<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Npgsql's EF 11 provider pins Microsoft.EntityFrameworkCore(.Relational) to exactly
             11.0.0-rc.1.26431.118, and that build is on .NET's own feed rather than nuget.org, which
             stops at 11.0.0-rc.1.26425.128. Without this source PostgreSQL cannot use an EF 11
             provider at all - the EF 10 one throws "Method not found: JsonTypeMapping..ctor" the
             moment a DbContext is created.

             Remove this source, and the mapping below, once EF and Npgsql agree on a version that
             nuget.org carries. -->
        <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <!-- The pattern is repeated under both sources on purpose. NuGet picks the longest matching
             pattern and then searches only the sources carrying it, so listing Microsoft.* on
             nuget.org as well is what keeps the older versions reachable: these libraries
             multi-target back to net8.0, and EF Core 8/9/10 and their dependencies live only there.
             Anything not starting with Microsoft. falls to the * pattern and comes from nuget.org. -->
        <packageSource key="nuget.org">
            <package pattern="*" />
            <package pattern="Microsoft.*" />
        </packageSource>
        <packageSource key="dotnet11">
            <package pattern="Microsoft.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
