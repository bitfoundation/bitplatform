<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>Bit.BlazeDb.EntityFrameworkCore</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- EF Core itself is neither trimming nor AOT safe, so a provider for it cannot claim to be. -->
        <IsAotCompatible>false</IsAotCompatible>
        <Description>Entity Framework Core provider for Bit.BlazeDb. UseBlazeDb() maps DbSet types onto the engine's live rows, tracks changes over them and translates LINQ straight onto hash and ordered indexes, with no SQL anywhere.</Description>
        <PackageTags>$(PackageTags);Blazor;WebAssembly;Database;EntityFrameworkCore;EFCore;LINQ</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- Use floating low-bound version ranges so consumers can pin to any patch release on
             their TFM. The upper bound prevents accidentally pulling a major-version package that
             targets a newer TFM. The net8.0 floor is 8.0.10, the first EF Core 8 servicing release
             whose Microsoft.Extensions.Caching.Memory dependency is past GHSA-qj66-m88j-hmgj. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.EntityFrameworkCore" Version="[8.0.10,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.EntityFrameworkCore" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.EntityFrameworkCore" Version="[10.0.0,11.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.BlazeDb\Bit.BlazeDb.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The translator and the plan are the provider's interesting parts and are tested directly:
             from the outside an index lookup and a scan are indistinguishable. -->
        <InternalsVisibleTo Include="Bit.BlazeDb.Tests" PublicKey="" />
    </ItemGroup>

</Project>
