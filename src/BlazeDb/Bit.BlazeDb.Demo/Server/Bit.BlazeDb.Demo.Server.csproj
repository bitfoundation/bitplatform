<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serves the client's _framework payload and enables WebAssembly debugging from this host. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <!-- The MCP server (see Controllers/McpController.cs), mapped at /mcp. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- InspectBlazeDbTable compiles the submitted table type and runs the generator over it. The version the
         generator itself is built against, so the two can never disagree about the API between them. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client brings the engine, the browser backends and the EF Core provider: the public surface
         GetBlazeDbApi reflects over. -->
    <ProjectReference Include="..\Client\Bit.BlazeDb.Demo.Client.csproj" />
    <!-- A plain assembly reference, not an analyzer: InspectBlazeDbTable runs the generator on demand,
         and GetBlazeDbDiagnostics reads its descriptors. -->
    <ProjectReference Include="..\..\Bit.BlazeDb.Generators\Bit.BlazeDb.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bit.BlazeDb" />
    <Using Include="Microsoft.AspNetCore.Mvc" />
  </ItemGroup>

  <ItemGroup>
    <!-- The MCP tests boot this very app and reach the internal helpers the tools are built from:
         WebApplicationFactory needs its entry point type, which top-level statements declare as internal. -->
    <InternalsVisibleTo Include="Bit.BlazeDb.Tests.Mcp" />
  </ItemGroup>

  <!-- Text the MCP server hands out. It is embedded rather than read from disk so the tools keep
       working from a published deployment, where none of these files exist next to the app.
       LogicalName is set explicitly because the resource name IS the path an MCP client asks for. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\README.md" LogicalName="BlazeDbDocs/README.md" />

    <!-- What this site can teach about the engine, and nothing else of it: the pages - each one drives a
         real database - the models, the database service and the instrumented storage, the diagnostics
         catalog and the client half of the hosting. The site chrome in Components\ (the icon set, the code
         highlighter, the panels, the theme toggle, the site map) answers no question about BlazeDb; the MCP
         page describes this server rather than the library, and the not-found page teaches nothing. -->
    <EmbeddedResource Include="..\Client\**\*.razor;..\Client\**\*.cs"
                      Exclude="..\Client\bin\**;..\Client\obj\**;..\Client\Components\**;..\Client\Pages\McpServer.razor;..\Client\Pages\NotFound.razor">
      <LogicalName>BlazeDbSource/Demo/Client/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Client\Bit.BlazeDb.Demo.Client.csproj" LogicalName="BlazeDbSource/Demo/Client/Bit.BlazeDb.Demo.Client.csproj" />

    <EmbeddedResource Include="Program.cs" LogicalName="BlazeDbSource/Demo/Server/Program.cs" />

    <!-- The Components\ prefix is written out: %(RecursiveDir) only captures what the '**' matched.
         Error.razor is the template's own error page and says nothing about the engine. -->
    <EmbeddedResource Include="Components\**\*.razor" Exclude="Components\Pages\Error.razor">
      <LogicalName>BlazeDbSource/Demo/Server/Components/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
