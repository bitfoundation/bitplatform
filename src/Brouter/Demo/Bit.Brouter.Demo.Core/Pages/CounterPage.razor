<h1>Counter</h1>

<p>Current count: @CurrentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<br />

<div>Init: @Init</div>

<br />

<div>Id: @Id</div>
<div>Age: @Age</div>
<div>Name: @Name</div>

@code {
    [Parameter] public int CurrentCount { get; set; } = 0;
    [Parameter] public EventCallback<int> CurrentCountChanged { get; set; }
    [Parameter] public Action<int>? ChangeCount { get; set; }

    [CascadingParameter(Name = "RouteParameters")] RouteParameters? Parameters { get; set; }

    [CascadingParameter(Name = "init")] int Init { get; set; }

    [CascadingParameter(Name = "id")] long Id { get; set; }
    [CascadingParameter(Name = "age")] double Age { get; set; }
    [CascadingParameter(Name = "name")] object? Name { get; set; }


    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Parameters?.TryGet<int>("init", out var init) == true && init != CurrentCount)
        {
            CurrentCount = init;
            ChangeCount?.Invoke(CurrentCount);
            if (CurrentCountChanged.HasDelegate)
                await CurrentCountChanged.InvokeAsync(CurrentCount);
        }
    }

    private async Task IncrementCount()
    {
        var next = CurrentCount + 1;
        CurrentCount = next;
        ChangeCount?.Invoke(next);
        if (CurrentCountChanged.HasDelegate)
            await CurrentCountChanged.InvokeAsync(next);
    }
}
