<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- The repo's global.json mandates the Microsoft.Testing.Platform runner. EnableMSTestRunner
             builds that test host into the assembly itself, and it only generates the entry point for
             an executable project. -->
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <!-- Playwright itself, without a per-framework integration package: the suite manages browsers,
             contexts and the CDP connection to the hybrid host from its own base classes. -->
        <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
        <PackageReference Include="MSTest" Version="4.4.1" />
    </ItemGroup>

    <!-- Deliberately no ProjectReference to the harness hosts. They are separate processes the suite
         boots - the web host once per render mode, the WinForms host on Windows only - and a reference
         would pin them to this project's single target framework and pull a WinForms app into a build
         that has to run on Linux. Infrastructure/HarnessBuild builds them before the first test. -->

</Project>
