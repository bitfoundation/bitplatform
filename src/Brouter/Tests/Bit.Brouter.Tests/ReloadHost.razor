@* Host for ReloadTests: a transient route, a keep-alive route (the case a same-URL navigation can
   never refresh), a lifecycle probe, and a parent/child chain with a guard plus cached loaders -
   so a reload can be observed to rebuild instances, re-run guards/loaders and bypass the loader
   cache that a plain re-navigation would hit. *@

@using Bit.Brouter
@inject IBrouter Router

@* Outside <Brouter> so it survives the reset and can be clicked again. Driving the reset from a
   real @onclick is the point: inside a UI event handler Blazor batches renders, so the unmatch and
   the re-mount collapse into one - the path app code actually takes (the docs' sign-out /
   switch-tenant buttons), and the one cut.InvokeAsync cannot reproduce. *@
<button data-testid="clear-active" @onclick="() => Router.ClearKeepAlive(includeActive: true)">clear-active</button>
@* Same batching point for the pipeline-running sibling: a reload whose chain has no async loader
   completes inside the handler, so its teardown and re-match collapse into one render too. *@
<button data-testid="reload-btn" @onclick="async () => await Router.ReloadAsync()">reload</button>

<Brouter>
    <Broute Path="/plain">
        <Content><StatefulCounter /></Content>
    </Broute>

    <Broute Path="/ka" KeepAlive="true">
        <Content><StatefulCounter /></Content>
    </Broute>

    <Broute Path="/lifecycle">
        <Content><LifecycleProbe Log="ProbeLog" /></Content>
    </Broute>

    <Broute Path="/data" Guard="CountGuard" Loader="ParentLoader" StaleTime="@TimeSpan.FromMinutes(5)">
        <Content>
            <div data-testid="layout">
                <StatefulCounter />
                <BrouterOutlet />
            </div>
        </Content>
        <ChildContent>
            <Broute Path="/view" Loader="ChildLoader" StaleTime="@TimeSpan.FromMinutes(5)">
                <Content><ChildDataView /></Content>
            </Broute>
        </ChildContent>
    </Broute>

    @* Nested chain with a probe at each level sharing one log, so the ORDER of their teardown
       callbacks is assertable (a child must flush before its parent's content goes). *@
    <Broute Path="/nested">
        <Content>
            <div data-testid="nested-layout">
                <LifecycleProbe Log="ProbeLog" Name="parent" />
                <BrouterOutlet />
            </div>
        </Content>
        <ChildContent>
            <Broute Path="/child">
                <Content><LifecycleProbe Log="ProbeLog" Name="child" /></Content>
            </Broute>
        </ChildContent>
    </Broute>

    <Broute Path="/teardown-nav">
        <Content><NavigateOnTeardownProbe Log="ProbeLog" /></Content>
    </Broute>

    <Broute Path="/teardown-nav-target" Loader="SlowLoader">
        <Content><div data-testid="teardown-nav-target">target</div></Content>
    </Broute>

    @* Outlet-hosted TRANSIENT child (no KeepAlive): the child's content lives in the layout's
       BrouterOutlet rather than at its declaration site, so it is rendered by BrouterOutlet's
       per-entry path instead of the route's inline renderer. Both a reset and a reload must give
       it a new entry - and a new lifecycle session the probe can report on. *@
    <Broute Path="/outlet">
        <Content>
            <div data-testid="olayout"><BrouterOutlet /></div>
        </Content>
        <ChildContent>
            <Broute Path="/t">
                <Content>
                    <StatefulCounter />
                    <LifecycleProbe Log="ProbeLog" />
                </Content>
            </Broute>
        </ChildContent>
    </Broute>

    @* Guard that parks the DECISION phase (OnLocationChanging) until the test releases it: the
       window where a navigation is under way but its pipeline has not started yet. *@
    <Broute Path="/slow-guard" Guard="SlowGuard">
        <Content><div data-testid="slow-guard">slow-guard</div></Content>
    </Broute>

    <Broute Path="/other">
        <Content><div data-testid="other">other</div></Content>
    </Broute>
</Brouter>

@code {
    public List<string> ProbeLog { get; } = [];
    public int GuardRuns { get; private set; }
    public int ParentLoaderRuns { get; private set; }
    public int ChildLoaderRuns { get; private set; }
    public bool? LastLoadWasReload { get; private set; }

    // Async on purpose: the navigation the teardown probe starts must still be in flight (started,
    // not committed) when the reset that triggered it resumes - the window the reset must respect.
    private async ValueTask<object?> SlowLoader(BrouterNavigationContext ctx)
    {
        await Task.Delay(50, ctx.CancellationToken);
        return null;
    }

    // Set by the tests to make the guard deny the NEXT pass, standing in for an authorization that
    // was valid when the user arrived but is not any more (expired session, revoked permission) -
    // the case where a reload's re-match is refused after its teardown already ran.
    public bool CancelGuard { get; set; }

    private ValueTask CountGuard(BrouterNavigationContext ctx)
    {
        GuardRuns++;
        if (CancelGuard) ctx.Cancel();
        return ValueTask.CompletedTask;
    }

    private ValueTask<object?> ParentLoader(BrouterNavigationContext ctx)
    {
        ParentLoaderRuns++;
        return ValueTask.FromResult<object?>($"parent-{ParentLoaderRuns}");
    }

    // Set by the tests to make the child loader cancel the NEXT pass - the reload bail-out that
    // happens AFTER the pipeline has already nulled the chain's LoadedData, unlike the guard's.
    public bool CancelInLoader { get; set; }

    private ValueTask<object?> ChildLoader(BrouterNavigationContext ctx)
    {
        ChildLoaderRuns++;
        LastLoadWasReload = ctx.IsReload;
        if (CancelInLoader)
        {
            ctx.Cancel();
            return ValueTask.FromResult<object?>(null);
        }
        return ValueTask.FromResult<object?>($"child-{ChildLoaderRuns}");
    }

    // Completed by the tests. Async on purpose: the navigation sits inside its guard - approved by
    // nothing yet, pipeline not started - for as long as the test needs.
    public TaskCompletionSource GuardGate { get; } = new();

    private async ValueTask SlowGuard(BrouterNavigationContext ctx) => await GuardGate.Task;
}
