@* Reports every route-lifecycle callback into an externally-owned log, so transitions on content
   that gets DISPOSED (transient routes) can still be asserted after the component is gone. *@

@using Bit.Brouter
@inherits BrouterRouteBase

<div data-testid="probe">probe</div>

@code {
    [Parameter] public List<string>? Log { get; set; }

    // Optional identity, so a nested chain can log two probes into ONE list and the relative order
    // of their callbacks is assertable. Unset (the default) keeps the entries verbatim for the
    // single-probe tests.
    [Parameter] public string? Name { get; set; }

    private string Tag(string entry) => string.IsNullOrEmpty(Name) ? entry : $"{Name}:{entry}";

    protected override void OnActivated(BrouterRouteActivation activation)
        => Log?.Add(Tag($"activated:first={activation.IsFirstActivation}"));

    protected override void OnDeactivated(BrouterRouteDeactivation deactivation)
        => Log?.Add(Tag($"deactivated:{deactivation.Reason}"));

    protected override void OnRenavigated(BrouterRouteRenavigation renavigation)
        => Log?.Add(Tag($"renavigated:{renavigation.PreviousLocation.Path}->{renavigation.Location.Path}"));
}
