@using Bit.Brouter

<Brouter>
    <Broute Path="/login" Guard="@RedirectToLogin">
        <Content><div data-testid="login">login</div></Content>
    </Broute>
</Brouter>

@code {
    public int GuardCalls { get; private set; }

    private ValueTask RedirectToLogin(BrouterNavigationContext ctx)
    {
        // Bounded so a redirect loop fails the test instead of hanging the run.
        if (++GuardCalls < 10) ctx.Redirect("/login/");
        return ValueTask.CompletedTask;
    }
}
