<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- One Blazor Web App that serves the harness in any render mode, chosen at startup with
         BrouterHarness:Mode (see HarnessRenderModes). A single host for every mode, rather than one
         project per mode, keeps the Program.cs and App.razor under test identical across modes, so a
         failure that shows up in one mode only belongs to the mode and not to a difference between two
         hosts. Multi-targeted because the library is: the suites can run the harness on every runtime
         Bit.Brouter ships for. -->

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.31" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.20" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Brouter.Tests.Harness.Web.Client\Bit.Brouter.Tests.Harness.Web.Client.csproj" />
        <ProjectReference Include="..\Bit.Brouter.Tests.Harness\Bit.Brouter.Tests.Harness.csproj" />
    </ItemGroup>

</Project>
