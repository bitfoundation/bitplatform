<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The one set of routes and pages every harness host renders: the web host in each Blazor render
         mode (Bit.Brouter.Tests.Harness.Web), its WebAssembly client, and the BlazorWebView host
         (Bit.Brouter.Tests.Harness.Hybrid). Keeping them in a single library is what lets the browser
         suites run the same assertions against every host and attribute a difference to the host. -->

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Brouter\Bit.Brouter.csproj" />
    </ItemGroup>

</Project>
