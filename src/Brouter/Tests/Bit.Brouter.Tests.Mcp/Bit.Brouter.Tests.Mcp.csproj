<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Microsoft.NET.Sdk.Razor" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="bunit" Version="2.9.0" />
        <PackageReference Include="MSTest" Version="4.3.3" />
        <!-- Boots the demo server's real Program.cs in memory, so the MCP server under test is the
             one the app actually maps at /mcp rather than a re-registration of its pieces. -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
        <!-- The MCP client half of the SDK: the tests speak the protocol over the wire, the way a
             real client does, instead of calling the tool methods directly. -->
        <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Brouter.Demo\Server\Bit.Brouter.Demo.Server.csproj" />
    </ItemGroup>

</Project>
