<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- Blazor Hybrid host for the harness. WinForms rather than MAUI: both sit on the same
         Microsoft.AspNetCore.Components.WebView core (the WebViewManager that serves _content/ assets,
         runs the renderer and bridges JS interop), and on Windows both render through WebView2, which
         Playwright can drive over the Chrome DevTools Protocol. WinForms gets there without the MAUI
         workload, so it builds and runs on a stock windows-2025 runner. -->

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net11.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- Lets the whole Bit.Brouter.slnx build on the Linux CI runner; running it still needs Windows. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="11.0.0-rc.1.26451.6" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Brouter.Tests.Harness\Bit.Brouter.Tests.Harness.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
