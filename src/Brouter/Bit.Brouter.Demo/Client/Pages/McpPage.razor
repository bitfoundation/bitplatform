<PageTitle>MCP server · Brouter docs</PageTitle>

@* The MCP server this site hosts (Server/Controllers/McpController.cs), exercised against itself.
   Everything below is a real session: the page speaks JSON-RPC over the Streamable HTTP transport
   to /mcp - the same endpoint an AI agent connects to - and shows every message on the wire, in
   both directions. Nothing here is a recording. *@

@using System.Text.Json
@using System.Text.Json.Nodes
@inject McpDemoClient mcp

<div class="bb-intro">
    <h1>MCP server</h1>
    <p class="bb-subtitle">
        This site ships an <strong>MCP server</strong> so an AI agent can build with Brouter from the
        library it actually has, instead of from what it remembers. The page below is a live MCP
        client: it handshakes with <code>/mcp</code>, lists the tools, resources and prompts, calls
        them, and prints every JSON-RPC message it sends and receives.
    </p>
</div>

<div class="bb-note">
    <strong>Model Context Protocol</strong> is how an agent discovers and calls capabilities at runtime.
    A server offers three kinds: <em>tools</em> the model may call, <em>resources</em> a client can attach
    to a conversation, and <em>prompts</em> a person can pick as a ready-made workflow. This one answers
    from the shipped <code>Bit.Brouter</code> assembly, its README and this site's own pages - so its
    answers move with the library rather than aging next to it.
</div>

<div class="bb-card">
    <h3 class="bb-card-title">
        <span class="bb-dot @(mcp.IsConnected ? "bb-dot-success" : "bb-dot-warning")"></span> Handshake
    </h3>
    <p class="bb-card-desc">
        Every session opens with <code>initialize</code>: the two sides agree on a protocol revision -
        a server without the requested one refuses with <code>-32022</code> and names the revisions it
        has - and the server states which capabilities it offers. The client answers with
        <code>notifications/initialized</code>, a message with no <code>id</code> and therefore no
        reply, and only after that may it call anything.
    </p>
    <p class="bb-card-desc">
        This server runs the transport in its <strong>stateless</strong> mode, which is the default:
        no <code>Mcp-Session-Id</code> comes back, every POST stands on its own, and the deployment can
        sit behind a load balancer without session affinity. What each later request does have to
        carry is the negotiated <code>MCP-Protocol-Version</code> header.
    </p>

    @if (_status is not null)
    {
        <p class="mcp-status">@_status</p>
    }

    <dl class="bb-params">
        <dt>Endpoint</dt>
        <dd><code>POST /mcp</code> · Streamable HTTP</dd>
        <dt>Protocol</dt>
        <dd>@(mcp.ProtocolVersion ?? "-") <span class="mcp-muted">(asked for @McpDemoClient.RequestedProtocolVersion)</span></dd>
        <dt>Server</dt>
        <dd>@(Value(mcp.ServerInfo?["name"]) ?? "-") @Value(mcp.ServerInfo?["version"])</dd>
        <dt>Session id</dt>
        <dd><code>@(mcp.SessionId ?? "none - stateless")</code></dd>
        <dt>Capabilities</dt>
        <dd>
            @if (mcp.Capabilities is JsonObject capabilities && capabilities.Count > 0)
            {
                @foreach (var capability in capabilities)
                {
                    <span class="bb-badge bb-badge-success">@capability.Key</span>
                }
            }
            else
            {
                <span>-</span>
            }
        </dd>
    </dl>

    <div class="bb-try">
        <button class="btn btn-primary" disabled="@_busy" @onclick="StartSessionAsync">
            @(mcp.IsConnected ? "Re-handshake" : "Connect")
        </button>
        @* Only a stateful server has something to close: the DELETE exists to release the session
           state it kept, and there is none to release without a session id. *@
        @if (mcp.SessionId is not null)
        {
            <button class="btn btn-outline" disabled="@_busy" @onclick="EndSessionAsync">
                Close session (HTTP DELETE)
            </button>
        }
        <button class="btn btn-outline" disabled="@_busy" @onclick="() => mcp.ClearExchanges()">Clear the log</button>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Tools</h3>
    <p class="bb-card-desc">
        <code>tools/list</code> returned @_tools.Length tool@(_tools.Length == 1 ? "" : "s"), each with the JSON
        schema of its arguments - that schema is all a model gets, which is why the descriptions read
        like instructions. Pick one, fill the arguments and call it: the request and the response land
        in the wire log at the bottom of the page.
    </p>

    @if (_tools.Length == 0)
    {
        <p class="bb-empty">No tools yet - the session has not listed them.</p>
    }
    else
    {
        <div class="mcp-field">
            <label for="mcp-tool">Tool</label>
            <select id="mcp-tool" value="@_selectedTool?.Name" @onchange="OnToolChanged">
                @foreach (var tool in _tools)
                {
                    <option value="@tool.Name">@tool.Name</option>
                }
            </select>
        </div>

        @if (_selectedTool is not null)
        {
            <p class="mcp-description">@_selectedTool.Description</p>

            @if (_selectedTool.Arguments.Length == 0)
            {
                <p class="mcp-muted">This tool takes no arguments.</p>
            }
            else
            {
                @foreach (var argument in _selectedTool.Arguments)
                {
                    <div class="mcp-field" @key="argument.Name">
                        <label for="@($"mcp-arg-{argument.Name}")">
                            @argument.Name
                            <span class="bb-badge @(argument.Required ? "bb-badge-danger" : "")">@(argument.Required ? "required" : argument.Type)</span>
                        </label>
                        @if (argument.Multiline)
                        {
                            <textarea id="@($"mcp-arg-{argument.Name}")" rows="4" @bind="_toolArguments[argument.Name]"></textarea>
                        }
                        else
                        {
                            <input id="@($"mcp-arg-{argument.Name}")" @bind="_toolArguments[argument.Name]" />
                        }
                        @if (argument.Description is not null)
                        {
                            <span class="mcp-hint">@argument.Description</span>
                        }
                    </div>
                }
            }

            <div class="bb-try">
                <button class="btn btn-primary" disabled="@(_busy || IsIncomplete(_selectedTool.Arguments, _toolArguments))" @onclick="CallToolAsync">Call tool</button>
                @if (_examples.ContainsKey(_selectedTool.Name))
                {
                    <button class="btn btn-outline" disabled="@_busy" @onclick="FillExample">Fill an example</button>
                }
            </div>
        }

        @if (_toolOutput is not null)
        {
            <p class="mcp-result-meta">
                <span class="bb-badge @(_toolFailed ? "bb-badge-danger" : "bb-badge-success")">@(_toolFailed ? "error" : "ok")</span>
                @_toolOutput.Length characters · @_toolElapsed.ToString("F0") ms
            </p>
            <pre class="bb-code mcp-output">@Clip(_toolOutput)</pre>
        }
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Resources</h3>
    <p class="bb-card-desc">
        Resources are addressed by URI rather than called, so a client can attach them to a
        conversation up front or let a person browse and pin them. Fixed ones come from
        <code>resources/list</code>; the parameterised ones come from
        <code>resources/templates/list</code> and are filled in before reading.
    </p>

    @if (_resources.Length + _resourceTemplates.Length == 0)
    {
        <p class="bb-empty">No resources yet - the session has not listed them.</p>
    }
    else
    {
        <table class="bb-table">
            <thead>
                <tr>
                    <th>URI</th>
                    <th>What it is</th>
                    <th>Read</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var resource in _resources.Concat(_resourceTemplates))
                {
                    <tr @key="resource.Uri">
                        <td><code>@resource.Uri</code></td>
                        <td>
                            @resource.Description
                            @if (resource.IsTemplate)
                            {
                                <span class="bb-badge bb-badge-warn">template</span>
                            }
                        </td>
                        <td class="bb-table-action">
                            <button class="btn btn-outline" disabled="@_busy" @onclick="() => PickResource(resource)">
                                @(resource.IsTemplate ? "use" : "read")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mcp-field">
            <label for="mcp-resource-uri">resources/read · uri</label>
            <input id="mcp-resource-uri" @bind="_resourceUri" @bind:event="oninput" />
            <span class="mcp-hint">
                A template's placeholder has to be replaced before reading - e.g.
                <code>brouter://api/BrouterOptions</code>. Values are URI-escaped, so
                <code>brouter://source/Demo%2FClient%2FAppRouter.razor</code> reads one file.
            </span>
        </div>

        <div class="bb-try">
            <button class="btn btn-primary" disabled="@(_busy || _resourceUri.Length == 0)" @onclick="ReadResourceAsync">Read resource</button>
        </div>

        @if (_resourceOutput is not null)
        {
            <p class="mcp-result-meta">
                <span class="bb-badge @(_resourceFailed ? "bb-badge-danger" : "bb-badge-success")">@(_resourceFailed ? "error" : "ok")</span>
                @_resourceOutput.Length characters
            </p>
            <pre class="bb-code mcp-output">@Clip(_resourceOutput)</pre>
        }
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Prompts</h3>
    <p class="bb-card-desc">
        A prompt is a workflow a person picks - in most clients they appear as slash commands. What
        <code>prompts/get</code> returns is the message that gets put in front of the model, and these
        four spend their words on the order to call the tools in, because an agent with a dozen tools
        usually fails by sequence rather than by ignorance.
    </p>

    @if (_prompts.Length == 0)
    {
        <p class="bb-empty">No prompts yet - the session has not listed them.</p>
    }
    else
    {
        <div class="mcp-field">
            <label for="mcp-prompt">Prompt</label>
            <select id="mcp-prompt" value="@_selectedPrompt?.Name" @onchange="OnPromptChanged">
                @foreach (var prompt in _prompts)
                {
                    <option value="@prompt.Name">@prompt.Name</option>
                }
            </select>
        </div>

        @if (_selectedPrompt is not null)
        {
            <p class="mcp-description">@_selectedPrompt.Description</p>

            @foreach (var argument in _selectedPrompt.Arguments)
            {
                <div class="mcp-field" @key="argument.Name">
                    <label for="@($"mcp-prompt-arg-{argument.Name}")">
                        @argument.Name
                        <span class="bb-badge @(argument.Required ? "bb-badge-danger" : "")">@(argument.Required ? "required" : "optional")</span>
                    </label>
                    <input id="@($"mcp-prompt-arg-{argument.Name}")" @bind="_promptArguments[argument.Name]" />
                    @if (argument.Description is not null)
                    {
                        <span class="mcp-hint">@argument.Description</span>
                    }
                </div>
            }

            <div class="bb-try">
                <button class="btn btn-primary" disabled="@(_busy || IsIncomplete(_selectedPrompt.Arguments, _promptArguments))" @onclick="GetPromptAsync">Get prompt</button>
            </div>
        }

        @if (_promptOutput is not null)
        {
            <pre class="bb-code mcp-output">@Clip(_promptOutput)</pre>
        }
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> The wire log</h3>
    <p class="bb-card-desc">
        Every message this page has exchanged with the server, oldest first - the JSON-RPC envelope
        that went out and the one that came back (indented for reading, otherwise as they were), with
        the HTTP status, the response's content type and how long the round trip took. Notifications have no <code>id</code>, so the server answers
        them with <code>202</code> and an empty body.
    </p>

    @if (mcp.Exchanges.Count == 0)
    {
        <p class="bb-empty">Nothing sent yet.</p>
    }

    @foreach (var (exchange, index) in mcp.Exchanges.Select((e, i) => (e, i)))
    {
        <details class="mcp-exchange" open="@(index >= mcp.Exchanges.Count - 2)" @key="exchange">
            <summary>
                <span class="mcp-exchange-index">#@(index + 1)</span>
                <code>@exchange.Method</code>
                @if (exchange.Error is not null)
                {
                    <span class="bb-badge bb-badge-danger">error</span>
                }
                else if (exchange.IsNotification)
                {
                    <span class="bb-badge bb-badge-warn">no reply expected</span>
                }
                <span class="mcp-muted">@exchange.StatusCode · @exchange.ElapsedMs.ToString("F0") ms · @exchange.StartedAt.ToString("HH:mm:ss")</span>
            </summary>

            <p class="mcp-wire-label">→ request</p>
            <pre class="bb-code mcp-wire">@exchange.RequestJson</pre>

            <p class="mcp-wire-label">← response @(exchange.ContentType is null ? null : $"({exchange.ContentType})")</p>
            <pre class="bb-code mcp-wire">@Clip(exchange.Error is not null && exchange.ResponseJson is null ? exchange.Error : exchange.ResponseJson ?? "")</pre>
        </details>
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Point your own client at it</h3>
    <p class="bb-card-desc">
        The endpoint is plain Streamable HTTP, so any MCP client connects to it with a URL and nothing
        else. Against a local run of this demo:
    </p>
    <pre class="bb-code"><span class="c">// .mcp.json (Claude Code, VS Code, and anything else reading this shape)</span>
{
  <span class="s">"mcpServers"</span>: {
    <span class="s">"brouter"</span>: {
      <span class="s">"type"</span>: <span class="s">"http"</span>,
      <span class="s">"url"</span>: <span class="s">"https://localhost:7185/mcp"</span>
    }
  }
}</pre>
    <p class="bb-card-desc">
        Or drive it from a terminal - one POST is a whole handshake:
    </p>
    <pre class="bb-code">curl -sN https://localhost:7185/mcp \
  -H <span class="s">"Content-Type: application/json"</span> \
  -H <span class="s">"Accept: application/json, text/event-stream"</span> \
  -d <span class="s">'{"jsonrpc":"2.0","id":1,"method":"initialize","params":{
       "protocolVersion":"2025-11-25","capabilities":{},
       "clientInfo":{"name":"curl","version":"1.0"}}}'</span></pre>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> The same tools over plain HTTP</h3>
    <p class="bb-card-desc">
        <code>McpController</code> is an MVC controller as well as an MCP tool type: every tool is also
        a <code>GET</code> under <code>/api/mcp/…</code>. That is a debugging convenience - open one in
        a browser tab and read exactly what an agent would be handed, with no client in the way.
    </p>
    <ul class="bb-link-list">
        <li><a href="/api/mcp/GetBrouterOverview" target="_blank" rel="noopener">/api/mcp/GetBrouterOverview</a></li>
        <li><a href="/api/mcp/SearchBrouter?query=block%20navigation%20unsaved%20changes" target="_blank" rel="noopener">/api/mcp/SearchBrouter?query=block navigation unsaved changes</a></li>
        <li><a href="/api/mcp/GetBrouterApiDetails?typeName=Broute" target="_blank" rel="noopener">/api/mcp/GetBrouterApiDetails?typeName=Broute</a></li>
        <li><a href="/api/mcp/InspectBrouterRouteTemplate?template=/files/%7Bname%7D.%7Bext?%7D" target="_blank" rel="noopener">/api/mcp/InspectBrouterRouteTemplate?template=/files/{name}.{ext?}</a></li>
        <li><a href="/api/mcp/GetBrouterSourceFile?path=Demo/Client/AppRouter.razor" target="_blank" rel="noopener">/api/mcp/GetBrouterSourceFile?path=Demo/Client/AppRouter.razor</a></li>
    </ul>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> How the server is put together</h3>
    <p class="bb-card-desc">
        Three files and four lines of startup. The tools are ordinary methods - the attributes are what
        make them callable, and the <code>[Description]</code> text is the whole interface a model sees.
    </p>
    <pre class="bb-code"><span class="c">// Server/Program.cs</span>
builder.Services.AddMcpServer()
                .WithHttpTransport()
                .WithToolsFromAssembly()
                .WithResourcesFromAssembly()
                .WithPromptsFromAssembly();

app.MapControllers();
app.MapMcp(<span class="s">"/mcp"</span>);

<span class="c">// Server/Controllers/McpController.cs - a tool and an HTTP endpoint at once</span>
[<span class="k">HttpGet</span>]
[<span class="k">McpServerTool</span>(Name = <span class="k">nameof</span>(InspectBrouterRouteTemplate))]
[<span class="k">Description</span>(<span class="s">"Parses a route template with Bit.Brouter's own parser and reports what it means…"</span>)]
<span class="k">public</span> BrouterTemplateInspectionDto InspectBrouterRouteTemplate(<span class="k">string</span> template)
    =&gt; BrouterTemplateInspector.Inspect(template, brouterOptions.Value.Constraints);</pre>
    <div class="bb-try">
        <BrouterLink Href="/docs/typed-routes" class="btn btn-outline">← Typed routes</BrouterLink>
        <BrouterLink Href="/docs/migration" class="btn btn-primary">Migration →</BrouterLink>
    </div>
</div>

@code {
    private const int MaxShownCharacters = 6_000;

    private static readonly JsonSerializerOptions _indented = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    private sealed record ArgumentInfo(string Name, string Type, string? Description, bool Required, bool Multiline);
    private sealed record ToolInfo(string Name, string? Description, ArgumentInfo[] Arguments);
    private sealed record PromptInfo(string Name, string? Description, ArgumentInfo[] Arguments);
    private sealed record ResourceInfo(string Uri, string? Description, bool IsTemplate);

    // Argument sets, by tool or prompt name, that make one show what it is for on the first click -
    // so trying it out does not start with inventing a plausible input.
    private static readonly Dictionary<string, Dictionary<string, string>> _examples = new(StringComparer.Ordinal)
    {
        ["SearchBrouter"] = new() { ["query"] = "block navigation unsaved changes" },
        ["GetBrouterSetupGuide"] = new() { ["renderMode"] = "wasm" },
        ["GetBrouterDocsPage"] = new() { ["slug"] = "guards" },
        ["GetBrouterGuideSection"] = new() { ["heading"] = "Async guards" },
        ["GetBrouterApiDetails"] = new() { ["typeName"] = "Broute" },
        ["GetBrouterSourceFile"] = new() { ["path"] = "Demo/Client/AppRouter.razor" },
        ["InspectBrouterRouteTemplate"] = new() { ["template"] = "/files/{name}.{ext?}" },
        ["AnalyzeBrouterRouteTable"] = new() { ["templates"] = "/products/{id:int}\n/products/{slug}\n/products/{name}" },
        ["add-brouter-to-app"] = new() { ["renderMode"] = "wasm" },
        ["implement-brouter-feature"] = new() { ["feature"] = "warn before leaving a half-filled form" },
        ["debug-brouter-routing"] = new() { ["symptom"] = "/files/report.pdf renders the 404 route" },
    };

    private ToolInfo[] _tools = [];
    private ToolInfo? _selectedTool;
    private readonly Dictionary<string, string> _toolArguments = new(StringComparer.Ordinal);
    private string? _toolOutput;
    private bool _toolFailed;
    private double _toolElapsed;

    private ResourceInfo[] _resources = [];
    private ResourceInfo[] _resourceTemplates = [];
    private string _resourceUri = "brouter://api/BrouterOptions";
    private string? _resourceOutput;
    private bool _resourceFailed;

    private PromptInfo[] _prompts = [];
    private PromptInfo? _selectedPrompt;
    private readonly Dictionary<string, string> _promptArguments = new(StringComparer.Ordinal);
    private string? _promptOutput;

    private string? _status;
    private bool _busy;

    // The session is opened from the first interactive render: during prerendering there is no
    // browser to send from, and this page renders on the server as well - the MCP server hands its
    // own documentation page out through GetBrouterDocsPage, which renders this very component.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender is false) return;

        await StartSessionAsync();
    }

    private async Task StartSessionAsync()
    {
        _busy = true;
        _status = "Handshaking with /mcp…";
        StateHasChanged();

        try
        {
            var call = await mcp.ConnectAsync();

            if (call.IsSuccess is false)
            {
                _status = $"initialize failed: {call.Error}";
                return;
            }

            _status = null;
            StateHasChanged();

            await ListToolsAsync();
            await ListResourcesAsync();
            await ListPromptsAsync();
        }
        finally
        {
            _busy = false;

            // This also runs from OnAfterRenderAsync, which does not re-render on its own.
            StateHasChanged();
        }
    }

    private async Task EndSessionAsync()
    {
        _busy = true;

        try
        {
            await mcp.DisconnectAsync();

            _tools = [];
            _resources = [];
            _resourceTemplates = [];
            _prompts = [];
            _selectedTool = null;
            _selectedPrompt = null;
            _status = "The session is closed. Connect again to list anything.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ListToolsAsync()
    {
        var call = await mcp.CallAsync("tools/list");

        // The server lists them in whatever order it discovered the methods; a dropdown is easier to
        // find a name in when it is sorted.
        _tools = call.Result?["tools"] is JsonArray tools
            ? [.. tools.Select(tool => new ToolInfo(
                Value(tool?["name"]) ?? "?",
                Value(tool?["description"]),
                ArgumentsOf(tool?["inputSchema"]))).OrderBy(tool => tool.Name, StringComparer.Ordinal)]
            : [];

        SelectTool(_tools.FirstOrDefault(tool => tool.Name == "SearchBrouter") ?? _tools.FirstOrDefault());

        StateHasChanged();
    }

    private async Task ListResourcesAsync()
    {
        var listed = await mcp.CallAsync("resources/list");

        _resources = listed.Result?["resources"] is JsonArray resources
            ? [.. resources.Select(resource => new ResourceInfo(
                Value(resource?["uri"]) ?? "?",
                Value(resource?["description"]),
                IsTemplate: false))]
            : [];

        StateHasChanged();

        // Templates are listed separately: they are not readable as they stand, so a client that
        // treated them as resources would offer URIs that cannot be fetched.
        var templated = await mcp.CallAsync("resources/templates/list");

        _resourceTemplates = templated.Result?["resourceTemplates"] is JsonArray templates
            ? [.. templates.Select(template => new ResourceInfo(
                Value(template?["uriTemplate"]) ?? "?",
                Value(template?["description"]),
                IsTemplate: true))]
            : [];

        StateHasChanged();
    }

    private async Task ListPromptsAsync()
    {
        var call = await mcp.CallAsync("prompts/list");

        _prompts = call.Result?["prompts"] is JsonArray prompts
            ? [.. prompts.Select(prompt => new PromptInfo(
                Value(prompt?["name"]) ?? "?",
                Value(prompt?["description"]),
                prompt?["arguments"] is JsonArray arguments
                    ? [.. arguments.Select(argument => new ArgumentInfo(
                        Value(argument?["name"]) ?? "?",
                        "string",
                        Value(argument?["description"]),
                        argument?["required"]?.GetValue<bool>() ?? false,
                        Multiline: false))]
                    : []))]
            : [];

        SelectPrompt(_prompts.FirstOrDefault());

        StateHasChanged();
    }

    private async Task CallToolAsync()
    {
        if (_selectedTool is null) return;

        _busy = true;

        try
        {
            var call = await mcp.CallAsync("tools/call", new JsonObject
            {
                ["name"] = _selectedTool.Name,
                ["arguments"] = ArgumentsFor(_selectedTool.Arguments, _toolArguments)
            });

            // A tool that fails does not fail the call: the result comes back with isError set and
            // the reason as text, so the model can read what went wrong and try something else.
            _toolFailed = call.IsSuccess is false || call.Result?["isError"]?.GetValue<bool>() is true;
            _toolElapsed = call.Exchange.ElapsedMs;
            _toolOutput = call.Error ?? TextOf(call.Result, "content");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReadResourceAsync()
    {
        _busy = true;

        try
        {
            var call = await mcp.CallAsync("resources/read", new JsonObject { ["uri"] = _resourceUri });

            _resourceFailed = call.IsSuccess is false;
            _resourceOutput = call.Error ?? TextOf(call.Result, "contents");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task GetPromptAsync()
    {
        if (_selectedPrompt is null) return;

        _busy = true;

        try
        {
            var call = await mcp.CallAsync("prompts/get", new JsonObject
            {
                ["name"] = _selectedPrompt.Name,
                ["arguments"] = ArgumentsFor(_selectedPrompt.Arguments, _promptArguments)
            });

            _promptOutput = call.Error ?? string.Join("\n\n", (call.Result?["messages"] as JsonArray)?
                .Select(message => $"[{Value(message?["role"])}] {Value(message?["content"]?["text"])}") ?? []);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnToolChanged(ChangeEventArgs args)
        => SelectTool(_tools.FirstOrDefault(tool => tool.Name == args.Value?.ToString()));

    private void SelectTool(ToolInfo? tool)
    {
        _selectedTool = tool;
        _toolOutput = null;
        _toolArguments.Clear();

        if (tool is null) return;

        foreach (var argument in tool.Arguments)
        {
            _toolArguments[argument.Name] = string.Empty;
        }

        FillExample();
    }

    private void FillExample()
    {
        if (_selectedTool is not null) FillExample(_selectedTool.Name, _toolArguments);
    }

    private static void FillExample(string name, Dictionary<string, string> values)
    {
        if (_examples.TryGetValue(name, out var example) is false) return;

        foreach (var (argument, value) in example)
        {
            if (values.ContainsKey(argument)) values[argument] = value;
        }
    }

    /// <summary>Whether a required argument is still empty - the call would come back as an error.</summary>
    private static bool IsIncomplete(ArgumentInfo[] declared, Dictionary<string, string> values)
        => declared.Any(argument => argument.Required && (values.GetValueOrDefault(argument.Name) ?? string.Empty).Length == 0);

    private void OnPromptChanged(ChangeEventArgs args)
        => SelectPrompt(_prompts.FirstOrDefault(prompt => prompt.Name == args.Value?.ToString()));

    private void SelectPrompt(PromptInfo? prompt)
    {
        _selectedPrompt = prompt;
        _promptOutput = null;
        _promptArguments.Clear();

        if (prompt is null) return;

        foreach (var argument in prompt.Arguments)
        {
            _promptArguments[argument.Name] = string.Empty;
        }

        FillExample(prompt.Name, _promptArguments);
    }

    private void PickResource(ResourceInfo resource)
    {
        _resourceUri = resource.Uri;
        _resourceOutput = null;
    }

    /// <summary>The declared arguments of a tool, read from the JSON schema the server published for it.</summary>
    private static ArgumentInfo[] ArgumentsOf(JsonNode? schema)
    {
        if (schema?["properties"] is not JsonObject properties) return [];

        HashSet<string> required = schema["required"] is JsonArray names
            ? [.. names.Select(name => Value(name) ?? string.Empty)]
            : [];

        return [.. properties.Select(property => new ArgumentInfo(
            property.Key,
            TypeOf(property.Value?["type"]),
            Value(property.Value?["description"]),
            required.Contains(property.Key),
            // The one argument that is a list rather than a value deserves a box it fits in.
            Multiline: property.Key is "templates"))];
    }

    /// <summary>Turns the filled-in text boxes into the JSON the argument's declared type asks for.</summary>
    private static JsonObject ArgumentsFor(ArgumentInfo[] declared, Dictionary<string, string> values)
    {
        var arguments = new JsonObject();

        foreach (var argument in declared)
        {
            var value = values.GetValueOrDefault(argument.Name) ?? string.Empty;

            // An omitted optional argument is not the same as an empty one: leaving it out is what
            // lets the server apply the default declared in the schema.
            if (value.Length == 0) continue;

            arguments[argument.Name] = argument.Type switch
            {
                "integer" when long.TryParse(value, out var whole) => JsonValue.Create(whole),
                "number" when double.TryParse(value, out var number) => JsonValue.Create(number),
                "boolean" when bool.TryParse(value, out var flag) => JsonValue.Create(flag),
                _ => JsonValue.Create(value)
            };
        }

        return arguments;
    }

    /// <summary>The text blocks of a tool result or a resource read, which is what a model is handed.</summary>
    private static string TextOf(JsonNode? result, string property)
    {
        if (result?[property] is not JsonArray blocks) return result?.ToString() ?? string.Empty;

        return Prettify(string.Join("\n\n", blocks.Select(block => Value(block?["text"]) ?? block?.ToString() ?? string.Empty)));
    }

    /// <summary>
    /// Indents a text block that is itself JSON - several tools answer with a serialized DTO, and a
    /// model reads that fine on one line while a person does not. The wire log below has the
    /// message exactly as it arrived either way.
    /// </summary>
    private static string Prettify(string text)
    {
        var trimmed = text.TrimStart();

        if (trimmed.StartsWith('{') is false && trimmed.StartsWith('[') is false) return text;

        try
        {
            return JsonNode.Parse(text)?.ToJsonString(_indented) ?? text;
        }
        catch (JsonException)
        {
            return text;
        }
    }

    /// <summary>A JSON value as text, whatever its underlying kind - null when the member is absent.</summary>
    private static string? Value(JsonNode? node)
        => node is JsonValue value ? value.ToString() : node?.ToString();

    /// <summary>The declared type of a schema property; a nullable one declares several, the first is its type.</summary>
    private static string TypeOf(JsonNode? type) => type switch
    {
        JsonArray types => Value(types.FirstOrDefault()) ?? "string",
        null => "string",
        _ => Value(type) ?? "string"
    };

    private static string Clip(string text) => text.Length <= MaxShownCharacters
        ? text
        : $"{text[..MaxShownCharacters]}\n\n[clipped for display - {text.Length} characters in total]";
}
