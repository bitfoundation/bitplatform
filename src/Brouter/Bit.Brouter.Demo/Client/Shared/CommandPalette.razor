@inject IBrouter brouter
@implements IAsyncDisposable

@* The site's search: a command palette rather than a dropdown under a text field.

   Everything it can reach is a route on this site, so the corpus is the catalogs themselves -
   DocsCatalog's titles, descriptions and keywords, plus a short list of the live demos worth
   jumping straight to. No index is built and no service is called; a router demo searching its
   own route table is the honest implementation.

   The trigger and the dialog are one component so the keyboard shortcut, the button and the open
   state cannot get out of step. Ctrl+K / Cmd+K and "/" open it from anywhere - site.js owns the
   document-level listener and calls back in here. *@

<button type="button" class="bb-search-trigger" @ref="_trigger" @onclick="Open"
        aria-label="Search documentation" title="Search documentation (Ctrl+K)">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <span class="bb-search-trigger-label">Search docs</span>
    <span class="bb-search-trigger-keys" aria-hidden="true">
        <kbd>@(_isApple ? "⌘" : "Ctrl")</kbd><kbd>K</kbd>
    </span>
</button>

@if (_open)
{
    @* The scrim takes the click that closes the dialog. The dialog itself stops the click from
       reaching it, so a click inside never closes what the reader is using. *@
    <div class="bb-palette-scrim" @onclick="() => Close()">
        <div class="bb-palette" role="dialog" aria-modal="true" aria-label="Search documentation"
             @onclick:stopPropagation="true" @onkeydown="OnKeyDown">
            @* Focus trap. The dialog claims to be modal, so Tab must not walk out of it into the
               page behind - which is still there and still focusable. These two zero-size stops
               sit either side of the content: reaching one means the reader tabbed past an end,
               and focus is handed to the opposite end instead. Two elements and no interop.

               Not aria-hidden: an element that is focusable and hidden from assistive technology
               at the same time is a stop the screen reader has been told does not exist. They are
               empty and zero-size, so there is nothing to announce anyway, and focus leaves again
               in the same tick. *@
            <span class="bb-focus-sentinel" tabindex="0" @onfocus="() => _escape.FocusAsync()"></span>

            <div class="bb-palette-input">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input @ref="_input"
                       type="text"
                       placeholder="Search the documentation and demos…"
                       aria-label="Search documentation"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-expanded="true"
                       aria-controls="bb-palette-listbox"
                       aria-activedescendant="@(_results.Length > 0 ? $"bb-palette-option-{_activeIndex}" : null)"
                       autocomplete="off"
                       spellcheck="false"
                       value="@_query"
                       @oninput="OnInput" />
                <button type="button" class="bb-palette-esc" @ref="_escape" @onclick="() => Close()" aria-label="Close search">Esc</button>
            </div>

            <div class="bb-palette-results" id="bb-palette-listbox" role="listbox" aria-label="Search results">
                @if (_results.Length == 0)
                {
                    <p class="bb-palette-empty">
                        No match for <strong>@_query</strong>.
                        Try <em>guard</em>, <em>loader</em>, <em>outlet</em>, <em>keep-alive</em> or <em>constraint</em>.
                    </p>
                }
                else
                {
                    @* Grouped by the section each hit came from, in catalog order, so the list
                       reads as the site's own table of contents rather than as a flat ranking.
                       The keyboard cursor still walks the FLAT order, which is why each row's
                       position is looked up in _results rather than counted per group. *@
                    @foreach (var group in _results.GroupBy(hit => hit.Group))
                    {
                        <p class="bb-overline bb-palette-group" role="presentation" @key="group.Key">@group.Key</p>
                        @foreach (var hit in group)
                        {
                            var position = Array.IndexOf(_results, hit);
                            <div role="option"
                                 id="@($"bb-palette-option-{position}")"
                                 aria-selected="@(position == _activeIndex ? "true" : "false")"
                                 class="@(position == _activeIndex ? "bb-palette-hit bb-active" : "bb-palette-hit")"
                                 @key="hit.Url"
                                 @onmouseenter="() => _activeIndex = position"
                                 @onmousedown="() => Go(hit)" @onmousedown:preventDefault>
                                <span class="bb-palette-hit-title">@hit.Title</span>
                                <span class="bb-palette-hit-desc">@hit.Description</span>
                                <span class="bb-palette-hit-url">@hit.Url</span>
                            </div>
                        }
                    }
                }
            </div>

            <div class="bb-palette-foot">
                <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
                <span><kbd>Enter</kbd> to open</span>
                <span><kbd>Esc</kbd> to dismiss</span>
            </div>

            <span class="bb-focus-sentinel" tabindex="0" @onfocus="() => _input.FocusAsync()"></span>
        </div>
    </div>
}

@code {
    /// <summary>One row of the palette: a place on this site, and why it matched.</summary>
    private sealed record Hit(string Group, string Title, string Description, string Url, string Corpus);

    /// <summary>
    /// The live demos worth reaching by name. The documentation pages come from DocsCatalog, which
    /// already knows about every one of them; these are the routes a reader who has read the docs
    /// wants to jump back into, and nothing else on the site indexes them by name.
    /// </summary>
    private static readonly Hit[] _demos =
    [
        new("Demos", "Playground", "Every live demo on this site, grouped by feature area.", "/playground", "playground demos index live"),
        new("Demos", "Loader, cache & revalidation", "A loader with a 30s StaleTime, revalidation and query-driven paging.", "/data", "loader cache stale revalidate swr data paging"),
        new("Demos", "Deferred data", "A fast summary reveals, the slow half streams in behind BrouterAwait.", "/deferred", "deferred streaming await suspense slow"),
        new("Demos", "Error boundary & retry", "A loader that throws, caught by the route's own ErrorContent.", "/unstable", "error boundary retry throw failure"),
        new("Demos", "Unsaved-changes guard", "A leave guard that cancels preventively while the editor is dirty.", "/editor", "leave guard dirty unsaved editor prevent"),
        new("Demos", "Navigation lock & dialog", "A page-held lock that opens a custom confirmation before letting go.", "/lock/1", "lock dialog confirm deactivating renavigating"),
        new("Demos", "Navigation outcomes", "Trigger each NavigateAsync result: succeeded, cancelled, redirected, not found.", "/outcomes", "outcome navigateasync cancelled redirected notfound superseded"),
        new("Demos", "History entry state", "State attached to a history entry, read back across Back and Forward.", "/history-state", "history state back forward entry"),
        new("Demos", "Shared-element morph", "The view-transitions gallery: click a tile and watch it become the hero.", "/gallery", "gallery view transition morph shared element animation"),
        new("Demos", "Keep-alive note", "A kept-alive page whose state and timer survive leaving it.", "/sticky", "keep alive sticky retention state timer"),
        new("Demos", "Per-parameter keep-alive", "KeepAliveMax with LRU eviction across /notes/1, /notes/2, /notes/3.", "/notes/1", "keepalivemax lru per parameter notebook"),
        new("Demos", "Route lifecycle", "OnActivated, OnRenavigated and OnDeactivated firing live.", "/lifecycle/1", "lifecycle activated deactivated renavigated ibrouterroute"),
        new("Demos", "Named outlets & pathless group", "One child route filling two regions, under a shared guard.", "/dashboard/stats", "named outlet dashboard group pathless sidebar"),
        new("Demos", "Discovered @page route", "A component matched from its own @page directive, not from the route table.", "/discovered/7?q=hello", "discovery attribute page route appassembly"),
    ];

    private bool _open;
    private bool _isApple;
    private bool _focusPending;
    private bool _restorePending;
    private bool _revealPending;
    private string _query = "";
    private Hit[] _results = [];
    private int _activeIndex;

    private ElementReference _trigger;
    private ElementReference _input;
    private ElementReference _escape;
    private DotNetObjectReference<CommandPalette>? _self;

    [Inject] private IJSRuntime jsRuntime { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Neither call runs during prerendering - OnAfterRender does not fire there - so the
            // palette is simply inert until the client takes over, which is the correct behavior
            // for a control whose whole job is interactive.
            _self = DotNetObjectReference.Create(this);
            _isApple = await jsRuntime.InvokeAsync<bool>("bitBrouterSite.registerPalette", _self);
            StateHasChanged();
        }

        if (_focusPending)
        {
            _focusPending = false;
            await _input.FocusAsync();
        }

        if (_restorePending)
        {
            _restorePending = false;
            await _trigger.FocusAsync();
        }

        if (_revealPending)
        {
            _revealPending = false;
            // After the render that moved the cursor, not before: the row has to carry its new
            // class before its position is worth measuring.
            await jsRuntime.InvokeVoidAsync("bitBrouterSite.revealPaletteOption", _activeIndex);
        }
    }

    /// <summary>Opened by the document-level Ctrl+K / Cmd+K / "/" handler in site.js.</summary>
    [JSInvokable]
    public Task OpenFromShortcut()
    {
        if (_open is false) Open();
        return InvokeAsync(StateHasChanged);
    }

    private void Open()
    {
        _open = true;
        _query = "";
        _activeIndex = 0;
        // An empty query is not "no results": with nothing typed the palette is a table of
        // contents, which is a more useful blank state than an empty box.
        _results = Suggest();
        _focusPending = true;
        LockScroll(true);
    }

    /// <summary>
    /// Dismisses the dialog. The whole dialog is unmounted on close, so unless focus is handed
    /// somewhere deliberately it falls to &lt;body&gt; and the next Tab restarts at the top of the
    /// page - hence the trip back to the button that opened it. A close that ends in a navigation
    /// passes false: the new page decides where focus belongs, and moving it here would fight that.
    /// </summary>
    private void Close(bool restoreFocus = true)
    {
        _open = false;
        _query = "";
        _results = [];
        _activeIndex = 0;
        _revealPending = false;
        _restorePending = restoreFocus;
        LockScroll(false);
    }

    /// <summary>
    /// Holds the page still while the dialog is up, so a flick of the wheel scrolls the results
    /// rather than the document behind them. Not awaited: the open/close state is already correct
    /// in C#, and making the callers async would put a render between the click and the dialog.
    /// </summary>
    private void LockScroll(bool locked) => _ = jsRuntime.InvokeVoidAsync("bitBrouterSite.lockScroll", locked);

    private void OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _results = _query.Trim().Length == 0 ? Suggest() : Find(_query.Trim());
        _activeIndex = 0;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                Close();
                break;

            case "ArrowDown" when _results.Length > 0:
                // Wrapping, because a palette is a short list: falling off the end and landing back
                // at the top is what every other palette does, and it saves a reversal.
                _activeIndex = (_activeIndex + 1) % _results.Length;
                _revealPending = true;
                break;

            case "ArrowUp" when _results.Length > 0:
                _activeIndex = (_activeIndex - 1 + _results.Length) % _results.Length;
                _revealPending = true;
                break;

            case "Enter" when _results.Length > 0:
                Go(_results[Math.Clamp(_activeIndex, 0, _results.Length - 1)]);
                break;
        }
    }

    private void Go(Hit hit)
    {
        Close(restoreFocus: false);
        brouter.Navigate(hit.Url);
    }

    /// <summary>The blank state: the reading order of the docs, then the demos.</summary>
    private static Hit[] Suggest()
        => Regroup([.. Pages().Take(8), .. _demos.Take(4)]);

    /// <summary>
    /// The rows in the order they are RENDERED - grouped by section, groups in first-appearance
    /// order. The arrow keys walk the flat array, so it has to agree with what is on screen or
    /// pressing Down would move the cursor somewhere the eye is not.
    /// </summary>
    private static Hit[] Regroup(IEnumerable<Hit> hits)
        => [.. hits.GroupBy(hit => hit.Group).SelectMany(group => group)];

    /// <summary>
    /// Every term has to match somewhere, and the hits are ordered by WHERE they matched: a title
    /// that starts with the query first, then a title that contains it, then everything that only
    /// matched on its description or keywords. Ranking by position rather than by count keeps
    /// "guards" from being outranked by a page that merely says the word four times.
    /// </summary>
    private static Hit[] Find(string query)
    {
        var terms = query.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return Regroup(Pages().Concat(_demos)
            .Where(hit => terms.All(term => hit.Corpus.Contains(term, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(hit => hit.Title.StartsWith(query, StringComparison.OrdinalIgnoreCase) ? 0
                          : hit.Title.Contains(query, StringComparison.OrdinalIgnoreCase) ? 1 : 2)
            .Take(12));
    }

    private static IEnumerable<Hit> Pages()
        => DocsCatalog.Sections.SelectMany(section => section.Pages.Select(page =>
               new Hit(section.Title, page.Title, page.Description, page.Url,
                       $"{page.Title} {page.Description} {page.Keywords} {page.Url}")));

    public async ValueTask DisposeAsync()
    {
        if (_self is null) return;

        try
        {
            await jsRuntime.InvokeVoidAsync("bitBrouterSite.unregisterPalette");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; there is nothing on the other side to unregister from.
        }

        _self.Dispose();
        _self = null;
    }
}
