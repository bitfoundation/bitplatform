<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF" />
    <base href="/" />
    @* No static <title> here: every page supplies its own through <PageTitle>, and with
       prerendering the HeadOutlet emits a real <title> element into this head. A second,
       earlier one would win in the served HTML (browsers and crawlers take the first). *@
    <meta name="description" content="Brouter - a modern, declarative, nestable router for Blazor with async guards, data loaders, named routes and view transitions." />
    <link rel="stylesheet" href="app.css" />
    @* Synchronous on purpose: applies the light/dark theme before first paint. *@
    <script src="theme.js"></script>
    @* Scoped-CSS bundle: includes the client project's *.razor.css files as well. *@
    <link rel="stylesheet" href="Bit.Brouter.Demo.Server.styles.css" />
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    @* Prerendered on the server, then hydrated by the WebAssembly runtime. Routes.razor wraps
       Brouter's <AppRouter /> in the shared MainLayout - the router matches during
       OnInitializedAsync, so the matched page's HTML is already in this first response. *@
    <Routes @rendermode="InteractiveWebAssembly" />

    <script src="_framework/blazor.web.js"></script>
    <script src="site.js"></script>
</body>

</html>
