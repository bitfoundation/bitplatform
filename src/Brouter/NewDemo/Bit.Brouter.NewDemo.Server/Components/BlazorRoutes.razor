@*
    Standard Blazor router. Its only job here is endpoint routing: it funnels every request to
    the single catch-all Host page (see Host.razor). The actual route matching is done by
    Bit.Brouter inside that page's <AppRouter />. DefaultLayout points at the shared MainLayout
    from the Core project so every demo head looks identical.

    Named BlazorRoutes (not Routes) to avoid colliding with Bit.Brouter.Demo.Core.Routes, which
    is in scope via _Imports.
*@
<Router AppAssembly="@typeof(BlazorRoutes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
</Router>
