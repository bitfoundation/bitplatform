@* Component-level navigation lock. The page derives from BrouterRouteBase and overrides the two
   awaited, cancellable lock callbacks: OnDeactivatingAsync (leaving the route) and
   OnRenavigatingAsync (the route stays matched - /lock/1 -> /lock/2 - which a route-declared
   LeaveGuard can never veto). While dirty, both park the pending navigation on a
   TaskCompletionSource and show a custom dialog; the answer cancels it or lets it proceed.
   Compare /editor, where the deactivation-only veto lives on the route declaration. *@

@inherits BrouterRouteBase

<h1>Navigation lock <span class="muted">/lock/@Id</span></h1>

<div class="card">
    <input @bind="_draft" @bind:event="oninput" placeholder="Type to make the draft dirty…" />
    <p class="muted" style="margin: .5rem 0;">
        Status: <strong>@(IsDirty ? "dirty - navigation is locked" : "saved")</strong>
    </p>
    <button @onclick="Save" disabled="@(IsDirty is false)">Save draft</button>
</div>

<div class="row">
    <BrouterLink Href="/lock/1" class="btn">/lock/1 (renavigation)</BrouterLink>
    <BrouterLink Href="/lock/2" class="btn">/lock/2 (renavigation)</BrouterLink>
    <BrouterLink Href="/" class="btn">Home (deactivation)</BrouterLink>
</div>

<p class="muted">
    A parameter change keeps this route matched, so a route-declared <code>LeaveGuard</code> would
    never fire - <code>OnRenavigating</code> is what protects the dirty draft there. The URL never
    changes while the dialog is open, so history is never corrupted.
</p>

@if (_prompt is not null)
{
    <div class="backdrop">
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="lock-title"
             tabindex="-1" @ref="_promptDialog">
            <h2 id="lock-title">Unsaved changes</h2>
            <p>Leave for <code>@_promptTarget</code> anyway?</p>
            <div class="row">
                <button @onclick="@(() => AnswerPrompt(stay: true))">Stay here</button>
                <button @onclick="@(() => AnswerPrompt(stay: false))">Leave &amp; discard</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private string _saved = string.Empty;
    private string _draft = string.Empty;
    private bool IsDirty => string.Equals(_draft, _saved, StringComparison.Ordinal) is false;

    // The parked decision of the currently open dialog: the lock callback awaits it, the buttons
    // complete it. The result encodes the outcome: true = stay, false = leave & discard, null =
    // dismissed by a superseding navigation, which must neither cancel nor touch the draft.
    private TaskCompletionSource<bool?>? _prompt;
    private string? _promptTarget;
    private ElementReference _promptDialog;
    private bool _focusPrompt;

    private void Save() => _saved = _draft;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move focus into the just-opened dialog so screen readers announce it and keyboard users
        // are not left on the link that triggered the parked navigation.
        if (_focusPrompt)
        {
            _focusPrompt = false;
            await _promptDialog.FocusAsync();
        }
    }

    private void AnswerPrompt(bool stay) => _prompt?.TrySetResult(stay);

    protected override Task OnDeactivatingAsync(BrouterRouteDeactivatingContext context)
        => ConfirmLeaveAsync(context.To, context.CancellationToken, context.Cancel);

    protected override Task OnRenavigatingAsync(BrouterRouteRenavigatingContext context)
        => ConfirmLeaveAsync(context.To, context.CancellationToken, context.Cancel);

    private async Task ConfirmLeaveAsync(BrouterLocation to, System.Threading.CancellationToken token, Action cancel)
    {
        if (IsDirty is false) return;

        // Everything below binds to THIS prompt instance: a superseding navigation's own lock can
        // open a replacement dialog before this parked await has finished unwinding, and the
        // unwind must not touch the replacement.
        var prompt = new TaskCompletionSource<bool?>(TaskCreationOptions.RunContinuationsAsynchronously);
        _prompt = prompt;
        _promptTarget = to.Path + to.Query;
        _focusPrompt = true;
        StateHasChanged(); // show the dialog; the navigation stays parked on the await below

        // A superseding navigation cancels the token: dismiss the dialog (null - no user decision).
        await using var dismiss = token.Register(() => prompt.TrySetResult(null));
        var stay = await prompt.Task;

        // Close the dialog only while it is still this prompt's; a newer prompt owns the UI otherwise.
        if (ReferenceEquals(_prompt, prompt))
        {
            _prompt = null;
            _promptTarget = null;
            StateHasChanged();
        }

        if (stay is null) return; // dismissed, not answered: keep the draft dirty

        if (stay.Value) cancel();
        else _draft = _saved; // leaving: drop the draft so a renavigated instance is not still dirty
    }
}
