@page "/interop"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>JS Interop</PageTitle>

<h1>JS Interop</h1>
<p class="muted">Every call below goes through the <code>IJSRuntime</code> injected into this component, so BevTools → JS Interop attributes it to <code>Interop</code> with duration and result. JS → .NET callbacks are reported by the browser bridge.</p>

<div class="row">
    <button class="primary" @onclick="Measure">Measure element</button>
    <button @onclick="() => Slow(400)">Slow call (400 ms busy JS)</button>
    <button @onclick="Chatty">Chatty loop (120 calls)</button>
    <button @onclick="ToggleCallbacks">@(_callbacks ? "Stop" : "Start") JS → .NET callbacks (every 200 ms)</button>
    <button @onclick="ThrowInJs">JS function throws</button>
    <button @onclick="UnhandledJs">Unhandled JS error + rejection</button>
    <button @onclick="WriteStorage">Write localStorage/sessionStorage</button>
</div>

<div id="measure-target" class="card">
    <h3>Measured element</h3>
    <div>@_result</div>
    <div class="muted">callbacks received: @_ticks</div>
</div>

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<Interop>? _self;
    private string _result = "–";
    private int _ticks;
    private bool _callbacks;

    private async Task<IJSObjectReference> Module() => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");

    private async Task Measure()
    {
        var m = await (await Module()).InvokeAsync<Dictionary<string, int>?>("measure", "#measure-target");
        _result = m is null ? "not found" : string.Join(", ", m.Select(kv => kv.Key + "=" + kv.Value));
    }

    private async Task Slow(int ms) => _result = "slow call returned " + await (await Module()).InvokeAsync<int>("slowCall", ms);

    private async Task Chatty()
    {
        var module = await Module();
        double last = 0;
        for (var i = 0; i < 120; i++)
        {
            last = await module.InvokeAsync<double>("ping");
        }

        _result = "chatty loop done, last ping " + last.ToString("0");
    }

    private async Task ToggleCallbacks()
    {
        var module = await Module();
        if (_callbacks)
        {
            await module.InvokeVoidAsync("stopCallbacks");
            _callbacks = false;
        }
        else
        {
            _self ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("startCallbacks", _self, 200);
            _callbacks = true;
        }
    }

    [JSInvokable]
    public void OnTick(long now)
    {
        _ticks++;
        StateHasChanged();
    }

    private async Task ThrowInJs()
    {
        try
        {
            await (await Module()).InvokeVoidAsync("throwError");
        }
        catch (JSException ex)
        {
            _result = "caught: " + ex.Message.Split('\n')[0];
        }
    }

    private async Task UnhandledJs() => await (await Module()).InvokeVoidAsync("triggerUnhandledError");

    private async Task WriteStorage()
    {
        await (await Module()).InvokeVoidAsync("writeStorage");
        _result = "storage written; open BevTools → Browser → Read storage";
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stopCallbacks");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
