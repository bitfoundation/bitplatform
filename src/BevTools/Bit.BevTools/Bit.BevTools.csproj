<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>Bit.BevTools</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageDescription>Runtime instrumentation and in-app developer tools for Blazor: component tree, render profiler, event timeline, state, network, JS interop, errors, DI inspector and diagnostics.</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;devtools;diagnostics;profiler;debugging</PackageTags>
        <!-- BevTools reads Blazor internals (ComponentBase._renderFragment, the renderer's component state map) through
             cached reflection accessors, each of which degrades to a reported capability gap when the member is missing.
             That is deliberate and development-time only, so the assembly is not trim- or AOT-safe and says so rather
             than carrying suppressions that would hide the fact from a consumer's publish. -->
        <IsTrimmable>false</IsTrimmable>
        <IsAotCompatible>false</IsAotCompatible>
        <!-- BL0006: RenderTree types are read on purpose, to measure render batches. -->
        <NoWarn>$(NoWarn);BL0006</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <!-- Use floating low-bound version ranges so consumers can pin to any patch release on
             their TFM. Pinning to an exact version (e.g. "8.0.0") forced applications onto that
             specific patch even when they wanted a newer servicing release. The upper bound
             prevents accidentally pulling a major-version package that targets a newer TFM. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[8.0.0,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.Extensions.Http" Version="[8.0.0,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.Extensions.Http" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.Http" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.Extensions.Hosting.Abstractions" Version="[8.0.0,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.Extensions.Hosting.Abstractions" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.Hosting.Abstractions" Version="[10.0.0,11.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.BevTools.Abstractions\Bit.BevTools.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.BevTools.Server" PublicKey="" />
        <InternalsVisibleTo Include="Bit.BevTools.Tests" PublicKey="" />
    </ItemGroup>

    <!-- Build inputs, not content: as Content they would be copied into every referencing app's output and publish
         folder (the demo's included). -->
    <ItemGroup>
        <Content Remove="package*.json;tsconfig.json" />
        <None Include="package*.json;tsconfig.json" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="Scripts\**\*.ts" />
    </ItemGroup>

    <!-- Restores npm packages then compiles the TypeScript into wwwroot. Both sub-targets are
         incremental via their Inputs/Outputs, so this is a no-op when nothing changed. -->
    <Target Name="BuildBevToolsJavaScript" DependsOnTargets="InstallNodejsDependencies;BuildJavaScript" />

    <!-- The output (wwwroot/bit-bevtools.js) is a generated, git-ignored file. On a clean build it does
         not exist when the default "wwwroot/**" Content glob is evaluated, so the static web asset
         discovery in ResolveProjectStaticWebAssets would miss it and consumers get a 404 for
         _content/Bit.BevTools/bit-bevtools.js (the panel would then report the browser bridge as missing).

         ResolveProjectStaticWebAssets runs BeforeTargets="AssignTargetPaths" and does NOT depend on
         ResolveStaticWebAssetsInputs, so an ResolveStaticWebAssetsInputsDependsOn hook would never run
         early enough. Hooking BeforeTargets="ResolveProjectStaticWebAssets" guarantees the file is
         generated first (DependsOnTargets) and then explicitly added to @(Content) so discovery picks
         it up. The Remove-before-Include keeps it to a single Content entry (avoiding a duplicate /
         conflicting-target-path error) for builds where the glob already captured it. -->
    <Target Name="IncludeBevToolsJavaScriptAsStaticWebAsset"
            BeforeTargets="ResolveProjectStaticWebAssets"
            DependsOnTargets="BuildBevToolsJavaScriptOnce">
        <ItemGroup>
            <Content Remove="wwwroot\bit-bevtools.js" />
            <Content Include="wwwroot\bit-bevtools.js" />
        </ItemGroup>
    </Target>

    <!-- Runs BuildBevToolsJavaScript through the MSBuild task with TargetFramework removed, so every
         per-TFM build asks for the same project configuration. MSBuild keeps one result per project and
         global properties: the first request runs tsc/esbuild, concurrent ones wait for that result, and
         later ones reuse it. Calling BuildBevToolsJavaScript directly from each inner build is not enough
         even with the cross-targeting target below: a ProjectReference (Bit.BevTools.Server, the tests)
         builds this project's inner builds directly - one per referencing target framework, in parallel -
         without ever running the outer build, so each of them would run tsc against the same
         wwwroot/bit-bevtools.js and fail intermittently with "EBUSY: resource busy or locked". -->
    <Target Name="BuildBevToolsJavaScriptOnce">
        <MSBuild Projects="$(MSBuildProjectFullPath)"
                 Targets="BuildBevToolsJavaScript"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
    </Target>

    <!-- In a multi-targeted build, produce the output exactly once in the outer (cross-targeting)
         build, before the per-TFM inner builds are dispatched. The Condition is evaluated at execution
         time (when IsCrossTargetingBuild is set), so the target only runs in the outer build; inner
         builds emit a harmless "DispatchToInnerBuilds does not exist" message at detailed verbosity only. -->
    <Target Name="BuildBevToolsJavaScriptOnCrossTargeting"
            BeforeTargets="DispatchToInnerBuilds"
            Condition="'$(IsCrossTargetingBuild)' == 'true'"
            DependsOnTargets="BuildBevToolsJavaScript" />

    <!-- Use the checked-in package-lock.json with `npm ci` (not `npm install`) so the installed tree is
         reproducible and exactly matches the lockfile - `npm ci` fails fast when package.json and the
         lockfile drift, instead of silently mutating the lock. The lockfile is an input so a dependency
         bump re-triggers the install; node_modules\.package-lock.json (written by npm) is the output. -->
    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm ci" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <!-- The output differs per configuration (Release is minified) but lands in the same file, so the
         TypeScript inputs alone can't drive the up-to-date check: after a Debug build, a Release build
         would see wwwroot/bit-bevtools.js newer than the sources and skip, shipping unminified JS (and
         vice versa). A per-configuration stamp in obj/ makes switching configurations invalidate the
         check; the stale stamp of the other configuration is deleted so switching back rebuilds too. -->
    <Target Name="BuildJavaScript" Inputs="@(TypeScriptFiles);tsconfig.json" Outputs="wwwroot/bit-bevtools.js;obj/bit-bevtools-$(Configuration).stamp">
        <ItemGroup>
            <_BevToolsStaleJsStamps Include="obj\bit-bevtools-*.stamp" Exclude="obj\bit-bevtools-$(Configuration).stamp" />
        </ItemGroup>
        <Delete Files="@(_BevToolsStaleJsStamps)" />
        <Exec Command="node_modules/.bin/tsc" StandardOutputImportance="high" StandardErrorImportance="high" />
        <!-- Minify to a temp file and move it into place, rather than overwriting the input in-place.
             An interrupted in-place minify could leave a half-written file that the Outputs check
             above then treats as up-to-date, requiring a clean to recover. The Move is atomic enough
             to avoid that. The esbuild "esm" format keeps the exports that the C# side imports as a module. -->
        <Exec Condition=" '$(Configuration)' == 'Release' " Command="node_modules/.bin/esbuild wwwroot/bit-bevtools.js --minify --format=esm --outfile=wwwroot/bit-bevtools.min.js" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Move Condition=" '$(Configuration)' == 'Release' " SourceFiles="wwwroot/bit-bevtools.min.js" DestinationFiles="wwwroot/bit-bevtools.js" OverwriteReadOnlyFiles="true" />
        <MakeDir Directories="obj" />
        <Touch Files="obj/bit-bevtools-$(Configuration).stamp" AlwaysCreate="true" />
    </Target>

</Project>
