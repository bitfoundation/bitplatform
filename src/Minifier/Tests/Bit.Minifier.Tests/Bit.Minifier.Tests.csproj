<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <OutputType>Exe</OutputType>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.4.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Minifier\Bit.Minifier.csproj" />
        <!-- Copied next to the tests as the input to minify; the tests only ever load them into their own contexts. -->
        <ProjectReference Include="..\Bit.Minifier.Tests.Friend\Bit.Minifier.Tests.Friend.csproj" />
    </ItemGroup>

</Project>
