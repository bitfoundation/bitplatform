{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "ES2019",
        // bit-bcrdt.js is loaded by BcrdtTextArea through a dynamic `import()` and its functions are called as
        // named module exports, so the output must stay an ES module: `module: ESNext` with `rootDir`/`outDir`
        // emits Scripts/bit-bcrdt.ts straight to wwwroot/bit-bcrdt.js with its `export`s preserved.
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [ "DOM", "DOM.Iterable", "ESNext" ],
        "rootDir": "Scripts",
        "outDir": "wwwroot",
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [ "./Scripts/**/*.ts" ]
}
