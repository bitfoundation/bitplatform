<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The same pages as the MAUI sample, hosted in a Windows Forms BlazorWebView: the Hybrid setup without the MAUI
         workload. Everything Belemetry does here (the Relay transport, file persistence, the flush when the window
         closes) is what it does in MAUI, WPF and WinUI - they share the BlazorWebView core. -->

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- Lets the solution build on a Linux CI runner; running it still needs Windows. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);ClassWithoutModifierAnalyzer</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.110" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\Bit.Belemetry.Samples.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Only because this sample references Bit.Belemetry as a project: the package imports this on its own. -->
    <Import Project="..\..\Bit.Belemetry\buildTransitive\Bit.Belemetry.props" />

</Project>
