<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
        <ProjectReference Include="..\..\Core\Bit.Belemetry.Samples.Core.csproj" />
    </ItemGroup>

    <!-- Only because this sample references Bit.Belemetry as a project: the package imports this on its own. It turns
         System.Diagnostics.Metrics back on, which the WebAssembly SDK turns off by default. -->
    <Import Project="..\..\..\Bit.Belemetry\buildTransitive\Bit.Belemetry.props" />

</Project>
