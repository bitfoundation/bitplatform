<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <!-- The host owns the launch profile: this project is never started on its own. -->
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <!-- Publishes this project's static web assets at the app root (not under _content/), the
             way a Blazor Web App's client project is expected to contribute them. -->
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Belemetry\Bit.Belemetry.csproj" />
    </ItemGroup>

    <!-- Only because the demo references Bit.Belemetry as a project: the package imports this on its own. It turns
         System.Diagnostics.Metrics back on, which the WebAssembly SDK turns off by default - without it, the .NET
         instrumentation page's counter, histogram and up-down counter would never reach the Live telemetry page. -->
    <Import Project="..\..\Bit.Belemetry\buildTransitive\Bit.Belemetry.props" />

</Project>
