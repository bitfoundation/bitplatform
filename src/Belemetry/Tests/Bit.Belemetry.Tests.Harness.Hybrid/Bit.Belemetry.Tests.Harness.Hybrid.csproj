<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- Blazor Hybrid host for the harness, to exercise the Relay transport: in a BlazorWebView the browser script
         hands its records to .NET over JS interop, and the app process exports them. WinForms rather than MAUI: both
         sit on the same Microsoft.AspNetCore.Components.WebView core, and on Windows both render through WebView2,
         which Playwright can drive over the Chrome DevTools Protocol. WinForms gets there without the MAUI workload. -->

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- Lets it build on a Linux CI runner; running it still needs Windows. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.110" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Belemetry.Tests.Harness\Bit.Belemetry.Tests.Harness.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
