<Project Sdk="Microsoft.NET.Sdk">

    <!-- The Hangfire filter against a real server (in-memory storage): the span of an execution, its parent from the
         enqueue, failures and the filter, on every target framework the package ships for. -->

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\..\AssemblyOriginatorKeyFile.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.5.1" />
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.Extensions.Logging" Version="8.0.1" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.Extensions.Logging" Version="9.0.21" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.Logging" Version="10.0.13" />
        <PackageReference Include="Hangfire.Core" Version="1.8.25" />
        <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
        <!-- Hangfire's floor is a Newtonsoft.Json with a known advisory; an app lifts it the way this does. -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Belemetry.Hangfire\Bit.Belemetry.Hangfire.csproj" />
    </ItemGroup>

</Project>
