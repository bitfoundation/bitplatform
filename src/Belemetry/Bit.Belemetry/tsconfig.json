{
    "compilerOptions": {
        "target": "ES2019",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [ "DOM", "DOM.Iterable", "ES2020" ],
        // tsc only type-checks; esbuild bundles Scripts/bit-belemetry.ts into wwwroot/bit-belemetry.js.
        "noEmit": true,
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true
    },
    "include": [ "./Scripts/**/*.ts" ]
}
