<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <PropertyGroup>
        <!-- The package ships its own Bit.Belemetry.props (buildTransitive\Bit.Belemetry.props, below), which takes the
             package paths of the three the Razor SDK generates to wire up static web assets. The SDK's own guidance for
             a package with build logic of its own: turn its files off, and import the static web assets props from
             yours - which that file does. -->
        <StaticWebAssetsDisableProjectBuildPropsFileGeneration>true</StaticWebAssetsDisableProjectBuildPropsFileGeneration>
        <StaticWebAssetsDisableProjectBuildMultiTargetingPropsFileGeneration>true</StaticWebAssetsDisableProjectBuildMultiTargetingPropsFileGeneration>
        <StaticWebAssetsDisableProjectBuildTransitivePropsFileGeneration>true</StaticWebAssetsDisableProjectBuildTransitivePropsFileGeneration>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <!-- Use floating low-bound version ranges so consumers can pin to any patch release on
             their TFM. The upper bound prevents accidentally pulling a major-version package that
             targets a newer TFM. Everything else Belemetry needs (ActivityListener, MeterListener,
             ILogger, Options, System.Text.Json) comes with the shared framework or transitively
             from this package - deliberately no OpenTelemetry packages. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[8.0.0,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[10.0.0,11.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System" />
        <Using Include="System.IO" />
        <Using Include="System.Linq" />
        <Using Include="System.Net.Http" />
        <Using Include="System.Threading" />
        <Using Include="System.Threading.Tasks" />
        <Using Include="System.Collections.Generic" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.Belemetry.Tests" PublicKey="" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="tsconfig.json" />
        <None Include="tsconfig.json" />
        <Content Remove="package.json;package-lock.json" />
        <None Include="package.json;package-lock.json" />
        <!-- Consumer-side build defaults (MetricsSupport) plus the static web assets import, as the package's one
             Bit.Belemetry.props in each of the folders NuGet looks in. Included rather than updated: pack collects it
             in the outer, cross-targeting build, which has no default None items for an Update to match. -->
        <None Remove="buildTransitive\Bit.Belemetry.props" />
        <None Include="buildTransitive\Bit.Belemetry.props" Pack="true" PackagePath="build\;buildMultiTargeting\;buildTransitive\" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="Scripts\**\*.ts" />
    </ItemGroup>

    <!-- Restores npm packages then type-checks and bundles the TypeScript into wwwroot. Both sub-targets
         are incremental via their Inputs/Outputs, so this is a no-op when nothing changed. -->
    <Target Name="BuildBelemetryJavaScript" DependsOnTargets="InstallNodejsDependencies;BuildJavaScript" />

    <!-- The output (wwwroot/bit-belemetry.js) is a generated, git-ignored file. On a clean build it does
         not exist when the default "wwwroot/**" Content glob is evaluated, so the static web asset
         discovery in ResolveProjectStaticWebAssets would miss it and consumers would get a 404 for
         _content/Bit.Belemetry/bit-belemetry.js. Hooking BeforeTargets="ResolveProjectStaticWebAssets"
         guarantees the file is generated first and then explicitly added to @(Content) so discovery picks
         it up. The Remove-before-Include keeps it to a single Content entry for builds where the glob
         already captured it. -->
    <Target Name="IncludeBelemetryJavaScriptAsStaticWebAsset"
            BeforeTargets="ResolveProjectStaticWebAssets"
            DependsOnTargets="BuildBelemetryJavaScriptOnce">
        <ItemGroup>
            <Content Remove="wwwroot\bit-belemetry.js" />
            <Content Include="wwwroot\bit-belemetry.js" />
        </ItemGroup>
    </Target>

    <!-- Runs BuildBelemetryJavaScript through the MSBuild task with TargetFramework removed, so every
         per-TFM build asks for the same project configuration. MSBuild keeps one result per project and
         global properties: the first request runs tsc/esbuild, concurrent ones wait for it, and later ones
         reuse it. A ProjectReference builds the inner builds directly (one per referencing TFM, in
         parallel) without the outer build, so calling the target from each of them raced on the shared
         wwwroot output ("EBUSY: resource busy or locked"). -->
    <Target Name="BuildBelemetryJavaScriptOnce">
        <MSBuild Projects="$(MSBuildProjectFullPath)"
                 Targets="BuildBelemetryJavaScript"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
    </Target>

    <!-- In a multi-targeted build, produce the output once in the outer (cross-targeting) build, before
         the per-TFM inner builds are dispatched. -->
    <Target Name="BuildBelemetryJavaScriptOnCrossTargeting"
            BeforeTargets="DispatchToInnerBuilds"
            Condition="'$(IsCrossTargetingBuild)' == 'true'"
            DependsOnTargets="BuildBelemetryJavaScript" />

    <!-- `npm ci` against the checked-in lockfile keeps the installed tree reproducible and fails fast when
         package.json and the lockfile drift. The lockfile is an input so a dependency bump re-installs. -->
    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm ci" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <!-- Unlike Bit.Brouter (whose single script tsc emits as-is), the instrumentations live in several
         modules, so tsc only type-checks (noEmit) and esbuild bundles them into one ES module. Shipping one
         file keeps it to a single request on the critical path - the script has to load early to see the
         initial page load, web vitals and early errors.

         The output differs per configuration (Release is minified) but lands in the same file, so a
         per-configuration stamp in obj/ makes switching configurations invalidate the up-to-date check;
         the stamp of the other configuration is deleted so switching back rebuilds too. -->
    <Target Name="BuildJavaScript"
            Inputs="@(TypeScriptFiles);tsconfig.json"
            Outputs="wwwroot/bit-belemetry.js;$(BaseIntermediateOutputPath)bit-belemetry.$(Configuration).stamp">
        <PropertyGroup>
            <_BelemetryMinify Condition=" '$(Configuration)' == 'Release' ">--minify</_BelemetryMinify>
        </PropertyGroup>
        <Exec Command="node_modules/.bin/tsc --noEmit -p tsconfig.json" StandardOutputImportance="high" StandardErrorImportance="high" />
        <!-- Bundle to a temp file and move it into place, so an interrupted build never leaves a half-written
             bundle that the Outputs check above would treat as up-to-date. -->
        <Exec Command="node_modules/.bin/esbuild Scripts/bit-belemetry.ts --bundle --format=esm --target=es2019 $(_BelemetryMinify) --outfile=wwwroot/bit-belemetry.tmp.js" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Move SourceFiles="wwwroot/bit-belemetry.tmp.js" DestinationFiles="wwwroot/bit-belemetry.js" OverwriteReadOnlyFiles="true" />
        <ItemGroup>
            <_BelemetryBuildStamp Include="$(BaseIntermediateOutputPath)bit-belemetry.*.stamp" />
        </ItemGroup>
        <Delete Files="@(_BelemetryBuildStamp)" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)" />
        <Touch Files="$(BaseIntermediateOutputPath)bit-belemetry.$(Configuration).stamp" AlwaysCreate="true" />
    </Target>

</Project>
