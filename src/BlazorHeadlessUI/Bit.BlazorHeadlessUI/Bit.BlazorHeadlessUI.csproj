<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <!-- The demo and the tests run on the latest TFM, so Debug builds compile net11.0 alone.
             Release (pack, CI) builds both; pass -p:BuildAllTfms=true to get them in Debug too. -->
        <TargetFrameworks Condition=" '$(Configuration)' == 'Debug' And '$(BuildAllTfms)' != 'true' ">net11.0</TargetFrameworks>
        <RootNamespace>Bit.BlazorHeadlessUI</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <PackageTags>Bit;Blazor;Headless;Unstyled;Accessibility;A11y;Aria;WAI-ARIA;Components</PackageTags>
        <Description>Accessible, unstyled UI primitives for Blazor: keyboard interaction, focus management, positioning, dismissal and WAI-ARIA semantics without any visual opinion.</Description>
        <PackageDescription>$(Description)</PackageDescription>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <!-- The upper bounds are the lowest prerelease of the next major (-0): NuGet orders 11.0.0-rc.x below 11.0.0,
             so a plain 11.0.0 bound would still let a net11-only prerelease into the net10.0 range. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[10.0.0,11.0.0-0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[11.0.0-rc.3.26522.148,12.0.0-0)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.BlazorHeadlessUI.Tests" PublicKey="" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="tsconfig.json;package.json;package-lock.json" />
        <None Include="tsconfig.json;package.json" />
        <Watch Include="$(MSBuildProjectDirectory)\Scripts\**\*.ts" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="Scripts\**\*.ts" />
    </ItemGroup>

    <!-- Restores npm packages then compiles the TypeScript. Both sub-targets are incremental through their
         Inputs/Outputs, so this is a no-op when nothing changed. -->
    <Target Name="BuildBlazorHeadlessUIJavaScript" DependsOnTargets="InstallNodejsDependencies;BuildJavaScript" />

    <!-- The scripts under wwwroot are generated and git-ignored. On a clean build they do not exist when the default
         wwwroot/** Content glob is evaluated, so static web asset discovery would miss them and an app would get a 404
         for _content/Bit.BlazorHeadlessUI/bit-blazorheadlessui.js. Generating them before ResolveProjectStaticWebAssets
         and adding them to Content explicitly makes discovery pick them up (Remove first keeps a single entry). -->
    <Target Name="IncludeBlazorHeadlessUIJavaScriptAsStaticWebAsset"
            BeforeTargets="ResolveProjectStaticWebAssets"
            DependsOnTargets="BuildBlazorHeadlessUIJavaScript">
        <ItemGroup>
            <Content Remove="wwwroot\bit-blazorheadlessui.js;wwwroot\Bit.BlazorHeadlessUI.lib.module.js" />
            <Content Include="wwwroot\bit-blazorheadlessui.js;wwwroot\Bit.BlazorHeadlessUI.lib.module.js" />
        </ItemGroup>
    </Target>

    <!-- In a multi-targeted build, produce the scripts once in the outer build, before the per-TFM inner builds are
         dispatched, so several inner builds never run tsc / esbuild against the same output files at once. -->
    <Target Name="BuildBlazorHeadlessUIJavaScriptOnCrossTargeting"
            BeforeTargets="DispatchToInnerBuilds"
            Condition="'$(IsCrossTargetingBuild)' == 'true'"
            DependsOnTargets="BuildBlazorHeadlessUIJavaScript" />

    <!-- npm ci (not npm install) keeps the installed tree exactly what the checked-in lockfile says. -->
    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm ci" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <Target Name="BuildJavaScript"
            Inputs="@(TypeScriptFiles);tsconfig.json"
            Outputs="wwwroot/bit-blazorheadlessui.js;wwwroot/Bit.BlazorHeadlessUI.lib.module.js;$(BaseIntermediateOutputPath)bit-blazorheadlessui.$(Configuration).stamp">
        <Exec Command="node node_modules/typescript/bin/tsc" StandardOutputImportance="high" StandardErrorImportance="high" />
        <!-- Minify into a temp file and move it into place: an interrupted in-place minify would leave a half-written
             script that the Outputs check above takes for up to date. format=esm keeps the named exports the interop's
             import() resolves. -->
        <Exec Condition=" '$(Configuration)' == 'Release' " Command="node node_modules/esbuild/bin/esbuild wwwroot/bit-blazorheadlessui.js --minify --format=esm --outfile=wwwroot/bit-blazorheadlessui.min.js" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Move Condition=" '$(Configuration)' == 'Release' " SourceFiles="wwwroot/bit-blazorheadlessui.min.js" DestinationFiles="wwwroot/bit-blazorheadlessui.js" OverwriteReadOnlyFiles="true" />

        <!-- Only Release minifies, so a per-configuration stamp keeps a Debug (unminified) script from being taken for
             up to date by a Release build and the other way round. -->
        <ItemGroup>
            <_BlazorHeadlessUIBuildStamp Include="$(BaseIntermediateOutputPath)bit-blazorheadlessui.*.stamp" />
        </ItemGroup>
        <Delete Files="@(_BlazorHeadlessUIBuildStamp)" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)" />
        <Touch Files="$(BaseIntermediateOutputPath)bit-blazorheadlessui.$(Configuration).stamp" AlwaysCreate="true" />
    </Target>

</Project>
