@using Microsoft.JSInterop
@inherits TestBase
@attribute [TestClass]

@code {
    private RenderFragment List(Stateful<List<string>> s, Action<BitBhReorderEventArgs<string>>? onReorder = null) =>
        @<BitBhSortable TItem="string" Items="s.Value!" ItemsChanged="items => s.Set(items.ToList())"
                     OnReorder="e => onReorder?.Invoke(e)" aria-label="Priorities" Context="item">
            <BitBhSortableHandle TItem="string" aria-label="@($"Reorder {item.Item}")">⠿</BitBhSortableHandle>
            @item.Item
        </BitBhSortable>;

    private IRenderedComponent<Bunit.Rendering.ContainerFragment> RenderList(Action<BitBhReorderEventArgs<string>>? onReorder = null)
        => Render(@<Stateful T="List<string>" Initial="@(["Alpha", "Beta", "Gamma"])" Context="s">@List(s, onReorder)</Stateful>);

    private static string[] Order(IRenderedComponent<Bunit.Rendering.ContainerFragment> cut)
        => cut.FindAll("li").Select(li => li.TextContent.Replace("⠿", "").Trim()).ToArray();

    [TestMethod]
    public void Handles_are_described_by_the_instructions()
    {
        var cut = RenderList();
        var handle = cut.FindAll("[data-bit-bh-sortable-handle]")[0];
        Assert.AreEqual("Reorder Alpha", handle.AccessibleName());
        Assert.StartsWith("To pick up an item, press Space or Enter.", handle.AccessibleDescription());
        Assert.AreEqual("false", handle.GetAttribute("aria-pressed"));
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public async Task Keyboard_pick_up_move_and_drop_with_announcements()
    {
        BitBhReorderEventArgs<string>? reorder = null;
        var cut = RenderList(e => reorder = e);

        cut.FindAll("[data-bit-bh-sortable-handle]")[0].Press(" ");
        Assert.AreEqual("true", cut.FindAll("[data-bit-bh-sortable-handle]")[0].GetAttribute("aria-pressed"));
        await Announcer.WaitForAsync("Picked up Alpha. Position 1 of 3.");

        cut.FindAll("[data-bit-bh-sortable-handle]")[0].Press("ArrowDown");
        Assert.AreSequenceEqual(new[] { "Beta", "Alpha", "Gamma" }, Order(cut));
        await Announcer.WaitForAsync("Alpha moved to position 2 of 3.");
        // Focus follows the moved item.
        Assert.AreEqual(cut.FindAll("[data-bit-bh-sortable-handle]")[1].Id, this.LastFocusRequest());

        cut.FindAll("[data-bit-bh-sortable-handle]")[1].Press("Enter");
        await Announcer.WaitForAsync("Dropped Alpha at position 2 of 3.");
        Assert.AreSequenceEqual(new[] { "Beta", "Alpha", "Gamma" }, cut.FindComponent<Stateful<List<string>>>().Instance.Value!);
        Assert.AreEqual(new BitBhReorderEventArgs<string>("Alpha", 0, 1), reorder);
        Assert.AreEqual("false", cut.FindAll("[data-bit-bh-sortable-handle]")[1].GetAttribute("aria-pressed"));
    }

    [TestMethod]
    public async Task Escape_cancels_and_restores_the_order()
    {
        var cut = RenderList();
        cut.FindAll("[data-bit-bh-sortable-handle]")[2].Press(" ");
        cut.FindAll("[data-bit-bh-sortable-handle]")[2].Press("ArrowUp");
        Assert.AreSequenceEqual(new[] { "Alpha", "Gamma", "Beta" }, Order(cut));

        cut.FindAll("[data-bit-bh-sortable-handle]")[1].Press("Escape");
        Assert.AreSequenceEqual(new[] { "Alpha", "Beta", "Gamma" }, Order(cut));
        await Announcer.WaitForAsync("Reordering cancelled. Gamma returned to position 3.");
        Assert.AreEqual(0, cut.FindComponent<Stateful<List<string>>>().Instance.Changes);
    }

    [TestMethod]
    public void Keys_typed_before_the_focus_follows_the_moved_item_still_drive_the_grab()
    {
        var cut = RenderList();
        cut.FindAll("[data-bit-bh-sortable-handle]")[0].Press(" ");
        cut.FindAll("[data-bit-bh-sortable-handle]")[0].Press("ArrowDown");

        // Handles are positional: until the focus reaches the moved item (a round trip later on Blazor Server),
        // the next keys arrive from the handle at its old position - and must still move and drop it.
        cut.FindAll("[data-bit-bh-sortable-handle]")[0].Press("ArrowDown");
        cut.FindAll("[data-bit-bh-sortable-handle]")[1].Press(" ");

        Assert.AreSequenceEqual(new[] { "Beta", "Gamma", "Alpha" }, cut.FindComponent<Stateful<List<string>>>().Instance.Value!);
    }

    [TestMethod]
    public async Task A_pointer_drag_during_a_keyboard_grab_is_ignored()
    {
        var cut = RenderList();
        var sortable = cut.FindComponent<BitBhSortable<string>>().Instance;
        cut.FindAll("[data-bit-bh-sortable-handle]")[0].Press(" ");
        cut.FindAll("[data-bit-bh-sortable-handle]")[0].Press("ArrowDown");
        Assert.AreSequenceEqual(new[] { "Beta", "Alpha", "Gamma" }, Order(cut));

        // The runtime counts positions in the page (the preview order): position 0 is Beta, not Items[0].
        await cut.InvokeAsync(() => sortable.HandlePointerDragStartAsync(0));
        await cut.InvokeAsync(() => sortable.HandlePointerDragEndAsync(0, 2, false));
        Assert.AreEqual(0, cut.FindComponent<Stateful<List<string>>>().Instance.Changes);
        Assert.AreSequenceEqual(new[] { "Beta", "Alpha", "Gamma" }, Order(cut));
        Assert.AreEqual("true", cut.FindAll("[data-bit-bh-sortable-handle]")[1].GetAttribute("aria-pressed"));
    }

    [TestMethod]
    public async Task Pointer_drop_beyond_the_end_announces_the_last_position()
    {
        var cut = RenderList();
        var sortable = cut.FindComponent<BitBhSortable<string>>().Instance;
        await cut.InvokeAsync(() => sortable.HandlePointerDragStartAsync(0));
        await cut.InvokeAsync(() => sortable.HandlePointerDragEndAsync(0, 7, false));
        Assert.AreSequenceEqual(new[] { "Beta", "Gamma", "Alpha" }, cut.FindComponent<Stateful<List<string>>>().Instance.Value!);
        await Announcer.WaitForAsync("Dropped Alpha at position 3 of 3.");
    }

    [TestMethod]
    public void Disposed_while_attaching_detaches_what_the_attach_returns()
    {
        var module = JSInterop.SetupModule("./_content/Bit.BlazorHeadlessUI/bit-blazorheadlessui.js");
        var attach = module.Setup<int>("sortable.attach", _ => true);
        var cut = Render(
            @<Stateful T="bool" Initial="true" Context="s">
                @if (s.Value)
                {
                    <BitBhSortable TItem="string" Items="@(new List<string> { "Alpha" })" aria-label="List" Context="item">@item.Item</BitBhSortable>
                }
            </Stateful>);

        // The runtime gets a callback object, not the component (whose callbacks would be public API).
        Assert.IsFalse(typeof(BitBhSortable<string>).GetMethods().Any(m => m.IsDefined(typeof(JSInvokableAttribute), true)));

        var host = cut.FindComponent<Stateful<bool>>().Instance;
        cut.InvokeAsync(() => host.Set(false));
        attach.SetResult(5);

        cut.WaitForAssertion(() =>
            Assert.ContainsSingle(JSInterop.Invocations.Where(i => i.Identifier == "sortable.detach" && Equals(i.Arguments[0], 5))));
    }
}
