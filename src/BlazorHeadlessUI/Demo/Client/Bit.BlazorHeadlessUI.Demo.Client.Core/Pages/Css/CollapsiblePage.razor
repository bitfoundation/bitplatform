        <BitBhButton OnClick="ToggleControlled" class="btn">
            Toggle from outside
        </BitBhButton>
        <span class="demo-output">Open: @controlledOpen.ToString().ToLowerInvariant()</span>
    </div>

    <BitBhCollapsible Open="controlledOpen"
                   OnOpenChange="v => controlledOpen = v"
                   class="collapsible">
        <div class="collapsible-header">
            <span>Internal trigger</span>
            <BitBhCollapsibleTrigger class="collapsible-trigger">▾</BitBhCollapsibleTrigger>
        </div>
        <BitBhCollapsibleContent class="collapsible-content">
            <div class="collapsible-row">
                Either trigger updates the same state — fully controlled.
            </div>
        </BitBhCollapsibleContent>
    </BitBhCollapsible>
</div>

@code {
    private bool controlledOpen;

    private void ToggleControlled() => controlledOpen = !controlledOpen;
}
""";

    private const string _collapsibleCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.collapsible {
    width: 100%;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #fff;
}

.collapsible-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.125rem;
    font-weight: 500;
}

.collapsible-trigger {
    all: unset;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.375rem;
    cursor: pointer;
    color: #71717a;
}

.collapsible-trigger:hover         { background: #f4f4f5; }
.collapsible-trigger:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
.collapsible-trigger[data-disabled]{ opacity: 0.5; cursor: not-allowed; pointer-events: none; }

.collapsible-row {
    padding: 0.75rem 1.125rem;
    color: #71717a;
    border-top: 1px solid #e4e4e7;
}
""";

    private const string _chevronCss = """
