    // ── CSS (mirrors wwwroot/demos/progress.css) ───────────────────────────────

    private const string _progressCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.progress {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 0.6rem;
    border-radius: 999px;
    background: #e4e4e7;
}

/* --bit-bh-progress is a unitless 0–100 number set inline by BitBhProgress and
   BitBhProgressIndicator; multiply by 1% to size the fill. */
.progress-indicator {
    width: calc(var(--bit-bh-progress, 0) * 1%);
    height: 100%;
    border-radius: inherit;
    background: #2563eb;
    transition: width 250ms ease, background-color 250ms ease;
}

/* data-state="loading | complete | indeterminate" */
.progress-indicator[data-state="complete"] { background: #16a34a; }
""";

    private const string _cardCss = """


/* Labelled card around the bar */
.progress-card {
    display: grid;
    gap: 0.6rem;
    width: 100%;
    max-width: 24rem;
    padding: 1rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.6rem;
    background: #fff;
}

.progress-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
}

.progress-label { font-weight: 600; color: #18181b; }

.progress-status {
    color: #71717a;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
}
""";

    private const string _buttonsCss = """


.progress-actions { display: flex; gap: 0.5rem; }

.progress-btn {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.45rem;
    background: #fff;
    color: #3f3f46;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
}

.progress-btn:hover         { background: #f4f4f5; }
.progress-btn:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
.progress-btn:disabled      { opacity: 0.5; cursor: not-allowed; }
""";

    private const string _indeterminateRulesCss = """


.progress-indicator[data-state="indeterminate"] {
    width: 40%;
    animation: progress-demo-slide 1.2s ease-in-out infinite;
}

@keyframes progress-demo-slide {
    from { transform: translateX(-100%); }
    to   { transform: translateX(250%); }
}

@media (prefers-reduced-motion: reduce) {
    .progress-indicator[data-state="indeterminate"] { animation-duration: 3s; }
}
""";

    private const string _determinateCss = _progressCss + _cardCss + _buttonsCss;

    private const string _uploadCss = _progressCss + _indeterminateRulesCss + """


/* Tall bar with the percentage drawn through BitBhProgress's Template */
.progress-lg { height: 1.25rem; }

.progress-lg .progress-indicator                         { background: #bfdbfe; }
.progress-lg .progress-indicator[data-state="complete"]  { background: #bbf7d0; }

.progress-percent {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 0.6rem;
    color: #1e3a8a;
    font-size: 0.72rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
}
""" + _cardCss + _buttonsCss + """


.progress-btn-primary       { background: #2563eb; border-color: #2563eb; color: #fff; }
.progress-btn-primary:hover { background: #1d4ed8; }
""";

    private const string _indeterminateCss = _progressCss + _indeterminateRulesCss + _cardCss;

    private const string _meterCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.meter {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 0.5rem;
    border-radius: 999px;
    background: #e4e4e7;
}

/* --bit-bh-meter (0–100) is set inline on the meter and inherited by the fill. */
.meter-fill {
    display: block;
    width: calc(var(--bit-bh-meter) * 1%);
    height: 100%;
    border-radius: inherit;
    background: #2563eb;
    transition: width 250ms ease, background-color 250ms ease;
}

/* data-level="low | optimum | high" (below Low / between / above High) */
.meter[data-level="low"]  .meter-fill { background: #16a34a; }
.meter[data-level="high"] .meter-fill { background: #dc2626; }

.meter-list {
    display: grid;
    gap: 1rem;
    width: 100%;
    max-width: 24rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

.meter-row { display: grid; gap: 0.4rem; }

.progress-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
}

.progress-label  { font-weight: 600; color: #18181b; }
.progress-status { color: #71717a; font-size: 0.8rem; font-variant-numeric: tabular-nums; }
""";

    private const string _strengthCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.strength {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    max-width: 20rem;
}

.strength-input {
    padding: 0.5rem 0.75rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.45rem;
    background: #fff;
    font: inherit;
    font-size: 0.9rem;
}

.strength-input:focus-visible { outline: 2px solid #2563eb; outline-offset: 1px; }

/* BitBhMeter root laid out as four segments */
.strength-meter {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.3rem;
}

.strength-segment {
    height: 0.375rem;
    border-radius: 999px;
    background: #e4e4e7;
    transition: background-color 200ms ease;
}

/* data-level from Low="2" / High="3"; data-filled from the Template */
.strength-meter[data-level="low"]     .strength-segment[data-filled] { background: #dc2626; }
.strength-meter[data-level="optimum"] .strength-segment[data-filled] { background: #d97706; }
.strength-meter[data-level="high"]    .strength-segment[data-filled] { background: #16a34a; }

.progress-label  { font-weight: 600; color: #18181b; }
.progress-status { color: #71717a; font-size: 0.8rem; font-variant-numeric: tabular-nums; }
""";
}
