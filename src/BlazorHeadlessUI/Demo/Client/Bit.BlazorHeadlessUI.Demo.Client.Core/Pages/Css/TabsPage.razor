/* All styles are consumer-authored — the library ships zero CSS */
.tabs {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.tab-list {
    display: flex;
    border-bottom: 1px solid #e4e4e7;
    gap: 0.25rem;
}

.tab {
    all: unset;
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #71717a;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
    box-sizing: border-box;
}

.tab:hover                  { color: #18181b; }
.tab:focus-visible          { outline: 2px solid #2563eb; outline-offset: -2px; border-radius: 0.25rem; }

/* Hooks emitted by BitBhTab */
.tab[data-state="active"]   { color: #2563eb; border-bottom-color: #2563eb; }
.tab[data-disabled]         { opacity: 0.4; cursor: not-allowed; }

.tab-panel {
    padding: 0.5rem 0;
    color: #18181b;
}
""";

