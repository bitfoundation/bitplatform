@page "/button"

<PageTitle>Button — bit BlazorHeadlessUI</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Button</h1>
        <p>A polymorphic, accessible button primitive with loading and disabled states.</p>
        <SectionSwitcher Slug="button" />
    </header>

    <DemoBlock Title="Basic Button"
               Code="@_basicCode"
               Css="@_btnCss">
        <Description>
            Renders a native <code>&lt;button&gt;</code> with no styling. All visuals come from you.
        </Description>
        <LiveContent>
            <BitBhButton OnClick="HandleBasicClick" class="btn">
                Click me
            </BitBhButton>
            <span class="demo-output">Clicked @basicClickCount times</span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled State"
               Code="@_disabledCode"
               Css="@_btnDisabledCss">
        <Description>
            Sets the native <code>disabled</code> attribute and emits <code>data-disabled</code> for CSS hooks.
        </Description>
        <LiveContent>
            <BitBhButton Disabled="true" OnClick="HandleBasicClick" class="btn">
                Can't click me
            </BitBhButton>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Loading State with Context"
               Code="@_loadingCode"
               Css="@_btnLoadingCss">
        <Description>
            Uses <code>RenderFragment&lt;BitBhButtonContext&gt;</code> so you can conditionally render
            a spinner driven by the button's own state.
        </Description>
        <LiveContent>
            <BitBhButton Loading="@isLoading" OnClick="HandleLoadingClick" class="btn">
                <Template Context="btn">
                    @if (btn.Loading)
                    {
                        <span class="spinner"></span>
                        <span>Saving…</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </Template>
            </BitBhButton>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Polymorphic Rendering"
               Code="@_polymorphicCode"
               Css="@_btnLinkCss">
        <Description>
            Set <code>As="a"</code> to render as an anchor while retaining all button semantics.
            Non-native elements automatically receive <code>role="button"</code>, <code>tabindex="0"</code>,
            and Enter/Space keyboard handling.
        </Description>
        <LiveContent>
            <BitBhButton As="a" href="https://github.com/bitfoundation/bitplatform/tree/develop/src/BlazorHeadlessUI" target="_blank" class="btn btn-link">
                I'm actually an &lt;a&gt; tag
            </BitBhButton>
            <BitBhButton As="span" OnClick="HandleBasicClick" class="btn">
                I'm a &lt;span&gt; with role="button"
            </BitBhButton>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Toggle Button"
               Code="@_toggleCode"
               Css="@_btnToggleCss">
        <Description>
            Combine <code>BitBhButton</code> with your own state to build a toggle. Pass
            <code>aria-pressed</code> via standard HTML attributes — they merge automatically.
        </Description>
        <LiveContent>
            <BitBhButton OnClick="TogglePressed"
                     class="@ToggleClass"
                     aria-pressed="@isPressed.ToString().ToLowerInvariant()">
                @(isPressed ? "ON" : "OFF")
            </BitBhButton>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Styled via Data Attributes"
               Code="@_dataAttrCode"
               Css="@_dataAttrCss">
        <Description>
            Style entirely via CSS attribute selectors. No component API for colors, sizes, or
            variants — that's your domain.
        </Description>
        <LiveContent>
            <BitBhButton OnClick="HandleBasicClick" class="btn-data">
                Styled via [data-*]
            </BitBhButton>
            <BitBhButton Disabled="true" class="btn-data">
                Disabled via [data-disabled]
            </BitBhButton>
            <BitBhButton Loading="true" class="btn-data">
                Loading via [data-loading]
            </BitBhButton>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    private int basicClickCount;
    private bool isLoading;
    private bool isPressed;

    private string ToggleClass => isPressed ? "btn btn-toggle active" : "btn btn-toggle";

    private void HandleBasicClick() => basicClickCount++;

    private async Task HandleLoadingClick()
    {
        isLoading = true;
        await Task.Delay(2000);
        isLoading = false;
    }

    private void TogglePressed() => isPressed = !isPressed;

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _basicCode = """
<BitBhButton OnClick="HandleBasicClick" class="btn">
    Click me
</BitBhButton>
<span class="demo-output">Clicked @basicClickCount times</span>

@code {
    private int basicClickCount;

    private void HandleBasicClick() => basicClickCount++;
}
""";

    private const string _disabledCode = """
<BitBhButton Disabled="true" OnClick="HandleBasicClick" class="btn">
    Can't click me
</BitBhButton>

@code {
    private int basicClickCount;

    private void HandleBasicClick() => basicClickCount++;
}
""";

    private const string _loadingCode = """
<BitBhButton Loading="@isLoading" OnClick="HandleLoadingClick" class="btn">
    <Template Context="btn">
        @if (btn.Loading)
        {
            <span class="spinner"></span>
            <span>Saving…</span>
        }
        else
        {
            <span>Save Changes</span>
        }
    </Template>
</BitBhButton>

@code {
    private bool isLoading;

    private async Task HandleLoadingClick()
    {
        isLoading = true;
        await Task.Delay(2000);
        isLoading = false;
    }
}
""";

    private const string _polymorphicCode = """
<BitBhButton As="a" href="https://github.com/bitfoundation/bitplatform/tree/develop/src/BlazorHeadlessUI" target="_blank" class="btn btn-link">
    I'm actually an <a> tag
</BitBhButton>
<BitBhButton As="span" OnClick="HandleBasicClick" class="btn">
    I'm a <span> with role="button"
</BitBhButton>

@code {
    private int basicClickCount;

    private void HandleBasicClick() => basicClickCount++;
}
""";

    private const string _toggleCode = """
<BitBhButton OnClick="TogglePressed"
         class="@ToggleClass"
         aria-pressed="@isPressed.ToString().ToLowerInvariant()">
    @(isPressed ? "ON" : "OFF")
</BitBhButton>

@code {
    private bool isPressed;

    private string ToggleClass => isPressed ? "btn btn-toggle active" : "btn btn-toggle";

    private void TogglePressed() => isPressed = !isPressed;
}
""";

    private const string _dataAttrCode = """
<BitBhButton OnClick="HandleBasicClick" class="btn-data">
    Styled via [data-*]
</BitBhButton>
<BitBhButton Disabled="true" class="btn-data">
    Disabled via [data-disabled]
</BitBhButton>
<BitBhButton Loading="true" class="btn-data">
    Loading via [data-loading]
</BitBhButton>

@code {
    private int basicClickCount;

    private void HandleBasicClick() => basicClickCount++;
}
""";

    private const string _btnCss = """
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #fff;
    color: #18181b;
    cursor: pointer;
}

.btn:hover         { background: #f4f4f5; border-color: #d4d4d8; }
.btn:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
.btn:active        { background: #e4e4e7; }

.demo-output {
    font-size: 0.875rem;
    color: #71717a;
}
""";

    private const string _btnDisabledCss = """
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #fff;
    color: #18181b;
    cursor: pointer;
}

.btn:hover         { background: #f4f4f5; border-color: #d4d4d8; }
.btn:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
.btn:active        { background: #e4e4e7; }

/* Hooks emitted by BitBhButton when Disabled="true" */
.btn[data-disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}
""";

    private const string _btnLoadingCss = """
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #fff;
    color: #18181b;
    cursor: pointer;
}

.btn:hover         { background: #f4f4f5; border-color: #d4d4d8; }
.btn:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
.btn:active        { background: #e4e4e7; }

/* Hooks emitted by BitBhButton when Loading="true" */
.btn[data-loading] {
    opacity: 0.7;
    cursor: wait;
}

.spinner {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }
""";

    private const string _btnLinkCss = """
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #fff;
    color: #18181b;
    cursor: pointer;
}

.btn:hover         { background: #f4f4f5; border-color: #d4d4d8; }
.btn:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
.btn:active        { background: #e4e4e7; }

/* Anchor variant of BitBhButton (As="a") */
.btn-link {
    background: transparent;
    border-color: transparent;
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 2px;
}

.btn-link:hover { color: #1d4ed8; background: #eff6ff; }
""";

    private const string _btnToggleCss = """
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
