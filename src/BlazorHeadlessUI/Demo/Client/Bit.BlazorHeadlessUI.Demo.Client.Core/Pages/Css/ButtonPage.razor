.btn:active        { background: #e4e4e7; }

/* Toggle button — driven by your own aria-pressed state */
.btn-toggle {
    min-width: 4rem;
    justify-content: center;
}

.btn-toggle.active {
    background: #2563eb;
    border-color: #2563eb;
    color: white;
}
""";

    private const string _dataAttrCss = """
/* Style entirely via CSS attribute selectors emitted by BitBhButton */
.btn-data                { background: #18181b; color: white; }
.btn-data[data-disabled] { opacity: 0.4; cursor: not-allowed; }
