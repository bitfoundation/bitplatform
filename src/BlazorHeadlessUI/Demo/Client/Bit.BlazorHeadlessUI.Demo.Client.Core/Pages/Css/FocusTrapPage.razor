@page "/focus-trap"

<PageTitle>FocusTrap — bit BlazorHeadlessUI</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>FocusTrap</h1>
        <p>A low-level component that traps keyboard focus within a container. Used internally by Dialog but also useful standalone for custom modal-like patterns.</p>
        <SectionSwitcher Slug="focus-trap" />
    </header>

    <DemoBlock Title="Basic Focus Trap"
               Code="@_basicCode"
               Css="@_basicCss">
        <Description>
            Toggle the trap on and off. While active, pressing Tab and Shift+Tab cycles
            through the focusable elements inside the container without escaping to the
            rest of the page. Focus is automatically moved to the first focusable element
            when the trap activates, and restored to the previously-focused element when
            it deactivates.
        </Description>
        <LiveContent>
            <BitBhButton OnClick="() => basicEnabled = !basicEnabled"
                      class="@($"btn {(basicEnabled ? "btn-primary" : "")}")">
                @(basicEnabled ? "Deactivate trap" : "Activate trap")
            </BitBhButton>

            <BitBhFocusTrap Enabled="basicEnabled" class="focus-trap-container">
                <p class="focus-trap-label">
                    Focus is @(basicEnabled ? "trapped" : "free") inside this box.
                </p>
                <input type="text" placeholder="First input" class="focus-trap-input" />
                <input type="text" placeholder="Second input" class="focus-trap-input" />
                <button class="btn" @onclick="() => basicEnabled = false">Close</button>
            </BitBhFocusTrap>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Slide-over panel"
               Code="@_slideOverCode"
               Css="@_slideOverCss">
        <Description>
            A common use case: a slide-over panel that traps focus while visible.
            The trap activates when the panel opens and deactivates when it closes,
            returning focus to the trigger button.
        </Description>
        <LiveContent>
            <BitBhButton OnClick="() => panelOpen = true" class="btn btn-primary">
                Open panel
            </BitBhButton>

            @if (panelOpen)
            {
                <div class="slide-over-backdrop" @onclick="() => panelOpen = false"></div>
                <BitBhFocusTrap Enabled="panelOpen" class="slide-over-panel">
                    <h3 class="slide-over-title">Settings</h3>
                    <p class="slide-over-description">
                        Focus is trapped inside this panel. Try Tab and Shift+Tab.
                    </p>

                    <label class="slide-over-field">
                        <span>Username</span>
                        <input type="text" class="focus-trap-input" value="alice" />
                    </label>

                    <label class="slide-over-field">
                        <span>Email</span>
                        <input type="email" class="focus-trap-input" value="alice@example.com" />
                    </label>

                    <div class="slide-over-actions">
                        <button class="btn" @onclick="() => panelOpen = false">Cancel</button>
                        <button class="btn btn-primary" @onclick="() => panelOpen = false">Save</button>
                    </div>
                </BitBhFocusTrap>
            }
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Multiple focusable regions"
               Code="@_multiCode"
               Css="@_multiCss">
        <Description>
            Demonstrates that only the active trap captures focus. Toggle between
            two regions — only the enabled one traps Tab navigation.
        </Description>
        <LiveContent>
            <div class="multi-controls">
                <BitBhButton OnClick="ActivateRegionA"
                          class="@($"btn {(regionA ? "btn-primary" : "")}")">
                    Trap Region A
                </BitBhButton>
                <BitBhButton OnClick="ActivateRegionB"
                          class="@($"btn {(regionB ? "btn-primary" : "")}")">
                    Trap Region B
                </BitBhButton>
                <BitBhButton OnClick="DeactivateAll" class="btn">
                    Release all
                </BitBhButton>
            </div>

            <div class="multi-regions">
                <BitBhFocusTrap Enabled="regionA" class="focus-trap-container">
                    <strong>Region A</strong>
                    <input type="text" placeholder="A — Field 1" class="focus-trap-input" />
                    <input type="text" placeholder="A — Field 2" class="focus-trap-input" />
                    <button class="btn">A — Action</button>
                </BitBhFocusTrap>

                <BitBhFocusTrap Enabled="regionB" class="focus-trap-container">
                    <strong>Region B</strong>
                    <input type="text" placeholder="B — Field 1" class="focus-trap-input" />
                    <input type="text" placeholder="B — Field 2" class="focus-trap-input" />
                    <button class="btn">B — Action</button>
                </BitBhFocusTrap>
            </div>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    private bool basicEnabled;
    private bool panelOpen;
    private bool regionA;
    private bool regionB;

    private void ActivateRegionA()
    {
        regionA = true;
        regionB = false;
    }

    private void ActivateRegionB()
    {
        regionA = false;
        regionB = true;
    }

    private void DeactivateAll()
    {
        regionA = false;
        regionB = false;
    }

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _basicCode = """
<BitBhButton OnClick="() => enabled = !enabled"
          class="btn @(enabled ? "btn-primary" : "")">
    @(enabled ? "Deactivate trap" : "Activate trap")
</BitBhButton>

<BitBhFocusTrap Enabled="enabled" class="focus-trap-container">
    <p>Focus is @(enabled ? "trapped" : "free") inside this box.</p>
    <input type="text" placeholder="First input" />
    <input type="text" placeholder="Second input" />
    <button class="btn" @onclick="() => enabled = false">Close</button>
</BitBhFocusTrap>

@code {
    private bool enabled;
}
""";

