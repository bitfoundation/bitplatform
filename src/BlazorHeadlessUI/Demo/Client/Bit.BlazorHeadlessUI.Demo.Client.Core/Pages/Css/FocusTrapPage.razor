""";

    private const string _multiCode = """
<BitBhButton OnClick="ActivateRegionA" class="btn">Trap Region A</BitBhButton>
<BitBhButton OnClick="ActivateRegionB" class="btn">Trap Region B</BitBhButton>
<BitBhButton OnClick="DeactivateAll" class="btn">Release all</BitBhButton>

<BitBhFocusTrap Enabled="regionA" class="focus-trap-container">
    <strong>Region A</strong>
    <input type="text" placeholder="A — Field 1" />
    <input type="text" placeholder="A — Field 2" />
    <button class="btn">A — Action</button>
</BitBhFocusTrap>

<BitBhFocusTrap Enabled="regionB" class="focus-trap-container">
    <strong>Region B</strong>
    <input type="text" placeholder="B — Field 1" />
    <input type="text" placeholder="B — Field 2" />
    <button class="btn">B — Action</button>
</BitBhFocusTrap>

@code {
    private bool regionA;
    private bool regionB;

    private void ActivateRegionA() { regionA = true; regionB = false; }
    private void ActivateRegionB() { regionA = false; regionB = true; }
    private void DeactivateAll() { regionA = false; regionB = false; }
}
""";

    private const string _basicCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.focus-trap-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 2px dashed #d4d4d8;
    border-radius: 0.5rem;
    margin-top: 1rem;
}

/* Active state via data-state attribute emitted by BitBhFocusTrap */
.focus-trap-container[data-state="active"] {
    border-color: #2563eb;
    background: #eff6ff;
}

.focus-trap-label {
    margin: 0;
    font-size: 0.9rem;
    color: #52525b;
}

.focus-trap-input {
    padding: 0.45rem 0.6rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.4rem;
    font-size: 0.9rem;
}

/* Toggle button */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
}
.btn:hover { background: #f4f4f5; }

.btn-primary {
    color: #fff;
    background: #2563eb;
    border-color: #2563eb;
}
.btn-primary:hover { background: #1d4ed8; border-color: #1d4ed8; }
""";

