.disclosure-body {
    padding: 0.875rem 1.125rem 1rem;
    color: #71717a;
    border-top: 1px solid #e4e4e7;
}

/* Rotating chevron driven by BitBhDisclosureRenderContext.IsOpen */
.disclosure-chevron      { transition: transform 200ms ease; color: #71717a; }
.disclosure-chevron.open { transform: rotate(180deg); }

/* "Close panel" button rendered inside the panel */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
}
.btn:hover { background: #f4f4f5; }
""";

