    // ── CSS (mirrors wwwroot/demos/sortable.css) ───────────────────────────────

    private const string _listCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.sortable-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 28rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

/* Each item is rendered by BitBhSortable as <li data-bit-bh-sortable-item>. */
.sortable-list > li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem 0.55rem 0.5rem;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    transition: border-color 150ms ease, box-shadow 150ms ease;
}

/* data-dragging: the item is picked up (keyboard) or dragged (pointer). */
.sortable-list > li[data-dragging] {
    border-color: #2563eb;
    box-shadow: 0 10px 24px rgba(24, 24, 27, 0.14);
}

/* The root also carries data-dragging while any item moves. */
.sortable-list[data-dragging] { user-select: none; }

/* Drag handle (BitBhSortableHandle renders a <button>) */
.sortable-handle {
    all: unset;
    box-sizing: border-box;
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.375rem;
    color: #a1a1aa;
    font-size: 1rem;
    line-height: 1;
    cursor: grab;
    touch-action: none;   /* lets touch drags start on the handle */
    user-select: none;
    transition: background-color 120ms ease, color 120ms ease;
}

.sortable-handle:hover         { background: #f4f4f5; color: #3f3f46; }
.sortable-handle:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }

/* aria-pressed="true" (and data-dragging) while picked up with the keyboard */
.sortable-handle[aria-pressed="true"] {
    background: #2563eb;
    color: #fff;
    cursor: grabbing;
}

.sortable-title { flex: 1; color: #18181b; }
""";

    private const string _tasksCss = _listCss + """


.sortable-tag {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: #f4f4f5;
    color: #52525b;
    font-size: 0.75rem;
    font-weight: 500;
}

/* Demo layout */
.sortable-demo { display: grid; gap: 1rem; width: 100%; }

.sortable-output { margin: 0; font-size: 0.85rem; color: #71717a; }
.sortable-output strong { color: #18181b; font-weight: 600; }
""";

    private const string _logCss = _listCss + """


/* List and log side by side */
.sortable-split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.5rem;
    width: 100%;
    align-items: start;
}

.sortable-log {
    margin: 0;
    padding: 0.75rem 1rem;
    list-style: none;
    min-height: 100%;
    background: #fafafa;
    border: 1px dashed #d4d4d8;
    border-radius: 0.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: #3f3f46;
}

.sortable-log li + li { margin-top: 0.35rem; }
.sortable-log-empty   { color: #71717a; }
""";

    private const string _horizontalCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.sortable-row {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

/* <li data-bit-bh-sortable-item> rendered by BitBhSortable */
.sortable-row > li {
    background: #fff;
    border: 1px solid #d4d4d8;
    border-radius: 999px;
    transition: border-color 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
}

.sortable-row > li[data-dragging] {
    border-color: #2563eb;
    background: #eff6ff;
    box-shadow: 0 6px 16px rgba(24, 24, 27, 0.14);
}

/* The chip is the BitBhSortableHandle <button> */
.sortable-chip {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #3f3f46;
    cursor: grab;
    touch-action: none;
    user-select: none;
}

.sortable-chip:focus-visible        { outline: 2px solid #2563eb; outline-offset: 2px; }
.sortable-chip[aria-pressed="true"] { color: #1d4ed8; cursor: grabbing; }
.sortable-chip-grip                 { color: #a1a1aa; }

/* Demo layout */
.sortable-demo { display: grid; gap: 1rem; width: 100%; }

.sortable-output { margin: 0; font-size: 0.85rem; color: #71717a; }
.sortable-output strong { color: #18181b; font-weight: 600; }
""";

    private const string _announcementsCss = _listCss + """


/* Live position badge (the template's Index) */
.sortable-index {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
}
""";

    private const string _disabledCss = _listCss + """


/* Hooks emitted when Disabled="true" */
.sortable-list[data-disabled] > li {
    background: #fafafa;
    color: #71717a;
}

.sortable-handle[aria-disabled="true"] { cursor: not-allowed; opacity: 0.5; }

/* The lock is a BitBhToggle: data-state="on|off" + aria-pressed */
.sortable-lock {
    all: unset;
    box-sizing: border-box;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.85rem;
    font-weight: 500;
    color: #3f3f46;
    cursor: pointer;
}

.sortable-lock:hover               { background: #f4f4f5; }
.sortable-lock:focus-visible       { outline: 2px solid #2563eb; outline-offset: 2px; }
.sortable-lock[data-state="on"]    { background: #18181b; border-color: #18181b; color: #fff; }

.sortable-demo { display: grid; gap: 1rem; width: 100%; }
""";
}
