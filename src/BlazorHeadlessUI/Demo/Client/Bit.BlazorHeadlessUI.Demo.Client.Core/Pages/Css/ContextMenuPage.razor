@page "/context-menu"

<PageTitle>Context Menu — bit BlazorHeadlessUI</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Context Menu</h1>
        <p>A menu located at the pointer, triggered by a right click. Keyboard navigation, typeahead, and viewport collision handling included.</p>
        <SectionSwitcher Slug="context-menu" />
    </header>

    <DemoBlock Title="Basic Context Menu"
               Code="@_basicCode"
               Css="@_basicCss">
        <Description>
            Right-click the trigger area to open the menu at the pointer. Use Up / Down to
            navigate, Home / End to jump, Enter / Space to activate, Escape to close, and
            type a letter to jump to the first matching item. The native browser menu is
            suppressed on the trigger.
        </Description>
        <LiveContent>
            <BitBhContextMenu>
                <BitBhContextMenuTrigger class="cm-trigger">
                    Right-click here
                </BitBhContextMenuTrigger>
                <BitBhContextMenuContent class="cm-content">
                    <BitBhContextMenuItem OnClick='@(() => Log("Back"))'    class="cm-item" Label="Back">Back</BitBhContextMenuItem>
                    <BitBhContextMenuItem OnClick='@(() => Log("Forward"))' class="cm-item" Label="Forward" Disabled="true">Forward</BitBhContextMenuItem>
                    <BitBhContextMenuItem OnClick='@(() => Log("Reload"))'  class="cm-item" Label="Reload">Reload</BitBhContextMenuItem>
                </BitBhContextMenuContent>
            </BitBhContextMenu>

            <span class="demo-output">Last action: <strong>@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Labels, groups and separators"
               Code="@_structuredCode"
               Css="@_structuredCss">
        <Description>
            Use <code>BitBhContextMenuLabel</code> to title a section, <code>BitBhContextMenuGroup</code>
            to relate items for assistive tech, and <code>BitBhContextMenuSeparator</code> to draw a
            divider. Labels and separators are skipped by keyboard nav and typeahead.
        </Description>
        <LiveContent>
            <BitBhContextMenu>
                <BitBhContextMenuTrigger class="cm-trigger">
                    Right-click for a structured menu
                </BitBhContextMenuTrigger>
                <BitBhContextMenuContent class="cm-content">
                    <BitBhContextMenuLabel class="cm-label">Edit</BitBhContextMenuLabel>
                    <BitBhContextMenuGroup class="cm-group">
                        <BitBhContextMenuItem OnClick='@(() => Log("Cut"))'   class="cm-item" Label="Cut">Cut <span class="cm-shortcut">⌘X</span></BitBhContextMenuItem>
                        <BitBhContextMenuItem OnClick='@(() => Log("Copy"))'  class="cm-item" Label="Copy">Copy <span class="cm-shortcut">⌘C</span></BitBhContextMenuItem>
                        <BitBhContextMenuItem OnClick='@(() => Log("Paste"))' class="cm-item" Label="Paste">Paste <span class="cm-shortcut">⌘V</span></BitBhContextMenuItem>
                    </BitBhContextMenuGroup>

                    <BitBhContextMenuSeparator class="cm-separator" />

                    <BitBhContextMenuLabel class="cm-label">Danger zone</BitBhContextMenuLabel>
                    <BitBhContextMenuItem OnClick='@(() => Log("Delete"))' class="cm-item cm-item-danger" Label="Delete">Delete</BitBhContextMenuItem>
                </BitBhContextMenuContent>
            </BitBhContextMenu>

            <span class="demo-output">Last action: <strong>@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled menu"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            Set <code>Disabled="true"</code> on <code>BitBhContextMenu</code> to turn the whole
            thing off. The trigger then lets the native browser context menu through instead.
        </Description>
        <LiveContent>
            <BitBhContextMenu Disabled="true">
                <BitBhContextMenuTrigger class="cm-trigger cm-trigger-disabled">
                    Right-click here (disabled — native menu shows)
                </BitBhContextMenuTrigger>
                <BitBhContextMenuContent class="cm-content">
                    <BitBhContextMenuItem OnClick='@(() => Log("Never"))' class="cm-item" Label="Never">Never runs</BitBhContextMenuItem>
                </BitBhContextMenuContent>
            </BitBhContextMenu>
        </LiveContent>
    </DemoBlock>
</div>

