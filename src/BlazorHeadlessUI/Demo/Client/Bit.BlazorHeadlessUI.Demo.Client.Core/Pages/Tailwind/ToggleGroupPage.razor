    <Template Context="pressed">
        <span class="text-base leading-none" aria-hidden="true">@(pressed ? "★" : "☆")</span>
        Star
    </Template>
</BitBhToggle>

<BitBhToggle class="inline-flex h-9 min-w-9 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 text-sm font-medium text-zinc-700 outline-none transition-colors enabled:hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:border-blue-200 aria-pressed:bg-blue-50 aria-pressed:text-blue-700 enabled:aria-pressed:hover:bg-blue-100">
    <Template Context="pressed">
        <span class="text-base leading-none" aria-hidden="true">@(pressed ? "✓" : "+")</span>
        Follow
    </Template>
</BitBhToggle>
""";

    private const string _multipleCode = """
<BitBhToggleGroup Type="BitBhToggleGroupType.Multiple" @bind-Values="textStyles"
               aria-label="Text formatting"
               class="inline-flex gap-1 rounded-[0.6rem] border border-zinc-200 bg-zinc-100 p-1">
    <BitBhToggleGroupItem Value="bold" aria-label="Bold"
                       class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center gap-2 rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white"><strong>B</strong></BitBhToggleGroupItem>
    <BitBhToggleGroupItem Value="italic" aria-label="Italic"
