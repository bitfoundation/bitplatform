    <BitBhToggleGroupItem Value="underline" aria-label="Underline"
                       class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center gap-2 rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white"><u>U</u></BitBhToggleGroupItem>
    <BitBhToggleGroupItem Value="strike" aria-label="Strikethrough"
