@page "/tw/avatar"

<PageTitle>Avatar — bit BlazorHeadlessUI · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Avatar</h1>
        <p class="mt-2 text-zinc-500">An image with a graceful fallback, styled entirely with Tailwind utilities.</p>
        <TwSectionSwitcher Slug="avatar" />
    </header>

    <TwDemoBlock Title="Basic" Code="@_basicCode">
        <Description>
            Compose <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhAvatarImage</code> with a <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhAvatarFallback</code>. The image only shows once it loads.
        </Description>
        <LiveContent>
            <BitBhAvatar class="inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-zinc-200 align-middle select-none">
                <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover"
                               Src="https://images.unsplash.com/photo-1492633423870-43d1cd2775eb?w=128&h=128&dpr=2&q=80"
                               Alt="Colm Tuite" />
                <BitBhAvatarFallback class="flex h-full w-full items-center justify-center bg-zinc-200 text-sm font-semibold text-zinc-700">CT</BitBhAvatarFallback>
            </BitBhAvatar>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Fallback (broken image)" Code="@_fallbackCode">
        <Description>
            On load failure the fallback replaces the broken-image icon. Here the source is intentionally invalid.
        </Description>
        <LiveContent>
            <BitBhAvatar class="inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-zinc-200 align-middle select-none">
                <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover"
                               Src="https://example.com/does-not-exist.jpg"
                               Alt="Jane Doe" />
                <BitBhAvatarFallback class="flex h-full w-full items-center justify-center bg-zinc-200 text-sm font-semibold text-zinc-700">JD</BitBhAvatarFallback>
            </BitBhAvatar>

            <BitBhAvatar class="inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-zinc-100 align-middle select-none">
                <BitBhAvatarFallback class="flex h-full w-full items-center justify-center text-zinc-500">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                         stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </BitBhAvatarFallback>
            </BitBhAvatar>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Delayed fallback" Code="@_delayCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">DelayMs</code> waits before showing the fallback, avoiding a flash for fast-loading images.
        </Description>
        <LiveContent>
            <BitBhAvatar class="inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-zinc-200 align-middle select-none">
                <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover"
                               Src="https://images.unsplash.com/photo-1511485977113-f34c92461ad9?w=128&h=128&dpr=2&q=80"
                               Alt="Pedro Duarte" />
                <BitBhAvatarFallback class="flex h-full w-full items-center justify-center bg-zinc-200 text-sm font-semibold text-zinc-700" DelayMs="600">PD</BitBhAvatarFallback>
            </BitBhAvatar>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Sizes and shapes" Code="@_variantsCode">
        <Description>
            Size and shape are pure utilities — swap <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">h-*/w-*</code> and the rounding to taste.
        </Description>
        <LiveContent>
            <div class="flex items-center gap-4">
                <BitBhAvatar class="inline-flex h-9 w-9 items-center justify-center overflow-hidden rounded-full bg-zinc-200 align-middle text-xs font-semibold text-zinc-700 select-none">
                    <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover"
                                   Src="https://images.unsplash.com/photo-1607746882042-944635dfe10e?w=96&h=96&dpr=2&q=80" Alt="" />
                    <BitBhAvatarFallback class="flex h-full w-full items-center justify-center">AB</BitBhAvatarFallback>
                </BitBhAvatar>

                <BitBhAvatar class="inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-zinc-200 align-middle text-sm font-semibold text-zinc-700 select-none">
                    <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover"
                                   Src="https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=128&h=128&dpr=2&q=80" Alt="" />
                    <BitBhAvatarFallback class="flex h-full w-full items-center justify-center">CD</BitBhAvatarFallback>
                </BitBhAvatar>

                <BitBhAvatar class="inline-flex h-16 w-16 items-center justify-center overflow-hidden rounded-xl bg-zinc-200 align-middle text-base font-semibold text-zinc-700 select-none">
                    <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover"
                                   Src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=160&h=160&dpr=2&q=80" Alt="" />
                    <BitBhAvatarFallback class="flex h-full w-full items-center justify-center">EF</BitBhAvatarFallback>
                </BitBhAvatar>
            </div>
        </LiveContent>
    </TwDemoBlock>
</div>

@code {
    private const string _basicCode = """
<BitBhAvatar class="inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-zinc-200 align-middle select-none">
    <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover" Src="/colm.jpg" Alt="Colm Tuite" />
    <BitBhAvatarFallback class="flex h-full w-full items-center justify-center bg-zinc-200 text-sm font-semibold text-zinc-700">CT</BitBhAvatarFallback>
</BitBhAvatar>
""";

    private const string _fallbackCode = """
@* Broken / missing image → the fallback shows automatically *@
<BitBhAvatar class="inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-zinc-200 align-middle select-none">
    <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover" Src="/does-not-exist.jpg" Alt="Jane Doe" />
    <BitBhAvatarFallback class="flex h-full w-full items-center justify-center bg-zinc-200 text-sm font-semibold text-zinc-700">JD</BitBhAvatarFallback>
</BitBhAvatar>

@* Fallback with no image — a generic user icon *@
<BitBhAvatar class="inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-zinc-100 align-middle select-none">
    <BitBhAvatarFallback class="flex h-full w-full items-center justify-center text-zinc-500">
        <svg viewBox="0 0 24 24" width="22" height="22" ...>...</svg>
    </BitBhAvatarFallback>
</BitBhAvatar>
""";

    private const string _delayCode = """
<BitBhAvatar class="inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-zinc-200 align-middle select-none">
    <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover" Src="/pedro.jpg" Alt="Pedro Duarte" />
    <BitBhAvatarFallback class="flex h-full w-full items-center justify-center bg-zinc-200 text-sm font-semibold text-zinc-700" DelayMs="600">PD</BitBhAvatarFallback>
</BitBhAvatar>
""";

    private const string _variantsCode = """
<div class="flex items-center gap-4">
    <BitBhAvatar class="inline-flex h-9 w-9 items-center justify-center overflow-hidden rounded-full bg-zinc-200 align-middle text-xs font-semibold text-zinc-700 select-none">
        <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover" Src="/a.jpg" Alt="" />
        <BitBhAvatarFallback class="flex h-full w-full items-center justify-center">AB</BitBhAvatarFallback>
    </BitBhAvatar>

    <BitBhAvatar class="inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-zinc-200 align-middle text-sm font-semibold text-zinc-700 select-none">
        <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover" Src="/b.jpg" Alt="" />
        <BitBhAvatarFallback class="flex h-full w-full items-center justify-center">CD</BitBhAvatarFallback>
    </BitBhAvatar>

    <BitBhAvatar class="inline-flex h-16 w-16 items-center justify-center overflow-hidden rounded-xl bg-zinc-200 align-middle text-base font-semibold text-zinc-700 select-none">
        <BitBhAvatarImage class="h-full w-full rounded-[inherit] object-cover" Src="/c.jpg" Alt="" />
        <BitBhAvatarFallback class="flex h-full w-full items-center justify-center">EF</BitBhAvatarFallback>
    </BitBhAvatar>
</div>
""";
}
