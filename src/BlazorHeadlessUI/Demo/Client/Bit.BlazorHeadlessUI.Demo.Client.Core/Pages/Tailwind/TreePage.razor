    private const string _checkboxCode = """
<BitBhTree TValue="string" aria-label="Features to install"
        Checkboxes="true"
        @bind-SelectedValues="checkedFeatures"
        DefaultExpandedValues="@(new[] { "app", "app-themes" })"
        class="w-full max-w-sm rounded-lg border border-zinc-200 bg-white p-1.5 text-sm text-zinc-900 [&_[role=treeitem]]:outline-none [&_[role=treeitem]:focus-visible>div]:outline-2 [&_[role=treeitem]:focus-visible>div]:-outline-offset-2 [&_[role=treeitem]:focus-visible>div]:outline-blue-600">
    @foreach (var node in features)
