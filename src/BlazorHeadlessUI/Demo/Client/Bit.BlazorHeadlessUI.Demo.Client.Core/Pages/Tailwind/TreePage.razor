        @FeatureItem(node)
    }
</BitBhTree>

<p class="text-sm text-zinc-500">
    Installing: <strong class="font-semibold text-zinc-900">@(InstalledFeatures.Any() ? string.Join(", ", InstalledFeatures) : "nothing")</strong>
</p>

@code {
    private sealed record Node(string Id, string Name, Node[] Children);

    private readonly Node[] features =
    [
        new("app", "Desktop app",
        [
            new("app-core", "Core runtime", []),
            new("app-spellcheck", "Spell checker", []),
            new("app-themes", "Themes",
            [
                new("theme-light", "Light", []),
                new("theme-dark", "Dark", []),
                new("theme-contrast", "High contrast", []),
            ]),
        ]),
        new("cli", "Command-line tools",
        [
            new("cli-core", "CLI", []),
            new("cli-completions", "Shell completions", []),
        ]),
        new("offline-docs", "Offline documentation", []),
    ];

    // Parents are added / removed automatically as their leaves change.
    private IReadOnlyCollection<string> checkedFeatures = ["app-core", "theme-light", "theme-dark"];

    private IEnumerable<string> InstalledFeatures =>
        Leaves(features).Where(n => checkedFeatures.Contains(n.Id)).Select(n => n.Name);

    private static IEnumerable<Node> Leaves(IEnumerable<Node> nodes) =>
        nodes.SelectMany(n => n.Children.Length == 0 ? new[] { n } : Leaves(n.Children));

    // The item itself emits data-checked; the Template's Checked (true / false / null) mirrors it.
    private static string CheckedAttr(bool? state) => state switch
    {
        true => "true",
        false => "false",
        null => "mixed",
    };

    private RenderFragment<Node> FeatureItem => node =>
        @<BitBhTreeItem TValue="string" Value="@node.Id" Label="@node.Name">
            <Template Context="state">
                <div class="flex min-h-8 cursor-pointer select-none items-center gap-1.5 rounded-md py-1 pr-2 pl-[calc((var(--bit-bh-tree-level)_-_1)_*_1.25rem_+_0.375rem)] hover:bg-zinc-100">
                    <BitBhTreeItemToggle TValue="string" class="inline-flex size-5 flex-none items-center justify-center rounded text-xs text-zinc-400 transition-transform duration-150 hover:bg-zinc-200 hover:text-zinc-900 data-state-open:rotate-90 data-[leaf]:invisible">▸</BitBhTreeItemToggle>
                    <span data-checked="@CheckedAttr(state.Checked)" aria-hidden="true"
                          class="inline-flex size-4 flex-none items-center justify-center rounded border-[1.5px] border-zinc-400 bg-white text-[0.7rem] font-bold leading-none text-white data-[checked=true]:border-blue-600 data-[checked=true]:bg-blue-600 data-[checked=mixed]:border-blue-600 data-[checked=mixed]:bg-blue-600">@(state.Checked switch { true => "✓", null => "–", _ => "" })</span>
                    <span>@node.Name</span>
                </div>
                @if (node.Children.Length > 0)
                {
                    <BitBhTreeGroup TValue="string">
                        @foreach (var child in node.Children)
                        {
                            @FeatureItem(child)
                        }
                    </BitBhTreeGroup>
                }
            </Template>
        </BitBhTreeItem>;
}
""";

    private const string _lazyCode = """
<BitBhTree TValue="string" aria-label="Cloud storage"
        LoadChildren="LoadChildrenAsync"
        class="w-full max-w-sm rounded-lg border border-zinc-200 bg-white p-1.5 text-sm text-zinc-900 [&_[role=treeitem]]:outline-none [&_[role=treeitem]:focus-visible>div]:outline-2 [&_[role=treeitem]:focus-visible>div]:-outline-offset-2 [&_[role=treeitem]:focus-visible>div]:outline-blue-600 [&_[aria-selected=true]>div]:bg-blue-50 [&_[aria-selected=true]>div]:font-medium [&_[aria-selected=true]>div]:text-blue-700 [&_[aria-busy=true]>div]:cursor-progress [&_[aria-busy=true]>div]:text-zinc-500">
    @foreach (var bucket in buckets)
    {
        @RemoteItem(bucket)
    }
</BitBhTree>

@code {
    private sealed record RemoteEntry(string Path, string Name, bool IsFolder);

    private readonly RemoteEntry[] buckets =
    [
        new("media", "media-bucket", true),
        new("logs", "logs-bucket", true),
        new("backups", "backups-bucket", true),
    ];

    private readonly Dictionary<string, RemoteEntry[]> loadedChildren = new();

    // Called once per folder, the first time it expands.
    private async Task LoadChildrenAsync(string path)
    {
        await Task.Delay(800); // simulate a network round-trip

        if (path.Contains('/'))
        {
            loadedChildren[path] =
            [
                new($"{path}/january.csv", "january.csv", false),
                new($"{path}/february.csv", "february.csv", false),
            ];
        }
        else
        {
            loadedChildren[path] =
            [
                new($"{path}/2025", "2025", true),
                new($"{path}/2026", "2026", true),
                new($"{path}/manifest.json", "manifest.json", false),
            ];
        }

        StateHasChanged();
    }

    private RenderFragment<RemoteEntry> RemoteItem => entry =>
        @<BitBhTreeItem TValue="string" Value="@entry.Path" Label="@entry.Name" HasChildren="entry.IsFolder">
            <Template Context="state">
                <div class="flex min-h-8 cursor-pointer select-none items-center gap-1.5 rounded-md py-1 pr-2 pl-[calc((var(--bit-bh-tree-level)_-_1)_*_1.25rem_+_0.375rem)] hover:bg-zinc-100">
                    <BitBhTreeItemToggle TValue="string" class="inline-flex size-5 flex-none items-center justify-center rounded text-xs text-zinc-400 transition-transform duration-150 hover:bg-zinc-200 hover:text-zinc-900 data-state-open:rotate-90 data-[leaf]:invisible">▸</BitBhTreeItemToggle>
                    <span class="w-5 flex-none text-center">@(entry.IsFolder ? (state.IsExpanded ? "📂" : "📁") : "📄")</span>
                    <span>@entry.Name</span>
                    @if (state.IsLoading)
                    {
                        <span class="ml-auto text-xs text-zinc-400">Loading…</span>
                        <span class="size-3.5 flex-none animate-spin rounded-full border-2 border-blue-100 border-t-blue-600" aria-hidden="true"></span>
                    }
                </div>
                @if (loadedChildren.TryGetValue(entry.Path, out var children))
                {
                    <BitBhTreeGroup TValue="string">
                        @foreach (var child in children)
                        {
                            @RemoteItem(child)
                        }
                    </BitBhTreeGroup>
                }
            </Template>
        </BitBhTreeItem>;
}
""";
}
