@page "/tw/radiogroup"

<PageTitle>Radio Group — bit BlazorHeadlessUI · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Radio Group</h1>
        <p class="mt-2 text-zinc-500">An accessible single-select group with roving tabindex and full keyboard support.</p>
        <TwSectionSwitcher Slug="radiogroup" />
    </header>

    <TwDemoBlock Title="Basic Radio Group" Code="@_basicCode">
        <Description>Click or use Up / Down arrow keys to navigate. Disabled radios are skipped.</Description>
        <LiveContent>
            <BitBhRadioGroup DefaultValue="medium" class="flex flex-col gap-2.5 data-orientation-horizontal:flex-row data-orientation-horizontal:gap-5">
                <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                    <BitBhRadio Value="small"
                             class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-300 bg-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                        <Template Context="r">
                            @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                        </Template>
                    </BitBhRadio>
                    <span>Small</span>
                </label>
                <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                    <BitBhRadio Value="medium"
                             class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-300 bg-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                        <Template Context="r">
                            @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                        </Template>
                    </BitBhRadio>
                    <span>Medium</span>
                </label>
                <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                    <BitBhRadio Value="large"
                             class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-300 bg-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                        <Template Context="r">
                            @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                        </Template>
                    </BitBhRadio>
                    <span>Large</span>
                </label>
            </BitBhRadioGroup>
        </LiveContent>
    </TwDemoBlock>

