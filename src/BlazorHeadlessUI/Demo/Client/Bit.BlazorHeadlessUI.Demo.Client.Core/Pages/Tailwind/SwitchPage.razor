    <BitBhSwitchThumb class="absolute top-1/2 left-0.5 h-4 w-4 -translate-y-1/2 rounded-full bg-white shadow transition-[left] data-state-checked:left-[calc(100%-1.125rem)]" />
</BitBhSwitch>
""";

    private const string _controlledCode = """
<div class="flex items-center gap-4">
