        @if (searching)
        {
            <span class="size-4 shrink-0 animate-spin rounded-full border-2 border-zinc-200 border-t-blue-600" aria-hidden="true"></span>
        }
    </div>
    <BitBhCommandList class="max-h-72 scroll-py-1.5 overflow-y-auto overscroll-contain p-1.5">
        @if (!searching)
        {
            <BitBhCommandEmpty class="px-4 py-8 text-center text-sm text-zinc-500">No components match “@docsQuery”.</BitBhCommandEmpty>
        }
        @foreach (var doc in docResults)
        {
            <BitBhCommandItem @key="doc.Name" Value="@doc.Name" OnSelect='@(() => Run($"Open {doc.Name} docs"))' class="flex cursor-pointer select-none items-center gap-2.5 rounded-md px-2.5 py-2 text-sm text-zinc-800 data-selected:bg-blue-50 data-selected:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                <span class="w-5 shrink-0 text-center" aria-hidden="true">📄</span>
                <span class="flex min-w-0 flex-col leading-tight">
                    <span class="font-medium">@doc.Name</span>
                    <span class="truncate text-xs text-zinc-600">@doc.Summary</span>
                </span>
            </BitBhCommandItem>
        }
    </BitBhCommandList>
</BitBhCommand>

<span class="text-sm text-zinc-500">Last command: <strong class="text-zinc-900">@(lastCommand ?? "(none)")</strong></span>

@code {
    private sealed record Doc(string Name, string Summary);

    private static readonly Doc[] _docs =
    [
        new("Accordion", "Vertically stacked, collapsible sections"),
        new("Checkbox", "Two- or three-state toggle with a label"),
        new("Combobox", "Text input with a filterable list of options"),
        new("Command Palette", "Searchable, keyboard-first list of actions"),
        new("Dialog", "Modal window with a focus trap"),
        // …
    ];

    private IReadOnlyList<Doc> docResults = _docs.Take(6).ToList();
    private string docsQuery = "";
    private bool searching;
    private int searchVersion;
    private string? lastCommand;

    private void Run(string command) => lastCommand = command;

    private async Task SearchDocsAsync(string query)
    {
        docsQuery = query;
        var version = ++searchVersion;
        searching = true;

        await Task.Delay(350); // pretend this is an HTTP call
        if (version != searchVersion) return; // a newer keystroke superseded this one

        docResults = string.IsNullOrWhiteSpace(query)
            ? _docs.Take(6).ToList()
            : BitBhFilter.Fuzzy(_docs, query, d => d.Name).ToList();
        searching = false;
    }
}
""";

