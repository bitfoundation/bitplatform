@code {
    private bool paletteOpen;
    private int selfOpens;
    private string? lastCommand;

    private void Run(string command) => lastCommand = command;

    // Fires when the palette changes its own state: the ⌘K / Ctrl+K shortcut,
    // Escape, an outside click, or running a command (which closes it).
    private void OnPaletteOpenChanged(bool open)
    {
        paletteOpen = open;
