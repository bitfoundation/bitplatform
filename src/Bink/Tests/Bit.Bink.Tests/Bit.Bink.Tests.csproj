<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CS1591;BL0005</NoWarn>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\..\AssemblyOriginatorKeyFile.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.5.1" />
        <PackageReference Include="bunit" Version="2.11.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Bink\Bit.Bink.csproj" />
    </ItemGroup>

    <!-- The visual regression baselines are read from (and, with BINK_UPDATE_GOLDEN=1, written to) the
         test output folder. -->
    <ItemGroup>
        <None Include="Golden\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
