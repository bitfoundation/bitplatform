@page "/"

<PageTitle>bit Bink - drawing and ink for Blazor</PageTitle>

<h1>bit Bink</h1>
<p class="page-intro">
    A native drawing and ink engine for Blazor. The stroke model, smoothing, pressure response, hit testing,
    undo, serialization and export are all written in C#. JavaScript only collects pointer events and replays a
    command buffer onto a canvas.
</p>

<div class="panel" style="padding:1rem">
    @* A host that reads canvas state (such as the undo button below) re-renders on this callback.
       Pointer input itself never re-renders anything. *@
    <BinkCanvas @ref="_canvas" HistoryChanged="() => StateHasChanged()" Height="260px" EnableTouchGestures="true" Brush="_brush" AriaLabel="Try drawing here"
               DocumentChanged="() => StateHasChanged()" />
</div>
<div class="toolbar" style="border:1px solid var(--border);border-top:none;border-radius:0 0 10px 10px">
    <span class="field">Draw above with a mouse, a finger or a stylus.</span>
    <div class="toolbar-spacer"></div>
    <button type="button" class="btn" disabled="@(_canvas is null || !_canvas.History.CanUndo)" @onclick="Undo">Undo</button>
    <button type="button" class="btn danger" disabled="@(_canvas is null || _canvas.CurrentDocument.IsEmpty)" @onclick="Clear">Clear</button>
</div>

