<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Besql.Demo.Client\Bit.Besql.Demo.Client.csproj" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>

    <ItemGroup>
        <!-- 
             To add migrations or optimize db context, first set `Bit.Besql.Demo` project as startup project in solution explorer,
             and open Nuget Package Manager Console, and select `Bit.Besql.Demo.Client` project as default project
             Then run either Add-Migration MigrationName -OutputDir Data\Migrations or
             Optimize-DbContext -OutputDir Data\CompiledModel commands. -->
        <!-- Microsoft.EntityFrameworkCore.Tasks is deliberately absent. On EF 11 it stops being a package you
             call on demand and becomes a publish step: it precompiles queries during publish and then fails,
             because the DbContext lives in Bit.Besql.Demo.Client rather than in this startup project. The
             Optimize-DbContext and Add-Migration commands described above come from Tools, which stays. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0-rc.1.26431.118">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
