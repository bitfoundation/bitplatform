{
    "compileOnSave": true,
    "compilerOptions": {
        "allowJs": true,
        "target": "ES2019",
        // bit-bortable.js is loaded by the C# interop through a dynamic `import()` and its
        // functions are called as named module exports, so the output must stay an ES module:
        // `module: ESNext` with `rootDir`/`outDir` emits Scripts/bit-bortable.ts straight to
        // wwwroot/bit-bortable.js with its `export`s preserved.
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [ "DOM", "DOM.Iterable", "ESNext" ],
        "rootDir": "Scripts",
        "outDir": "wwwroot",
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [ "./Scripts/**/*.ts" ]
}
