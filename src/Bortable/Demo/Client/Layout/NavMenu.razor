        "<rect x='2' y='16.5' width='13' height='4.5' rx='1.5' fill='#ccfbf1'/>" +
        "<path d='M20.5 5v14' stroke='#f0fdfa' stroke-width='1.5' stroke-linecap='round'/>" +
        "<path d='M18.5 7l2-2 2 2M18.5 17l2 2 2-2' stroke='#f0fdfa' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/>" +
        "</svg>";

