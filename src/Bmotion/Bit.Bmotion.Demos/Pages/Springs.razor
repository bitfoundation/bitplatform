@page "/springs"

<div class="demo-section">
    <h2>Spring Physics</h2>
    <p>
        Set <strong>Transition.Type = TransitionType.Spring</strong> for physically-based motion.
        Tune <em>Stiffness</em> (snap speed) and <em>Damping</em> (oscillation).
    </p>

    <div class="demo-row">
        @foreach (var cfg in _springs)
        {
            <div class="demo-card" style="flex-direction:column; gap:.75rem;">
                <span style="font-size:.78rem; color:#888">@cfg.Label</span>
                <Motion Tag="div"
                        Class="box box-sm"
                        Animate="@(_on ? new AnimationProps { X = 80 } : new AnimationProps { X = 0 })"
                        Transition="@cfg.Config" />
            </div>
        }
    </div>

    <button class="btn-bm" style="margin-top:1rem" @onclick="@(() => _on = !_on)">
        Animate
    </button>
</div>

<div class="demo-section">
    <h2>Bouncy Enter</h2>
    <p>Underdamped springs produce delightful overshoots on mount.</p>
    <div class="demo-row">
        <div class="demo-card">
            <Motion Tag="div"
                    Class="box"
                    Initial="@(new AnimationProps { Scale = 0, Rotate = -180 })"
                    Animate="@(new AnimationProps { Scale = 1, Rotate = 0 })"
                    Transition="@TransitionConfig.Spring(stiffness:260, damping:12)"
                    @key="@_mountKey" />
        </div>
    </div>
    <button class="btn-bm" style="margin-top:1rem" @onclick="Remount">Re-mount</button>
</div>

<div class="demo-section">
    <h2>Repeating Springs</h2>
    <p>
        Springs now honour <strong>Repeat</strong>, <strong>RepeatType</strong> and <strong>RepeatDelay</strong>.
        <em>Mirror</em> ping-pongs back to the start, <em>Loop</em> replays from the origin.
    </p>

    <div class="demo-row">
        <div class="demo-card" style="flex-direction:column; gap:.75rem;">
            <span style="font-size:.78rem; color:#888">Mirror &middot; infinite</span>
            <Motion Tag="div"
                    Class="box box-sm"
                    Animate="@(_repeat ? new AnimationProps { X = 90 } : new AnimationProps { X = 0 })"
                    Transition="@(new TransitionConfig
                    {
                        Type = TransitionType.Spring,
                        Stiffness = 200,
                        Damping = 12,
                        Repeat = int.MaxValue,
                        RepeatType = RepeatType.Mirror,
                    })" />
        </div>

        <div class="demo-card" style="flex-direction:column; gap:.75rem;">
            <span style="font-size:.78rem; color:#888">Loop &middot; 3&times; with delay</span>
            <Motion Tag="div"
                    Class="box box-sm"
                    Animate="@(_repeat ? new AnimationProps { Y = 60 } : new AnimationProps { Y = 0 })"
                    Transition="@(new TransitionConfig
                    {
                        Type = TransitionType.Spring,
                        Stiffness = 300,
                        Damping = 18,
                        Repeat = 3,
                        RepeatType = RepeatType.Loop,
                        RepeatDelay = 0.3,
                    })" />
        </div>
    </div>

    <button class="btn-bm" style="margin-top:1rem" @onclick="@(() => _repeat = !_repeat)">
        @(_repeat ? "Reset" : "Start repeating")
    </button>
</div>

@code {
    private bool _on;
    private bool _repeat;
    private int  _mountKey;

    private record SpringDemo(string Label, TransitionConfig Config);

    private readonly SpringDemo[] _springs =
    [
        new("Stiff 400 / Damp 40",  TransitionConfig.Spring(400, 40)),
        new("Stiff 100 / Damp 10",  TransitionConfig.Spring(100, 10)),
        new("Stiff 50 / Damp 5",    TransitionConfig.Spring(50,  5)),
        new("Stiff 300 / Damp 70",  TransitionConfig.Spring(300, 70)),
    ];

    void Remount() => _mountKey++;
}
