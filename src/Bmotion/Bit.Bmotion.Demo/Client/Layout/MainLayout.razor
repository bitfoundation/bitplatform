@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

@* The docs shell: sticky header, nav panel, content column with its "on this page" rail, footer.
   The structure and the surfaces follow the Bit.BlazorUI docs site, but nothing here is built from
   that library - this demo carries no dependency other than Bit.Bmotion itself. The styles live in
   wwwroot/css/app.css and are written against the theme tokens in wwwroot/css/theme.css.

   The home page is deliberately outside all of that. It is a landing page rather than a document:
   no nav panel, no rail, no content column - it lays out its own full-bleed sections, exactly as
   the BlazorUI docs site does. Only the header and the footer are shared, and the header narrows
   itself to the landing page's own width. *@

<div class="app-shell">
    <AppHeader IsHomePage="_isHomePage" IsHydrating="@_isHydrating"
               IsNavOpen="_isNavOpen" OnToggleNav="ToggleNav" />

    <div class="layout-row">
        @if (_isHomePage)
        {
            <div class="site-content home">
                @Body

                <AppFooter />
            </div>
        }
        else
        {
            @* Only rendered at the widths where the panel is a drawer - CSS hides it above them -
               and only while it is open, so it never covers a page that has nothing to close. *@
            @if (_isNavOpen)
            {
                <button type="button" class="nav-panel-overlay" aria-label="Close navigation" @onclick="CloseNav"></button>
            }

            <AppNavPanel IsOpen="_isNavOpen" Disabled="@_isHydrating" />

            <div class="site-content">
                <div class="page-row">
                    <div class="page-container">
                        @Body
                    </div>

                    <SideRail />
                </div>

                <AppFooter />
            </div>
        }
    </div>
</div>

@* Live engine debug overlay (plan item 3.5) - starts collapsed; click to expand. *@
<BmotionInspector StartOpen="false" />

@code {
    private bool _isNavOpen;
    private bool _isHomePage;

    // The page is prerendered on the server and is inert until the WebAssembly runtime takes over.
    // The header says so while that is true, and the interactive chrome stays disabled so a click
    // that cannot do anything does not look broken.
    private bool _isHydrating => RendererInfo.IsInteractive is false;

    private void ToggleNav() => _isNavOpen = !_isNavOpen;

    private void CloseNav() => _isNavOpen = false;

    protected override void OnInitialized()
    {
        UpdateIsHomePage();
        Nav.LocationChanged += OnLocationChanged;
    }

    // Following a link inside the drawer closes it: on the widths where the drawer exists it covers
    // the page the reader just asked for.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _isNavOpen = false;
        UpdateIsHomePage();
        StateHasChanged();
    }

    private void UpdateIsHomePage()
        => _isHomePage = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').Split('?', '#')[0].Length == 0;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
