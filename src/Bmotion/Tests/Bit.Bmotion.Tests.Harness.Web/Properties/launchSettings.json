{
  "profiles": {
    "ssr": {
      "commandName": "Project",
      "commandLineArgs": "--BmotionHarness:Mode=ssr",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5470",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "server": {
      "commandName": "Project",
      "commandLineArgs": "--BmotionHarness:Mode=server",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5470",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "wasm": {
      "commandName": "Project",
      "commandLineArgs": "--BmotionHarness:Mode=wasm",
      "launchBrowser": true,
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "applicationUrl": "http://localhost:5470",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "auto": {
      "commandName": "Project",
      "commandLineArgs": "--BmotionHarness:Mode=auto",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5470",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "wasm-strict": {
      "commandName": "Project",
      "commandLineArgs": "--BmotionHarness:Mode=wasm --BmotionHarness:Prerender=Animate --BmotionHarness:ReducedMotion=User --BmotionHarness:CssSafeMode=Throw",
      "launchBrowser": true,
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "applicationUrl": "http://localhost:5470",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    }
  }
}
