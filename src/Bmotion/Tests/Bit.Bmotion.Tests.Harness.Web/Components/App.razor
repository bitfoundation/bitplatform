@inject IConfiguration Configuration
@inject HarnessOptions Options

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* An empty icon: the default /favicon.ico request would 404 into the console of every page under test. *@
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href="harness.css" />
    @* The stylesheet BmPrerenderMode.Animate plays its CSS animations from. ?nocss=1 leaves it out, which is how
       a test proves an app that forgot it still renders every element at rest. *@
    @if (WithBmotionCss)
    {
        <link rel="stylesheet" href="_content/Bit.Bmotion/bit-bmotion.css" />
    }
    <HeadOutlet @rendermode="RenderMode" />
</head>

@* data-mode is the render mode this request was served in; data-bm-* hand the library options to the WebAssembly
   client, which has no configuration of its own (see the client's Program.cs). *@
<body data-mode="@Mode"
      data-bm-prerender="@Options.Prerender"
      data-bm-reduced-motion="@Options.ReducedMotion"
      data-bm-css-safe-mode="@Options.CssSafeMode">
    <Routes @rendermode="RenderMode" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string Mode => HttpContext?.Request.Query[HarnessRenderModes.QueryKey].FirstOrDefault()
                           ?? Configuration[HarnessRenderModes.ConfigurationKey]
                           ?? HarnessRenderModes.Auto;

    private IComponentRenderMode? RenderMode => HarnessRenderModes.Resolve(Mode);

    private bool WithBmotionCss => HttpContext?.Request.Query["nocss"].FirstOrDefault() is not "1";
}
