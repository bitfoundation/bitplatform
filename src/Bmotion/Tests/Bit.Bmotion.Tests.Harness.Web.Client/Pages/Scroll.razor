@page "/scroll"
@implements IAsyncDisposable
@inject BmotionScrollTracker Tracker

@* Scroll-linked motion: native scroll timelines (page, container, the element's own view) and
   BmotionScrollTracker's progress numbers and motion values, bound to an element without re-rendering it. *@

<HarnessHeader Title="Scroll" Ready="Ready" OnLog="BindLog" />

<Bmotion Timeline="BmScrollTimeline.Page()" Animate="Bm.To(scaleX: [0, 1])">
    <div id="page-progress" class="progress" style="position: fixed; top: 0; left: 0"></div>
</Bmotion>

<Readout @ref="_progress" Id="tracker-progress" Initial="0" />
<Readout @ref="_target" Id="tracker-target" Initial="" />

@* Bound to the tracker's progress through a derived motion value: 0..1 maps to 0..300px. *@
<Bmotion Values="_bound">
    <div id="bound" class="small" style="position: fixed; top: 40px; left: 0"></div>
</Bmotion>

<div class="scroller" id="tl-scroller">
    <div class="inner">
        <Bmotion Timeline='BmScrollTimeline.Container("#tl-scroller")' Animate="Bm.To(opacity: [0.2, 1])">
            <div id="container-driven" class="small" style="position: sticky; top: 0"></div>
        </Bmotion>
    </div>
</div>

<div class="spacer"></div>

<Bmotion Timeline="BmScrollTimeline.View()" Animate="Bm.To(x: [0, 200])">
    <div id="view-driven" class="small"></div>
</Bmotion>

<div class="spacer"></div>

<div id="tracked-target" class="box"></div>

<div class="spacer"></div>

@code {
    private Readout _progress = default!;
    private Readout _target = default!;
    private Dictionary<string, BmValue<double>> _bound = default!;

    protected override void OnInitialized()
        => _bound = new() { ["x"] = Tracker.ProgressYValue.Transform([0, 1], [0, 300]) };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender is false) return;

        await Tracker.ObserveAsync(new BmScrollOptions { TargetId = "tracked-target", Offset = ["start end", "end start"] }, info =>
        {
            _progress.Set(info.ProgressY);
            if (info.TargetProgress is double target) _target.Set(target);
        });
        Log("tracker:observing");
    }

    public ValueTask DisposeAsync() => Tracker.DisposeAsync();
}
