@inject NavigationManager NavigationManager

@* Client-side docs search over DocsCatalog - no index build and no service call: the catalog's
   titles, descriptions and keywords ARE the corpus, and it is already in the browser.

   The one piece of chrome that is not wired through data-demo-action and demo.js, because the
   corpus it searches is C# data the script has no copy of. The cost is that it is inert until
   the WebAssembly runtime takes over - the input renders during prerendering but does not answer
   a keystroke yet. The nav panel's own filter (Shared/NavMenu.razor, filterNav in demo.js) is
   the pre-boot, script-only counterpart: it narrows the rail's visible links by their label,
   while this searches every page's description and keywords and jumps straight to one.

   Items navigate on mousedown so the click wins the race against the input's blur closing the
   dropdown. The input is a WAI-ARIA combobox: ArrowUp/ArrowDown move the highlighted option,
   Enter activates it, Escape closes. demo.js focuses it from Ctrl/Cmd+K and from "/" - the
   shortcut is advertised by the key hint inside the field, so it is discoverable rather than
   folklore. *@

<div class="docs-search">
    <Icon Name="search" Class="docs-search-icon" />
    <input type="search"
           class="docs-search-input"
           placeholder="Search docs"
           aria-label="Search documentation"
           aria-keyshortcuts="Control+K"
           autocomplete="off"
           role="combobox"
           aria-autocomplete="list"
           aria-expanded="@(_results is null ? "false" : "true")"
           aria-controls="docs-search-listbox"
           aria-activedescendant="@(_results is { Length: > 0 } ? $"docs-search-option-{_activeIndex}" : null)"
           data-demo-search
           value="@_query"
           @oninput="OnInput"
           @onkeydown="OnKeyDown"
           @onblur="OnBlur" />

    @* Hidden while there is a query, because it would sit on top of the text being typed.
       aria-hidden as well as decorative: the shortcut is already announced through
       aria-keyshortcuts on the field itself, and reading "Control K" after the label would
       just be the same fact twice. *@
    @if (_query.Length == 0)
    {
        <span class="kbd docs-search-kbd" aria-hidden="true">Ctrl K</span>
    }

    @if (_results is { Length: > 0 })
    {
        <ul id="docs-search-listbox" class="docs-search-results" role="listbox">
            @for (var i = 0; i < _results.Length; i++)
            {
                var index = i;
                var entry = _results[i];
                <li role="option"
                    id="@($"docs-search-option-{index}")"
                    aria-selected="@(index == _activeIndex ? "true" : "false")"
                    class="@(index == _activeIndex ? "docs-search-active" : null)"
                    @key="entry.Slug"
                    @onmousedown="@(() => Go(entry))" @onmousedown:preventDefault>
                    <span class="docs-search-result-title">@entry.Title</span>
                    <span class="docs-search-result-section">@DocsCatalog.SectionOf(entry)</span>
                    @* The description is what turns a list of page names into a list of
                       answers - the reason to pick this row over the one below it. *@
                    <span class="docs-search-result-desc">@entry.Description</span>
                </li>
            }
        </ul>
    }
    else if (_results is { Length: 0 })
    {
        @* Rendered rather than left blank so the query is not silently swallowed. It is a
           listbox with no options, hence the presentational row. *@
        <ul id="docs-search-listbox" class="docs-search-results" role="listbox">
            <li class="docs-search-empty" role="presentation">No results for &ldquo;@_query&rdquo;</li>
        </ul>
    }
</div>

@code {
    // null = the dropdown is closed (nothing typed yet, or it was dismissed); an empty array is
    // the distinct "searched, found nothing" state the branch above renders.
    private string _query = "";
    private DocsPageInfo[]? _results;
    private int _activeIndex;

    private void OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        // One character matches most of the catalog, which is noise rather than a result list.
        _results = _query.Trim().Length < 2 ? null : Find(_query.Trim());
        _activeIndex = 0;
    }

    // Every term has to match somewhere in the entry (AND, not OR), so adding a word narrows the
    // list the way a reader expects - "cache header" finds Recipes rather than everything that
    // mentions a cache.
    private static DocsPageInfo[] Find(string query)
    {
        var terms = query.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return DocsCatalog.AllPages
            .Where(p => terms.All(t =>
                p.Title.Contains(t, StringComparison.OrdinalIgnoreCase)
                || p.Description.Contains(t, StringComparison.OrdinalIgnoreCase)
                || p.Keywords.Contains(t, StringComparison.OrdinalIgnoreCase)))
            .Take(8)
            .ToArray();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (_results is { Length: > 0 })
        {
            if (e.Key == "ArrowDown") _activeIndex = Math.Min(_activeIndex + 1, _results.Length - 1);
            else if (e.Key == "ArrowUp") _activeIndex = Math.Max(_activeIndex - 1, 0);
            else if (e.Key == "Enter") Go(_results[Math.Clamp(_activeIndex, 0, _results.Length - 1)]);
        }

        if (e.Key == "Escape") Close();
    }

    private void OnBlur() => Close();

    private void Go(DocsPageInfo page)
    {
        Reset();
        NavigationManager.NavigateTo(page.Url);
    }

    // Escape dismisses the dropdown but leaves the text alone: the query is what the person just
    // typed, and clearing it turns "hide this list" into "start over".
    private void Close()
    {
        _results = null;
        _activeIndex = 0;
    }

    private void Reset()
    {
        _query = "";
        Close();
    }
}
