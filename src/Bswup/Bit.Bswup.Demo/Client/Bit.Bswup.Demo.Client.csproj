<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- The host project owns the launch profile: this project is never run on its own,
             the host document (Server/Components/App.razor) lives on the server now. -->
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <!-- Publishes this project's wwwroot at the app root through the host, so app.css,
             demo.js, manifest.json, the icons and service-worker.js keep the exact URLs the
             standalone app served them from - which is also what the service-worker scope
             (and every asset URL recorded in service-worker-assets.js) depends on. -->
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
        <!-- Fingerprinted file names (asset.<fingerprint>.ext) would not match the URLs
             recorded in service-worker-assets.js, leaving the worker unable to precache them. -->
        <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Bswup\Bit.Bswup.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
    </ItemGroup>

</Project>
