<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The one app every harness host renders: the Blazor Web App host in each render mode
         (Bit.Bswup.Tests.Harness.Web), its WebAssembly client, and the standalone WebAssembly app the
         host mounts under /standalone/ (Bit.Bswup.Tests.Harness.Wasm). Keeping the pages and the page
         script in a single library is what lets the browser suites run the same assertions against every
         host and attribute a difference to the host. Its wwwroot files land in both clients' asset
         manifests, which is what makes them usable as precached assets the suites can fault. -->

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.Web" Version="8.0.31" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.AspNetCore.Components.Web" Version="9.0.20" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Bswup\Bit.Bswup.csproj" />
    </ItemGroup>

</Project>
