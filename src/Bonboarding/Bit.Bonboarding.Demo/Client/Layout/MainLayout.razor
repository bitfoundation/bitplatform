@inherits LayoutComponentBase

@* SiteShell is this demo's own chrome - header, navigation, footer - and stands in for your layout's
   markup. The part every application needs is the BonboardingRoot below it. *@

<SiteShell @bind-IsDark="_dark">
    @Body
</SiteShell>

@* One host renders every tour the application starts, wherever it is started from. *@
@* The site's theme switch drives the tours as well as the page. Dark forces every tour dark; in the
   light theme each tour keeps its own Theme setting, which is what lets the theming page
   demonstrate the option. *@
<BonboardingRoot Theme="@(_dark ? BonboardingTheme.Dark : null)" />

@code {
    private bool _dark;
}
