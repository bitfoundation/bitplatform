@page "/not-found"
@layout MainLayout

@* Covers both a deep link the server could not route (Program.cs re-executes it here) and client-side
   navigation to an unknown route (via the router's NotFoundPage parameter). *@

<PageTitle>Not found - Bit.Bonboarding</PageTitle>

<div class="error-page">
    <span class="error-code" aria-hidden="true">404</span>

    <h1>This page does not exist</h1>

    <p>
        There is nothing at this address. Every page of the docs is a working tour, and they start with
        placement and the spotlight.
    </p>

    <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="@NavItem.All[0].Url">
            Read the docs
            <Icon Path="@Icons.ArrowRight" />
        </a>
        <a class="btn btn-lg" href="/">Back to home</a>
    </div>
</div>
