<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <!-- Shares the Bit.Bmage namespace with the Blazor integration package, so `using Bit.Bmage;`
             brings in the engine and the browser services alike. -->
        <RootNamespace>Bit.Bmage</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <PackageDescription>Browser-independent image processing engine of bit Bmage: pixel buffers, transforms, adjustments, filters, drawing, annotations, EXIF metadata, managed PNG/JPEG/BMP/GIF codecs and composable non-destructive pipelines.</PackageDescription>
        <PackageTags>Bit;Bmage;image;crop;resize;exif;annotation;png;jpeg</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.Bmage" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bmage.Editor" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bmage.Tests" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bmage.Benchmarks" PublicKey="" />
    </ItemGroup>

</Project>
