@namespace Bit.Bdnd
@typeparam TItem
@implements IDisposable

@if (ChildContent is not null)
{
    @ChildContent(BuildState())
}

@code {
    [CascadingParameter] private BdndDragDropManager? Manager { get; set; }

    /// <summary>The preview to render; it receives the live drag state, offsets included.</summary>
    [Parameter] public RenderFragment<BdndDragLayerState<TItem>>? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (Manager is null)
            throw new InvalidOperationException(
                $"{nameof(BdndDragLayer<TItem>)} must be placed inside a {nameof(BdndProvider)}.");
        Manager.StateChanged += OnChanged;
        Manager.OffsetChanged += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private BdndDragLayerState<TItem> BuildState()
    {
        var m = Manager!.Monitor;
        return new BdndDragLayerState<TItem>
        {
            Monitor = m,
            IsDragging = m.IsDragging(),
            ItemType = m.GetItemType(),
            Item = m.GetItem() is TItem t ? t : default,
            InitialClientOffset = m.GetInitialClientOffset(),
            InitialSourceClientOffset = m.GetInitialSourceClientOffset(),
            ClientOffset = m.GetClientOffset(),
            DifferenceFromInitialOffset = m.GetDifferenceFromInitialOffset(),
            SourceClientOffset = m.GetSourceClientOffset(),
        };
    }

    public void Dispose()
    {
        if (Manager is null) return;
        Manager.StateChanged -= OnChanged;
        Manager.OffsetChanged -= OnChanged;
    }
}
