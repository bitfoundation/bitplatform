@page "/examples/selection-gestures"

<PageTitle>Selection Gestures - bit Blow</PageTitle>

<ExampleScaffold Title="Selection Gestures"
                 Summary="A selection is a thing in its own right, not just several selected nodes. Dragging one member moves them all and reports it as a single OnSelectionDrag rather than a burst of node drags; right-clicking one of them offers the whole selection. The key that opens a selection box is configurable separately from the one that adds to a selection.">
    <Toolbar>
        <label>
            Selection key
            <select @bind="_selectionKey">
                <option value="Shift">Shift</option>
                <option value="Alt">Alt</option>
                <option value="Control">Control</option>
                <option value="None">none (drag pans)</option>
            </select>
        </label>
        <label>
            Multi-select key
            <select @bind="_multiKey">
                <option value="Shift">Shift</option>
                <option value="Alt">Alt</option>
                <option value="Control">Control</option>
            </select>
        </label>
        <label>
            <input type="checkbox" @bind="_selectionOnDrag" /> Selection on plain drag
        </label>
        <button class="btn" @onclick="ClearLog">Clear log</button>
    </Toolbar>
    <ChildContent>
        <BlowCanvas Nodes="_nodes"
                    Edges="_edges"
                    SelectionKey="SelectionKey"
                    MultiSelectionKey="MultiKey"
                    SelectionOnDrag="_selectionOnDrag"
                    OnSelectionDragStart="OnSelectionDragStart"
                    OnSelectionDragStop="OnSelectionDragStop"
                    OnSelectionContextMenu="OnSelectionContextMenu"
                    OnNodeDragStart="OnNodeDragStart"
                    FitViewOnInit="true">
            <BlowBackground Variant="BlowBackgroundVariant.Dots" Gap="20" />
            <BlowControls />
            <BlowPanel Anchor="BlowPanelPosition.TopRight">
                <div class="log">
                    <div class="log-title">Events</div>
                    @if (_log.Count == 0)
                    {
                        <div class="log-empty">
                            Box-select a few nodes, then drag one of them - or right-click one.
                        </div>
                    }
                    @foreach (var entry in _log)
                    {
                        <div class="log-row">@entry</div>
                    }
                </div>
            </BlowPanel>
        </BlowCanvas>
    </ChildContent>
</ExampleScaffold>

<style>
    .log {
        width: 240px;
        max-height: 260px;
        overflow-y: auto;
        padding: 8px 10px;
        font-size: 11px;
        background: var(--bit-blow-surface);
        color: var(--bit-blow-text);
        border: 1px solid var(--bit-blow-border);
        border-radius: 6px;
    }
    .log-title { font-weight: 600; margin-bottom: 4px; }
    .log-empty { color: #6b7280; line-height: 1.45; }
    .log-row { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; padding: 1px 0; }
</style>

@code {
    private List<BlowNode> _nodes = [];
    private List<BlowEdge> _edges = [];
    private readonly List<string> _log = [];

    private string _selectionKey = "Shift";
    private string _multiKey = "Shift";
    private bool _selectionOnDrag;

    private BlowModifierKey? SelectionKey => _selectionKey switch
    {
        "Alt" => BlowModifierKey.Alt,
        "Control" => BlowModifierKey.Control,
        "None" => null,
        _ => BlowModifierKey.Shift,
    };

    private BlowModifierKey MultiKey => _multiKey switch
    {
        "Alt" => BlowModifierKey.Alt,
        "Control" => BlowModifierKey.Control,
        _ => BlowModifierKey.Shift,
    };

    protected override void OnInitialized()
    {
        _nodes =
        [
            new BlowNode { Id = "a", Label = "Read", Position = new(40, 40) },
            new BlowNode { Id = "b", Label = "Parse", Position = new(240, 40) },
            new BlowNode { Id = "c", Label = "Filter", Position = new(440, 40) },
            new BlowNode { Id = "d", Label = "Reduce", Position = new(140, 200) },
            new BlowNode { Id = "e", Label = "Write", Position = new(380, 200) },
        ];

        _edges =
        [
            new BlowEdge { Id = "a-b", Source = "a", Target = "b" },
            new BlowEdge { Id = "b-c", Source = "b", Target = "c" },
            new BlowEdge { Id = "b-d", Source = "b", Target = "d" },
            new BlowEdge { Id = "d-e", Source = "d", Target = "e" },
        ];
    }

    private void OnNodeDragStart(BlowNode node) => Log($"node drag: {node.Id}");

    private void OnSelectionDragStart(BlowSelectionMouseEvent e) => Log($"selection drag start: {Ids(e)}");

    private void OnSelectionDragStop(BlowSelectionMouseEvent e) => Log($"selection drag stop: {Ids(e)}");

    private void OnSelectionContextMenu(BlowSelectionMouseEvent e) => Log($"selection menu: {Ids(e)}");

    private static string Ids(BlowSelectionMouseEvent e) => string.Join(", ", e.Nodes.Select(n => n.Id));

    private void Log(string message)
    {
        _log.Insert(0, message);
        if (_log.Count > 12) _log.RemoveAt(_log.Count - 1);
    }

    private void ClearLog() => _log.Clear();
}
