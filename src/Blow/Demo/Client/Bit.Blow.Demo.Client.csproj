<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- The host owns the launch profile: this project is never started on its own. -->
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <!-- Publishes this project's static web assets at the app root (not under _content/), the
             way a Blazor Web App's client project is expected to contribute them. -->
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Blow\Bit.Blow.csproj" />
    </ItemGroup>

    <!--
        Generates a compiled lookup (DemoSources.g.cs) that maps each routable demo page's
        @page route to its full .razor source text, so the demo can render "View code"
        snippets at runtime without any per-page wiring.
    -->
    <UsingTask TaskName="GenerateDemoSources"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <SourceDir ParameterType="System.String" Required="true" />
            <OutputFile ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs">
<![CDATA[
var sb = new StringBuilder();
sb.AppendLine("// <auto-generated />");
sb.AppendLine("namespace Bit.Blow.Demo.Client.Examples;");
sb.AppendLine("public static class DemoSources");
sb.AppendLine("{");
// Case-insensitive, like the router: /Examples/Basic renders the same page as /examples/basic.
sb.AppendLine("    public static readonly System.Collections.Generic.Dictionary<string, string> ByRoute = new(System.StringComparer.OrdinalIgnoreCase)");
sb.AppendLine("    {");
foreach (var file in Directory.GetFiles(SourceDir, "*.razor", SearchOption.AllDirectories))
{
    var content = File.ReadAllText(file);
    var match = Regex.Match(content, "@page\\s+\"([^\"]+)\"");
    if (!match.Success) continue;
    var route = match.Groups[1].Value.TrimStart('/');

    // Strip demo-app chrome so the snippet shows only the example itself.
    // 1. The @page routing directive.
    content = Regex.Replace(content, @"(?m)^[ \t]*@page[ \t]+""[^""]*""[ \t]*\r?\n", "");
    // 2. The <PageTitle> that sets the browser tab title.
    content = Regex.Replace(content, @"(?s)[ \t]*<PageTitle>.*?</PageTitle>[ \t]*\r?\n", "");
    // 3. The demo-header description block on the hand-written demo pages. Its end is found by
    //    balancing <div> tags rather than with a lazy match, which would stop at the first
    //    </div> nested inside the header and leave the rest of it behind.
    var header = Regex.Match(content, @"[ \t]*<div class=""demo-header"">");
    if (header.Success)
    {
        var depth = 0;
        var end = -1;
        for (var tag = Regex.Match(content.Substring(header.Index), @"<div\b|</div\s*>"); tag.Success; tag = tag.NextMatch())
        {
            depth += tag.Value.StartsWith("</", StringComparison.Ordinal) ? -1 : 1;
            if (depth == 0)
            {
                end = header.Index + tag.Index + tag.Length;
                break;
            }
        }
        if (end >= 0)
        {
            // Take the rest of the closing tag's line with it.
            var rest = Regex.Match(content.Substring(end), @"^[ \t]*\r?\n");
            if (rest.Success) end += rest.Length;
            content = content.Remove(header.Index, end - header.Index);
        }
    }
    // 4. The Summary description attribute on ExampleScaffold-based pages.
    content = Regex.Replace(content,
        @"(<ExampleScaffold\b[^>]*?)\s*Summary=""[^""]*""([^>]*>)",
        m => m.Groups[1].Value.TrimEnd() + m.Groups[2].Value);
    // 5. The <DemoCode /> toggle element (it powers this snippet, it isn't part of the demo).
    content = Regex.Replace(content, @"(?s)[ \t]*<DemoCode[ \t]*/>[ \t]*\r?\n", "");
    // Collapse any runs of blank lines left by the removals.
    content = Regex.Replace(content, @"(\r?\n){3,}", "\n\n");
    // Drop any blank lines left at the very top.
    content = content.TrimStart('\r', '\n', ' ', '\t');

    var keyEsc = route.Replace("\"", "\"\"");
    var valEsc = content.Replace("\"", "\"\"");
    sb.Append("        [@\"").Append(keyEsc).Append("\"] = @\"").Append(valEsc).AppendLine("\",");
}
sb.AppendLine("    };");
sb.AppendLine("}");

// Only touch the file when its content changed: rewriting it on every build would bump its
// timestamp and force a full recompile of the demo even when no page was edited.
var text = sb.ToString();
if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
{
    Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
    File.WriteAllText(OutputFile, text, new UTF8Encoding(false));
}
]]>
            </Code>
        </Task>
    </UsingTask>

    <Target Name="GenerateDemoSources" BeforeTargets="BeforeCompile;CoreCompile">
        <PropertyGroup>
            <DemoSourcesFile>$(IntermediateOutputPath)DemoSources.g.cs</DemoSourcesFile>
        </PropertyGroup>
        <GenerateDemoSources SourceDir="$(MSBuildProjectDirectory)\Pages" OutputFile="$(DemoSourcesFile)" />
        <!-- Unconditional: the file has to be compiled whether or not this build rewrote it.
             FileWrites lets Clean delete it. -->
        <ItemGroup>
            <Compile Include="$(DemoSourcesFile)" />
            <FileWrites Include="$(DemoSourcesFile)" />
        </ItemGroup>
    </Target>

</Project>
