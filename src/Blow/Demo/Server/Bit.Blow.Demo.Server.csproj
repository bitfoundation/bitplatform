<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <!-- Serves the client's _framework payload and enables WebAssembly debugging from this host. -->
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
        <!-- The MCP server (see Controllers/McpController.cs), mapped at /mcp. -->
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Blow\Bit.Blow.csproj" />
        <ProjectReference Include="..\Client\Bit.Blow.Demo.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Bit.Blow" />
        <Using Include="Microsoft.AspNetCore.Mvc" />
    </ItemGroup>

    <ItemGroup>
        <!-- The MCP tests boot this very app: WebApplicationFactory needs its entry point type, which
             top-level statements declare as internal. -->
        <InternalsVisibleTo Include="Bit.Blow.Tests.Mcp" />
    </ItemGroup>

    <!-- Text the MCP server hands out. It is embedded rather than read from disk so the tools keep
         working from a published deployment, where none of these files exist next to the app.
         LogicalName is set explicitly because the resource name IS the path an MCP client asks for. -->
    <ItemGroup>
        <EmbeddedResource Include="..\..\README.md" LogicalName="BlowDocs/README.md" />

        <!-- The stylesheet as written, comments included: the theme tool reads its custom properties, and
             the search index its classes and the comments that say why each rule exists, out of it. -->
        <EmbeddedResource Include="..\..\Bit.Blow\Styles\bit-blow.css" LogicalName="BlowSource/Library/Styles/bit-blow.css" />

        <!-- Every demo page - each one is a working flow - plus the examples gallery, its scaffold and the
             client half of the hosting. The MCP page describes this server rather than the library, and
             the not-found page teaches nothing about flows. -->
        <EmbeddedResource Include="..\Client\**\*.razor;..\Client\**\*.cs"
                          Exclude="..\Client\bin\**;..\Client\obj\**;..\Client\Pages\McpServer.razor;..\Client\Pages\NotFound.razor">
            <LogicalName>BlowSource/Demo/Client/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <EmbeddedResource Include="Program.cs" LogicalName="BlowSource/Demo/Server/Program.cs" />

        <!-- The Components\ prefix is written out: %(RecursiveDir) only captures what the '**' matched.
             Error.razor is the template's own error page and says nothing about flows. -->
        <EmbeddedResource Include="Components\**\*.razor" Exclude="Components\Pages\Error.razor">
            <LogicalName>BlowSource/Demo/Server/Components/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
