<PageTitle>@Title - bit platform</PageTitle>

<HeadContent>
    <meta name="description" content="@Description" />
    @if (IsNoIndex)
    {
        <meta name="robots" content="noindex" />
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="bit platform" />
    <meta property="og:title" content="@Title - bit platform" />
    <meta property="og:description" content="@Description" />
    <meta property="og:image" content="@ImageUrl" />
    <meta property="og:url" content="https://bitplatform.dev/@Url" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@("@bitplatformhq")" />
    <meta name="twitter:title" content="@Title - bit platform" />
    <meta name="twitter:description" content="@Description" />
    <meta name="twitter:image" content="@ImageUrl" />

    <link rel="canonical" href="https://bitplatform.dev/@Url">

    @if (ChildContent is not null)
    {
        @ChildContent
    }
</HeadContent>
