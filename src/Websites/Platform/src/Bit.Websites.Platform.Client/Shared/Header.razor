@inherits AppComponentBase

<header class="main-header">
    <BitLink Class="skip-link" Href="#main-content" NoColor NoUnderline>Skip to main content</BitLink>
    <div class="header-main-container">
        <div class="header-content-container">
            @if (navMenuService.IsDocsRoute)
            {
                <BitButton Class="header-menu-btn"
                           Variant="BitVariant.Text"
                           AriaLabel="Toggle documentation navigation"
                           OnClick=@WrapHandled(ToggleMenu)>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M21 7.75H3C2.59 7.75 2.25 7.41 2.25 7C2.25 6.59 2.59 6.25 3 6.25H21C21.41 6.25 21.75 6.59 21.75 7C21.75 7.41 21.41 7.75 21 7.75Z" fill="currentColor" />
                        <path d="M21 12.75H3C2.59 12.75 2.25 12.41 2.25 12C2.25 11.59 2.59 11.25 3 11.25H21C21.41 11.25 21.75 11.59 21.75 12C21.75 12.41 21.41 12.75 21 12.75Z" fill="currentColor" />
                        <path d="M21 17.75H3C2.59 17.75 2.25 17.41 2.25 17C2.25 16.59 2.59 16.25 3 16.25H21C21.41 16.25 21.75 16.59 21.75 17C21.75 17.41 21.41 17.75 21 17.75Z" fill="currentColor" />
                    </svg>
                </BitButton>
            }
            <BitLink Class="header-logo" Href="@Urls.Home" AriaLabel="bit platform home page" NoColor NoUnderline />
            @* The mouseenter handler is attached only while force-closed is set (it just lifts that
               flag), so the common hover path stays pure CSS with no interop roundtrip or re-render. *@
            <div class="header-link header-ps-btn @(navMenuService.IsProductsRoute ? "header-link--active" : null) @(isProductsMenuOpen ? "open" : null) @(isProductsMenuForceClosed ? "force-closed" : null)"
                 @onmouseenter="ProductsMenuMouseEnterCallback"
                 @onkeydown="WrapHandled<KeyboardEventArgs>(HandleProductsMenuKeyDown)">
                <BitLink Class="header-ps-trigger"
                         NoColor
                         NoUnderline
                         aria-haspopup="true"
                         aria-controls="header-products-menu"
                         aria-expanded="@(isProductsMenuOpen ? "true" : "false")"
                         OnClick=@WrapHandled(ToggleProductsMenu)>
                    Products
                    <svg class="ps-chevron" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </BitLink>
                <div class="header-menu-popup" id="header-products-menu">
                    <div class="col">
                        @foreach (var item in mainProductMenuItems)
                        {
                            @ProductMenuItemTemplate(item, HandleProductMenuItemClick)
                        }
                        @* The flyout is positioned against the popup (not this wrapper), so it opens flush
                           with the popup's top-right corner whatever the trigger's row. *@
                        @foreach (var subMenu in productSubMenus)
                        {
                            <div class="menu-sub @(openSubMenu == subMenu ? "open" : null)">
                                <BitLink Class="@($"menu-item menu-sub-trigger {(IsSubMenuActive(subMenu) ? "active" : null)}")"
                                         NoColor
                                         NoUnderline
                                         aria-haspopup="true"
                                         aria-controls="@($"header-{subMenu.Id}-menu")"
                                         aria-expanded="@(openSubMenu == subMenu ? "true" : "false")"
                                         OnClick=@WrapHandled(() => ToggleSubMenu(subMenu))>
                                    <div class="menu-item-content">
                                        <BitText Typography="BitTypography.Inherit" Element="div" Class="item-title">@subMenu.Title</BitText>
                                        <BitText Typography="BitTypography.Inherit" Element="div" Class="item-desc">@subMenu.Description</BitText>
                                    </div>
                                    <svg class="menu-sub-chevron" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </BitLink>
                                <div class="menu-sub-popup" id="header-@(subMenu.Id)-menu">
                                    @foreach (var item in subMenu.Items)
                                    {
                                        @ProductMenuItemTemplate(item, HandleProductMenuItemClick)
                                    }
                                </div>
                            </div>
                        }
                        <div class="menu-all">
                            @ProductMenuItemTemplate(allProductsMenuItem, HandleProductMenuItemClick)
                        </div>
                    </div>
                </div>
            </div>
            <BitLink Class="@($"header-link {(navMenuService.IsCurrentUrl(Urls.Demos) ? "header-link--active" : null)}")" Href="@Urls.Demos" NoColor NoUnderline>Demos</BitLink>
            <BitLink Class="@($"header-link {(navMenuService.IsCurrentUrl(Urls.Pricing) ? "header-link--active" : null)}")" Href="@Urls.Pricing" NoColor NoUnderline>Pricing</BitLink>
            <BitLink Class="@($"header-link {(navMenuService.IsCurrentUrl(Urls.AboutUs) ? "header-link--active" : null)}")" Href="@Urls.AboutUs" NoColor NoUnderline>About us</BitLink>
            <BitLink Class="@($"header-link {(navMenuService.IsCurrentUrl(Urls.ContactUs) ? "header-link--active" : null)}")" Href="@Urls.ContactUs" NoColor NoUnderline>Contact us</BitLink>
        </div>
        <div class="right-section">
            <BitLink Class="github-container" Href="@Urls.GithubRepo" Target="_blank" AriaLabel="GitHub repository" Title="GitHub repository" NoColor NoUnderline>
                <span class="github-btn"></span>
            </BitLink>

            <BitLink OnClick="WrapHandled(ToggleTheme)" Class="toggle-theme-btn dark-theme" Title="Turn on light" AriaLabel="Switch to light theme" NoColor NoUnderline>
                <span class="icon-container">
                    <BitImage Src="/images/sun.svg" Alt="" Class="theme-icon" />
                </span>
            </BitLink>
            <BitLink OnClick="WrapHandled(ToggleTheme)" Class="toggle-theme-btn light-theme" Title="Turn off light" AriaLabel="Switch to dark theme" NoColor NoUnderline>
                <span class="icon-container">
                    <BitImage Src="/images/moon.svg" Alt="" Class="theme-icon" />
                </span>
            </BitLink>
        </div>
    </div>

    <div class="header-second-row">
        <BitActionButton IconName="ChevronRight"
                         Class="header-action-button"
                         OnClick="@WrapHandled(ToggleHeaderMenu)"
                         AriaLabel="@($"{(isHeaderMenuOpen ? "Close" : "Open")} site navigation")"
                         Styles="@(new() { Icon = isHeaderMenuOpen ? "transform:rotate(-90deg)" : "transform:rotate(90deg)" })">
            @GetActiveRouteName()
        </BitActionButton>
    </div>
</header>

@if (isHeaderMenuOpen)
{
    <nav class="header-nav" @onkeydown="WrapHandled<KeyboardEventArgs>(HandleHeaderNavKeyDown)">
        <BitButton IconName="Cancel"
                   Variant="BitVariant.Text"
                   Class="header-nav-close-btn"
                   AriaLabel="Close site navigation"
                   OnClick="@WrapHandled(ToggleHeaderMenu)" />
        <div class="header-nav-item">
            <BitLink Class="@($"header-nav-link header-nav-products-trigger {(navMenuService.IsProductsRoute ? "header-nav-link--active" : null)}")"
                     NoColor
                     NoUnderline
                     aria-controls="@(isMobileProductsOpen ? "header-nav-products" : null)"
                     aria-expanded="@(isMobileProductsOpen ? "true" : "false")"
                     OnClick=@WrapHandled(ToggleMobileProducts)>
                Products
                <svg class="ps-chevron @(isMobileProductsOpen ? "open" : null)" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </BitLink>
            @if (isMobileProductsOpen)
            {
                <div class="header-nav-products" id="header-nav-products">
                    @foreach (var item in mainProductMenuItems)
                    {
                        @ProductMenuItemTemplate(item, ToggleHeaderMenu)
                    }
                    @foreach (var subMenu in productSubMenus)
                    {
                        <div class="header-nav-sub">
                            <BitLink Class="@($"menu-item header-nav-sub-trigger {(IsSubMenuActive(subMenu) ? "active" : null)}")"
                                     NoColor
                                     NoUnderline
                                     aria-controls="@(openMobileSubMenu == subMenu ? $"header-nav-{subMenu.Id}" : null)"
                                     aria-expanded="@(openMobileSubMenu == subMenu ? "true" : "false")"
                                     OnClick=@WrapHandled(() => ToggleMobileSubMenu(subMenu))>
                                <div class="menu-item-content">
                                    <BitText Typography="BitTypography.Inherit" Element="div" Class="item-title">@subMenu.Title</BitText>
                                    <BitText Typography="BitTypography.Inherit" Element="div" Class="item-desc">@subMenu.Description</BitText>
                                </div>
                                <svg class="ps-chevron @(openMobileSubMenu == subMenu ? "open" : null)" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </BitLink>
                            @if (openMobileSubMenu == subMenu)
                            {
                                <div class="header-nav-sub-list" id="header-nav-@(subMenu.Id)">
                                    @foreach (var item in subMenu.Items)
                                    {
                                        @ProductMenuItemTemplate(item, ToggleHeaderMenu)
                                    }
                                </div>
                            }
                        </div>
                    }
                    <div class="header-nav-all">
                        @ProductMenuItemTemplate(allProductsMenuItem, ToggleHeaderMenu)
                    </div>
                </div>
            }
        </div>
        <BitLink Class="@($"header-nav-link {(navMenuService.IsCurrentUrl(Urls.Demos) ? "header-nav-link--active" : null)}")" Href="@Urls.Demos" OnClick=@WrapHandled(ToggleHeaderMenu) NoColor NoUnderline>Demos</BitLink>
        <BitLink Class="@($"header-nav-link {(navMenuService.IsCurrentUrl(Urls.Pricing) ? "header-nav-link--active" : null)}")" Href="@Urls.Pricing" OnClick=@WrapHandled(ToggleHeaderMenu) NoColor NoUnderline>Pricing</BitLink>
        <BitLink Class="@($"header-nav-link {(navMenuService.IsCurrentUrl(Urls.AboutUs) ? "header-nav-link--active" : null)}")" Href="@Urls.AboutUs" OnClick=@WrapHandled(ToggleHeaderMenu) NoColor NoUnderline>About us</BitLink>
        <BitLink Class="@($"header-nav-link {(navMenuService.IsCurrentUrl(Urls.ContactUs) ? "header-nav-link--active" : null)}")" Href="@Urls.ContactUs" OnClick=@WrapHandled(ToggleHeaderMenu) NoColor NoUnderline>Contact us</BitLink>
    </nav>
}

@code {
    // Shared between the desktop popup (and its Utilities flyout) and the mobile list; only the
    // click behavior differs.
    private RenderFragment ProductMenuItemTemplate(ProductLink item, Func<Task> onClick) =>
        @<text>
            @if (item.Disabled)
            {
                <div class="menu-item menu-item--disabled" aria-disabled="true">
                    <div class="menu-item-content">
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="item-title">@((MarkupString)item.Title)</BitText>
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="item-desc">@item.Description</BitText>
                    </div>
                </div>
            }
            else
            {
                <BitLink Class="@($"menu-item {(IsMenuItemActive(item) ? "active" : null)}")"
                         Href="@item.Url"
                         Target="@(item.External ? "_blank" : null)"
                         NoColor
                         NoUnderline
                         OnClick="WrapHandled(onClick)">
                    <div class="menu-item-content">
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="item-title">@((MarkupString)item.Title)</BitText>
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="item-desc">@item.Description</BitText>
                    </div>
                </BitLink>
            }
        </text>;
}
