@inherits AppComponentBase

<header class="main-header">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="header-main-container">
        <div class="header-content-container">
            @if (isDocsRoute)
            {
                <BitButton Class="header-menu-btn"
                           Variant="BitVariant.Text"
                           AriaLabel="Toggle documentation navigation"
                           OnClick=@WrapHandled(ToggleMenu)>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M21 7.75H3C2.59 7.75 2.25 7.41 2.25 7C2.25 6.59 2.59 6.25 3 6.25H21C21.41 6.25 21.75 6.59 21.75 7C21.75 7.41 21.41 7.75 21 7.75Z" fill="currentColor" />
                        <path d="M21 12.75H3C2.59 12.75 2.25 12.41 2.25 12C2.25 11.59 2.59 11.25 3 11.25H21C21.41 11.25 21.75 11.59 21.75 12C21.75 12.41 21.41 12.75 21 12.75Z" fill="currentColor" />
                        <path d="M21 17.75H3C2.59 17.75 2.25 17.41 2.25 17C2.25 16.59 2.59 16.25 3 16.25H21C21.41 16.25 21.75 16.59 21.75 17C21.75 17.41 21.41 17.75 21 17.75Z" fill="currentColor" />
                    </svg>
                </BitButton>
            }
            <a class="header-logo" href="@Urls.Home" aria-label="bit platform home page" />
            <div class="header-link header-ps-btn @(isProductsRoute ? "header-link--active" : null) @(isProductsMenuOpen ? "open" : null) @(isProductsMenuForceClosed ? "force-closed" : null)"
                 @onmouseleave="WrapHandled(HandleProductsMenuMouseLeave)"
                 @onkeydown="WrapHandled<KeyboardEventArgs>(HandleProductsMenuKeyDown)">
                <button type="button"
                        class="header-ps-trigger"
                        aria-haspopup="true"
                        aria-controls="header-products-menu"
                        aria-expanded="@(isProductsMenuOpen ? "true" : "false")"
                        @onclick=@WrapHandled(ToggleProductsMenu)>
                    Products
                    <svg class="ps-chevron" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <div class="header-menu-popup" id="header-products-menu">
                    @foreach (var column in productMenuColumns)
                    {
                        <div class="col">
                            @foreach (var item in column)
                            {
                                @if (item.Disabled)
                                {
                                    <div class="menu-item menu-item--disabled" aria-disabled="true">
                                        <div class="menu-item-content">
                                            <div class="item-title">@((MarkupString)item.Title)</div>
                                            <div class="item-desc">@item.Description</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <a class="menu-item @(IsMenuItemActive(item) ? "active" : null)"
                                       href="@item.Url"
                                       target="@(item.External ? "_blank" : null)"
                                       rel="@(item.External ? "noopener" : null)"
                                       @onclick="WrapHandled(HandleProductMenuItemClick)">
                                        <div class="menu-item-content">
                                            <div class="item-title">@((MarkupString)item.Title)</div>
                                            <div class="item-desc">@item.Description</div>
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
            <a class="header-link @(currentUrl == Urls.Demos ? "header-link--active" : null)" href="@Urls.Demos">Demos</a>
            <a class="header-link @(currentUrl == Urls.Pricing ? "header-link--active" : null)" href="@Urls.Pricing">Pricing</a>
            <a class="header-link @(currentUrl == Urls.AboutUs ? "header-link--active" : null)" href="@Urls.AboutUs">About us</a>
            <a class="header-link @(currentUrl == Urls.ContactUs ? "header-link--active" : null)" href="@Urls.ContactUs">Contact us</a>
        </div>
        <div class="right-section">
            <a class="github-container" target="_blank" rel="noopener" aria-label="GitHub repository" title="GitHub repository" href="@Urls.GithubRepo">
                <span class="github-btn"></span>
            </a>

            <button @onclick="WrapHandled(ToggleTheme)" class="toggle-theme-btn dark-theme" title="Turn on light" aria-label="Switch to light theme">
                <span class="icon-container">
                    <img src="/images/sun.png" alt="" />
                </span>
            </button>
            <button @onclick="WrapHandled(ToggleTheme)" class="toggle-theme-btn light-theme" title="Turn off light" aria-label="Switch to dark theme">
                <span class="icon-container">
                    <img src="/images/moon.svg" alt="" />
                </span>
            </button>
        </div>
    </div>

    <div class="header-second-row">
        <BitActionButton IconName="ChevronRight"
                         Class="header-action-button"
                         OnClick="@WrapHandled(ToggleHeaderMenu)"
                         AriaLabel="@($"{(isHeaderMenuOpen ? "Close" : "Open")} site navigation")"
                         Styles="@(new() { Icon = isHeaderMenuOpen ? "transform:rotate(-90deg)" : "transform:rotate(90deg)" })">
            @GetActiveRouteName()
        </BitActionButton>
    </div>
</header>

@if (isHeaderMenuOpen)
{
    <nav class="header-nav" @onkeydown="WrapHandled<KeyboardEventArgs>(HandleHeaderNavKeyDown)">
        <BitButton IconName="Cancel"
                   Variant="BitVariant.Text"
                   Class="header-nav-close-btn"
                   AriaLabel="Close site navigation"
                   OnClick="@WrapHandled(ToggleHeaderMenu)" />
        <div class="header-nav-item">
            <button type="button"
                    class="header-nav-link header-nav-products-trigger @(isProductsRoute ? "header-nav-link--active" : null)"
                    aria-controls="header-nav-products"
                    aria-expanded="@(isMobileProductsOpen ? "true" : "false")"
                    @onclick=@WrapHandled(ToggleMobileProducts)>
                Products
                <svg class="ps-chevron @(isMobileProductsOpen ? "open" : null)" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            @if (isMobileProductsOpen)
            {
                <div class="header-nav-products" id="header-nav-products">
                    @foreach (var item in productMenuColumns.SelectMany(c => c))
                    {
                        @if (item.Disabled)
                        {
                            <div class="menu-item menu-item--disabled" aria-disabled="true">
                                <div class="menu-item-content">
                                    <div class="item-title">@((MarkupString)item.Title)</div>
                                    <div class="item-desc">@item.Description</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="menu-item @(IsMenuItemActive(item) ? "active" : null)"
                               href="@item.Url"
                               target="@(item.External ? "_blank" : null)"
                               rel="@(item.External ? "noopener" : null)"
                               @onclick=@WrapHandled(ToggleHeaderMenu)>
                                <div class="menu-item-content">
                                    <div class="item-title">@((MarkupString)item.Title)</div>
                                    <div class="item-desc">@item.Description</div>
                                </div>
                            </a>
                        }
                    }
                </div>
            }
        </div>
        <a class="header-nav-link @(currentUrl == Urls.Demos ? "header-nav-link--active" : null)" href="@Urls.Demos" @onclick=@WrapHandled(ToggleHeaderMenu)>Demos</a>
        <a class="header-nav-link @(currentUrl == Urls.Pricing ? "header-nav-link--active" : null)" href="@Urls.Pricing" @onclick=@WrapHandled(ToggleHeaderMenu)>Pricing</a>
        <a class="header-nav-link @(currentUrl == Urls.AboutUs ? "header-nav-link--active" : null)" href="@Urls.AboutUs" @onclick=@WrapHandled(ToggleHeaderMenu)>About us</a>
        <a class="header-nav-link @(currentUrl == Urls.ContactUs ? "header-nav-link--active" : null)" href="@Urls.ContactUs" @onclick=@WrapHandled(ToggleHeaderMenu)>Contact us</a>
    </nav>
}
