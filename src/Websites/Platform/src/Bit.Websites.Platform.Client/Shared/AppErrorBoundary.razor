@inherits ErrorBoundaryBase

@if (CurrentException is null)
{
    @ChildContent
}
else if (ErrorContent is null)
{
    <div class="main">
        <div class="header">
            <BitButton OnClick="Recover" IconName="Cancel" Variant="BitVariant.Text" />
        </div>
        <div>
            <BitImage Src="/images/error-triangle.svg" Alt="" Class="error-image" />
        </div>
        <BitText Typography="BitTypography.Inherit" Element="h1" Class="title">Oops, something went wrong...</BitText>
        @if (showException)
        {
            <BitText Typography="BitTypography.Inherit" Element="div" Class="exception">@CurrentException?.ToString()</BitText>
        }
        <div class="buttons">
            <BitButton OnClick="Refresh" Variant="BitVariant.Fill">Refresh</BitButton>
            <BitButton OnClick="GoHome" Variant="BitVariant.Outline">Home</BitButton>
        </div>
    </div>
}
else
{
    @ErrorContent(CurrentException)
}