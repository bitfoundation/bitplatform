@inherits ErrorBoundaryBase

@if (CurrentException is null)
{
    @ChildContent
}
else if (ErrorContent is null)
{
    <div class="main">
        <div class="header">
            <BitButton OnClick="Recover" IconName="Cancel" Variant="BitVariant.Text" />
        </div>
        <div>
            <img src="/images/error-triangle.svg" alt="" />
        </div>
        <h1 class="title">Oops, something went wrong...</h1>
        @if (showException)
        {
            <div class="exception">@CurrentException?.ToString()</div>
        }
        <div class="buttons">
            <BitButton OnClick="Refresh" Variant="BitVariant.Fill">Refresh</BitButton>
            <BitButton OnClick="GoHome" Variant="BitVariant.Outline">Home</BitButton>
        </div>
    </div>
}
else
{
    @ErrorContent(CurrentException)
}