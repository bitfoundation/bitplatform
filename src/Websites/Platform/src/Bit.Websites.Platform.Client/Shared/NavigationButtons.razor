@inherits AppComponentBase

<div class="container">
    <div class="button">
        @if (string.IsNullOrWhiteSpace(Prev) is false)
        {
            <BitLink Class="link" Href="@PrevUrl" NoColor NoUnderline>
                <BitIcon IconName="ChevronRight" Style="transform:rotate(180deg)" />
                <BitText Typography="BitTypography.Inherit" Element="span" Class="left">@Prev</BitText>
            </BitLink>
        }
    </div>
    <div class="button">
        @if (string.IsNullOrWhiteSpace(Next) is false)
        {
            <BitLink Class="link" Href="@NextUrl" NoColor NoUnderline>
                <BitText Typography="BitTypography.Inherit" Element="span" Class="right">@Next</BitText>
                <BitIcon IconName="ChevronRight" />
            </BitLink>
        }
    </div>
</div>