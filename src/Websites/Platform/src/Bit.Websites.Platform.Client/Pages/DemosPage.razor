@page "/demo"
@page "/demos"
@inherits AppComponentBase

<PageOutlet Url="demos"
            Title="Demos"
            Description="Real, open source apps built with the bit platform libraries, running on web, Android, iOS, Windows and macOS, with the source code included.">
    @* rel=prerender is obsolete: browsers treat it as a no-state prefetch that downloads the demo site
       up front. A preconnect only warms the connection, so a click still opens fast without the
       bandwidth and memory cost on every visit. *@
    <link rel="preconnect" href="https://blazorui.bitplatform.dev" />
</PageOutlet>

<div class="page-container">
    <section class="page-section">
        <div class="page-section-content">
            <BitText Typography="BitTypography.H1" Align="BitTextAlign.Center" Gutter>Products Demo</BitText>
            <BitText Typography="BitTypography.H4" Align="BitTextAlign.Center">
                See the libraries at work in real apps
            </BitText>
            <BitText Typography="BitTypography.Subtitle1" Align="BitTextAlign.Center">
                Every demo is open source, and every library has a live demo site of its own.
            </BitText>
        </div>
    </section>

    <section class="page-section mid-section page-section-content">
        <BitStack Alignment="BitAlignment.Center">
            <BitStack Horizontal Wrap Alignment="BitAlignment.Center" Style="max-width:1000px">
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground"><b>Open source</b> ❤️</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground">Cross platform</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground">Accessible</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground">Dark/Light theme</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground">RTL</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground">PWA</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground">Offline support</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground">Prerendering</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground">MCP servers</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground" SecondaryIconName="ChevronRight" Href="https://blazorui.bitplatform.dev/components/chart#line-filled" Target="_blank">Chart</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground" SecondaryIconName="ChevronRight" Href="https://blazorui.bitplatform.dev/components/fullcalendar#example1" Target="_blank">Scheduler</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground" SecondaryIconName="ChevronRight" Href="https://bbscanner.bitplatform.dev/scan" Target="_blank">Barcode scanner</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground" SecondaryIconName="ChevronRight" Href="https://bcrdt.bitplatform.dev/live" Target="_blank">Realtime collaboration</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground" SecondaryIconName="ChevronRight" Href="https://bink.bitplatform.dev/signature" Target="_blank">Signature pad</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground" SecondaryIconName="ChevronRight" Href="https://bmage.bitplatform.dev/editor" Target="_blank">Image editor</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground" SecondaryIconName="ChevronRight" Href="https://blazorui.bitplatform.dev/components/datagrid#example8" Target="_blank">Data grid</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground" SecondaryIconName="ChevronRight" Href="https://blazorui.bitplatform.dev/components/map#example1" Target="_blank">Map</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground" SecondaryIconName="ChevronRight" Href="https://blazorui.bitplatform.dev/components/pdfviewer#example1" Target="_blank">PDF viewer</BitTag>
                <BitTag Size="BitSize.Large" Color="BitColor.SecondaryForeground"><b>Free</b></BitTag>
            </BitStack>
        </BitStack>
    </section>

    <section class="page-section">
        <div class="page-content page-section-content">
            <BitText Typography="BitTypography.H6" Element="p" Align="BitTextAlign.Center">
                From active shovels in Canadian mines to logistics drivers in Sweden, over 450K students in India,
                platform to maintain 3D information of 4M house units, these are just a few of the groundbreaking software
                projects built on the bitplatform!
            </BitText>
        </div>
    </section>

    <div class="page-content">
        <BitText Typography="BitTypography.H6" Element="p" Align="BitTextAlign.Center" Color="BitColor.SecondaryForeground">
            Looking for the apps made from the bit Boilerplate template? They live with
            <BitLink Href="@Urls.BitFabric" Target="_blank">bit Fabric</BitLink> now.
        </BitText>

        <br /><br />

        <BitText id="platform" Style="scroll-margin-top:100px" Typography="BitTypography.H3" Element="h2">
            Platform website
        </BitText>
        <div class="section-title-line platform"></div>
        <br />
        <BitText Style="max-width:920px" Typography="BitTypography.H6" Element="p">
            Experience the blazing speed of bitplatform.dev.
            <br />
            This site was built using our own product, showcasing the exceptional performance you can achieve for your projects.
        </BitText>
        <br />
        <div class="page-flex-container">
            <div class="page-content-container">
                <BitImage Loading="BitImageLoading.Lazy" Class="template-img dark-image" Src="/images/demos/platform-dark.webp" Alt="bitplatform website" />
                <BitImage Loading="BitImageLoading.Lazy" Class="template-img light-image" Src="/images/demos/platform-light.webp" Alt="bitplatform website" />
            </div>

            <div class="page-content-container">
                <BitLink Class="primary-btn" Href="@Urls.PlatformPwa" Target="_blank" Title="PWA" NoColor NoUnderline>PWA</BitLink>
                <BitLink Class="secondary-btn" Href="@Urls.PlatformPageSpeed" Target="_blank" Title="Test it yourself on PageSpeed Insights" NoColor NoUnderline>Test it yourself on PageSpeed</BitLink>
            </div>
        </div>

        <BitText id="blazorui" Style="scroll-margin-top:100px" Typography="BitTypography.H3" Element="h2">
            BlazorUI
        </BitText>
        <div class="section-title-line blazorui"></div>
        <br />
        <BitText Style="max-width:920px" Typography="BitTypography.H6" Element="p">
            A lightweight yet powerful library of 100+ ready-made components.
            <br />
            It's ideal for building consumer-facing apps and websites that are fast, responsive, and optimized for both desktop and mobile.
        </BitText>
        <br />
        <div class="page-flex-container">
            <div class="page-content-container">
                <BitImage Loading="BitImageLoading.Lazy" Class="template-img dark-image" Src="/images/demos/blazorui-dark.webp" Alt="BlazorUI sample" />
                <BitImage Loading="BitImageLoading.Lazy" Class="template-img light-image" Src="/images/demos/blazorui-light.webp" Alt="BlazorUI sample" />
            </div>

            <div class="page-content-container">
                <BitLink Class="primary-btn" Href="@Urls.BlazorUiPwa" Target="_blank" Title="PWA" NoColor NoUnderline>PWA</BitLink>
                <BitLink Class="secondary-btn" Href="@Urls.BlazorUiGooglePlay" Target="_blank" Title="Google Play" NoColor NoUnderline><span class="btn-img google-play"></span>Android</BitLink>
                <BitLink Class="secondary-btn" Href="@Urls.BlazorUiAppleStore" Target="_blank" Title="Apple Store" NoColor NoUnderline><span class="btn-img apple-store"></span>iOS - macOS</BitLink>
                <BitLink Class="secondary-btn" Href="@Urls.BlazorUiWindows" Target="_blank" Title="Windows" NoColor NoUnderline><span class="btn-img windows"></span>Windows</BitLink>
                <BitLink Class="secondary-btn" Href="@Urls.BlazorUiPlayground" Target="_blank" Title="GitHub codespace" NoColor NoUnderline><span class="btn-img github"></span>Playground</BitLink>
                <BitLink Class="secondary-btn" Href="@Urls.BlazorUiBenchmarks" Target="_blank" Title="Benchmark repo" NoColor NoUnderline><span class="btn-img github"></span>Benchmarks</BitLink>
            </div>
        </div>
    </div>

    <section class="page-section mid-section">
        <div class="products-container">
            <BitText Typography="BitTypography.Inherit" Element="span">All hosted on a single cheap server:</BitText>
            <BitText Typography="BitTypography.Inherit" Element="span"><b class="highlight-1">1 core CPU</b> and <b class="highlight-1">1.5 GB RAM</b></BitText>
        </div>
    </section>

    <div class="page-content" id="built-with-bitplatform">

        <BitText Typography="BitTypography.H2" Align="BitTextAlign.Center" Style="margin-top:10rem">
            Built with bitplatform
        </BitText>

        <br />

        <CustomerCarousel />
    </div>
    <br />
    <br />
    <br />
    <br />
</div>
