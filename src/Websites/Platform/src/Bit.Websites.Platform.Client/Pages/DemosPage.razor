                <BitLink Class="secondary-btn" Href="@Urls.AdminPanelAppleStore" Target="_blank" Title="Apple Store" NoColor NoUnderline><span class="btn-img apple-store"></span>iOS - macOS</BitLink>
                <BitLink Class="secondary-btn" Href="@Urls.AdminPanelWindows" Target="_blank" Title="Windows" NoColor NoUnderline><span class="btn-img windows"></span>Windows</BitLink>
                <BitLink Class="secondary-btn" Href="@Urls.AdminPanelPlayground" Target="_blank" Title="GitHub codespace" NoColor NoUnderline><span class="btn-img github"></span>Playground</BitLink>
            </div>
        </div>

