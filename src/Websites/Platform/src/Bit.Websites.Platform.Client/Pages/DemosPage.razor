        <BitText>
            Need a robust back-office or admin panel?
            <br />
            bit Boilerplate's AdminPanel module has you covered with built-in features, ready to go from day one.
        </BitText>
        <br />
        <div class="page-flex-container">
            <div class="page-content-container">
                <BitImage Loading="BitImageLoading.Lazy" Class="template-img dark-image" Src="/images/demos/admin-dark.webp" Alt="AdminPanel sample" />
                <BitImage Loading="BitImageLoading.Lazy" Class="template-img light-image" Src="/images/demos/admin-light.webp" Alt="AdminPanel sample" />
            </div>

            <div class="page-content-container">
                <BitLink Class="primary-btn" Href="@Urls.AdminPanelPwa" Target="_blank" Title="PWA" NoColor NoUnderline>PWA</BitLink>
