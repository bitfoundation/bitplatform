@page "/about-us"
@inherits AppComponentBase

<PageOutlet Url="about-us"
            Title="About us"
            Description="Meet the team behind bit platform and learn about our mission: help founders and product teams launch real apps on every platform, on a codebase they fully own and can take anywhere." />

<div class="page-container">
    <section class="page-section vision-section">
        <div class="page-section-content">
            <BitText Typography="BitTypography.H1" Gutter Class="page-title">About us</BitText>
            <BitText Typography="BitTypography.H4" Gutter Class="vision-title">
                Our vision is to empower our customers to maximize their performance through high quality development services and products.
            </BitText>
        </div>
    </section>

    <section class="page-section values-section">
        <div class="page-section-content">
            <BitText Typography="BitTypography.H3" Gutter>Our values</BitText>
            <div class="value-card-list">
                <div class="value-card">
                    <BitText Typography="BitTypography.H5" Gutter>Quality</BitText>
                    <BitText Typography="BitTypography.Body1">
                        We expertly execute our work, utilizing innovation and ingenuity to provide high-quality services and products.
                    </BitText>
                </div>

                <div class="value-card">
                    <BitText Typography="BitTypography.H5" Gutter>Integrity</BitText>
                    <BitText Typography="BitTypography.Body1">
                        Conduct our business in a legal and ethical manner, build lasting relationships through honesty, respect and trust with our employees as well as our business partners.
                    </BitText>
                </div>

                <div class="value-card">
                    <BitText Typography="BitTypography.H5" Gutter>Transparency</BitText>
                    <BitText Typography="BitTypography.Body1">
                        Being honest and open when communicating with our employees and business partners.
                    </BitText>
                </div>
            </div>
        </div>
    </section>

    <section class="page-section download-section">
        <div class="page-section-content">
            <BitText Typography="BitTypography.H3" Gutter>10M</BitText>
            <BitSeparator Style="width:100%" />
            <BitLink Href="https://www.nuget.org/profiles/bit-foundation" Target="_blank" NoUnderline>
                <BitText Typography="BitTypography.H5" Class="blue-txt">
                    Total downloads of packages
                </BitText>
            </BitLink>
        </div>
    </section>

    <section class="page-section team-section">
        <div class="page-section-content">
            <BitText Typography="BitTypography.H3" Gutter>Our team</BitText>

            <div class="member-card-list">

                <div class="member-card">
                    <BitImage Class="member-img" Src="/images/about-us/team/yaser-moradi.webp" Alt="Yaser Moradi" ImageFit="BitImageFit.Cover" ImageAttributes="@(new() { ["width"] = "70", ["height"] = "70" })" />
                    <div class="member-container">
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-name">Yaser Moradi</BitText>
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-position" Color="BitColor.SecondaryForeground">Co-Founder</BitText>
                        <div class="contact-grp">
                            <BitLink Class="contact-lnk github" Href="https://github.com/ysmoradi" Target="_blank" AriaLabel="Yaser Moradi on GitHub" NoColor NoUnderline />
                            <BitLink Class="contact-lnk twitter" Href="https://twitter.com/ysmoradi" Target="_blank" AriaLabel="Yaser Moradi on X (Twitter)" NoColor NoUnderline />
                        </div>
                    </div>
                </div>

                <div class="member-card">
                    <BitImage Class="member-img" Src="/images/about-us/team/saleh-yousefnejad.webp" Alt="Saleh Yusefnejad" ImageFit="BitImageFit.Cover" ImageAttributes="@(new() { ["width"] = "70", ["height"] = "70" })" />
                    <div class="member-container">
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-name">Saleh Yusefnejad</BitText>
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-position" Color="BitColor.SecondaryForeground">Co-Founder</BitText>
                        <div class="contact-grp">
                            <BitLink Class="contact-lnk github" Href="https://github.com/msynk" Target="_blank" AriaLabel="Saleh Yusefnejad on GitHub" NoColor NoUnderline />
                            <BitLink Class="contact-lnk twitter" Href="https://twitter.com/SalehYusefnejad" Target="_blank" AriaLabel="Saleh Yusefnejad on X (Twitter)" NoColor NoUnderline />
                        </div>
                    </div>
                </div>

            </div>

            <div class="member-card-list">

                <div class="member-card">
                    <BitImage Class="member-img" Src="/images/about-us/team/mohammad-aminsafaei.webp" Alt="Mohammad Aminsafaei" ImageFit="BitImageFit.Cover" ImageAttributes="@(new() { ["width"] = "70", ["height"] = "70" })" />
                    <div class="member-container">
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-name">Mohammad Aminsafaei</BitText>
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-position" Color="BitColor.SecondaryForeground">Developer</BitText>
                        <div class="contact-grp">
                            <BitLink Class="contact-lnk github" Href="https://github.com/Cyrus-Sushiant" Target="_blank" AriaLabel="Mohammad Aminsafaei on GitHub" NoColor NoUnderline />
                        </div>
                    </div>
                </div>

                <div class="member-card">
                    <BitImage Class="member-img" Src="/images/about-us/team/mh-rastegari.webp" Alt="M. H. Rastegarinia" ImageFit="BitImageFit.Cover" ImageAttributes="@(new() { ["width"] = "70", ["height"] = "70" })" />
                    <div class="member-container">
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-name">M. H. Rastegarinia</BitText>
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-position" Color="BitColor.SecondaryForeground">Developer</BitText>
                        <div class="contact-grp">
                            <BitLink Class="contact-lnk github" Href="https://github.com/mhrastegari" Target="_blank" AriaLabel="M. H. Rastegarinia on GitHub" NoColor NoUnderline />
                            <BitLink Class="contact-lnk twitter" Href="https://twitter.com/mhrastegari77" Target="_blank" AriaLabel="M. H. Rastegarinia on X (Twitter)" NoColor NoUnderline />
                        </div>
                    </div>
                </div>

            </div>

            <div class="member-card-list">

                <div class="member-card">
                    <BitImage Class="member-img" Src="/images/about-us/team/zahra-sangtarash.webp" Alt="Zahra Sangtarash" ImageFit="BitImageFit.Cover" ImageAttributes="@(new() { ["width"] = "70", ["height"] = "70" })" />
                    <div class="member-container">
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-name">Zahra Sangtarash</BitText>
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-position" Color="BitColor.SecondaryForeground">UI/UX designer</BitText>
                        <div class="contact-grp">
                            <BitLink Class="contact-lnk github" Href="https://github.com/ZahraSng" Target="_blank" AriaLabel="Zahra Sangtarash on GitHub" NoColor NoUnderline />
                        </div>
                    </div>
                </div>

                <div class="member-card">
                    <BitImage Class="member-img" Src="/images/about-us/team/zahra-yousefi.webp" Alt="Zahra Yousefi" ImageFit="BitImageFit.Cover" ImageAttributes="@(new() { ["width"] = "70", ["height"] = "70" })" />
                    <div class="member-container">
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-name">Zahra Yousefi</BitText>
                        <BitText Typography="BitTypography.Inherit" Element="div" Class="member-position" Color="BitColor.SecondaryForeground">UI/UX designer</BitText>
                        <div class="contact-grp">
                            <BitLink Class="contact-lnk github" Href="https://github.com/zahra-yousefi" Target="_blank" AriaLabel="Zahra Yousefi on GitHub" NoColor NoUnderline />
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>
</div>
