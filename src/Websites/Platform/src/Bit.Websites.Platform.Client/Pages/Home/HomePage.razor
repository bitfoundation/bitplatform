@page "/"
@inherits AppComponentBase

<PageOutlet Url=""
            Title="The AI-ready UI toolkit for Blazor"
            Description="Blazor components and libraries written for AI agents, each newer library with an MCP server of its own: accessibility, offline sync, live collaboration, an image editor and more. Free, open source and MIT licensed.">
</PageOutlet>

@* The hero glow and dot grid are painted by CSS (see .page-container::before / .hero-section::before),
   which replaced two large blurred SVG images: no extra requests and a far cheaper first paint. *@
<div class="page-container">

    <section class="page-section hero-section">
        <div class="page-section-content">
            <div class="hero-section-content @(animateHeroIntro ? "animate-intro" : null)">
                <BitLink Class="hero-eyebrow" Href="@($"{Urls.GithubRepo}/releases")" Target="_blank" NoColor NoUnderline>
                    <span class="hero-eyebrow-tag">v@(releaseMajor)</span>
                    <span>@(isPreviewRelease ? "Now in preview" : "Now available") on .NET @releaseMajor</span>
                    <svg class="hero-eyebrow-arrow" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </BitLink>
                <BitText Typography="BitTypography.H1" Gutter Class="hero-title">
                    bit platform
                </BitText>
                <BitText Typography="BitTypography.H4" Gutter Class="hero-subtitle">
                    The AI-ready UI toolkit
                    <br />
                    for Blazor
                </BitText>
                <div class="hero-cta-container">
                    <BitLink Class="hero-cta primary" Href="@($"#{LIBRARIES_SECTION_ID}")" NoColor NoUnderline>Explore the libraries</BitLink>
                    <BitLink Class="hero-cta secondary" Href="@BLAZORUI_GETTING_STARTED_URL" Target="_blank" NoColor NoUnderline>Get started</BitLink>
                </div>
            </div>
        </div>
    </section>

    <section class="page-section text-section">
        <div class="page-section-content">
            <div class="section-title-container">
                <div class="section-title-line reversed"></div>
                <BitText Typography="BitTypography.H6" Gutter Class="section-title">
                    What is <span style="text-transform:lowercase">bit platform?</span>
                </BitText>
                <div class="section-title-line"></div>
            </div>
            <br />
            <BitText Typography="BitTypography.H2" Class="text-title">
                written for you
                <br />
                and for <span class="highlight-1">your AI agent</span>
            </BitText>
            <br />
            <BitText Typography="BitTypography.H5" Class="text-subtitle">
                Blazor components, browser APIs and focused libraries for web, Android, iOS, Windows and macOS.
                <br />
                Your coding agent finds the right API, reads how it works and uses it as intended.
            </BitText>
        </div>
    </section>

    <BitImage Src="/images/home/hero-image.webp"
              Class="hero-image"
              Alt="bit platform apps running on web, mobile, and desktop"
              Loading="BitImageLoading.Lazy"
              Decoding="BitImageDecoding.Async"
              ImageAttributes="@(new() { ["width"] = "877", ["height"] = "668" })" />

    <section class="page-section stats-section" aria-label="bit platform statistics">
        <div class="page-section-content">
            <div class="stats-list">
                <div class="stats-item">
                    <BitText Typography="BitTypography.Inherit" Element="span" Class="stats-number">10M+</BitText>
                    <BitText Typography="BitTypography.Inherit" Element="span" Class="stats-label" Color="BitColor.SecondaryForeground">NuGet downloads</BitText>
                </div>
                <div class="stats-item">
                    <BitText Typography="BitTypography.Inherit" Element="span" Class="stats-number">1.4K+</BitText>
                    <BitText Typography="BitTypography.Inherit" Element="span" Class="stats-label" Color="BitColor.SecondaryForeground">GitHub stars</BitText>
                </div>
                <div class="stats-item">
                    <BitText Typography="BitTypography.Inherit" Element="span" Class="stats-number">150+</BitText>
                    <BitText Typography="BitTypography.Inherit" Element="span" Class="stats-label" Color="BitColor.SecondaryForeground">Contributors</BitText>
                </div>
                <div class="stats-item">
                    <BitText Typography="BitTypography.Inherit" Element="span" Class="stats-number">100+</BitText>
                    <BitText Typography="BitTypography.Inherit" Element="span" Class="stats-label" Color="BitColor.SecondaryForeground">UI components</BitText>
                </div>
            </div>
        </div>
    </section>

    <section class="page-section ai-section">
        <div class="page-section-content">
            <div class="section-title-container">
                <div class="section-title-line reversed"></div>
                <BitText Typography="BitTypography.H6" Gutter Class="section-title">AI-ready</BitText>
                <div class="section-title-line"></div>
            </div>
            <br />
            <BitText Typography="BitTypography.H2" Class="text-title">
                ask for the API,
                <br />
                not the <span class="highlight-2">source code</span>
            </BitText>
            <div class="ai-grid">
                <div class="ai-points">
                    <div class="ai-point">
                        <span class="ai-point-icon" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="6" rx="2" />
                                <rect x="3" y="14" width="18" height="6" rx="2" />
                                <path d="M7 7h.01M7 17h.01" />
                            </svg>
                        </span>
                        <div>
                            <BitText Typography="BitTypography.Inherit" Element="h3" Class="ai-point-title">An MCP server for every newer library</BitText>
                            <BitText Typography="BitTypography.Inherit" Element="p" Class="ai-point-text">
                                A search tool that finds the right feature from a plain description of what it must do, the setup guide,
                                the full API reference and working examples - straight from the library itself.
                            </BitText>
                        </div>
                    </div>
                    <div class="ai-point">
                        <span class="ai-point-icon" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9" />
                                <circle cx="12" cy="12" r="5" />
                                <circle cx="12" cy="12" r="1" />
                            </svg>
                        </span>
                        <div>
                            <BitText Typography="BitTypography.Inherit" Element="h3" Class="ai-point-title">Fewer tokens, fewer guesses</BitText>
                            <BitText Typography="BitTypography.Inherit" Element="p" Class="ai-point-text">
                                Your agent asks for the one API it needs instead of reading the source and guessing.
                                Less context to pay for, and code that follows the library as it is.
                            </BitText>
                        </div>
                    </div>
                    <div class="ai-point">
                        <span class="ai-point-icon" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="4.5" r="1.5" />
                                <path d="M5 8.5l7 1.5 7-1.5M12 10v4m0 0l-3 6m3-6l3 6" />
                            </svg>
                        </span>
                        <div>
                            <BitText Typography="BitTypography.Inherit" Element="h3" Class="ai-point-title">Accessible from the start</BitText>
                            <BitText Typography="BitTypography.Inherit" Element="p" Class="ai-point-text">
                                Keyboard interaction, focus management and ARIA come built in: in the
                                <BitLink Href="@Urls.BlazorUI" Target="_blank">BlazorUI</BitLink> components, and in the unstyled
                                <BitLink Href="@Urls.Bheadless" Target="_blank">Bheadless</BitLink> primitives for your own design system.
                            </BitText>
                        </div>
                    </div>
                </div>
                <div class="ai-code">
                    <BitText Typography="BitTypography.Inherit" Element="h3" Class="ai-code-title">Point your coding agent at a library</BitText>
                    <CodeBox>{
  "servers": {
    "bmage": {
      "type": "http",
      "url": "https://bmage.bitplatform.dev/mcp"
    },
    "bcrdt": {
      "type": "http",
      "url": "https://bcrdt.bitplatform.dev/mcp"
    }
  }
}</CodeBox>
                    <BitText Typography="BitTypography.Inherit" Element="p" Class="ai-code-note">
                        Each library's server lives on its own site, at <code>https://&lt;library&gt;.bitplatform.dev/mcp</code>:
                        plain HTTP, no sign-in. Projects made with <BitLink Href="@Urls.BitFabric" Target="_blank">bit Fabric</BitLink>
                        connect to <code>https://api.bitfabric.co/docs-mcp</code>.
                    </BitText>
                </div>
            </div>
        </div>
    </section>

    <section class="page-section capabilities-section" id="@LIBRARIES_SECTION_ID" @ref="librariesRef">
        <div class="page-section-content">
            <div class="section-title-container">
                <div class="section-title-line reversed"></div>
                <BitText Typography="BitTypography.H6" Gutter Class="section-title">What you can build</BitText>
                <div class="section-title-line"></div>
            </div>
            <br />
            <BitText Typography="BitTypography.H2" Class="text-title">
                the hard parts,
                <br />
                <span class="highlight-1">already built</span>
            </BitText>
            <div class="capability-grid">
                @foreach (var capability in capabilities)
                {
                    <div class="capability-card @(capability.Featured ? "featured" : null)">
                        <BitText Typography="BitTypography.Inherit" Element="h3" Class="capability-title">@capability.Title</BitText>
                        <BitText Typography="BitTypography.Inherit" Element="p" Class="capability-text" Color="BitColor.SecondaryForeground">@capability.Description</BitText>
                        <div class="capability-libraries">
                            @foreach (var library in capability.Libraries)
                            {
                                <BitLink Class="capability-library" Href="@library.Url" Target="_blank" Title="@($"bit {library.Title}: {library.Description}")" NoColor NoUnderline>
                                    @library.Title
                                    <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </BitLink>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="page-section products-section" id="@OUR_PRODUCTS_SECTION_ID" @ref="ourProductsRef">
        <div class="page-section-content">
            <div class="section-title-container">
                <div class="section-title-line reversed"></div>
                <BitText Typography="BitTypography.H6" Gutter Class="section-title">Our products</BitText>
                <div class="section-title-line"></div>
            </div>
            <br />
            <BitText Typography="BitTypography.H2" Class="text-title">
                the <span class="highlight-2">foundation</span> of
                <br />
                every bit app
            </BitText>
            <br />
            <Products Group="ProductGroup.Core" />
            <div class="products-more">
                <BitLink Class="products-more-btn secondary" Href="@Urls.Products" NoColor NoUnderline>
                    See all products
                    <svg class="products-more-arrow" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </BitLink>
            </div>
        </div>
    </section>

    <section class="page-section fabric-section">
        <div class="page-section-content">
            <div class="fabric-card">
                <div class="fabric-text">
                    <BitText Typography="BitTypography.Inherit" Element="span" Class="fabric-eyebrow">bit Fabric</BitText>
                    <BitText Typography="BitTypography.H3" Element="h2" Class="fabric-title">Building a whole app?</BitText>
                    <BitText Typography="BitTypography.Inherit" Element="p" Class="fabric-subtitle">
                        bit Fabric builds full apps on these libraries with AI, for web, Android, iOS, Windows and macOS from one project.
                        The bit Boilerplate project template and bit CLI are part of it.
                    </BitText>
                </div>
                <div class="fabric-buttons">
                    <BitLink Class="fabric-btn primary" Href="@Urls.BitFabric" Target="_blank" NoColor NoUnderline>Visit bitfabric.co</BitLink>
                    <BitLink Class="fabric-btn secondary" Href="@Urls.BitFabricCli" Target="_blank" NoColor NoUnderline>bit CLI</BitLink>
                </div>
            </div>
        </div>
    </section>

    <section class="page-section tech-section">
        <div class="page-section-content">
            <div class="section-title-container">
                <div class="section-title-line reversed"></div>
                <BitText Typography="BitTypography.H6" Gutter Class="section-title">Tech we use</BitText>
                <div class="section-title-line"></div>
            </div>
            <br /><br /><br />
            <div class="tech-list">
                <BitLink Target="_blank" Title="C#" AriaLabel="C#" Class="tech-item csharp-item" Href="https://dotnet.microsoft.com/en-us/languages/csharp" NoColor NoUnderline />
                <BitLink Target="_blank" Title="Blazor" AriaLabel="Blazor" Class="tech-item blazor-item" Href="https://dotnet.microsoft.com/en-us/apps/aspnet/web-apps/blazor" NoColor NoUnderline />
                <BitLink Target="_blank" Title="Visual Studio" AriaLabel="Visual Studio" Class="tech-item vs-item" Href="https://visualstudio.microsoft.com/" NoColor NoUnderline />
                <BitLink Target="_blank" Title="git" AriaLabel="git" Class="tech-item git-item" Href="https://git-scm.com/" NoColor NoUnderline />
                <BitLink Target="_blank" Title="GitHub" AriaLabel="GitHub" Class="tech-item github-item" Href="https://github.com" NoColor NoUnderline>
                    <svg height="70" width="70" viewBox="0 0 16 16">
                        <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
                    </svg>
                </BitLink>
                <BitLink Target="_blank" Title="Sass" AriaLabel="Sass" Class="tech-item sass-item" Href="https://sass-lang.com/" NoColor NoUnderline />
            </div>
            <br /><br />
            <BitText Typography="BitTypography.H4" Class="tech-subtitle">
                We've developed all of our websites
                <br />
                with our own toolchain!
            </BitText>
        </div>
    </section>

    <section class="page-section customer-section">
        <div class="page-section-content">
            <div class="section-title-container">
                <div class="section-title-line reversed"></div>
                <BitText Typography="BitTypography.H6" Gutter Class="section-title">Built with bitplatform</BitText>
                <div class="section-title-line"></div>
            </div>
            <br />
            <BitText Typography="BitTypography.H2" Class="text-title">
                see what <span class="highlight-2">teams</span>
                <br />
                are shipping
            </BitText>
            <br /><br />
            <CustomerCarousel />
        </div>
    </section>

    <section class="page-section cta-section">
        <div class="page-section-content cta-card">
            <BitText Typography="BitTypography.H2" Class="text-title">
                start building <span class="highlight-1">today</span>
            </BitText>
            <br />
            <BitText Typography="BitTypography.H5" Element="p" Class="text-subtitle">
                Free and open source. MIT licensed. No sign-up required.
            </BitText>
            <br />
            <div class="cta-command">
                <CodeBox>dotnet add package Bit.BlazorUI</CodeBox>
            </div>
            <div class="cta-buttons">
                <BitLink Class="cta-btn primary" Href="@BLAZORUI_GETTING_STARTED_URL" Target="_blank" NoColor NoUnderline>Get started</BitLink>
                <BitLink Class="cta-btn secondary" Href="@Urls.GithubRepo" Target="_blank" NoColor NoUnderline>Star on GitHub</BitLink>
            </div>
        </div>
    </section>
</div>
