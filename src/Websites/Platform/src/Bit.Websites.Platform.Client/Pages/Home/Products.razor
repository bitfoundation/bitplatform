@inherits AppComponentBase
<div>
    @for (var i = 0; i < visibleProducts.Length; i++)
    {
        var product = visibleProducts[i];

        @if (i > 0)
        {
            <br />
        }
        <BitAccordion Class="@($"accordion{(product.IsExpanded ? " expanded" : "")}")" @bind-Expanded="product.IsExpanded">
            <HeaderTemplate Context="isExpanded">
                <div class="header-container">
                    <BitIcon Class="header-icon" IconName="ChevronRight" Style="@(isExpanded ? "transform:rotate(90deg)" : "")" />
                    <div>
                        <BitText Typography="BitTypography.H4" Class="header-title">@product.Title</BitText>
                        <BitText Typography="BitTypography.H5" Class="header-subtitle">@product.Subtitle</BitText>
                    </div>
                </div>
            </HeaderTemplate>
            <ChildContent>
                <div class="content-container">
                    @product.Body
                    <BitLink Class="template-link" Href="@product.Product.Url" Target="@(product.Product.External ? "_blank" : null)" NoColor NoUnderline>
                        Learn more <span class="template-link-arrow"></span>
                    </BitLink>
                </div>
            </ChildContent>
        </BitAccordion>
    }
</div>

@code {
    // A catalog entry with no hand-written accordion yet still gets listed, with its catalog description.
    private ProductAccordionItem CreateFallbackProduct(ProductLink product) => new()
    {
        Title = product.Title,
        Subtitle = $"bit {product.Title} · {product.Description}",
        LinkUrl = product.Url,
        Body = @<text>
            <BitText Typography="BitTypography.Subtitle1" Gutter>@product.Description</BitText>
        </text>
    };

    private ProductAccordionItem[] CreateCoreProducts() =>
    [
        new()
        {
            Title = "100+ components, from inputs to data grids",
            Subtitle = "bit BlazorUI · Blazor components with built-in theming",
            LinkUrl = Urls.BlazorUI,
            IsExpanded = true,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit BlazorUI covers everything from inputs and date pickers to a data grid, charts, maps, a PDF viewer, a rich text editor
                    and an AI chat kit. The components behave the same in WebAssembly, Server, Hybrid and prerendering, and re-skin with
                    Fluent, Material or Cupertino presets or from a single brand color.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;BitDropdown @@bind-Values="tags" Items="tagItems"
             Label="Tags" Placeholder="Pick or type a tag"
             MultiSelect Combo Chips Dynamic Responsive
             DynamicValueGenerator="(BitDropdownItem&lt;string> item) => item.Text ?? string.Empty"
             OnDynamicAdd="(BitDropdownItem&lt;string> item) => AddTag(item)" /></CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "130+ browser APIs, called from C#",
            Subtitle = "bit Butil · browser APIs as typed C# services",
            LinkUrl = Urls.Butil,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Butil turns storage, clipboard, geolocation, camera, Bluetooth, passkeys, crypto, workers and more into injectable,
                    strongly typed services. Calls are safe during prerendering, and a published app ships only the JavaScript it actually uses.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>@@inject Bit.Butil.Geolocation geolocation
@@inject Bit.Butil.Clipboard clipboard

@@code {
    async Task CopyLocation()
    {
        var c = (await geolocation.GetCurrentPosition()).Coords;
        await clipboard.WriteText($"{c.Latitude}, {c.Longitude}");
    }
}</CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Offline-ready, with updates users can see",
            Subtitle = "bit Bswup · service worker with update progress",
            LinkUrl = Urls.Bswup,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bswup caches your Blazor app for offline use and shows real download progress on the first load and on every update.
                    It checks for new versions, keeps every open tab on the same one, and can let users choose when to reload.
                </BitText>
                <br />
                <div style="text-align:center">
                    <BitImage Src="/images/home/bswup.webp"
                              Fluid
                              Style="display:inline-block"
                              Alt="bit Bswup service worker update flow in a Blazor PWA"
                              Loading="BitImageLoading.Lazy" />
                </div>
                <br />
            </text>
        },
        new()
        {
            Title = "Routing with guards and data loaders",
            Subtitle = "bit Brouter · nested, declarative Blazor router",
            LinkUrl = Urls.Brouter,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Brouter adds what the built-in router lacks: async and leave guards, cached data loaders with link preloading,
                    keep-alive pages, view transitions and typed URLs generated at compile time - while your existing @@page components
                    and [Authorize] keep working.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;Brouter NotFoundUrl="404">
    &lt;Broute Path="/" RedirectTo="/home" />
    &lt;Broute Path="/admin" Guard="@@RequireAdmin" Component="@@typeof(AdminPage)" />
    &lt;Broute Name="user" Path="/users/{id:int}" Loader="@@LoadUser"
            StaleTime="@@TimeSpan.FromMinutes(1)" Component="@@typeof(UserPage)" />
&lt;/Brouter></CodeBox>
                </div>
            </text>
        },
    ];

    private ProductAccordionItem[] CreateUtilityProducts() =>
    [
        new()
        {
            Title = "Fluid animation, declared in Razor",
            Subtitle = "bit Bmotion · Motion-style animation for Blazor",
            LinkUrl = Urls.Bmotion,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bmotion brings springs, gestures, drag, exit and layout animations to your markup the way Motion (Framer Motion) does.
                    The math runs in C#, the browser plays it off the main thread, and it works on WebAssembly and Server.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;Bmotion Initial="Bm.To(opacity: 0, y: 20)"
         Animate="Bm.To(opacity: 1, y: 0)"
         WhileHover="Bm.To(scale: 1.05)"
         Transition="Bm.Spring(bounce: 0.4, duration: 0.6)">
    &lt;div class="card">Hello&lt;/div>
&lt;/Bmotion></CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Edit and shrink images before upload",
            Subtitle = "bit Bmage · image editor and processing engine",
            LinkUrl = Urls.Bmage,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bmage crops, resizes, adjusts and annotates images with its own C# codecs, then exports them to a file-size budget
                    with GPS and other metadata removed by default. Use the full editor component, or run the same pipeline headless.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>await processor.ProcessAsync(bytes,
    BmageImagePipeline.Create().AutoOrient().Cover(512, 512),
    new BmageImageExportOptions
    {
        Format = BmageImageFormat.WebP,
        MaxFileSize = 120 * 1024 // metadata is removed by default
    });</CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Your EF Core model, client-side",
            Subtitle = "bit Bsqlite · SQLite and EF Core in the browser",
            LinkUrl = Urls.Bsqlite,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bsqlite runs SQLite and the stock EF Core provider inside the browser - or on a device file in Blazor Hybrid -
                    so your server's entities and migrations work unchanged. Live queries re-run on every write, even one from another tab.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>// A field, disposed in the component's DisposeAsync,
// so the subscription lives as long as the component.
_live = db.Orders
    .Where(o => o.Status == OrderStatus.Open)
    .AsLiveQuery();

_live.Changed += (_, rows) => { _open = rows; _ = InvokeAsync(StateHasChanged); };
_open = await _live.RefreshAsync();</CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "From signature pad to whiteboard",
            Subtitle = "bit Bink · drawing and ink engine",
            LinkUrl = Urls.Bink,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bink turns pressure-sensitive pen, touch and mouse input into an editable vector document - with brushes, shapes,
                    layers, undo and live collaboration - and exports it to SVG, PNG or PDF exactly as drawn.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;BinkCanvas @@ref="canvas" Height="200px" AriaLabel="Signature" />

@@code {
    BinkCanvas? canvas;
    Task&lt;string> SaveAsync() => canvas!.ExportSvgAsync();
}</CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "A Ctrl+K command palette for your app",
            Subtitle = "bit Balette · keyboard-first command palette",
            LinkUrl = Urls.Balette,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Balette gives your app the Ctrl+K / ⌘K box from VS Code, Linear and Raycast: fuzzy, typo-tolerant search over every
                    page, action and API result, with nested pages, global shortcuts and full screen-reader support.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>Palette.Register(
    BaletteCmd.Navigate("Settings", "/settings").Keywords("preferences").Shortcut("G S"),
    BaletteCmd.Action("Toggle sidebar", Toggle).Shortcut("Mod+B"));</CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Scan barcodes without an SDK",
            Subtitle = "bit BbScanner · camera and image barcode scanner",
            LinkUrl = Urls.BbScanner,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit BbScanner reads 19 symbologies - QR, Data Matrix, PDF417, Aztec, EAN/UPC, GS1 DataBar and more - from the camera
                    or still images, with a decoder written from scratch in .NET. It verifies every read before reporting it, and runs on
                    WebAssembly, Server and MAUI.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;BbScanner Formats="BbScannerBarcodeFormat.QrCode | BbScannerBarcodeFormat.Ean13"
           Region="BbScannerScanRegion.CenteredSquare(0.7)"
           OnScan="HandleScan" /></CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Drag and drop for every input",
            Subtitle = "bit Bdnd · typed drag and drop for Blazor",
            LinkUrl = Urls.Bdnd,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bdnd turns drag sources and drop targets into components that pass strongly typed items, matched by type. Mouse,
                    touch, pen and keyboard all work, with screen-reader announcements, sortable lists and trees, custom previews and
                    file drops from the desktop.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;BdndProvider>
    &lt;BdndDraggable TItem="Card" Type="card" Item="card" />
    &lt;BdndDropTarget TItem="Card" Accept="card" OnDrop="HandleDrop" />
&lt;/BdndProvider></CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Instant queries, no SQL or interop",
            Subtitle = "bit BlazeDb · in-memory database for Blazor WebAssembly",
            LinkUrl = Urls.BlazeDb,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit BlazeDb keeps rows in memory as your own typed objects, so a read is an index lookup - no JS interop, no SQL.
                    Commits persist to OPFS in the background, and live queries re-render only when their data changes.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>var open = todos.Lookup(TodoItem.Indexes.Done, false);</CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Build node editors and workflows",
            Subtitle = "bit Blow · node-based editors and flow charts",
            LinkUrl = Urls.Blow,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Blow is a Blazor counterpart to React Flow: pan, zoom, connect, group and auto-lay out nodes, with undo/redo and
                    keyboard support. The graph is plain C# you can validate, export to Mermaid or GraphML, and run on a server.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;BlowCanvas Nodes="nodes" Edges="edges" FitViewOnInit="true">
    &lt;BlowBackground />
    &lt;BlowControls />
&lt;/BlowCanvas></CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Describe a form once, render it anywhere",
            Subtitle = "bit Borm · schema-driven forms for Blazor",
            LinkUrl = Urls.Borm,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Borm builds a working form from a C# type, a fluent builder or a JSON Schema the server sends. It handles validation,
                    conditions, computed values, wizards and repeaters with no JavaScript, and exports back to JSON Schema.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;BormView Definition="BormSchemaGenerator.Generate&lt;Contact>()"
          Model="contact" OnValidSubmit="Save" /></CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Shared editing, online or offline",
            Subtitle = "bit Bcrdt · real-time collaboration for Blazor",
            LinkUrl = Urls.Bcrdt,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bcrdt lets several people edit the same text, list or form at once, and every copy ends up identical - even after
                    days offline. Sync, presence and selective undo are pure .NET, with no Yjs or JavaScript CRDT library underneath.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;BcrdtCollaborationScope DocumentId="notes-42" User="_me" Context="doc">
    &lt;BcrdtPresenceView Presence="doc.Presence" />
    &lt;BcrdtTextArea Text="@@doc.Text("body")" Presence="doc.Presence" />
&lt;/BcrdtCollaborationScope></CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Guide new users step by step",
            Subtitle = "bit Bonboarding · product tours, hints and checklists",
            LinkUrl = Urls.Bonboarding,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bonboarding builds multi-step tours, spotlights, beacons and self-checking checklists in Razor. Steps can wait for
                    elements that aren't rendered yet, advance when the user really clicks, branch, and carry on across pages - with focus
                    trapping and screen-reader announcements built in.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;BonboardingTour Id="welcome" AutoStart="BonboardingAutoStart.Once">
    &lt;BonboardingStep Anchor="new-project" Title="Create a project" />
    &lt;BonboardingStep Anchor="search" Title="Find anything" />
&lt;/BonboardingTour>

&lt;button data-bonboarding-anchor="new-project">New project&lt;/button></CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "State management without the boilerplate",
            Subtitle = "bit Blex · reactive state for Blazor and .NET MAUI",
            LinkUrl = Urls.Blex,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    Mark fields and methods with attributes and the bit Blex source generator writes the store - reactive properties,
                    memoized computed values, actions and async effects. Persistence, undo/redo and Redux DevTools time-travel are built in,
                    with no action, reducer or feature classes.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>[BlexStore(Name = "counter")]
public partial class CounterStore
{
    [BlexState] private int _count;
    [BlexComputed] private bool ComputeIsEven() => Count % 2 == 0;
    [BlexAction] private void OnIncrement() => Count++;
}</CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Browser and .NET telemetry, one SDK",
            Subtitle = "bit Belemetry · OpenTelemetry-compatible telemetry for Blazor",
            LinkUrl = Urls.Belemetry,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Belemetry collects page views, web vitals, JS errors and fetch calls from the browser, plus ILogger, Activity and
                    Meter data from .NET, and exports them over OTLP or to Azure Monitor or Sentry - with no OpenTelemetry packages, and
                    nothing sent until the user consents.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>builder.Services.AddBitBelemetryServices(o =>
{
    o.AddOtlpExporter("http://localhost:4318");
    o.AddSentryExporter(sentryDsn);
});</CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Accessible components, your styles",
            Subtitle = "bit Bheadless · unstyled, accessible UI primitives",
            LinkUrl = Urls.Bheadless,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bheadless gives you menus, comboboxes, dialogs, date pickers, data grids and more, with keyboard interaction, focus,
                    ARIA and positioning handled for you - rendered as plain semantic HTML for your CSS or Tailwind. A bUnit toolkit for
                    testing your own components' accessibility ships alongside.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;BitBhMenu>
    &lt;BitBhMenuButton class="btn">Options&lt;/BitBhMenuButton>
    &lt;BitBhMenuItems class="menu">
        &lt;BitBhMenuItem OnClick="Edit">Edit&lt;/BitBhMenuItem>
        &lt;BitBhMenuItem OnClick="Share">Share&lt;/BitBhMenuItem>
    &lt;/BitBhMenuItems>
&lt;/BitBhMenu></CodeBox>
                </div>
            </text>
        },
    ];
}
