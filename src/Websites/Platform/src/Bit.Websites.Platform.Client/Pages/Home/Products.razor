@inherits AppComponentBase
<div>
    @for (var i = 0; i < products.Length; i++)
    {
        var product = products[i];

        @if (i > 0)
        {
            <br />
        }
        <BitAccordion Class="@($"accordion{(product.IsExpanded ? " expanded" : "")}")" @bind-IsExpanded="product.IsExpanded">
            <HeaderTemplate Context="isExpanded">
                <div class="header-container">
                    <BitIcon Class="header-icon" IconName="ChevronRight" Style="@(isExpanded ? "transform:rotate(90deg)" : "")" />
                    <div>
                        <BitText Typography="BitTypography.H4" Class="header-title">@product.Title</BitText>
                        <BitText Typography="BitTypography.H5" Class="header-subtitle">@product.Subtitle</BitText>
                    </div>
                </div>
            </HeaderTemplate>
            <ChildContent>
                <div class="content-container">
                    @product.Body
                    <a class="template-link" href="@product.LinkUrl" target="@(product.External ? "_blank" : null)" rel="@(product.External ? "noopener" : null)">
                        Learn more <span class="template-link-arrow"></span>
                    </a>
                </div>
            </ChildContent>
        </BitAccordion>
    }
</div>

@code {
    private readonly ProductAccordionItem[] products =
    [
        new()
        {
            Title = "Your app starts finished",
            Subtitle = "bit Boilerplate · feature-rich project template",
            LinkUrl = Urls.Templates,
            IsExpanded = true,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Boilerplate hands you a real app on day one - sign-in, admin panel, payments, SEO, offline and monitoring already working -
                    for PWA/SSR enabled websites and Android, iOS, macOS, Windows apps.
                </BitText>
                <div class="template-terminal">
                    <BitIcon IconName="ChevronRight" /> <span>dotnet</span> <span>new</span> <span>bit-bp</span>
                    <span>--database</span>
                    <span class="animation-container"><span class="animated a-2">sqlite&nbsp;&nbsp;&nbsp;</span> <span class="animated a-2 delayed d-2">sqlserver</span></span>
                    <span>--pipeline</span>
                    <span class="animation-container"><span class="animated a-3">github</span> <span class="animated a-3 delayed d-3">azure</span></span>
                    <span>--module</span>
                    <span class="animation-container"><span class="animated a-4">admin</span> <span class="animated a-4 delayed d-4">sales</span></span>
                    <span>--name</span> <span>MyAwesomeProject</span>
                </div>
            </text>
        },
        new()
        {
            Title = "100+ ready-made UI components",
            Subtitle = "bit BlazorUI · native components with dark/light theming",
            LinkUrl = Urls.BlazorUI,
            External = true,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit BlazorUI components are native, easy-to-customize, and work seamlessly in all interactive Blazor modes (WASM, Server, Hybrid, pre-rendering),
                    saving you time and making development enjoyable.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;BitDropdown @@bind-Values="comboValues"
             Label="Multi select combo box"
             Placeholder="Select options"
             Items="comboBoxItems"
             Combo Chips Dynamic Responsive
             OnDynamicAdd="(BitDropdownItem&lt;string> item) => HandleOnDynamicAdd(item)" /></CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Camera, location, bluetooth, storage",
            Subtitle = "bit Butil · browser APIs in C#, without JavaScript",
            LinkUrl = Urls.Butil,
            External = true,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Butil brings the browser APIs that normally need JavaScript into your app, ready to use in C#.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>@@inject Bit.Butil.Crypto crypto

@@code {
    var encryptedBytes = await crypto.Encrypt(CryptoAlgorithm.AesCbc, key, textAsUtf8Bytes, iv: iv);
}</CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Installs like a real app",
            Subtitle = "bit Bswup · PWA, offline support and background updates",
            LinkUrl = Urls.Bswup,
            External = true,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bswup makes your app installable, usable offline, and updated in the background - with a visible install progress your users can watch.
                </BitText>
                <br />
                <div style="text-align:center">
                    <img src="/images/home/bswup.webp" style="max-width:100%;" alt="bit Bswup service worker update flow in a Blazor PWA" loading="lazy" />
                </div>
                <br />
            </text>
        },
        new()
        {
            Title = "Works with no connection (Offline)",
            Subtitle = "bit Besql · Entity Framework and SQLite inside the browser",
            LinkUrl = Urls.Besql,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Besql facilitates the use of Entity Framework and SQLite in web browsers with Blazor WebAssembly.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>services.AddBesqlDbContextFactory();</CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Clean URLs and deep links",
            Subtitle = "bit Brouter · modern declarative Blazor router",
            LinkUrl = Urls.Brouter,
            External = true,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Brouter is a modern, declarative, nestable router for Blazor with async guards, data loaders,
                    named routes, programmatic navigation, query string binding, and global navigation hooks.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;Brouter NotFoundUrl="404">
    &lt;Broute Path="/" RedirectTo="/home" />
    &lt;Broute Name="home" Path="/home">
        &lt;Content>&lt;HomePage />&lt;/Content>
    &lt;/Broute>
    &lt;Broute Name="user" Path="/users/{id:int}" Component="@@typeof(UserPage)" />
&lt;/Brouter></CodeBox>
                </div>
            </text>
        },
        new()
        {
            Title = "Motion that feels native",
            Subtitle = "bit Bmotion · Blazor-native animation library",
            LinkUrl = Urls.Bmotion,
            External = true,
            Body = @<text>
                <BitText Typography="BitTypography.Subtitle1" Gutter>
                    bit Bmotion is a Blazor-native animation library with springs, gestures, keyframes, variants, drag,
                    layout animations, shared-element transitions and exit animations, no manual JavaScript wiring required.
                </BitText>
                <div>
                    <CodeBox HideCopyButton>&lt;Bmotion Initial="Bm.To(opacity: 0, y: 20)"
         Animate="Bm.To(opacity: 1, y: 0)"></CodeBox>
                </div>
            </text>
        },
    ];
}
