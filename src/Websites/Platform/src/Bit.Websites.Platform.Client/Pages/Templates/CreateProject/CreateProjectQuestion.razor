@inherits AppComponentBase

<section class="question" aria-labelledby="@headingId">
    <div class="question-head">
        @if (HeadingElement is "h3")
        {
            <BitText Typography="BitTypography.Inherit" Element="h3" Class="question-title is-small" Id="@headingId">@Title</BitText>
        }
        else
        {
            <BitText Typography="BitTypography.Inherit" Element="h2" Class="question-title" Id="@headingId">@Title</BitText>
        }
        @if (Topic is not null)
        {
            <BitLink Class="help-link" AriaLabel="@($"Help me choose: {Title}")" OnClick="() => PageState?.OpenHelp(Topic)">Help me choose</BitLink>
        }
    </div>
    @if (Lead is not null)
    {
        <BitText Typography="BitTypography.Inherit" Element="p" Class="question-lead">@Lead</BitText>
    }
    <div class="question-body">
        @ChildContent
    </div>
</section>

@code {
    private static int count;

    private readonly string headingId = $"question-{Interlocked.Increment(ref count)}";

    [CascadingParameter] public CreateProjectState? PageState { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    [Parameter] public string? Lead { get; set; }

    [Parameter] public CreateProjectHelpTopic? Topic { get; set; }

    [Parameter] public string HeadingElement { get; set; } = "h2";

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
