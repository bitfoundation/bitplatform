@page "/templates/create-project"
@page "/boilerplate/create-project"
@using Bit.Websites.Platform.Client.Pages.Templates.CreateProject
@inherits AppComponentBase

<PageOutlet Url="templates/create-project"
            Title="Create project - Templates"
            Description="Create a new project from the bit Boilerplate template: answer a few everyday questions and copy the bit new command that sets everything up." />

@{
    RenderFragment EffectTag(List<EffectPart> effectParts) =>
        @<span class="effect">
            @if (effectParts.Count is 0)
            {
                <span class="effect-part">no change</span>
            }
            else
            {
                foreach (var part in effectParts)
                {
                    <span class="effect-part">@(part.Verb + " ")<code>@part.Flags</code></span>
                }
            }
        </span>;

    RenderFragment RichText(string text) =>
        @<span>
            @foreach (var part in AnswerParts(text))
            {
                if (part.IsCode)
                {
                    <code>@part.Text</code>
                }
                else if (part.Url is not null)
                {
                    var external = part.Url.StartsWith("http", StringComparison.Ordinal);
                    <a href="@part.Url" target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)">@part.Text</a>
                }
                else
                {
                    @part.Text
                }
            }
        </span>;

    RenderFragment Faqs(Faq[] faqs) =>
        @<div class="faqs">
            <span class="faqs-title">Common questions</span>
            <div class="faq-list">
                @foreach (var faq in faqs)
                {
                    var open = openFaq == faq;
                    <div class="faq @(open ? "open" : null)">
                        <button type="button" class="faq-question" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleFaq(faq)">
                            <span class="faq-mark" aria-hidden="true"></span>
                            <span>@faq.Question</span>
                        </button>
                        @if (open)
                        {
                            <p class="faq-answer">@RichText(faq.Answer)</p>
                        }
                    </div>
                }
            </div>
        </div>;

    RenderFragment Choices(Step step) =>
        @<div class="choices">
            @if (step.Warning is not null)
            {
                <BitMessage Color="BitColor.Warning" Multiline Class="question-warning">@step.Warning</BitMessage>
            }

            @foreach (var group in step.Groups)
            {
                <div class="choice-group">
                    @if (group.Prompt is not null)
                    {
                        <h3 class="group-prompt">@group.Prompt</h3>
                    }
                    <div class="answers" role="@(group.Multiple ? "group" : "radiogroup")" aria-label="@(group.Prompt ?? step.Question)">
                        @foreach (var answer in group.Answers)
                        {
                            var chosen = answer.IsChosen();
                            <div class="answer @(chosen ? "chosen" : null)">
                                <button type="button"
                                        class="answer-hit"
                                        role="@(group.Multiple ? "checkbox" : "radio")"
                                        aria-checked="@(chosen ? "true" : "false")"
                                        aria-label="@answer.Text"
                                        aria-describedby="@(answer.Hint is null ? null : answer.HintId)"
                                        @onclick="WrapHandled(() => Choose(group, answer))"></button>
                                <span class="answer-mark @(group.Multiple ? "square" : null)" aria-hidden="true"></span>
                                <span class="answer-body">
                                    <span class="answer-head">
                                        <span class="answer-text">@answer.Text</span>
                                        @if (answer.ShowsRecommended)
                                        {
                                            <span class="answer-badge">Recommended</span>
                                        }
                                    </span>
                                    @if (answer.Hint is not null)
                                    {
                                        <span class="answer-hint" id="@answer.HintId">@RichText(answer.Hint)</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>;

    RenderFragment NameField() =>
        @<BitTextField @bind-Value="setup.Name"
                       Label="Project name"
                       Placeholder="MyFirstProject"
                       ErrorMessage="@NameError"
                       MaxLength="60"
                       Immediate
                       DebounceTime="300"
                       Class="name-field" />;
}

<div class="page-container">
    <BitText Typography="BitTypography.H3" Element="h1" Gutter>Create Project</BitText>
    <BitText Typography="BitTypography.Subtitle1" Class="page-intro">
        Answer a few everyday questions, one at a time. Every answer updates the command right away, so you can copy it whenever you're ready.
    </BitText>

    <BitSticky Top="64px">
        <CreateProjectCommandBar Setup="setup" />
    </BitSticky>
    <CreateProjectCommandHint />

    <section class="interview" aria-label="Questions">
        <div class="interview-top">
            <span class="progress-text">@ProgressText</span>
            @if (IsFinalStep is false)
            {
                <button type="button" class="done-link" @onclick="WrapHandled(ShowCommand)">I'm done, show my command</button>
            }
        </div>
        <BitProgress Percent="ProgressPercent" Thickness="4" Rounded AriaLabel="Progress" AriaValueText="@ProgressText" />

        @if (IsFinalStep)
        {
            <div class="question" @key="stepIndex">
                <h2 class="question-title" tabindex="-1" @ref="questionHeading">Your command is ready</h2>
                <BitText Typography="BitTypography.Body2" Class="question-help">
                    It's at the top of the page, ready to copy. Here's what you told us. Open an answer to change it.
                </BitText>

                <ol class="summary">
                    @for (var i = 0; i < QuestionCount; i++)
                    {
                        var index = i;
                        var step = steps[index];
                        var parts = StepEffect(step);
                        <li class="summary-row @(parts.Count > 0 ? "changed" : null)" @key="step.Key">
                            <BitAccordion IsExpanded="openSummaryRow == index"
                                          IsExpandedChanged="(bool expanded) => ToggleSummaryRow(index, expanded)"
                                          NoBorder
                                          HeadingLevel="3"
                                          Classes="summaryRowClasses">
                                <TitleTemplate>
                                    <span class="summary-number" aria-hidden="true">@(index + 1)</span>
                                    <span class="summary-body">
                                        <span class="summary-label">@step.Label</span>
                                        <span class="summary-answer">@Describe(step)</span>
                                        @if (parts.Count > 0)
                                        {
                                            @EffectTag(parts)
                                        }
                                    </span>
                                </TitleTemplate>
                                <Body>
                                    @if (step.Key is "name")
                                    {
                                        @NameField()
                                    }
                                    else
                                    {
                                        @Choices(step)
                                    }
                                </Body>
                            </BitAccordion>
                        </li>
                    }
                </ol>

                <div class="final-section">
                    <h3 class="final-section-title">Technical extras</h3>
                    <BitText Typography="BitTypography.Body2" Class="question-help">
                        Already set the way most projects want them. Change them only if you know you need to.
                    </BitText>
                    <div class="extras-list">
                        @foreach (var option in technicalExtras)
                        {
                            <ProjectOptionEditor Option="option" Setup="setup" Compact OnChange="() => MarkTouched(option.Key)" />
                        }
                    </div>
                </div>

                @Faqs(finalFaqs)

                <div class="final-section">
                    <h3 class="final-section-title">What happens next</h3>
                    <ol class="next-steps">
                        <li>Paste the command into a terminal. If something needs administrator rights, Windows asks once.</li>
                        <li><code>bit new</code> installs what this machine is missing, creates the project and opens it in the editor you picked.</li>
                        <li>Use any AI assistant you like. The project comes set up for Claude Code, GitHub Copilot, Codex, Gemini CLI and Cursor.</li>
                    </ol>
                </div>
            </div>
        }
        else if (stepIndex is 0)
        {
            <div class="question" @key="stepIndex">
                <h2 class="question-title" tabindex="-1" @ref="questionHeading">@CurrentStep.Question</h2>
                <BitText Typography="BitTypography.Body2" Class="question-help">@CurrentStep.Help</BitText>
                @NameField()
                @Faqs(CurrentStep.Faqs)
            </div>
        }
        else
        {
            var step = CurrentStep;
            <div class="question" @key="stepIndex">
                <h2 class="question-title" tabindex="-1" @ref="questionHeading">@step.Question</h2>
                @if (step.Help is not null)
                {
                    <BitText Typography="BitTypography.Body2" Class="question-help">@step.Help</BitText>
                }
                @Choices(step)

                @if (step.Key is "platforms")
                {
                    <BitText Typography="BitTypography.Body2" Class="question-help">
                        Add one later from the project folder with <code>bit setup --platforms android</code>.
                    </BitText>
                }

                @if (step.Links.Length > 0)
                {
                    <div class="demo-links">
                        @foreach (var link in step.Links)
                        {
                            <a href="@link.Url" target="_blank" rel="noopener">@link.Text</a>
                        }
                    </div>
                }

                @if (step.Faqs.Length > 0)
                {
                    @Faqs(step.Faqs)
                }
            </div>
        }

        <div class="interview-nav">
            <BitButton Variant="BitVariant.Outline"
                       IconName="ChevronLeft"
                       IsEnabled="@(stepIndex > 0)"
                       OnClick="WrapHandled(GoBack)">Back</BitButton>
            <div class="nav-forward">
                @if (CanSkip)
                {
                    <BitButton Variant="BitVariant.Text" Title="Keep the current answer and go on" OnClick="WrapHandled(GoNext)">Skip</BitButton>
                }
                @if (IsFinalStep)
                {
                    <BitButton Variant="BitVariant.Outline" IconName="Refresh" OnClick="WrapHandled(StartOver)">Start over</BitButton>
                }
                else
                {
                    <BitButton IconName="ChevronRight" IconPosition="BitIconPosition.End" OnClick="WrapHandled(GoNext)">@NextText</BitButton>
                }
            </div>
        </div>
    </section>
</div>

<NavigationButtons Prev="Getting started" PrevUrl="/templates/getting-started" Next="Project structure" NextUrl="/templates/project-structure" />
