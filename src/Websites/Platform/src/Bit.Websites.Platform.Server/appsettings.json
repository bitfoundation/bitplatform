{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "ApplicationInsights": {
        "ConnectionString": null
    },
    "AppSettings": {
        "HealthCheckSettings": {
            "EnableHealthChecks": false
        },
        "TelegramBotSettings": {
            "Token": "",
            "ChatIds": [ "" ]
        },
        "ChatOptions": {
            "Temperature": 0,
            "Reasoning": {
                "Effort": "None",
                "Output": "None"
            }
        },
        "OpenAI": {
            "ChatModel": "gpt-4.1-mini",
            "ChatApiKey": null,
            "ChatEndpoint": null
        },
        "Mcp": {
            "RepositoryUrl": "https://github.com/bitfoundation/bitplatform.git",
            "MinimumVersion": "10.6.0",
            "RefreshInterval": "06:00:00",
            // Empty on every host but the one that serves bitplatform.dev/mcp: it holds a clone, a worktree
            // per released version, and the documentation servers and index built out of each of them.
            "SourcesDirectoryPath": "",
            "CodebaseMemory": {
                "DataDirectoryPath": "",
                "ExecutablePath": "",
                "ExecutableArguments": []
            }
        }
    },
    "AllowedHosts": "*"
