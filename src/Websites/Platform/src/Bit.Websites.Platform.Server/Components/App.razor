@{
    // NOTE: The literals below (cookie name, bit-theme* attributes, storage key) mirror the ones the
    // Bit.BlazorUI theme runtime uses.

    // The theme the visitor picked, mirrored into a cookie by the client (bit-theme-persist-cookie
    // below) because localStorage - where the client script keeps the same value - cannot be read
    // from here. Without it every prerendered response painted a hardcoded dark, and anyone on light
    // watched the whole page flip once the client came up.
    var themePreference = HttpContext.Request.Cookies["bit-theme-preference"]?.Trim().ToLowerInvariant();
    // Tampered values are rejected and treated as "nothing stored", so a cookie cannot inject markup.
    if (themePreference is not null && themePreference.All(c => char.IsAsciiLetterLower(c) || char.IsAsciiDigit(c) || c is '-') is false)
    {
        themePreference = null;
    }
    // Null while the visitor follows the OS (nothing stored or explicit "system"), which the server
    // cannot read. The theme-color tag then has to guess, and the inline script under it carries the
    // client's answer back - see there.
    var resolvedTheme = themePreference == "system" ? null : themePreference;
    // bit-theme="<name>" for a concrete choice paints the right theme with no flash; the
    // bit-theme-system marker defers the light/dark resolution to the inline head script below.
    var rootThemeAttributes = resolvedTheme switch
    {
        null => systemThemeAttributes,
        "dark" => darkThemeAttributes,
        "light" => lightThemeAttributes,
        _ => new Dictionary<string, object> { ["bit-theme"] = resolvedTheme }
    };
    // Dark is the guess while the visitor follows the OS; the inline script corrects it before first
    // paint, and app.ts replaces it with the palette's own --bit-clr-bg-pri once the stylesheets are in.
    var isDarkTheme = resolvedTheme is null || resolvedTheme is "dark" || resolvedTheme.EndsWith("-dark", StringComparison.Ordinal);
    var themeColor = isDarkTheme ? DarkThemeColor : LightThemeColor;
}

<!DOCTYPE html>
@* bit-theme-persist / bit-theme-persist-cookie: the client keeps the chosen theme in localStorage AND
   in the cookie read above, which is what lets the server render the right theme in the first place.
   bit-theme-view-transition: theme toggles cross-fade via the View Transitions API (skipped
   automatically on unsupported browsers / prefers-reduced-motion). *@
<html lang="en" @attributes="rootThemeAttributes" bit-theme-persist bit-theme-persist-cookie bit-theme-view-transition>

<head>
    <ResourcePreloader />
    <base href="/" />
    <meta charset="utf-8" />
    <meta name="theme-color" content="@themeColor"><!-- Kept as a single tag: the inline script below corrects it pre-paint and app.ts (syncThemeColor) keeps it equal to the live --bit-clr-bg-pri on later toggles, both via querySelector. -->
    @* Runs while the browser is still parsing <head>, before anything is painted: re-resolves
       bit-theme from the OS preference / localStorage / the preference cookie (the server can only
       see the cookie, which may be stale or absent) and corrects the theme-color guess above.
       app.ts takes over for later toggles; it cannot cover the first paint because app.js loads at
       the end of <body>, long after the address bar has been painted. *@
    @((MarkupString)ThemeInlineScript)
