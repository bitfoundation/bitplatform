@{
    // NOTE: The literals below (cookie name, bit-theme* attributes, storage key) mirror the ones the
    // Bit.BlazorUI theme runtime uses. The library's BitThemeSsr / BitThemeCookie /
    // BitThemeAttributeNames helpers cover all of this; switch to them once a package version newer
    // than 10.6.0-pre-01 is referenced (they are not part of that build).

    // The theme the visitor picked, mirrored into a cookie by the client (bit-theme-persist-cookie
    // below) because localStorage - where the client script keeps the same value - cannot be read
    // from here. Without it every prerendered response painted a hardcoded dark, and anyone on light
    // watched the whole page flip once the client came up.
    var themePreference = HttpContext.Request.Cookies["bit-theme-preference"]?.Trim().ToLowerInvariant();
    // Tampered values are rejected and treated as "nothing stored", so a cookie cannot inject markup.
    if (themePreference is not null && System.Text.RegularExpressions.Regex.IsMatch(themePreference, "^[a-z0-9-]+$") is false)
    {
        themePreference = null;
    }
    // Null while the visitor follows the OS (nothing stored or explicit "system"), which the server
    // cannot read. The theme-color tag then has to guess, and the script under it carries the
    // client's answer back - see there.
    var resolvedTheme = themePreference == "system" ? null : themePreference;
    // bit-theme="<name>" for a concrete choice paints the right theme with no flash; the
    // bit-theme-system marker defers the light/dark resolution to the inline head script below.
    var rootThemeAttributes = resolvedTheme is not null
        ? new Dictionary<string, object> { ["bit-theme"] = resolvedTheme }
        : new Dictionary<string, object> { ["bit-theme-system"] = true };
    const string darkThemeColor = "#060E2D";
    const string lightThemeColor = "#FFFFFF";
    var themeColor = resolvedTheme?.EndsWith("dark", StringComparison.Ordinal) is false ? lightThemeColor : darkThemeColor;

    // First-paint bootstrap, equivalent to BitThemeSsr.InlineHeadScript: re-resolves bit-theme from
    // the OS preference / localStorage / the preference cookie with the same precedence as the
    // theme runtime's init, so the attribute is correct before anything is painted.
    const string themeInlineScript =
        "<script>(function(){var r=document.documentElement,k='bit-current-theme',ck='bit-theme-preference'," +
        "m=window.matchMedia&&matchMedia('(prefers-color-scheme:dark)').matches," +
        "base=r.getAttribute('bit-theme')||'light';" +
        "if(r.hasAttribute('bit-theme-system')){base=m?'dark':'light';}" +
        "var cur=base,got=false;" +
        "try{var s=localStorage.getItem(k);if(s){cur=s;got=true;}}catch(e){}" +
        "if(!got){var cm=('; '+document.cookie).match('; '+ck+'=([^;]*)');if(cm){try{cur=decodeURIComponent(cm[1]);}catch(e){cur=cm[1];}}}" +
        "if(cur==='system'){cur=m?'dark':'light';}" +
        "r.setAttribute('bit-theme',cur);})();</script>";
}

<!DOCTYPE html>
@* bit-theme-persist / bit-theme-persist-cookie: the client keeps the chosen theme in localStorage AND
   in the cookie read above, which is what lets the server render the right theme in the first place.
   bit-theme-view-transition: theme toggles cross-fade via the View Transitions API (skipped
   automatically on unsupported browsers / prefers-reduced-motion). *@
<html lang="en" @attributes="rootThemeAttributes" bit-theme-persist bit-theme-persist-cookie bit-theme-view-transition>

<head>
    @* First thing in the document: re-resolves bit-theme from localStorage / the preference cookie
       before anything is painted. The attributes above are already correct for a visitor whose cookie
       reached us, so this is what covers the rest - following the OS (which the server cannot read),
       and a localStorage value newer than the cookie. *@
    @((MarkupString)themeInlineScript)
    <ResourcePreloader />
    <base href="/" />
    <meta charset="utf-8" />
    <meta name="theme-color" content="@themeColor"><!-- Kept as a single tag: app.ts (BitBlazorUI.Theme.init onChange) updates this content dynamically via querySelector based on the active theme. -->
    @if (resolvedTheme is null)
    {
        @* The tag above had to guess (the dark default), because this visitor follows the OS and only
           the client can resolve that - which the inline script at the top of <head> has already done,
           onto <html>. Read it back and correct the tag here, while the browser is still parsing
           <head>. app.ts does this same job on every later toggle, but it cannot cover the first paint:
           app.js loads at the end of <body>, long after the address bar has been painted. *@
        <Script>
            document.querySelector('meta[name="theme-color"]').content =
                (document.documentElement.getAttribute('bit-theme') || '').endsWith('dark')
                    ? '@darkThemeColor'
                    : '@lightThemeColor';
        </Script>
    }
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@graph": [
                {
                    "@@type": "Organization",
                    "name": "bit platform",
                    "url": "https://bitplatform.dev/",
                    "logo": "https://bitplatform.dev/images/bit-icon-512.png",
                    "sameAs": [
                        "https://github.com/bitfoundation/bitplatform",
                        "https://twitter.com/bitplatformhq",
                        "https://www.youtube.com/@@bitplatform",
                        "https://www.linkedin.com/company/bitplatformhq"
                    ]
                },
                {
                    "@@type": "WebSite",
                    "name": "bit platform",
                    "url": "https://bitplatform.dev/"
                }
            ]
        }
    </script>

    <Link rel="manifest" Href="manifest.json" />
    <Link rel="icon" Href="/favicon.ico" type="image/x-icon" />

    <HeadOutlet @rendermode=RenderModeProvider.Current />

    <Link rel="apple-touch-icon" sizes="512x512" Href="images/bit-icon-512.png" />
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI/styles/bit.blazorui.css" />
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.Extras/styles/bit.blazorui.extras.css" />
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.Assets/styles/bit.blazorui.assets.css" />
    <Link rel="stylesheet" Href="styles/app.css" />
    <Link rel="stylesheet" Href="Bit.Websites.Platform.Client.bundle.scp.css" />
</head>

<body class="@BitCss.Class.Color.Background.Primary.Main @BitCss.Class.Color.Foreground.Primary.Main bit-blazor-web">

    <Routes @rendermode=RenderModeProvider.Current />

    @if (HttpContext.Request.IsLightHouseRequest() is false)
    {
        <Script Src="_framework/bit.blazor.web.es2019.js" autostart="false"></Script>
        <Script Src="_content/Bit.Bswup/bit-bswup.js" blazorScript="_framework/bit.blazor.web.es2019.js"></Script>
        <Script Src="_content/Bit.Bswup/bit-bswup.progress.js"></Script>
        <AppBswupProgressBar />
        <Script Src="_content/Bit.Butil/bit-butil.js"></Script>
        <Script Src="_content/Bit.BlazorUI/scripts/bit.blazorui.js"></Script>
        <Script Src="_content/Bit.BlazorUI.Extras/scripts/bit.blazorui.extras.js"></Script>
        <Script Src="scripts/app.js"></Script>
    }
</body>

</html>

