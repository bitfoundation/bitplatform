@page "/validation"
@implements IDisposable
@inject DemoDirectory Directory

<PageTitle>Validation modes</PageTitle>

<div class="demo-intro">
    <h1>Validation modes, summary &amp; reset</h1>
    <p>
        Choose <em>when</em> a field revalidates, independently for before and after the first submit —
        the same <code>mode</code>/<code>reValidateMode</code> split React Hook Form popularised. The
        summary below lists every error in schema order and links to the control that needs fixing.
        The username field is <em>debounced</em>, so its async availability check runs once you pause
        rather than once per character — try <code>ada</code> or <code>admin</code> and watch the
        indicator below.
    </p>
</div>

<div class="demo-card">
    <div class="demo-toolbar">
        <label>
            Before submit
            <select @onchange="e => SetTrigger(before: true, e)">
                @foreach (var t in Triggers)
                {
                    <option value="@t" selected="@(t == _state.ValidationTrigger)">@t</option>
                }
            </select>
        </label>
        <label>
            After submit
            <select @onchange="e => SetTrigger(before: false, e)">
                @foreach (var t in Triggers)
                {
                    <option value="@t" selected="@(t == _state.RevalidationTrigger)">@t</option>
                }
            </select>
        </label>
        <label class="demo-toolbar__check">
            <input type="checkbox" checked="@_readOnly" @onchange="ToggleReadOnly" /> Read-only (review mode)
        </label>
    </div>

    <BormView State="_state"
              ReadOnly="_readOnly"
              ShowErrorSummary="true"
              ShowResetButton="true"
              OnValidSubmit="HandleSubmit"
              SubmitText="Create account" />
</div>

<p class="demo-status">
    dirty: <strong>@_state.IsFormDirty</strong> ·
    submitted: <strong>@_state.SubmitCount</strong> time(s) ·
    saved: <strong>@_state.IsSubmitSuccessful</strong> ·
    errors: <strong>@_state.AllMessages.Count()</strong> ·
    @* Per field, not per form: a lookup on one box should not declare the whole form busy. *@
    checking username: <strong>@(_state.IsValidatingField("Username") ? "yes — remote lookup in flight" : "no")</strong>
</p>

@if (_submitted)
{
    <div class="demo-result"><strong>Account created ✓</strong> <pre>@_json</pre></div>
}

<details class="demo-source">
    <summary>View source</summary>
    <pre><code>@Source</code></pre>
</details>

<style>
    .demo-toolbar { display: flex; gap: 1.25rem; flex-wrap: wrap; align-items: center; margin-bottom: 1.5rem; font-size: .85rem; color: #475569; }
    .demo-toolbar select { margin-left: .4rem; padding: .25rem .4rem; border: 1px solid #cbd5e1; border-radius: 6px; }
    .demo-toolbar__check { display: inline-flex; align-items: center; gap: .4rem; }
    .demo-status { max-width: 760px; margin-top: 1rem; font-size: .85rem; color: #475569; }
</style>

@code {
    private const string Source =
"""
@page "/validation"
@inject DemoDirectory Directory

<BormView State="_state"
          ReadOnly="_readOnly"
          ShowErrorSummary="true"
          ShowResetButton="true"
          OnValidSubmit="HandleSubmit"
          SubmitText="Create account" />

@code {
    private readonly NewAccount _model = new();
    private BormState _state = default!;
    private bool _readOnly;

    protected override void OnInitialized()
    {
        var schema = BormBuilder.For<NewAccount>()
            .Title("Create your account")
            .Field(x => x.Email, f => f.Autocomplete("email"))
            .Field(x => x.Username, f => f
                .Required()
                .Autocomplete("username")
                .Trim()                                  // fix the value; do not complain about spaces
                // Debouncing writes once per pause instead of once per character — and the async rule
                // runs with that write, which is the whole reason to debounce a field that calls out
                // to a service. An undebounced field's async rules still wait for blur.
                .UpdateOnInput(debounceMilliseconds: 400)
                .MustAsync(async ctx => await Directory.IsUsernameAvailableAsync((string?)ctx.Value ?? "", ctx.CancellationToken),
                           "That username is taken.")
                .Help("Try 'ada' or 'admin' to see the async rule fire."))
            .Field(x => x.Password, f => f.Autocomplete("new-password"))
            // [Compare] on the model already wires the confirm rule.
            .Field(x => x.ConfirmPassword, f => f.Autocomplete("new-password"))
            .Build();

        _state = new BormState(schema, new BormModelDataAccessor(_model))
        {
            // Stay quiet until the first submit, then correct eagerly.
            ValidationTrigger = BormValidationTrigger.OnBlur,
            RevalidationTrigger = BormValidationTrigger.OnChange
        };
        _state.StateChanged += OnStateChanged;
    }
}
""";

    private static readonly BormValidationTrigger[] Triggers = Enum.GetValues<BormValidationTrigger>();

    private readonly NewAccount _model = new();
    private BormState _state = default!;
    private bool _readOnly;
    private bool _submitted;
    private string _json = "";

    protected override void OnInitialized()
    {
        var schema = BormBuilder.For<NewAccount>()
            .Title("Create your account")
            .Field(x => x.Email, f => f.Autocomplete("email"))
            .Field(x => x.Username, f => f
                .Required()
                .Autocomplete("username")
                .Trim()
                .UpdateOnInput(debounceMilliseconds: 400)
                // A spinner beside this one box, not a form that declares itself busy: state.IsValidatingField("Username")
                .MustAsync(async ctx => await Directory.IsUsernameAvailableAsync((string?)ctx.Value ?? "", ctx.CancellationToken),
                           "That username is taken.")
                .Help("Try 'ada' or 'admin' to see the async rule fire."))
            .Field(x => x.Password, f => f.Autocomplete("new-password"))
            .Field(x => x.ConfirmPassword, f => f.Autocomplete("new-password"))
            .Build();

        _state = new BormState(schema, new BormModelDataAccessor(_model))
        {
            ValidationTrigger = BormValidationTrigger.OnBlur,
            RevalidationTrigger = BormValidationTrigger.OnChange
        };
        _state.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void SetTrigger(bool before, ChangeEventArgs e)
    {
        if (!Enum.TryParse<BormValidationTrigger>(e.Value?.ToString(), out var trigger)) return;
        if (before) _state.ValidationTrigger = trigger;
        else _state.RevalidationTrigger = trigger;
    }

    private void ToggleReadOnly(ChangeEventArgs e)
    {
        _readOnly = e.Value is bool b && b;
        _state.ReadOnly = _readOnly;
    }

    private void HandleSubmit(BormState state)
    {
        _submitted = true;
        _json = System.Text.Json.JsonSerializer.Serialize(
            new { _model.Email, _model.Username, Password = "********" },
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }

    public void Dispose()
    {
        _state.StateChanged -= OnStateChanged;
        // The page created the state, so the page disposes it: an options load or async rule still in
        // flight is cancelled instead of finishing against a form nobody is looking at.
        _state.Dispose();
    }
}
