@page "/composition"
@implements IDisposable
@inject DemoDirectory Directory

<PageTitle>Groups, custom layout &amp; resilience</PageTitle>

<div class="demo-intro">
    <h1>Groups, custom layout &amp; resilience</h1>
    <p>
        Three things a form needs once it stops being a demo. Fields that cluster into named
        <code>&lt;fieldset&gt;</code>s a screen reader announces; a layout the page owns, built from
        <code>&lt;BormField&gt;</code>; and a dropdown whose service is allowed to fall over
        without taking the page with it. Every field also has its own undo, because
        <code>Reset()</code> is far too blunt when the user changed their mind about one answer.
    </p>
</div>

<div class="demo-split">
    <div class="demo-card">
        <h2 style="margin-top:0;font-size:1.05rem;">Grouped, rendered whole</h2>
        <p style="color:#64748b;font-size:.85rem;">
            <code>[Display(GroupName = "…")]</code> — or <code>f.Group("…")</code> — clusters a run of
            fields into one labelled fieldset.
        </p>
        @* The same schema is rendered twice on this page, so each copy gets an id prefix of its own —
           otherwise both would render borm_ReporterName, and a label in one would point at the other. *@
        <BormView State="_grouped" ShowSubmitButton="false" IdPrefix="grouped_" />
    </div>

    <div class="demo-card">
        <h2 style="margin-top:0;font-size:1.05rem;">The same schema, the page's layout</h2>
        <p style="color:#64748b;font-size:.85rem;">
            Placed one field at a time, interleaved with the page's own markup. Labels, validation,
            conditions and the <code>aria-*</code> wiring all still come from the schema.
        </p>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;align-items:start;">
            <BormField State="_custom" Name="ReporterName" />
            <BormField State="_custom" Name="ReporterEmail" />
        </div>

        <p style="margin:1rem 0 .5rem;font-size:.8rem;text-transform:uppercase;letter-spacing:.04em;color:#64748b;">
            Routing
        </p>
        <BormField State="_custom" Name="Team" />

        <div style="display:flex;gap:.5rem;align-items:flex-end;">
            <div style="flex:1;"><BormField State="_custom" Name="Component" /></div>
            <button type="button" class="bit-borm-btn bit-borm-btn--sm" @onclick="RetryComponents">Retry</button>
        </div>

        <label style="display:flex;gap:.4rem;align-items:center;font-size:.82rem;color:#475569;margin-top:.6rem;">
            <input type="checkbox" checked="@_breakTheService" @onchange="ToggleService" />
            Break the component service
        </label>
        @if (_lastFailure is not null)
        {
            <p style="font-size:.8rem;color:#b45309;margin:.4rem 0 0;">
                Logged from <code>OnOptionsLoadFailed</code>: @_lastFailure
            </p>
        }

        <hr style="border:none;border-top:1px solid #e2e8f0;margin:1.25rem 0;" />

        @* AsSearch(): the same string value, but the browser gives it a clear affordance, a search key
           on the on-screen keyboard and history from previous searches. *@
        <BormField State="_custom" Name="RelatedTicket" />
        <div style="margin-top:.75rem;"><BormField State="_custom" Name="Subject" /></div>
        <div style="margin-top:.75rem;"><BormField State="_custom" Name="Details" /></div>

        <div class="bit-borm-form__actions">
            <button type="button" class="bit-borm-btn bit-borm-btn--primary" @onclick="Submit">Raise ticket</button>
            <button type="button" class="bit-borm-btn" disabled="@(!_custom.IsDirty("Subject"))" @onclick='() => _custom.ResetField("Subject")'>
                Undo subject
            </button>
            <span style="align-self:center;font-size:.82rem;color:#64748b;">
                @(_custom.IsFormDirty ? $"{_custom.DirtyFields.Count} unsaved change(s)" : "No unsaved changes")
            </span>
        </div>
    </div>
</div>

@if (_submitted)
{
    <div class="demo-result"><strong>Raised ✓</strong> <pre>@_json</pre></div>
}

<details class="demo-source">
    <summary>View source</summary>
    <pre><code>@Source</code></pre>
</details>

@code {
    private const string Source =
"""
// 1. Named groups. A run of consecutive fields sharing a Group name becomes one <fieldset> with a
//    <legend>, so a screen reader announces "Who you are" as focus enters the first control in it.
//    [Display(GroupName = "Who you are")] on the model does the same thing.
var schema = BormBuilder.For<SupportTicket>()
    .Field(x => x.ReporterName,  f => f.Required().Group("Who you are"))
    .Field(x => x.ReporterEmail, f => f.AsEmail().Required().Group("Who you are"))
    .Field(x => x.Team,      f => f.Group("Where it belongs").Options(Teams))
    .Field(x => x.Component, f => f.Group("Where it belongs")
        // 2. A lookup that is allowed to fail. An options provider that throws used to take the
        //    rendering component down with it; now it is recorded, announced, and shown in place of
        //    the choices — and the next Invalidate retries.
        .OptionsFrom(async ctx => await components.ForTeamAsync(ctx.Value("Team") as string, ctx.CancellationToken),
                     value: c => c, label: c => c,
                     dependsOn: nameof(SupportTicket.Team)))
    .Field(x => x.RelatedTicket, f => f.AsSearch().Suggest("SUP-1201", "SUP-1233"))
    // A counter drops the maxlength attribute, so a pasted subject keeps every character and the
    // count turns red instead of the answer being silently truncated.
    .Field(x => x.Subject, f => f.Required().MaxLength(80).CharacterCount().UpdateOnInput())
    .Field(x => x.Details, f => f.AsTextArea(4))
    .Build();

var state = new BormState(schema, new BormModelDataAccessor(model));
state.OptionsLoadFailed += (path, ex) => logger.LogWarning(ex, "Options for {Path} failed", path);

// 3. The page owns the layout. BormField places one field wherever you want it while the
//    schema keeps the label, the rules, the conditions and the accessibility wiring.
<div style="display:grid;grid-template-columns:1fr 1fr;">
    <BormField State="state" Name="ReporterName" />
    <BormField State="state" Name="ReporterEmail" />
</div>
<BormField State="state" Name="Subject" />

// 4. Per-field undo, and dirtiness that is a comparison rather than a flag: typing a character and
//    deleting it again leaves the field clean, so this button switches itself off.
<button disabled="@(!state.IsDirty("Subject"))" @onclick='() => state.ResetField("Subject")'>Undo subject</button>
""";

    private readonly SupportTicket _groupedModel = new();
    private readonly SupportTicket _customModel = new();
    private BormState _grouped = default!;
    private BormState _custom = default!;

    private bool _breakTheService;
    private string? _lastFailure;
    private bool _submitted;
    private string _json = "";

    protected override void OnInitialized()
    {
        _grouped = new BormState(Schema(), new BormModelDataAccessor(_groupedModel));
        _custom = new BormState(Schema(), new BormModelDataAccessor(_customModel)) { IdPrefix = "custom_" };

        _grouped.StateChanged += OnStateChanged;
        _custom.StateChanged += OnStateChanged;
        _custom.OptionsLoadFailed += OnOptionsLoadFailed;
    }

    private BormDefinition Schema() => BormBuilder.For<SupportTicket>()
        .Title("Raise a ticket")
        .Field(x => x.ReporterName, f => f.Required())
        .Field(x => x.ReporterEmail, f => f.AsEmail().Required())
        .Field(x => x.Team, f => f
            .Options([.. DemoDirectory.Teams])
            .Placeholder("Pick a team"))
        .Field(x => x.Component, f => f
            .OptionsFrom(
                load: async ctx => await Directory.GetComponentsAsync(
                    ctx.Value(nameof(SupportTicket.Team)) as string, _breakTheService, ctx.CancellationToken),
                value: c => c,
                label: c => c,
                dependsOn: nameof(SupportTicket.Team))
            .Help("Loaded once a team is chosen."))
        .Field(x => x.RelatedTicket, f => f
            .AsSearch()
            .Placeholder("SUP-1234")
            .Suggest("SUP-1201", "SUP-1233", "SUP-1240"))
        // No maxlength attribute: the counter is non-destructive, so pasting a long subject keeps every
        // character and turns the count red instead of silently truncating it.
        .Field(x => x.Subject, f => f.Required().MaxLength(80).CharacterCount().UpdateOnInput())
        .Field(x => x.Details, f => f.AsTextArea(4))
        .Build();

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnOptionsLoadFailed(string path, Exception ex)
    {
        _lastFailure = $"{path} — {ex.Message}";
        InvokeAsync(StateHasChanged);
    }

    private void ToggleService(ChangeEventArgs e)
    {
        _breakTheService = e.Value is bool b && b;
        _lastFailure = null;
        RetryComponents();
    }

    private void RetryComponents() => _custom.InvalidateOptions(nameof(SupportTicket.Component));

    private async Task Submit()
    {
        var valid = await _custom.SubmitAsync();
        _submitted = valid;
        if (valid)
        {
            _json = System.Text.Json.JsonSerializer.Serialize(_customModel,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            // The values just saved are the new baseline, so the "unsaved changes" counter goes quiet.
            _custom.AcceptChanges();
        }
    }

    public void Dispose()
    {
        _grouped.StateChanged -= OnStateChanged;
        _custom.StateChanged -= OnStateChanged;
        _custom.OptionsLoadFailed -= OnOptionsLoadFailed;
        _grouped.Dispose();
        _custom.Dispose();
    }
}
