<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>Bit.Borm</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- The engine reads and writes the bound model through property paths resolved at run time,
             builds collections of element types it only learns from the model, and reads
             DataAnnotations off whatever type it is handed, so it cannot claim to be trimming or AOT
             safe. Left untrimmed, the app keeps everything it reaches. -->
        <IsAotCompatible>false</IsAotCompatible>
        <IsTrimmable>false</IsTrimmable>
        <Description>A schema-driven form engine for Blazor: render forms from C# types, a fluent builder or JSON Schema, with validation, conditional visibility, requiredness and read-only state, computed values, cascading options, multi-step wizards and array/repeater fields. Every decision runs in C#; the renderers are plain, accessible HTML with a pluggable renderer registry and a themeable stylesheet.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>Bit;Blazor;Forms;FormBuilder;DynamicForms;Schema;JsonSchema;Validation;Wizard;Accessibility</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <!-- Use floating low-bound version ranges so consumers can pin to any patch release on
             their TFM. The upper bound prevents accidentally pulling a major-version package that
             targets a newer TFM. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[8.0.0,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[10.0.0,11.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.Borm.Tests" PublicKey="" />
    </ItemGroup>

    <!-- Keep the build inputs (package manifests) out of the published static web assets while still
         showing them in the project. -->
    <ItemGroup>
        <Content Remove="package*.json" />
        <None Include="package*.json" />
    </ItemGroup>

    <ItemGroup>
        <StyleFiles Include="Styles\**\*.css" />
    </ItemGroup>

    <!-- Restores npm packages and bundles the stylesheet. Both sub-targets are incremental via their
         Inputs/Outputs, so this is a no-op when nothing changed. There is no script: every decision the
         form makes runs in C#, and the inputs are plain HTML elements. -->
    <Target Name="BuildBormAssets" DependsOnTargets="InstallNodejsDependencies;BuildCss" />

    <!-- The output (wwwroot/bit-borm.css) is a generated, git-ignored file. On a clean build it does
         not exist when the default "wwwroot/**" Content glob is evaluated, so the static web asset
         discovery in ResolveProjectStaticWebAssets would miss it and consumers would get a 404 for
         _content/Bit.Borm/bit-borm.css.
         Hooking BeforeTargets="ResolveProjectStaticWebAssets" guarantees it is generated first and
         then explicitly added to @(Content). The Remove-before-Include keeps it to a single Content
         entry for builds where the glob already captured it. -->
    <Target Name="IncludeBormAssetsAsStaticWebAsset"
            BeforeTargets="ResolveProjectStaticWebAssets"
            DependsOnTargets="BuildBormAssetsOnce">
        <ItemGroup>
            <Content Remove="wwwroot\bit-borm.css" />
            <Content Include="wwwroot\bit-borm.css" />
        </ItemGroup>
    </Target>

    <!-- Runs BuildBormAssets through the MSBuild task with TargetFramework removed, so every per-TFM
         build asks for the same project configuration. MSBuild keeps one result per project and global
         properties: the first request runs esbuild, concurrent ones wait for it, and later ones reuse
         it. A ProjectReference builds this project's inner builds directly (one per referencing target
         framework, in parallel) without ever running the outer build, so without this each of them
         would write the same wwwroot output at once. -->
    <Target Name="BuildBormAssetsOnce">
        <MSBuild Projects="$(MSBuildProjectFullPath)"
                 Targets="BuildBormAssets"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
    </Target>

    <!-- In a multi-targeted build, produce the output exactly once in the outer (cross-targeting)
         build, before the per-TFM inner builds are dispatched. -->
    <Target Name="BuildBormAssetsOnCrossTargeting"
            BeforeTargets="DispatchToInnerBuilds"
            Condition="'$(IsCrossTargetingBuild)' == 'true'"
            DependsOnTargets="BuildBormAssets" />

    <!-- `npm ci` installs exactly what the checked-in package-lock.json pins, and fails fast when the
         lockfile and package.json drift instead of silently rewriting the lock. -->
    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm ci" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <!-- The stylesheet is plain CSS: esbuild only copies it in Debug and minifies it in Release. The
         output differs per configuration but lands in the same file, so the sources alone cannot drive
         the up-to-date check: after a Debug build, a Release build would see the output newer than the
         sources and skip, shipping an unminified file (and vice versa). A per-configuration stamp in
         obj/ makes switching configurations invalidate the check; the stale stamp of the other
         configuration is deleted so switching back rebuilds too. -->
    <Target Name="BuildCss"
            Inputs="@(StyleFiles)"
            Outputs="wwwroot/bit-borm.css;$(BaseIntermediateOutputPath)bit-borm.css.$(Configuration).stamp">
        <ItemGroup>
            <_BormStaleCssStamps Include="$(BaseIntermediateOutputPath)bit-borm.css.*.stamp" />
        </ItemGroup>
        <Delete Files="@(_BormStaleCssStamps)" />
        <Exec Condition=" '$(Configuration)' == 'Release' " Command="node_modules/.bin/esbuild Styles/bit-borm.css --minify --outfile=wwwroot/bit-borm.css" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Exec Condition=" '$(Configuration)' != 'Release' " Command="node_modules/.bin/esbuild Styles/bit-borm.css --outfile=wwwroot/bit-borm.css" StandardOutputImportance="high" StandardErrorImportance="high" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)" />
        <Touch Files="$(BaseIntermediateOutputPath)bit-borm.css.$(Configuration).stamp" AlwaysCreate="true" />
    </Target>

</Project>
