<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Single-target: this is a measurement tool, not a shipped/multi-TFM library. net10.0 matches
             global.json's pinned SDK. -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <!-- BenchmarkDotNet refuses to measure an unoptimized assembly, so keep the JIT-relevant optimizations on
             even when the project is built without -c Release. Numbers should still come from a Release run. -->
        <Optimize>true</Optimize>
        <!-- Workstation GC, as in the browser: the numbers are meant to describe a frame decoded on a phone, not
             on a server's dedicated collector threads. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <!-- Not a unit-test project: it's a console harness run manually (dotnet run -c Release), so it
             deliberately does NOT set IsTestProject. -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.BbScanner\Bit.BbScanner.csproj" />
        <ProjectReference Include="..\Bit.BbScanner.TestKit\Bit.BbScanner.TestKit.csproj" />
    </ItemGroup>

</Project>
