@namespace Bit.Balette

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@if (EffectiveShowSequenceHint)
{
    @* After the first chords of a sequence, while the palette is closed: the keys pressed so far and that the next one is
       awaited. Present and empty otherwise, so the announcement is heard when it fills. *@
    <div class="@(Unstyled ? null : "bit-balette-sequence")" data-balette="sequence" data-pending="@(_pendingSequence is not null && !_isOpen ? "true" : null)" role="status">
        @if (_pendingSequence is not null && !_isOpen)
        {
            <BaletteShortcutHint Shortcut="_pendingSequence" IsMac="_isMac" Strings="S" />
            <span class="bit-balette-sequence-text">@S.SequencePending</span>
        }
    </div>
}

@if (Inline)
{
    @* In the page rather than over it: a region named like the dialog, always showing its list. *@
    <section @ref="_dialogEl"
             id="@_id"
             class="@RootClass"
             style="@Style"
             data-balette="inline"
             data-theme="@EffectiveTheme"
             data-density="@EffectiveDensity"
             data-open="true"
             data-ready="@(_handle is not null ? "true" : null)"
             data-multiselect="@(CurrentPage.MultiSelect ? "true" : "false")"
             data-has-detail="@(DetailTemplate is not null ? "true" : "false")"
             data-busy="@(_busy ? "true" : null)"
             data-hover-suspended="@HoverSuspended"
             aria-label="@S.DialogLabel"
             @attributes="AdditionalAttributes">
        @RenderBody()
    </section>
}
else
{
    @* data-ready: the browser layer listens for keys. Until then Ctrl+K and the global shortcuts reach nothing - the page
       is prerendered and turns interactive first - and another palette on the page may have started already. *@
    <dialog @ref="_dialogEl"
            id="@_id"
            class="@RootClass"
            style="@Style"
            data-balette="dialog"
            data-theme="@EffectiveTheme"
            data-density="@EffectiveDensity"
            data-open="@(_isOpen ? "true" : "false")"
            data-ready="@(_handle is not null ? "true" : null)"
            data-multiselect="@(CurrentPage.MultiSelect ? "true" : "false")"
            data-has-detail="@(DetailTemplate is not null ? "true" : "false")"
            data-busy="@(_busy ? "true" : null)"
            data-hover-suspended="@HoverSuspended"
            aria-label="@S.DialogLabel"
            @attributes="AdditionalAttributes">
        @if (_isOpen)
        {
            @RenderBody()
        }
    </dialog>
}

@code {
    /// <summary>Everything inside the dialog, or inside the inline section: header, list, footer, detail pane, live regions.</summary>
    private RenderFragment RenderBody() => __builder =>
    {
        var frame = CurrentPage;
        var state = StateContext;
        <div class="bit-balette-root" data-balette="root" data-mode="@(_mode?.Prefix)" data-page-depth="@(_pages.Count - 1)">
            <div class="bit-balette-main" data-balette="main">
                @* ---------- Header ---------- *@
                @if (HeaderTemplate is not null)
                {
                    @HeaderTemplate(state)
                }
                <div class="bit-balette-header" data-balette="header">
                    @if (_pages.Count > 1 || _mode is not null)
                    {
                        <nav class="bit-balette-breadcrumbs" data-balette="breadcrumbs" aria-label="@S.Breadcrumb">
                            @if (_pages.Count > 1)
                            {
                                var crumbs = Breadcrumbs;
                                <button type="button" class="bit-balette-crumb bit-balette-crumb-home" @onclick="OnBackClick" aria-label="@S.BackButton" title="@S.BackButton">
                                    @IconSvg("arrow-left")
                                </button>
                                @for (var c = 0; c < crumbs.Count; c++)
                                {
                                    var crumb = c;
                                    if (crumb < crumbs.Count - 1)
                                    {
                                        @* An ancestor is a way back to its page. *@
                                        <button type="button" class="bit-balette-crumb bit-balette-crumb-link" data-balette="crumb" dir="auto" @onclick="() => OnCrumbClick(crumb)">@crumbs[crumb]</button>
                                    }
                                    else
                                    {
                                        <span class="bit-balette-crumb" data-balette="crumb" dir="auto" aria-current="page">@crumbs[crumb]</span>
                                    }
                                }
                            }
                            @if (_mode is not null)
                            {
                                <span class="bit-balette-crumb bit-balette-mode-chip" data-balette="mode">@_mode.Name</span>
                            }
                        </nav>
                    }
                    <div class="bit-balette-input-row" data-balette="input-row">
                        <span class="bit-balette-input-icon" aria-hidden="true">
                            @if (IsLoading || _busy)
                            {
                                <span class="bit-balette-spinner" data-balette="spinner"></span>
                            }
                            else
                            {
                                @IconSvg("search")
                            }
                        </span>
                        @* @bind rather than value + @oninput: only a binding tells the renderer what the field holds when each key's
                           event arrives, so on Blazor Server a render answering an earlier key never writes its older value over
                           the keys typed since ("th" turned back into "t", then "teme"). A query stops at BaletteQuery.MaxLength,
                           past which it would match nothing; a prompt's answer is not a query and has no such limit. *@
                        <input @ref="_inputEl"
                               class="bit-balette-input"
                               data-balette="input"
                               type="text"
                               role="@(frame.Prompt is null ? "combobox" : null)"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="off"
                               spellcheck="false"
                               enterkeyhint="go"
                               aria-label="@(frame.Prompt?.Title ?? S.InputLabel)"
                               aria-expanded="@(frame.Prompt is null ? HasListbox ? "true" : "false" : null)"
                               aria-haspopup="@(frame.Prompt is null ? "listbox" : null)"
                               aria-autocomplete="@(frame.Prompt is null ? "list" : null)"
                               aria-controls="@(HasListbox ? $"{_id}-list" : null)"
                               aria-activedescendant="@ActiveDescendant"
                               aria-invalid="@(_promptError is not null ? "true" : null)"
                               aria-describedby="@(_promptError is not null ? $"{_id}-prompt-error" : null)"
                               placeholder="@EffectivePlaceholder"
                               maxlength="@(frame.Prompt is null ? (int?)BaletteQuery.MaxLength : null)"
                               @bind="_query"
                               @bind:event="oninput"
                               @bind:after="OnInputAsync" />
                        @if (frame.MultiSelect && frame.Selected.Count > 0)
                        {
                            <span class="bit-balette-selected-count" data-balette="selected-count">@S.Format(S.SelectedCount, frame.Selected.Count)</span>
                        }
                        @if (!Inline)
                        {
                            @* The accessible name holds the visible "Esc" (WCAG 2.5.3, label in name), so voice control users can say it. *@
                            <button type="button" class="bit-balette-close" data-balette="close" @onclick="CloseCoreAsync" aria-label="@($"{S.CloseButton}, Esc")" aria-keyshortcuts="Escape" title="@S.CloseButton">
                                <kbd class="bit-balette-kbd">Esc</kbd>
                            </button>
                        }
                    </div>
                </div>

                @if (_approximate && _itemRows.Count > 0)
                {
                    @* Outside the listbox, which may only hold options and groups; announced with the result count. *@
                    <div class="bit-balette-notice" data-balette="notice">@S.ApproximateResults</div>
                }

                @* ---------- List ---------- *@
                @* A listbox only while it lists something: a listbox owns options and groups, and the prompt, the empty state,
                   the loading state and the error are none of those. The input's combobox says so (aria-expanded). Never a
                   tab stop: rows are reached through aria-activedescendant, and browsers make a scrollable box a tab stop
                   of its own otherwise. *@
                <div @ref="_listEl"
                     id="@(_id)-list"
                     class="bit-balette-list"
                     data-balette="list"
                     tabindex="-1"
                     role="@(HasListbox ? "listbox" : null)"
                     aria-label="@(HasListbox ? frame.IsRoot ? S.Results : frame.Title : null)"
                     aria-multiselectable="@(HasListbox && frame.MultiSelect ? "true" : null)"
                     aria-busy="@(HasListbox && (IsLoading || _busy) ? "true" : null)"
                     style="@RowHeightStyle">
                    @if (frame.Prompt is not null)
                    {
                        <div class="bit-balette-prompt" data-balette="prompt">
                            <p class="bit-balette-prompt-title">@frame.Prompt.Title</p>
                            @if (_promptError is not null)
                            {
                                <p class="bit-balette-prompt-error" id="@($"{_id}-prompt-error")" data-balette="prompt-error">@_promptError</p>
                            }
                            <p class="bit-balette-prompt-hint">
                                <kbd class="bit-balette-kbd">@(_isMac ? "↩" : "Enter")</kbd> @S.Apply
                                <span class="bit-balette-sep">·</span>
                                <kbd class="bit-balette-kbd">Esc</kbd> @S.Back
                            </p>
                        </div>
                    }
                    else if (_rows.Count == 0)
                    {
                        if (frame.LoadFailed)
                        {
                            <div class="bit-balette-empty bit-balette-error" data-balette="error" role="alert">
                                @IconSvg("alert")
                                <p class="bit-balette-empty-title">@S.LoadFailed</p>
                                <button type="button" class="bit-balette-retry" data-balette="retry" @onclick="RetryPageLoadAsync">@S.Retry</button>
                            </div>
                        }
                        else if (IsLoading)
                        {
                            if (LoadingTemplate is not null)
                            {
                                @LoadingTemplate
                            }
                            else
                            {
                                <div class="bit-balette-empty" data-balette="loading" role="status">
                                    <span class="bit-balette-spinner"></span>
                                    <p>@S.Loading</p>
                                </div>
                            }
                        }
                        else if (EmptyTemplate is not null)
                        {
                            @EmptyTemplate(_effectiveQuery)
                        }
                        else
                        {
                            <div class="bit-balette-empty" data-balette="empty" role="status">
                                @IconSvg("empty")
                                <p class="bit-balette-empty-title">@(_effectiveQuery.Length > 0 ? S.Format(S.NoResults, _effectiveQuery) : S.Empty)</p>
                                @if (_effectiveQuery.Length > 0)
                                {
                                    <p class="bit-balette-empty-hint">@S.NoResultsHint</p>
                                }
                            </div>
                        }
                    }
                    else if (EffectiveVirtualize)
                    {
                        <Virtualize Items="_rows" ItemSize="Options.RowHeight" Context="row" OverscanCount="6">
                            @RenderRow(row)
                        </Virtualize>
                    }
                    else
                    {
                        @RenderGroupedRows()
                    }
                </div>

                @* ---------- Footer ---------- *@
                @if (EffectiveShowFooter)
                {
                    if (FooterTemplate is not null)
                    {
                        @FooterTemplate(state)
                    }
                    else
                    {
                        <div class="bit-balette-footer" data-balette="footer">
                            @if (_toast is not null)
                            {
                                @* Announced by the live regions below, which exist before the message does. *@
                                <span class="bit-balette-toast @(_confirmingId is not null ? "bit-balette-toast-confirm" : null) @(_toastIsError ? "bit-balette-toast-error" : null)"
                                      data-balette="toast"
                                      data-kind="@(_toastIsError ? "error" : null)">@_toast</span>
                            }
                            else
                            {
                                <span class="bit-balette-hint"><kbd class="bit-balette-kbd">↑</kbd><kbd class="bit-balette-kbd">↓</kbd> @S.Navigate</span>
                                @if (frame.MultiSelect)
                                {
                                    <span class="bit-balette-hint"><kbd class="bit-balette-kbd">@(_isMac ? "↩" : "Enter")</kbd> @S.Toggle</span>
                                    <span class="bit-balette-hint"><kbd class="bit-balette-kbd">@(_isMac ? "⌘" : "Ctrl")</kbd><kbd class="bit-balette-kbd">@(_isMac ? "↩" : "Enter")</kbd> @S.Apply</span>
                                }
                                else
                                {
                                    <span class="bit-balette-hint"><kbd class="bit-balette-kbd">@(_isMac ? "↩" : "Enter")</kbd> @S.Select</span>
                                }
                                @if (!frame.MultiSelect && ActiveCommand is { } active && (active.Actions is { Count: > 0 } || EffectiveEnableHistory))
                                {
                                    <span class="bit-balette-hint"><kbd class="bit-balette-kbd">Tab</kbd> @S.OpenActions</span>
                                }
                                @if (_pages.Count > 1 || !Inline || _query.Length > 0)
                                {
                                    <span class="bit-balette-hint bit-balette-hint-right"><kbd class="bit-balette-kbd">Esc</kbd> @(_pages.Count > 1 ? S.Back : Inline ? S.ClearQuery : S.Close)</span>
                                }
                            }
                        </div>
                    }
                }
            </div>

            @* ---------- Detail pane ---------- *@
            @if (DetailTemplate is not null && ActiveCommand is { } detailCmd)
            {
                <aside class="bit-balette-detail" data-balette="detail">
                    @DetailTemplate(detailCmd)
                </aside>
            }
        </div>

        @* Live regions are rendered empty when the palette opens and only their text changes afterwards: a region inserted
           together with its message is often not announced. The toast is announced here whatever the footer shows - a
           FooterTemplate, or no footer at all. *@
        @* An inline palette announces only while it has the focus: its history loading or its sources answering would
           otherwise speak up while the reader is elsewhere on the page. *@
        <div class="bit-balette-sr-only" aria-live="polite" aria-atomic="true">@(Inline && !_inlineFocused ? null : _announcement)</div>
        <div class="bit-balette-sr-only" role="status" aria-atomic="true" data-balette="status">@(_toastIsError ? null : _confirmingId is not null && _toast is not null ? $"{_toast}. {S.ConfirmHint}" : _toast)</div>
        <div class="bit-balette-sr-only" role="alert" aria-atomic="true" data-balette="alert">@(_toastIsError ? _toast : _promptError)</div>
    };

    /// <summary>
    /// The rows with each heading and its items wrapped in a <c>role="group"</c> named by the heading - the WAI-ARIA listbox
    /// with grouped options - so screen readers say which group an option is in. Rows before the first heading are direct
    /// options of the listbox.
    /// </summary>
    private RenderFragment RenderGroupedRows() => __builder =>
    {
        var i = 0;
        while (i < _rows.Count)
        {
            var row = _rows[i];
            if (row.Kind != BaletteRowKind.GroupHeader)
            {
                @RenderRow(row)
                i++;
                continue;
            }

            var end = i + 1;
            while (end < _rows.Count && _rows[end].Kind != BaletteRowKind.GroupHeader)
            {
                end++;
            }

            <div class="bit-balette-group" data-balette="group" role="group" aria-labelledby="@row.ElementId">
                @for (var j = i; j < end; j++)
                {
                    @RenderRow(_rows[j])
                }
            </div>
            i = end;
        }
    };

    private RenderFragment RenderRow(BaletteRow row) => __builder =>
    {
        var virtualized = EffectiveVirtualize;
        if (row.Kind == BaletteRowKind.GroupHeader)
        {
            @* Virtualized rows cannot be wrapped in groups: the heading is then hidden from screen readers, which hear it
               as each option's description instead (see aria-describedby below). *@
            <div class="bit-balette-group-heading" data-balette="group-heading" role="presentation" id="@row.ElementId" aria-hidden="@(virtualized ? "true" : null)">
                @if (GroupHeaderTemplate is not null)
                {
                    @GroupHeaderTemplate(row.Group!)
                }
                else
                {
                    <span dir="auto">@row.Group</span>
                }
            </div>
            return;
        }

        var match = row.Match!;
        var cmd = match.Command;
        var page = CurrentPage;
        var isActive = row.ItemIndex == _activeIndex;
        var isChecked = page.MultiSelect && page.Selected.Contains(cmd.Id);
        var isPinned = EffectiveEnableHistory && History.IsPinned(cmd.Id);
        var isConfirming = _confirmingId == cmd.Id;

        @* One state per list, never both (WAI-ARIA listbox): aria-selected marks the active row of a single-select list,
           where selection follows the active descendant; aria-checked marks the checked rows of a multi-select one, where
           aria-activedescendant alone says which row is active. *@
        <div id="@row.ElementId"
             class="bit-balette-item"
             data-balette="item"
             role="option"
             aria-selected="@(page.MultiSelect ? null : isActive ? "true" : "false")"
             aria-checked="@(page.MultiSelect ? isChecked ? "true" : "false" : null)"
             aria-disabled="@(cmd.Disabled ? "true" : null)"
             aria-describedby="@(virtualized ? row.GroupHeaderId : null)"
             aria-posinset="@(virtualized ? row.ItemIndex + 1 : null)"
             aria-setsize="@(virtualized ? _itemRows.Count : null)"
             data-active="@(isActive ? "true" : null)"
             data-checked="@(isChecked ? "true" : null)"
             data-disabled="@(cmd.Disabled ? "true" : null)"
             data-destructive="@(cmd.Destructive ? "true" : null)"
             data-confirming="@(isConfirming ? "true" : null)"
             data-running="@(_busy && cmd.Id == _runningId ? "true" : null)"
             data-error="@(cmd.Tags.Contains(SourceErrorTag) ? "true" : null)"
             data-kind="@cmd.Kind.ToString().ToLowerInvariant()"
             data-value="@cmd.Id"
             @onmouseenter="() => OnItemHover(row)"
             @onmousedown:preventDefault
             @oncontextmenu="() => OnItemContextMenu(row)"
             @oncontextmenu:preventDefault="@(HasActionPanel(cmd) && !page.MultiSelect)"
             @onclick="() => OnItemClick(row)"
             @onclick:preventDefault>
            @if (ItemTemplate is not null)
            {
                @ItemTemplate(new BaletteItemContext(row, isActive, isChecked, isPinned, isConfirming, _isMac))
            }
            else
            {
                @if (page.MultiSelect)
                {
                    <span class="bit-balette-check" aria-hidden="true">@(isChecked ? IconSvg("check") : null)</span>
                }
                <span class="bit-balette-item-icon" aria-hidden="true">
                    @if (IconTemplate is not null)
                    {
                        @IconTemplate(cmd)
                    }
                    else if (cmd.Icon is not null)
                    {
                        @cmd.Icon
                    }
                    else if (cmd.IconCss is not null)
                    {
                        <i class="@cmd.IconCss"></i>
                    }
                    else
                    {
                        @IconSvg(DefaultIconFor(cmd))
                    }
                </span>
                <span class="bit-balette-item-body">
                    <span class="bit-balette-item-title">
                        @if (isConfirming)
                        {
                            <span class="bit-balette-confirm-label">@S.ConfirmPrefix</span>
                        }
                        @* One inline box for the text and its marks: as direct children of the flex title they would each
                           become a flex item, spaced apart by the title's gap and never ellipsized. *@
                        @if (match.Path.Count > 0)
                        {
                            @* Separated by the stylesheet (::after, with empty alternative text), so screen readers hear the
                               titles alone: "Theme Dark". *@
                            <span class="bit-balette-item-path" data-balette="path">
                                @foreach (var segment in match.Path)
                                {
                                    <span class="bit-balette-path-segment" dir="auto">@segment</span>
                                }
                            </span>
                        }
                        <span class="bit-balette-item-label" data-balette="label" dir="auto"><BaletteHighlightedText Text="@cmd.Title" Positions="@(EffectiveHighlight ? match.TitlePositions : null)" /></span>
                        @if (cmd.Badge is not null)
                        {
                            <span class="bit-balette-badge" data-balette="badge" dir="auto">@cmd.Badge</span>
                        }
                        @if (isPinned)
                        {
                            <span class="bit-balette-pin" title="@S.Pinned">@IconSvg("pin")<span class="bit-balette-sr-only">@S.Pinned</span></span>
                        }
                    </span>
                    @if (cmd.Subtitle is not null || match.MatchedKeyword is not null || (cmd.Disabled && cmd.DisabledReason is not null))
                    {
                        <span class="bit-balette-item-subtitle" dir="auto">
                            @if (cmd.Disabled && cmd.DisabledReason is not null)
                            {
                                @cmd.DisabledReason
                            }
                            else if (cmd.Subtitle is not null)
                            {
                                <BaletteHighlightedText Text="@cmd.Subtitle" Positions="@(EffectiveHighlight ? match.SubtitlePositions : null)" />
                            }
                            else if (match.MatchedKeyword is not null)
                            {
                                <span class="bit-balette-keyword-hit">@match.MatchedKeyword</span>
                            }
                        </span>
                    }
                </span>
                <span class="bit-balette-item-trailing">
                    @if (cmd.Checked is { } chk)
                    {
                        <span class="bit-balette-toggle" data-on="@(chk ? "true" : "false")" aria-hidden="true"></span>
                        <span class="bit-balette-sr-only">@(chk ? S.On : S.Off)</span>
                    }
                    else if (cmd.Value is not null && !cmd.Tags.Contains(ModeHintTag))
                    {
                        <span class="bit-balette-value" dir="auto">@cmd.Value</span>
                    }
                    @if (EffectiveShowShortcuts && cmd.Shortcut is not null)
                    {
                        <BaletteShortcutHint Shortcut="cmd.Shortcut" IsMac="_isMac" Strings="S" />
                    }
                    @if (HasPage(cmd))
                    {
                        <span class="bit-balette-chevron" aria-hidden="true">@IconSvg("chevron-right")</span>
                    }
                    else if (isActive && cmd.Actions is { Count: > 0 })
                    {
                        <span class="bit-balette-actions-hint" aria-hidden="true"><kbd class="bit-balette-kbd">Tab</kbd></span>
                    }
                </span>
            }
        </div>
    };

    private static string DefaultIconFor(BaletteCommand cmd) => cmd.Kind switch
    {
        BaletteCommandKind.Navigation => "arrow-right",
        BaletteCommandKind.Page => "folder",
        BaletteCommandKind.Toggle => "toggle",
        BaletteCommandKind.Setting => "sliders",
        BaletteCommandKind.Search => "search",
        BaletteCommandKind.Help => "help",
        BaletteCommandKind.Recent => "clock",
        _ when cmd.Destructive => "trash",
        _ => "bolt",
    };

    private static readonly Dictionary<string, string> IconPaths = new(StringComparer.Ordinal)
    {
        ["search"] = "M11 4a7 7 0 1 0 4.2 12.6l3.6 3.6 1.4-1.4-3.6-3.6A7 7 0 0 0 11 4zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10z",
        ["arrow-right"] = "M13 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2h12.2l-4.6-4.6z",
        ["arrow-left"] = "M11 19l-7-7 7-7 1.4 1.4L7.8 11H20v2H7.8l4.6 4.6z",
        ["chevron-right"] = "M9 6l6 6-6 6-1.4-1.4L12.2 12 7.6 7.4z",
        ["folder"] = "M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
        ["toggle"] = "M7 7h10a5 5 0 0 1 0 10H7A5 5 0 0 1 7 7zm10 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z",
        ["sliders"] = "M4 6h10v2H4zm12 0h4v2h-4zM4 11h4v2H4zm6 0h10v2H10zM4 16h12v2H4zm14 0h2v2h-2z",
        ["help"] = "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm-1-5h2v2h-2zm2.1-2.3c-.6.4-.1 1.3-1.1 1.3h-1c0-1.7.5-2 1.4-2.6.5-.3.6-.7.6-1.1a1 1 0 0 0-2 0H9a3 3 0 0 1 6 0c0 1.2-.7 1.8-1.9 2.4z",
        ["clock"] = "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm1-13h-2v6l5 3 1-1.7-4-2.3z",
        ["trash"] = "M9 3h6l1 2h4v2H4V5h4zm-3 5h12l-1 12H7zm4 2v8h2v-8zm4 0v8h2v-8z",
        ["bolt"] = "M13 2L4 14h7l-1 8 9-12h-7z",
        ["check"] = "M9 16.2l-3.5-3.5L4 14.2 9 19.2 20 8.2l-1.4-1.4z",
        ["pin"] = "M16 3l5 5-4 1-3 3 1 5-2 2-4-4-5 5-1-1 5-5-4-4 2-2 5 1 3-3z",
