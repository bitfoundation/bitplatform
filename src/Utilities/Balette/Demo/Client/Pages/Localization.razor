    private const string RtlExample = """
        <div dir="@(_language.Rtl ? "rtl" : "ltr")" lang="@_language.Code">
            <Balette Inline="true"
                     IncludeRegisteredCommands="false"
                     Strings="_language.Strings"
                     Commands="_commands" />
        </div>

        @code {
            // A new list on every switch: the palette re-reads Commands when it is handed a new collection.
            private void SetLanguage(Language language)
            {
                _language = language;
                _commands = BuildCommands();
            }
        }
        """;

    private const string PluralExample = """
        public sealed class PolishStrings : BaletteStrings
        {
            public override string ResultsAnnouncementFor(int count) => count switch
            {
                0 => "Brak wyników",
                1 => "1 wynik",
                _ when count % 10 is >= 2 and <= 4 && count % 100 is < 12 or > 14 => $"{count} wyniki",
                _ => $"{count} wyników",
            };
        }
        """;

    private const string CommandsExample = """
        BaletteCmd.New("Einstellungen öffnen")
            .Id("l10n:settings")         // the same in every language
            .Keywords("Open settings")   // the English name still finds it
            .Group("Allgemein")
            .Shortcut("G S", global: false)
        """;

    private Language _language = Languages[0];
    private List<BaletteCommand> _commands = [];
    private bool _dark;

    protected override void OnInitialized() => _commands = BuildCommands();

    private void SetLanguage(Language language)
    {
        _language = language;
        // A new list: the palette re-reads Commands when it is handed a new collection.
        _commands = BuildCommands();
    }

    private List<BaletteCommand> BuildCommands()
    {
        var t = _language.Texts;
        var english = EnglishTexts;

        return
        [
            BaletteCmd.New(t.OpenSettings).Id("l10n:settings").Group(t.General).Keywords(english.OpenSettings)
                .Shortcut("G S", global: false)
                .Handler(_ => Task.FromResult(BaletteCommandResult.Toast(t.SettingsOpened, keepOpen: true))),
            BaletteCmd.New(t.DarkMode).Id("l10n:dark").Group(t.General).Keywords(english.DarkMode)
                .Checked(_dark)
                .Handler(_ =>
                {
                    _dark = !_dark;
                    _commands = BuildCommands();
                    StateHasChanged();
                    return Task.FromResult(BaletteCommandResult.KeepOpen);
                }),
            BaletteCmd.New(t.Export).Id("l10n:export").Group(t.General).Keywords(english.Export)
                .ChildrenPlaceholder(t.ChooseFormat)
                .Children(
                    BaletteCmd.New(t.AsPdf).Id("l10n:export.pdf").Keywords(english.AsPdf)
                        .Handler(_ => Task.FromResult(BaletteCommandResult.Toast(t.ExportedPdf, keepOpen: true))),
                    BaletteCmd.New(t.AsCsv).Id("l10n:export.csv").Keywords(english.AsCsv).Disabled(true, t.NeedsPro)),
            BaletteCmd.New(t.DeleteFiles).Id("l10n:delete").Group(t.DangerZone).Keywords(english.DeleteFiles)
                .Destructive(t.ConfirmDelete)
                .Handler(_ => Task.FromResult(BaletteCommandResult.Toast(t.Deleted, keepOpen: true))),
        ];
    }
}
