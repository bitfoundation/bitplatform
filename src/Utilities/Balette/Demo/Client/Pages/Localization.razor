    /// <summary>Persian strings that announce the result count in Persian digits.</summary>
    private sealed class PersianStrings : BaletteStrings
    {
        public override string ResultsAnnouncementFor(int count) => count switch
        {
            0 => NoResultsAnnouncement,
            1 => OneResultAnnouncement,
            _ => Format(ResultsAnnouncement, PersianDigits(count)),
        };
    }

    private static string PersianDigits(int value)
        => string.Concat(value.ToString(CultureInfo.InvariantCulture).Select(c => char.IsAsciiDigit(c) ? (char)('۰' + (c - '0')) : c));

    // Every property of BaletteStrings, read through a delegate rather than reflection, which trimming would make unreliable.
    private static readonly (string Name, string Where, Func<BaletteStrings, string> Read)[] AllStrings =
