    private readonly List<string> _failures = [];
    private readonly List<IDisposable> _todos = [];
    private List<BaletteCommand> _pageCommands = [];
    private int _deploymentLoads;
    private int _todoCount;

    protected override void OnInitialized()
    {
        _pageCommands =
        [
            BaletteCmd.New("Generate report…").Group("This page").Keywords("slow", "busy", "long running")
                .Description("Takes three seconds: after 150 ms the palette shows it busy, and Esc cancels it.")
                .Handler(async ctx =>
                {
                    try
                    {
                        await Task.Delay(3000, ctx.CancellationToken);
                    }
                    catch (OperationCanceledException)
                    {
                        State.Record("Report cancelled");
                        throw;
                    }

                    State.Record("Report generated");
                    return BaletteCommandResult.Toast("Report ready", keepOpen: true);
                }),

            BaletteCmd.New("Sync with server").Group("This page").Keywords("refresh", "pull", "error")
                .Description("Fails with an exception whose text names a server and a user - which the palette does not show.")
                .Handler(async ctx =>
                {
                    await Task.Delay(300, ctx.CancellationToken);
                    throw new InvalidOperationException("Connection to db-prod-7.internal:5432 refused for user 'svc_sync'.");
                }),

            BaletteCmd.New("Publish release").Group("This page").Keywords("ship", "deploy", "error")
                .Description("Fails with a ValidationException, whose message this page shows as it is.")
                .Handler(async ctx =>
                {
                    await Task.Delay(300, ctx.CancellationToken);
                    throw new ValidationException("The changelog is empty: write one before publishing.");
                }),

            BaletteCmd.New("Recent deployments…").Group("This page").Keywords("releases", "history", "retry")
                .Description("A lazy page whose loader fails every other time, to show the error state and its retry.")
                .Children(async (ctx, ct) =>
                {
                    await Task.Delay(500, ct);
                    if (++_deploymentLoads % 2 == 1)
                    {
                        throw new HttpRequestException("503 Service Unavailable from deploy-api.internal");
                    }

                    return Deployments.Select(d => BaletteCmd.New($"{d.Version} to {d.Environment}")
                            .Subtitle(d.When)
                            .ExcludeFromHistory()
                            .Handler(_ => Task.FromResult(BaletteCommandResult.Toast($"Opened {d.Version} on {d.Environment}")))
                            .Build())
                        .ToList();
                }, placeholder: "Pick a deployment…"),

            BaletteCmd.New("Create webhook…").Group("This page").Keywords("hook", "integration", "events")
                .Description("A prompt, then a multi-select page the prompt's handler returns.")
                .Handler(_ => Task.FromResult(BaletteCommandResult.Prompt(
                    "Payload URL",
                    address => Task.FromResult(BaletteCommandResult.Page(
                        "Events to send",
                        [.. WebhookEvents.Select(e => BaletteCmd.New(e).Id($"event:{e}").Build())],
                        placeholder: "Check events, Ctrl+Enter to create…",
                        multiSelect: true,
                        onSubmit: picked =>
                        {
                            var events = picked.SelectedCommands.Select(c => c.Title).ToList();
                            if (events.Count == 0)
                            {
                                return Task.FromResult(BaletteCommandResult.Error("Pick at least one event."));
                            }

                            var url = address.PromptValue!.Trim();
                            State.Record($"Webhook to {url} for {string.Join(", ", events)}");
                            return Task.FromResult(BaletteCommandResult.Toast(events.Count == 1 ? "Webhook created for 1 event" : $"Webhook created for {events.Count} events"));
                        })),
                    validate: value => Uri.TryCreate(value.Trim(), UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps && uri.Host.Length > 0
                        ? null
                        : "Enter an https:// address.",
                    placeholder: "https://example.com/hooks/balette",
                    initialValue: "https://"))),

            BaletteCmd.New("Add a to-do…").Group("This page").Keywords("task", "todo", "note")
                .Description("A prompt that registers a command and answers Reset: back to the root, where the new to-do is listed ahead of every group.")
                .Handler(_ => Task.FromResult(BaletteCommandResult.Prompt(
                    "New to-do",
                    submit =>
                    {
                        AddTodo(submit.PromptValue!.Trim());
                        return Task.FromResult(BaletteCommandResult.Reset);
                    },
                    validate: value => value.Trim().Length == 0 ? "A to-do needs some text." : null,
                    placeholder: "What needs doing?"))),
        ];

        State.Changed += Refresh;
        History.Changed += Refresh;
        Palette.CommandFailed += OnCommandFailed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The history lives in localStorage, which is only reachable once the page runs in the browser.
        if (firstRender && RendererInfo.IsInteractive && !History.IsLoaded)
        {
            await History.EnsureLoadedAsync();
            StateHasChanged();
        }
    }

    /// <summary>
    /// A to-do is a command of its own, registered at runtime without a group so it is listed first on the root page.
    /// Running it completes it: it unregisters itself and the palette stays open on the list.
    /// </summary>
    private void AddTodo(string text)
    {
        var id = $"todo:{++_todoCount}";
        _todos.Add(Palette.Register(BaletteCmd.New(text)
            .Id(id)
            .Subtitle("To-do · Enter completes it")
            .Keywords("todo", "task")
            .ExcludeFromHistory()
            .Handler(_ =>
            {
                Palette.Unregister(id);
                State.Record($"Done: {text}");
                return Task.FromResult(BaletteCommandResult.KeepOpen);
            })));
        State.Record($"To-do added: {text}");
    }

    /// <summary>
    /// This page's own failing commands are reported here rather than logged; any other command's failure is left to the
    /// palette, which logs it.
    /// </summary>
    private void OnCommandFailed(object? sender, BaletteCommandErrorEventArgs e)
    {
        if (_pageCommands.All(c => c.Id != e.Command.Id))
        {
            return;
        }

        if (e.Exception is ValidationException)
        {
            e.Message = e.Exception.Message;
        }

        e.Handled = true;
        var shown = e.Command.Id == DeploymentsId ? "the page's error state, with Try again" : $"“{e.Message}”";
        _failures.Insert(0, $"{DateTime.Now:HH:mm:ss}  {e.Command.Title}: {e.Exception.GetType().Name} - shown as {shown}");
        if (_failures.Count > 8)
        {
            _failures.RemoveAt(_failures.Count - 1);
        }

        Refresh();
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= Refresh;
        History.Changed -= Refresh;
        Palette.CommandFailed -= OnCommandFailed;

        foreach (var todo in _todos)
        {
            todo.Dispose();
        }
    }
}
