@page "/modes"
@using System.Globalization
@implements IDisposable
@inject IBaletteService Palette
@inject BaletteOptions Options
@inject SourceLog SourceLog

<PageTitle>Modes and sources · Balette</PageTitle>

<div class="bb-intro">
    <h1>Modes &amp; sources</h1>
    <p class="bb-subtitle">
        A mode is a prefix typed at the start of the query - <code>&gt;</code> in VS Code, <code>#</code> on GitHub - that
        scopes the palette to part of the registry, to its own asynchronous sources, or both. A source is anything that
        answers a query later: an API, a database, a search index. The palette debounces it, cancels it when the query
        moves on, pages it, times it out, and merges what it returns.
    </p>
</div>

<PaletteBar />

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> The modes of this app</h3>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Prefix</th><th>Mode</th><th>Lists</th><th>Sources</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var mode in Palette.Modes)
                {
                    <tr>
                        <td class="bb-table-key"><code>@mode.Prefix</code></td>
                        <td>
                            <strong>@mode.Name</strong>
                            <div class="bb-soft demo-small">@mode.Description</div>
                        </td>
                        <td>@Scope(mode)</td>
                        <td>@(mode.Sources.Count == 0 ? "-" : string.Join(", ", mode.Sources.Select(s => s.Name)))</td>
                        <td class="bb-table-action"><button type="button" class="btn btn-secondary" @onclick="() => Palette.OpenAsync(mode.Prefix)">Open</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p>
        The first four are registered at startup, in <code>options.Modes</code>. <code>$</code> is this page's own:
        <code>Palette.RegisterMode</code> added it when the page opened, and disposing the handle it returned takes it away
        again when you leave. The active mode is shown as a chip next to the breadcrumbs, and on the empty query of the default
        mode every mode is listed as a hint under <em>Modes</em>, so they can be discovered without reading this page;
        picking a hint types its prefix.
    </p>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Property</th><th>What it does</th></tr>
            </thead>
            <tbody>
                <tr><td class="bb-table-key"><code>Prefix</code></td><td>What is typed at the start of the query. The longest matching prefix wins, so <code>&gt;&gt;</code> and <code>&gt;</code> can coexist.</td></tr>
                <tr><td class="bb-table-key"><code>Name</code> / <code>Description</code></td><td>The chip, and the hint's title and subtitle.</td></tr>
                <tr><td class="bb-table-key"><code>Placeholder</code></td><td>The search box's placeholder while the mode is active.</td></tr>
                <tr><td class="bb-table-key"><code>Tags</code></td><td>Only commands carrying one of these tags - <code>&gt;</code> lists those tagged <code>command</code>.</td></tr>
                <tr><td class="bb-table-key"><code>Groups</code></td><td>Only commands in these groups - <code>?</code> lists the Help group.</td></tr>
                <tr><td class="bb-table-key"><code>HideRegistryCommands</code></td><td>No registry commands at all, only the mode's sources - <code>#</code>, <code>@@</code> and <code>$</code>.</td></tr>
                <tr><td class="bb-table-key"><code>Sources</code></td><td>Asked in this mode, instead of the default mode's sources.</td></tr>
                <tr><td class="bb-table-key"><code>ShowHint</code></td><td>Whether the mode is listed under <em>Modes</em>; <code>options.ShowModeHints = false</code> drops the whole group.</td></tr>
            </tbody>
        </table>
    </div>
    <p>A mode scopes the registry and the sources; nested commands are never found from a mode.</p>
    <CodeBlock Language="csharp" Code="@ModeExample" />
</section>

<section class="bb-card" id="sources">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> The sources</h3>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Source</th><th>Asked in</th><th class="demo-num">From</th><th class="demo-num">At most</th><th>Order</th><th class="demo-num">Latency</th></tr>
            </thead>
            <tbody>
                @foreach (var (source, where) in AllSources())
                {
                    <tr>
                        <td class="bb-table-key">@source.Name</td>
                        <td>@where</td>
                        <td class="demo-num">@(source.MinQueryLength == 0 ? "empty box" : $"{source.MinQueryLength} char{(source.MinQueryLength == 1 ? "" : "s")}")</td>
                        <td class="demo-num">@source.MaxResults</td>
                        <td>@(source.ApplyMatcher ? "re-ranked with the registry" : "its own, as one block")</td>
                        <td class="demo-num">@(Latency.TryGetValue(source.Name, out var ms) ? $"{ms} ms" : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="bb-split">
        <div class="bb-card">
            <h4 class="demo-card-heading">Re-ranked</h4>
            <p class="bb-card-desc">
                With <code>ApplyMatcher</code> the palette scores what a source returns with its own matcher and sorts it in
                with everything else. The source only has to return candidates, and its rows are highlighted like the rest.
                <em>People</em> and <em>Documentation</em> work this way.
            </p>
        </div>
        <div class="bb-card">
            <h4 class="demo-card-heading">Ordered</h4>
            <p class="bb-card-desc">
                Without it - the default - the source's order is kept and its rows are listed as one block under its name,
                right for a server that already sorts by relevance. <em>Issues</em> puts open issues first, newest first, and
                asks on the empty query too (<code>MinQueryLength = 0</code>), so <code>#</code> opens on a list.
            </p>
        </div>
    </div>
    <p>
        Sources in <code>options.Sources</code> are asked in the default mode, and so are the ones registered at runtime with
        <code>Palette.RegisterSource</code> or resolved from DI with <code>services.AddBitBaletteSource&lt;TSource&gt;()</code>
        - those belong to the scope and stay registered whichever palette comes and goes. A mode asks its own
        <code>Sources</code> instead, and a command's page can ask one too (<code>.Source(...)</code>, see
        <a href="pages#navigating">nested pages</a>). Each search gets a <code>BaletteSourceContext</code>: the
        <code>ModePrefix</code>, the <code>ParentCommandId</code> of the page that asked, and the user's <code>Services</code>.
    </p>
    <CodeBlock Language="csharp" Code="@OrderedSourceExample" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Debounced and cancelled, live</h3>
    <p>
        Open the palette and type <code>@@ada lovelace</code> at your normal speed. The palette waits
        <strong>@Options.DebounceMs ms</strong> (<code>DebounceMs</code>) after the last keystroke before it asks a source, so
        most keystrokes never reach one; a search still running when the next one starts is cancelled through its token, so
        a slow API never shows stale results. A spinner replaces the search icon while any source is pending. Every call that
        did reach a source is listed here, newest first.
    </p>
    <CodeBlock Language="csharp" Code="@DebounceExample" />

    <div class="bb-demo">
        <div class="bb-demo-bar">
            <span class="bb-demo-label">Source calls</span>
            <button type="button" class="btn btn-secondary" disabled="@(SourceLog.Calls.Count == 0)" @onclick="SourceLog.Clear">Clear</button>
        </div>
        <div class="bb-try">
            <button type="button" class="btn btn-secondary" @onclick="@(() => Palette.OpenAsync("@"))">Open in People mode</button>
            <button type="button" class="btn btn-secondary" @onclick='() => Palette.OpenAsync("#")'>Open in Issues mode</button>
            <button type="button" class="btn btn-secondary" @onclick='() => Palette.OpenAsync("$")'>Open in Packages mode</button>
            <button type="button" class="btn btn-secondary" @onclick='() => Palette.OpenAsync("theming")'>Search "theming" (documentation)</button>
        </div>
        <div class="bb-scroll">
            <table class="bb-table">
                <thead>
                    <tr><th>Started</th><th>Source</th><th>Query</th><th>Outcome</th><th class="demo-num">Results</th><th class="demo-num">Took</th></tr>
                </thead>
                <tbody>
                    @if (SourceLog.Calls.Count == 0)
                    {
                        <tr><td colspan="6" class="bb-muted">No source has been asked yet.</td></tr>
                    }
                    @foreach (var call in SourceLog.Calls)
                    {
                        <tr>
                            <td class="bb-nowrap">@call.StartedAt.ToString("HH:mm:ss.fff")</td>
                            <td>@call.Source</td>
                            <td><code>@(call.Query.Length == 0 ? "(empty)" : call.Query)</code></td>
                            <td><span class="@OutcomeBadge(call.Outcome)">@call.Outcome</span></td>
                            <td class="demo-num">@(call.Outcome == SourceCallOutcome.Completed ? call.ResultCount.ToString() : "-")</td>
                            <td class="demo-num">@(call.Outcome == SourceCallOutcome.Running ? "-" : $"{call.Duration.TotalMilliseconds:0} ms")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<section class="bb-card" id="paging">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Paging</h3>
    <p>
        A source with more results than it should send at once answers through <code>SearchPageAsync(query, cursor, ...)</code>:
        the first page with a null <code>cursor</code>, each next one with the <code>NextCursor</code> of the page before. A
        page with a cursor gets a row after the source's results - "Show 50 more…" when the page says
        <code>TotalCount</code>, "Show more…" when it does not - which loads the next page, appends it without repeating
        what is listed, and selects its first row. A source that implements only <code>SearchAsync</code> answers one page.
    </p>
    <p>
        The <code>$</code> mode pages through @Packages.Length packages, @PageSize at a time, with a
        <code>BaletteDelegateSource</code> - the ready-made source over a delegate:
    </p>
    <CodeBlock Language="csharp" Code="@PagingExample" />
    <div class="bb-try">
        <button type="button" class="btn btn-secondary" @onclick='() => Palette.OpenAsync("$")'>Open in Packages mode</button>
        <button type="button" class="btn btn-secondary" @onclick='() => Palette.OpenAsync("$acme")'>Search <code>$acme</code></button>
    </div>
</section>

<section class="bb-card" id="failures">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-danger"></span> When a source fails</h3>
    <p>
        A source that throws, or that has not answered after <code>SourceTimeoutMs</code>
        (@(Options.SourceTimeoutMs == 0 ? "never" : $"{Options.SourceTimeoutMs / 1000.0:0.#} s") here) - whether or not it
        honours its token - is logged and leaves a row in place of its results, "Couldn’t search Service status" in the
        danger colour, which asks it again when chosen. The other sources' results stay: one failing API does not take the
        whole list with it. A next page that fails keeps the pages already listed, and its row to try again.
    </p>
    <p>
        This page registered a <em>Service status</em> source in the default mode with <code>Palette.RegisterSource</code>:
        <code>status</code> lists every service, and a service's name lists that one. Choose how it behaves, then search:
    </p>
    <div class="bb-segmented" role="group" aria-label="Service status source">
        @foreach (var (value, label) in StatusBehaviours)
        {
            <button type="button" aria-pressed="@(_statusBehaviour == value ? "true" : "false")" @onclick="() => _statusBehaviour = value">@label</button>
        }
    </div>
    <div class="bb-try">
        <button type="button" class="btn btn-secondary" @onclick='() => Palette.OpenAsync("status")'>Search "status"</button>
    </div>
    <p class="bb-muted demo-small">
        A source that hangs is cancelled through its token when the timeout passes, so the call log above shows it
        <em>Cancelled</em> while the palette offers to try again.
    </p>
    <CodeBlock Language="csharp" Code="@StatusExample" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Registering them</h3>
    <CodeBlock Language="csharp" Code="@RegistrationExample" />
    <p>
        <code>RegisterMode</code> and <code>RegisterSource</code> return a handle that removes what they added. This page's
        two are registered while it is on screen:
    </p>
    <div class="bb-try">
        <button type="button" class="btn btn-secondary" @onclick="ToggleRegistrations">@(_registered ? "Remove the $ mode and the status source" : "Register them again")</button>
    </div>
    <div class="bb-note">
        Two ready-made sources cover the common cases: <code>BaletteDelegateSource</code> wraps a delegate - single page or
        paged - and <code>BaletteStaticSource</code> serves a large in-memory list through the palette's matcher without
        registering thousands of commands (see <a href="performance">Large registry</a>).
    </div>
</section>

@code {
    private const int PageSize = 10;

    // Sixty packages: four vendors, fifteen areas.
    private static readonly string[] Packages =
    [
        .. from vendor in new[] { "Acme", "Contoso", "Fabrikam", "Northwind" }
           from area in new[] { "Core", "Http", "Json", "Logging", "Caching", "Auth", "Data", "Testing", "Blazor", "Grpc", "Metrics", "Search", "Storage", "Mail", "Queue" }
           select $"{vendor}.{area}"
    ];

    private static readonly (string Name, string State)[] ServiceStates =
    [
        ("API", "Operational"),
        ("Web app", "Operational"),
        ("Database", "Degraded performance"),
        ("Search index", "Operational"),
        ("E-mail delivery", "Operational"),
    ];

    private static readonly (string Value, string Label)[] StatusBehaviours =
    [
        ("answers", "Answers"),
        ("throws", "Throws"),
        ("hangs", "Never answers"),
    ];

    private const string ModeExample = """
        options.Modes.Add(new BaletteCommandMode
        {
            Prefix = ">",
            Name = "Commands",
            Description = "Run any command",
            Placeholder = "Run a command…",
            Tags = ["command"],            // only the commands tagged "command"
        });
        options.Modes.Add(new BaletteCommandMode { Prefix = "?", Name = "Help", Groups = ["Help"] });

        // At runtime, until the handle is disposed: this page's $ mode.
        _packagesMode = Palette.RegisterMode(new BaletteCommandMode
        {
            Prefix = "$",
            Name = "Packages",
            HideRegistryCommands = true,   // only its sources' rows
            Sources = [packages],
        });
        """;

    private const string OrderedSourceExample = """
        // Ordered: the server already sorts by relevance, so its order is kept and its rows are one block.
        public sealed class IssueSource(IssueClient issues) : IBaletteSource
        {
            public string Name => "Issues";
            public int MinQueryLength => 0;     // asked on the empty query too, so # opens on a list

            public async Task<IReadOnlyList<BaletteCommand>> SearchAsync(
                string query, BaletteSourceContext context, CancellationToken cancellationToken)
            {
                // context.ModePrefix is "#" here, and context.Services the user's scope.
                var found = await issues.SearchAsync(query, openFirst: true, cancellationToken);
                return [.. found.Select(i => BaletteCmd.New($"#{i.Number} {i.Title}").Subtitle(i.State).Build())];
            }
        }
        """;

    private const string DebounceExample = """
        options.DebounceMs = 150;   // the quiet time after the last keystroke before a source is asked

        public async Task<IReadOnlyList<BaletteCommand>> SearchAsync(
            string query, BaletteSourceContext context, CancellationToken cancellationToken)
        {
            // Cancelled when the next search starts: hand the token to whatever waits, and stale results never show.
            var people = await http.GetFromJsonAsync<Person[]>($"api/people?q={Uri.EscapeDataString(query)}", cancellationToken);
            return [.. people!.Select(p => BaletteCmd.New(p.Name).Subtitle(p.Role).Build())];
        }
        """;

    private const string PagingExample = """
        options.Modes.Add(new BaletteCommandMode
        {
            Prefix = "$",
            Name = "Packages",
            HideRegistryCommands = true,
            Sources =
            [
                new BaletteDelegateSource("Packages", async (query, cursor, context, ct) =>
                {
                    var page = await Api.SearchPackagesAsync(query, after: cursor, take: 10, ct);
                    return new BaletteSourcePage([.. page.Items.Select(ToCommand)], page.NextCursor, page.Total);
                }, minQueryLength: 0, maxResults: 10),
            ],
        });
        """;

    private const string StatusExample = """
        _status = Palette.RegisterSource(new StatusSource());   // asked in the default mode
        // ... and when the page goes:
        _status.Dispose();

        public sealed class StatusSource : IBaletteSource
        {
            public string Name => "Service status";             // its heading, and its retry row's text

            public async Task<IReadOnlyList<BaletteCommand>> SearchAsync(string query, BaletteSourceContext context, CancellationToken ct)
            {
                var services = await Api.GetStatusAsync(ct);     // throws, or never answers: a retry row
                return [.. services.Where(s => s.Name.Contains(query)).Select(ToCommand)];
            }
        }
        """;

    private const string RegistrationExample = """
        builder.Services.AddBitBaletteServices(options =>
        {
            options.Modes.Add(new BaletteCommandMode
            {
                Prefix = "@",
                Name = "People",
                Description = "Find a teammate",
                Placeholder = "Search people…",
                HideRegistryCommands = true,       // only the source's rows
                Sources = [new PeopleSource()],
            });

            options.Sources.Add(new DocsSource()); // also asked in the default mode
            options.DebounceMs = 150;              // quiet time before a source is asked
            options.SourceTimeoutMs = 10_000;      // 0 waits for ever
        });

        builder.Services.AddBitBaletteSource<OrdersSource>(); // a default-mode source resolved from DI

        public sealed class PeopleSource : IBaletteSource
        {
            public string Name => "People";        // the group heading of its results
            public int MinQueryLength => 1;        // 0 also asks on the empty query
            public int MaxResults => 20;
            public bool ApplyMatcher => true;      // re-rank with the palette's matcher

            public async Task<IReadOnlyList<BaletteCommand>> SearchAsync(
                string query, BaletteSourceContext context, CancellationToken cancellationToken)
            {
                var people = await context.Services.GetRequiredService<PeopleClient>()
                    .SearchAsync(query, cancellationToken);
                return [.. people.Select(p => BaletteCmd.New(p.Name).Subtitle(p.Role).Build())];
            }
        }
        """;

    // The delays the demo's sources simulate (Services/FakeData.cs and this page); nothing in IBaletteSource reports one.
    private static readonly Dictionary<string, int> Latency = new()
    {
        ["People"] = 250,
        ["Issues"] = 180,
        ["Documentation"] = 300,
        ["Packages"] = 200,
        ["Service status"] = 200,
    };

    private string _statusBehaviour = "answers";
    private IDisposable? _packagesMode;
    private IDisposable? _statusSource;
    private bool _registered;

    protected override void OnInitialized()
    {
        SourceLog.Changed += Refresh;
        Palette.CommandsChanged += Refresh;
        Register();
    }

    private void Register()
    {
        _packagesMode = Palette.RegisterMode(new BaletteCommandMode
        {
            Prefix = "$",
            Name = "Packages",
            Description = $"Browse {Packages.Length} packages, {PageSize} at a time",
            Placeholder = "Search packages…",
            HideRegistryCommands = true,
            Sources = [new BaletteDelegateSource("Packages", SearchPackagesAsync, minQueryLength: 0, maxResults: PageSize)],
        });
        _statusSource = Palette.RegisterSource(new StatusSource(SourceLog, () => _statusBehaviour));
        _registered = true;
    }

    private void ToggleRegistrations()
    {
        if (_registered)
        {
            _packagesMode?.Dispose();
            _statusSource?.Dispose();
            _registered = false;
        }
        else
        {
            Register();
        }
    }

    /// <summary>
    /// One page of the packages matching the query. The cursor is the offset of the page, which a real API would hand out
    /// as an opaque token; the total is how many matched, which the "Show 50 more…" row counts down from.
    /// </summary>
    private async Task<BaletteSourcePage> SearchPackagesAsync(string query, string? cursor, BaletteSourceContext context, CancellationToken cancellationToken)
    {
        var offset = int.TryParse(cursor, NumberStyles.None, CultureInfo.InvariantCulture, out var from) ? from : 0;
        var hits = Packages.Where(p => p.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
        var label = cursor is null ? query : $"{query} (page from #{offset + 1})";

        var commands = await SourceLog.TrackAsync("Packages", label, async ct =>
        {
            await Task.Delay(200, ct);
            return (IReadOnlyList<BaletteCommand>)[.. hits.Skip(offset).Take(PageSize).Select(name => BaletteCmd.New(name)
                .Id($"package:{name}")
                .Subtitle($"{2 + name.Length % 5}.{name.Length % 10}.0 · {(name.Length * 7919 % 900) + 100}k downloads")
                .Kind(BaletteCommandKind.Navigation)
                .Handler(_ => Task.FromResult(BaletteCommandResult.Toast($"Opened {name}")))
                .Build())];
        }, cancellationToken);

        var next = offset + PageSize < hits.Count ? (offset + PageSize).ToString(CultureInfo.InvariantCulture) : null;
        return new BaletteSourcePage(commands, next, hits.Count);
    }

    /// <summary>A default-mode source whose behaviour the page picks: it answers, throws, or never answers.</summary>
    private sealed class StatusSource(SourceLog log, Func<string> behaviour) : IBaletteSource
    {
        public string Name => "Service status";

        public Task<IReadOnlyList<BaletteCommand>> SearchAsync(string query, BaletteSourceContext context, CancellationToken cancellationToken)
            => log.TrackAsync(Name, query, async ct =>
            {
                switch (behaviour())
                {
                    case "throws":
                        await Task.Delay(200, ct);
                        throw new HttpRequestException("502 Bad Gateway from status.internal");
                    case "hangs":
                        // Honours its token, which the palette cancels when SourceTimeoutMs passes.
                        await Task.Delay(Timeout.Infinite, ct);
                        break;
                }

                // Like a status page: "status" lists every service, a service's name that one.
                await Task.Delay(200, ct);
                var everything = query.Contains("status", StringComparison.OrdinalIgnoreCase);
                return (IReadOnlyList<BaletteCommand>)[.. ServiceStates
                    .Where(s => everything || s.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
                    .Select(s => BaletteCmd.New(s.Name)
                        .Id($"status:{s.Name}")
                        .Subtitle(s.State)
                        .ExcludeFromHistory()
                        .Handler(_ => Task.FromResult(BaletteCommandResult.Toast($"{s.Name}: {s.State}", keepOpen: true)))
                        .Build())];
            }, cancellationToken);
    }

    private IEnumerable<(IBaletteSource Source, string Where)> AllSources()
    {
        foreach (var source in Palette.Sources)
        {
            yield return (source, "the default mode");
        }

        foreach (var mode in Palette.Modes)
        {
            foreach (var source in mode.Sources)
            {
                yield return (source, $"{mode.Prefix} {mode.Name}");
            }
        }
    }

    private static string OutcomeBadge(SourceCallOutcome outcome) => outcome switch
    {
        SourceCallOutcome.Completed => "bb-badge bb-badge-success",
        SourceCallOutcome.Cancelled => "bb-badge bb-badge-warn",
        SourceCallOutcome.Failed => "bb-badge bb-badge-danger",
        _ => "bb-badge",
    };

    private static string Scope(BaletteCommandMode mode)
    {
        if (mode.HideRegistryCommands)
        {
            return "only its sources";
        }

        if (mode.Tags is { Count: > 0 } tags)
        {
            return $"commands tagged {string.Join(", ", tags.Select(t => $"“{t}”"))}";
        }

        if (mode.Groups is { Count: > 0 } groups)
        {
            return $"the {string.Join(", ", groups)} group";
        }

        return "every command";
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SourceLog.Changed -= Refresh;
        Palette.CommandsChanged -= Refresh;
        _packagesMode?.Dispose();
        _statusSource?.Dispose();
    }
}
