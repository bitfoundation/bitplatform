    private static readonly BaletteKeyboardShortcut WordWrapShortcut = "Alt+Z";

    private static readonly string[] Files = ["README.md", "Program.cs", "App.razor", "site.css"];

    // Worked out by the library itself when the page renders, so the table cannot drift from what it does.
    private static readonly (string Built, BaletteCommand Command)[] IdentityExamples =
    [
        ("BaletteCmd.New(\"Settings\").Group(\"Navigation\")", BaletteCmd.New("Settings").Group("Navigation").Build()),
        ("BaletteCmd.New(\"Rename project…\").Group(\"Actions\")", BaletteCmd.New("Rename project…").Group("Actions").Build()),
        ("BaletteCmd.New(\"What's new\").Group(\"Help\")", BaletteCmd.New("What's new").Group("Help").Build()),
        ("BaletteCmd.New(\"Dark\").Parent(\"preferences.theme\")", BaletteCmd.New("Dark").Parent("preferences.theme").Build()),
        ("BaletteCmd.New(\"C#\")", BaletteCmd.New("C#").Build()),
        ("BaletteCmd.New(\"C++\")", BaletteCmd.New("C++").Build()),
        ("BaletteCmd.New(\"🚀\")", BaletteCmd.New("🚀").Build()),
        ("BaletteCmd.New(\"Word wrap\").Id(\"toggle:wordwrap\")", BaletteCmd.New("Word wrap").Id("toggle:wordwrap").Build()),
    ];

    private const string IncrementId = "this-page.increment-counter";
    private const string DecrementId = "this-page.decrement-counter";
    private const string ResetId = "this-page.reset-counter";
    private const string GreetingId = "this-page.say-hello";

    private IDisposable? _greeting;
    private int _count;
    private int _executed;
    private string? _lastExecuted;
    private readonly HashSet<string> _selected = [];
    private readonly List<string> _events = [];
    private List<BaletteCommand> _pageCommands = [];
    private List<BaletteCommand> _settingsCommands = [];

    protected override void OnInitialized()
    {
        // Icon takes a RenderFragment as well as a CSS class: any markup, here an inline SVG drawn in the row's colour.
        RenderFragment plus = @<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 3v10M3 8h10" /></svg>;
        RenderFragment minus = @<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10" /></svg>;

        _settingsCommands = SettingsCommands();
        _pageCommands =
        [
            BaletteCmd.New("Increment counter").Group("This page").Shortcut("Ctrl+Up").Keywords("plus", "add").Badge("0").Icon(plus)
                .Description("Registered by Pages/Commands.razor; gone when you leave the page.")
                .Handler(_ => Step(+1)),
            BaletteCmd.New("Decrement counter").Group("This page").Shortcut("Ctrl+Down").Keywords("minus", "subtract").Badge("0").Icon(minus)
                .Description("Registered by Pages/Commands.razor; gone when you leave the page.")
                .Handler(_ => Step(-1)),
            BaletteCmd.New("Reset counter").Group("This page").Keywords("zero", "clear")
                .Destructive("Reset the counter to zero?")
                .Disabled(true, ZeroReason)
                .Handler(_ =>
                {
                    SetCount(0);
                    return Task.FromResult(BaletteCommandResult.Close);
                }),
            BaletteCmd.New("Merge selected files").Group("This page").Shortcut("Alt+M").Keywords("combine", "join")
                .Description("Listed only while two or more files are selected on Pages/Commands.razor (VisibleWhen).")
                .VisibleWhen(() => _selected.Count >= 2)
                .Handler(_ =>
                {
                    var count = _selected.Count;
                    State.Record($"Merged {count} files");
                    _selected.Clear();
                    // The selection the predicate reads just changed: the shortcut is the page's again.
                    Palette.Refresh();
                    Refresh();
                    return Task.FromResult(BaletteCommandResult.Toast($"Merged {count} files"));
                }),
        ];

        State.Changed += OnStateChanged;
        Palette.CommandExecuted += OnExecuted;
        Palette.CommandsChanged += OnCommandsChanged;
        Palette.Opened += OnOpened;
        Palette.Closed += OnClosed;
    }

    private const string ZeroReason = "The counter is already at zero";

    private Task<BaletteCommandResult> Step(int delta)
    {
        SetCount(_count + delta);
        return Task.FromResult(BaletteCommandResult.KeepOpen);
    }

    private void SetCount(int count)
    {
        _count = count;
        State.Record($"Counter is now {_count}");

        // Commands are immutable, so a change is a copy - With keeps the id, the handler and the shortcut - and Update
        // swaps it in wherever it was registered. The registration BaletteCommands holds is edited in place, so disposing
        // it when the page goes still removes the copies.
        var badge = _count.ToString(CultureInfo.InvariantCulture);
        foreach (var id in (string[])[IncrementId, DecrementId])
        {
            if (Palette.Find(id) is { } command)
            {
                Palette.Update(command.With(b => b.Badge(badge)));
            }
        }

        if (Palette.Find(ResetId) is { } reset)
        {
            Palette.Update(reset.With(b => b.Disabled(_count == 0, _count == 0 ? ZeroReason : null)));
        }

        Refresh();
    }

    /// <summary>Registers a command from code, or disposes the handle that registration returned.</summary>
    private void ToggleGreeting()
    {
        if (_greeting is not null)
        {
            _greeting.Dispose();
            _greeting = null;
            return;
        }

        _greeting = Palette.Register(BaletteCmd.New("Say hello").Group("This page").Keywords("greet", "wave")
            .Description("Registered by a button on Pages/Commands.razor with Palette.Register; disposing the handle it returned removes it.")
            .Handler(_ => Task.FromResult(BaletteCommandResult.Toast("Hello!", keepOpen: true))));
    }

    private void ToggleFile(string file)
    {
        if (!_selected.Remove(file))
        {
            _selected.Add(file);
        }

        // VisibleWhen reads the selection: tell the palette, so Alt+M is claimed or released right away.
        Palette.Refresh();
    }

    private void OnExecuted(object? sender, BaletteCommandExecutedEventArgs e)
    {
        _executed++;
        _lastExecuted = e.Command.Title;
        var result = e.Result.GetType().Name.Replace("Result", string.Empty, StringComparison.Ordinal);
        Log($"CommandExecuted  {e.Command.Id} → {result} in {e.Duration.TotalMilliseconds:0} ms");
    }

    // The registry changes in bursts - a toggle swaps the app's whole list - so a run of them is one line.
    private void OnCommandsChanged()
    {
        if (_events.Count > 0 && _events[0].Contains("CommandsChanged", StringComparison.Ordinal))
        {
            _events.RemoveAt(0);
        }

        Log($"CommandsChanged  {Palette.Commands.Count} commands registered");
    }

    private void OnOpened() => Log("Opened");

    private void OnClosed() => Log("Closed");

    private void Log(string entry)
    {
        _events.Insert(0, $"{DateTime.Now:HH:mm:ss}  {entry}");
        if (_events.Count > 8)
        {
            _events.RemoveAt(_events.Count - 1);
        }

        Refresh();
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    // A new list for the inline palette, so its switches show the new state: it re-reads Commands when handed a new one.
    private void OnStateChanged() => _ = InvokeAsync(() =>
    {
        _settingsCommands = SettingsCommands();
        StateHasChanged();
    });

    private List<BaletteCommand> SettingsCommands() =>
    [
        BaletteCmd.New("Word wrap").Id("setting:wordwrap").Keywords("soft wrap lines").Checked(State.WordWrap)
            .Handler(_ => { State.ToggleWordWrap(); return Task.FromResult(BaletteCommandResult.KeepOpen); }),
        BaletteCmd.New("Desktop notifications").Id("setting:notifications").Keywords("alerts push").Checked(State.Notifications)
            .Handler(_ => { State.ToggleNotifications(); return Task.FromResult(BaletteCommandResult.KeepOpen); }),
        BaletteCmd.New("Show minimap").Id("setting:minimap").Keywords("outline overview").Checked(State.ShowMinimap)
            .Handler(_ => { State.ToggleMinimap(); return Task.FromResult(BaletteCommandResult.KeepOpen); }),
        .. new[] { "auto", "light", "dark" }.Select(theme => BaletteCmd.New($"Theme: {char.ToUpperInvariant(theme[0])}{theme[1..]}")
            .Id($"setting:theme-{theme}")
            .Keywords("appearance", "color scheme")
            .Checked(State.Theme == theme)
            .Handler(async _ => { await State.SetThemeAsync(theme); return BaletteCommandResult.KeepOpen; })
            .Build()),
    ];

    private Task OnThemeChanged(ChangeEventArgs e) => State.SetThemeAsync(e.Value?.ToString() ?? "auto");

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Palette.CommandExecuted -= OnExecuted;
        Palette.CommandsChanged -= OnCommandsChanged;
        Palette.Opened -= OnOpened;
        Palette.Closed -= OnClosed;
        _greeting?.Dispose();
    }
}
