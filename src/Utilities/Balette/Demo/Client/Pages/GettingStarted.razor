@page "/getting-started"
@inject IBaletteService Palette

<PageTitle>Getting started · Balette</PageTitle>

<div class="bb-intro">
    <h1>Getting started</h1>
    <p class="bb-subtitle">
        One package, one service registration, one stylesheet and one component: install Bit.Balette, register it, link
        its stylesheet, place the palette once in an interactively rendered layout, and register commands from anywhere.
        The bar below is this site's own palette - it is set up exactly like this.
    </p>
</div>

<PaletteBar />

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Install</h3>
    <pre class="bb-code">dotnet add package Bit.Balette</pre>
    <p>
        Everything ships in that one package, under one namespace, <code>Bit.Balette</code>. In a Blazor Web App with an
        interactive client, the package belongs in the <code>.Client</code> project, and the services are registered in
        both projects.
    </p>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Register the services</h3>
    <pre class="bb-code">@RegisterExample</pre>
    <p>
        The options are a singleton. The registry, the open state and the history are scoped: one per circuit on Blazor
        Server, one per application on WebAssembly. Every page of a Blazor Web App is prerendered on the server before it
        runs in the browser, so anything a component injects must resolve in both containers - share one extension
        method between the two <code>Program.cs</code> files, the way this demo does with <code>AddDemoServices</code>.
    </p>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Reference the stylesheet</h3>
    <pre class="bb-code">&lt;link rel="stylesheet" href="_content/Bit.Balette/bit-balette.css" /&gt;</pre>
    <p>
        In <code>App.razor</code> or <code>index.html</code>, before your own stylesheet, so your overrides of its
        <code>--bit-balette-*</code> variables win. It is a plain stylesheet with no dependencies, and it is not added for
        you: leave it out and set <code>Unstyled="true"</code> to style everything yourself. Add the namespace to
        <code>_Imports.razor</code> as well:
    </p>
    <pre class="bb-code">@@using Bit.Balette</pre>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Place the palette</h3>
    <p>
        Put one <code>Balette</code> where it is rendered interactively on every page, and a <code>BaletteTrigger</code>
        wherever a visible entry point helps:
    </p>
    <pre class="bb-code">@LayoutExample</pre>
    <p>
        The palette renders a closed <code>&lt;dialog&gt;</code> until it is opened, so it costs nothing while it is not in
        use. It needs an interactive render mode: a statically rendered palette never attaches its keyboard handling.
        This site renders it from <code>Components/AppPalette.razor</code>, which <code>Routes.razor</code> puts next to
        the router so the one palette outlives every page and layout.
    </p>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Register commands</h3>
    <p>Inject <code>IBaletteService</code> wherever commands belong and register them:</p>
    <pre class="bb-code">@CommandsExample</pre>
    <p>
        <code>Register</code> returns an <code>IDisposable</code>: dispose it to remove the commands again. Commands that
        belong to the whole app are registered once, from the layout or at startup through <code>options.Commands</code>;
        <code>&lt;BaletteCommands Commands="_commands" /&gt;</code> registers a list while it is rendered and removes it
        when it goes.
    </p>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Open it</h3>
    <p>
        <kbd>Ctrl</kbd> <kbd>K</kbd> (<kbd>⌘</kbd> <kbd>K</kbd> on a Mac) toggles the palette. Code opens it through the
        service, optionally with a query - a mode prefix included - or directly on a command's page:
    </p>
    <pre class="bb-code">@OpenExample</pre>
    <div class="bb-try">
        <button type="button" class="btn btn-secondary" @onclick="() => Palette.OpenAsync()">Open the palette</button>
        <button type="button" class="btn btn-secondary" @onclick='() => Palette.OpenAsync(">")'>Commands mode</button>
        <button type="button" class="btn btn-secondary" @onclick='() => Palette.OpenAsync(pageCommandId: "preferences.theme")'>Straight to the Theme page</button>
    </div>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Things to try</h3>
    <p>Every one of these runs on the palette of this site, right now:</p>
    <ul class="bb-detail-list">
        <li>Type <code>rc</code> - fuzzy matching jumps to <em>Registering commands</em>, with the word starts highlighted.</li>
        <li>Type <code>theme</code> and press <kbd>Enter</kbd> - a nested page; <kbd>Backspace</kbd> on an empty box goes back.</li>
        <li>Type <code>&gt;</code> for commands only, <code>#105</code> to look up an issue, <code>@@ada</code> to search people (async).</li>
        <li>Type <code>doc theming</code> - both terms must match, and the async documentation source answers too.</li>
        <li>Pick <em>Set labels…</em> - a multi-select page; <kbd>Ctrl</kbd> <kbd>Enter</kbd> applies.</li>
        <li>Pick <em>Rename project…</em> - a free-text prompt step.</li>
        <li>Pick <em>Delete project</em> - destructive, so it needs a second <kbd>Enter</kbd>.</li>
        <li>Press <kbd>Tab</kbd> on any row - the action panel: pin, forget, and the row's own actions.</li>
        <li>Close the palette and press <kbd>G</kbd> then <kbd>S</kbd> - a sequence shortcut opens the settings.</li>
        <li>Try the operators <code>'exact</code>, <code>^prefix</code>, <code>suffix$</code> and <code>!exclude</code>.</li>
    </ul>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> How it is built</h3>
    <pre class="bb-code">Key press (browser)
  -&gt; bit-balette.js     toggle, global chords and G-then-X sequences, navigation keys
  -&gt; Balette            query, mode prefix, page stack, active row     (C#)
  -&gt; IBaletteMatcher    fzf-style score and highlight positions per field
  -&gt; BaletteRanker      score + priority + frecency, the best MaxResults kept
  -&gt; rows               groups, pinned, recents, async source blocks
  -&gt; &lt;dialog&gt;          native top layer, focus trap, aria-activedescendant</pre>
    <p>
        The browser layer is small on purpose: it decides which keys belong to the palette and hands them over. What
        matches, in which order, what <kbd>Enter</kbd> does and which page comes next are all decided in C#, so they can be
        unit tested, replaced (<code>IBaletteMatcher</code>, <code>IBaletteHistoryStore</code>, <code>IBaletteSource</code>)
        and reasoned about like the rest of the app.
    </p>
    <div class="bb-note">
        This site runs on WebAssembly, so the whole search runs in the browser next to the list it fills. The same
        component works on Blazor Server, where a keystroke is one round trip; it searches synchronously there instead of
        deferring to the next frame, because the network already separates typing from rendering.
    </div>
</section>

@code {
    private const string RegisterExample = """
        builder.Services.AddBitBaletteServices(options =>
        {
            // Ctrl+K / ⌘K is the default; this adds VS Code's Ctrl+Shift+P as well.
            options.AdditionalToggleShortcuts.Add("Mod+Shift+P");

            // Groups appear in this order on the empty query; any others follow alphabetically.
            options.GroupOrder.AddRange(["Navigation", "Actions", "Preferences", "Help"]);
        });
        """;

    private const string LayoutExample = """
        @inherits LayoutComponentBase

        <header>
            <BaletteTrigger Label="Search…" />
        </header>

        <main>@Body</main>

        <Balette />
        """;

    private const string CommandsExample = """
        @inject IBaletteService Palette
        @implements IDisposable

        @code {
            private IDisposable? _commands;

            protected override void OnInitialized()
            {
                _commands = Palette.Register(
                    BaletteCmd.Navigate("Home", "/").Group("Navigation").Shortcut("G H"),
                    BaletteCmd.Navigate("Settings", "/settings").Group("Navigation").Shortcut("G S").Keywords("preferences", "options"),
                    BaletteCmd.Action("Toggle sidebar", () => _sidebarOpen = !_sidebarOpen).Group("View").Shortcut("Mod+B"),
                    BaletteCmd.New("Delete project")
                        .Group("Danger zone")
                        .Destructive("This cannot be undone")
                        .Handler(async ctx =>
                        {
                            await Api.DeleteProjectAsync(ctx.CancellationToken);
                            return BaletteCommandResult.Toast("Project deleted");
                        }));
            }

            // Commands registered by a page leave with the page.
            public void Dispose() => _commands?.Dispose();
        }
        """;

    private const string OpenExample = """
        await Palette.OpenAsync();
        await Palette.OpenAsync(">");                                // commands mode
        await Palette.OpenAsync(pageCommandId: "preferences.theme"); // straight to the Theme page
        await Palette.ExecuteAsync("navigation.settings");          // run a command without opening anything
        """;
}
