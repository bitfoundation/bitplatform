<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.Bcrdt</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
        <Description>Real-time collaborative editing for .NET and Blazor, written natively in C#: a YATA-based CRDT engine (text, arrays, maps and sets), a synchronization protocol with jittered reconnection, presence and awareness, offline-first persistence, selective undo, input bindings and the in-memory and WebSocket transports - with no JavaScript CRDT library and no interop in the engine. Includes the Blazor components: BcrdtComponentBase, which marshals change notifications onto the renderer and coalesces them onto a frame budget; BcrdtCollaborationScope, which opens and closes a document for its content; BcrdtTextArea, a textarea that edits a collaborative text without losing keystrokes; and BcrdtPresenceView. Works in Blazor WebAssembly, Server, Web App and Hybrid.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;CRDT;Collaboration;Realtime;YATA;Offline-first;Presence;Undo;Sync;Collaborative editing</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <!-- Floating low-bound version ranges so consumers can pin to any patch release on their TFM;
             the upper bound keeps a major-version package that targets a newer TFM out. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[11.0.0-rc.1.26425.128,12.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[11.0.0-rc.1.26425.128,12.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Diagnostics.CodeAnalysis" />
        <Using Include="System.Runtime.CompilerServices" />
    </ItemGroup>

    <ItemGroup>
        <!-- The WebSocket relay reuses the client transport's message framing. -->
        <InternalsVisibleTo Include="Bit.Bcrdt.Server" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bcrdt.Server" PublicKey="" />
        <!-- The simulator and the update corrupter work on the engine's blocks and wire format directly. -->
        <InternalsVisibleTo Include="Bit.Bcrdt.Testing" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bcrdt.Testing" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bcrdt.Tests" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bcrdt.Benchmarks" PublicKey="" />
    </ItemGroup>

    <!-- Keep the build inputs (tsconfig + package manifests) out of the published static web
         assets while still showing them in the project. -->
    <ItemGroup>
        <Content Remove="package*.json;tsconfig.json" />
        <None Include="package*.json;tsconfig.json" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="Scripts\**\*.ts" />
    </ItemGroup>

    <!-- Restores npm packages then compiles the TypeScript into wwwroot. Both sub-targets are
         incremental via their Inputs/Outputs, so this is a no-op when nothing changed. -->
    <Target Name="BuildBcrdtJavaScript" DependsOnTargets="InstallNodejsDependencies;BuildJavaScript" />

    <!-- The output (wwwroot/bit-bcrdt.js) is a generated, git-ignored file. On a clean build it does
         not exist when the default "wwwroot/**" Content glob is evaluated, so the static web asset
         discovery in ResolveProjectStaticWebAssets would miss it and consumers would get a 404 for
         _content/Bit.Bcrdt/bit-bcrdt.js. Hooking BeforeTargets="ResolveProjectStaticWebAssets"
         guarantees it is generated first and then explicitly added to @(Content); the
         Remove-before-Include keeps it to a single Content entry. -->
    <Target Name="IncludeBcrdtJavaScriptAsStaticWebAsset"
            BeforeTargets="ResolveProjectStaticWebAssets"
            DependsOnTargets="BuildBcrdtJavaScriptOnce">
        <ItemGroup>
            <Content Remove="wwwroot\bit-bcrdt.js" />
            <Content Include="wwwroot\bit-bcrdt.js" />
        </ItemGroup>
    </Target>

    <!-- Runs BuildBcrdtJavaScript through the MSBuild task with TargetFramework removed, so every
         per-TFM build asks for the same project configuration and MSBuild runs tsc/esbuild once:
         a ProjectReference builds this project's inner builds directly (one per referencing target
         framework, in parallel) without the outer build, so calling the target from each inner
         build would race on the same wwwroot file ("EBUSY: resource busy or locked"). -->
    <Target Name="BuildBcrdtJavaScriptOnce">
        <MSBuild Projects="$(MSBuildProjectFullPath)"
                 Targets="BuildBcrdtJavaScript"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
    </Target>

    <!-- In a multi-targeted build, produce the output exactly once in the outer (cross-targeting)
         build, before the per-TFM inner builds are dispatched. -->
    <Target Name="BuildBcrdtJavaScriptOnCrossTargeting"
            BeforeTargets="DispatchToInnerBuilds"
            Condition="'$(IsCrossTargetingBuild)' == 'true'"
            DependsOnTargets="BuildBcrdtJavaScript" />

    <!-- `npm ci` installs exactly what the checked-in package-lock.json pins, and fails fast when the
         lockfile and package.json drift instead of silently rewriting the lock. -->
    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm ci" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <!-- Release minifies into the same file Debug writes unminified, so the sources alone cannot drive
         the up-to-date check: a per-configuration stamp in obj/ makes switching configurations
         invalidate it, and the stale stamp of the other configuration is deleted so switching back
         rebuilds too. The minified output is written to a temp file and moved into place, so an
         interrupted run cannot leave a half-written module that looks up to date. -->
    <Target Name="BuildJavaScript"
            Inputs="@(TypeScriptFiles);tsconfig.json"
            Outputs="wwwroot/bit-bcrdt.js;$(BaseIntermediateOutputPath)bit-bcrdt.js.$(Configuration).stamp">
        <ItemGroup>
            <_BcrdtStaleJsStamps Include="$(BaseIntermediateOutputPath)bit-bcrdt.js.*.stamp" />
        </ItemGroup>
        <Delete Files="@(_BcrdtStaleJsStamps)" />
        <Exec Command="node_modules/.bin/tsc" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Exec Condition=" '$(Configuration)' == 'Release' " Command="node_modules/.bin/esbuild wwwroot/bit-bcrdt.js --minify --format=esm --target=es2019 --outfile=wwwroot/bit-bcrdt.min.js" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Move Condition=" '$(Configuration)' == 'Release' " SourceFiles="wwwroot/bit-bcrdt.min.js" DestinationFiles="wwwroot/bit-bcrdt.js" OverwriteReadOnlyFiles="true" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)" />
        <Touch Files="$(BaseIntermediateOutputPath)bit-bcrdt.js.$(Configuration).stamp" AlwaysCreate="true" />
    </Target>

</Project>
