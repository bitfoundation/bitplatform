<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>Bit.Bcrdt</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <Description>Real-time collaborative editing for .NET and Blazor, written natively in C#: a YATA-based CRDT engine (text, arrays, maps and sets), a synchronization protocol with jittered reconnection, presence and awareness, offline-first persistence, selective undo, input bindings and the in-memory and WebSocket transports - with no JavaScript CRDT library and no interop in the engine.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;CRDT;Collaboration;Realtime;YATA;Offline-first;Presence;Undo;Sync</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- Floating low-bound version ranges so consumers can pin to any patch release on their TFM;
             the upper bound keeps a major-version package that targets a newer TFM out. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.0,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.0,11.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Diagnostics.CodeAnalysis" />
        <Using Include="System.Runtime.CompilerServices" />
    </ItemGroup>

    <ItemGroup>
        <!-- The WebSocket relay reuses the client transport's message framing. -->
        <InternalsVisibleTo Include="Bit.Bcrdt.Server" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bcrdt.Server" PublicKey="" />
        <!-- The simulator and the update corrupter work on the engine's blocks and wire format directly. -->
        <InternalsVisibleTo Include="Bit.Bcrdt.Testing" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bcrdt.Testing" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bcrdt.Tests" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bcrdt.Benchmarks" PublicKey="" />
    </ItemGroup>

</Project>
