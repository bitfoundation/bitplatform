@namespace Bit.Bcrdt.Blazor
@inherits BcrdtComponentBase

@if (Document is not null)
{
    @* Keyed on the document, so switching documents recreates the subtree: nothing rendered for the
       previous document - a component holding its text, a cascaded reference - survives into the next. *@
    <CascadingValue Value="Document" IsFixed="true" @key="Document">
        @ChildContent(Document)
    </CascadingValue>
}
else if (_openFailure is not null && ErrorContent is not null)
{
    @ErrorContent(_openFailure)
}
else if (LoadingContent is not null)
{
    @LoadingContent
}

@code {
    private readonly List<IDisposable> _documentSubscriptions = [];
    private Exception? _openFailure;
    private string? _requestedId;
    private string? _heldId;
    private int _generation;
    private bool _isDisposed;

    /// <summary>The document to open. Changing it closes the current document and opens the new one.</summary>
    [Parameter, EditorRequired]
    public string DocumentId { get; set; } = default!;

    /// <summary>Who the local participant is, published as soon as the document opens.</summary>
    [Parameter]
    public BcrdtCollaboratorInfo? User { get; set; }

    /// <summary>Rendered once the document is open, with the document as context.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<BcrdtCollaborativeDocument> ChildContent { get; set; } = default!;

    /// <summary>
    /// Rendered while the document is being opened - and while the page is being prerendered, because a
    /// document is opened only once the component is interactive.
    /// </summary>
    [Parameter]
    public RenderFragment? LoadingContent { get; set; }

    /// <summary>
    /// Rendered with the failure if the document cannot be opened - its store failed to load it, say.
    /// Without it the failure is thrown, for an error boundary to catch. Changing <see cref="DocumentId"/>
    /// tries again.
    /// </summary>
    [Parameter]
    public RenderFragment<Exception>? ErrorContent { get; set; }

    /// <summary>Invoked once the document is open.</summary>
    [Parameter]
    public EventCallback<BcrdtCollaborativeDocument> OnOpened { get; set; }

    /// <summary>The open document, or null while it is still opening.</summary>
    public BcrdtCollaborativeDocument? Document { get; private set; }

    protected override Task OnParametersSetAsync()
    {
        // A prerendered page belongs to a request that is over as soon as it is sent: a document opened
        // now would connect, publish a presence nobody will ever withdraw, and - backed by a browser
        // store - fail outright, because there is no browser yet. The interactive render opens it.
        if (!IsInteractive) return Task.CompletedTask;

        // A failure kept for ErrorContent that has since been taken away is thrown, as it would have been
        // without it, and the attempt forgotten so the same identifier can be retried.
        if (_openFailure is not null && ErrorContent is null && string.Equals(_requestedId, DocumentId, StringComparison.Ordinal))
        {
            Exception failure = _openFailure;
            _openFailure = null;
            _requestedId = null;
            return Task.FromException(failure);
        }

        return FollowDocumentIdAsync();
    }

    private async Task FollowDocumentIdAsync()
    {
        if (string.Equals(_requestedId, DocumentId, StringComparison.Ordinal)) return;

        // Parameters can change again while an earlier open is still in flight. Each pass takes a
        // generation; a pass that has been overtaken releases what it opened and stands down.
        int generation = ++_generation;
        _requestedId = DocumentId;

        // Stop rendering the previous document before it is closed, so nothing can edit it while it
        // is being torn down, and release the subscriptions that would otherwise keep it reachable.
        string? held = _heldId;
        _heldId = null;
        Document = null;
        _openFailure = null;
        ReleaseDocumentSubscriptions();

        // Release a reference rather than force a close: another scope may share the document.
        if (held is not null) await Collaboration.CloseAsync(held);
        if (generation != _generation || _isDisposed) return;

        BcrdtCollaborativeDocument opened;
        try
        {
            opened = await Collaboration.OpenAsync(DocumentId, new BcrdtOpenDocumentOptions { User = User });
        }
        catch (Exception) when (generation != _generation || _isDisposed)
        {
            // Overtaken by a newer identifier, or disposed, while opening: the failure belongs to a
            // document nobody is waiting for any more. Rethrowing it would fail the component - in
            // Blazor Server, the whole circuit - over something already irrelevant.
            return;
        }
        catch (Exception ex) when (ErrorContent is not null)
        {
            // Shown in place of the content. The identifier stays requested, so the failure is not
            // retried on every render; changing it tries again.
            _openFailure = ex;
            return;
        }
        catch
        {
            // Forget the attempt, so the same identifier can be retried rather than ignored forever.
            _requestedId = null;
            throw;
        }

        if (generation != _generation || _isDisposed)
        {
            await Collaboration.CloseAsync(opened.Id);
            return;
        }

        _heldId = opened.Id;
        Document = opened;

        _documentSubscriptions.Add(Track(opened));
        _documentSubscriptions.Add(Track(opened.Presence));
        if (opened.Sync is not null) _documentSubscriptions.Add(Track(opened.Sync));

        if (OnOpened.HasDelegate) await OnOpened.InvokeAsync(opened);
    }

    private void ReleaseDocumentSubscriptions()
    {
        foreach (IDisposable subscription in _documentSubscriptions) subscription.Dispose();
        _documentSubscriptions.Clear();
    }

    public override async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;
        _generation++;

        ReleaseDocumentSubscriptions();
        await base.DisposeAsync();

        // Closing here rather than leaving it to the service means a component that navigates away
        // stops consuming a connection immediately, instead of when the circuit eventually ends. An
        // open still in flight releases its own reference when it completes.
        string? held = _heldId;
        _heldId = null;
        Document = null;
        if (held is not null) await Collaboration.CloseAsync(held);
    }
}
