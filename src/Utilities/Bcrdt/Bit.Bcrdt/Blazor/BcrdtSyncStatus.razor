@namespace Bit.Bcrdt.Blazor
@inherits BcrdtComponentBase
@using System.Globalization

@if (_snapshot is null)
{
    @* No document yet - a scope still opening it, say. Nothing is said rather than a guess. *@
}
else if (ChildContent is not null)
{
    @ChildContent(_snapshot)
}
else
{
    <span class="@Class" data-status="@StatusName(_snapshot)"
          style="display:inline-flex;align-items:center;flex-wrap:wrap;column-gap:.6em;row-gap:.3em">
        @* The live region holds the words only: a button inside it would be announced with every change of its label.
           The words carry the whole state, so the colour is never the only signal. *@
        <span role="status" aria-live="polite" aria-atomic="true"
              title="@(_snapshot.IsLocalOnly ? "No transport is configured: the document is kept on this device only." : null)"
              style="display:inline-flex;align-items:center;column-gap:.4em">
            <span aria-hidden="true" style="@DotStyle(_snapshot)"></span>
            <span>@Describe(_snapshot, CultureInfo.CurrentCulture)</span>
        </span>
        @if (ShowToggle && _snapshot.HasTransport && RendererInfo.IsInteractive)
        {
            @* aria-disabled rather than disabled while a toggle is in flight: disabling a button drops the keyboard
               focus that pressed it. *@
            <button type="button" class="@ToggleClass" aria-disabled="@(_toggling ? "true" : null)" @onclick="ToggleAsync">
                @(_snapshot.IsOffline ? "Go online" : "Go offline")
            </button>
        }
    </span>
}
