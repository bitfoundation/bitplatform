<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>preview</LangVersion>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Signed with the repository key: Bit.Bcrdt exposes its internals (the search marker cache, the WebSocket
             transport's live socket) to this assembly by its public key. -->
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\..\..\AssemblyOriginatorKeyFile.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.5.1" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Bcrdt\Bit.Bcrdt.csproj" />
        <ProjectReference Include="..\..\Bit.Bcrdt.SignalR\Bit.Bcrdt.SignalR.csproj" />
        <ProjectReference Include="..\..\Bit.Bcrdt.Server\Bit.Bcrdt.Server.csproj" />
        <ProjectReference Include="..\..\Bit.Bcrdt.Testing\Bit.Bcrdt.Testing.csproj" />
    </ItemGroup>

    <!-- The demo client is a Blazor WebAssembly app and only targets net11.0, so the tests of its replica
         plumbing and conflict lab run on that target framework alone. -->
    <ItemGroup Condition=" '$(TargetFramework)' == 'net11.0' ">
        <ProjectReference Include="..\..\Demo\Client\Bit.Bcrdt.Demo.Client.csproj" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' != 'net11.0' ">
        <Compile Remove="DemoTests.cs" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
        <Using Include="Bit.Bcrdt" />
        <Using Include="Bit.Bcrdt.Testing" />
    </ItemGroup>

</Project>
