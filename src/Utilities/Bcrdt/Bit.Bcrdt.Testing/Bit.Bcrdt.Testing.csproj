<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>Bit.Bcrdt.Testing</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Runs in test hosts, never in a trimmed or native AOT app: the convergence harness reflects over root
             kinds and serializes projections to describe a divergence. -->
        <IsAotCompatible>false</IsAotCompatible>
        <Description>Test support for bit Bcrdt: a deterministic, seeded network simulator with loss, duplication, reordering, partitions and offline peers; random operation generators; a convergence harness; and an update corrupter for fuzzing the wire format. Framework-neutral, so it works with MSTest, xUnit or NUnit.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>$(PackageTags);CRDT;Collaboration;Testing;Simulation;Fuzzing</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Bcrdt\Bit.Bcrdt.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Bit.Bcrdt" />
    </ItemGroup>

</Project>
