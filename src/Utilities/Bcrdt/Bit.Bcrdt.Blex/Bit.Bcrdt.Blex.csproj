<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.Bcrdt.Blex</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <Description>Collaborative state for bit Bcrdt and bit Blex: a Blex store whose state is an immutable projection of a Bcrdt document subtree, whose actions are tagged Bcrdt transactions, and which dispatches collaborators' changes as actions, so selectors, subscriptions, middleware and DevTools see them.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;CRDT;Collaboration;Realtime;State management;Blex</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Bcrdt\Bit.Bcrdt.csproj" />
        <ProjectReference Include="..\..\Blex\Bit.Blex\Bit.Blex.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Bit.Bcrdt" />
        <Using Include="Bit.Blex" />
    </ItemGroup>

</Project>
