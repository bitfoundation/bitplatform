<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.Bcrdt.BlazeDb</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <Description>A bit Bcrdt document store on top of bit BlazeDb, so an application already on BlazeDb keeps its collaborative documents in the same database - persisted to OPFS or IndexedDB in Blazor WebAssembly, or to files on the server, the desktop and MAUI - with atomic compaction and no separate storage to manage.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;CRDT;Collaboration;Offline-first;BlazeDb;OPFS;Database</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Bcrdt\Bit.Bcrdt.csproj" />
        <ProjectReference Include="..\..\BlazeDb\Bit.BlazeDb\Bit.BlazeDb.csproj" />
        <!-- The table type is a [BlazeDbTable] class, so the generator runs here as it does in an application; the
             Bit.BlazeDb package carries it for consumers, so it adds no package dependency of its own. -->
        <ProjectReference Include="..\..\BlazeDb\Bit.BlazeDb.Generators\Bit.BlazeDb.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.Bcrdt.Tests" PublicKey="" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Bit.Bcrdt" />
        <Using Include="Bit.BlazeDb" />
    </ItemGroup>

</Project>
