@* The router waits for OnNavigateAsync before it renders a page, so Bit.Bcrdt.wasm is there before the notes render.
   This file renders before the assembly is downloaded, so it may not use Bcrdt's types itself. The server prerenders
   it too: it registers LazyAssemblyLoader for that (its Program.cs), and does not set the switch, as it loads Bcrdt
   with the rest of the app. *@
@using Microsoft.AspNetCore.Components.WebAssembly.Services
@inject LazyAssemblyLoader LazyAssemblyLoader

<Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Set only where Bit.Bcrdt.wasm is marked (the project file): loading an assembly that is not marked throws.
    private static readonly bool LazyLoadsBcrdt = AppContext.TryGetSwitch("Bit.Bcrdt.Samples.Lazy.LazyLoadsBcrdt", out var on) && on;

    private async Task OnNavigateAsync(NavigationContext context)
    {
        // The pages that collaborate: fetch Bcrdt before they render. A second call loads nothing again.
        if (LazyLoadsBcrdt && IsNotesPage(context.Path))
            await LazyAssemblyLoader.LoadAssembliesAsync(["Bit.Bcrdt.wasm"]);
    }

    // /notes and the rooms beneath it (routes match regardless of case), but not /notes-archive. The path keeps any
    // query and fragment.
    private static bool IsNotesPage(string path)
    {
        path = path.Split('?', '#')[0];
        return path.Equals("notes", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("notes/", StringComparison.OrdinalIgnoreCase);
    }
}
