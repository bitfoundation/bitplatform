@inherits LayoutComponentBase

@* Every page shares this layout, so it renders before Bit.Bcrdt.wasm is downloaded and may not use Bcrdt's types.
   data-interactive turns true once the page runs in the browser; the end-to-end tests wait for it. *@
<div class="page" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    <nav class="topbar">
        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink href="notes">Notes</NavLink>
    </nav>

    <main>
        @Body
    </main>
</div>
