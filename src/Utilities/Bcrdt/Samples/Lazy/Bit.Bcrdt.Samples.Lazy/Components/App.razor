<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Bcrdt lazy loading sample</title>
    @* An empty icon, so the browser does not ask for a /favicon.ico the sample does not have. *@
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    @* The router runs in the browser, where its OnNavigateAsync downloads Bit.Bcrdt.wasm before the notes render. *@
    <Routes @rendermode="InteractiveWebAssembly" />
    @* No script tag for Bcrdt: BcrdtTextArea imports its one small module itself, on demand. *@
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
