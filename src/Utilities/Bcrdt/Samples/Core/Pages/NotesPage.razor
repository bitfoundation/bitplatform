@page "/notes"
@inherits BcrdtComponentBase
@inject SampleSession Session

<PageTitle>Notes - Bcrdt samples</PageTitle>

<h1>Notes</h1>

<BcrdtCollaborationScope DocumentId="samples-notes" User="Session.User" OnOpened="Opened" Context="document">
    @* Shown while the page is prerendered and while the document opens. *@
    <LoadingContent>
        <p class="muted">Opening the document…</p>
    </LoadingContent>
    <ErrorContent Context="error">
        <p class="error">The document could not be opened: @error.Message</p>
    </ErrorContent>
    <ChildContent>
        <DocumentStatus />

        @* Turns each keystroke into the minimal edit, keeps the caret on its character while somebody types above it,
           and publishes the caret through presence. *@
        <BcrdtTextArea Text="@document.Text("body")" Presence="document.Presence" Field="body" Rows="12"
                       Placeholder="Type here, then open this page in another tab." />

        @* An undo is an edit like any other, and the server drops what a read-only replica writes. *@
        <div class="row">
            <button type="button" disabled="@(document.IsReadOnly || _undo is not { CanUndo: true })" @onclick="Undo">Undo</button>
            <button type="button" disabled="@(document.IsReadOnly || _undo is not { CanRedo: true })" @onclick="Redo">Redo</button>
            <span class="muted">@document.Text("body").Count characters</span>
        </div>
    </ChildContent>
</BcrdtCollaborationScope>

@code {
    private BcrdtUndoManager? _undo;

    // Called for every document the scope opens, so the stack of the one before is let go first.
    private void Opened(BcrdtCollaborativeDocument document)
    {
        Unfollow();

        // The document's own stack (BcrdtCollaborationOptions.CreateUndoManager), which already covers "body": Text()
        // adds the root it returns to that stack's scope. A stack of the page's own would capture every keystroke twice.
        // Selective undo: the stack captures this replica's own edits only, never the updates that arrive from peers,
        // so undoing never takes away somebody else's work.
        _undo = document.Undo;
        if (_undo is null) return;

        // The buttons follow the stack, not only the document. RequestRender renders once the edit is over, coalesced.
        _undo.StackItemAdded += OnStackChanged;
        _undo.StackItemUpdated += OnStackChanged;
        _undo.StackItemPopped += OnStackChanged;
    }

    private void OnStackChanged(BcrdtUndoStackEventArgs _) => RequestRender();

    // The stack belongs to the document, which another page of this scope may keep open after this one is gone.
    private void Unfollow()
    {
        if (_undo is null) return;

        _undo.StackItemAdded -= OnStackChanged;
        _undo.StackItemUpdated -= OnStackChanged;
        _undo.StackItemPopped -= OnStackChanged;
        _undo = null;
    }

    public override ValueTask DisposeAsync()
    {
        Unfollow();
        return base.DisposeAsync();
    }

    // Not a rewind: an undo makes new edits that reverse this replica's last step, and they sync and merge like
    // keystrokes - so everyone else's work, even work done later, is left alone.
    private void Undo() => _undo?.Undo();

    private void Redo() => _undo?.Redo();
}
