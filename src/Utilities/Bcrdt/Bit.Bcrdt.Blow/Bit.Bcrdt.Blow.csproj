<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.Bcrdt.Blow</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <Description>bit Bcrdt as the collaboration backend for bit Blow: BcrdtBlowBinding keeps the node and edge lists a BlowCanvas edits and a collaborative map in step in both directions - every node and edge an entry of its own, keyed by id, one key per property, so concurrent edits of different elements or of different properties of one node all survive - with one transaction per finished edit, no echo, selective collaborative undo and cursor and selection presence.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;CRDT;Collaboration;Realtime;Flow;Diagram;NodeEditor</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Bcrdt\Bit.Bcrdt.csproj" />
        <ProjectReference Include="..\..\Blow\Bit.Blow\Bit.Blow.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shared with Bit.Bcrdt.Bink: the field and stacking-order mapping every integration uses. -->
        <Compile Include="..\Integrations\*.cs" Link="Integrations\%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Bit.Bcrdt" />
    </ItemGroup>

</Project>
