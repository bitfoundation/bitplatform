@page "/internals"
@using System.Diagnostics.Metrics
@inherits ReplicaPageBase

<PageTitle>Internals · Bcrdt</PageTitle>

<div class="bb-intro">
    <h1>Internals</h1>
    <p class="bb-subtitle">
        The machinery the other pages hide: what a replica knows, how much it is storing, and what actually goes over
        the wire - the page to open when you want to check that the efficiency claims are true rather than take them
        on faith.
    </p>
</div>

@* Each panel carries a table of measurements under its editor, so the panels take the width the "on this page" rail would. *@
<div class="bb-card bb-page-wide">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Two replicas, measured</h3>
    <p class="bb-card-desc">
        Type into either replica, or let the buttons do it, and watch what each one stores and what it would send.
        <em>Type 500 characters</em> makes 500 separate one-character edits at the end of the text, the way a person
        types; <em>500 insertions in one transaction</em> makes the same 500 edits inside one transaction;
        <em>Make 200 scattered edits</em> inserts 200 characters at random places, the case that defeats run-length
        encoding. Hover over a measurement's name for a reminder of what it counts.
    </p>

    @if (!Ready)
    {
        <p class="loading bb-empty"><span class="bb-spinner" aria-hidden="true"></span> Opening two replicas…</p>
    }
    else
    {
        <div class="bb-split replicas">
            @foreach (DemoReplica replica in Replicas)
            {
                <ReplicaPanel Replica="replica" ShowPresence="false">
                    <ChildContent>
                        <BcrdtTextArea Text="replica.Document.Text(Field)"
                                       Presence="replica.Document.Presence"
                                       Field="@Field"
                                       Rows="6"
                                       Class="editor"
                                       Placeholder="Type here and watch the numbers below." />

                        <div class="toolbar bb-toolbar">
                            <button type="button" class="btn btn-primary" @onclick="() => TypeBurst(replica, 500)">
                                Type 500 characters
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="() => TypeInOneTransaction(replica, 500)">
                                500 insertions in one transaction
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="() => Scatter(replica, 200)">
                                Make 200 scattered edits
                            </button>
                        </div>

                        <dl class="stats bb-params">
                            <dt>Characters</dt>
                            <dd>@replica.Document.Text(Field).Count.ToString("N0")</dd>

                            <dt title="One per contiguous run of content. Far fewer than the character count is the point.">
                                Blocks
                            </dt>
                            <dd>@BlockCount(replica).ToString("N0")</dd>

                            <dt title="Characters per block. Higher means run-length encoding is working harder for you.">
                                Characters per block
                            </dt>
                            <dd>@Ratio(replica)</dd>

                            <dt title="What a peer sends to ask for exactly what it is missing.">
                                State vector
                            </dt>
                            <dd>@Bytes(replica.Document.Crdt.GetStateVector().Encode().Length)</dd>

                            <dt title="The whole document, encoded. What a brand-new peer would receive.">
                                Full document
                            </dt>
                            <dd>@Bytes(FullSize(replica))</dd>

                            <dt title="What this replica would send to a peer that is already up to date.">
                                Delta for an up-to-date peer
                            </dt>
                            <dd>@Bytes(NoOpSize(replica))</dd>
                        </dl>
                    </ChildContent>

                    <Footer>
                        <span class="metric" title="Entries in the state vector: every client that has ever written to this document.">clients known: @replica.Document.Crdt.GetStateVector().Count</span>
                    </Footer>
                </ReplicaPanel>
            }
        </div>
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-danger"></span> What the numbers mean</h3>
    <p class="bb-card-desc">
        The <strong>state vector</strong> is a replica's complete summary of what it has seen - one
        entry per author, a few bytes each. It is the whole of what a peer needs in order to compute
        the exact delta this replica is missing, which is why reconnecting after a long absence costs
        one small message rather than a full document transfer. <strong>Clients known</strong>, under each
        panel, is its number of entries: every replica that has ever written to this document, this
        session's included.
    </p>
    <p class="bb-card-desc">
        <strong>Blocks</strong> are the engine's internal unit of storage. Watch the ratio between
        characters and blocks as you type: a run of consecutive typing collapses into a single block,
        so a long document typically holds a few dozen blocks rather than one per character. That
        collapse is the single most important reason collaborative text is affordable at all.
        Scattered edits are the opposite: each one splits a run, and the ratio falls.
    </p>
    <p class="bb-card-desc">
        <strong>Full document</strong> is what a peer that holds nothing is sent: every block, plus the record of
        what has been deleted. <strong>Delta for an up-to-date peer</strong> is what a peer that already holds
        everything is sent, and it is not zero: the delete set always travels, because a deletion does not advance
        a state vector, and re-sending it is the only way a deletion lost in transit is ever repaired. It stays
        small - deletions are stored as ranges - which is what keeps "anything new?" cheap however big the
        document grows.
    </p>
</div>

@if (Ready)
{
    <div class="bb-card">
        <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Updates as they happen</h3>
        <p class="bb-card-desc">
            Every committed change produces exactly one update, whatever it contained - this is why a
            paste of five hundred rows is one network message rather than five hundred. Compare the two buttons:
            <em>Type 500 characters</em> fills the log with one-character updates, <em>500 insertions in one
            transaction</em> adds a single row. The most recent are listed newest first, with the replica that
            produced them; the content column is the start of the encoded bytes.
        </p>
        <p class="bb-card-desc">
            The origin column tells a replica's own edits from what it received. Local edits - the editor's
            keystrokes and the buttons alike - carry no origin, while an update that arrived from the other replica
            carries its sync provider. That tag is how the provider avoids echoing a peer's change back to it, and
            how an undo stack knows to leave remote edits alone.
        </p>
        @if (_updates.Count == 0)
        {
            <p class="bb-empty">Nothing yet. Type into a panel above.</p>
        }
        else
        {
            <div class="bb-scroll">
                <table class="bb-table log-table">
                    <thead>
                        <tr><th>Replica</th><th>Size</th><th>Origin</th><th>Content</th></tr>
                    </thead>
                    <tbody>
                        @foreach (UpdateRecord record in _updates)
                        {
                            <tr>
                                <td class="bb-table-key"><span class="replica-dot" style="--replica-color: @record.Color" aria-hidden="true"></span>@record.Label</td>
                                <td class="bb-nowrap">@Bytes(record.Size)</td>
                                <td>@record.Origin</td>
                                <td class="bb-mono">@record.Preview</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="bb-toolbar">
            <button type="button" class="btn btn-secondary" @onclick="() => _updates.Clear()">Clear the log</button>
        </div>
        <pre class="bb-code"><span class="k">using</span> (<span class="k">var</span> transaction = document.BeginTransaction())   <span class="c">// or document.Transact(t =&gt; ...)</span>
{
    <span class="k">for</span> (<span class="k">int</span> i = 0; i &lt; 500; i++) text.Insert(text.Count, <span class="s">"x"</span>);
}                                                          <span class="c">// one update, one round of events</span>

document.Changed += change =&gt; Send(change.Update, change.Origin);</pre>
    </div>

    <div class="bb-card">
        <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Changes as deltas</h3>
        <p class="bb-card-desc">
            An update is what travels; a <strong>delta</strong> is what a view needs. Every collaborative type raises
            an event after each transaction that changed it, and a text's event describes the change as
            <em>retain</em>, <em>insert</em> and <em>delete</em> steps - so a view can patch exactly what moved instead
            of re-reading the whole document. Below is the latest change each replica observed on its text, and
            whether it was made locally or arrived from the other replica.
        </p>
        <div class="bb-scroll">
            <table class="bb-table">
                <thead>
                    <tr><th>Replica</th><th>Latest change</th></tr>
                </thead>
                <tbody>
                    @foreach (DemoReplica replica in Replicas)
                    {
                        <tr>
                            <td class="bb-table-key bb-nowrap"><span class="replica-dot" style="--replica-color: @replica.Color" aria-hidden="true"></span> @replica.Label</td>
                            <td class="bb-mono">@(_deltas.GetValueOrDefault(replica) ?? "nothing yet")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <pre class="bb-code">IDisposable subscription = text.Observe((change, transaction) =&gt;
{
    <span class="c">// Read the delta here, inside the handler: it is computed from the blocks the</span>
    <span class="c">// transaction touched, which are compacted once the transaction settles.</span>
    IReadOnlyList&lt;BcrdtDeltaOperation&gt; delta = change.Delta;   <span class="c">// retain 12, insert "x"</span>
    <span class="k">bool</span> mine = transaction.Local;
});</pre>
        <p class="bb-card-desc">
            A map's event reports which <code>Keys</code> changed, a set's what was <code>Added</code> and
            <code>Removed</code>, and <code>ObserveDeep</code> on a type hears changes to everything nested inside it.
        </p>
    </div>

    <div class="bb-card">
        <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Metrics</h3>
        <p class="bb-card-desc">
            Every measurement the library takes is published on one meter, <code>Bit.Bcrdt</code>
            (<code>BcrdtDiagnostics.MeterName</code>), through <code>System.Diagnostics.Metrics</code>, and costs a
            single check while nobody listens. This page listens, in the browser, and totals what every replica in
            this tab has done since the page opened - messages and bytes in both directions, handshakes,
            reconnections, errors and store writes. The message counters keep ticking while you do nothing: each
            replica refreshes its presence every few seconds.
        </p>
        <div class="bb-scroll">
            <table class="bb-table">
                <thead>
                    <tr><th>Instrument</th><th>Since this page opened</th><th>What it counts</th></tr>
                </thead>
                <tbody>
                    @foreach ((string name, string meaning) in Instruments)
                    {
                        <tr>
                            <td class="bb-table-key bb-nowrap">@name</td>
                            <td class="bb-mono bb-nowrap">@Measured(name)</td>
                            <td>@meaning</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <pre class="bb-code">builder.Services.AddOpenTelemetry()
    .WithMetrics(metrics =&gt; metrics.AddMeter(BcrdtDiagnostics.MeterName));</pre>
        <p class="bb-card-desc">
            Or, with no code at all, <code>dotnet-counters monitor --counters Bit.Bcrdt</code> against a server.
            Message counters are tagged with the message's kind; no measurement carries a document identifier, a
            client identifier or any content. In Blazor WebAssembly the SDK turns <code>System.Diagnostics.Metrics</code>
            off by default, so a browser app that wants the numbers sets <code>&lt;MetricsSupport&gt;true&lt;/MetricsSupport&gt;</code>
            in its project file, as this demo does.
        </p>
    </div>

    <div class="bb-card">
        <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Full projection</h3>
        <p class="bb-card-desc">The whole document as each replica projects it, which is what <code>ToJson()</code> hands an application.</p>
        <div class="bb-split">
            @foreach (DemoReplica replica in Replicas)
            {
                <div class="projection" style="--replica-color: @replica.Color">
                    <p class="projection-title"><span class="replica-dot" aria-hidden="true"></span>@replica.Label</p>
                    <pre class="json bb-code">@DemoJson.Format(replica.Document.ToJson())</pre>
                </div>
            }
        </div>
    </div>
}

@code {
    private const string Field = "body";
    private const int MaxLoggedUpdates = 25;

    // What the metrics table lists, in the order BcrdtDiagnostics declares them.
    private static readonly (string Name, string Meaning)[] Instruments =
    [
        ("bcrdt.sync.messages.sent", "Protocol messages handed to a transport."),
        ("bcrdt.sync.bytes.sent", "Bytes of those messages."),
        ("bcrdt.sync.messages.received", "Protocol messages received from a transport."),
        ("bcrdt.sync.bytes.received", "Bytes of those messages."),
        ("bcrdt.sync.handshake.duration", "Handshakes completed, and how long the latest one took."),
        ("bcrdt.sync.reconnects", "Reconnection attempts scheduled."),
        ("bcrdt.sync.errors", "Failures a sync provider reported."),
        ("bcrdt.persistence.writes", "Records written to a document store."),
        ("bcrdt.persistence.bytes", "Bytes of those records."),
        ("bcrdt.persistence.failures", "Store writes and compactions that failed."),
        ("bcrdt.persistence.compactions", "Store compactions that completed."),
    ];

    private readonly List<UpdateRecord> _updates = [];
    private readonly Dictionary<DemoReplica, string> _deltas = [];
    private readonly Dictionary<string, Measurement> _measured = new(StringComparer.Ordinal);

    protected override string DocumentId => "demo-internals";

    protected override string[] ReplicaLabels => ["Replica A", "Replica B"];

    private sealed record UpdateRecord(string Label, string Color, int Size, string Origin, string Preview);

    private sealed class Measurement
    {
        public double Total;
        public long Count;
        public double Last;
    }

    protected override void OnReplicasOpened()
    {
        foreach (DemoReplica replica in Replicas)
        {
            DemoReplica captured = replica;
            void Handler(BcrdtUpdateEventArgs args) => Record(captured, args);

            captured.Document.Changed += Handler;
            TrackDisposable(new Unsubscribe(() => captured.Document.Changed -= Handler));

            TrackDisposable(captured.Document.Text(Field).Observe((change, transaction) =>
            {
                _deltas[captured] = $"{Describe(change.Delta)}  ({(transaction.Local ? "local" : "from the other replica")})";
                RequestRender();
            }));
        }

        StartListening();
    }

    /// <summary>
    /// Notes one update for display, newest first.
    /// </summary>
    /// <remarks>
    /// The origin column is worth watching: updates this replica produced itself are local and
    /// untagged - the editor's keystrokes and the buttons below alike, which is what lets a default
    /// undo stack capture them - while updates it received carry the sync provider as their origin. That tag is how the
    /// provider avoids echoing a peer's own change back to it, and how the undo stack knows to leave
    /// remote edits alone.
    /// </remarks>
    private void Record(DemoReplica replica, BcrdtUpdateEventArgs args)
    {
        string origin = args.Origin switch
        {
            null => "local edit",
            BcrdtSyncProvider => "received from a peer",
            _ => args.Origin.GetType().Name,
        };

        _updates.Insert(0, new UpdateRecord(
            replica.Label,
            replica.Color,
            args.Update.Length,
            origin,
            Preview(args.Update)));

        if (_updates.Count > MaxLoggedUpdates) _updates.RemoveRange(MaxLoggedUpdates, _updates.Count - MaxLoggedUpdates);
        RequestRender();
    }

    /// <summary>
    /// Listens to the library's meter the way any metrics pipeline does - OpenTelemetry and
    /// dotnet-counters are MeterListeners too - and keeps a running total per instrument.
    /// </summary>
    /// <remarks>
    /// The instruments are process-wide, so this hears every replica in the tab; leaving the page
    /// disposes the listener along with the replicas.
    /// </remarks>
    private void StartListening()
    {
        var listener = new MeterListener
        {
            InstrumentPublished = (instrument, subscriber) =>
            {
                if (instrument.Meter.Name == BcrdtDiagnostics.MeterName) subscriber.EnableMeasurementEvents(instrument);
            },
        };

        listener.SetMeasurementEventCallback<long>((instrument, value, _, _) => Measure(instrument.Name, value));
        listener.SetMeasurementEventCallback<double>((instrument, value, _, _) => Measure(instrument.Name, value));
        listener.Start();

        TrackDisposable(listener);
    }

    private void Measure(string instrument, double value)
    {
        lock (_measured)
        {
            if (!_measured.TryGetValue(instrument, out Measurement? measurement))
            {
                _measured[instrument] = measurement = new Measurement();
            }

            measurement.Total += value;
            measurement.Count++;
            measurement.Last = value;
        }

        RequestRender();
    }

    private string Measured(string instrument)
    {
        lock (_measured)
        {
            if (!_measured.TryGetValue(instrument, out Measurement? measurement)) return "0";

            return instrument == "bcrdt.sync.handshake.duration"
                ? $"{measurement.Count:N0} (latest {measurement.Last:N0} ms)"
                : measurement.Total.ToString("N0");
        }
    }

    private static string Describe(IReadOnlyList<BcrdtDeltaOperation> delta)
    {
        const int shownSteps = 6;
        const int shownCharacters = 24;

        IEnumerable<string> steps = delta.Take(shownSteps).Select(step => step.Kind switch
        {
            BcrdtDeltaKind.Insert when step.Content is string inserted && !step.IsEmbed =>
                inserted.Length > shownCharacters
                    ? $"insert \"{inserted[..shownCharacters]}…\" ({inserted.Length:N0} characters)"
                    : $"insert \"{inserted}\"",
            _ => step.ToString(),
        });

        string described = string.Join(", ", steps);
        return delta.Count > shownSteps ? $"{described}, … ({delta.Count:N0} steps)" : described;
    }

    private static string Preview(byte[] update)
    {
        const int shown = 12;
        string hex = Convert.ToHexString(update.AsSpan(0, Math.Min(shown, update.Length))).ToLowerInvariant();
        return update.Length > shown ? hex + "…" : hex;
    }

    private static int BlockCount(DemoReplica replica) =>
        replica.Document.Crdt.Store.Clients.Sum(entry => entry.Value.Count);

    private static int FullSize(DemoReplica replica) => replica.Document.Crdt.EncodeStateAsUpdate().Length;

    // What a peer that is already up to date would be sent. It is not zero, because the delete set
    // always travels - a deletion does not advance a state vector, so re-sending the set is the only
    // way a lost deletion ever gets repaired.
    private static int NoOpSize(DemoReplica replica) =>
        replica.Document.Crdt.EncodeStateAsUpdate(replica.Document.Crdt.GetStateVector()).Length;

    private static string Bytes(int count) => count == 1 ? "1 byte" : $"{count:N0} bytes";

    private static string Ratio(DemoReplica replica)
    {
        int blocks = BlockCount(replica);
        int characters = replica.Document.Text(Field).Count;
        return blocks == 0 ? "-" : (characters / (double)blocks).ToString("N1");
    }

    /// <summary>Types a run of characters, as a person typing steadily would.</summary>
    /// <remarks>
    /// Deliberately one insertion at a time rather than one bulk insert, so the block count reflects
    /// blocks <i>merging back together</i> after the fact rather than never having been split.
    /// </remarks>
    private static void TypeBurst(DemoReplica replica, int count)
    {
        BcrdtText text = replica.Document.Text(Field);
        for (int i = 0; i < count; i++) text.Insert(text.Count, "x");
    }

    /// <summary>The same insertions as <see cref="TypeBurst"/>, grouped into one transaction.</summary>
    /// <remarks>
    /// Each call inside joins the transaction rather than committing its own, so the peer receives one
    /// update and every observer hears about the change once.
    /// </remarks>
    private static void TypeInOneTransaction(DemoReplica replica, int count)
    {
        BcrdtText text = replica.Document.Text(Field);
        using BcrdtCollaborativeTransaction transaction = replica.Document.BeginTransaction();
        for (int i = 0; i < count; i++) text.Insert(text.Count, "x");
    }

    /// <summary>Makes edits at random positions, which is the case run-length encoding cannot help.</summary>
    private static void Scatter(DemoReplica replica, int count)
    {
        BcrdtText text = replica.Document.Text(Field);
        var random = new Random(7);

        for (int i = 0; i < count; i++)
        {
            text.Insert(text.Count == 0 ? 0 : random.Next(text.Count), "*");
        }
    }

    private sealed class Unsubscribe(Action action) : IDisposable
    {
        public void Dispose() => action();
    }
}
