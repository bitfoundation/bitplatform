@page "/form"
@inherits ReplicaPageBase

<PageTitle>Collaborative form · Bcrdt</PageTitle>

<div class="bb-intro">
    <h1>Collaborative form</h1>
    <p class="bb-subtitle">
        Two replicas of one form, there to make a single decision visible: which field type you pick determines what
        happens when two people edit the same thing at once - one value wins for a map entry, both additions survive
        in a nested set, and both edits survive in a nested text.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Two replicas of one form</h3>
    <p class="bb-card-desc">
        Three map entries, one nested set and one nested text, all inside one <code>BcrdtMap</code> called
        <code>form</code>. Edit a field in either replica and watch the other follow. Under each field, a note says
        how it merges.
    </p>

    @if (!Ready)
    {
        <p class="loading bb-empty"><span class="bb-spinner" aria-hidden="true"></span> Opening two replicas…</p>
    }
    else
    {
        <div class="bb-split replicas">
            @foreach (DemoReplica replica in Replicas)
            {
                <ReplicaPanel Replica="replica">
                    <ChildContent>
                        <label class="field bb-field">
                            <span class="field-label">Title</span>
                            <input type="text"
                                   class="field-input"
                                   value="@Read(replica, TitleKey)"
                                   @oninput="@(args => Write(replica, TitleKey, args))" />
                            <small class="field-note">map entry - last writer wins</small>
                        </label>

                        <label class="field bb-field">
                            <span class="field-label">Owner</span>
                            <input type="text"
                                   class="field-input"
                                   value="@Read(replica, OwnerKey)"
                                   @oninput="@(args => Write(replica, OwnerKey, args))" />
                            <small class="field-note">map entry - independent of the others</small>
                        </label>

                        <label class="field bb-field">
                            <span class="field-label">Status</span>
                            <select class="field-input"
                                    value="@Read(replica, StatusKey)"
                                    @onchange="@(args => Write(replica, StatusKey, args))">
                                @*
                                    Shown while the field has no value. Without it the browser would
                                    display the first real option even though nothing is stored, and
                                    choosing that option would raise no change at all.
                                *@
                                <option value="" disabled selected="@(Read(replica, StatusKey).Length == 0)">Choose a status…</option>
                                @foreach (string option in StatusOptions)
                                {
                                    <option value="@option" selected="@(Read(replica, StatusKey) == option)">@option</option>
                                }
                            </select>
                            <small class="field-note">map entry - a menu is a natural fit for last-writer-wins</small>
                        </label>

                        @* A group of checkboxes is one field, so it is a fieldset with a legend rather than a label. *@
                        <fieldset class="field bb-field form-labels">
                            <legend class="field-label">Labels</legend>
                            <div class="label-options">
                                @foreach (string label in LabelOptions)
                                {
                                    <label class="bb-check">
                                        <input type="checkbox"
                                               checked="@Labels(replica).Contains(label)"
                                               @onchange="@(args => ToggleLabel(replica, label, args))" />
                                        @label
                                    </label>
                                }
                            </div>
                            <small class="field-note">nested BcrdtSet - two people's labels both stay</small>
                        </fieldset>

                        <label class="field bb-field">
                            <span class="field-label">Notes</span>
                            @*
                                The same component as the text page. Because the notes are a collaborative
                                text type rather than a string in a map entry, two people typing here at
                                once both keep their work.
                            *@
                            <BcrdtTextArea Text="Notes(replica)"
                                           Presence="replica.Document.Presence"
                                           Field="notes"
                                           Rows="5"
                                           Class="editor"
                                           Placeholder="Both replicas can type here at once." />
                            <small class="field-note">nested BcrdtText - concurrent edits merge</small>
                        </label>
                    </ChildContent>

                    <Footer>
                        <span class="metric">@Notes(replica).Count characters of notes</span>
                    </Footer>
                </ReplicaPanel>
            }
        </div>
    }

    <CodeSnippet Sample="TicketForm.razor" />

    <div class="bb-note bb-note-warn">
        <strong>The thing worth trying.</strong> Take <em>Replica B</em> offline. In A, set the
        title to <em>one thing</em>, tick <em>urgent</em> and add a sentence to the notes. In B, set the title to
        <em>something else</em>, tick <em>blocked</em> and add a different sentence to the notes. Bring B back
        online. One of the two titles wins outright and the other is lost - while <em>both</em> labels stay ticked
        and <em>both</em> sentences appear in the notes. Same two clients, same moment, same conflict; different
        outcome purely because of how the field was modelled.
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Map entries, a nested set and a nested text</h3>
    <p class="bb-card-desc">
        Most collaborative features are not documents. They are forms, settings panels and entity
        editors whose shape is already a C# type. This page is two replicas of one such form, and it
        exists to make a single decision visible: <strong>which field type you pick determines what
        happens when two people edit the same thing at once.</strong>
    </p>
    <p class="bb-card-desc">
        The three fields at the top are plain map entries. Different fields never conflict - one
        person can change the title while another changes the owner and both survive, which is
        already better than the usual save-the-whole-record approach. But two people editing
        <em>the same</em> map field concurrently resolve last-writer-wins: one value survives,
        deterministically but arbitrarily, and the other is gone.
    </p>
    <p class="bb-card-desc">
        The labels are a nested <code>BcrdtSet</code>: a member is a value, present or not. Labels ticked by two
        people at once are both kept, the same label ticked by both is kept once, and a label one person unticks
        while the other unticks and ticks it again stays ticked - an add wins over a concurrent remove. (A tick of a
        label that is already ticked writes nothing, so it cannot outvote a removal; the
        <a href="conflicts">conflict lab</a> runs both cases.)
    </p>
    <p class="bb-card-desc">
        The notes field at the bottom is a nested <code>BcrdtText</code> instead. Concurrent edits to
        it merge character by character, exactly as on the text page.
    </p>
    <pre class="bb-code">BcrdtMap form = document.GetMap(<span class="s">"form"</span>);

form.Set(<span class="s">"title"</span>, <span class="s">"..."</span>);                    <span class="c">// a map entry: one side wins</span>
form.EnsureSet(<span class="s">"labels"</span>).Add(<span class="s">"urgent"</span>);      <span class="c">// a nested set: both additions stay</span>
form.EnsureText(<span class="s">"notes"</span>).Insert(0, <span class="s">"..."</span>);   <span class="c">// a nested text: both edits merge</span></pre>
    <p class="bb-card-desc">
        <code>EnsureSet</code> and <code>EnsureText</code> create the nested type the first time and return it
        after that. Two replicas creating it at the same moment on an empty document race like any map entry - one
        of the two nested types wins, with whatever was written into the other - so a real application creates
        a document's structure once, when the document is first made.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> A form that is already a C# class</h3>
    <p class="bb-card-desc">
        When the form's shape is a type you already have, keep the type as the model.
        <code>BcrdtObjectBinding&lt;T&gt;</code> binds the properties of a plain object to the keys of a
        <code>BcrdtMap</code>, raises <code>INotifyPropertyChanged</code> when a collaborator changes one, and on
        save writes back only the properties you actually changed - so saving never reverts a field somebody else
        edited meanwhile.
    </p>
    <pre class="bb-code"><span class="k">using var</span> binding = <span class="k">new</span> BcrdtObjectBinding&lt;Ticket&gt;(document.GetMap(<span class="s">"form"</span>));

Ticket ticket = binding.ToObject();        <span class="c">// reads the form</span>
ticket.Owner = <span class="s">"Ada"</span>;
binding.FromObject(ticket);                <span class="c">// writes only Owner</span>

binding.Set(t =&gt; t.Status, <span class="s">"Approved"</span>);  <span class="c">// or one property at a time</span></pre>
    <p class="bb-card-desc">
        For a value stored whole, <code>map.SetObject("assignee", person)</code> flattens an object onto the
        values a document can hold, and <code>map.Get&lt;Person&gt;("assignee")</code> reads it back - one value,
        last writer wins.
    </p>
</div>

@if (Ready)
{
    <div class="bb-card">
        <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> What the two replicas hold</h3>
        <p class="bb-card-desc">
            The projection below is what each replica would hand to your application. When both are
            online and idle they are identical; while one is offline they differ, and that is the
            divergence the handshake reconciles.
        </p>
        <div class="bb-split">
            @foreach (DemoReplica replica in Replicas)
            {
                <div class="projection" style="--replica-color: @replica.Color">
                    <p class="projection-title"><span class="replica-dot" aria-hidden="true"></span>@replica.Label</p>
                    <pre class="json bb-code">@DemoJson.Format(replica.Document.GetMap(FormKey).ToJson())</pre>
                </div>
            }
        </div>
        <CodeSnippet Sample="FormJson.razor" />
    </div>
}

@code {
    private const string FormKey = "form";
    private const string TitleKey = "title";
    private const string OwnerKey = "owner";
    private const string StatusKey = "status";
    private const string NotesKey = "notes";
    private const string LabelsKey = "labels";

    private static readonly string[] StatusOptions = ["Draft", "In review", "Approved", "Archived"];

    private static readonly string[] LabelOptions = ["urgent", "customer", "internal", "blocked"];

    protected override string DocumentId => "demo-form";

    protected override string[] ReplicaLabels => ["Replica A", "Replica B"];

    private static string Read(DemoReplica replica, string key) =>
        replica.Document.GetMap(FormKey).Get(key) as string ?? string.Empty;

    private static void Write(DemoReplica replica, string key, ChangeEventArgs args) =>
        replica.Document.GetMap(FormKey).Set(key, args.Value as string ?? string.Empty);

    // EnsureText creates the nested type on first use and returns the existing one thereafter. Two
    // replicas calling it concurrently on an empty document is itself a last-writer-wins race, so a
    // real application would create the structure once when the document is first provisioned.
    private static BcrdtText Notes(DemoReplica replica) => replica.Document.GetMap(FormKey).EnsureText(NotesKey);

    // The same race as the notes, for the same reason: created on first use, by whichever replica renders first.
    private static BcrdtSet Labels(DemoReplica replica) => replica.Document.GetMap(FormKey).EnsureSet(LabelsKey);

    // Add and Remove rather than one write of the whole selection: a set merges per member, so a label
    // ticked here never overwrites one ticked elsewhere.
    private static void ToggleLabel(DemoReplica replica, string label, ChangeEventArgs args)
    {
        BcrdtSet labels = Labels(replica);
        if (args.Value is true) labels.Add(label);
        else labels.Remove(label);
    }
}
