@page "/list"
@inherits ReplicaPageBase

<PageTitle>Collaborative list · Bcrdt</PageTitle>

<div class="bb-intro">
    <h1>Collaborative list</h1>
    <p class="bb-subtitle">
        A shared to-do list, held as a <code>BcrdtArray</code> whose elements are each a <code>BcrdtMap</code> with a
        <code>title</code> and a <code>done</code> flag. Two independent replicas of the document <code>demo-list</code>
        are shown; add, rename, tick and reorder in either one.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Two replicas of one list</h3>
    <p class="bb-card-desc">
        Add an item in either replica, rename it, tick it, move it up or down - and watch the other follow. A
        rename is sent when the title field loses focus or you press Enter; everything else is sent at once. The
        footer counts the items, the ticked items and the engine's storage blocks.
    </p>

    @if (!Ready)
    {
        <p class="loading bb-empty"><span class="bb-spinner" aria-hidden="true"></span> Opening two replicas…</p>
    }
    else
    {
        <div class="bb-split replicas">
            @foreach (DemoReplica replica in Replicas)
            {
                <ReplicaPanel Replica="replica">
                    <ChildContent>
                        <div class="list-add">
                            <input type="text"
                                   aria-label="New item"
                                   placeholder="New item…"
                                   value="@Draft(replica)"
                                   @oninput="args => SetDraft(replica, args.Value as string)"
                                   @onkeydown="args => OnDraftKey(replica, args)" />
                            <button type="button" class="btn btn-primary" @onclick="() => Add(replica)">Add</button>
                        </div>

                        @{
                            BcrdtArray items = Items(replica);
                        }

                        @if (items.Count == 0)
                        {
                            <p class="todo-empty">Nothing on the list yet.</p>
                        }
                        else
                        {
                            <ul class="todo">
                                @for (int index = 0; index < items.Count; index++)
                                {
                                    int position = index;
                                    BcrdtMap? item = items.GetMap(position);
                                    if (item is null) continue;

                                    @*
                                        Keyed by the item itself. Remote insertions and deletions shift
                                        positions; without a key the renderer would reuse the DOM row at
                                        each index for a different item, overwriting a title somebody is
                                        halfway through typing and sending their change to the wrong item.
                                    *@
                                    <li @key="item" class="todo-item @(IsDone(item) ? "todo-done" : "")">
                                        <input type="checkbox"
                                               aria-label="Done"
                                               checked="@IsDone(item)"
                                               @onchange="args => ToggleDone(item, args)" />

                                        <input type="text"
                                               class="todo-title"
                                               aria-label="Title"
                                               value="@Title(item)"
                                               @onchange="args => Rename(item, args.Value as string)" />

                                        <button type="button" class="bb-icon-btn"
                                                title="Move up" aria-label="Move up"
                                                disabled="@(position == 0)"
                                                @onclick="() => MoveUp(replica, position)">↑</button>
                                        <button type="button" class="bb-icon-btn"
                                                title="Move down" aria-label="Move down"
                                                disabled="@(position == items.Count - 1)"
                                                @onclick="() => MoveDown(replica, position)">↓</button>
                                        <button type="button" class="bb-icon-btn icon-danger"
                                                title="Delete" aria-label="Delete"
                                                @onclick="() => Delete(replica, position)">✕</button>
                                    </li>
                                }
                            </ul>
                        }
                    </ChildContent>

                    <Footer>
                        <span class="metric">@Items(replica).Count items</span>
                        <span class="metric">@DoneCount(replica) done</span>
                        <span class="metric">@Blocks(replica) blocks</span>
                    </Footer>
                </ReplicaPanel>
            }
        </div>
    }

    <div class="bb-note bb-note-warn">
        <strong>Worth trying.</strong> Take Replica B offline. In A, rename an item. In B, tick the
        same item and add a new one. Bring B back: the rename and the tick both survive on the same
        item, and B's new item is now in A as well. Then try the reorder arrows on both replicas
        while one is offline. Moving an item removes it and inserts a copy of it at the new
        position, so two people moving the <em>same</em> item concurrently can produce two copies of
        it, and a rename or tick made concurrently with somebody else's move of that item is lost,
        because it lands on the element the move removed. Those are genuine limitations of the
        operation rather than bugs, and they are called out in the library's own documentation for
        <code>Move</code>.
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Why a list of maps</h3>
    <p class="bb-card-desc">
        The nesting is the point. If each item were stored as a single string or a serialized blob,
        then one person renaming an item while another ticks it would be two writes of the same
        value, and one of them would have to lose. Because an item is a real collaborative map, the
        rename touches the <code>title</code> key and the tick touches the <code>done</code> key,
        they never contend, and both survive. Two people editing the <em>same</em> key of the same
        item still resolves last-writer-wins - the merge is per key, not per keystroke.
    </p>
    <p class="bb-card-desc">
        Ordering is handled by the sequence itself. Concurrent insertions at the same position are
        placed in an order every replica independently agrees on, and a run inserted by one person
        stays contiguous rather than interleaving with a run inserted by someone else. Concurrent
        deletion of the same item is idempotent: it disappears once and never comes back.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> The same list in code</h3>
    <p class="bb-card-desc">
        Everything the buttons above do is one call on a <code>BcrdtArray</code> or on one of its
        <code>BcrdtMap</code> elements. A new item is built detached - a <code>BcrdtMap</code> not yet in any
        document - and its writes are replayed when it joins, so the element and both of its keys reach the other
        replica as one update rather than three.
    </p>
    <pre class="bb-code">BcrdtArray items = document.Array(<span class="s">"items"</span>);

<span class="k">var</span> item = <span class="k">new</span> BcrdtMap();                  <span class="c">// detached until it is inserted</span>
item.Set(<span class="s">"title"</span>, <span class="s">"Buy milk"</span>);
item.Set(<span class="s">"done"</span>, <span class="k">false</span>);
items.Push(item);                         <span class="c">// one update: the element and both keys</span>

items.GetMap(0)?.Set(<span class="s">"done"</span>, <span class="k">true</span>);        <span class="c">// a tick writes one key of one item</span>
items.Move(0, 2);                         <span class="c">// delete, then insert a copy where it goes</span>
items.Delete(1);

items.ObserveDeep((events, transaction) =&gt; { <span class="c">/* any change, nested ones included */</span> });</pre>
    <p class="bb-card-desc">
        Two habits keep a list like this correct in the browser. Key every rendered row by its item
        (<code>@@key="item"</code>): remote insertions and deletions shift positions, and a row reused for a
        different item would send a half-typed title to the wrong one. And read <code>Move</code>'s destination as
        a position in the list <em>before</em> the element is lifted out - one step down is
        <code>Move(index, index + 2)</code>.
    </p>
    <p class="bb-card-desc">
        An application with view models rather than markup can project the same array through
        <code>BcrdtListBinding&lt;T&gt;</code>, an <code>IReadOnlyList&lt;T&gt;</code> that raises
        <code>INotifyCollectionChanged</code> as the list changes - locally or remotely.
    </p>
</div>

@if (Ready)
{
    <div class="bb-card">
        <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> The raw state of each replica</h3>
        <p class="bb-card-desc">
            The same list as the engine holds it. When both replicas are online and idle these two
            projections are identical, character for character - that is the convergence property,
            and it is exactly the assertion the library's own correctness tests make.
        </p>
        <div class="bb-split">
            @foreach (DemoReplica replica in Replicas)
            {
                <div class="projection" style="--replica-color: @replica.Color">
                    <p class="projection-title"><span class="replica-dot" aria-hidden="true"></span>@replica.Label</p>
                    <pre class="json bb-code">@DemoJson.Format(replica.Document.ToJson())</pre>
                </div>
            }
        </div>
    </div>
}

@code {
    private const string ItemsField = "items";
    private const string TitleKey = "title";
    private const string DoneKey = "done";

    private readonly Dictionary<string, string> _drafts = new(StringComparer.Ordinal);
    private int _added;

    protected override string DocumentId => "demo-list";

    protected override string[] ReplicaLabels => ["Replica A", "Replica B"];

    private static BcrdtArray Items(DemoReplica replica) => replica.Document.Array(ItemsField);

    private static string Title(BcrdtMap item) => item.Get<string>(TitleKey) ?? string.Empty;

    private static bool IsDone(BcrdtMap item) => item.Get<bool>(DoneKey);

    private static int Blocks(DemoReplica replica) =>
        replica.Document.Crdt.Store.Clients.Sum(entry => entry.Value.Count);

    private static int DoneCount(DemoReplica replica)
    {
        BcrdtArray items = Items(replica);
        int count = 0;
        for (int index = 0; index < items.Count; index++)
        {
            if (items.GetMap(index) is { } item && IsDone(item)) count++;
        }
        return count;
    }

    private string Draft(DemoReplica replica) => _drafts.GetValueOrDefault(replica.Label, string.Empty);

    private void SetDraft(DemoReplica replica, string? value) => _drafts[replica.Label] = value ?? string.Empty;

    // An Enter that confirms an input method's candidate (Japanese, Chinese, Korean...) belongs to the
    // composition, not to the form: adding then would add the half-composed title.
    private void OnDraftKey(DemoReplica replica, KeyboardEventArgs args)
    {
        if (args.Key is "Enter" && !args.IsComposing) Add(replica);
    }

    private void Add(DemoReplica replica)
    {
        string title = Draft(replica);
        if (string.IsNullOrWhiteSpace(title)) title = $"Item {++_added} from {replica.Label}";

        // A detached map can be filled in before it is inserted; the buffered writes replay as real
        // collaborative operations at the moment it joins the document, so the whole item - element
        // plus both keys - reaches peers as one update rather than three.
        var item = new BcrdtMap();
        item.Set(TitleKey, title.Trim());
        item.Set(DoneKey, false);

        Items(replica).Push(item);
        _drafts[replica.Label] = string.Empty;
    }

    private static void ToggleDone(BcrdtMap item, ChangeEventArgs args) =>
        item.Set(DoneKey, args.Value is true);

    private static void Rename(BcrdtMap item, string? title) =>
        item.Set(TitleKey, title ?? string.Empty);

    private static void MoveUp(DemoReplica replica, int index)
    {
        if (index <= 0) return;
        Items(replica).Move(index, index - 1);
    }

    // Move's destination names a position in the list as it stands *before* the element is lifted
    // out, so a step downwards is index + 2: index + 1 is the position the element already occupies.
    private static void MoveDown(DemoReplica replica, int index)
    {
        BcrdtArray items = Items(replica);
        if (index >= items.Count - 1) return;
        items.Move(index, index + 2);
    }

    private static void Delete(DemoReplica replica, int index) => Items(replica).Delete(index);
}
