@* One participant with an undo stack of its own, which undoes only this user's edits. Each panel of the undo
   page is this component, opened by a different user. *@
@using Bit.Bcrdt
@using Bit.Bcrdt.Blazor
@implements IDisposable

<BcrdtCollaborationScope DocumentId="demo-undo" User="_me" OnOpened="Opened" Context="document">
    <BcrdtTextArea Text="@document.Text("body")" Presence="document.Presence" Field="body" Rows="8"
                   Placeholder="Type here, then undo it." />

    <div>
        <button type="button" disabled="@(_undo is not { CanUndo: true })" @onclick="Undo">Undo</button>
        <button type="button" disabled="@(_undo is not { CanRedo: true })" @onclick="Redo">Redo</button>
        <button type="button" @onclick="() => _undo?.StopCapturing()">End the current step</button>
    </div>

    <footer>@_undo?.UndoCount undoable step(s), @_undo?.RedoCount redoable step(s)</footer>
</BcrdtCollaborationScope>

@code {
    private readonly BcrdtCollaboratorInfo _me = new("u-1", "Ada", BcrdtPresenceService.SuggestColor("u-1"));
    private BcrdtUndoManager? _undo;

    private void Opened(BcrdtCollaborativeDocument document)
    {
        // One stack per editing surface, scoped to the text it edits: a stack over the whole document would
        // undo an edit made in an unrelated field minutes ago. It captures untagged local edits - the
        // textarea's keystrokes - and never the updates that arrive from peers.
        _undo = new BcrdtUndoManager(document.Text("body"));

        // The buttons enable and disable as the stack changes, not only as the document does.
        _undo.StackItemAdded += _ => InvokeAsync(StateHasChanged);
        _undo.StackItemUpdated += _ => InvokeAsync(StateHasChanged);
        _undo.StackItemPopped += _ => InvokeAsync(StateHasChanged);
    }

    // Not a rewind: an undo makes new edits that reverse this user's last step, and they sync and merge
    // like keystrokes - so everyone else's work, even work done later, is left alone.
    private void Undo() => _undo?.Undo();

    private void Redo() => _undo?.Redo();

    public void Dispose() => _undo?.Dispose();
}
