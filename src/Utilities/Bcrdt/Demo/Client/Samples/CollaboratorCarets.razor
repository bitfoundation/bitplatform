@* Where everyone else's caret is, resolved against this replica's own copy of the text. The library draws no
   remote carets: this is what an application reads to draw them. Place it inside a BcrdtCollaborationScope,
   which cascades the open document. *@
@using Bit.Bcrdt
@using Bit.Bcrdt.Blazor
@inherits BcrdtComponentBase

<table>
    <thead>
        <tr><th>Who</th><th>Where</th></tr>
    </thead>
    <tbody>
        @foreach (BcrdtCollaborator other in Document.Presence.Others)
        {
            <tr>
                <td style="color: @other.User.Color">@other.User.Name</td>
                <td>@Where(other)</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [CascadingParameter] public BcrdtCollaborativeDocument Document { get; set; } = default!;

    // Re-render, coalesced, whenever somebody joins, leaves or moves their caret.
    protected override void OnInitialized() => Track(Document.Presence);

    // A selection is anchored to a character rather than to an index, so it is resolved against this
    // replica's own copy of the text - and is null while that character has not arrived here yet,
    // because presence and the document travel separately.
    private string Where(BcrdtCollaborator other)
    {
        if (other.Selection is not { } selection) return "has not placed a caret yet";
        if (selection.Resolve(Document.Crdt) is not { } range) return "caret in text not received yet";

        return range.Start == range.End ? $"caret at {range.Start}" : $"selecting {range.Start} to {range.End}";
    }
}
