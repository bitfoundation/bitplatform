@* A plain read-out of one replica's connection state: a status light and a word. Purely presentational:
   it re-renders when its parent does, and the parent is what subscribes to the sync provider. *@

<span class="badge bb-badge @BadgeClass" title="@Description"><span class="bb-dot @DotClass" aria-hidden="true"></span>@Label</span>

@code {
    /// <summary>The connection state to display.</summary>
    [Parameter, EditorRequired]
    public BcrdtConnectionStatus Status { get; set; }

    /// <summary>Whether the replica is meant to be connected at all.</summary>
    [Parameter]
    public bool WantsConnection { get; set; } = true;

    private string Label => !WantsConnection ? "offline" : Status switch
    {
        BcrdtConnectionStatus.Synced => "synced",
        BcrdtConnectionStatus.Handshaking => "syncing",
        BcrdtConnectionStatus.Connecting => "connecting",
        BcrdtConnectionStatus.Reconnecting => "reconnecting",
        BcrdtConnectionStatus.Faulted => "faulted",
        _ => "disconnected",
    };

    private Tone Kind => !WantsConnection ? Tone.Idle : Status switch
    {
        BcrdtConnectionStatus.Synced => Tone.Good,
        BcrdtConnectionStatus.Handshaking or BcrdtConnectionStatus.Connecting or BcrdtConnectionStatus.Reconnecting => Tone.Busy,
        BcrdtConnectionStatus.Faulted => Tone.Bad,
        _ => Tone.Idle,
    };

    private string BadgeClass => Kind switch
    {
        Tone.Good => "bb-badge-success",
        Tone.Busy => "bb-badge-warn",
        Tone.Bad => "bb-badge-danger",
        _ => "badge-idle",
    };

    private string? DotClass => Kind switch
    {
        Tone.Good => "bb-dot-success",
        Tone.Busy => "bb-dot-warning",
        Tone.Bad => "bb-dot-danger",
        _ => null,
    };

    private string Description => !WantsConnection
        ? "Disconnected on purpose. Edits still work and are kept locally until this replica reconnects."
        : $"BcrdtConnectionStatus.{Status}";

    private enum Tone { Good, Busy, Bad, Idle }
}
