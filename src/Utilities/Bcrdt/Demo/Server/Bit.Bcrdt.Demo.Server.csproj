<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <!-- Serves the client's _framework payload and enables WebAssembly debugging from this host. -->
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
        <!-- The MCP server (see Controllers/McpController.cs), mapped at /mcp. -->
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Bcrdt\Bit.Bcrdt.csproj" />
        <ProjectReference Include="..\..\Bit.Bcrdt.Server\Bit.Bcrdt.Server.csproj" />
        <!-- Nothing here runs it: it is referenced so GetBcrdtApi reflects all four packages. The client brings
             Bit.Bcrdt.SignalR. -->
        <ProjectReference Include="..\..\Bit.Bcrdt.Testing\Bit.Bcrdt.Testing.csproj" />
        <ProjectReference Include="..\Client\Bit.Bcrdt.Demo.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Bit.Bcrdt" />
        <Using Include="Microsoft.AspNetCore.Mvc" />
    </ItemGroup>

    <ItemGroup>
        <!-- The MCP tests boot this very app: WebApplicationFactory needs its entry point type, which
             top-level statements declare as internal. -->
        <InternalsVisibleTo Include="Bit.Bcrdt.Tests.Mcp" />
    </ItemGroup>

    <!-- Text the MCP server hands out. It is embedded rather than read from disk so the tools keep
         working from a published deployment, where none of these files exist next to the app.
         LogicalName is set explicitly because the resource name IS the path an MCP client asks for. -->
    <ItemGroup>
        <EmbeddedResource Include="..\..\README.md" LogicalName="BcrdtDocs/README.md" />

        <!-- Every demo page - each one is a set of real replicas merging for real - plus the replicas,
             transports and components they share and the client half of the hosting. The MCP page
             describes this server rather than the library, and the not-found page teaches nothing
             about collaboration. Nor does the site chrome: Layout\ and the DocsCatalog.cs that drives it
             are the header, docs shell, search and footer every Utilities demo shares. -->
        <EmbeddedResource Include="..\Client\**\*.razor;..\Client\**\*.cs"
                          Exclude="..\Client\bin\**;..\Client\obj\**;..\Client\Layout\**;..\Client\DocsCatalog.cs;..\Client\Pages\McpServer.razor;..\Client\Pages\NotFound.razor">
            <LogicalName>BcrdtSource/Demo/Client/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <EmbeddedResource Include="Program.cs" LogicalName="BcrdtSource/Demo/Server/Program.cs" />

        <!-- The Components\ prefix is written out: %(RecursiveDir) only captures what the '**' matched.
             Error.razor is the template's own error page and says nothing about collaboration. -->
        <EmbeddedResource Include="Components\**\*.razor" Exclude="Components\Pages\Error.razor">
            <LogicalName>BcrdtSource/Demo/Server/Components/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- BcrdtServerInstructions.BcrdtVersion is a hand-written copy of ReleaseVersion: the version the packages
         ship as, which no assembly carries (a Debug build stamps 1.0.0, a Release build 10.7.0.04 for 10.7.0-pre-04).
         This project ships no package and does not import Bit.Build.props, so ReleaseVersion is read out of it
         here, and the build fails as Bit.Build.props's VerifyReleaseVersionLiterals does when the copy goes stale. -->
    <ItemGroup>
        <ReleaseVersionLiteral Include="Services\BcrdtServerInstructions.cs" />
    </ItemGroup>

    <Target Name="VerifyBcrdtReleaseVersionLiteral" BeforeTargets="BeforeBuild">
        <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\..\..\..\Bit.Build.props" Query="/Project/PropertyGroup/ReleaseVersion/text()">
            <Output TaskParameter="Result" PropertyName="_BcrdtReleaseVersion" />
        </XmlPeek>
        <PropertyGroup>
            <_BcrdtReleaseVersionPattern>['"]$([System.Text.RegularExpressions.Regex]::Escape('$(_BcrdtReleaseVersion)'))['"]</_BcrdtReleaseVersionPattern>
        </PropertyGroup>
        <ItemGroup>
            <_BcrdtStaleReleaseVersionLiteral Include="@(ReleaseVersionLiteral)"
                                              Condition=" !$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '$(_BcrdtReleaseVersionPattern)')) " />
        </ItemGroup>
        <Error Condition=" '$(_BcrdtReleaseVersion)' == '' " Text="ReleaseVersion could not be read from Bit.Build.props." />
        <Error Condition=" '@(_BcrdtStaleReleaseVersionLiteral)' != '' "
               File="%(_BcrdtStaleReleaseVersionLiteral.FullPath)"
               Text="%(_BcrdtStaleReleaseVersionLiteral.Identity) does not declare the release version '$(_BcrdtReleaseVersion)' (see ReleaseVersion in Bit.Build.props). Update its version literal." />
    </Target>

</Project>
