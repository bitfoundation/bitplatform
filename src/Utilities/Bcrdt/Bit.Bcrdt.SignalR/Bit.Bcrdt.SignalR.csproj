<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.Bcrdt.SignalR</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <Description>The SignalR client transport for bit Bcrdt. It carries no ASP.NET Core server dependency, so it runs in Blazor WebAssembly, Server and Hybrid alike; map the matching hub from Bit.Bcrdt.Server on the server.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;CRDT;Collaboration;Realtime;SignalR</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- Floating low-bound version ranges so consumers can pin to any patch release on their TFM; the upper
             bound keeps a major-version package that targets a newer TFM out. Each floor is the first patch of its
             band whose Microsoft.AspNetCore.SignalR.Common is not affected by CVE-2026-70159 (GHSA-334f-vvp4-7g6p),
             which NuGet audit would otherwise report on every restore. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.SignalR.Client" Version="[10.0.13,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.SignalR.Client" Version="[11.0.0-rc.1.26425.128,12.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Bcrdt\Bit.Bcrdt.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Bit.Bcrdt" />
    </ItemGroup>

</Project>
