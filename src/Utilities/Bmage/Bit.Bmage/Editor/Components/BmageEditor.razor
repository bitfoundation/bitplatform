@using System.Drawing
@using Bit.Bmage.Analysis
@using Bit.Bmage.Editor.Tools
@using Bit.Bmage.Masks
@using Bit.Bmage.Operations
@using Bit.Bmage.Operations.Adjustments
@using Bit.Bmage.Operations.Transforms
@implements IAsyncDisposable
@inject IServiceProvider Services

@*
    The complete editor. Every visual element is a slot: hosts can replace the toolbar, panels or empty state entirely
    while keeping the editing engine, or use the defaults and get a working editor in one line of markup.
*@

<div class="bmg-editor @(Class) @(_capabilities?.Environment == ImageEnvironment.Prerendering ? "bmg-prerender" : null)"
     style="@Style"
     dir="@Direction"
     role="region"
     aria-label="@(AriaLabel ?? Strings.EditorLabel)"
     aria-busy="@(_busy ? "true" : "false")">

    @if (Toolbar is not null)
    {
        @Toolbar(BuildContext())
    }
    else if (ShowToolbar)
    {
        <BmageEditorToolbar Context="BuildContext()" />
    }

    <div class="bmg-editor-body">
        <div class="bmg-editor-stage">
            @if (_session is null)
            {
                @if (EmptyState is not null)
                {
                    @EmptyState
                }
                else
                {
                    <BmageDropZone Strings="Strings"
                                   Accept="@AcceptedFileTypes"
                                   Multiple="false"
                                   OnFilesSelected="OnFilesSelected" />
                }
            }
            else
            {
                <BmageEditorCanvas @ref="_canvas"
                                   Image="ShownImage"
                                   DisplaySize="ShownDisplaySize"
                                   Version="_previewVersion"
                                   Zoom="_zoom"
                                   Pan="_pan"
                                   Strings="Strings"
                                   Busy="_busy"
                                   ShowCropOverlay="_tool == EditorToolKind.Crop && !_comparing"
                                   CropRectangle="_comparing ? null : _cropRectangle"
                                   SelectionBounds="_comparing ? null : SelectionBounds"
                                   SelectionOutline="@(_comparing ? null : _selectionOutline)"
                                   OnDragStart="OnDragStart"
                                   OnDragMove="OnDragMove"
                                   OnDragEnd="OnDragEnd"
                                   OnCropHandleDown="OnCropHandleDown"
                                   OnZoom="OnZoomGesture"
                                   OnKeyPressed="OnKeyPressed" />
                @if (_comparing)
                {
                    <div class="bmg-compare-badge" role="status">@Strings.ShowingOriginal</div>
                }
            }

            @if (_message is not null)
            {
                <div class="bmg-message bmg-message-@(_messageIsError ? "error" : "info")" role="@(_messageIsError ? "alert" : "status")" aria-live="polite">
                    <span>@_message</span>
                    <button type="button" class="bmg-message-dismiss" aria-label="@Strings.Cancel" @onclick="() => _message = null">×</button>
                </div>
            }
        </div>

        @if (Panel is not null)
        {
            @Panel(BuildContext())
        }
        else if (ShowPanel && _session is not null)
        {
            <BmageEditorPanel Context="BuildContext()" />
        }
    </div>

    @if (Footer is not null)
    {
        @Footer(BuildContext())
    }
</div>

@code {
    // Resolved rather than injected, so the editor also works when the app never called AddBitBmageServices.
    private IServiceProvider EditorServices => field ??= BitBmage.GetEditorServices(Services);
    private ImageLoader Loader => field ??= EditorServices.GetRequiredService<ImageLoader>();
    private ImageExporter Exporter => field ??= EditorServices.GetRequiredService<ImageExporter>();
    private IImageCapabilityProvider Capabilities => field ??= EditorServices.GetRequiredService<IImageCapabilityProvider>();
    private Bit.Bmage.Text.FontTextRasterizer FontRasterizer => field ??= EditorServices.GetRequiredService<Bit.Bmage.Text.FontTextRasterizer>();
    private BitBmageOptions Options => field ??= EditorServices.GetRequiredService<BitBmageOptions>();

    private ImageEditSession? _session;
    private BmageEditorCanvas? _canvas;
    private ImageCapabilities? _capabilities;
    private EditorToolKind _tool = EditorToolKind.Select;
    private EditorToolSettings _settings = new();
    private ToolDrag? _drag;
    private Annotation? _dragPreview;
    private Guid? _selectedId;
    private Vector2 _selectionDragOrigin;
    private RectangleF? _cropRectangle;
    private CropHandle? _cropHandle;
    private RectangleF _cropStart;
    private AspectRatio? _cropAspect;
    private double _zoom = 1.0;
    private Vector2 _pan;
    private long _previewVersion;
    private bool _busy;
    private string? _message;
    private bool _messageIsError;
    private CancellationTokenSource? _renderCts;
    // At most one render runs at a time, always of the latest state; see RenderPreviewAsync.
    private bool _renderLoopRunning;
    private bool _renderWanted;
    private bool _wantedDraft;
    private bool _wantedRefine;
    private RenderKind _renderingNow;
    private int _renderRequests;
    private Func<ImageDocument, ImageDocument>? _wantedOverlay;
    private TaskCompletionSource? _renderWaiters;
    private ImageBuffer? _shownPreview;
    private ImageDocument? _notifiedDocument;
    private int _stepCounter;
    // The Image parameter last loaded. The session holds a copy, so it cannot be compared with the parameter itself.
    private ImageBuffer? _loadedParameter;
    private bool _fitPending;
    private SizeF? _viewport;
    private Vector2 _panLast;
    // While comparing, the canvas shows the source at preview resolution, owned by the session.
    private bool _comparing;
    private ImageBuffer? _sourcePreview;
    // The layer the layer panel has selected, which painting goes to when it is a paint layer.
    private Guid? _activeLayerId;
    // The next eyedropper pick sets the white balance instead of the drawing colour.
    private bool _pickingWhiteBalance;
    // The pixel selection, in output coordinates, and its outline as SVG path data in the canvas's coordinates.
    private Mask? _selection;
    private string? _selectionOutline;
    private int _outlineVersion;
    private SelectionMode _selectionMode;

    /// <summary>How a new selection shape combines with the selection there is.</summary>
    private enum SelectionMode { Replace, Add, Subtract }

    /// <summary>The image to edit. Setting this replaces the current session and discards its history.</summary>
    [Parameter] public ImageBuffer? Image { get; set; }

    /// <summary>Localised strings for every label in the editor.</summary>
    [Parameter] public BmageEditorStrings Strings { get; set; } = BmageEditorStrings.Default;

    /// <summary>Text direction, "ltr" or "rtl".</summary>
    [Parameter] public string Direction { get; set; } = "ltr";

    /// <summary>Extra CSS classes on the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline styles on the root element.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Accessible label for the editor region.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Show the built-in toolbar. Ignored when <see cref="Toolbar"/> is set.</summary>
    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>Show the built-in options panel. Ignored when <see cref="Panel"/> is set.</summary>
    [Parameter] public bool ShowPanel { get; set; } = true;

    /// <summary>Replaces the toolbar entirely. The context exposes every editor action.</summary>
    [Parameter] public RenderFragment<BmageEditorContext>? Toolbar { get; set; }

    /// <summary>Replaces the options panel entirely.</summary>
    [Parameter] public RenderFragment<BmageEditorContext>? Panel { get; set; }

    /// <summary>Content rendered below the editor body.</summary>
    [Parameter] public RenderFragment<BmageEditorContext>? Footer { get; set; }

    /// <summary>Replaces the "no image loaded" view.</summary>
    [Parameter] public RenderFragment? EmptyState { get; set; }

    /// <summary>File types offered by the built-in file picker.</summary>
    [Parameter] public string AcceptedFileTypes { get; set; } = "image/*";

    /// <summary>
    /// Longest edge used for interactive editing. Larger images are edited through a downscaled proxy and the edit is
    /// replayed at full resolution on export. Null uses <see cref="BitBmageOptions.MaxInteractiveDimension"/>, or
    /// 2048 when that is not configured either. Zero edits at full resolution, which is only sensible for small images.
    /// </summary>
    [Parameter] public int? MaxProxyDimension { get; set; }

    private int EffectiveProxyDimension => MaxProxyDimension ?? Options.MaxInteractiveDimension ?? 2048;

    /// <summary>Number of undo steps kept.</summary>
    [Parameter] public int MaxHistoryDepth { get; set; } = 100;

    /// <summary>
    /// Draws text and step-number annotations. Null uses the <see cref="Bit.Bmage.Text.FontTextRasterizer"/> from
    /// dependency injection, which renders text once a font has been registered with it.
    /// </summary>
    [Parameter] public ITextRasterizer? TextRasterizer { get; set; }

    /// <summary>Export settings used by the built-in save action.</summary>
    [Parameter] public ImageExportOptions ExportOptions { get; set; } = ImageExportOptions.Png;

    /// <summary>Raised after every edit, with the current document.</summary>
    [Parameter] public EventCallback<ImageDocument> OnDocumentChanged { get; set; }

    /// <summary>Raised when the user exports, with the encoded result.</summary>
    [Parameter] public EventCallback<EncodedImage> OnExported { get; set; }

    /// <summary>Raised when an image is loaded into the editor.</summary>
    [Parameter] public EventCallback<ImageBuffer> OnImageLoaded { get; set; }

    /// <summary>Raised when an operation fails. When not handled, the error is shown in the editor.</summary>
    [Parameter] public EventCallback<Exception> OnError { get; set; }

    /// <summary>The live editing session, or null when no image is loaded.</summary>
    public ImageEditSession? Session => _session;

    /// <summary>The current document, or null when no image is loaded.</summary>
    public ImageDocument? Document => _session?.Document;

    // Annotations live in full-resolution coordinates; the canvas shows the preview, which may be a smaller proxy.
    private RectangleF? SelectionBounds => _selectedId is { } id && _session?.Document.FindAnnotation(id) is { } a
        ? ToPreview(a.GetRotatedBounds())
        : null;

    private Vector2 ToDocument(Vector2 previewPoint) => _session?.PreviewToOutput(previewPoint) ?? previewPoint;

    private RectangleF ToPreview(RectangleF r)
    {
        if (_session is not { UsesProxy: true } session) return r;
        var scale = (float)session.ProxyScale;
        return new RectangleF(r.X * scale, r.Y * scale, r.Width * scale, r.Height * scale);
    }

    /// <summary>Preview pixels per document pixel.</summary>
    private float PreviewScale => _session is { UsesProxy: true } s ? (float)s.ProxyScale : 1f;

    /// <summary>What the canvas shows: the edit, or the original while comparing.</summary>
    private ImageBuffer? ShownImage => _comparing && _sourcePreview is { IsDisposed: false } original ? original : _session?.Preview;

    /// <summary>The size the canvas shows its image at, in proxy pixels.</summary>
    private SizeF ShownDisplaySize => _comparing && _sourcePreview is { IsDisposed: false } original
        ? new SizeF(original.Width, original.Height)
        : PreviewDisplaySize;

    /// <summary>
    /// The size the preview is shown at, in proxy pixels: a draft has fewer pixels but covers the same area, so the
    /// canvas, its overlays and the pointer mapping all stay in the proxy's coordinates.
    /// </summary>
    private SizeF PreviewDisplaySize => _session?.Preview is { } preview
        ? new SizeF((float)(preview.Width * _session.ProxyScale / _session.PreviewScale), (float)(preview.Height * _session.ProxyScale / _session.PreviewScale))
        : SizeF.Empty;

    /// <summary>
    /// A render slower than this makes the next ones of a drag drafts: a frame and a half at 60 Hz is roughly where
    /// following the pointer starts to feel heavy.
    /// </summary>
    private static readonly TimeSpan DraftBudget = TimeSpan.FromMilliseconds(25);

    private bool DraftsHelp => _session is { } s && s.DraftScale < s.ProxyScale && s.LastPreviewDuration > DraftBudget;

    protected override async Task OnInitializedAsync()
    {
        _capabilities = await Capabilities.GetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Image is not null && !ReferenceEquals(_loadedParameter, Image))
        {
            _loadedParameter = Image;
            await LoadImageAsync(Image, takeOwnership: false);
        }
        else if (Image is null)
        {
            _loadedParameter = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Fitting needs the size of the editing area, which only exists once the canvas has rendered.
        if (!_fitPending || _canvas is null || _session?.Preview is null) return;
        _fitPending = false;
        _viewport = await _canvas.GetViewportSizeAsync();
        if (_viewport is not { } viewport) return;
        var preview = PreviewDisplaySize;
        const float margin = 24;
        var fit = Math.Min((viewport.Width - margin) / preview.Width, (viewport.Height - margin) / preview.Height);
        _zoom = Math.Clamp(Math.Min(1.0, fit), 0.05, 32);
        _pan = new Vector2(
            (float)((viewport.Width - preview.Width * _zoom) / 2),
            (float)((viewport.Height - preview.Height * _zoom) / 2));
        StateHasChanged();
    }

    private BmageEditorContext BuildContext() => new(this);

    // ---- Loading ----

    private async Task OnFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0) return;
        await RunAsync(async () =>
        {
            var image = await Loader.LoadAsync(files[0]);
            await LoadImageAsync(image, takeOwnership: true);
        });
    }

    /// <summary>Loads an image into the editor, replacing any current session.</summary>
    public async Task LoadImageAsync(ImageBuffer image, bool takeOwnership = true)
    {
        ArgumentNullException.ThrowIfNull(image);
        _session?.Dispose();
        // When the caller keeps ownership the session gets a copy, so disposing the session never frees their buffer.
        var owned = takeOwnership ? image : image.Clone();
        _session = new ImageEditSession(owned, new ImageEditSessionOptions
        {
            MaxProxyDimension = EffectiveProxyDimension,
            MaxHistoryDepth = MaxHistoryDepth,
            TextRasterizer = new SessionTextRasterizer(this),
            // The services' allocator and limits, so a memory budget set there holds for the editor's previews and export too.
            Allocator = Options.Allocator,
            Limits = Options.Limits,
            MaxDegreeOfParallelism = Options.MaxDegreeOfParallelism,
            // On WebAssembly the browser builds the working copy of a large photo in native code: about 30 times
            // faster than resampling it on the interpreter, and the export still replays on the original pixels.
            ProxyScaler = OperatingSystem.IsBrowser() ? ScaleProxyInBrowserAsync : null,
        });
        _selectedId = null;
        _cropRectangle = null;
        _stepCounter = 0;
        _zoom = 1;
        _pan = default;
        _comparing = false;
        _sourcePreview = null;
        _activeLayerId = null;
        _pickingWhiteBalance = false;
        _selection = null;
        _selectionOutline = null;
        await RenderPreviewAsync();
        FitToWindow();
        await OnImageLoaded.InvokeAsync(owned);
        StateHasChanged();
    }

    /// <summary>Loads an image from any source.</summary>
    public Task LoadAsync(ImageSource source) => RunAsync(async () =>
    {
        var image = await Loader.LoadAsync(source);
        await LoadImageAsync(image, takeOwnership: true);
    });

    /// <summary>Loads the image currently on the clipboard, if any.</summary>
    public Task PasteAsync() => RunAsync(async () =>
    {
        var image = await Loader.LoadFromClipboardAsync();
        if (image is null)
        {
            ShowMessage(Strings.NoImage, isError: false);
            return;
        }
        await LoadImageAsync(image, takeOwnership: true);
    });

    [System.Runtime.Versioning.SupportedOSPlatform("browser")]
    private ValueTask<ImageBuffer?> ScaleProxyInBrowserAsync(ImageBuffer source, System.Drawing.Size size, CancellationToken cancellationToken)
        => Bit.Bmage.Interop.BrowserPixels.ScaleAsync(EditorServices.GetRequiredService<Bit.Bmage.Interop.BrowserImageInterop>(), source, size,
            Options.Allocator ?? Bit.Bmage.Memory.PooledPixelAllocator.Shared, cancellationToken);

    // ---- Preview rendering ----

    /// <summary>
    /// Asks for the preview to show the current document, with <paramref name="overlay"/> drawn over it, and completes
    /// once a render that includes this request has finished.
    /// </summary>
    /// <remarks>
    /// Renders never queue up behind each other. A request made while one runs only marks the preview as wanted again,
    /// and the next render shows whatever the document is by then, so a slider dragged faster than frames can render
    /// skips the values in between instead of falling further and further behind the pointer.
    /// </remarks>
    private Task RenderPreviewAsync(Func<ImageDocument, ImageDocument>? overlay = null, bool draft = false, bool refine = false)
    {
        if (_session is null) return Task.CompletedTask;
        _wantedOverlay = overlay;
        _wantedDraft = draft;
        _wantedRefine = refine;
        _renderWanted = true;
        _renderRequests++;
        // Requests wait for the render in flight, so a drag always gets frames, except where that render is not worth
        // finishing: a full one, which can take most of a second on a large photo, once a drag asks for drafts again,
        // and the refinement of a resting drag once anything newer is asked for.
        if (_renderingNow is RenderKind.Refine || (draft && _renderingNow is RenderKind.Full)) CancelQuietly(_renderCts);
        var waiters = _renderWaiters ??= new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        // The loop can finish before returning here (an unchanged document renders synchronously), so whether one is
        // running is a flag it keeps itself rather than the task it returns.
        if (!_renderLoopRunning) _ = RenderLoopAsync();
        return waiters.Task;
    }

    private async Task RenderLoopAsync()
    {
        _renderLoopRunning = true;
        try
        {
            while (_renderWanted && _session is not null)
            {
                _renderWanted = false;
                var overlay = _wantedOverlay;
                var draft = _wantedDraft;
                var waiters = _renderWaiters;
                _renderWaiters = null;
                _renderingNow = draft ? RenderKind.Draft : _wantedRefine ? RenderKind.Refine : RenderKind.Full;
                var error = await RenderOnceAsync(overlay, draft);
                _renderingNow = RenderKind.None;
                if (error is OperationCanceledException)
                {
                    error = null;
                    if (_renderWanted)
                    {
                        // Cancelled for a newer request: the render that request gets answers this one's callers too.
                        if (waiters is not null && _renderWaiters is { } next) _ = next.Task.ContinueWith(_ => waiters.TrySetResult(), TaskScheduler.Default);
                        else _renderWaiters ??= waiters;
                        continue;
                    }
                }
                StateHasChanged();
                waiters?.TrySetResult();
                // Reported once the waiters are released and without holding the loop: a handler that edits or renders
                // in response would otherwise wait for a render that only this loop can start.
                if (error is not null) _ = ReportRenderErrorAsync(error);
                if (draft && !_renderWanted) _ = RefineWhenIdleAsync(_renderRequests, overlay);
                // Let the browser show the frame and deliver the input that arrived meanwhile.
                if (_renderWanted) await Task.Yield();
            }
        }
        finally
        {
            _renderLoopRunning = false;
            _renderWaiters?.TrySetResult();
            _renderWaiters = null;
        }
    }

    /// <summary>
    /// Replaces a draft with the full preview once the pointer rests, even before the drag ends: nothing has asked
    /// for a render since request <paramref name="request"/>.
    /// </summary>
    private async Task RefineWhenIdleAsync(int request, Func<ImageDocument, ImageDocument>? overlay)
    {
        await Task.Delay(200);
        if (request == _renderRequests && _session is not null) await RenderPreviewAsync(overlay, refine: true);
    }

    private async Task ReportRenderErrorAsync(Exception error)
    {
        try
        {
            await ReportErrorAsync(error);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // The host's OnError handler failed in turn; show that rather than losing it.
            ShowMessage(Strings.LoadFailed, isError: true);
        }
    }

    /// <summary>
    /// Renders once and returns the exception the render ended with, if any, for the caller to report: an
    /// <see cref="OperationCanceledException"/> when it was cancelled, which is not a failure.
    /// </summary>
    private async Task<Exception?> RenderOnceAsync(Func<ImageDocument, ImageDocument>? overlay, bool draft)
    {
        if (_session is null) return null;

        // Each render owns exactly one token source and is the only code that disposes it. Newer requests and disposal
        // only cancel it: disposing another call's source would pull the token out from under a render still using it.
        var cts = new CancellationTokenSource();
        CancelQuietly(Interlocked.Exchange(ref _renderCts, cts));
        try
        {
            var preview = draft
                ? await _session.RenderDraftAsync(overlay, cts.Token)
                : await _session.RenderPreviewAsync(overlay, cts.Token);
            // Rendering an unchanged document hands back the preview already on screen, which needs no repaint.
            if (!ReferenceEquals(preview, _shownPreview))
            {
                _shownPreview = preview;
                _previewVersion++;
            }
        }
        catch (Exception ex)
        {
            return ex;
        }
        finally
        {
            Interlocked.CompareExchange(ref _renderCts, null, cts);
            cts.Dispose();
        }
        return null;
    }

    /// <summary>
    /// Cancels a token source owned by another render. That render may already have finished and disposed it, which
    /// is not an error: a finished render has nothing left to cancel.
    /// </summary>
    private static void CancelQuietly(CancellationTokenSource? cts)
    {
        if (cts is null) return;
        try { cts.Cancel(); }
        catch (ObjectDisposedException) { /* the owning render already completed */ }
    }

    /// <summary>What the render in flight draws, which decides whether a newer request cancels it.</summary>
    private enum RenderKind { None, Full, Draft, Refine }

    private async Task ApplyAndRenderAsync(Func<ImageDocument, ImageDocument> change, string label, bool transient = false)
    {
        if (_session is null) return;
        // An edit made while comparing is an edit the user wants to see.
        if (_comparing) _comparing = false;
        if (transient) _session.ApplyTransient(change, label);
        else _session.Apply(change, label);
        // While a control is dragged, a slow preview gives way to a draft; the release renders it in full.
        await RenderPreviewAsync(draft: transient && DraftsHelp);
        // The selection's outline is traced on the preview, so it follows the image once the edit is shown: a crop or a
        // turn has moved it, and a selection by colour may cover something else now.
        if (!transient && _selection is not null) _ = UpdateSelectionOutlineAsync();
        await NotifyDocumentChangedAsync();
        StateHasChanged();
    }

    /// <summary>Raises <see cref="OnDocumentChanged"/> once per document, however many edits waited for one render.</summary>
    private async Task NotifyDocumentChangedAsync()
    {
        if (_session?.Document is not { } document || ReferenceEquals(document, _notifiedDocument)) return;
        _notifiedDocument = document;
        await OnDocumentChanged.InvokeAsync(document);
    }

    // ---- Pointer interaction ----

    private async Task OnDragStart(CanvasPointerArgs e)
    {
        if (_session is null) return;
        // The original is only to look at: everything but panning waits until the comparison ends.
        if (_comparing && _tool != EditorToolKind.Pan) return;
        // Crop works on the preview (ApplyCropAsync maps it to full resolution); everything else edits the document.
        var point = _tool == EditorToolKind.Crop ? e.Point : ToDocument(e.Point);
        switch (_tool)
        {
            case EditorToolKind.Pan:
                _drag = new ToolDrag { Start = point, Current = point };
                _panLast = e.Screen;
                break;

            case EditorToolKind.Crop:
                if (_cropRectangle is null)
                {
                    _cropRectangle = new RectangleF(point.X, point.Y, 0, 0);
                    _drag = new ToolDrag { Start = point, Current = point, ShiftKey = e.ShiftKey };
                }
                else if (e.Handle is null)
                {
                    // Dragging inside the existing rectangle moves it.
                    _cropHandle = _cropRectangle.Value.Contains(point.X, point.Y) ? CropHandle.Move : null;
                    _cropStart = _cropRectangle.Value;
                    _drag = new ToolDrag { Start = point, Current = point };
                }
                break;

            case EditorToolKind.Select:
                var hit = _session.Document.HitTest(point, 6f / (float)Math.Max(_zoom, 0.01) / PreviewScale);
                _selectedId = hit?.Id;
                if (hit is not null)
                {
                    _selectionDragOrigin = point;
                    _drag = new ToolDrag { Start = point, Current = point };
                }
                break;

            case EditorToolKind.Text:
                WarnIfTextCannotRender();
                await AddTextAnnotationAsync(point);
                break;

            case EditorToolKind.Step:
                WarnIfTextCannotRender();
                _stepCounter++;
                await ApplyAndRenderAsync(d => d.AddAnnotation(new StepAnnotation
                {
                    Center = point,
                    Number = _stepCounter,
                    Radius = Math.Max(12f, _settings.StrokeWidth * 4),
                    BackgroundColor = _settings.StrokeColor,
                    TextStyle = _settings.ToTextStyle() with
                    {
                        Alignment = TextAlignment.Center,
                        Baseline = TextBaseline.Middle,
                        Bold = true,
                        FillColor = Rgba32.White,
                    },
                }), Strings.Step);
                break;

            case EditorToolKind.Brush or EditorToolKind.Eraser:
                _drag = new ToolDrag { Start = point, Current = point };
                _drag.Points.Add(point);
                if (e.IsPen) _drag.Pressures.Add(e.Pressure);
                await RenderStrokePreviewAsync();
                break;

            case EditorToolKind.Eyedropper:
                await PickColorAsync(e.Point);
                break;

            case EditorToolKind.Fill:
                await FillAsync(point);
                break;

            case EditorToolKind.MagicEraser:
                await MagicEraseAsync(point);
                break;

            case EditorToolKind.SelectRectangle or EditorToolKind.SelectEllipse or EditorToolKind.Lasso:
                // Shift adds to the selection and Alt takes away from it, decided when the drag starts.
                _selectionMode = e.ShiftKey ? SelectionMode.Add : e.AltKey ? SelectionMode.Subtract : SelectionMode.Replace;
                _drag = new ToolDrag { Start = point, Current = point };
                _drag.Points.Add(point);
                break;

            case EditorToolKind.MagicWand:
                _selectionMode = e.ShiftKey ? SelectionMode.Add : e.AltKey ? SelectionMode.Subtract : SelectionMode.Replace;
                CombineSelection(new FloodMask([point]) { Tolerance = _settings.Tolerance });
                break;

            default:
                if (EditorTools.BuiltIn.ContainsKey(_tool))
                {
                    _drag = new ToolDrag { Start = point, Current = point, ShiftKey = e.ShiftKey, AltKey = e.AltKey };
                    _drag.Points.Add(point);
                }
                break;
        }
        StateHasChanged();
    }

    private async Task OnDragMove(CanvasPointerArgs e)
    {
        if (_session is null || _drag is null) return;
        var point = _tool == EditorToolKind.Crop ? e.Point : ToDocument(e.Point);
        _drag.Current = point;
        _drag.ShiftKey = e.ShiftKey;
        _drag.AltKey = e.AltKey;

        switch (_tool)
        {
            case EditorToolKind.Pan:
                // Measured on screen: image coordinates move under the pointer as the view pans.
                _pan += e.Screen - _panLast;
                _panLast = e.Screen;
                StateHasChanged();
                return;

            case EditorToolKind.Crop:
                UpdateCropRectangle(point);
                StateHasChanged();
                return;

            case EditorToolKind.Brush or EditorToolKind.Eraser:
                AddSmoothedPoint(point, e.IsPen ? e.Pressure : null);
                await RenderStrokePreviewAsync();
                return;

            case EditorToolKind.SelectRectangle or EditorToolKind.SelectEllipse or EditorToolKind.Lasso:
                if (_tool == EditorToolKind.Lasso) AddSmoothedPoint(point);
                // The shape being drawn, outlined straight from the drag: tracing a mask waits for the release.
                _selectionOutline = ShapePath(_drag);
                StateHasChanged();
                return;

            case EditorToolKind.Select when _selectedId is { } id:
            {
                var delta = point - _selectionDragOrigin;
                if (delta.LengthSquared() < 0.01f) return;
                _selectionDragOrigin = point;
                var annotation = _session.Document.FindAnnotation(id);
                if (annotation is null || annotation.IsLocked) return;
                await ApplyAndRenderAsync(d => d.UpdateAnnotation(annotation.Translate(delta.X, delta.Y)), Strings.Select, transient: true);
                return;
            }

            default:
                if (EditorTools.BuiltIn.TryGetValue(_tool, out var tool))
                {
                    if (_tool == EditorToolKind.Draw) AddSmoothedPoint(point);
                    _dragPreview = tool.BuildPreview(_drag, _settings);
                    await RenderWithPreviewAsync();
                }
                return;
        }
    }

    private async Task OnDragEnd(CanvasPointerArgs e)
    {
        if (_session is null || _drag is null) return;
        var drag = _drag;
        _drag = null;
        _cropHandle = null;
        _dragPreview = null;

        switch (_tool)
        {
            case EditorToolKind.Pan or EditorToolKind.Crop:
                StateHasChanged();
                return;

            case EditorToolKind.Select:
                if (_selectedId is not null) _session.Commit(Strings.Select);
                StateHasChanged();
                return;

            case EditorToolKind.Brush or EditorToolKind.Eraser:
                // A pen lifts with no pressure, so the stroke ends at the last point it was pressed down on.
                await PaintStrokeAsync(drag);
                return;

            case EditorToolKind.SelectRectangle or EditorToolKind.SelectEllipse or EditorToolKind.Lasso:
                if (SelectionShape(drag) is { } shape) CombineSelection(shape);
                // A click that drew nothing deselects, as in other editors; with Shift or Alt it changes nothing.
                else if (_selectionMode == SelectionMode.Replace) SetSelection(null);
                else _ = UpdateSelectionOutlineAsync();
                return;

            default:
                if (EditorTools.BuiltIn.TryGetValue(_tool, out var tool))
                {
                    drag.Current = ToDocument(e.Point);
                    var annotation = tool.BuildFinal(drag, _settings);
                    if (annotation is not null)
                    {
                        await ApplyAndRenderAsync(d => d.AddAnnotation(annotation with { Opacity = _settings.Opacity }), ToolLabel(_tool));
                        _selectedId = annotation.Id;
                    }
                    else
                    {
                        await RenderPreviewAsync();
                        StateHasChanged();
                    }
                }
                return;
        }
    }

    /// <summary>
    /// Renders the preview with the in-progress shape drawn on top, without touching the document or history.
    /// </summary>
    private async Task RenderWithPreviewAsync()
    {
        if (_session is null) return;
        var preview = _dragPreview;
        if (preview is null) { await RenderPreviewAsync(); return; }
        // Drawn as an overlay, so the document and its history never contain a half-finished shape.
        await RenderPreviewAsync(d => d.AddAnnotation(preview));
        StateHasChanged();
    }

    /// <summary>
    /// Adds a freehand point, skipping ones too close to the last to keep the stroke small and smooth, with the pen
    /// pressure at it when a pen drew the stroke from its start.
    /// </summary>
    private void AddSmoothedPoint(Vector2 point, float? pressure = null)
    {
        if (_drag is null) return;
        var minimumSpacing = 1.5f / (float)Math.Max(_zoom, 0.05) / PreviewScale;
        if (_drag.Points.Count > 0 && Vector2.Distance(_drag.Points[^1], point) < minimumSpacing) return;
        var pressed = _drag.Pressures.Count == _drag.Points.Count && _drag.Points.Count > 0;
        _drag.Points.Add(point);
        if (pressed) _drag.Pressures.Add(pressure ?? _drag.Pressures[^1]);
    }

    // ---- Painting and picking ----

    /// <summary>
    /// Shows the stroke being painted as a line over the kept preview, which costs a line rather than a composite of the
    /// layers per pointer move; the stroke itself, with its hardness and pressure, is painted when the pointer lifts.
    /// </summary>
    private async Task RenderStrokePreviewAsync()
    {
        if (_drag is null) return;
        var erase = _tool == EditorToolKind.Eraser;
        var color = erase ? new Rgba32(255, 255, 255, 150) : _settings.StrokeColor.WithAlpha((byte)Math.Round(255 * Math.Clamp(_settings.Opacity, 0f, 1f)));
        _dragPreview = new FreehandAnnotation
        {
            Points = [.. _drag.Points],
            Style = new ShapeStyle
            {
                StrokeColor = color,
                FillColor = null,
                Stroke = new StrokeStyle { Width = _settings.BrushSize, Cap = LineCap.Round, Join = LineJoin.Round },
            },
        };
        await RenderWithPreviewAsync();
    }

    /// <summary>Paints a finished stroke onto the paint layer, adding one on top when there is none to paint on.</summary>
    private async Task PaintStrokeAsync(ToolDrag drag)
    {
        if (_session is null) return;
        var erase = _tool == EditorToolKind.Eraser;
        var target = FindPaintLayer(_session.Document);
        if (drag.Points.Count == 0 || (target is null && erase))
        {
            if (erase) ShowMessage(Strings.NoPaintLayer, isError: false);
            await RenderPreviewAsync();
            StateHasChanged();
            return;
        }
        var stroke = new PaintStroke(drag.Points, _settings.BrushSize, _settings.StrokeColor.WithAlpha(255))
        {
            Pressures = drag.Pressures.Count == drag.Points.Count ? drag.Pressures : null,
            Opacity = _settings.Opacity,
            Hardness = _settings.BrushHardness,
            Erase = erase,
        };
        var layer = (target ?? new PaintLayer { Name = Strings.Paint }).Add(stroke);
        await ApplyAndRenderAsync(d => target is null ? d.AddLayer(layer) : d.UpdateLayer(layer), erase ? Strings.Eraser : Strings.Brush);
        _activeLayerId = layer.Id;
    }

    /// <summary>The paint layer strokes go to: the selected layer when it is an unlocked paint layer, else the topmost one.</summary>
    private PaintLayer? FindPaintLayer(ImageDocument document)
    {
        if (_activeLayerId is { } id && document.FindLayer(id) is PaintLayer { IsLocked: false } active) return active;
        for (var i = document.Layers.Count - 1; i >= 0; i--)
            if (document.Layers[i] is PaintLayer { IsLocked: false } paint) return paint;
        return null;
    }

    /// <summary>
    /// Picks the colour shown under the pointer, averaged over three pixels square, for the drawing tools, or as the
    /// neutral of a white balance when one was asked for.
    /// </summary>
    private async Task PickColorAsync(Vector2 previewPoint)
    {
        if (_session?.Preview is not { IsDisposed: false } preview) return;
        // A draft has fewer pixels than the proxy whose coordinates the pointer reports.
        var factor = (float)(_session.PreviewScale / _session.ProxyScale);
        var color = ColorSampler.Sample(preview, new Point((int)MathF.Floor(previewPoint.X * factor), (int)MathF.Floor(previewPoint.Y * factor)), radius: 1);
        if (_pickingWhiteBalance)
        {
            _pickingWhiteBalance = false;
            _tool = EditorToolKind.Select;
            // The preview shows any earlier white balance already, so the new correction is made on top of it.
            var correction = WhiteBalanceAdjustment.FromNeutral(color);
            var existing = _session.Document.Pipeline.OfType<WhiteBalanceAdjustment>().FirstOrDefault();
            var combined = existing is null ? correction
                : new WhiteBalanceAdjustment(existing.RedGain * correction.RedGain, existing.GreenGain * correction.GreenGain, existing.BlueGain * correction.BlueGain);
            await SetAdjustmentAsync(combined, Strings.WhiteBalance);
            return;
        }
        _settings = _settings with { StrokeColor = color.WithAlpha(255), FillColor = color.WithAlpha(_settings.FillColor.A) };
        ShowMessage(Strings.FormatPickedColor(color.WithAlpha(255).ToHex(false)), isError: false);
    }

    /// <summary>Fills the region of similar colour under the pointer, in the image as it is composited so far, as a layer.</summary>
    private Task FillAsync(Vector2 point) => ApplyAndRenderAsync(d => d.AddLayer(new FillLayer(_settings.FillColor.WithAlpha(255))
    {
        Name = Strings.Fill,
        Opacity = _settings.Opacity,
        Mask = new FloodMask([point]) { Tolerance = _settings.Tolerance },
    }), Strings.Fill);

    /// <summary>Makes the region of similar colour under the pointer transparent.</summary>
    private Task MagicEraseAsync(Vector2 point) => ApplyAndRenderAsync(
        d => d.AddOperation(new AlphaMaskOperation(new FloodMask([point]) { Tolerance = _settings.Tolerance, Inverted = true })),
        Strings.MagicEraser);

    // ---- The pixel selection ----

    /// <summary>The shape a selection drag drew, in output coordinates, or null when it drew nothing.</summary>
    private Mask? SelectionShape(ToolDrag drag)
    {
        if (_tool == EditorToolKind.Lasso)
            return drag.Points.Count >= 3 ? new PolygonMask([.. drag.Points]) : null;
        var rect = RectangleF.FromLTRB(MathF.Min(drag.Start.X, drag.Current.X), MathF.Min(drag.Start.Y, drag.Current.Y),
            MathF.Max(drag.Start.X, drag.Current.X), MathF.Max(drag.Start.Y, drag.Current.Y));
        if (rect.Width < 2 || rect.Height < 2) return null;
        return _tool == EditorToolKind.SelectEllipse ? new EllipseMask(rect) : new RectangleMask(rect);
    }

    /// <summary>The outline of the shape a selection drag is drawing, as SVG path data in the canvas's coordinates.</summary>
    private string? ShapePath(ToolDrag? drag)
    {
        if (drag is null || _session is null) return null;
        var scale = PreviewScale;
        static string N(float v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        if (_tool == EditorToolKind.Lasso)
        {
            if (drag.Points.Count < 2) return null;
            var path = new System.Text.StringBuilder();
            for (var i = 0; i < drag.Points.Count; i++)
                path.Append(i == 0 ? 'M' : 'L').Append(N(drag.Points[i].X * scale)).Append(' ').Append(N(drag.Points[i].Y * scale));
            return path.Append('Z').ToString();
        }
        float x0 = MathF.Min(drag.Start.X, drag.Current.X) * scale, y0 = MathF.Min(drag.Start.Y, drag.Current.Y) * scale;
        float x1 = MathF.Max(drag.Start.X, drag.Current.X) * scale, y1 = MathF.Max(drag.Start.Y, drag.Current.Y) * scale;
        if (_tool == EditorToolKind.SelectRectangle) return $"M{N(x0)} {N(y0)}H{N(x1)}V{N(y1)}H{N(x0)}Z";
        var rx = (x1 - x0) / 2;
        var ry = (y1 - y0) / 2;
        return $"M{N(x0)} {N(y0 + ry)}a{N(rx)} {N(ry)} 0 1 0 {N(2 * rx)} 0a{N(rx)} {N(ry)} 0 1 0 {N(-2 * rx)} 0Z";
    }

    /// <summary>Adds a shape to the selection, takes it away, or makes it the selection, as the drag started.</summary>
    private void CombineSelection(Mask shape)
    {
        var combined = _selectionMode switch
        {
            SelectionMode.Add when _selection is { } current => current.Union(shape),
            SelectionMode.Subtract when _selection is { } current => current.Subtract(shape),
            SelectionMode.Subtract => null,
            _ => shape,
        };
        SetSelection(combined);
    }

    /// <summary>The pixel selection, in output coordinates, or null when nothing is selected.</summary>
    public Mask? Selection => _selection;

    /// <summary>Sets the pixel selection the selection actions work on, or clears it with null.</summary>
    public void SetSelection(Mask? selection)
    {
        _selection = selection;
        _ = UpdateSelectionOutlineAsync();
        StateHasChanged();
    }

    /// <summary>Selects the whole image.</summary>
    public void SelectAll() => SetSelection(Mask.All());

    /// <summary>Selects everything that is not selected.</summary>
    public void InvertSelection()
    {
        if (_selection is { } selection) SetSelection(selection.Invert());
    }

    /// <summary>Makes the selected pixels transparent, keeping the selection.</summary>
    public Task ClearSelectionAsync()
        => _selection is { } selection
            ? ApplyAndRenderAsync(d => d.AddOperation(new AlphaMaskOperation(selection.Invert())), Strings.ClearSelection)
            : Task.CompletedTask;

    /// <summary>Fills the selection with the fill colour, as a layer at the drawing opacity.</summary>
    public Task FillSelectionAsync()
        => _selection is { } selection
            ? ApplyAndRenderAsync(d => d.AddLayer(new FillLayer(_settings.FillColor.WithAlpha(255)) { Name = Strings.FillSelection, Opacity = _settings.Opacity, Mask = selection }), Strings.FillSelection)
            : Task.CompletedTask;

    /// <summary>Crops the image to the bounds of the selected pixels, carrying the overlays and the selection along.</summary>
    public Task CropToSelectionAsync() => RunAsync(async () =>
    {
        if (_session is not { } session || _selection is not { } selection) return;
        var document = session.Document;
        var bounds = await SelectedBoundsAsync(selection);
        // Measured on the image and selection as they were: if either changed meanwhile, the bounds would crop something else.
        if (!IsStill(session, document) || !ReferenceEquals(_selection, selection)) return;
        if (bounds is not { } area)
        {
            ShowMessage(Strings.NothingSelected, isError: false);
            return;
        }
        var crop = new CropOperation(area);
        MoveSelectionWith(crop);
        await ApplyAndRenderAsync(d => d.AddOperation(crop, keepOverlaysAttached: true), Strings.CropToSelection);
        FitToWindow();
    });

    /// <summary>
    /// Copies the selected pixels, as the image is composited with its layers and annotations, into a new image layer
    /// in the same place, and selects the layer: the "layer via copy" of photo editors.
    /// </summary>
    public Task CopySelectionToLayerAsync() => RunAsync(async () =>
    {
        if (_session is not { } session || _selection is not { } selection) return;
        var document = session.Document;
        ImageBuffer? piece = null;
        Rectangle area;
        using (var rendered = await session.RenderFullAsync())
        {
            if (!IsStill(session, document) || !ReferenceEquals(_selection, selection)) return;
            using var coverage = selection.Render(rendered.Size, rendered);
            area = coverage.GetBounds();
            if (area.IsEmptyArea())
            {
                ShowMessage(Strings.NothingSelected, isError: false);
                return;
            }
            piece = rendered.CopyRegion(area);
            try
            {
                // The copy keeps what the selection covers, its soft edge included.
                for (var y = 0; y < area.Height; y++)
                {
                    var row = piece.GetRow(y);
                    var cover = coverage.GetRow(area.Y + y).Slice(area.X, area.Width);
                    for (var x = 0; x < row.Length; x++) row[x] = row[x].WithAlpha((byte)((row[x].A * cover[x] + 127) / 255));
                }
                session.Own(piece);
            }
            catch
            {
                piece.Dispose();
                throw;
            }
        }
        var layer = new ImageLayer { Image = piece, Bounds = new RectangleF(area.X, area.Y, area.Width, area.Height), Name = Strings.CopyToLayer };
        await ApplyAndRenderAsync(d => d.AddLayer(layer), Strings.CopyToLayer);
        _activeLayerId = layer.Id;
    });

    /// <summary>
    /// The bounds of the pixels a selection covers, in output coordinates, or null when it covers none. A selection by
    /// colour is measured on the image at full resolution, as it looks with its layers and annotations.
    /// </summary>
    private async Task<Rectangle?> SelectedBoundsAsync(Mask selection)
    {
        if (_session is null || !_session.Document.TryGetOutputSize(out var size)) return null;
        using var rendered = await _session.RenderFullAsync();
        using var coverage = selection.Render(size, rendered);
        var bounds = coverage.GetBounds();
        return bounds.IsEmptyArea() ? null : bounds;
    }

    /// <summary>
    /// True when <paramref name="session"/> is still the editor's and still shows <paramref name="document"/>: what was
    /// worked out from the image before an await only applies to the image it was worked out from, and an undo, a slider
    /// or another image may have come in between.
    /// </summary>
    private bool IsStill(ImageEditSession session, ImageDocument document) => ReferenceEquals(_session, session) && ReferenceEquals(session.Document, document);

    /// <summary>
    /// Carries the selection from what one document shows to what another shows, after an undo, a redo or a jump through
    /// the history: the steps the two pipelines do not share are undone and redone on it, and it is dropped when what
    /// they do to coordinates cannot be said.
    /// </summary>
    private void FollowSelection(ImageDocument from, ImageDocument to)
    {
        if (_selection is not { } selection || ReferenceEquals(from.Pipeline, to.Pipeline)) return;
        var shared = 0;
        while (shared < from.Pipeline.Count && shared < to.Pipeline.Count && ReferenceEquals(from.Pipeline[shared], to.Pipeline[shared])) shared++;
        if (from.SourceSize == to.SourceSize
            && ImagePipeline.From(from.Pipeline.Take(shared)).TryGetOutputSize(from.SourceSize, out var size)
            && ImagePipeline.From(from.Pipeline.Skip(shared)).TryGetTransform(size, out var before)
            && ImagePipeline.From(to.Pipeline.Skip(shared)).TryGetTransform(size, out var after)
            && Matrix3x2.Invert(before, out var undo))
        {
            var change = undo * after;
            if (!change.IsIdentity) SetSelection(selection.Transform(change));
        }
        else
        {
            SetSelection(null);
        }
    }

    /// <summary>Moves the selection the way appending <paramref name="operation"/> moves the image, or drops it when that cannot be said.</summary>
    private void MoveSelectionWith(IImageOperation operation)
    {
        if (_selection is not { } selection || _session is null) return;
        if (operation is IGeometricOperation geometric && _session.Document.TryGetOutputSize(out var size) && geometric.GetTransform(size) is { } matrix)
            SetSelection(selection.Transform(matrix));
        else
            SetSelection(null);
    }

    /// <summary>
    /// Traces the selection's outline for the canvas: rendered at the preview's resolution, from the preview for a
    /// selection by colour, and traced at most 640 pixels across, which is detailed enough for marching ants and cheap
    /// enough on the interpreter. Only the latest request publishes its outline.
    /// </summary>
    private async Task UpdateSelectionOutlineAsync()
    {
        var version = ++_outlineVersion;
        if (_selection is not { } selection || _session?.Preview is not { IsDisposed: false } preview)
        {
            _selectionOutline = null;
            return;
        }
        string? path = null;
        try
        {
            await Task.Yield();
            if (version != _outlineVersion || preview.IsDisposed) return;
            // Drawn on a copy of the preview at most 640 pixels across, not traced from a full one shrunk afterwards: a
            // selection by colour floods a tenth of the pixels that way, which is what keeps it quick on the interpreter.
            var factor = Math.Min(1.0, 640.0 / Math.Max(preview.Width, preview.Height));
            using var small = factor < 1
                ? new ResizeOperation(Math.Max(1, (int)Math.Round(preview.Width * factor)), Math.Max(1, (int)Math.Round(preview.Height * factor)), ResizeMode.Stretch, ResamplingFilter.Box)
                    .Apply(preview, new OperationContext(Options.Allocator, Options.Limits).WithMutation(false))
                : null;
            var source = small ?? preview;
            var scale = _session.PreviewScale * source.Width / preview.Width;
            using var traced = selection.ForScale(scale).Render(source.Size, source);
            var curves = MaskContours.Trace(traced, maxPoints: 40_000);
            // From the traced mask's pixels to the preview's, then to the proxy's, which the canvas is laid out in.
            var toCanvas = (float)(preview.Width / (double)traced.Width * _session.ProxyScale / _session.PreviewScale);
            var builder = new System.Text.StringBuilder();
            foreach (var curve in curves)
            {
                for (var i = 0; i < curve.Length; i++)
                {
                    builder.Append(i == 0 ? 'M' : 'L');
                    builder.Append((curve[i].X * toCanvas).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)).Append(' ');
                    builder.Append((curve[i].Y * toCanvas).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture));
                }
                builder.Append('Z');
            }
            path = builder.ToString();
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // A selection that cannot be drawn is still a selection; the actions on it report their own errors.
            path = null;
        }
        if (version != _outlineVersion) return;
        _selectionOutline = path;
        StateHasChanged();
    }

    private async Task AddTextAnnotationAsync(Vector2 point)
    {
        // A real editor would open an inline text box; the built-in flow adds placeholder text the user then edits
        // through the panel, which keeps the component free of a modal dialog.
        var annotation = new TextAnnotation
        {
            Text = Strings.Text,
            Position = point,
            Style = _settings.ToTextStyle(),
        };
        await ApplyAndRenderAsync(d => d.AddAnnotation(annotation), Strings.Text);
        _selectedId = annotation.Id;
    }

    /// <summary>
    /// Text and step numbers are drawn as glyph outlines, which needs a font. Without one they would be added but
    /// invisible, so say why instead of leaving the user to wonder.
    /// </summary>
    private void WarnIfTextCannotRender()
    {
        if (EffectiveTextRasterizer is null) ShowMessage(Strings.TextNeedsFont, isError: false);
    }

    /// <summary>
    /// The rasteriser given to the session. The injected font rasteriser throws when asked to draw without a font, which
    /// would fail every render containing text, so it is only used once a font has been registered; until then text is
    /// skipped and <see cref="WarnIfTextCannotRender"/> explains why.
    /// </summary>
    private ITextRasterizer? EffectiveTextRasterizer => TextRasterizer ?? (FontRasterizer.HasFonts ? FontRasterizer : null);

    /// <summary>
    /// What a session draws text with: <see cref="EffectiveTextRasterizer"/>, looked up on every call rather than once
    /// when the image was opened. A font registered later - an app that fetches one in the background - or a
    /// <see cref="TextRasterizer"/> set later then draws from the next render, and <see cref="RefreshAsync"/> redraws
    /// the text already there. Until there is one, text is skipped as it is with no rasteriser at all.
    /// </summary>
    private sealed class SessionTextRasterizer(BmageEditor editor) : ITextRasterizer
    {
        public TextMetrics Measure(string text, TextStyle style) => editor.EffectiveTextRasterizer?.Measure(text, style) ?? default;

        public VectorPath? GetTextPath(string text, Vector2 origin, TextStyle style) => editor.EffectiveTextRasterizer?.GetTextPath(text, origin, style);
    }

    private void UpdateCropRectangle(Vector2 point)
    {
        if (_session is null) return;
        var shown = PreviewDisplaySize;
        var bounds = shown.IsEmpty ? new RectangleF(PointF.Empty, _session.ProxySize) : new RectangleF(PointF.Empty, shown);
        if (_cropHandle is { } handle && handle != CropHandle.Move)
        {
            var r = _cropStart;
            var left = r.Left; var top = r.Top; var right = r.Right; var bottom = r.Bottom;
            if (handle is CropHandle.TopLeft or CropHandle.Left or CropHandle.BottomLeft) left = point.X;
            if (handle is CropHandle.TopRight or CropHandle.Right or CropHandle.BottomRight) right = point.X;
            if (handle is CropHandle.TopLeft or CropHandle.Top or CropHandle.TopRight) top = point.Y;
            if (handle is CropHandle.BottomLeft or CropHandle.Bottom or CropHandle.BottomRight) bottom = point.Y;
            var rect = RectangleF.FromLTRB(MathF.Min(left, right), MathF.Min(top, bottom), MathF.Max(left, right), MathF.Max(top, bottom));
            _cropRectangle = ApplyAspect(Clamp(rect, bounds));
        }
        else if (_cropHandle == CropHandle.Move && _drag is not null)
        {
            var delta = point - _drag.Start;
            var moved = new RectangleF(_cropStart.X + delta.X, _cropStart.Y + delta.Y, _cropStart.Width, _cropStart.Height);
            moved.X = Math.Clamp(moved.X, bounds.Left, Math.Max(bounds.Left, bounds.Right - moved.Width));
            moved.Y = Math.Clamp(moved.Y, bounds.Top, Math.Max(bounds.Top, bounds.Bottom - moved.Height));
            _cropRectangle = moved;
        }
        else if (_drag is not null)
        {
            _cropRectangle = ApplyAspect(Clamp(_drag.Rectangle, bounds));
        }
    }

    private RectangleF ApplyAspect(RectangleF rect)
    {
        if (_cropAspect is not { } aspect || rect.Width <= 0 || rect.Height <= 0) return rect;
        var target = aspect.Value;
        var current = rect.Width / rect.Height;
        if (current > target) rect.Width = rect.Height * (float)target;
        else rect.Height = rect.Width / (float)target;
        return rect;
    }

    private static RectangleF Clamp(RectangleF rect, RectangleF bounds)
        => RectangleF.FromLTRB(
            Math.Clamp(rect.Left, bounds.Left, bounds.Right),
            Math.Clamp(rect.Top, bounds.Top, bounds.Bottom),
            Math.Clamp(rect.Right, bounds.Left, bounds.Right),
            Math.Clamp(rect.Bottom, bounds.Top, bounds.Bottom));

    private async Task OnCropHandleDown(CropHandleArgs e)
    {
        _cropHandle = e.Handle;
        _cropStart = _cropRectangle ?? default;
        _drag = new ToolDrag { Start = e.Pointer.Point, Current = e.Pointer.Point };
        await Task.CompletedTask;
    }

    private void OnZoomGesture(ZoomArgs e)
    {
        var next = Math.Clamp(_zoom * e.Factor, 0.05, 32);
        // Keep the focal point stationary on screen.
        var before = e.Focus * (float)_zoom;
        var after = e.Focus * (float)next;
        _pan += before - after;
        _zoom = next;
        StateHasChanged();
    }

    private async Task OnKeyPressed(KeyboardEventArgs e)
    {
        if (_session is null) return;
        var ctrl = e.CtrlKey || e.MetaKey;
        switch (e.Key)
        {
            case "z" or "Z" when ctrl && !e.ShiftKey:
                Undo();
                break;
            case "y" or "Y" when ctrl:
            case "z" or "Z" when ctrl && e.ShiftKey:
                Redo();
                break;
            case "Delete" or "Backspace" when _selectedId is { } id:
                await DeleteAnnotationAsync(id);
                break;
            case "Delete" or "Backspace" when _selection is not null:
                await ClearSelectionAsync();
                break;
            case "a" or "A" when ctrl:
                SelectAll();
                break;
            case "d" or "D" when ctrl:
                SetSelection(null);
                break;
            case "i" or "I" when ctrl && e.ShiftKey:
                InvertSelection();
                break;
            case "Escape":
                _selectedId = null;
                if (_tool == EditorToolKind.Crop) _cropRectangle = null;
                if (_selection is not null) SetSelection(null);
                break;
            case "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown" when _selectedId is { } moveId:
            {
                var step = e.ShiftKey ? 10f : 1f;
                var delta = e.Key switch
                {
                    "ArrowLeft" => new Vector2(-step, 0),
                    "ArrowRight" => new Vector2(step, 0),
                    "ArrowUp" => new Vector2(0, -step),
                    _ => new Vector2(0, step),
                };
                var annotation = _session.Document.FindAnnotation(moveId);
                if (annotation is not null && !annotation.IsLocked)
                    await ApplyAndRenderAsync(d => d.UpdateAnnotation(annotation.Translate(delta.X, delta.Y)), Strings.Select);
                break;
            }
            case "+" or "=":
                OnZoomGesture(new ZoomArgs(1.2, ViewCentre()));
                break;
            case "-" or "_":
                OnZoomGesture(new ZoomArgs(1 / 1.2, ViewCentre()));
                break;
            case "0" when ctrl:
                FitToWindow();
                break;
            case "\\":
                await SetCompareAsync(!_comparing);
                break;
            case "[" when _tool is EditorToolKind.Brush or EditorToolKind.Eraser:
                _settings = _settings with { BrushSize = Math.Max(1, _settings.BrushSize / 1.2f) };
                break;
            case "]" when _tool is EditorToolKind.Brush or EditorToolKind.Eraser:
                _settings = _settings with { BrushSize = Math.Min(1000, _settings.BrushSize * 1.2f) };
                break;
        }
        StateHasChanged();
    }

    /// <summary>The image point at the centre of the visible area, used as the focus of non-pointer zooming.</summary>
    private Vector2 ViewCentre()
    {
        var shown = PreviewDisplaySize;
        var viewport = _viewport ?? new SizeF((float)(shown.Width * _zoom), (float)(shown.Height * _zoom));
        return (new Vector2(viewport.Width / 2, viewport.Height / 2) - _pan) / (float)_zoom;
    }

    // History labels are shown to the user, so they come from the localised strings rather than the enum names.
    private string ToolLabel(EditorToolKind kind) => kind switch
    {
        EditorToolKind.Draw => Strings.Draw,
        EditorToolKind.Line => Strings.Line,
        EditorToolKind.Arrow => Strings.Arrow,
        EditorToolKind.Rectangle => Strings.Rectangle,
        EditorToolKind.Ellipse => Strings.Ellipse,
        EditorToolKind.Highlight => Strings.Highlight,
        EditorToolKind.Redact => Strings.Redact,
        EditorToolKind.Text => Strings.Text,
        EditorToolKind.Step => Strings.Step,
        EditorToolKind.Brush => Strings.Brush,
        EditorToolKind.Eraser => Strings.Eraser,
        EditorToolKind.Eyedropper => Strings.Eyedropper,
        EditorToolKind.Fill => Strings.Fill,
        EditorToolKind.MagicEraser => Strings.MagicEraser,
        EditorToolKind.SelectRectangle => Strings.SelectRectangle,
        EditorToolKind.SelectEllipse => Strings.SelectEllipse,
        EditorToolKind.Lasso => Strings.Lasso,
        EditorToolKind.MagicWand => Strings.MagicWand,
        _ => kind.ToString(),
    };

    // ---- Public actions, also used by custom toolbars ----

    /// <summary>The active tool.</summary>
    public EditorToolKind Tool => _tool;

    /// <summary>The current drawing settings.</summary>
    public EditorToolSettings Settings => _settings;

    /// <summary>The detected browser capabilities.</summary>
    public ImageCapabilities? BrowserCapabilities => _capabilities;

    /// <summary>Current zoom factor.</summary>
    public double Zoom => _zoom;

    /// <summary>True while an operation is running.</summary>
    public bool IsBusy => _busy;

    /// <summary>The id of the selected annotation, if any.</summary>
    public Guid? SelectedAnnotationId => _selectedId;

    /// <summary>Switches the active tool.</summary>
    public void SetTool(EditorToolKind tool)
    {
        _tool = tool;
        if (tool != EditorToolKind.Eyedropper) _pickingWhiteBalance = false;
        if (tool != EditorToolKind.Crop) _cropRectangle = null;
        if (tool != EditorToolKind.Select) _selectedId = null;
        StateHasChanged();
    }

    /// <summary>Updates the drawing settings.</summary>
    public void SetSettings(EditorToolSettings settings)
    {
        _settings = settings ?? new EditorToolSettings();
        StateHasChanged();
    }

    /// <summary>Sets the aspect ratio the crop tool enforces, or null for freeform.</summary>
    public void SetCropAspect(AspectRatio? aspect)
    {
        _cropAspect = aspect;
        if (_cropRectangle is { } r) _cropRectangle = ApplyAspect(r);
        StateHasChanged();
    }

    /// <summary>Applies the pending crop rectangle to the document.</summary>
    public async Task ApplyCropAsync()
    {
        if (_session is null || _cropRectangle is not { Width: > 1, Height: > 1 } rect) return;
        // The rectangle is in preview coordinates; map it back to full resolution.
        var scale = _session.UsesProxy ? 1 / _session.ProxyScale : 1.0;
        var full = new Rectangle(
            (int)Math.Round(rect.X * scale),
            (int)Math.Round(rect.Y * scale),
            Math.Max(1, (int)Math.Round(rect.Width * scale)),
            Math.Max(1, (int)Math.Round(rect.Height * scale)));
        _cropRectangle = null;
        _tool = EditorToolKind.Select;
        // Geometric edits carry the annotations, the layers and the selection with the content they mark.
        var crop = new CropOperation(full);
        MoveSelectionWith(crop);
        await ApplyAndRenderAsync(d => d.AddOperation(crop, keepOverlaysAttached: true), Strings.Crop);
        FitToWindow();
    }

    /// <summary>Discards the pending crop rectangle.</summary>
    public void CancelCrop()
    {
        _cropRectangle = null;
        StateHasChanged();
    }

    /// <summary>Rotates the image by a multiple of 90 degrees.</summary>
    public Task RotateAsync(int degrees)
    {
        var turn = OrientationOperation.FromRotation(degrees);
        MoveSelectionWith(turn);
        return ApplyAndRenderAsync(d => d.AddOperation(turn, keepOverlaysAttached: true), degrees > 0 ? Strings.RotateRight : Strings.RotateLeft);
    }

    /// <summary>Mirrors the image.</summary>
    public Task FlipAsync(bool horizontal)
    {
        var flip = horizontal ? OrientationOperation.FlipHorizontal : OrientationOperation.FlipVertical;
        MoveSelectionWith(flip);
        return ApplyAndRenderAsync(d => d.AddOperation(flip, keepOverlaysAttached: true), horizontal ? Strings.FlipHorizontal : Strings.FlipVertical);
    }

    /// <summary>
    /// Levels the image by up to 45 degrees either way, cropping to the largest rectangle the turned image covers. A
    /// second call replaces the first, so a slider can drive it; 0 removes it.
    /// </summary>
    public Task SetStraightenAsync(double degrees, bool transient = false)
    {
        // Re-editing a step mid-pipeline moves the image in a way the selection cannot follow exactly; it is dropped.
        if (_selection is not null) SetSelection(null);
        return SetAdjustmentAsync(degrees == 0 || !double.IsFinite(degrees) ? null : new StraightenOperation(Math.Clamp(degrees, -StraightenOperation.MaxDegrees, StraightenOperation.MaxDegrees)),
            Strings.Straighten, transient);
    }

    /// <summary>Resizes the image to exactly <paramref name="width"/> by <paramref name="height"/> pixels.</summary>
    public async Task ResizeAsync(int width, int height)
    {
        if (_session is null || width <= 0 || height <= 0) return;
        var resize = new ResizeOperation(width, height, ResizeMode.Stretch);
        MoveSelectionWith(resize);
        await ApplyAndRenderAsync(d => d.AddOperation(resize, keepOverlaysAttached: true), Strings.Resize);
        FitToWindow();
    }

    /// <summary>
    /// Sets the canvas to <paramref name="width"/> by <paramref name="height"/> without scaling the image, placing it by
    /// <paramref name="anchor"/> and filling new area with <paramref name="background"/>.
    /// </summary>
    public async Task SetCanvasSizeAsync(int width, int height, Anchor anchor, Rgba32 background)
    {
        if (_session is null || width <= 0 || height <= 0) return;
        var canvas = new CanvasSizeOperation(width, height, anchor, background);
        MoveSelectionWith(canvas);
        await ApplyAndRenderAsync(d => d.AddOperation(canvas, keepOverlaysAttached: true), Strings.CanvasSize);
        FitToWindow();
    }

    /// <summary>
    /// Crops away plain or transparent edges, as found on the image at full resolution with its layers and annotations,
    /// or says there are none.
    /// </summary>
    public Task TrimAsync() => RunAsync(async () =>
    {
        if (_session is not { } session) return;
        var document = session.Document;
        System.Drawing.Rectangle? bounds;
        System.Drawing.Size size;
        using (var rendered = await session.RenderFullAsync())
        {
            bounds = ContentBounds.Find(rendered);
            size = rendered.Size;
        }
        if (!IsStill(session, document)) return;
        if (bounds is not { } content || content.Size == size)
        {
            ShowMessage(Strings.NothingToTrim, isError: false);
            return;
        }
        var trim = new CropOperation(content);
        MoveSelectionWith(trim);
        await ApplyAndRenderAsync(d => d.AddOperation(trim, keepOverlaysAttached: true), Strings.Trim);
        FitToWindow();
    });

    /// <summary>Turns automatic white balance on, or off when it is on.</summary>
    public Task ToggleAutoWhiteBalanceAsync()
        => SetAdjustmentAsync(FindAdjustment<AutoWhiteBalanceOperation>() is null ? new AutoWhiteBalanceOperation() : null, Strings.AutoWhiteBalance);

    /// <summary>Turns automatic levels on, or off when they are on.</summary>
    public Task ToggleAutoLevelsAsync()
        => SetAdjustmentAsync(FindAdjustment<AutoLevelsOperation>() is null ? new AutoLevelsOperation() : null, Strings.AutoLevels);

    /// <summary>Makes the next eyedropper pick set the white balance: click something that should be grey or white.</summary>
    public void PickWhiteBalance()
    {
        if (_session is null) return;
        SetTool(EditorToolKind.Eyedropper);
        _pickingWhiteBalance = true;
        ShowMessage(Strings.PickNeutralHint, isError: false);
    }

    /// <summary>True while the next eyedropper pick sets the white balance.</summary>
    public bool IsPickingWhiteBalance => _pickingWhiteBalance;

    private TOperation? FindAdjustment<TOperation>() where TOperation : class, IImageOperation
        => _session?.Document.Pipeline.OfType<TOperation>().FirstOrDefault();

    // ---- Comparing ----

    /// <summary>True while the canvas shows the original image instead of the edit.</summary>
    public bool IsComparing => _comparing;

    /// <summary>Shows the original image instead of the edit, or the edit again. Any edit ends the comparison.</summary>
    public async Task SetCompareAsync(bool compare)
    {
        if (_session is not { } session || compare == _comparing) return;
        if (compare)
        {
            try
            {
                var original = await session.GetSourcePreviewAsync();
                // Another image loaded meanwhile: this one's preview is on its way out with its session.
                if (!ReferenceEquals(_session, session)) return;
                _sourcePreview = original;
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }
        _comparing = compare;
        _previewVersion++;
        StateHasChanged();
    }

    // ---- Layers ----

    /// <summary>The id of the layer selected in the layer panel, if any.</summary>
    public Guid? ActiveLayerId => _activeLayerId;

    /// <summary>Selects a layer, or clears the selection when null. Painting goes to the selected paint layer.</summary>
    public void SelectLayer(Guid? id)
    {
        _activeLayerId = id;
        StateHasChanged();
    }

    /// <summary>Adds an empty paint layer on top, selects it and picks the brush.</summary>
    public async Task AddPaintLayerAsync()
    {
        if (_session is null) return;
        var layer = new PaintLayer { Name = Strings.Paint };
        await ApplyAndRenderAsync(d => d.AddLayer(layer), Strings.AddPaintLayer);
        _activeLayerId = layer.Id;
        SetTool(EditorToolKind.Brush);
    }

    /// <summary>
    /// Loads an image and places it as a layer in the middle of the image, at most six tenths of its size, and selects
    /// it. The session keeps the pixels for as long as its history can refer to them.
    /// </summary>
    public Task AddImageLayerAsync(ImageSource source) => RunAsync(async () =>
    {
        if (_session is null) return;
        var image = await Loader.LoadAsync(source);
        // The editor may have been closed while the file loaded; another image loaded meanwhile simply gets the layer.
        if (_session is not { } session)
        {
            image.Dispose();
            return;
        }
        session.Own(image);
        var output = session.Document.TryGetOutputSize(out var size) ? size : session.SourceSize;
        var scale = Math.Min(1.0, Math.Min(output.Width * 0.6 / image.Width, output.Height * 0.6 / image.Height));
        var width = (float)(image.Width * scale);
        var height = (float)(image.Height * scale);
        var layer = new ImageLayer
        {
            Image = image,
            Bounds = new RectangleF((output.Width - width) / 2, (output.Height - height) / 2, width, height),
            Name = string.IsNullOrWhiteSpace(source.FileName) ? Strings.AddImageLayer : System.IO.Path.GetFileNameWithoutExtension(source.FileName),
        };
        await ApplyAndRenderAsync(d => d.AddLayer(layer), Strings.AddImageLayer);
        _activeLayerId = layer.Id;
    });

    /// <summary>Duplicates a layer, placing the copy above it, and selects the copy.</summary>
    public async Task DuplicateLayerAsync(Guid id)
    {
        Guid? copy = null;
        await ApplyAndRenderAsync(d => d.DuplicateLayer(id, out copy), Strings.Duplicate);
        if (copy is not null) _activeLayerId = copy;
    }

    /// <summary>
    /// Groups a layer with the one directly below it in the same list, and selects the group; when that one is a group
    /// already, moves the layer into it, on top of its layers. Does nothing for the lowest layer of a list.
    /// </summary>
    public async Task GroupWithLayerBelowAsync(Guid id)
    {
        if (_session?.Document is not { } document || !document.TryLocateLayer(id, out var parent, out var index) || index == 0) return;
        var below = (parent?.Layers ?? document.Layers)[index - 1];
        Guid? group = null;
        try
        {
            if (below is GroupLayer existing) await ApplyAndRenderAsync(d => d.MoveLayerIntoGroup(id, existing.Id), Strings.MoveIntoGroupBelow);
            else await ApplyAndRenderAsync(d => d.GroupLayers([below.Id, id], out group, Strings.Group), Strings.Group);
        }
        catch (ArgumentException)
        {
            // Nothing was applied: the change is refused before it reaches the history.
            ShowMessage(Strings.GroupTooDeep, isError: true);
            return;
        }
        if (group is not null) _activeLayerId = group;
    }

    /// <summary>Replaces a group by its layers, where it was. The group's own opacity, blend mode and mask go with it.</summary>
    public async Task UngroupAsync(Guid id)
    {
        if (_session?.Document.FindLayer(id) is not GroupLayer) return;
        await ApplyAndRenderAsync(d => d.Ungroup(id), Strings.Ungroup);
        if (_activeLayerId == id) _activeLayerId = null;
    }

    /// <summary>Moves a layer out of the group that holds it, directly above the group.</summary>
    public Task MoveLayerOutOfGroupAsync(Guid id) => ApplyAndRenderAsync(d => d.MoveLayerOutOfGroup(id), Strings.MoveOutOfGroup);

    /// <summary>Adds or updates an adjustment, replacing any existing one of the same type so sliders stay live.</summary>
    public Task SetAdjustmentAsync<TOperation>(TOperation? operation, string label, bool transient = false) where TOperation : class, IImageOperation
        => ApplyAndRenderAsync(d =>
        {
            var pipeline = d.Pipeline;
            var index = -1;
            for (var i = 0; i < pipeline.Count; i++)
            {
                if (pipeline[i] is TOperation) { index = i; break; }
            }
            // A geometric step, such as a straighten, carries the overlays with the image; any other leaves them where they are.
            if (operation is null || operation.IsIdentity)
                return index >= 0 ? d.WithPipeline(pipeline.RemoveAt(index), keepOverlaysAttached: true) : d;
            return d.WithPipeline(index >= 0 ? pipeline.Replace(index, operation) : pipeline.Add(operation), keepOverlaysAttached: true);
        }, label, transient);

    /// <summary>Applies any change to the document as one history entry and one render.</summary>
    public Task ApplyAsync(Func<ImageDocument, ImageDocument> change, string label, bool transient = false)
    {
        ArgumentNullException.ThrowIfNull(change);
        return ApplyAndRenderAsync(change, label, transient);
    }

    /// <summary>
    /// Renders the preview again from scratch, for when something outside the document changed how it looks, such as a
    /// font registered after the text was first drawn. See <see cref="ImageEditSession.Invalidate"/>.
    /// </summary>
    public Task RefreshAsync()
    {
        _session?.Invalidate();
        return RenderPreviewAsync();
    }

    /// <summary>Adds an arbitrary operation.</summary>
    public Task AddOperationAsync(IImageOperation operation, string? label = null)
        => ApplyAndRenderAsync(d => d.AddOperation(operation), label ?? operation.Name);

    /// <summary>Adds an annotation.</summary>
    public Task AddAnnotationAsync(Annotation annotation, string? label = null)
        => ApplyAndRenderAsync(d => d.AddAnnotation(annotation), label ?? Strings.FormatKind(annotation.Kind));

    /// <summary>Replaces an annotation, matched by id.</summary>
    public Task UpdateAnnotationAsync(Annotation annotation, bool transient = false)
        => ApplyAndRenderAsync(d => d.UpdateAnnotation(annotation), Strings.FormatKind(annotation.Kind), transient);

    /// <summary>Removes an annotation.</summary>
    public async Task DeleteAnnotationAsync(Guid id)
    {
        if (_selectedId == id) _selectedId = null;
        await ApplyAndRenderAsync(d => d.RemoveAnnotation(id), Strings.Delete);
    }

    /// <summary>Selects an annotation, or clears the selection when null.</summary>
    public void SelectAnnotation(Guid? id)
    {
        _selectedId = id;
        StateHasChanged();
    }

    // Moving through the history waits while the editor is busy: a trim, a crop to the selection or an export works
    // out what to do from the document it started with, and applies it to that document.

    /// <summary>Undoes the last edit. Does nothing while the editor is busy.</summary>
    public void Undo()
    {
        if (_session is not { } session || _busy) return;
        var before = session.Document;
        session.Undo();
        FollowSelection(before, session.Document);
        _selectedId = null;
        _ = RenderAndNotifyAsync();
    }

    /// <summary>Redoes the last undone edit. Does nothing while the editor is busy.</summary>
    public void Redo()
    {
        if (_session is not { } session || _busy) return;
        var before = session.Document;
        session.Redo();
        FollowSelection(before, session.Document);
        _selectedId = null;
        _ = RenderAndNotifyAsync();
    }

    /// <summary>Jumps to an entry in the history, as the history panel does. Does nothing while the editor is busy.</summary>
    public Task GoToHistoryAsync(int index)
    {
        if (_session is not { } session || _busy || index < 0 || index >= session.History.Entries.Count) return Task.CompletedTask;
        var before = session.Document;
        session.History.GoTo(index);
        FollowSelection(before, session.Document);
        _selectedId = null;
        return RenderAndNotifyAsync();
    }

    /// <summary>Discards every edit. Does nothing while the editor is busy.</summary>
    public void Reset()
    {
        if (_session is not { } session || _busy) return;
        var before = session.Document;
        session.Reset();
        FollowSelection(before, session.Document);
        _selectedId = null;
        _cropRectangle = null;
        _stepCounter = 0;
        _ = RenderAndNotifyAsync();
    }

    private async Task RenderAndNotifyAsync()
    {
        await RenderPreviewAsync();
        if (_selection is not null) _ = UpdateSelectionOutlineAsync();
        await NotifyDocumentChangedAsync();
        StateHasChanged();
    }

    /// <summary>Sets the zoom, keeping the point at the centre of the view where it is.</summary>
    public void SetZoom(double zoom)
    {
        var next = Math.Clamp(zoom, 0.05, 32);
        OnZoomGesture(new ZoomArgs(next / _zoom, ViewCentre()));
    }

    /// <summary>Zooms and pans so the whole image is visible and centred, never enlarging it past 100%.</summary>
    public void FitToWindow()
    {
        // Measured after the next render, when the canvas and its container exist.
        _fitPending = true;
        StateHasChanged();
    }

    /// <summary>Renders the edit at full resolution and encodes it.</summary>
    public async Task<EncodedImage?> ExportAsync(ImageExportOptions? options = null)
    {
        if (_session is null) return null;
        EncodedImage? result = null;
        await RunAsync(async () =>
        {
            using var full = await _session.RenderFullAsync();
            result = await Exporter.EncodeAsync(full, options ?? ExportOptions);
            await OnExported.InvokeAsync(result);
        });
        return result;
    }

    /// <summary>Renders, encodes and downloads the edit.</summary>
    public async Task DownloadAsync(string fileName, ImageExportOptions? options = null)
    {
        var encoded = await ExportAsync(options);
        if (encoded is not null) await RunAsync(() => Exporter.DownloadAsync(encoded, fileName).AsTask());
    }

    /// <summary>
    /// Downloads the original, the edit and every image it uses as one project file, which
    /// <see cref="OpenProjectAsync(System.IO.Stream)"/> reopens with every layer, mask, adjustment and annotation still editable.
    /// </summary>
    public Task SaveProjectAsync(string fileName = "edit") => RunAsync(async () =>
    {
        if (_session is null) return;
        using var stream = new System.IO.MemoryStream();
        await Serialization.BmageProject.SaveAsync(stream, _session.Original, _session.Document, new Serialization.BmageProjectOptions { Limits = Options.Limits });
        var name = fileName.EndsWith(Serialization.BmageProject.FileExtension, StringComparison.OrdinalIgnoreCase) ? fileName : fileName + Serialization.BmageProject.FileExtension;
        await Exporter.DownloadFileAsync(stream.ToArray(), name, "application/zip");
    });

    /// <summary>
    /// Opens a project saved by <see cref="SaveProjectAsync"/>, replacing the image and its history; the edit comes back
    /// as one undoable step over the original.
    /// </summary>
    public Task OpenProjectAsync(System.IO.Stream stream) => RunAsync(async () =>
    {
        ArgumentNullException.ThrowIfNull(stream);
        using var project = await Serialization.BmageProject.LoadAsync(stream, new Serialization.BmageProjectOptions { Limits = Options.Limits, Allocator = Options.Allocator });
        var document = project.Document;
        var original = project.DetachOriginal();
        var images = project.DetachImages();
        var handedOn = false;
        try
        {
            await LoadImageAsync(original, takeOwnership: true);
            // Unless a handler of OnImageLoaded loaded another image meanwhile, the session now open is the project's.
            if (_session is not { } session || !ReferenceEquals(session.Original, original)) return;
            foreach (var image in images) session.Own(image);
            handedOn = true;
        }
        finally
        {
            if (!handedOn) foreach (var image in images) image.Dispose();
        }
        await ApplyAndRenderAsync(_ => document, Strings.OpenProject);
        FitToWindow();
    });

    /// <summary>
    /// Opens a project file the user picked. Projects carry their original losslessly, so they may be four times the
    /// size <see cref="BitBmageOptions.MaxSourceBytes"/> allows an image upload.
    /// </summary>
    public async Task OpenProjectAsync(IBrowserFile file)
    {
        ArgumentNullException.ThrowIfNull(file);
        System.IO.Stream stream;
        try
        {
            stream = file.OpenReadStream(Options.MaxSourceBytes * 4);
        }
        catch (Exception ex) when (ex is IOException or ArgumentException)
        {
            ShowMessage(Strings.ProjectFailed, isError: true);
            return;
        }
        await using (stream) await OpenProjectAsync(stream);
    }

    /// <summary>Copies the exported image to the clipboard as PNG, which is the only format browsers reliably accept.</summary>
    public Task CopyToClipboardAsync() => RunAsync(async () =>
    {
        if (_session is null) return;
        using var full = await _session.RenderFullAsync();
        var encoded = await Exporter.EncodeAsync(full, ImageExportOptions.Png);
        await Exporter.CopyToClipboardAsync(encoded);
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            // On WebAssembly .NET runs on the page's thread, and a render of one step never yields: without this the
            // busy state, the disabled controls and aria-busy would only reach the page once the work was over.
            await Task.Yield();
            await action();
        }
        catch (Exception ex)
        {
            await ReportErrorAsync(ex);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ReportErrorAsync(Exception ex)
    {
        if (OnError.HasDelegate)
        {
            await OnError.InvokeAsync(ex);
            return;
        }
        ShowMessage(ex switch
        {
            ImageLimitExceededException => Strings.ImageTooLarge,
            ImageDecodeException => Strings.UnsupportedFormat,
            ImageCapabilityException c => c.Message,
            ImageEncodeException => Strings.ExportFailed,
            Serialization.ImageDocumentFormatException => Strings.ProjectFailed,
            _ => Strings.LoadFailed,
        }, isError: true);
    }

    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _messageIsError = isError;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        // Cancel but do not dispose: the token source belongs to the render that created it, which disposes it on
        // the way out. Disposing it here would race that render.
        CancelQuietly(Interlocked.Exchange(ref _renderCts, null));
        _session?.Dispose();
        _session = null;
        await ValueTask.CompletedTask;
    }
}
