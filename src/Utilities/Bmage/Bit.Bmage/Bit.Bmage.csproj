<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.Bmage</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <Description>bit Bmage: image processing from strongly typed C#, headless and browser-independent, for ASP.NET Core, console, worker and Blazor hosts alike. Pixel buffers, transforms, adjustments, filters, drawing, annotations, masks and selective edits, image, fill and adjustment layers with W3C blend modes, EXIF metadata, managed PNG/JPEG/BMP/GIF codecs, a managed WebP codec, lossy and lossless, and a managed AVIF decoder, none needing a native library, composable non-destructive pipelines and edits that save to JSON and replay on a server, spread over as many cores as you allow with identical pixels, with predictable, budgeted memory. Add Bit.Bmage.Blazor for the browser integration and the BmageEditor component.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>Bit;Bmage;image;crop;resize;webp;avif;exif;annotation;mask;layers;blend;png;jpeg;headless</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- Floating low-bound version ranges so consumers can pin to any patch release on their TFM;
             the upper bound keeps a major-version package that targets a newer TFM out. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[11.0.0-rc.1.26425.128,12.0.0)" />
    </ItemGroup>

    <!-- Bit.Bmage.Blazor ships, so it is granted access under both the repo's AssemblyOriginatorKeyFile.snk and the
         release key the publish workflows sign with. The tests and benchmarks only ever build against the repo's key,
         so they are granted access under that key alone. -->
    <ItemGroup>
        <InternalsVisibleTo Include="Bit.Bmage.Blazor" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bmage.Blazor" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bmage.Tests" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Bmage.Benchmarks" PublicKey="" />
    </ItemGroup>

</Project>
