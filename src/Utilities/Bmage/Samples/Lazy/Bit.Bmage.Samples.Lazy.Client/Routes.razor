@* The router waits for OnNavigateAsync before it renders a page, so Bmage is there before the editor's page renders.
   This file renders before the assemblies are downloaded, so it may not use Bmage's types itself. The server
   prerenders it too: it registers LazyAssemblyLoader for that (its Program.cs), and does not set the switch, as it
   loads Bmage with the rest of the app. *@
@using Microsoft.AspNetCore.Components.WebAssembly.Services
@inject LazyAssemblyLoader LazyAssemblyLoader

<Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Set only where the assemblies are marked (the project file): loading an assembly that is not marked throws.
    private static readonly bool LazyLoadsBmage = AppContext.TryGetSwitch("Bit.Bmage.Samples.Lazy.LazyLoadsBmage", out var on) && on;

    private async Task OnNavigateAsync(NavigationContext context)
    {
        // The page with the editor on it: fetch both assemblies before it renders. A second call loads nothing again.
        if (LazyLoadsBmage && IsEditorPage(context.Path))
            await LazyAssemblyLoader.LoadAssembliesAsync(["Bit.Bmage.wasm", "Bit.Bmage.Blazor.wasm"]);
    }

    // /editor and the routes beneath it (routes match regardless of case), but not /editor-settings. The path keeps any
    // query and fragment.
    private static bool IsEditorPage(string path)
    {
        path = path.Split('?', '#')[0];
        return path.Equals("editor", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("editor/", StringComparison.OrdinalIgnoreCase);
    }
}
