@* A code sample: SyntaxHighlighter's tokens inside the site kit's pre.bb-code, which is what gives
   it the site's code surface - and the copy button site.js adds to every pre.bb-code. The token
   colours are in wwwroot/demo.css.

   Snippets that are the point of their section - the install command, the Program.cs a reader is
   about to paste - are shown as they are (Expanded); the full source behind a worked scenario sits
   behind a "Show code" toggle, so the scenario itself stays the first thing on the page. *@

@if (Expanded)
{
    @* tabindex="0": a block wider than the column scrolls sideways, and a keyboard reader can only
       scroll what can take focus. *@
    <pre class="bb-code" tabindex="0"><code>@Highlighted</code></pre>
}
else
{
    <div class="bb-source">
        <button type="button" class="btn btn-secondary" @onclick="() => _show = !_show"
                aria-expanded="@(_show ? "true" : "false")" aria-controls="@_bodyId">
            <span class="demo-source-caret" aria-hidden="true">@(_show ? "▾" : "▸")</span>
            <span class="demo-source-glyph" aria-hidden="true">&lt;/&gt;</span>
            @(_show ? "Hide code" : "Show code")
            <span class="demo-source-lang">@Language</span>
        </button>

        @if (_show)
        {
            <pre class="bb-code" id="@_bodyId" tabindex="0"><code>@Highlighted</code></pre>
        }
    </div>
}

@code {
    /// <summary>The source to display, copy/paste-ready.</summary>
    [Parameter, EditorRequired] public string Code { get; set; } = "";

    /// <summary>
    /// The language, which picks the highlighter: Razor (the default), HTML and XML are lexed as
    /// markup and C# as C#; anything else - a shell command, CSS, JSON - is shown as written.
    /// </summary>
    [Parameter] public string Language { get; set; } = "Razor";

    /// <summary>Whether the code is shown as it is rather than behind a toggle. On for a snippet that is the point of its section.</summary>
    [Parameter] public bool Expanded { get; set; }

    // The toggle points at the block it opens, so a screen reader following aria-controls lands on
    // the code rather than on the next thing in the document. Generated per instance because a
    // page carries a dozen of these.
    private readonly string _bodyId = $"code-{Guid.NewGuid():N}";

    private bool _show;

    // The samples are raw string literals, so they carry the source file's line endings; a trailing
    // line break would otherwise render as an empty last line.
    private MarkupString Highlighted => new(SyntaxHighlighter.Highlight(Code.ReplaceLineEndings("\n").Trim('\n'), Language));
}
