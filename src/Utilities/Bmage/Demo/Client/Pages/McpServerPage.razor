    private const string ArchitectureCode = """
        // Server/Services/BmagePipelineLab.cs - the whole trick, in a few lines.
        //
        // The pipeline is parsed into the real ImagePipeline by calling its own builder methods
        // through reflection, so every method and parameter the library has is accepted as written.
        var pipeline = BmagePipelineSpec.Parse(spec).Pipeline;

        using var input = CreateSource("photo", 2400, 1600);   // drawn with ImageCanvas, plus grain

        var optimized = pipeline.Optimize(input.Size);           // what ExecuteAsync really runs
        using var output = await pipeline.ExecuteAsync(input);

        var processor = new ImageProcessor();                    // the managed codecs a server has
        var jpeg = await processor.EncodeAsync(output, new ImageExportOptions
        {
            Format = ImageFormat.Jpeg,
            Quality = 0.8,
            MaxFileSize = budget,                                // the library's own search
        });
        """;

    private const string DefaultReview = """
        @inject ImageProcessor Processor
        @inject IImageCapabilityProvider Capabilities
        @inject ImageExporter Exporter

        @code {
            private ImageCapabilities? _caps;

            protected override async Task OnInitializedAsync()
            {
                _caps = await Capabilities.GetAsync();
            }

            private async Task<EncodedImage> SaveAsync(ImageBuffer photo)
            {
                var thumb = await ImagePipeline.Create()
                    .Sharpen(0.3f)
                    .MaxSize(400, 400)
                    .ExecuteAsync(photo);

                return await Exporter.EncodeAsync(thumb, new ImageExportOptions
                {
                    Format = ImageFormat.WebP,
                    Metadata = MetadataPolicy.Preserve,
                });
            }
        }
        """;

