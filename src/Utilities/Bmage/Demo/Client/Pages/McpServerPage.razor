        : "—";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Every call on this page goes to the app's own API, which prerendering has no way to reach and
        // no reason to: the catalog is chrome, not content.
        if (firstRender is false || IsHydrating) return;

        _catalog = await GetAsync<Catalog>("api/mcp/GetMcpCatalog");

        StateHasChanged();
    }

    private static string TabId(string client) => $"mcp-tab-{Slug(client)}";

    private static string PanelId(string client) => $"mcp-panel-{Slug(client)}";

    private static string Slug(string client) => client.ToLowerInvariant().Replace(' ', '-');

    /// <summary>
    /// Arrow keys move between the tabs, wrapping at both ends - the tablist pattern. The focus moves
    /// with the selection, so the focus ring never sits on a tab that is no longer the current one.
    /// </summary>
    private async Task OnTabKeyDown(KeyboardEventArgs e)
    {
        var step = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => 1,
            "ArrowLeft" or "ArrowUp" => -1,
            _ => 0
        };

        if (step == 0) return;

        var index = Array.FindIndex(Clients, client => client.Name == _client);
        var next = Clients[((index + step) % Clients.Length + Clients.Length) % Clients.Length];

        _client = next.Name;

        if (_tabs.TryGetValue(next.Name, out var tab)) await tab.FocusAsync();
    }

    private void OnSizeChanged(ChangeEventArgs e)
    {
        var parts = (e.Value?.ToString() ?? string.Empty).Split('x');

        if (parts.Length == 2 && int.TryParse(parts[0], out var width) && int.TryParse(parts[1], out var height))
        {
            _width = width;
            _height = height;
        }
    }

    private void OnBudgetChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) _budgetKb = value;
    }

    private void ToggleFormat(string format)
    {
        if (_formats.Remove(format) is false) _formats.Add(format);
    }

    private async Task RunPresetAsync(Preset preset)
    {
        _pipeline = preset.Pipeline;
        _source = preset.Source;
        _formats.Clear();
        _formats.UnionWith(preset.Formats);
        _budgetKb = preset.BudgetKb;

        await RunAsync();
    }

    // The handlers below each reset their own flag in a finally: the flag disables the panel's
    // controls while a call is out, so losing it would leave the panel disabled with no way back but a
    // reload. Each also clears its own error first and sets it on a null answer, so a panel never shows
    // a stale result under a fresh question.

    private async Task RunAsync()
    {
        _running = true;
        _runError = null;

        try
        {
            var formats = string.Join(",", Formats.Where(_formats.Contains));
            var url = $"api/mcp/RunBmagePipeline?pipeline={Uri.EscapeDataString(_pipeline)}&source={_source}" +
                      $"&width={_width}&height={_height}&formats={Uri.EscapeDataString(formats)}&qualities={Uri.EscapeDataString(_qualities)}" +
                      (_budgetKb > 0 ? $"&maxFileSize={_budgetKb * 1024L}" : string.Empty);

            if (url.Length > MaxUrlLength)
            {
                _runError = "That pipeline is longer than this page can put in a URL. The MCP tool itself takes far more.";
                return;
            }

            _run = await GetAsync<Run>(url);
            _runError = _run is null ? Unreachable : null;
        }
        finally
        {
            _running = false;
        }
    }

    private async Task CompareAsync()
    {
        _comparing = true;
        _compareError = null;

        try
        {
            _comparison = await GetAsync<Comparison>($"api/mcp/CompareBmageMetadataPolicies?format={_metadataFormat}");
            _compareError = _comparison is null ? Unreachable : null;
        }
        finally
        {
            _comparing = false;
        }
    }

    private async Task ReviewAsync()
    {
        _reviewError = null;

        var url = $"api/mcp/ReviewBmageCode?code={Uri.EscapeDataString(_review)}";

        // The tool reviews far more, but this page hands the code over in the query string, and a request
        // line that long is refused by the server before the tool sees it. Saying so beats a 414.
        if (url.Length > MaxUrlLength)
        {
            _reviewError = $"That is {_review.Length} characters, which is more than this page can put in a URL. " +
                           "Paste one component rather than a whole file - the MCP tool itself takes far more.";
            _findings = null;

            return;
        }

        _reviewing = true;

        try
        {
            _findings = await GetAsync<Review>(url);
            _reviewError = _findings is null ? Unreachable : null;
        }
        finally
        {
            _reviewing = false;
        }
    }

    private async Task SearchAsync()
    {
        _searching = true;
        _searchError = null;

        try
        {
            _hits = await GetAsync<Hit[]>($"api/mcp/SearchBmage?query={Uri.EscapeDataString(_query)}&limit=8");
            _searchError = _hits is null ? Unreachable : null;
        }
        finally
        {
            _searching = false;
        }
    }

    /// <summary>
    /// Calls one of the demo's own MCP endpoints, answering null when it cannot be reached or did not
    /// come back in the expected shape. Every caller turns that into its own panel saying so: leaving
    /// the last answer on screen would read as the answer to the question just asked.
    /// </summary>
    private async Task<T?> GetAsync<T>(string url)
    {
        try
        {
            return await Http.GetFromJsonAsync<T>(url);
        }
        catch
        {
            return default;
        }
    }

    /// <summary>"Location: 53.2, 5.8" is reported as "Location".</summary>
    private static string LabelOf(string field)
    {
        var colon = field.IndexOf(": ", StringComparison.Ordinal);

        return colon > 0 ? field[..colon] : field;
    }

    /// <summary>Kept or removed; a sensitive field that was kept is the one that matters, so it reads as a failure.</summary>
    private static MarkupString Badge(bool kept, bool sensitive) => kept
        ? new(sensitive ? "<span class=\"bb-badge bb-badge-danger\">kept</span>" : "<span class=\"bb-badge demo-badge-off\">kept</span>")
        : new(sensitive ? "<span class=\"bb-badge bb-badge-success\">removed</span>" : "<span class=\"bb-badge demo-badge-off\">removed</span>");

    private static string SeverityBadge(string? severity) => severity switch
    {
        "Error" => "bb-badge-danger",
        "Warning" => "bb-badge-warn",
        _ => "demo-badge-off"
    };

    private static string Shorten(string description)
    {
        // The tool descriptions are written for an agent deciding whether to call the tool, so they are
        // long by design. The table wants the first sentence.
        var stop = description.IndexOf(". ", StringComparison.Ordinal);

        return stop > 0 ? description[..(stop + 1)] : description;
    }
