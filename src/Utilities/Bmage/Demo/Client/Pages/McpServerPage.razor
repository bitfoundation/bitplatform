@page "/mcp-server"
@inject HttpClient Http
@inject NavigationManager Nav

@* The MCP server's own documentation page. Everything interactive on it calls the demo's real
   /api/mcp endpoints - the same methods the MCP server exposes as tools - so what a reader tries
   here is exactly what an agent gets, and the page cannot document a tool that does not work.

   The tool, prompt and resource tables are fetched rather than written out, for the same reason:
   they come from GetMcpCatalog, which reflects over the attributes that declare them. *@

<PageTitle>MCP server · Bmage</PageTitle>

<div class="bb-intro">
    <h1>MCP server</h1>
    <p class="bb-subtitle">
        This site ships a <strong>Model Context Protocol</strong> server, so an AI agent writes Bmage
        code from what the library <em>actually</em> is rather than from what it remembers. Half of its
        tools answer from this build's own text - the guides, the XML documentation compiled into the
        package, the source of every page you have been reading. The other half answer by
        <strong>running the real engine on the server</strong>: how many bytes a pipeline really
        produces, whether a size budget is reachable, what the optimiser does, and whether the export
        still carries the GPS position.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Why an image library needs one</h3>
    <p>
        Almost every way of getting image code wrong compiles. There is no warning for a capability
        probe that runs during prerendering, for a 48 MB buffer nobody disposes, or for an avatar
        exported with the user's home address in it. Three of the questions this server answers
        directly:
    </p>

    <div class="bb-grid mcp-why">
        @foreach (var problem in Problems)
        {
            <div class="bb-card">
                <p class="bb-card-title">@problem.Symptom</p>
                <p class="bb-card-desc">@problem.Cause</p>
                <code>@problem.Tool</code>
            </div>
        }
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Connect your agent</h3>
    <p>
        The server speaks MCP over HTTP. Point any MCP client at this site's endpoint or at the deployed
        <code>https://bmage.bitplatform.dev/mcp</code>.
        The same methods are also plain <code>GET</code> endpoints under <code>/api/mcp/...</code>,
        which is what the panels further down this page call.
    </p>

    <div class="demo-field" role="group" aria-labelledby="mcp-endpoint-label">
        <span class="demo-field-label" id="mcp-endpoint-label">Endpoint</span>
        <div class="bb-segmented">
            @foreach (var endpoint in Endpoints)
            {
                <button type="button" aria-pressed="@(_endpoint == endpoint.Name ? "true" : "false")"
                        @onclick="() => _endpoint = endpoint.Name">
                    @endpoint.Name
                </button>
            }
        </div>
        <span class="bb-field-hint">@CurrentEndpoint.Note</span>
    </div>

    @* A tablist is one stop in the tab order: tab moves past the whole group, and the arrow keys move
       between the tabs inside it. The roles come with the behaviour they promise: every tab names the
       panel it controls, and only the selected one is tabbable. aria-selected is written out as a word
       rather than bound to the bool, because a false bool renders as no attribute at all. *@
    <div class="bb-tabs mcp-tabs" role="tablist" aria-label="MCP client">
        @foreach (var client in Clients)
        {
            var isSelected = _client == client.Name;

            <button type="button" role="tab"
                    id="@TabId(client.Name)"
                    aria-selected="@(isSelected ? "true" : "false")"
                    aria-controls="@PanelId(client.Name)"
                    tabindex="@(isSelected ? 0 : -1)"
                    @ref="_tabs[client.Name]"
                    @onclick="() => _client = client.Name"
                    @onkeydown="OnTabKeyDown">
                @client.Name
            </button>
        }
    </div>

    @* Every panel is rendered and the unselected ones hidden: aria-controls has to point at an element
       that exists, on the tabs that are not the current one too. *@
    @foreach (var client in Clients)
    {
        <div role="tabpanel" id="@PanelId(client.Name)" aria-labelledby="@TabId(client.Name)"
             hidden="@(_client != client.Name)">
            <p class="demo-small bb-muted">@client.Note</p>
            <CodeSnippet Code="@client.Config(CurrentEndpoint.Key, CurrentEndpoint.Url)" Language="@client.Language" Expanded="true" />
        </div>
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> The pipeline lab</h3>
    <p>
        <code>RunBmagePipeline</code> runs a pipeline on the real engine against a generated test
        image - a photo with sensor grain, a flat-colour screenshot or a transparent graphic - and
        reports the output size, the bytes for every format and quality, whether a byte budget can be
        met, the operations the optimiser really runs, and the timings with and without it. The
        pipeline is the C# you would write; every <code>ImagePipeline</code> method is accepted.
    </p>

    <div class="bb-demo bb-page-wide">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live</span></div>
        <div class="demo-split">
            <div>
                <div class="demo-field">
                    <label class="demo-field-label" for="mcp-pipeline">Pipeline</label>
                    <textarea id="mcp-pipeline" class="mcp-input mcp-pipeline" rows="3" spellcheck="false"
                              value="@_pipeline" @onchange="e => _pipeline = e.Value?.ToString() ?? string.Empty"
                              disabled="@(_running || IsHydrating)"></textarea>
                </div>

                <div class="bb-toolbar mcp-presets">
                    @foreach (var preset in Presets)
                    {
                        <button type="button" class="btn btn-secondary demo-btn-sm" disabled="@(_running || IsHydrating)" @onclick="() => RunPresetAsync(preset)">
                            @preset.Name
                        </button>
                    }
                </div>

                @if (_runError is not null)
                {
                    <div class="bb-note bb-note-danger demo-error" role="alert">@_runError</div>
                }
                else if (_run?.Error is { } error)
                {
                    @* The server read the pipeline and could not run it, and said why - a better message than
                       anything this page could compose about it. *@
                    <div class="bb-note bb-note-danger demo-error" role="alert">@error</div>
                }
                else if (_run is not null)
                {
                    <div class="bb-stats demo-stats-compact mcp-run-stats">
                        <div class="bb-stat">
                            <span class="bb-stat-label">Output</span>
                            <span class="bb-stat-value">@_run.OutputWidth &times; @_run.OutputHeight</span>
                        </div>
                        <div class="bb-stat">
                            <span class="bb-stat-label">Run</span>
                            <span class="bb-stat-value">@_run.ExecuteMilliseconds.ToString("0.#") ms</span>
                        </div>
                        <div class="bb-stat">
                            <span class="bb-stat-label">Unoptimised</span>
                            <span class="bb-stat-value">@(_run.UnoptimizedMilliseconds is { } ms ? $"{ms:0.#} ms" : "same")</span>
                        </div>
                        <div class="bb-stat">
                            <span class="bb-stat-label">Smallest file</span>
                            <span class="bb-stat-value">@SmallestFile</span>
                        </div>
                    </div>

                    <div class="bb-scroll" tabindex="0" role="region" aria-label="Encoded sizes">
                        <table class="bb-table">
                            <thead>
                                <tr>
                                    <th scope="col">Format</th>
                                    <th scope="col" class="demo-num">Quality</th>
                                    <th scope="col" class="demo-num">Bytes</th>
                                    <th scope="col" class="demo-num">Bits/px</th>
                                    <th scope="col" class="demo-num">Encode</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var encoding in _run.Encodings ?? [])
                                {
                                    <tr>
                                        <th scope="row">@encoding.Format.ToUpperInvariant()</th>
                                        @if (encoding.Bytes is null)
                                        {
                                            <td colspan="4" class="demo-small bb-muted">@encoding.Note</td>
                                        }
                                        else
                                        {
                                            <td class="demo-num">@(encoding.Quality?.ToString("0.##") ?? "lossless")</td>
                                            <td class="demo-num">@Display.Bytes(encoding.Bytes.Value)</td>
                                            <td class="demo-num">@encoding.BitsPerPixel?.ToString("0.##")</td>
                                            <td class="demo-num">@encoding.EncodeMilliseconds?.ToString("0.#") ms</td>
                                        }
                                    </tr>
                                }
                                @foreach (var budget in _run.Budgets ?? [])
                                {
                                    <tr>
                                        <th scope="row">@budget.Format.ToUpperInvariant() &le; @Display.Bytes(budget.MaxFileSize)</th>
                                        @if (budget.Met)
                                        {
                                            <td class="demo-num">@(budget.Quality?.ToString("0.##") ?? "lossless")</td>
                                            <td class="demo-num demo-good">@Display.Bytes(budget.Bytes ?? 0)</td>
                                            <td colspan="2" class="demo-small bb-muted">@budget.Width &times; @budget.Height</td>
                                        }
                                        else
                                        {
                                            <td colspan="4" class="demo-small demo-bad">@budget.Error</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="bb-overline demo-label">What the optimiser runs</p>
                    <pre class="demo-readout mcp-operations">@string.Join("\n", (_run.OptimizedOperations ?? []).Select((op, i) => $"{i + 1}. {op}"))</pre>
                    <ul class="mcp-notes">
                        @foreach (var note in _run.OptimizerNotes ?? [])
                        {
                            <li>@note</li>
                        }
                    </ul>

                    <p class="demo-small mcp-reading">@_run.Reading</p>

                    @foreach (var warning in _run.Warnings ?? [])
                    {
                        <p class="demo-small demo-bad">@warning</p>
                    }
                }
            </div>

            <div class="demo-panel">
                <p class="bb-overline demo-label">
                    Run settings
                    @if (_running)
                    {
                        <span class="working" role="status"><span class="bb-spinner" aria-hidden="true"></span>Running on the server&hellip;</span>
                    }
                </p>

                <div class="demo-field" role="group" aria-labelledby="mcp-source-label">
                    <span class="demo-field-label" id="mcp-source-label">Test image</span>
                    <div class="bb-segmented">
                        @foreach (var source in Sources)
                        {
                            <button type="button" aria-pressed="@(_source == source ? "true" : "false")"
                                    disabled="@_running" @onclick="() => _source = source">@source</button>
                        }
                    </div>
                </div>

                <div class="demo-field">
                    <label class="demo-field-label" for="mcp-size">Source size <span class="demo-field-value">@_width &times; @_height</span></label>
                    <select id="mcp-size" disabled="@_running" @onchange="OnSizeChanged">
                        @foreach (var size in Sizes)
                        {
                            <option value="@size" selected="@($"{_width}x{_height}" == size)">@size.Replace("x", " × ")</option>
                        }
                    </select>
                </div>

                <div class="demo-field" role="group" aria-labelledby="mcp-formats-label">
                    <span class="demo-field-label" id="mcp-formats-label">Formats</span>
                    <div class="bb-segmented">
                        @foreach (var format in Formats)
                        {
                            <button type="button" aria-pressed="@(_formats.Contains(format) ? "true" : "false")"
                                    disabled="@_running" @onclick="() => ToggleFormat(format)">@format</button>
                        }
                    </div>
                </div>

                <div class="demo-field">
                    <label class="demo-field-label" for="mcp-qualities">Qualities</label>
                    <input id="mcp-qualities" type="text" value="@_qualities" disabled="@_running"
                           @onchange="e => _qualities = e.Value?.ToString() ?? string.Empty" />
                </div>

                <div class="demo-field">
                    <label class="demo-field-label" for="mcp-budget">Size budget <span class="demo-field-value">@(_budgetKb > 0 ? $"{_budgetKb} KB" : "none")</span></label>
                    <input id="mcp-budget" type="range" min="0" max="500" step="10" value="@_budgetKb" disabled="@_running"
                           @oninput="OnBudgetChanged" />
                </div>

                <button type="button" class="btn btn-primary demo-btn-block" disabled="@(_running || IsHydrating)" @onclick="RunAsync">
                    @(_running ? "Running..." : "Run it on the engine")
                </button>
            </div>
        </div>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> What leaves with the file</h3>
    <p>
        <code>CompareBmageMetadataPolicies</code> writes a phone photo - GPS position, serial number,
        owner, camera, lens, ISO, date and copyright - through the real encoder under each
        <code>MetadataPolicy</code>, then decodes every file again and reports what is really in it.
        A privacy decision then rests on the exported bytes, not on what a policy's name suggests.
    </p>

    <div class="bb-toolbar">
        <div class="bb-segmented" role="group" aria-label="Format to export">
            @foreach (var format in MetadataFormats)
            {
                <button type="button" aria-pressed="@(_metadataFormat == format ? "true" : "false")"
                        disabled="@_comparing" @onclick="() => _metadataFormat = format">@format</button>
            }
        </div>
        <button type="button" class="btn btn-primary" disabled="@(_comparing || IsHydrating)" @onclick="CompareAsync">
            @(_comparing ? "Encoding..." : "Export it three ways")
        </button>
    </div>

    @if (_compareError is not null)
    {
        <div class="bb-note bb-note-danger demo-error" role="alert">@_compareError</div>
    }
    else if (_comparison?.Error is { } comparisonError)
    {
        <div class="bb-note bb-note-danger demo-error" role="alert">@comparisonError</div>
    }
    else if (_comparison is { Policies: { Length: > 0 } policies })
    {
        <div class="bb-scroll" tabindex="0" role="region" aria-label="Metadata kept per policy">
            <table class="bb-table">
                <thead>
                    <tr>
                        <th scope="col">Field</th>
                        @foreach (var policy in policies)
                        {
                            <th scope="col">@policy.Policy</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var field in _comparison.Original ?? [])
                    {
                        var label = LabelOf(field);

                        <tr>
                            <th scope="row">@label</th>
                            @foreach (var policy in policies)
                            {
                                var kept = (policy.Kept ?? []).Any(entry => LabelOf(entry) == label);
                                <td>@Badge(kept, label is "Location" or "Serial number" or "Owner")</td>
                            }
                        </tr>
                    }
                    <tr>
                        <th scope="row">File size</th>
                        @foreach (var policy in policies)
                        {
                            <td>@Display.Bytes(policy.Bytes)</td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="demo-small mcp-reading">@_comparison.Reading</p>
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Review your code</h3>
    <p>
        <code>ReviewBmageCode</code> is the pass that closes the loop after an agent writes code. Its
        rules look for the mistakes that compile cleanly - a capability probe in
        <code>OnInitializedAsync</code>, <code>@@inject ImageProcessor</code> in a browser app, a
        buffer never disposed, <code>MetadataPolicy.Preserve</code>, WebP with no fallback. The sample
        below has several on purpose.
    </p>

    <div class="demo-field">
        <label class="demo-field-label" for="mcp-review">Code</label>
        <textarea id="mcp-review" class="mcp-input mcp-code" rows="12" spellcheck="false"
                  value="@_review" @onchange="e => _review = e.Value?.ToString() ?? string.Empty"
                  disabled="@(_reviewing || IsHydrating)"></textarea>
    </div>

    <div class="bb-toolbar">
        <button type="button" class="btn btn-primary" disabled="@(_reviewing || IsHydrating)" @onclick="ReviewAsync">
            @(_reviewing ? "Reviewing..." : "Review it")
        </button>
    </div>

    @if (_reviewError is not null)
    {
        <div class="bb-note bb-note-danger demo-error mcp-results" role="alert">@_reviewError</div>
    }
    else if (_findings is not null)
    {
        @if (_findings.Findings is null or { Length: 0 })
        {
            <p class="demo-small mcp-results">Nothing to report - all @(_findings.RulesApplied?.Length ?? 0) rules passed.</p>
        }
        else
        {
            <ul class="mcp-findings mcp-results">
                @foreach (var finding in _findings.Findings)
                {
                    <li class="mcp-finding @finding.Severity?.ToLowerInvariant()">
                        <span class="mcp-finding-head">
                            <span class="bb-badge @SeverityBadge(finding.Severity)">@finding.Severity</span>
                            <code>@finding.Rule</code>
                            @if (finding.Line is { } line)
                            {
                                <span class="demo-small bb-muted">line @line</span>
                            }
                        </span>
                        <span class="mcp-finding-message">@finding.Message</span>
                        <span class="mcp-finding-fix">@finding.Fix</span>
                    </li>
                }
            </ul>
        }
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> One search across everything</h3>
    <p>
        An agent rarely knows which corpus holds the answer. <code>SearchBmage</code> covers every
        guide section, every public member of the package, the setup guides, the recipes, the
        review rules and the demo's sources at once - and every hit carries the exact follow-up call
        that returns it in full.
    </p>

    <div class="mcp-search">
        <input type="search" class="mcp-input" value="@_query" disabled="@(_searching || IsHydrating)"
               @onchange="e => _query = e.Value?.ToString() ?? string.Empty"
               placeholder="avatar under 100 KB" aria-label="Search Bmage" />
        <button type="button" class="btn btn-primary" disabled="@(_searching || IsHydrating)" @onclick="SearchAsync">
            <Icon Path="@Icons.Search" />
            @(_searching ? "Searching..." : "Search")
        </button>
    </div>

    @if (_searchError is not null)
    {
        <div class="bb-note bb-note-danger demo-error" role="alert">@_searchError</div>
    }
    else if (_hits is { Length: > 0 })
    {
        <ul class="mcp-hits">
            @foreach (var hit in _hits)
            {
                <li>
                    <span class="bb-badge demo-badge-off">@hit.Kind</span>
                    <span class="mcp-hit-title">@hit.Title</span>
                    <code>@hit.Tool</code>
                </li>
            }
        </ul>
    }
    else if (_hits is not null)
    {
        <p class="demo-small bb-muted">Nothing matched that.</p>
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Tools</h3>

    @if (_catalog is null)
    {
        <p class="working" role="status"><span class="bb-spinner" aria-hidden="true"></span>Loading the catalog&hellip;</p>
    }
    else
    {
        <p>
            @_catalog.Tools.Length of them, listed straight from the attributes that declare them - so
            this table cannot fall out of step with the server, and neither can this count.
        </p>

        <div class="bb-scroll" tabindex="0" role="region" aria-label="MCP tools">
            <table class="bb-table mcp-tools">
                <thead>
                    <tr><th scope="col">Tool</th><th scope="col">Parameters</th><th scope="col">What it answers</th></tr>
                </thead>
                <tbody>
                    @foreach (var tool in _catalog.Tools)
                    {
                        <tr>
                            <th scope="row" class="bb-table-key"><code>@tool.Name</code></th>
                            <td>
                                @if (tool.Parameters is null or { Length: 0 })
                                {
                                    <span class="bb-muted">none</span>
                                }
                                else
                                {
                                    <div class="mcp-params">
                                        @foreach (var parameter in tool.Parameters)
                                        {
                                            <code>@parameter</code>
                                        }
                                    </div>
                                }
                            </td>
                            <td>@Shorten(tool.Description)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Prompts</h3>
    <p>
        Prompts are the workflows: the order to call the tools in for a whole task. They exist because
        the failure mode of an agent holding a shelf of tools is not ignorance - it is calling them in
        an order that skips the check which would have caught the bug.
    </p>

    @if (_catalog is not null)
    {
        <div class="bb-grid">
            @foreach (var prompt in _catalog.Prompts)
            {
                <div class="bb-card">
                    <p class="bb-card-title"><code>@prompt.Name</code></p>
                    <p class="bb-card-desc">@prompt.Description</p>
                    @if (prompt.Parameters is { Length: > 0 })
                    {
                        <p class="demo-small bb-muted">@string.Join(" · ", prompt.Parameters)</p>
                    }
                </div>
            }
        </div>
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Resources</h3>
    <p>
        The same knowledge as URIs, for clients that attach documentation to a conversation up front
        or let a person browse and pin it. They read the same catalogs the tools do, so neither can go
        stale relative to the other.
    </p>

    @if (_catalog is not null)
    {
        <ul class="mcp-resources">
            @foreach (var resource in _catalog.Resources)
            {
                <li><code>@resource.Name</code> <span class="demo-small bb-muted">@resource.Description</span></li>
            }
        </ul>
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> How it stays true</h3>
    <p>
        Documentation that is written down separately drifts, and an agent cannot tell a stale answer
        from a fresh one. So nothing here is written down twice:
    </p>

    <ul class="bb-detail-list">
        <li>
            <strong>The API reference is reflected</strong> out of the shipped assembly and
            paired with the XML documentation compiled into it, with each type's namespace and
            package - Bmage spreads its types over a dozen namespaces, and a wrong <code>using</code> is
            the commonest way generated code fails to compile.
        </li>
        <li>
            <strong>The guides, the demo pages and their sources are embedded</strong> into the server
            assembly, so the tools keep working from a published deployment and hand out the same text
            this site renders.
        </li>
        <li>
            <strong>Sizes are measured, not estimated.</strong> The pipeline is built by reflection over
            <code>ImagePipeline</code>'s own builder methods and run by the same engine a browser runs,
            with the managed codecs a headless host has; the budget search is the library's own.
        </li>
        <li>
            <strong>Privacy is read back, not asserted.</strong> The metadata comparison decodes the file
            the encoder wrote, so it reports what is in the bytes.
        </li>
    </ul>

    <CodeSnippet Code="@ArchitectureCode" Language="C#" />
</div>

@code {
    private sealed record Problem(string Symptom, string Cause, string Tool);

    private sealed record McpEndpoint(string Name, string Key, string Url, string Note);

    // The config is written against the endpoint the reader picked; "This site" resolves against the
    // address the page is served from, so on localhost, a tunnel or a deployment the snippet points
    // at the server being looked at.
    private sealed record McpClient(string Name, string Note, string Language, Func<string, string, string> Config);

    private sealed record Preset(string Name, string Pipeline, string Source, string[] Formats, int BudgetKb);

    // The response shapes of the endpoints this page calls. They mirror the server's DTOs rather than
    // sharing them: the client project does not reference the host, and these are the fields the page
    // renders - not the whole contract. Arrays are nullable throughout: what comes back is JSON, and a
    // body missing a field deserialises to null rather than to an empty array.
    private sealed record Run(int OutputWidth, int OutputHeight, double ExecuteMilliseconds, double? UnoptimizedMilliseconds,
        EncodingRow[]? Encodings, BudgetRow[]? Budgets, string[]? OptimizedOperations, string[]? OptimizerNotes,
        string? Reading, string[]? Warnings, string? Error);

    private sealed record EncodingRow(string Format, double? Quality, long? Bytes, double? BitsPerPixel, double? EncodeMilliseconds, string? Note);

    private sealed record BudgetRow(string Format, long MaxFileSize, bool Met, long? Bytes, double? Quality, int? Width, int? Height, string? Error);

    private sealed record Comparison(string[]? Original, PolicyRow[]? Policies, string? Reading, string? Error);

    private sealed record PolicyRow(string Policy, long Bytes, string[]? Kept, bool LeaksLocation);

    private sealed record Review(bool Passed, Finding[]? Findings, string[]? RulesApplied);

    private sealed record Finding(string? Severity, string Rule, int? Line, string Message, string Fix);

    private sealed record Hit(string Kind, string Title, string? Context, string Tool, string Snippet);

    private sealed record Catalog(CatalogMember[] Tools, CatalogMember[] Prompts, CatalogMember[] Resources);

    private sealed record CatalogMember(string Name, string Description, string[]? Parameters);

