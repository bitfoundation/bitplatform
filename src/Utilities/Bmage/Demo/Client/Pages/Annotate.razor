@page "/annotate"
@implements IAsyncDisposable
@inject ImageLoader Loader
@inject IImageCapabilityProvider Capabilities
@inject DemoFonts Fonts

@* A bug report's screenshot: paste it in, point at the problem, black out what must not be shared.
   The page is the editor component plus three things a host adds around it - a page-wide paste
   listener, a clipboard button, and annotations placed from code - which is most of what a real
   app's integration would look like. *@

<PageTitle>Screenshot annotation · Bmage</PageTitle>

<div class="bb-intro">
    <h1>Screenshot annotation</h1>
    <p class="bb-subtitle">
        Paste a screenshot, point at the problem, and black out anything that must not leave the
        building. Annotations stay <strong>editable objects</strong> until you export, so nothing is
        baked in until you say so.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Annotate a screenshot</h3>

    @if (_error is not null)
    {
        <div class="bb-note bb-note-danger demo-error" role="alert">@_error</div>
    }
    @if (!HasImage)
    {
        <div class="bb-note">
            Press <strong>Ctrl+V</strong> (<strong>&#8984;V</strong> on a Mac) anywhere on this page to
            bring in a screenshot, or drop an image on the editor below.
        </div>
    }

    <div class="bb-toolbar">
        <button type="button" class="btn btn-secondary" disabled="@(_capabilities?.SupportsClipboardRead != true)" @onclick="PasteAsync"
                title="Reads the clipboard directly; the browser asks for permission the first time">Paste from clipboard</button>
        <button type="button" class="btn btn-secondary" disabled="@(HasImage || IsHydrating)" @onclick="UseSample">Use a sample image</button>
        <button type="button" class="btn btn-secondary" disabled="@(!HasImage)" @onclick="AddSampleAnnotations">Add a worked example</button>
        <button type="button" class="btn btn-secondary" disabled="@(!HasImage || _capabilities?.SupportsClipboardWrite != true)" @onclick="CopyResultAsync"
                title="Exports the annotated image as PNG and puts it on the clipboard, ready to paste into a bug report">Copy the result</button>
        <button type="button" class="btn btn-secondary" disabled="@(!HasImage)" @onclick="Clear">Start over</button>
        @if (_copied)
        {
            <span class="demo-small bb-muted" role="status">Copied - paste it into the bug report.</span>
        }
    </div>

    <div class="editor-frame bb-page-wide">
        <BmageEditor @ref="_editor"
                     Image="_source"
                     ExportOptions="ExportOptions"
                     OnImageLoaded="OnEditorImageLoaded"
                     OnError="OnEditorError" />
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Redaction that actually redacts</h3>
    <p>
        The redaction tool replaces the pixels underneath it, so the hidden content is genuinely gone
        from the exported file rather than covered by a layer someone can move. It comes in three modes -
        <code>Solid</code>, <code>Pixelate</code> and <code>Blur</code>; the worked example uses the first
        two. Solid blocks are the safe choice: pixelation and a strong blur are usually irreversible in
        practice, but text can sometimes be recovered when its possible values are few, and a solid
        rectangle removes all doubt. Redactions are always drawn before other annotations, so an arrow
        you place on top is never blurred away.
    </p>
    <div class="bb-note">
        <p>
            Redaction is about pixels; metadata is a separate leak. This page exports with
            <code>MetadataPolicy.Remove</code> - see <a href="/metadata">Metadata and privacy</a>.
        </p>
    </div>
    <CodeSnippet Code="@Snippet" Language="C#" Expanded="true" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Every kind of annotation</h3>
    <p>
        Annotations are records drawn over the image and its layers, each one selectable, movable,
        rotatable, fadable, lockable and reorderable until export - in the editor with the pointer or
        the keyboard, and from code with <code>AddAnnotationAsync</code>, <code>UpdateAnnotationAsync</code>
        and <code>DeleteAnnotationAsync</code>.
    </p>
    <div class="bb-scroll" tabindex="0" role="region" aria-label="Annotation types">
        <table class="bb-table">
            <thead>
                <tr><th scope="col">Record</th><th scope="col">Draws</th></tr>
            </thead>
            <tbody>
                <tr><th scope="row"><code>RectangleAnnotation</code>, <code>EllipseAnnotation</code></th><td>A shape, outlined or filled, solid or dashed.</td></tr>
                <tr><th scope="row"><code>LineAnnotation</code>, <code>ArrowAnnotation</code></th><td>A straight line, or one with an arrow head at its end.</td></tr>
                <tr><th scope="row"><code>FreehandAnnotation</code>, <code>PolygonAnnotation</code></th><td>A smoothed pen stroke, or a closed outline through points.</td></tr>
                <tr><th scope="row"><code>TextAnnotation</code></th><td>A label in any registered font, wrapped, with an optional background box - shaped right to left where the text is.</td></tr>
                <tr><th scope="row"><code>CalloutAnnotation</code></th><td>A speech bubble with text and a leader line to what it explains.</td></tr>
                <tr><th scope="row"><code>StepAnnotation</code></th><td>A numbered marker for the order of a tutorial or a reproduction.</td></tr>
                <tr><th scope="row"><code>HighlightAnnotation</code></th><td>A translucent block, like a marker pen.</td></tr>
                <tr><th scope="row"><code>RedactionAnnotation</code></th><td>Hidden content: solid, pixelated or blurred, in the pixels themselves.</td></tr>
                <tr><th scope="row"><code>ImageAnnotation</code></th><td>An image stamped in a rectangle: a logo, a sticker, a signature.</td></tr>
            </tbody>
        </table>
    </div>
    <CodeSnippet Code="@MoreSnippet" Language="C#" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Pasting from anywhere on the page</h3>
    <p>
        <code>ListenForPasteAsync</code> listens for the browser's own paste event, which carries the
        image with it - so <strong>Ctrl+V</strong> works without the clipboard permission prompt.
        <code>LoadFromClipboardAsync</code>, behind the button, reads the clipboard directly; that
        needs the permission, which is why the button is only enabled where the capability probe
        found the API. <strong>Copy the result</strong> closes the loop the other way:
        <code>CopyToClipboardAsync</code> renders the edit at full resolution and puts it on the clipboard
        as PNG, the format browsers reliably accept, ready to paste into the report.
    </p>
    <CodeSnippet Code="@PasteSnippet" Language="Razor" />
</div>

@code {
    private BmageEditor? _editor;
    private ImageBuffer? _source;
    private ImageCapabilities? _capabilities;
    private IAsyncDisposable? _pasteListener;
    private string? _error;
    private bool _copied;

    /// <summary>The editor owns the image once loaded, whether it came from here or from its own drop zone.</summary>
    private bool HasImage => _editor?.Session is not null;

    private bool IsHydrating => RendererInfo.IsInteractive is false;

    private static readonly ImageExportOptions ExportOptions = new()
    {
        Format = ImageFormat.Png,
        Metadata = MetadataPolicy.Remove,
    };

    private const string Snippet = """
        // Annotations are records, so building one is a value, not a mutation.
        await editor.AddAnnotationAsync(new RedactionAnnotation
        {
            Rectangle = new RectangleF(40, 120, 320, 28),
            Mode      = RedactionMode.Solid,   // Pixelate and Blur are also available
        });

        await editor.AddAnnotationAsync(new ArrowAnnotation
        {
            Start = new Vector2(500, 380),
            End   = new Vector2(360, 220),
            Style = ShapeStyle.Default with { Stroke = new StrokeStyle { Width = 6 } },
        });

        await editor.AddAnnotationAsync(new StepAnnotation
        {
            Center = new Vector2(340, 400),
            Number = 1,
        });

        await editor.AddAnnotationAsync(new CalloutAnnotation
        {
            Bubble    = new RectangleF(620, 420, 260, 64),
            Target    = new Vector2(700, 330),   // where the leader line points
            Text      = "Total shows 0",
            TextStyle = new TextStyle { FontSize = 22, Bold = true, Alignment = TextAlignment.Center, Baseline = TextBaseline.Middle },
        });
        """;

    private const string MoreSnippet = """
        await editor.AddAnnotationAsync(new TextAnnotation
        {
            Text            = "Steps to reproduce",
            Position        = new Vector2(40, 60),
            Style           = new TextStyle { FontSize = 28, Bold = true, FillColor = Rgba32.White, MaxWidth = 400 },
            BackgroundColor = new Rgba32(20, 20, 20, 200),
        });

        await editor.AddAnnotationAsync(new EllipseAnnotation
        {
            Rectangle = new RectangleF(500, 200, 160, 90),
            Style     = ShapeStyle.Default with { Stroke = new StrokeStyle { Width = 4, DashPattern = [10f, 6f] } },
        });

        await editor.AddAnnotationAsync(new ImageAnnotation { Image = logo, Rectangle = new RectangleF(20, 20, 96, 96) });

        // Every annotation is a record: change one with `with`, and the edit is one undo step.
        var arrow = (ArrowAnnotation)editor.Document!.FindAnnotation(id)!;
        await editor.UpdateAnnotationAsync(arrow with { Rotation = 15, Opacity = 0.8f, IsLocked = true });
        """;

    private const string PasteSnippet = """
        @implements IAsyncDisposable
        @inject ImageLoader Loader

        <BmageEditor @ref="_editor" />

        @code {
            private BmageEditor? _editor;
            private IAsyncDisposable? _paste;

            protected override async Task OnAfterRenderAsync(bool firstRender)
            {
                if (!firstRender) return;

                // Ctrl+V anywhere on the page: the paste event carries the image,
                // so no clipboard permission is needed.
                _paste = await Loader.ListenForPasteAsync(
                    image => _editor!.LoadImageAsync(image));
            }

            // Back out: the annotated image, as PNG, on the clipboard.
            private Task CopyAsync() => _editor!.CopyToClipboardAsync();

            public async ValueTask DisposeAsync()
            {
                if (_paste is not null) await _paste.DisposeAsync();
            }
        }
        """;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || IsHydrating) return;
        _capabilities = await Capabilities.GetAsync();
        _pasteListener = await Loader.ListenForPasteAsync(OnPastedAsync, ex =>
        {
            _error = Describe(ex);
            StateHasChanged();
            return Task.CompletedTask;
        });
        StateHasChanged();

        // The font the step numbers and text labels are drawn with (see Shared/DemoFonts.cs).
        try
        {
            await Fonts.EnsureAsync();
        }
        catch (Exception)
        {
            // Without it the editor says why its text cannot be drawn.
            return;
        }
        if (_editor?.Session is not null) await _editor.RefreshAsync();
    }

    private Task OnPastedAsync(ImageBuffer image)
    {
        _error = null;
        SetSource(image);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task PasteAsync()
    {
        _error = null;
        try
        {
            var image = await Loader.LoadFromClipboardAsync();
            if (image is null)
            {
                _error = "There is no image on the clipboard.";
                return;
            }
            SetSource(image);
        }
        catch (Exception ex)
        {
            _error = ex is ImageCapabilityException c ? c.Message : $"Could not read the clipboard: {ex.Message}";
        }
    }

    private void UseSample() => SetSource(SampleImages.Landscape());

    /// <summary>Hands a new image to the editor, which copies it, replacing whatever it was showing.</summary>
    private void SetSource(ImageBuffer image)
    {
        _source?.Dispose();
        _source = image;
    }

    /// <summary>
    /// Places a realistic set of annotations so the page demonstrates the model without needing the user to draw.
    /// Coordinates are relative to the image so the example fits whatever was pasted.
    /// </summary>
    private async Task AddSampleAnnotations()
    {
        if (_editor?.Session is not { } session) return;
        var w = session.OutputSize.Width;
        var h = session.OutputSize.Height;

        await _editor.AddAnnotationAsync(new RedactionAnnotation
        {
            Rectangle = new System.Drawing.RectangleF(w * 0.06f, h * 0.10f, w * 0.34f, h * 0.06f),
            Mode = RedactionMode.Solid,
        }, "Redact");

        await _editor.AddAnnotationAsync(new RectangleAnnotation
        {
            Rectangle = new System.Drawing.RectangleF(w * 0.52f, h * 0.30f, w * 0.36f, h * 0.22f),
            Style = ShapeStyle.Default with { Stroke = new StrokeStyle { Width = MathF.Max(3, w / 300f) } },
        }, "Rectangle");

        await _editor.AddAnnotationAsync(new ArrowAnnotation
        {
            Start = new Vector2(w * 0.30f, h * 0.78f),
            End = new Vector2(w * 0.56f, h * 0.46f),
            Style = ShapeStyle.Default with { Stroke = new StrokeStyle { Width = MathF.Max(4, w / 220f) } },
        }, "Arrow");

        await _editor.AddAnnotationAsync(new StepAnnotation
        {
            Center = new Vector2(w * 0.26f, h * 0.82f),
            Number = 1,
            Radius = MathF.Max(14, w / 45f),
        }, "Step");

        await _editor.AddAnnotationAsync(new HighlightAnnotation
        {
            Rectangle = new System.Drawing.RectangleF(w * 0.06f, h * 0.60f, w * 0.30f, h * 0.05f),
        }, "Highlight");

        // The second redaction mode, beside the solid block above: the blocks are coarse enough that nothing reads.
        await _editor.AddAnnotationAsync(new RedactionAnnotation
        {
            Rectangle = new System.Drawing.RectangleF(w * 0.56f, h * 0.10f, w * 0.34f, h * 0.06f),
            Mode = RedactionMode.Pixelate,
        }, "Redact");

        // A callout under the outlined area, saying what is wrong there, its text sized to fit the bubble on one line
        // whatever the screenshot's shape.
        var bubbleWidth = w * 0.30f;
        var fontSize = MathF.Max(10, MathF.Min(h / 26f, bubbleWidth / 9.5f));
        await _editor.AddAnnotationAsync(new CalloutAnnotation
        {
            Bubble = new System.Drawing.RectangleF(w * 0.60f, h * 0.64f, bubbleWidth, fontSize * 2.2f),
            Target = new Vector2(w * 0.70f, h * 0.52f),
            Text = "Wrong total here",
            TextStyle = new TextStyle { FontSize = fontSize, Bold = true, Alignment = TextAlignment.Center, Baseline = TextBaseline.Middle },
            Style = ShapeStyle.Default with { FillColor = Rgba32.White, Stroke = new StrokeStyle { Width = MathF.Max(2, w / 400f) } },
        }, "Callout");
    }

    private async Task CopyResultAsync()
    {
        if (_editor is null) return;
        _copied = false;
        _error = null;
        // The editor reports a refusal (the browser's permission, say) through OnError, like every action it runs.
        await _editor.CopyToClipboardAsync();
        _copied = _error is null;
    }

    private void OnEditorError(Exception ex) => _error = Describe(ex);

    // The editor can load an image through its own drop zone, so the page has to re-render to enable its buttons.
    private void OnEditorImageLoaded(ImageBuffer image) => StateHasChanged();

    private async Task Clear()
    {
        _source?.Dispose();
        _source = null;
        _error = null;
        // Disposing the editor ends its session, which brings back its drop zone.
        if (_editor is not null) await _editor.DisposeAsync();
        StateHasChanged();
    }

    private static string Describe(Exception ex) => ex switch
    {
        ImageLimitExceededException => "That image is larger than this page allows.",
        ImageDecodeException => "That could not be read as an image.",
        _ => ex.Message,
    };

    public async ValueTask DisposeAsync()
    {
        if (_pasteListener is not null) await _pasteListener.DisposeAsync();
        _source?.Dispose();
    }
}
