@page "/performance"
@implements IDisposable

@* The numbers, and the one decision that matters more than any of them in a browser: compiling
   ahead of time. The live benchmark runs the interpreter-vs-AOT table's own operations in the
   reader's browser, so whether the site they are on was compiled ahead of time shows up in their
   own measurements rather than in a claim. *@

<PageTitle>Performance · Bmage</PageTitle>

<div class="bb-intro">
    <h1>Performance</h1>
    <p class="bb-subtitle">
        Every number here was measured with BenchmarkDotNet, not estimated - and in the browser, they only
        hold with <strong>ahead-of-time compilation</strong>. Read the first section before anything else.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Measure this browser</h3>
    <p>
        The operations from the table below, on a generated 1920 &times; 1080 image, best of three
        after a warm-up. Around five times the AOT column means the interpreter. This site is
        published with AOT; under <code>dotnet run</code> it is interpreted, and every row takes
        several times longer - which is the point.
    </p>
    <div class="bb-toolbar">
        <button type="button" class="btn btn-primary" disabled="@(_busy || IsHydrating)" @onclick="RunAsync">
            <Icon Path="@Icons.Gauge" />
            Run the benchmark
        </button>
        @if (_busy)
        {
            <span class="working" role="status"><span class="bb-spinner" aria-hidden="true"></span>Measuring @_current&hellip;</span>
        }
    </div>

    @if (_results.Count > 0)
    {
        <div class="bb-scroll perf-results" tabindex="0" role="region" aria-label="Benchmark results for this browser">
            <table class="bb-table">
                <thead>
                    <tr>
                        <th scope="col">Operation</th>
                        <th scope="col" class="demo-num">This browser</th>
                        <th scope="col" class="demo-num">Interpreter</th>
                        <th scope="col" class="demo-num">AOT</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in _results)
                    {
                        <tr>
                            <th scope="row">@result.Name</th>
                            <td class="demo-num"><strong>@result.Elapsed.TotalMilliseconds.ToString("0") ms</strong></td>
                            <td class="demo-num">@result.Interpreter ms</td>
                            <td class="demo-num">@result.Aot ms</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> WebAssembly: compile ahead of time</h3>
    <p>
        By default Blazor WebAssembly runs .NET code on an IL interpreter. Tight pixel loops are its
        worst case: every <code>Vector4</code> operation RyuJIT turns into one SIMD instruction becomes
        a separate interpreted step. Bmage's loops are written around that, and the browser does the
        decoding, encoding and the editor's working copy, but what stays in .NET is still several times
        faster compiled ahead of time. Measured on a 1920 &times; 1080 image in Chromium, best of three
        after a warm-up:
    </p>
    <div class="bb-scroll" tabindex="0" role="region" aria-label="Interpreter against AOT">
        <table class="bb-table">
            <thead>
                <tr><th scope="col">Operation</th><th scope="col" class="demo-num">Interpreter</th><th scope="col" class="demo-num">AOT</th><th scope="col" class="demo-num">Desktop .NET</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Reference)
                {
                    <tr><th scope="row">@row.Name</th><td class="demo-num">@row.Interpreter ms</td><td class="demo-num"><strong>@row.Aot ms</strong></td><td class="demo-num">@row.Desktop ms</td></tr>
                }
            </tbody>
        </table>
    </div>
    <p>
        The interpreter is 5 to 9&times; slower than desktop .NET; AOT is within 1 to 2.3&times; of it. A Debug
        build measured the same as Release on the interpreter, so the build configuration is not the
        issue. <a href="/hosting">Hosting models</a> shows how to switch it on, and how this site does.
    </p>
    <CodeSnippet Code="@AotSnippet" Language="XML" Expanded="true" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Resizing</h3>
    <p>Downscaling to 1280px on the long edge, and generating a 200px thumbnail (desktop .NET 10, AVX2):</p>
    <div class="bb-scroll" tabindex="0" role="region" aria-label="Resize timings">
        <table class="bb-table">
            <thead>
                <tr><th scope="col">Operation</th><th scope="col" class="demo-num">1920&times;1080</th><th scope="col" class="demo-num">3840&times;2160</th><th scope="col" class="demo-num">6000&times;4000</th></tr>
            </thead>
            <tbody>
                <tr><th scope="row">Box</th><td class="demo-num">9.8 ms</td><td class="demo-num">16.5 ms</td><td class="demo-num">63.1 ms</td></tr>
                <tr><th scope="row">Bilinear</th><td class="demo-num">10.6 ms</td><td class="demo-num">20.6 ms</td><td class="demo-num">65.0 ms</td></tr>
                <tr><th scope="row">Bicubic</th><td class="demo-num">13.4 ms</td><td class="demo-num">25.4 ms</td><td class="demo-num">76.1 ms</td></tr>
                <tr><th scope="row">Lanczos3</th><td class="demo-num">16.0 ms</td><td class="demo-num">40.0 ms</td><td class="demo-num">82.2 ms</td></tr>
                <tr><th scope="row">Thumbnail to 200px (Auto)</th><td class="demo-num">3.3 ms</td><td class="demo-num">8.1 ms</td><td class="demo-num">22.6 ms</td></tr>
            </tbody>
        </table>
    </div>
    <p>
        Allocations stay between 23 KB and 185 KB regardless of source size, because pixel buffers are
        pooled and the resampler works a row at a time. Thumbnailing a 24 megapixel photo originally
        took 368 ms; an exact integer box prepass to within 2&times; of the target, finished by the
        requested filter, brought it to 52 ms and cut its allocations tenfold - with quality guarded by
        tests that a ramp stays linear and a fine checkerboard averages to grey rather than aliasing.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Operations and pipelines</h3>
    <div class="bb-scroll" tabindex="0" role="region" aria-label="Operation timings">
        <table class="bb-table">
            <thead>
                <tr><th scope="col">Operation</th><th scope="col" class="demo-num">1920&times;1080</th><th scope="col" class="demo-num">3840&times;2160</th></tr>
            </thead>
            <tbody>
                <tr><th scope="row">Crop</th><td class="demo-num">0.06 ms</td><td class="demo-num">0.28 ms</td></tr>
                <tr><th scope="row">Rotate 90 (lossless)</th><td class="demo-num">1.8 ms</td><td class="demo-num">27.2 ms</td></tr>
                <tr><th scope="row">Brightness (one pass)</th><td class="demo-num">1.3 ms</td><td class="demo-num">5.1 ms</td></tr>
                <tr><th scope="row">Four adjustments, fused</th><td class="demo-num">17.2 ms</td><td class="demo-num">67.4 ms</td></tr>
                <tr><th scope="row">Four adjustments, unfused</th><td class="demo-num">18.4 ms</td><td class="demo-num">75.2 ms</td></tr>
                <tr><th scope="row">Gaussian blur, radius 8</th><td class="demo-num">25.3 ms</td><td class="demo-num">99.5 ms</td></tr>
                <tr><th scope="row">Unsharp mask</th><td class="demo-num">27.3 ms</td><td class="demo-num">107 ms</td></tr>
                <tr><th scope="row">Rotate 37&deg; (resampled)</th><td class="demo-num">65.6 ms</td><td class="demo-num">236 ms</td></tr>
            </tbody>
        </table>
    </div>
    <ul class="bb-detail-list">
        <li><strong>Fusing adjustments is worth about 1.1&times;.</strong> Adjustments that map each channel from itself, such as brightness, contrast and gamma, run through 256-entry tables whether fused or not, so fusing mostly saves passes over the pixels.</li>
        <li><strong>A right angle is 9 to 37&times; cheaper than an arbitrary one</strong>, because it moves pixels rather than resampling them. The optimiser routes multiples of 90&deg; to the lossless path automatically.</li>
        <li><strong>Blur is independent of radius</strong>: three box passes approximating a gaussian, so radius 40 costs the same as radius 4. Below a radius of about 2, where whole-pixel boxes would miss by more than 10%, a sampled gaussian of at most 13 taps runs instead.</li>
        <li><strong>Resize then crop fuses</strong> into one resample of only the surviving region - 25.8 ms against 62.2 ms on a 4000 &times; 3000 source, bit-identical.</li>
    </ul>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Codecs</h3>
    <div class="bb-scroll" tabindex="0" role="region" aria-label="Codec timings">
        <table class="bb-table">
            <thead>
                <tr><th scope="col">Operation</th><th scope="col" class="demo-num">1024&times;768</th><th scope="col" class="demo-num">3840&times;2160</th><th scope="col" class="demo-num">Allocated (4K)</th></tr>
            </thead>
            <tbody>
                <tr><th scope="row">PNG decode</th><td class="demo-num">8.7 ms</td><td class="demo-num">88 ms</td><td class="demo-num">37 MB</td></tr>
                <tr><th scope="row">JPEG decode</th><td class="demo-num">7.4 ms</td><td class="demo-num">77 ms</td><td class="demo-num">14 MB</td></tr>
                <tr><th scope="row">JPEG encode, quality 85</th><td class="demo-num">11.5 ms</td><td class="demo-num">122 ms</td><td class="demo-num">6.7 MB</td></tr>
                <tr><th scope="row">PNG encode, level 1</th><td class="demo-num">19.2 ms</td><td class="demo-num">198 ms</td><td class="demo-num">98 MB</td></tr>
                <tr><th scope="row">PNG encode, level 6</th><td class="demo-num">68.0 ms</td><td class="demo-num">720 ms</td><td class="demo-num">46 MB</td></tr>
            </tbody>
        </table>
    </div>
    <p>
        PNG compression level matters more than anything else here: level 6 is 3.6&times; slower than
        level 1 for a modest size gain. Level 1 suits a preview that is on screen for a moment; the
        default of 6 suits the file the user keeps.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Interactive editing</h3>
    <p>
        The editor works on a proxy no larger than 2048px on its longest edge and replays the edit at
        full resolution on export: for a 24 megapixel photo, a 25&times; reduction in the pixels each
        preview touches - the difference between a slider that tracks your finger and one that does
        not. History stores descriptions, not pixels: a test asserts that 100 undo steps on a 6000
        &times; 4000 image stay under 1 MB, where pixel snapshots would need about 4.8 GB.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Guidance</h3>
    <ul class="bb-detail-list">
        <li><strong>Cap dimensions before anything else.</strong> Every later operation costs proportionally less.</li>
        <li><strong>Group adjustments together.</strong> Consecutive per-pixel operations fuse into one pass; a geometric operation between them prevents that.</li>
        <li><strong>Prefer right angles.</strong> <code>Rotate(90)</code> takes the lossless path; <code>Rotate(90.5)</code> resamples the whole image.</li>
        <li><strong>Keep batch concurrency low.</strong> Each worker holds a decoded image; four on 24 megapixel photos is roughly 400 MB of live pixels.</li>
        <li><strong>Dispose buffers</strong>, and <strong>use object URLs</strong>, not data URLs.</li>
    </ul>
    <CodeSnippet Code="ImagePipeline.Create().AutoOrient().MaxSize(1920, 1920).Sharpen(0.3f)" Language="C#" Expanded="true" />
</div>

@code {
    private sealed record ReferenceRow(string Name, int Interpreter, int Aot, int Desktop);

    private sealed record Result(string Name, TimeSpan Elapsed, int Interpreter, int Aot);

    private static readonly ReferenceRow[] Reference =
    [
        new("Resize to 1280, Lanczos3", 108, 24, 15),
        new("Brightness", 11, 3, 1),
        new("Four adjustments, fused", 118, 23, 25),
        new("Gaussian blur, radius 8", 125, 24, 24),
        new("Unsharp mask", 203, 36, 25),
    ];

    // The same operations as the reference table, so the reader's numbers line up against it row by row.
    private static readonly (string Name, Func<ImagePipeline> Pipeline)[] Benchmarks =
    [
        ("Resize to 1280, Lanczos3", () => ImagePipeline.Create().Resize(1280, 1280, ResizeMode.Fit, ResamplingFilter.Lanczos3)),
        ("Brightness", () => ImagePipeline.Create().Brightness(0.2f)),
        ("Four adjustments, fused", () => ImagePipeline.Create().Brightness(0.1f).Contrast(0.15f).Saturation(0.2f).Vibrance(0.2f)),
        ("Gaussian blur, radius 8", () => ImagePipeline.Create().Blur(8f)),
        ("Unsharp mask", () => ImagePipeline.Create().Sharpen(0.5f)),
    ];

    private readonly List<Result> _results = [];
    private string _current = "";
    private bool _busy;
    private bool _disposed;

    private bool IsHydrating => RendererInfo.IsInteractive is false;

    private const string AotSnippet = """
        <PropertyGroup>
          <RunAOTCompilation>true</RunAOTCompilation>
        </PropertyGroup>
        """;

    private async Task RunAsync()
    {
        _busy = true;
        _results.Clear();
        _current = "the source";
        StateHasChanged();
        await Task.Yield();

        using var source = SampleImages.Landscape(1920, 1080);

        for (var i = 0; i < Benchmarks.Length && !_disposed; i++)
        {
            var (name, pipeline) = Benchmarks[i];
            _current = name.ToLowerInvariant();
            StateHasChanged();
            await Task.Yield();

            // One warm-up, then the best of three: the first run pays for JIT-free but cold code paths
            // and pool growth, which is not what the row is measuring.
            var best = TimeSpan.MaxValue;
            for (var attempt = 0; attempt < 4 && !_disposed; attempt++)
            {
                var started = System.Diagnostics.Stopwatch.StartNew();
                using (pipeline().Execute(source)) { }
                started.Stop();
                if (attempt > 0 && started.Elapsed < best) best = started.Elapsed;

                // Let the page breathe between runs on a single-threaded runtime.
                await Task.Yield();
            }

            var reference = Reference[i];
            _results.Add(new Result(name, best, reference.Interpreter, reference.Aot));
        }

        _busy = false;
    }

    public void Dispose() => _disposed = true;
}
