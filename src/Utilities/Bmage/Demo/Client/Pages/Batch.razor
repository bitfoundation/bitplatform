@page "/batch"
@implements IDisposable
@inject ImageProcessorFactory Processors
@inject ImageExporter Exporter
@inject IImageCapabilityProvider Capabilities

@* The headless batch API driving a UI - not a separate code path. ProcessBatchAsync runs one
   pipeline over every item with a bounded number of workers, reports progress per item, honours
   cancellation, and hands back every item's own outcome, so one unreadable file is a row in the
   table rather than the end of the run. *@

<PageTitle>Batch processing · Bmage</PageTitle>

<div class="bb-intro">
    <h1>Batch processing</h1>
    <p class="bb-subtitle">
        The same pipeline over many files with <strong>bounded concurrency</strong>, live progress,
        cancellation, and a per-file result rather than one failure aborting the run. This is the
        headless batch API driving a UI, not a separate code path.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Try it</h3>

    @if (_error is not null)
    {
        <div class="bb-note bb-note-danger demo-error" role="alert">@_error</div>
    }

    <div class="bb-demo bb-page-wide">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live</span></div>
        <div class="demo-split">
            <div>
                <BmageDropZone Label="Drop several images here" Multiple="true" MaxFiles="200" OnFilesSelected="OnFilesSelected" />

                @if (_running || _result is not null)
                {
                    <div class="bb-toolbar optimize-progress">
                        <div class="demo-progress" role="progressbar" aria-label="Batch progress" aria-valuenow="@_completed" aria-valuemin="0" aria-valuemax="@_total">
                            <div class="demo-progress-bar" style="width:@(_total == 0 ? 0 : _completed * 100 / _total)%"></div>
                        </div>
                        <span class="demo-small bb-muted" role="status">@_completed of @_total</span>
                        @if (_running)
                        {
                            <button type="button" class="btn btn-secondary demo-btn-sm" @onclick="Cancel">Stop</button>
                        }
                    </div>
                }

                @if (_result is not null)
                {
                    <div class="bb-stats results-stats">
                        <div class="bb-stat">
                            <span class="bb-stat-label">Succeeded</span>
                            <span class="bb-stat-value demo-good">@_result.SuccessCount</span>
                        </div>
                        <div class="bb-stat">
                            <span class="bb-stat-label">Failed</span>
                            <span class="bb-stat-value @(_result.FailureCount > 0 ? "demo-bad" : null)">@_result.FailureCount</span>
                        </div>
                        <div class="bb-stat">
                            <span class="bb-stat-label">Input</span>
                            <span class="bb-stat-value">@Display.Bytes(_result.TotalInputBytes)</span>
                        </div>
                        <div class="bb-stat">
                            <span class="bb-stat-label">Output</span>
                            <span class="bb-stat-value">@Display.Bytes(_result.TotalOutputBytes)</span>
                        </div>
                        <div class="bb-stat">
                            <span class="bb-stat-label">Elapsed</span>
                            <span class="bb-stat-value">@_result.Duration.TotalSeconds.ToString("0.0")s</span>
                        </div>
                        <div class="bb-stat">
                            <span class="bb-stat-label">Per image</span>
                            <span class="bb-stat-value">@((_result.Results.Count == 0 ? 0 : _result.Duration.TotalMilliseconds / _result.Results.Count).ToString("0"))ms</span>
                        </div>
                    </div>

                    <div class="bb-scroll results-table" tabindex="0" role="region" aria-label="Batch results">
                        <table class="bb-table">
                            <thead>
                                <tr>
                                    <th scope="col">File</th>
                                    <th scope="col">Result</th>
                                    <th scope="col" class="demo-num">In</th>
                                    <th scope="col" class="demo-num">Out</th>
                                    <th scope="col" class="demo-num">Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _result.Results)
                                {
                                    <tr>
                                        <td>@(item.FileName ?? "—")</td>
                                        <td>
                                            @if (item.IsSuccess)
                                            {
                                                <span class="bb-badge bb-badge-success">@item.Output!.Width×@item.Output.Height @item.Output.Format.ToString().ToUpperInvariant()</span>
                                            }
                                            else if (item.WasCancelled)
                                            {
                                                <span class="bb-badge demo-badge-off">stopped</span>
                                            }
                                            else
                                            {
                                                <span class="bb-badge bb-badge-danger">@Describe(item.Error!)</span>
                                            }
                                        </td>
                                        <td class="demo-num">@Display.Bytes(item.Item.Data.Length)</td>
                                        <td class="demo-num">@(item.Output is null ? "—" : Display.Bytes(item.Output.Length))</td>
                                        <td class="demo-num">@item.Duration.TotalMilliseconds.ToString("0")ms</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="bb-toolbar">
                        <button type="button" class="btn btn-primary" disabled="@(_running || _result.SuccessCount == 0)" @onclick="DownloadAll">
                            <Icon Path="@Icons.Download" />
                            Download results
                        </button>
                    </div>
                }
            </div>

            <div class="demo-panel">
                <p class="bb-overline demo-label">Pipeline</p>

                <div class="demo-field">
                    <label class="demo-field-label" for="edge">Longest edge <span class="demo-field-value">@_maxEdge px</span></label>
                    <input id="edge" type="range" min="240" max="3840" step="80" value="@_maxEdge" @oninput="e => SetInt(ref _maxEdge, e)" />
                </div>

                <div class="demo-field">
                    <label class="demo-field-label" for="conc">Concurrency <span class="demo-field-value">@_concurrency</span></label>
                    <input id="conc" type="range" min="1" max="8" step="1" value="@_concurrency" @oninput="e => SetInt(ref _concurrency, e)" aria-describedby="conc-hint" />
                    <span class="bb-field-hint" id="conc-hint">Each worker holds a decoded image, so this is a memory dial as much as a speed dial.</span>
                </div>

                <div class="demo-field">
                    <label class="demo-field-label" for="bformat">Format</label>
                    <select id="bformat" disabled="@(_capabilities is null)" @onchange="OnFormatChanged">
                        @foreach (var format in AvailableFormats)
                        {
                            <option value="@format" selected="@(_format == format)">@format.ToString().ToUpperInvariant()</option>
                        }
                    </select>
                </div>

                <div class="demo-field demo-field-inline">
                    <input id="grayscale" type="checkbox" checked="@_grayscale" @onchange="e => _grayscale = (bool)(e.Value ?? false)" />
                    <label class="demo-field-label" for="grayscale">Convert to grayscale</label>
                </div>

                <div class="demo-field demo-field-inline">
                    <input id="stopfirst" type="checkbox" checked="@_stopOnFirstError" @onchange="e => _stopOnFirstError = (bool)(e.Value ?? false)" />
                    <label class="demo-field-label" for="stopfirst">Stop on first error</label>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> The batch API</h3>
    <p>
        <code>ProcessBatchAsync</code> is on <code>ImageProcessor</code>, which in a browser comes from
        <code>ImageProcessorFactory.GetAsync()</code> once the codec probe has run; on a server,
        <code>AddBitBmageHeadlessServices</code> registers it directly. Every item comes back with its
        own outcome - <code>Output</code>, <code>Error</code> or <code>WasCancelled</code> - and
        <code>StopOnFirstError</code> is opt-in.
    </p>
    <CodeSnippet Code="@Snippet" Language="C#" Expanded="true" />
    <div class="bb-note">
        <p>
            Size <code>MaxConcurrency</code> against memory, not cores: four workers on 24 megapixel
            photos is roughly 400 MB of live pixels. Two is a safe default on phones.
        </p>
    </div>
</div>

@code {
    private BatchResult? _result;
    private int _maxEdge = 1600;
    private int _concurrency = 2;
    private ImageFormat _format = ImageFormat.WebP;
    private bool _grayscale;
    private bool _stopOnFirstError;
    private bool _running;
    private int _completed;
    private int _total;
    private string? _error;
    private CancellationTokenSource? _cts;
    private ImageCapabilities? _capabilities;

    // Until the probe has run, only the current choice is listed (and the list is disabled).
    private IEnumerable<ImageFormat> AvailableFormats => _capabilities is null
        ? [_format]
        : new[] { ImageFormat.WebP, ImageFormat.Avif, ImageFormat.Jpeg, ImageFormat.Png }.Where(_capabilities.CanEncode);

    private const string Snippet = """
        var processor = await processorFactory.GetAsync();

        var result = await processor.ProcessBatchAsync(items, pipeline, new BatchOptions
        {
            MaxConcurrency   = 2,
            StopOnFirstError = false,        // one bad file must not lose the rest
            ExportOptions    = exportOptions,
            Progress = new Progress<BatchProgress>(p =>
            {
                completed = p.Completed;
                if (p.Last.Error is { } error) Log(p.Last.FileName, error);
            }),
        }, cancellationToken);

        foreach (var item in result.Succeeded) Save(item.Output!);
        foreach (var item in result.Failed)    Report(item.FileName, item.Error!);
        """;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || RendererInfo.IsInteractive is false) return;
        _capabilities = await Capabilities.GetAsync();
        if (!_capabilities.CanEncode(_format)) _format = _capabilities.ChooseEncodableFormat([ImageFormat.WebP, ImageFormat.Jpeg]);
        StateHasChanged();
    }

    private void SetInt(ref int field, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) field = value;
    }

    private void OnFormatChanged(ChangeEventArgs e)
    {
        if (e.Value is string value && Enum.TryParse<ImageFormat>(value, out var format)) _format = format;
    }

    private async Task OnFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0 || _running) return;
        _error = null;
        _result = null;
        _running = true;
        _total = files.Count;
        _completed = 0;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            // Read every file first so the batch measures processing, not disk. A real upload flow would stream
            // them in instead, but the point here is the concurrency and error behaviour.
            var items = new List<BatchItem>(files.Count);
            foreach (var file in files)
            {
                await using var stream = file.OpenReadStream(64 * 1024 * 1024, _cts.Token);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms, _cts.Token);
                items.Add(new BatchItem(ms.ToArray(), file.Name));
            }

            var pipeline = ImagePipeline.Create().AutoOrient().MaxSize(_maxEdge, _maxEdge);
            if (_grayscale) pipeline = pipeline.Grayscale();

            var processor = await Processors.GetAsync(_cts.Token);
            _result = await processor.ProcessBatchAsync(items, pipeline, new BatchOptions
            {
                MaxConcurrency = _concurrency,
                StopOnFirstError = _stopOnFirstError,
                ExportOptions = new ImageExportOptions
                {
                    Format = _format,
                    Quality = 0.82,
                    Metadata = MetadataPolicy.Remove,
                    Background = Rgba32.White,
                },
                Progress = new Progress<BatchProgress>(p =>
                {
                    _completed = p.Completed;
                    InvokeAsync(StateHasChanged);
                }),
            }, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            _error = "The batch was stopped.";
        }
        catch (Exception ex)
        {
            _error = Describe(ex);
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    private void Cancel() => _cts?.Cancel();

    private async Task DownloadAll()
    {
        if (_result is null) return;
        try
        {
            foreach (var item in _result.Succeeded)
            {
                await Exporter.DownloadAsync(item.Output!, System.IO.Path.GetFileNameWithoutExtension(item.FileName ?? "image"));
                // Browsers throttle rapid successive downloads; a short gap keeps them all.
                await Task.Delay(250);
            }
        }
        catch (Exception ex)
        {
            _error = $"Downloading failed: {ex.Message}";
        }
    }

    private static string Describe(Exception ex) => ex switch
    {
        ImageLimitExceededException => "too large",
        ImageDecodeException => "unreadable",
        ImageCapabilityException => "unsupported here",
        _ => ex.Message,
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
