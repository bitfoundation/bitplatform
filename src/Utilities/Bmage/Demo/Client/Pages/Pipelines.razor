    private const string CustomSnippet = """
        // Solarize: the darkroom effect of re-exposing a print, inverting every channel above a threshold.
        public sealed class SolarizeOperation(float threshold = 0.5f) : PointOperation
        {
            public float Threshold { get; } = threshold;

            public override string Name => "Solarize";

            // ProcessRow reads nothing but Threshold, so rows may run on several threads at once.
            public override bool CanProcessRowsConcurrently => true;

            public override void ProcessRow(Span<Vector4> pixels)
            {
                for (var i = 0; i < pixels.Length; i++)
                {
                    var p = pixels[i];
                    pixels[i] = new Vector4(
                        p.X > Threshold ? 1 - p.X : p.X,
                        p.Y > Threshold ? 1 - p.Y : p.Y,
                        p.Z > Threshold ? 1 - p.Z : p.Z,
                        p.W);
                }
            }
        }

        pipeline.Apply(new SolarizeOperation(0.6f));

        // So documents that use it can be saved as JSON and replayed:
        var json = new BmageJsonOptions().Add<SolarizeOperation>("acme.solarize",
            (writer, solarize) => writer.Write("threshold", solarize.Threshold),
            reader => new SolarizeOperation(reader.GetSingle("threshold")));
        """;

    private async Task StartAsync()
    {
        _busy = true;
        StateHasChanged();
        await Task.Yield();
        _source ??= SampleImages.Landscape(SourceSize.Width, SourceSize.Height);
        await RunAsync();
    }

    private void SetGeometry(string option)
    {
        _geometry = option;
        Schedule();
    }

    private void Toggle(string id, ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false)) _enabled.Add(id);
        else _enabled.Remove(id);
        Schedule();
    }

    // The text readouts follow every change at once - they cost nothing - while the pixels wait
    // for the reader to stop clicking.
    private void Schedule()
    {
        if (_source is null) return;
        _debounce.Schedule(async _ => await RunAsync());
    }

    private async Task RunAsync()
    {
        if (_source is not { } source) return;
        var run = ++_run;
        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var started = System.Diagnostics.Stopwatch.StartNew();
            var result = await Pipeline.ExecuteAsync(source);
            started.Stop();
            if (run != _run)
            {
                result.Dispose();
                return;
            }
            _preview?.Dispose();
            _preview = result;
            _previewVersion++;
            _elapsed = started.Elapsed;
        }
        catch (Exception ex) when (run == _run)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            // Superseded: the newer run reports its own outcome.
        }
        finally
        {
            if (run == _run)
            {
                _busy = false;
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        _run++;
        _debounce.Dispose();
        _preview?.Dispose();
        _source?.Dispose();
    }
}
