    private const string AdjustSnippet = """
        pipeline.Brightness(0.1f).Contrast(0.15f).Saturation(-0.2f).Hue(15)
                .Exposure(0.5f).Gamma(1.2f).Temperature(0.2f).Tint(-0.1f)
                .Vibrance(0.3f).ShadowsHighlights(0.2f, -0.15f).Opacity(0.9f)
                .Grayscale().Sepia(0.8f).Invert().Posterize(6).Threshold(0.5f)
                .Blur(4f).Sharpen(0.5f).Pixelate(12).Noise(0.05f)
                .DenoiseMedian(1).Vignette(0.4f)
                .ColorMatrix(myMatrix);

        pipeline.AutoLevels();                    // stretch the tonal range
        pipeline.AutoLevels(perChannel: true);    // also neutralise a colour cast
        pipeline.AutoContrast(targetMean: 0.5f);  // gentler: move the mean luminance towards a target

        // A region confines a filter - this is how redaction works.
        pipeline.Pixelate(14, new Rectangle(40, 120, 300, 40));

        // Movement and texture.
        pipeline.MotionBlur(distance: 24, angle: -15).HighPass(radius: 3);
        pipeline.Apply(ConvolutionFilter.Emboss());
        pipeline.Apply(new ConvolutionFilter([0, -1, 0, -1, 5, -1, 0, -1, 0], 3, 3));   // any kernel
        """;

    private const string ColorSnippet = """
        // White balance: from a pixel that should be neutral, or found automatically.
        var grey = ColorSampler.Sample(image, new Point(120, 80), radius: 3);   // the eyedropper
        pipeline.WhiteBalance(grey);
        pipeline.AutoWhiteBalance(strength: 0.8f);

        // The ends of the tonal range, and the whole curve.
        pipeline.WhitesBlacks(whites: 0.2f, blacks: -0.15f);
        pipeline.Apply(new LevelsAdjustment(inputBlack: 0.05f, inputWhite: 0.95f, gamma: 1.1f));
        pipeline.Apply(CurveOperation.FromFunction(x => x * x * (3 - 2 * x), name: "S-curve"));

        // One colour range at a time: bluer, richer skies; calmer greens.
        pipeline.Hsl(HueBand.Blues, hue: -8, saturation: 0.3f, lightness: -0.2f)
                .Hsl(HueBand.Greens, saturation: -0.25f);

        // Channel mixers, black and white from chosen channels, and tinting.
        pipeline.ChannelMixer(red: new(1.1f, -0.1f, 0), green: new(0, 1, 0), blue: new(0, 0.1f, 0.9f));
        pipeline.BlackAndWhite(red: 0.6f, green: 0.3f, blue: 0.1f);   // a red filter on black and white film
        pipeline.Colorize(hue: 30, saturation: 0.35f);

        // Map luminance onto colours: two of them, or any gradient.
        pipeline.Duotone(shadows: new Rgba32(24, 32, 88), highlights: new Rgba32(250, 214, 140));
        pipeline.Apply(new GradientMapOperation([(0f, Rgba32.Black), (0.5f, new Rgba32(200, 40, 90)), (1f, new Rgba32(255, 230, 120))]));
        """;

