@page "/editor"
@inject DemoFonts Fonts

@* The editor component, whole: the built-in toolbar and panel, a theme forced or left to follow the
   site, a direction, and two example translations. Under it, the document the editor is editing,
   printed live from OnDocumentChanged and OnImageLoaded - the clearest way to show that an edit here
   is a value (a pipeline, layers and annotations) rather than a mutated bitmap. The rest of the page
   is the component's reference. *@

<PageTitle>The editor · Bmage</PageTitle>

<div class="bb-intro">
    <h1>The editor</h1>
    <p class="bb-subtitle">
        Everything in one component: crop, rotate, straighten, resize and trim; adjustments with a
        histogram, a colour mixer and white balance; filters; selections with the magic wand; painting;
        annotations and redaction; layers and groups; before and after; history; export and project
        files. Drop an image on it, or open one from its own drop zone - then try the
        <strong>theme</strong>, <strong>direction</strong> and <strong>language</strong> switches.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Try it</h3>

    <div class="bb-toolbar">
        <div class="demo-toolbar-group" role="group" aria-labelledby="editor-theme-label">
            <span class="demo-toolbar-label" id="editor-theme-label">Theme</span>
            <div class="bb-segmented">
                @foreach (var theme in new[] { "site", "light", "dark" })
                {
                    <button type="button" aria-pressed="@(_theme == theme ? "true" : "false")" @onclick="() => _theme = theme">@theme</button>
                }
            </div>
        </div>
        <div class="demo-toolbar-group" role="group" aria-labelledby="editor-direction-label">
            <span class="demo-toolbar-label" id="editor-direction-label">Direction</span>
            <div class="bb-segmented">
                @foreach (var dir in new[] { "ltr", "rtl" })
                {
                    <button type="button" aria-pressed="@(_direction == dir ? "true" : "false")" @onclick="() => _direction = dir">@dir</button>
                }
            </div>
        </div>
        <div class="demo-toolbar-group" role="group" aria-labelledby="editor-language-label">
            <span class="demo-toolbar-label" id="editor-language-label">Language</span>
            <div class="bb-segmented">
                @foreach (var lang in Languages)
                {
                    <button type="button" lang="@lang.Value.Tag" aria-pressed="@(_language == lang.Key ? "true" : "false")" @onclick="() => SetLanguage(lang.Key)">@lang.Key</button>
                }
            </div>
        </div>
    </div>

    <div class="editor-frame bb-page-wide">
        <BmageEditor @ref="_editor"
                     Class="@ThemeClass"
                     Direction="@_direction"
                     Strings="_strings"
                     ExportOptions="ExportOptions"
                     OnDocumentChanged="OnDocumentChanged"
                     OnImageLoaded="OnImageLoaded" />
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> The document behind the editor</h3>
    <p>
        This is the whole edit: a list of pixel operations, the layers composited over them - paint,
        images, fills and adjustments - and a list of annotation objects. It is a value, so it can be
        stored, sent to a server, replayed on the original file, or applied to a different image
        entirely. It updates as you work.
    </p>
    @if (_document is null)
    {
        <p class="demo-small bb-muted">Load an image into the editor above to see its document here.</p>
    }
    else
    {
        <pre class="demo-readout">@DocumentText</pre>
    }
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Using it</h3>
    <p>
        The simple path stays simple: the editor fills its container, so give it a height, and
        everything else has a working default. The advanced path is the same component with more
        parameters.
    </p>
    <CodeSnippet Code="@Snippet" Expanded="true" />
    <div class="bb-note">
        <p>
            The editor needs the stylesheet <code>_content/Bit.Bmage.Blazor/bit-bmage-editor.css</code>
            linked from <code>App.razor</code> or <code>index.html</code> - see
            <a href="/getting-started">Getting started</a>.
        </p>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Parameters</h3>
    <div class="bb-scroll" tabindex="0" role="region" aria-label="Editor parameters">
        <table class="bb-table">
            <thead>
                <tr><th scope="col">Parameter</th><th scope="col">Purpose</th></tr>
            </thead>
            <tbody>
                <tr><th scope="row"><code>Image</code></th><td>The image to edit. Setting it replaces the session and its history. The editor works on a copy, so your buffer stays yours.</td></tr>
                <tr><th scope="row"><code>Strings</code></th><td>Every user-visible label - see <a href="/editor#localisation">Localisation</a>.</td></tr>
                <tr><th scope="row"><code>Direction</code></th><td><code>"ltr"</code> or <code>"rtl"</code>. The layout uses logical CSS properties, so it mirrors correctly.</td></tr>
                <tr><th scope="row"><code>Class</code>, <code>Style</code></th><td>Applied to the root element. <code>bmg-theme-dark</code> or <code>bmg-theme-light</code> force a theme.</td></tr>
                <tr><th scope="row"><code>AriaLabel</code></th><td>The accessible name of the editor region, for a page with more than one.</td></tr>
                <tr><th scope="row"><code>AcceptedFileTypes</code></th><td>The file types its own drop zone and file picker offer. Default <code>image/*</code>.</td></tr>
                <tr><th scope="row"><code>TextRasterizer</code></th><td>What text and step numbers are drawn with. Null uses the <code>FontTextRasterizer</code> from the services, which draws once a font is registered with it - this site registers Noto Sans and Vazirmatn.</td></tr>
                <tr><th scope="row"><code>ShowToolbar</code>, <code>ShowPanel</code></th><td>Hide the built-in chrome without replacing it.</td></tr>
                <tr><th scope="row"><code>Toolbar</code>, <code>Panel</code>, <code>Footer</code></th><td>Replace the chrome entirely; each receives a <code>BmageEditorContext</code>.</td></tr>
                <tr><th scope="row"><code>EmptyState</code></th><td>Replace the "drop an image here" view.</td></tr>
                <tr><th scope="row"><code>MaxProxyDimension</code></th><td>Longest edge used for interactive editing. Falls back to <code>BitBmageOptions.MaxInteractiveDimension</code>, then 2048. <code>0</code> always edits at full resolution.</td></tr>
                <tr><th scope="row"><code>MaxHistoryDepth</code></th><td>Undo steps kept. Default 100.</td></tr>
                <tr><th scope="row"><code>ExportOptions</code></th><td>Settings used by the built-in save action: the Export tab starts from its format, quality and metadata policy, and keeps the rest.</td></tr>
                <tr><th scope="row"><code>OnDocumentChanged</code>, <code>OnExported</code>, <code>OnImageLoaded</code>, <code>OnError</code></th><td>Callbacks. <code>OnImageLoaded</code> matters more than it looks: the editor can load an image through its own drop zone while your <code>Image</code> is still null, so a page whose buttons depend on an image should re-render from it.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Driving it from code</h3>
    <p>
        Everything the built-in toolbar can do is a public method, and the same surface is handed to
        custom chrome through <code>BmageEditorContext</code> - so a toolbar you write can do
        everything the built-in one does.
    </p>
    <CodeSnippet Code="@CodeSnippetText" Language="Razor" Expanded="true" />
    <p>
        For an adjustment driven by your own slider, pass <code>transient: true</code> while dragging
        and commit once when the interaction ends, so the history gets one entry rather than hundreds.
    </p>
    <CodeSnippet Code="@TransientSnippet" Language="C#" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Replacing the chrome</h3>
    <p>
        <code>Toolbar</code>, <code>Panel</code> and <code>Footer</code> take a render fragment with a
        <code>BmageEditorContext</code>: the current tool and settings, the document, the annotations and
        layers, the selection, the history and its position, the detected capabilities, the output size,
        and every action - tool selection, crop, rotate, flip, straighten, resize, canvas size, trim,
        adjustments, white balance, annotations, layers and groups, selections, compare, undo, redo,
        reset, zoom, load, paste, export, download, clipboard copy and projects.
    </p>
    <CodeSnippet Code="@ToolbarSnippet" Expanded="true" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Theming</h3>
    <p>
        Every colour and metric is a CSS custom property on <code>.bmg-editor</code>. Override the
        ones you care about - this site does exactly that to make the editor follow the theme switch
        in the header rather than the operating system (the <strong>site</strong> theme above), while
        <strong>light</strong> and <strong>dark</strong> show the component's own palettes.
    </p>
    <CodeSnippet Code="@ThemeSnippet" Language="CSS" Expanded="true" />
    <p>
        Dark mode follows <code>prefers-color-scheme</code> unless forced with
        <code>bmg-theme-light</code> or <code>bmg-theme-dark</code>. High contrast mode and
        <code>prefers-reduced-motion</code> are honoured.
    </p>
</div>

<div class="bb-card" id="localisation">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Localisation</h3>
    <p>
        <code>BmageEditorStrings</code> is a record with a property for every label, so a translation
        is an object rather than a resource file - and you can override only the words you care
        about. Number and size formatting are functions on the same record, and so are the names of
        annotation and layer kinds, blend modes and anchors. For a right-to-left language set
        <code>Direction="rtl"</code>: the panel, the crop handles and the toolbar all mirror. The
        Persian button above switches both at once; both translations set every label.
    </p>
    <p>
        Text and step numbers are drawn into the image from font files, the same way on a server as
        here: this site registers Noto Sans and Vazirmatn, and a letter one lacks comes from the
        other. A Persian or Arabic label is shaped with the font's own OpenType rules - joined
        letters, lam-alef, harakat in place - and laid out right to left by the Unicode
        Bidirectional Algorithm, Latin words and numbers inside it included. Try the Text tool with
        the Persian button on.
    </p>
    <CodeSnippet Code="@LocalisationSnippet" Language="C#" Expanded="true" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> The panel and the toolbar</h3>
    <p>
        The built-in panel is seven tabs, each a plain form over the same public methods - copy the calls
        you need into a panel of your own.
    </p>
    <div class="bb-scroll" tabindex="0" role="region" aria-label="Editor panel tabs">
        <table class="bb-table">
            <thead>
                <tr><th scope="col">Tab</th><th scope="col">What it holds</th></tr>
            </thead>
            <tbody>
                <tr><th scope="row">Adjust</th><td>A live histogram with how much of the image is clipped to black or white; auto levels, automatic white balance and a white balance picker - click something that should be grey; brightness, contrast, saturation, exposure, temperature, vibrance, shadows, highlights, whites, blacks, tint, hue, sharpen, blur and vignette; and a colour mixer that shifts the hue, saturation and lightness of one of eight colour bands.</td></tr>
                <tr><th scope="row">Filters</th><td>Looks - grayscale, sepia, invert, posterize, threshold, black and white, duotone - and a motion blur with a distance and an angle.</td></tr>
                <tr><th scope="row">Transform</th><td>Straighten up to 45&deg; with the corners cropped away; resize to exact numbers, proportions kept or not; canvas size with an anchor and a colour or transparency; and trim to the content.</td></tr>
                <tr><th scope="row">Tools</th><td>Stroke and fill colours, dashes, width, opacity and font size for the drawing tools; brush size and hardness; the tolerance of the fill, magic eraser and magic wand; the redaction style - and, for the selected annotation, its text, size, rotation, opacity, order and lock.</td></tr>
                <tr><th scope="row">Layers</th><td>Add a paint layer or an image as a layer; every layer with show, hide, lock, reorder, duplicate and delete; the selected one's opacity, blend mode and clipping to the layer below; group it with the layer below, move it out of its group, ungroup, and blend a group as one. Annotations are listed under the layers.</td></tr>
                <tr><th scope="row">History</th><td>Every step by name; click one to go back to it, or forward again.</td></tr>
                <tr><th scope="row">Export</th><td>The output size (and the original's, while editing through a proxy); format, quality and metadata policy; download and copy to the clipboard; save the edit as a project, and open one.</td></tr>
            </tbody>
        </table>
    </div>
    <p>
        The toolbar holds the tools below, rotate and flip, undo, redo and reset, <strong>Compare with the
        original</strong> - which shows the original until it is turned off - and zoom. While pixels are
        selected it adds the selection's actions: make them transparent, fill them, copy them to a layer,
        crop to them, invert, and deselect.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Tools and keyboard</h3>
    <div class="bb-scroll" tabindex="0" role="region" aria-label="Editor tools">
        <table class="bb-table">
            <thead>
                <tr><th scope="col">Tool</th><th scope="col">Behaviour</th></tr>
            </thead>
            <tbody>
                <tr><th scope="row">Select</th><td>Click to select an annotation, drag to move it, arrow keys to nudge, Delete to remove.</td></tr>
                <tr><th scope="row">Pan</th><td>Drag to move the view.</td></tr>
                <tr><th scope="row">Crop</th><td>Drag a rectangle, adjust it with eight handles, apply from the toolbar.</td></tr>
                <tr><th scope="row">Draw</th><td>Freehand, smoothed so fast strokes do not look polygonal.</td></tr>
                <tr><th scope="row">Line, Arrow</th><td>Drag from start to end; hold Shift to snap to 15&deg; increments.</td></tr>
                <tr><th scope="row">Rectangle, Ellipse</th><td>Drag to size; hold Shift for a square or a circle.</td></tr>
                <tr><th scope="row">Highlight</th><td>A translucent block, like a marker pen.</td></tr>
                <tr><th scope="row">Redact</th><td>Solid, pixelate or blur; replaces the pixels underneath.</td></tr>
                <tr><th scope="row">Text</th><td>Places a label you then edit from the Tools tab.</td></tr>
                <tr><th scope="row">Step</th><td>Auto-numbered markers for tutorials and bug reports.</td></tr>
                <tr><th scope="row">Brush</th><td>Paints onto the selected paint layer, or the topmost one, or a new one when there is none - with a round brush, soft or hard, narrowing with pen pressure.</td></tr>
                <tr><th scope="row">Eraser</th><td>Removes paint from the paint layer and never touches the image below.</td></tr>
                <tr><th scope="row">Pick a colour</th><td>The eyedropper: picks the colour under the pointer as the stroke and fill colour - or, started from the Adjust tab's picker, as the grey a white balance should make neutral.</td></tr>
                <tr><th scope="row">Fill</th><td>Fills the region of similar colour under the pointer, as a new layer you can still change.</td></tr>
                <tr><th scope="row">Magic eraser</th><td>Makes the region of similar colour under the pointer transparent.</td></tr>
                <tr><th scope="row">Rectangle select, Ellipse select, Lasso</th><td>Select pixels by shape or by drawing around them, outlined with marching ants. Hold Shift to add to the selection, Alt to take away from it.</td></tr>
                <tr><th scope="row">Magic wand</th><td>Selects the region of similar colour under the pointer, within the tolerance; Shift and Alt add and subtract here too.</td></tr>
            </tbody>
        </table>
    </div>
    <div class="bb-scroll" tabindex="0" role="region" aria-label="Editor keyboard shortcuts">
        <table class="bb-table">
            <thead>
                <tr><th scope="col">Keys</th><th scope="col">Action</th></tr>
            </thead>
            <tbody>
                <tr><th scope="row"><kbd>Ctrl</kbd> / <kbd>&#8984;</kbd> + <kbd>Z</kbd></th><td>Undo</td></tr>
                <tr><th scope="row"><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>Z</kbd>, <kbd>Ctrl</kbd> + <kbd>Y</kbd></th><td>Redo</td></tr>
                <tr><th scope="row"><kbd>Delete</kbd>, <kbd>Backspace</kbd></th><td>Delete the selected annotation, or make the selected pixels transparent</td></tr>
                <tr><th scope="row">Arrow keys</th><td>Nudge the selected annotation by 1px, or 10px with Shift</td></tr>
                <tr><th scope="row"><kbd>Ctrl</kbd> + <kbd>A</kbd></th><td>Select all the pixels</td></tr>
                <tr><th scope="row"><kbd>Ctrl</kbd> + <kbd>D</kbd></th><td>Deselect</td></tr>
                <tr><th scope="row"><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>I</kbd></th><td>Invert the selection</td></tr>
                <tr><th scope="row"><kbd>Esc</kbd></th><td>Clear the annotation and pixel selections, or cancel a pending crop</td></tr>
                <tr><th scope="row"><kbd>\</kbd></th><td>Compare with the original, and back</td></tr>
                <tr><th scope="row"><kbd>[</kbd>, <kbd>]</kbd></th><td>Make the brush or eraser smaller or larger</td></tr>
                <tr><th scope="row"><kbd>+</kbd>, <kbd>-</kbd></th><td>Zoom</td></tr>
                <tr><th scope="row"><kbd>Ctrl</kbd> + <kbd>0</kbd></th><td>Fit to window</td></tr>
            </tbody>
        </table>
    </div>
    <p>
        The canvas is a focusable <code>application</code> region with a described keyboard hint. The
        toolbar is a <code>toolbar</code> of labelled buttons carrying <code>aria-pressed</code>, the
        panel is a <code>tablist</code> with arrow-key navigation, crop handles are focusable buttons
        with 24px hit targets, and status messages use live regions. On touch screens the canvas
        claims the drag (so drawing does not scroll the page) and the panel moves below the canvas.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Large images</h3>
    <p>
        By default the editor edits through a proxy no larger than 2048px on its longest edge and
        replays the edit at full resolution on export - for a 24 megapixel photo, a 25&times; cut in
        the pixels each preview touches. Because every operation rescales itself, the preview and the
        export are one edit at two resolutions rather than two code paths that could disagree.
        <code>ImageEditSession.UsesProxy</code> and <code>ProxyScale</code> say when it is happening;
        set <code>MaxProxyDimension="0"</code> to always edit at full resolution, or
        <code>MaxInteractiveDimension</code> on <code>BitBmageOptions</code> to change the default for
        every editor in the app.
    </p>
    <p>
        History stores descriptions, not pixels: a hundred undo steps on a 6000 &times; 4000 image
        stay under a megabyte.
    </p>
</div>

@code {
    private BmageEditor? _editor;
    private ImageDocument? _document;
    private string _theme = "site";
    private string _direction = "ltr";
    private string _language = "English";
    private BmageEditorStrings _strings = BmageEditorStrings.Default;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || RendererInfo.IsInteractive is false) return;
        try
        {
            await Fonts.EnsureAsync();
        }
        catch (Exception)
        {
            // Without the font the editor says why its text cannot be drawn, which is the honest outcome.
            return;
        }
        // Text placed before the font arrived is drawn now.
        if (_editor?.Session is not null) await _editor.RefreshAsync();
    }

    private static readonly ImageExportOptions ExportOptions = new()
    {
        Format = ImageFormat.Png,
        Metadata = MetadataPolicy.StripSensitive,
    };

    // "site" leaves the class off, which is what lets wwwroot/demo.css point the editor at the
    // site's own tokens; the other two force the component's built-in palettes.
    private string ThemeClass => _theme switch
    {
        "light" => "bmg-theme-light",
        "dark" => "bmg-theme-dark",
        _ => string.Empty,
    };

    /// <summary>
    /// Two example translations, every label set (see Shared/EditorTranslations.cs). Every label is a property on a
    /// record, so a translation is an object, not a resource file, and a host can override just the few words it cares about.
    /// </summary>
    private static readonly Dictionary<string, (string Tag, BmageEditorStrings Strings)> Languages = new()
    {
        ["English"] = ("en", BmageEditorStrings.Default),
        ["Deutsch"] = ("de", EditorTranslations.German),
        ["فارسی"] = ("fa", EditorTranslations.Persian),
    };

    private const string Snippet = """
        @* The simple path stays simple. *@
        <div style="height: 70vh">
            <BmageEditor @ref="editor" />
        </div>
        <button @onclick='() => editor.DownloadAsync("edited")'>Save</button>

        @* And the advanced path is the same component. *@
        <BmageEditor Strings="german" Class="bmg-theme-dark"
                     MaxProxyDimension="3000"
                     OnDocumentChanged="doc => Persist(doc)">
            <Toolbar Context="editor">
                <button @onclick="() => editor.SetTool(EditorToolKind.Crop)">Crop</button>
                <button disabled="@(!editor.CanUndo)" @onclick="editor.Undo">Undo</button>
            </Toolbar>
        </BmageEditor>
        """;

    private const string CodeSnippetText = """
        @code {
            private BmageEditor? _editor;

            void Crop16x9()
            {
                _editor!.SetTool(EditorToolKind.Crop);
                _editor.SetCropAspect(AspectRatio.Ratio16x9);
            }

            async Task Save() => await _editor!.DownloadAsync("edited",
                new ImageExportOptions { Format = ImageFormat.WebP, Quality = 0.9 });

            async Task AddCallout() => await _editor!.AddAnnotationAsync(new ArrowAnnotation
            {
                Start = new Vector2(100, 400),
                End   = new Vector2(300, 200),
                Style = ShapeStyle.Default with { Stroke = new StrokeStyle { Width = 6 } },
            });

            // Transforms: each one undoable, with annotations and layers kept on what they mark.
            async Task Level() => await _editor!.SetStraightenAsync(-2.5);
            async Task Shrink() => await _editor!.ResizeAsync(1600, 1200);
            async Task Frame() => await _editor!.SetCanvasSizeAsync(2000, 2000, Anchor.Center, Rgba32.White);
            async Task Trim() => await _editor!.TrimAsync();

            // Selections: select, then act on the pixels inside.
            void SelectSky()
            {
                _editor!.SetSelection(Mask.Gradient(new(0, 0), new(0, 0.4f)));
                _editor.InvertSelection();                       // ...or everything else
            }
            async Task CutOut() => await _editor!.ClearSelectionAsync();          // make transparent
            async Task Lift() => await _editor!.CopySelectionToLayerAsync();       // a new image layer
            async Task CropToIt() => await _editor!.CropToSelectionAsync();

            // Layers, before and after, and projects.
            async Task Paint() { await _editor!.AddPaintLayerAsync(); _editor.SetTool(EditorToolKind.Brush); }
            async Task Compare() => await _editor!.SetCompareAsync(!_editor.IsComparing);
            async Task Keep() => await _editor!.SaveProjectAsync("holiday");      // a .bmage file
            async Task Reopen(IBrowserFile file) => await _editor!.OpenProjectAsync(file);
        }
        """;

    private const string TransientSnippet = """
        async Task OnBrightnessInput(double value)
            => await context.SetAdjustmentAsync(new BrightnessAdjustment((float)value), "Brightness", transient: true);

        async Task OnBrightnessCommit()
            => await context.SetAdjustmentAsync(context.FindAdjustment<BrightnessAdjustment>(), "Brightness");
        """;

    private const string ToolbarSnippet = """
        <BmageEditor ExportOptions="_options">
            <Toolbar Context="editor">
                <div class="my-toolbar">
                    <button class="@(editor.Tool == EditorToolKind.Crop ? "on" : null)"
                            @onclick="() => editor.SetTool(EditorToolKind.Crop)">
                        Crop
                    </button>
                    <button disabled="@(!editor.CanUndo)" @onclick="editor.Undo">Undo</button>
                    <button disabled="@(!editor.CanRedo)" @onclick="editor.Redo">Redo</button>
                    <span>@editor.OutputSize.Width × @editor.OutputSize.Height</span>
                    <button @onclick='() => editor.DownloadAsync("image")'>Save</button>
                </div>
            </Toolbar>
        </BmageEditor>
        """;

    private const string ThemeSnippet = """
        .my-editor {
            --bmg-accent: #7c3aed;
            --bmg-accent-text: #ffffff;
            --bmg-bg: #0f0f12;
            --bmg-bg-subtle: #17171c;
            --bmg-canvas-bg: #202027;
            --bmg-border: #2a2a33;
            --bmg-text: #eeeef2;
            --bmg-radius: 4px;
            --bmg-panel-width: 320px;
        }

        /* <BmageEditor Class="my-editor" /> */
        """;

    private const string LocalisationSnippet = """
        var german = BmageEditorStrings.Default with
        {
            Crop = "Zuschneiden",
            Undo = "Rückgängig",
            Redo = "Wiederholen",
            Download = "Herunterladen",
            DropImageHere = "Bild hier ablegen oder klicken zum Auswählen",
        };

        // Formatting is replaceable too, because it is a function on the same record.
        var strings = BmageEditorStrings.Default with
        {
            FormatFileSize = bytes => $"{bytes / 1024.0:0.#} Ko",
            FormatDimensions = (w, h) => $"{w}×{h} px",
        };

        // <BmageEditor Strings="german" Direction="ltr" />
        """;

    private string DocumentText
    {
        get
        {
            if (_document is null) return string.Empty;
            var lines = new List<string>
            {
                $"Source      {_document.SourceSize.Width} × {_document.SourceSize.Height}",
                $"Output      {_document.OutputSize.Width} × {_document.OutputSize.Height}",
                "",
                $"Pipeline ({_document.Pipeline.Count})",
            };
            if (_document.Pipeline.Count == 0) lines.Add("  (none)");
            foreach (var operation in _document.Pipeline) lines.Add($"  {operation}");
            lines.Add("");
            lines.Add($"Layers ({_document.Layers.Count}, bottom first)");
            if (_document.Layers.Count == 0) lines.Add("  (none)");
            AddLayers(lines, _document.Layers, "  ");
            lines.Add("");
            lines.Add($"Annotations ({_document.Annotations.Count})");
            if (_document.Annotations.Count == 0) lines.Add("  (none)");
            foreach (var annotation in _document.Annotations)
            {
                var b = annotation.GetBounds();
                lines.Add($"  {annotation.Kind,-10} at ({b.X:0},{b.Y:0}) {b.Width:0}×{b.Height:0}");
            }
            return string.Join('\n', lines);
        }
    }

    /// <summary>One line a layer, a group's own layers indented under it.</summary>
    private static void AddLayers(List<string> lines, IReadOnlyList<Layer> layers, string indent)
    {
        foreach (var layer in layers)
        {
            var details = new List<string>();
            if (layer.Name is { } name) details.Add(name);
            if (layer.BlendMode != BlendMode.SourceOver) details.Add(layer.BlendMode.ToString());
            if (layer.Opacity < 1) details.Add($"{layer.Opacity * 100:0}%");
            if (!layer.IsVisible) details.Add("hidden");
            lines.Add($"{indent}{layer.Kind,-10} {string.Join(" · ", details)}".TrimEnd());
            if (layer is GroupLayer group) AddLayers(lines, group.Layers, indent + "  ");
        }
    }

    private void SetLanguage(string language)
    {
        _language = language;
        _strings = Languages[language].Strings;
        // Persian reads right to left, so switching the language switches the layout too, and back again.
        _direction = language == "فارسی" ? "rtl" : "ltr";
    }

    private void OnDocumentChanged(ImageDocument document)
    {
        _document = document;
        StateHasChanged();
    }

    // A new image is a new, empty document, but not an edit, so OnDocumentChanged waits for the first change: without
    // this the readout would go on showing the previous image's edit.
    private void OnImageLoaded(ImageBuffer image)
    {
        _document = _editor?.Document;
        StateHasChanged();
    }
}
