<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.5.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Bmage.Bink\Bit.Bmage.Bink.csproj" />
        <ProjectReference Include="..\..\Bit.Bmage.BbScanner\Bit.Bmage.BbScanner.csproj" />
        <!-- Real symbols rendered in memory, and the blur, lighting and scaling a camera adds to them. -->
        <ProjectReference Include="..\..\..\BbScanner\Tests\Bit.BbScanner.TestKit\Bit.BbScanner.TestKit.csproj" />
    </ItemGroup>

</Project>
