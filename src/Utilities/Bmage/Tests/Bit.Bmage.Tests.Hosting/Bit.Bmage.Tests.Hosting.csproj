<Project Sdk="Microsoft.NET.Sdk">

    <!-- In-process HTTP tests: the hosting samples booted as they ship - their own Program.cs and
         App.razor - with WebApplicationFactory, asserting what only a server response can show: what
         the prerendered page already contains, how a miss and an error are answered, and which of
         Bmage's static assets each host serves. No browser, so this runs in the regular CI job; the
         same samples are driven in a real browser by Bit.Bmage.Tests.E2E. -->
    <PropertyGroup>
        <!-- The samples only target net10.0. -->
        <TargetFramework>net10.0</TargetFramework>
        <!-- A ProjectReference to a Web SDK project leaves OutputType at Library, and the MSTest
             runner needs an entry point of its own. -->
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.5.1" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Samples\Server\Bit.Bmage.Samples.Server.csproj" />
        <ProjectReference Include="..\..\Samples\Wasm\Bit.Bmage.Samples.Wasm\Bit.Bmage.Samples.Wasm.csproj" />
        <ProjectReference Include="..\..\Samples\Auto\Bit.Bmage.Samples.Auto\Bit.Bmage.Samples.Auto.csproj" />
    </ItemGroup>

</Project>
