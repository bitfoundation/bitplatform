@namespace Bit.Bmage
@using Bit.Bmage

@*
    The default toolbar. Purely a composition of the context's actions, so replacing it wholesale costs nothing:
    every button here is one call a host can make itself.
*@

<div class="bmg-toolbar" role="toolbar" aria-label="@Context.Strings.ToolbarLabel" aria-orientation="horizontal">

    <div class="bmg-toolgroup" role="group" aria-label="@Context.Strings.Tools">
        @foreach (var (kind, label, icon) in OfferedTools)
        {
            <button type="button"
                    class="bmg-tool @(Context.Tool == kind ? "bmg-tool-active" : null)"
                    title="@label"
                    aria-label="@label"
                    aria-pressed="@(Context.Tool == kind ? "true" : "false")"
                    disabled="@(!Context.HasImage)"
                    @onclick="() => Context.SetTool(kind)">
                @((MarkupString)icon)
            </button>
        }
    </div>

    <div class="bmg-toolgroup" role="group" aria-label="@Context.Strings.Transform">
        <button type="button" class="bmg-tool" title="@Context.Strings.RotateLeft" aria-label="@Context.Strings.RotateLeft"
                disabled="@(!Context.HasImage || Context.IsBusy)" @onclick="() => Context.RotateAsync(-90)">
            @((MarkupString)BmageIcons.RotateLeft)
        </button>
        <button type="button" class="bmg-tool" title="@Context.Strings.RotateRight" aria-label="@Context.Strings.RotateRight"
                disabled="@(!Context.HasImage || Context.IsBusy)" @onclick="() => Context.RotateAsync(90)">
            @((MarkupString)BmageIcons.RotateRight)
        </button>
        <button type="button" class="bmg-tool" title="@Context.Strings.FlipHorizontal" aria-label="@Context.Strings.FlipHorizontal"
                disabled="@(!Context.HasImage || Context.IsBusy)" @onclick="() => Context.FlipAsync(true)">
            @((MarkupString)BmageIcons.FlipHorizontal)
        </button>
        <button type="button" class="bmg-tool" title="@Context.Strings.FlipVertical" aria-label="@Context.Strings.FlipVertical"
                disabled="@(!Context.HasImage || Context.IsBusy)" @onclick="() => Context.FlipAsync(false)">
            @((MarkupString)BmageIcons.FlipVertical)
        </button>
    </div>

    <div class="bmg-toolgroup" role="group" aria-label="@Context.Strings.History">
        <button type="button" class="bmg-tool" title="@Context.Strings.Undo" aria-label="@Context.Strings.Undo"
                disabled="@(!Context.CanUndo || Context.IsBusy)" @onclick="Context.Undo">
            @((MarkupString)BmageIcons.Undo)
        </button>
        <button type="button" class="bmg-tool" title="@Context.Strings.Redo" aria-label="@Context.Strings.Redo"
                disabled="@(!Context.CanRedo || Context.IsBusy)" @onclick="Context.Redo">
            @((MarkupString)BmageIcons.Redo)
        </button>
        <button type="button" class="bmg-tool" title="@Context.Strings.Reset" aria-label="@Context.Strings.Reset"
                disabled="@(!Context.HasImage || Context.IsBusy)" @onclick="Context.Reset">
            @((MarkupString)BmageIcons.Reset)
        </button>
    </div>

    <div class="bmg-toolbar-spacer"></div>

    <div class="bmg-toolgroup" role="group" aria-label="@Context.Strings.Compare">
        <button type="button" class="bmg-tool @(Context.IsComparing ? "bmg-tool-active" : null)"
                title="@($"{Context.Strings.Compare} (\\)")" aria-label="@Context.Strings.Compare"
                aria-pressed="@(Context.IsComparing ? "true" : "false")"
                disabled="@(!Context.HasImage)" @onclick="() => Context.SetCompareAsync(!Context.IsComparing)">
            @((MarkupString)BmageIcons.Compare)
        </button>
    </div>

    <div class="bmg-toolgroup" role="group" aria-label="@Context.Strings.ZoomToFit">
        <button type="button" class="bmg-tool" title="@Context.Strings.ZoomOut" aria-label="@Context.Strings.ZoomOut"
                disabled="@(!Context.HasImage)" @onclick="() => Context.SetZoom(Context.Zoom / 1.25)">−</button>
        @* Named for the zoom it shows first and what pressing it does after, so the name a speech user hears and says
           contains the readout on screen (WCAG 2.5.3, label in name). *@
        <button type="button" class="bmg-tool bmg-zoom-value" title="@Context.Strings.ZoomToFit"
                aria-label="@($"{Context.Strings.FormatPercent(Context.Zoom)}, {Context.Strings.ZoomToFit}")"
                disabled="@(!Context.HasImage)" @onclick="Context.FitToWindow">
            @Context.Strings.FormatPercent(Context.Zoom)
        </button>
        <button type="button" class="bmg-tool" title="@Context.Strings.ZoomIn" aria-label="@Context.Strings.ZoomIn"
                disabled="@(!Context.HasImage)" @onclick="() => Context.SetZoom(Context.Zoom * 1.25)">+</button>
    </div>

    @if (Context.HasSelection)
    {
        <div class="bmg-toolgroup" role="group" aria-label="@Context.Strings.Selection">
            <button type="button" class="bmg-button" disabled="@Context.IsBusy" @onclick="Context.ClearSelectionAsync">@Context.Strings.ClearSelection</button>
            <button type="button" class="bmg-button" disabled="@Context.IsBusy" @onclick="Context.FillSelectionAsync">@Context.Strings.FillSelection</button>
            <button type="button" class="bmg-button" disabled="@Context.IsBusy" @onclick="Context.CopySelectionToLayerAsync">@Context.Strings.CopyToLayer</button>
            <button type="button" class="bmg-button" disabled="@Context.IsBusy" @onclick="Context.CropToSelectionAsync">@Context.Strings.CropToSelection</button>
            <button type="button" class="bmg-button" disabled="@Context.IsBusy" @onclick="Context.InvertSelection">@Context.Strings.InvertSelection</button>
            <button type="button" class="bmg-button" @onclick="Context.Deselect">@Context.Strings.Deselect</button>
        </div>
    }

    @if (Context.Tool == BmageEditorToolKind.Crop)
    {
        <div class="bmg-toolgroup" role="group" aria-label="@Context.Strings.Crop">
            <button type="button" class="bmg-button bmg-button-primary" disabled="@Context.IsBusy" @onclick="Context.ApplyCropAsync">
                @Context.Strings.ApplyCrop
            </button>
            <button type="button" class="bmg-button" @onclick="Context.CancelCrop">@Context.Strings.CancelCrop</button>
        </div>
    }

    @if (ShowExport)
    {
        <button type="button" class="bmg-button bmg-button-primary" disabled="@(!Context.HasImage || Context.IsBusy)"
                @onclick="() => Context.DownloadAsync(DownloadFileName)">
            @Context.Strings.Download
        </button>
    }
</div>

@code {
    /// <summary>The editor context supplying state and actions.</summary>
    [Parameter, EditorRequired] public BmageEditorContext Context { get; set; } = default!;

    /// <summary>Show the download button.</summary>
    [Parameter] public bool ShowExport { get; set; } = true;

    /// <summary>File name used by the download button.</summary>
    [Parameter] public string DownloadFileName { get; set; } = "image";

    /// <summary>The editor's tools in the order its <see cref="BmageEditor.Tools"/> lists them; every tool in the default order when that is null.</summary>
    private IEnumerable<(BmageEditorToolKind Kind, string Label, string Icon)> OfferedTools
    {
        get
        {
            var all = Tools;
            return Context.OfferedTools.SelectMany(kind => all.Where(t => t.Kind == kind));
        }
    }

    private (BmageEditorToolKind Kind, string Label, string Icon)[] Tools =>
    [
        (BmageEditorToolKind.Select, Context.Strings.Select, BmageIcons.Select),
        (BmageEditorToolKind.Pan, Context.Strings.Pan, BmageIcons.Pan),
        (BmageEditorToolKind.Crop, Context.Strings.Crop, BmageIcons.Crop),
        (BmageEditorToolKind.Draw, Context.Strings.Draw, BmageIcons.Pen),
        (BmageEditorToolKind.Arrow, Context.Strings.Arrow, BmageIcons.Arrow),
        (BmageEditorToolKind.Line, Context.Strings.Line, BmageIcons.Line),
        (BmageEditorToolKind.Rectangle, Context.Strings.Rectangle, BmageIcons.Rectangle),
        (BmageEditorToolKind.Ellipse, Context.Strings.Ellipse, BmageIcons.Ellipse),
        (BmageEditorToolKind.Text, Context.Strings.Text, BmageIcons.Text),
        (BmageEditorToolKind.Step, Context.Strings.Step, BmageIcons.Step),
        (BmageEditorToolKind.Highlight, Context.Strings.Highlight, BmageIcons.Highlight),
        (BmageEditorToolKind.Redact, Context.Strings.Redact, BmageIcons.Redact),
        (BmageEditorToolKind.Brush, Context.Strings.Brush, BmageIcons.Brush),
        (BmageEditorToolKind.Eraser, Context.Strings.Eraser, BmageIcons.Eraser),
        (BmageEditorToolKind.Fill, Context.Strings.Fill, BmageIcons.Fill),
        (BmageEditorToolKind.MagicEraser, Context.Strings.MagicEraser, BmageIcons.MagicEraser),
        (BmageEditorToolKind.Eyedropper, Context.Strings.Eyedropper, BmageIcons.Eyedropper),
        (BmageEditorToolKind.SelectRectangle, Context.Strings.SelectRectangle, BmageIcons.SelectRectangle),
        (BmageEditorToolKind.SelectEllipse, Context.Strings.SelectEllipse, BmageIcons.SelectEllipse),
        (BmageEditorToolKind.Lasso, Context.Strings.Lasso, BmageIcons.Lasso),
        (BmageEditorToolKind.MagicWand, Context.Strings.MagicWand, BmageIcons.MagicWand),
    ];
}
