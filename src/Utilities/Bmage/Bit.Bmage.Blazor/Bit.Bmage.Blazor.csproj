<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.Bmage</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <!-- The [JSImport] source generator emits unsafe code. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Description>bit Bmage for Blazor: browser-side image processing on the user's device from strongly typed C#, on top of the Bit.Bmage engine. Browser-native WebP and AVIF codecs, capability detection, IBrowserFile/clipboard/camera input, loading and export and dependency injection wiring, with codec work in Web Workers. Works in WebAssembly, Server, Auto and Hybrid render modes. Includes BmageEditor, a themeable, accessible, touch-friendly image editor component: crop, rotate, adjust, filter, draw, annotate, redact, undo/redo and export.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>Bit;Bmage;Blazor;image;editor;canvas;crop;resize;webp;avif;annotation;wasm</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <!-- Floating low-bound version ranges so consumers can pin to any patch release on their TFM;
             the upper bound keeps a major-version package that targets a newer TFM out. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[11.0.0-rc.1.26425.128,12.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Bmage\Bit.Bmage.csproj" />
    </ItemGroup>

    <!-- This assembly reads Bit.Bmage's internals (through its InternalsVisibleTo), which carry no compatibility promise
         from one release to the next. NuGet turns a ProjectReference into a floating ">=" dependency, so a later
         Bit.Bmage would restore cleanly and then fail at run time with a MissingMethodException or TypeLoadException.
         Pinning the dependency to this exact version makes a mismatch fail at restore instead. -->
    <Target Name="PinBmageDependencyToExactVersion" AfterTargets="_GetProjectReferenceVersions">
        <ItemGroup>
            <_BmageExactVersionReference Include="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
            <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
            <_ProjectReferencesWithVersions Include="@(_BmageExactVersionReference)" />
        </ItemGroup>
    </Target>

    <!-- The tests only ever build against the repo's AssemblyOriginatorKeyFile.snk, so they are granted access under that
         key alone. -->
    <ItemGroup>
        <InternalsVisibleTo Include="Bit.Bmage.Tests" PublicKey="" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="tsconfig.json" />
        <None Include="tsconfig.json" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="Scripts\**\*.ts" />
    </ItemGroup>

    <!-- Restores npm packages then compiles the TypeScript bundle. Both sub-targets are incremental
         via their Inputs/Outputs, so this is a no-op when nothing changed. -->
    <Target Name="BuildBmageJavaScript" DependsOnTargets="InstallNodejsDependencies;BuildJavaScript" />

    <!-- The bundle (wwwroot/bit-bmage.js) is a generated, git-ignored file. On a clean build it does not
         exist when the default "wwwroot/**" Content glob is evaluated, so static web asset discovery would
         miss it and consumers would get a 404 for _content/Bit.Bmage.Blazor/bit-bmage.js. Hooking
         BeforeTargets="ResolveProjectStaticWebAssets" generates it first and then adds it to @(Content)
         explicitly; the Remove-before-Include keeps it to a single Content entry when the glob already
         captured it. -->
    <Target Name="IncludeBmageJavaScriptAsStaticWebAsset"
            BeforeTargets="ResolveProjectStaticWebAssets"
            DependsOnTargets="BuildBmageJavaScriptOnce">
        <ItemGroup>
            <Content Remove="wwwroot\bit-bmage.js;wwwroot\bit-bmage-worker.js" />
            <Content Include="wwwroot\bit-bmage.js;wwwroot\bit-bmage-worker.js" />
        </ItemGroup>
    </Target>

    <!-- Runs BuildBmageJavaScript through the MSBuild task with TargetFramework removed, so every per-TFM
         build asks for the same project configuration: MSBuild keeps one result per project and global
         properties, so the first request runs npm/tsc/esbuild and concurrent ones wait for it. A
         ProjectReference (Bit.Bmage.Tests references this project once per target framework, in parallel)
         builds the inner builds directly without the outer build, so calling BuildBmageJavaScript from each
         of them raced on node_modules and wwwroot/bit-bmage.js - the "EBUSY" Brouter ran into. -->
    <Target Name="BuildBmageJavaScriptOnce">
        <MSBuild Projects="$(MSBuildProjectFullPath)"
                 Targets="BuildBmageJavaScript"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
    </Target>

    <!-- In a multi-targeted build, produce the bundle exactly once in the outer (cross-targeting) build,
         before the per-TFM inner builds are dispatched, so several inner builds never run tsc/esbuild
         concurrently against the same shared wwwroot output file. -->
    <Target Name="BuildBmageJavaScriptOnCrossTargeting"
            BeforeTargets="DispatchToInnerBuilds"
            Condition="'$(IsCrossTargetingBuild)' == 'true'"
            DependsOnTargets="BuildBmageJavaScript" />

    <!-- `npm ci` against the checked-in package-lock.json keeps the installed tree reproducible and fails
         fast when package.json and the lockfile drift. -->
    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm ci" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <Target Name="BuildJavaScript"
            Inputs="@(TypeScriptFiles);tsconfig.json;package-lock.json"
            Outputs="wwwroot/bit-bmage.js;wwwroot/bit-bmage-worker.js;$(BaseIntermediateOutputPath)bit-bmage.$(Configuration).stamp">
        <Exec Command="node_modules/.bin/tsc" StandardOutputImportance="high" StandardErrorImportance="high" />
        <!-- Minify to a temp file and move it into place, so an interrupted minify never leaves a half-written
             bundle that the Outputs check above would then treat as up-to-date. format=esm keeps the named
             exports the interop's dynamic import() resolves. The codec worker is a classic script, which
             esbuild keeps as one when no format is given. -->
        <Exec Condition=" '$(Configuration)' == 'Release' " Command="node_modules/.bin/esbuild wwwroot/bit-bmage.js --minify --format=esm --outfile=wwwroot/bit-bmage.min.js" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Move Condition=" '$(Configuration)' == 'Release' " SourceFiles="wwwroot/bit-bmage.min.js" DestinationFiles="wwwroot/bit-bmage.js" OverwriteReadOnlyFiles="true" />
        <Exec Condition=" '$(Configuration)' == 'Release' " Command="node_modules/.bin/esbuild wwwroot/bit-bmage-worker.js --minify --outfile=wwwroot/bit-bmage-worker.min.js" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Move Condition=" '$(Configuration)' == 'Release' " SourceFiles="wwwroot/bit-bmage-worker.min.js" DestinationFiles="wwwroot/bit-bmage-worker.js" OverwriteReadOnlyFiles="true" />

        <!-- Configuration-aware incremental marker: only Release minifies, so switching between Debug and
             Release must invalidate this target instead of shipping the other configuration's bundle. -->
        <ItemGroup>
            <_BmageBuildStamp Include="$(BaseIntermediateOutputPath)bit-bmage.*.stamp" />
        </ItemGroup>
        <Delete Files="@(_BmageBuildStamp)" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)" />
        <Touch Files="$(BaseIntermediateOutputPath)bit-bmage.$(Configuration).stamp" AlwaysCreate="true" />
    </Target>

</Project>
