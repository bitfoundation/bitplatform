<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <UseMonoRuntime>false</UseMonoRuntime>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The host owns the launch profile: this project is never started on its own. -->
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <!-- Publishes this project's static web assets at the app root (not under _content/), the
         way a Blazor Web App's client project is expected to contribute them. -->
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Every stage of the decoder is a C# pixel loop, and on Blazor's IL interpreter a 640x480 frame took 90 to 150 ms
       in Chromium on a desktop where the same frame compiled ahead of time took under 2 ms (the README's performance
       section has the measurements). The deployed site is therefore compiled ahead of time - but only on a Release
       publish, the one place AOT applies anyway: it needs the wasm-tools workload and adds minutes to the build.
       The CD workflow publishes the Server project, whose nested publish of this project carries
       WasmBuildingForNestedPublish=true, as Bmage's demo does. Pass -p:RunAOTCompilation=false to publish without it. -->
  <PropertyGroup Condition="'$(RunAOTCompilation)' == '' and '$(Configuration)' == 'Release' and ('$(_IsPublishing)' == 'true' or '$(WasmBuildingForNestedPublish)' == 'true')">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Bit.Minifier" Version="10.7.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bit.BbScanner\Bit.BbScanner.csproj" />
    <!-- The sample barcodes are drawn with the test kit's encoders: the library only reads symbols,
         and the demo generates its own rather than shipping images, so a sample can never drift
         from what the decoder expects. -->
    <ProjectReference Include="..\..\Tests\Bit.BbScanner.TestKit\Bit.BbScanner.TestKit.csproj" />
  </ItemGroup>

</Project>
