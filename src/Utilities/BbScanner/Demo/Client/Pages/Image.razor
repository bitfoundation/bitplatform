@page "/image"

<PageTitle>Image scanning · BbScanner</PageTitle>

<div class="bb-intro">
    <h1>Image and file scanning</h1>
    <p class="bb-subtitle">
        The same decoder reads a still image. Nothing about the pipeline changes; only the tuning
        does, because a one-shot decode can afford to be exhaustive.
    </p>
</div>

<div class="bb-demo bb-page-wide">
    <div class="bb-demo-bar">
        <span class="bb-demo-label">Live</span>
        <span class="bb-soft">No camera needed</span>
    </div>

    <div class="scan-sample">
        <div class="scan-layout">
            <div class="scan-view">
                <BbScanner @ref="_scanner"
                           AutoStart="false"
                           ShowStatusBar="true"
                           Formats="BbBarcodeFormat.All"
                           EnableFileScanning="true"
                           MaxSymbolsPerFrame="@(_everySymbol ? 16 : 1)"
                           OnScan="HandleScan"
                           OnError="e => _error = e" />

                @if (_error is not null)
                {
                    <div class="bb-note bb-note-warn"><strong>@_error.Kind</strong> — @_error.Message</div>
                }
            </div>

            <div class="scan-panels">
                <section class="scan-panel">
                    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Pick an image</h3>
                    <p class="bb-card-desc">
                        The component ships a hidden file input and the plumbing to read it. Opening it
                        from your own button is a single call.
                    </p>
                    <div class="bb-toolbar">
                        <button class="btn btn-primary" type="button" @onclick="OpenPicker">Choose an image</button>
                        <button class="btn btn-secondary" type="button" @onclick="DecodeGeneratedImage">Decode a generated image</button>
                        <button class="btn btn-secondary" type="button" @onclick="() => _results.Clear()" disabled="@(_results.Count == 0)">Clear</button>
                    </div>
                    <p class="bb-card-desc">
                        The second button skips the picker entirely: it renders a symbol into a pixel
                        buffer and hands it to <code>DecodeImage</code>, which is the path an application
                        uses when it sources images itself. An image file dragged onto the scanner is
                        scanned too.
                    </p>
                    <label class="bb-check">
                        <input type="checkbox" id="every-symbol" @bind="_everySymbol" />
                        Read every symbol in the image (<code>MaxSymbolsPerFrame="16"</code>)
                    </label>
                </section>

                <section class="scan-panel">
                    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Blazor's InputFile</h3>
                    <p class="bb-card-desc">
                        An image the application already holds - from <code>InputFile</code>, an upload, a
                        download - goes to <code>ScanImageAsync</code>, which decodes it in the browser like a
                        picked file and returns every symbol in it. No camera, so no permission prompt.
                    </p>
                    <InputFile id="scan-image-input" accept="image/*" OnChange="ScanUploadAsync" />
                </section>
            </div>
        </div>

        <ResultLog Results="_results" OnClear="() => _results.Clear()" />
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Why still images differ</h3>
    <p class="bb-card-desc">
        A camera gets another chance in fifty milliseconds, so a live frame should give up
        early. A file gets one chance, so
        <code>BbScannerOptions.ForStillImages()</code> raises the scan line count, enables the
        exhaustive detector path and allows inverted symbols.
    </p>
    <pre class="bb-code"><span class="k">var</span> options = BbScannerOptions.ForStillImages();
options.Formats = BbBarcodeFormat.QrCode;

<span class="k">using var</span> decoder = <span class="k">new</span> BbBarcodeDecoder(options);
<span class="k">var</span> result = decoder.Decode(pixels, width, height, BbPixelFormat.Rgba32);</pre>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Large photographs</h3>
    <p class="bb-card-desc">
        A twelve megapixel photo carries no more barcode detail than a two megapixel one,
        so the component asks the browser to scale anything larger than 1600 pixels on its
        longest edge before it crosses into managed code. That alone is the difference
        between a snappy decode and a visible pause on a phone.
    </p>
</div>

@code {
    /// <summary>
    /// Decodes a buffer the page owns, through <see cref="BbScanner.DecodeImage"/>. No
    /// camera and no file picker are involved.
    /// </summary>
    private void DecodeGeneratedImage()
    {
        _error = null;

        var sample = SampleCatalog.All.First(s => s.Format == BbBarcodeFormat.QrCode);
        using var image = Bit.BbScanner.TestKit.SyntheticImage.FromMatrix(sample.Matrix!, scale: 6);

        // Expand to the packed RGBA an application would normally get from a canvas.
        var rgba = new byte[image.Width * image.Height * 4];
        for (var i = 0; i < image.Width * image.Height; i++)
        {
            rgba[(i * 4) + 0] = image.Pixels[i];
            rgba[(i * 4) + 1] = image.Pixels[i];
            rgba[(i * 4) + 2] = image.Pixels[i];
            rgba[(i * 4) + 3] = 255;
        }

        var result = _scanner?.DecodeImage(
            rgba, image.Width, image.Height, BbPixelFormat.Rgba32);

        if (result is not null)
        {
            _results.Insert(0, result);
        }
        else
        {
            _error = new BbScannerException(BbScannerErrorKind.Unknown, "The generated image did not decode.");
        }
    }

    /// <summary>
    /// Scans a file chosen through Blazor's own <see cref="InputFile"/>, through
    /// <see cref="BbScanner.ScanImageAsync(Stream, int, CancellationToken)"/>.
    /// </summary>
    private async Task ScanUploadAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        if (_scanner is null)
        {
            return;
        }

        try
        {
            await using var stream = args.File.OpenReadStream(_scanner.MaxImageFileSize);
            var results = await _scanner.ScanImageAsync(stream);
            if (results.Count == 0)
            {
                _error = new BbScannerException(BbScannerErrorKind.Unknown, $"No barcode found in {args.File.Name}.");
            }

            _results.InsertRange(0, results);
        }
        catch (BbScannerException ex)
        {
            _error = ex;
        }
        catch (IOException ex)
        {
            // InputFile's own size limit, which is the scanner's.
            _error = new BbScannerException(BbScannerErrorKind.InvalidImage, ex.Message, ex);
        }
    }

    private readonly List<BbBarcodeResult> _results = [];
    private BbScanner? _scanner;
    private BbScannerException? _error;
    private bool _everySymbol;

    private Task OpenPicker() => _scanner is null ? Task.CompletedTask : _scanner.OpenFilePickerAsync();

    private void HandleScan(BbBarcodeResult result)
    {
        _error = null;
        _results.Insert(0, result);
        StateHasChanged();
    }
}
