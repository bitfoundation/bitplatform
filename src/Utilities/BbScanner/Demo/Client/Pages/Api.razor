Task            StopAsync()
<span class="k">void</span>            Pause()
<span class="k">void</span>            Resume()
Task            SwitchCameraAsync(<span class="k">string</span> deviceId)
Task&lt;<span class="k">bool</span>&gt;      SetTorchAsync(<span class="k">bool</span> on)
Task&lt;<span class="k">bool</span>&gt;      SetZoomAsync(<span class="k">double</span> zoom)
Task            OpenFilePickerAsync()
Task&lt;IReadOnlyList&lt;BbCameraDevice&gt;&gt; GetCamerasAsync()
Task&lt;BbCameraPermission&gt;             GetCameraPermissionAsync()
<span class="k">void</span>            ResetDuplicateFilter()
BbBarcodeResult?  DecodeImage(ReadOnlySpan&lt;<span class="k">byte</span>&gt; pixels, <span class="k">int</span> width, <span class="k">int</span> height, BbPixelFormat format)
IReadOnlyList&lt;BbBarcodeResult&gt;        DecodeAllInImage(ReadOnlySpan&lt;<span class="k">byte</span>&gt; pixels, <span class="k">int</span> width, <span class="k">int</span> height, BbPixelFormat format, <span class="k">int</span> maxSymbols = 16)
Task&lt;IReadOnlyList&lt;BbBarcodeResult&gt;&gt;  ScanImageAsync(Stream image, <span class="k">int</span> maxSymbols = 16, CancellationToken cancellationToken = <span class="k">default</span>)
Task&lt;IReadOnlyList&lt;BbBarcodeResult&gt;&gt;  ScanImageAsync(ReadOnlyMemory&lt;<span class="k">byte</span>&gt; image, <span class="k">string</span>? contentType = <span class="k">null</span>, <span class="k">int</span> maxSymbols = 16, CancellationToken cancellationToken = <span class="k">default</span>)
Task&lt;IReadOnlyList&lt;BbBarcodeResult&gt;&gt;  ScanCurrentFrameAsync(<span class="k">int</span> maxSymbols = 16)

BbScannerStatus   Status
BbCameraInfo?     Camera
IReadOnlyList&lt;BbCameraDevice&gt; Cameras
BbScanDiagnostics Diagnostics
<span class="k">long</span>            FramesDecoded
<span class="k">long</span>            FramesWithSymbol
<span class="k">bool</span>            IsTorchOn
<span class="k">double</span>          Zoom
(<span class="k">int</span>, <span class="k">int</span>)      ProcessingSize</pre>
    <p class="bb-card-desc">
        <code>StartAsync</code> is safe to call at any time: a call that arrives while an earlier one
        is still waiting for the permission prompt supersedes it, and the superseded request releases
        its camera rather than leaving it running. The same holds for <code>StopAsync</code> and for
        disposal, so navigating away mid-prompt never leaves the camera indicator lit.
    </p>
</div>

<h2>The results and the options</h2>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> BbBarcodeResult</h3>
