@page "/errors"

<PageTitle>Errors and permissions · BbScanner</PageTitle>

<div class="bb-intro">
    <h1>Errors and permissions</h1>
    <p class="bb-subtitle">
        Camera failures are ordinary and expected: permission denied, no camera, camera already in
        use. The component classifies each one so an application can respond without parsing message
        text.
    </p>
</div>

<div class="bb-demo bb-page-wide">
    <div class="bb-demo-bar">
        <span class="bb-demo-label">Live</span>
        <StatusBadge Status="_status" />
    </div>

    <div class="scan-sample">
        <div class="scan-layout">
            <div class="scan-view">
                <BbScanner @ref="_scanner"
                           AutoStart="false"
                           DeviceId="@_deviceId"
                           RequestedWidth="_width"
                           RequestedHeight="_height"
                           OnError="HandleError"
                           OnStatusChanged="HandleStatus" />
            </div>

            <div class="scan-panels">
                <section class="scan-panel">
                    <h3 class="bb-card-title"><span class="bb-dot bb-dot-danger"></span> Provoke a failure</h3>
                    <div class="bb-toolbar">
                        <button class="btn btn-secondary" type="button" @onclick="StartNormally">Start normally</button>
                        <button class="btn btn-secondary" type="button" @onclick="StartWithBadDevice">Unknown camera id</button>
                    </div>
                    <p class="bb-card-desc">
                        An unknown <code>DeviceId</code> is requested as an exact constraint, so browsers
                        reject it with <code>OverconstrainedError</code>, which the component reports as
                        <code>ConstraintsUnsatisfied</code>.
                    </p>
                    <p class="bb-card-desc">
                        <code>RequestedWidth</code> and <code>RequestedHeight</code> are sent as
                        <em>ideal</em> constraints, so an unreachable resolution is negotiated down rather
                        than refused; resolution alone never produces an error.
                    </p>
                    <p class="bb-card-desc">
                        To see a permission denial, block camera access for this site in the browser and
                        press <em>Start normally</em>.
                    </p>
                    <div class="bb-toolbar">
                        <button class="btn btn-secondary" type="button" id="check-permission" @onclick="CheckPermission">Check camera permission</button>
                        @if (_permission is { } permission)
                        {
                            <output id="camera-permission">@permission</output>
                        }
                    </div>
                    <p class="bb-card-desc">
                        <code>GetCameraPermissionAsync</code> asks the browser what a start would do -
                        <code>Prompt</code>, <code>Granted</code> or <code>Denied</code> - without asking the
                        user, so a page can explain the prompt before it appears.
                    </p>
                </section>

                <section class="scan-panel">
                    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Current state</h3>
                    @if (_error is not null)
                    {
                        <div class="bb-note bb-note-warn">
                            <p><strong>@_error.Kind</strong></p>
                            <p>@_error.Message</p>
                        </div>
                        <p class="bb-card-desc">Suggested handling: @Advice(_error.Kind)</p>
                    }
                    else
                    {
                        <div class="bb-empty">No error.</div>
                    }
                </section>
            </div>
        </div>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Error kinds</h3>
    <p class="bb-card-desc">
        Every failure reaches <code>OnError</code> as a <code>BbScannerException</code> whose
        <code>Kind</code> is one of these.
    </p>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Kind</th><th>Meaning</th></tr>
            </thead>
            <tbody>
                <tr><td class="bb-table-key">PermissionDenied</td><td>The user or a policy refused the camera.</td></tr>
                <tr><td class="bb-table-key">NoCamera</td><td>No device matched the request.</td></tr>
                <tr><td class="bb-table-key">CameraUnavailable</td><td>A device exists but is held by something else.</td></tr>
                <tr><td class="bb-table-key">ConstraintsUnsatisfied</td><td>No camera can meet the requested constraints.</td></tr>
                <tr><td class="bb-table-key">NotSupported</td><td>No camera API, or the page is not a secure context.</td></tr>
                <tr><td class="bb-table-key">Unknown</td><td>Anything the browser did not classify.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Secure context</h3>
    <p class="bb-card-desc">
        Browsers only expose <code>getUserMedia</code> over HTTPS or on
        <code>localhost</code>. Served any other way the component reports
        <code>NotSupported</code> immediately, with a message that says exactly that,
        instead of hanging on a permission prompt that will never appear.
    </p>
</div>

@code {
    private BbScanner? _scanner;
    private BbScannerException? _error;
    private BbScannerStatus _status = BbScannerStatus.Idle;
    private BbCameraPermission? _permission;

    private async Task CheckPermission()
    {
        if (_scanner is not null)
        {
            _permission = await _scanner.GetCameraPermissionAsync();
        }
    }
    private string? _deviceId;
    private int _width = 1280;
    private int _height = 720;

    private async Task StartNormally()
    {
        _deviceId = null;
        _width = 1280;
        _height = 720;
        _error = null;
        StateHasChanged();
        await Task.Yield();
        await (_scanner?.StartAsync() ?? Task.CompletedTask);
    }

    private async Task StartWithBadDevice()
    {
        _deviceId = "this-device-does-not-exist";
        _error = null;
        StateHasChanged();
        await Task.Yield();
        await (_scanner?.StartAsync() ?? Task.CompletedTask);
    }

    private void HandleError(BbScannerException error)
    {
        _error = error;
        StateHasChanged();
    }

    private void HandleStatus(BbScannerStatus status)
    {
        _status = status;
        StateHasChanged();
    }

    private static string Advice(BbScannerErrorKind kind) => kind switch
    {
        BbScannerErrorKind.PermissionDenied =>
            "explain why the camera is needed and offer a retry, since the browser will not re-prompt on its own.",
        BbScannerErrorKind.NoCamera => "fall back to image scanning or manual entry.",
        BbScannerErrorKind.CameraUnavailable => "ask the user to close other applications using the camera, then retry.",
        BbScannerErrorKind.ConstraintsUnsatisfied =>
            "drop the DeviceId and start again with Facing, since the requested camera is gone.",
        BbScannerErrorKind.NotSupported => "serve over HTTPS, or hide the scanner entirely on this browser.",
        _ => "log the inner exception and offer a retry.",
    };
}
