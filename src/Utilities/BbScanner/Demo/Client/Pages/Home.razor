@code {
    private sealed record HeroHit(BbBarcodeFormat Format, string Text, double Milliseconds);

    /// <summary>The site's own address as a QR code - the first sample of the samples page.</summary>
    private static BarcodeSample Symbol => SampleCatalog.All[0];

    private HeroHit? _hero;
    private bool _heroMissed;

    /// <summary>
    /// Rasterises the symbol into a grayscale frame and decodes it with the library, exactly as a
    /// camera frame is decoded - only without the camera.
    /// </summary>
    private void DecodeHero()
    {
        using var image = SyntheticImage.FromMatrix(Symbol.Matrix!, scale: 6);
        using var decoder = new BbBarcodeDecoder(new BbScannerOptions
        {
            Formats = BbBarcodeFormat.All,
            DuplicateSuppressionWindow = TimeSpan.Zero,
        });

        var start = Stopwatch.GetTimestamp();
        var result = decoder.Decode(image.View, suppressDuplicates: false);
        var elapsed = Stopwatch.GetElapsedTime(start).TotalMilliseconds;

        _hero = result is null ? null : new HeroHit(result.Format, result.Text, elapsed);
        _heroMissed = result is null;
    }
}
