@page "/samples"

<PageTitle>Sample barcodes · BbScanner</PageTitle>

<div class="bb-intro">
    <h1>Sample barcodes</h1>
    <p class="bb-subtitle">
        One scannable example of every supported symbology, generated in the browser and drawn as
        SVG. Point a phone at the screen, or open this page on a second device and scan it with the
        <a href="scan">playground</a>.
    </p>
</div>

<div class="bb-note">
    These are rendered by encoders that live in the test project, not in the library. The library
    itself only reads barcodes; the encoders exist so that the decoders can be validated by round
    trip and so that this page has something real to show.
</div>

@* The linear symbols are drawn at two pixels a module, up to 720 wide: the page gives up the
   "on this page" rail for the width. *@
<div class="bb-card bb-page-wide">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Two dimensional</h3>
    <div class="sample-grid">
        @foreach (var sample in SampleCatalog.All.Where(s => (s.Format & BbBarcodeFormat.AllMatrix) != 0))
        {
            <BarcodeSvg Matrix="sample.Matrix" Format="sample.Format" Caption="@sample.Caption" Value="@sample.Value" Size="200" />
        }
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Linear</h3>
    <div class="sample-grid sample-grid-linear">
        @foreach (var sample in SampleCatalog.All.Where(s => (s.Format & BbBarcodeFormat.AllLinear) != 0))
        {
            @* Two CSS pixels per module, so the bars survive rasterisation on a 1x display and a
               phone camera can read them off the screen. *@
            <BarcodeSvg Modules="sample.Modules"
                        Caption="@sample.Caption"
                        Value="@sample.Value"
                        Size="@Math.Clamp((sample.Modules!.Length + 24) * 2, 300, 720)"
                        LinearHeight="26"
                        QuietZone="12" />
        }
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Decode them right here</h3>
    <p class="bb-card-desc">
        The same symbols, decoded in place without a camera: each one is rasterised into a grayscale
        buffer and pushed through <code>BbBarcodeDecoder</code>, exactly as a camera frame would be.
    </p>

    <div class="bb-toolbar">
        <button class="btn btn-primary" type="button" @onclick="RunSelfTest" disabled="@_running">
            @if (_running)
            {
                <span class="bb-spinner"></span>
            }
            @(_running ? "Decoding..." : "Decode every sample")
        </button>
        @if (_selfTest.Count > 0 && !_running)
        {
            <span class="bb-muted">
                @_selfTest.Count(r => r.Ok) of @_selfTest.Count samples decoded in
                @_selfTest.Sum(r => r.Milliseconds).ToString("0.0") ms total.
            </span>
        }
    </div>

    @if (_selfTest.Count > 0)
    {
        <div class="bb-scroll">
            <table class="bb-table">
                <thead>
                    <tr><th>Sample</th><th>Expected</th><th>Decoded</th><th>Time</th><th>Result</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _selfTest)
                    {
                        <tr>
                            <td class="bb-table-key">@row.Caption</td>
                            <td class="bb-mono">@row.Expected</td>
                            <td class="bb-mono">@(row.Actual ?? "-")</td>
                            <td class="bb-mono bb-nowrap">@row.Milliseconds.ToString("0.00") ms</td>
                            <td>
                                @if (row.Ok)
                                {
                                    <span class="bb-badge bb-badge-success">match</span>
                                }
                                else
                                {
                                    <span class="bb-badge bb-badge-danger">miss</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private sealed record SelfTestRow(string Caption, string Expected, string? Actual, double Milliseconds, bool Ok);

    private readonly List<SelfTestRow> _selfTest = [];
    private bool _running;

    private async Task RunSelfTest()
    {
        _running = true;
        _selfTest.Clear();
        StateHasChanged();
        await Task.Yield();

        foreach (var sample in SampleCatalog.All)
        {
            using var image = sample.Matrix is not null
                ? SampleCatalog.RenderMatrix(sample, scale: 6)
                : Bit.BbScanner.TestKit.SyntheticImage.FromLinear(sample.Modules!, scale: 3, height: 90);

            var start = System.Diagnostics.Stopwatch.GetTimestamp();

            using var decoder = new BbBarcodeDecoder(new BbScannerOptions
            {
                Formats = BbBarcodeFormat.All,
                DuplicateSuppressionWindow = TimeSpan.Zero,
                MaxScanLines = 30,
            });

            var text = decoder.Decode(image.View, suppressDuplicates: false)?.Text;

            var elapsed = System.Diagnostics.Stopwatch.GetElapsedTime(start).TotalMilliseconds;

            _selfTest.Add(new SelfTestRow(sample.Caption, sample.Value, text, elapsed, text == sample.Value));
        }

        _running = false;
        StateHasChanged();
    }
}
