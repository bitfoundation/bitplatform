@page "/camera"

<PageTitle>Camera control · BbScanner</PageTitle>

<div class="bb-intro">
    <h1>Camera, torch and zoom</h1>
    <p class="bb-subtitle">
        Camera selection, torch and zoom are all capabilities of the running media track. The
        component reports what the browser says is available and never offers a control the hardware
        will refuse.
    </p>
</div>

<div class="bb-demo bb-page-wide">
    <div class="bb-demo-bar">
        <span class="bb-demo-label">Live</span>
        <StatusBadge Status="_scanner?.Status" />
    </div>

    <div class="scan-sample">
        <div class="scan-layout">
            <div class="scan-view">
                <BbScanner @ref="_scanner"
                           Facing="_facing"
                           ShowControls="true"
                           OnScan="r => _last = r"
                           OnCameraChanged="OnCameraChanged"
                           OnStatusChanged="OnStatusChanged"
                           OnError="e => _error = e" />

                @if (_error is not null)
                {
                    <div class="bb-note bb-note-warn"><strong>@_error.Kind</strong> — @_error.Message</div>
                }

                @if (_last is not null)
                {
                    <dl class="bb-params">
                        <dt>Last scan</dt>
                        <dd><span class="bb-badge">@_last.Format</span> @_last.Text</dd>
                    </dl>
                }
            </div>

            <div class="scan-panels">
                <section class="scan-panel">
                    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Available cameras</h3>
                    <div class="bb-toolbar">
                        <button class="btn btn-secondary" type="button" @onclick="RefreshCameras">Enumerate</button>
                    </div>

                    @if (_cameras.Count == 0)
                    {
                        <div class="bb-empty">
                            None listed yet. Browsers withhold the list, and camera labels, until permission
                            has been granted at least once.
                        </div>
                    }
                    else
                    {
                        <div class="bb-scroll">
                            <table class="bb-table">
                                <tbody>
                                    @foreach (var camera in _cameras)
                                    {
                                        <tr>
                                            <td>@camera.Label</td>
                                            <td class="bb-table-action">
                                                <button class="btn btn-secondary" type="button" @onclick="() => Switch(camera.DeviceId)">Use</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <label class="bb-field">
                        <span>Preferred facing for the next start</span>
                        <select id="facing" value="@_facing" @onchange="OnFacingChanged">
                            <option value="@BbCameraFacing.Rear">Rear</option>
                            <option value="@BbCameraFacing.Front">Front</option>
                            <option value="@BbCameraFacing.Any">Any</option>
                        </select>
                    </label>
                </section>

                <section class="scan-panel">
                    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Negotiated track</h3>
                    @if (_camera is null)
                    {
                        <div class="bb-empty">No camera open.</div>
                    }
                    else
                    {
                        <dl class="bb-params">
                            <dt>Label</dt>
                            <dd>@_camera.Label</dd>
                            <dt>Resolution</dt>
                            <dd>@_camera.Width × @_camera.Height</dd>
                            <dt>Frame rate</dt>
                            <dd>@_camera.FrameRate.ToString("0.#") fps</dd>
                            <dt>Facing</dt>
                            <dd>@(_camera.FacingMode.Length == 0 ? "unreported" : _camera.FacingMode)</dd>
                            <dt>Torch</dt>
                            <dd>
                                @if (_camera.SupportsTorch)
                                {
                                    <span class="bb-badge bb-badge-success">supported</span>
                                }
                                else
                                {
                                    <span class="bb-soft">not supported</span>
                                }
                            </dd>
                            <dt>Zoom</dt>
                            <dd>
                                @if (_camera.SupportsZoom)
                                {
                                    <span class="bb-badge bb-badge-success">@_camera.ZoomMin.ToString("0.#") to @_camera.ZoomMax.ToString("0.#")</span>
                                }
                                else
                                {
                                    <span class="bb-soft">not supported</span>
                                }
                            </dd>
                        </dl>
                    }
                </section>

                <section class="scan-panel">
                    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Controls</h3>
                    <div class="bb-toolbar">
                        <button class="btn btn-secondary" type="button" disabled="@(_camera?.SupportsTorch != true)" @onclick="ToggleTorch">
                            @(_scanner?.IsTorchOn == true ? "Torch off" : "Torch on")
                        </button>
                    </div>

                    @if (_camera?.SupportsZoom == true)
                    {
                        <label class="bb-field">
                            <span class="scan-field-head"><span>Zoom</span><output>@(_scanner?.Zoom.ToString("0.##"))</output></span>
                            <input type="range"
                                   min="@Invariant(_camera.ZoomMin)"
                                   max="@Invariant(_camera.ZoomMax)"
                                   step="@Invariant(_camera.ZoomStep > 0 ? _camera.ZoomStep : 0.1)"
                                   value="@Invariant(_scanner?.Zoom ?? 0)"
                                   @onchange="OnZoomChanged" />
                        </label>
                    }

                    <p class="bb-card-desc">
                        Torch and zoom are almost always rear-camera-only, and support varies by browser.
                        Both calls report whether the browser accepted them rather than throwing.
                    </p>
                </section>
            </div>
        </div>
    </div>
</div>

@code {
    private BbScanner? _scanner;
    private IReadOnlyList<BbCameraDevice> _cameras = [];
    private BbCameraInfo? _camera;
    private BbBarcodeResult? _last;
    private BbScannerException? _error;
    private BbCameraFacing _facing = BbCameraFacing.Rear;

    private async Task RefreshCameras()
    {
        if (_scanner is not null)
        {
            _cameras = await _scanner.GetCamerasAsync();
        }
    }

    private async Task Switch(string deviceId)
    {
        if (_scanner is not null)
        {
            await _scanner.SwitchCameraAsync(deviceId);
        }
    }

    private async Task ToggleTorch()
    {
        if (_scanner is not null)
        {
            await _scanner.SetTorchAsync(!_scanner.IsTorchOn);
        }
    }

    private async Task OnZoomChanged(ChangeEventArgs args)
    {
        if (_scanner is not null &&
            double.TryParse(args.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var zoom))
        {
            await _scanner.SetZoomAsync(zoom);
        }
    }

    // Numeric attributes must not pick up a culture specific decimal separator.
    private static string Invariant(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private void OnFacingChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<BbCameraFacing>(args.Value?.ToString(), out var facing))
        {
            _facing = facing;
        }
    }

    private async Task OnCameraChanged(BbCameraInfo camera)
    {
        _camera = camera;
        _error = null;
        await RefreshCameras();
        StateHasChanged();
    }

    private void OnStatusChanged(BbScannerStatus status)
    {
        // The card describes a running track, so it has to empty when the track goes away.
        if (status is BbScannerStatus.Stopped or BbScannerStatus.Faulted or BbScannerStatus.Idle)
        {
            _camera = null;
        }

        StateHasChanged();
    }
}
