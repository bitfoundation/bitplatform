@page "/lifecycle"

<PageTitle>Lifecycle · BbScanner</PageTitle>

<div class="bb-intro">
    <h1>Lifecycle and duplicate prevention</h1>
    <p class="bb-subtitle">
        Start, stop, pause and resume are explicit and cheap. Pausing keeps the camera open, so
        resuming is instant; stopping releases the track and turns the camera indicator off.
    </p>
</div>

<div class="bb-demo bb-page-wide">
    <div class="bb-demo-bar">
        <span class="bb-demo-label">Live</span>
        <StatusBadge Status="_scanner?.Status" />
    </div>

    <div class="scan-sample">
        <div class="scan-layout">
            <div class="scan-view">
                <BbScanner @ref="_scanner"
                           AutoStart="false"
                           ShowControls="false"
                           DuplicateSuppressionWindow="TimeSpan.FromSeconds(_windowSeconds)"
                           OnScan="HandleScan"
                           OnStatusChanged="HandleStatus" />

                <div class="bb-toolbar">
                    <button class="btn btn-primary" type="button" @onclick="Start">Start</button>
                    <button class="btn btn-secondary" type="button" @onclick="Stop">Stop</button>
                    <button class="btn btn-secondary" type="button" @onclick="Pause">Pause</button>
                    <button class="btn btn-secondary" type="button" @onclick="Resume">Resume</button>
                </div>
            </div>

            <div class="scan-panels">
                <section class="scan-panel">
                    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Duplicate suppression</h3>
                    <label class="bb-field">
                        <span class="scan-field-head"><span>Window</span><output>@_windowSeconds s</output></span>
                        <input type="range" min="0" max="10" step="1" value="@_windowSeconds" @onchange="OnWindowChanged" />
                    </label>
                    <p class="bb-card-desc">
                        Suppression is keyed on the value and the symbology together, so moving the camera
                        to a different barcode reports immediately instead of waiting out the window.
                        Holding the same one in view keeps it suppressed rather than re-firing on a timer.
                    </p>
                    <p class="bb-card-desc">
                        Set it to zero and the scanner reports every frame that decodes, which is the
                        right setting for measuring throughput.
                    </p>
                </section>

                <section class="scan-panel">
                    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Scan counters</h3>
                    <div class="bb-stats">
                        <div class="bb-stat">
                            <span class="bb-stat-label">Reported</span>
                            <span class="bb-stat-value">@_reported</span>
                        </div>
                        <div class="bb-stat">
                            <span class="bb-stat-label">Distinct values</span>
                            <span class="bb-stat-value">@_distinct.Count</span>
                        </div>
                        <div class="bb-stat">
                            <span class="bb-stat-label">Status changes</span>
                            <span class="bb-stat-value">@_statusChanges</span>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <ResultLog Results="_results" OnClear="Clear" />
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Disposal</h3>
    <p class="bb-card-desc">
        The component implements <code>IAsyncDisposable</code>. Navigating away cancels the
        frame loop, stops every media track, releases the JavaScript session and returns
        the pooled buffers. Nothing keeps the camera alive after the component is gone.
    </p>
</div>

@code {
    private readonly List<BbBarcodeResult> _results = [];
    private readonly HashSet<string> _distinct = [];

    private BbScanner? _scanner;
    private int _windowSeconds = 2;
    private int _reported;
    private int _statusChanges;

    private Task Start() => _scanner?.StartAsync() ?? Task.CompletedTask;

    private Task Stop() => _scanner?.StopAsync() ?? Task.CompletedTask;

    private void Pause() => _scanner?.Pause();

    private void Resume() => _scanner?.Resume();

    private void OnWindowChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var seconds))
        {
            _windowSeconds = seconds;
        }
    }

    private void HandleScan(BbBarcodeResult result)
    {
        _reported++;
        _distinct.Add(result.Text);
        _results.Insert(0, result);
        if (_results.Count > 30)
        {
            _results.RemoveAt(_results.Count - 1);
        }

        StateHasChanged();
    }

    private void HandleStatus(BbScannerStatus status)
    {
        _statusChanges++;
        StateHasChanged();
    }

    private void Clear()
    {
        _results.Clear();
        _distinct.Clear();
        _reported = 0;
    }
}
