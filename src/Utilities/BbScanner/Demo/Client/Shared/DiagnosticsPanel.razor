@*
    Live pipeline timings. The stacked bar makes the split between the stages obvious, which is
    what tells you whether to lower the processing size, narrow the region or drop a symbology.
*@

<section class="bb-stage diag">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Frame diagnostics</h3>

    <div class="bb-stats">
        <div class="bb-stat">
            <span class="bb-stat-label">Frame</span>
            <span class="bb-stat-value">@Diagnostics.Total.TotalMilliseconds.ToString("0.00") ms</span>
        </div>
        <div class="bb-stat">
            <span class="bb-stat-label">Headroom</span>
            <span class="bb-stat-value">@Diagnostics.EquivalentFramesPerSecond.ToString("0") fps</span>
        </div>
        <div class="bb-stat">
            <span class="bb-stat-label">Decoded size</span>
            <span class="bb-stat-value">@Diagnostics.DecodedWidth×@Diagnostics.DecodedHeight</span>
        </div>
        <div class="bb-stat">
            <span class="bb-stat-label">Scan lines</span>
            <span class="bb-stat-value">@Diagnostics.RowsScanned</span>
        </div>
    </div>

    <div class="diag-bar" role="img" aria-label="Time split between pipeline stages">
        <div class="diag-seg diag-seg-gray" style="width:@Percent(Diagnostics.Grayscale)%"></div>
        <div class="diag-seg diag-seg-binarize" style="width:@Percent(Diagnostics.Binarize)%"></div>
        <div class="diag-seg diag-seg-matrix" style="width:@Percent(Diagnostics.Matrix)%"></div>
        <div class="diag-seg diag-seg-linear" style="width:@Percent(Diagnostics.Linear)%"></div>
    </div>
    <div class="diag-legend">
        <span><span class="diag-swatch diag-seg-gray"></span>Grayscale @Ms(Diagnostics.Grayscale)</span>
        <span><span class="diag-swatch diag-seg-binarize"></span>Binarise @Ms(Diagnostics.Binarize)</span>
        <span><span class="diag-swatch diag-seg-matrix"></span>Matrix @Ms(Diagnostics.Matrix)</span>
        <span><span class="diag-swatch diag-seg-linear"></span>Linear @Ms(Diagnostics.Linear)</span>
    </div>

    @if (FramesDecoded > 0)
    {
        <p class="diag-foot">@FramesDecoded frames decoded, @FramesWithSymbol contained a symbol.</p>
    }
</section>

@code {
    /// <summary>The most recent frame timings.</summary>
    [Parameter]
    public BbScanDiagnostics Diagnostics { get; set; }

    /// <summary>Total frames processed by the scanner.</summary>
    [Parameter]
    public long FramesDecoded { get; set; }

    /// <summary>How many of those frames contained a symbol.</summary>
    [Parameter]
    public long FramesWithSymbol { get; set; }

    private string Percent(TimeSpan part)
    {
        var total = Diagnostics.Total.TotalMilliseconds;
        return total <= 0 ? "0" : (part.TotalMilliseconds / total * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string Ms(TimeSpan value) => $"{value.TotalMilliseconds:0.00} ms";
}
