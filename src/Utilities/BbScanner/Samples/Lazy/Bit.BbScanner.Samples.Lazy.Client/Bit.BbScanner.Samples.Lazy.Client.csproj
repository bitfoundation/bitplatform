<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!-- The browser half of the lazy loading sample: it downloads Bit.BbScanner.wasm only when the page with the scanner
         opens. It does everything the README's "Lazy loading on WebAssembly" section asks of such a project, and the
         end-to-end suite (Tests/Bit.BbScanner.Tests.E2E, LazyLoadingTests) publishes it and checks it in a browser. -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
        <ProjectReference Include="..\..\..\Bit.BbScanner\Bit.BbScanner.csproj" />
    </ItemGroup>

    <!-- AOT builds load Bit.BbScanner with the rest of the app. Lazy loading suits an app that is not compiled ahead of
         time, whose interpreter decodes a camera frame far slower: fine for a scanner opened now and then. -->
    <ItemGroup Condition=" '$(RunAOTCompilation)' != 'true' ">
        <BlazorWebAssemblyLazyLoad Include="Bit.BbScanner.wasm" />
        <RuntimeHostConfigurationOption Include="Bit.BbScanner.Samples.Lazy.LazyLoadsBbScanner" Value="true" Trim="true" />
    </ItemGroup>

</Project>
