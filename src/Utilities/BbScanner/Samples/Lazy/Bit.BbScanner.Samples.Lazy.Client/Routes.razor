@* The router waits for OnNavigateAsync before it renders a page, so Bit.BbScanner.wasm is there before the scanner
   renders. This file renders before the assembly is downloaded, so it may not use BbScanner's types itself. The server
   prerenders it too: it registers LazyAssemblyLoader for that (its Program.cs), and does not set the switch, as it
   loads BbScanner with the rest of the app. *@
@using Microsoft.AspNetCore.Components.WebAssembly.Services
@inject LazyAssemblyLoader LazyAssemblyLoader

<Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Set only where Bit.BbScanner.wasm is marked (the project file): loading an assembly that is not marked throws.
    private static readonly bool LazyLoadsBbScanner = AppContext.TryGetSwitch("Bit.BbScanner.Samples.Lazy.LazyLoadsBbScanner", out var on) && on;

    private async Task OnNavigateAsync(NavigationContext context)
    {
        // The page with the scanner on it: fetch BbScanner before it renders. A second call loads nothing again.
        if (LazyLoadsBbScanner && IsScanPage(context.Path))
            await LazyAssemblyLoader.LoadAssembliesAsync(["Bit.BbScanner.wasm"]);
    }

    // /scan and the routes beneath it (routes match regardless of case), but not /scanner-settings. The path keeps any
    // query and fragment.
    private static bool IsScanPage(string path)
    {
        path = path.Split('?', '#')[0];
        return path.Equals("scan", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("scan/", StringComparison.OrdinalIgnoreCase);
    }
}
