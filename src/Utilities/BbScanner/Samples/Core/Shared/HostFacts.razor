@* Where this page is running. BbScanner works the same on every host; what changes is where its frames are decoded:
   in the browser on WebAssembly, and wherever .NET runs otherwise, the page sending each frame across. *@

<dl class="facts">
    <dt>Renderer</dt>
    <dd>@RendererInfo.Name (@(RendererInfo.IsInteractive ? "interactive" : "prerendering"))</dd>
    <dt>.NET runs on</dt>
    <dd>@(OperatingSystem.IsBrowser() ? "the browser (WebAssembly)" : RuntimeInformation.OSDescription)</dd>
    <dt>Runtime</dt>
    <dd>@RuntimeInformation.FrameworkDescription</dd>
    <dt>Camera frames</dt>
    <dd>@(OperatingSystem.IsBrowser() ? "decoded in the browser, copied straight into WebAssembly memory" : "sent by the page as the luminance of the searched region, decoded here")</dd>
    @ChildContent
</dl>

@code {
    /// <summary>More facts, as dt/dd pairs.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
