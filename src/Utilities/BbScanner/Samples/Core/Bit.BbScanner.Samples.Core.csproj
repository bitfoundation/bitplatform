<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The pages every hosting sample (Server, WebAssembly, Auto, MAUI) renders. Nothing in here knows which host it
       runs in, so running the same pages in each one shows what BbScanner can do where: the camera needs the
       WebAssembly runtime, the decoder runs wherever .NET does. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <ProjectReference Include="..\..\Bit.BbScanner\Bit.BbScanner.csproj" />
    <!-- The sample symbols are drawn with the test kit's encoders, as the demo's are: the library only reads
         barcodes, so the pages generate their own rather than shipping images. -->
    <ProjectReference Include="..\..\Tests\Bit.BbScanner.TestKit\Bit.BbScanner.TestKit.csproj" />
  </ItemGroup>

</Project>
