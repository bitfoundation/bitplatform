@page "/image"
@using Bit.BbScanner.TestKit

<PageTitle>Images - BbScanner samples</PageTitle>

<h1>Still images</h1>

<p>
    Three ways to read a still image, none of which opens the camera, so no permission is asked for. The first two
    have the browser decode the image file and need the WebAssembly runtime, as the camera does; the third hands the
    scanner pixels the application already has, and works on every host.
</p>

<div class="surface narrow">
    <BbScanner @ref="_scanner"
               AutoStart="false"
               Formats="BbBarcodeFormat.All"
               OnScan="HandleScan"
               OnError="e => _error = e" />
</div>

<section>
    <h2>Pick or drop an image</h2>
    <p>
        The scanner's own <em>Scan image</em> button, an image file dropped onto it, or a button of the page's own
        through <code>OpenFilePickerAsync</code>. Results arrive through <code>OnScan</code>.
    </p>
    <div class="toolbar">
        <button type="button" @onclick="OpenPickerAsync">Choose an image</button>
    </div>
</section>

<section>
    <h2>Blazor's InputFile</h2>
    <p>
        <code>ScanImageAsync</code> reads an image the application holds - an upload, a download, a file from
        <code>InputFile</code> - and returns every symbol in it instead of raising <code>OnScan</code>.
    </p>
    <InputFile accept="image/*" OnChange="ScanFileAsync" />
</section>

<section>
    <h2>Pixels the application has</h2>
    <p>
        <code>DecodeImage</code> takes pixels - from a canvas, a platform camera API, or here a generated QR code
        turned 20 degrees - and decodes them in-process with the scanner's symbologies and the still image tuning.
    </p>
    <div class="toolbar">
        <button type="button" @onclick="DecodeGeneratedImage">Decode a generated image</button>
    </div>
</section>

@if (_error is not null)
{
    <p class="status error"><strong>@_error.Kind</strong>: @_error.Message</p>
}

<ResultList Results="_results" />

@code {
    private readonly List<BbBarcodeResult> _results = [];
    private BbScanner? _scanner;
    private BbScannerException? _error;

    private void HandleScan(BbBarcodeResult result)
    {
        _error = null;
        _results.Insert(0, result);
    }

    private Task OpenPickerAsync() => _scanner?.OpenFilePickerAsync() ?? Task.CompletedTask;

    private async Task ScanFileAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        if (_scanner is null)
        {
            return;
        }

        try
        {
            // Zero is no limit to the scanner, but no bytes at all to OpenReadStream.
            var limit = _scanner.MaxImageFileSize > 0 ? _scanner.MaxImageFileSize : long.MaxValue;
            await using var stream = args.File.OpenReadStream(limit);
            var results = await _scanner.ScanImageAsync(stream);
            if (results.Count == 0)
            {
                _error = new BbScannerException(BbScannerErrorKind.InvalidImage, $"No barcode found in {args.File.Name}.");
            }

            _results.InsertRange(0, results);
        }
        catch (BbScannerException ex)
        {
            // NotSupported off WebAssembly; InvalidImage for a file that is refused or unreadable.
            _error = ex;
        }
        catch (IOException ex)
        {
            // InputFile's own size limit, which is the scanner's.
            _error = new BbScannerException(BbScannerErrorKind.InvalidImage, ex.Message, ex);
        }
    }

    private void DecodeGeneratedImage()
    {
        _error = null;
        if (_scanner is null)
        {
            return;
        }

        var qr = SymbolCatalog.All.First(s => s.Format == BbBarcodeFormat.QrCode);
        using var upright = qr.Render();
        using var turned = ImageTransforms.Rotate(upright, 20);

        // The packed RGBA an application gets from a canvas or a camera.
        var rgba = ImageTransforms.ToRgba(turned, tint: false);
        var result = _scanner.DecodeImage(rgba, turned.Width, turned.Height, BbPixelFormat.Rgba32);
        if (result is null)
        {
            _error = new BbScannerException(BbScannerErrorKind.Unknown, "The generated image did not decode.");
            return;
        }

        _results.Insert(0, result);
    }
}
