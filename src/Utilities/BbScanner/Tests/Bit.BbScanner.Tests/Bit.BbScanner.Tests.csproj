<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CS1591;BL0005</NoWarn>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.5.1" />
        <PackageReference Include="bunit" Version="2.13.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- Symbols written by an independent encoder; Reference/generate-reference-symbols.mjs regenerates them. -->
        <EmbeddedResource Include="Reference\ReferenceSymbols.json" LogicalName="ReferenceSymbols.json" />
        <None Remove="Reference\ReferenceSymbols.json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.BbScanner\Bit.BbScanner.csproj" />
        <ProjectReference Include="..\Bit.BbScanner.TestKit\Bit.BbScanner.TestKit.csproj" />
    </ItemGroup>

</Project>
