<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- The repo's global.json mandates the Microsoft.Testing.Platform runner. EnableMSTestRunner
             builds that test host into the assembly itself, and it only generates the entry point for
             an executable project. -->
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <!-- Playwright itself, without a per-framework integration package: the suite manages the
             browsers, the contexts and the demo host from its own infrastructure. -->
        <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
        <PackageReference Include="MSTest" Version="4.5.1" />
    </ItemGroup>

    <!-- The fake camera plays clips rendered by the test kit's encoders (Infrastructure/FakeCameraVideo.cs).
         Deliberately no ProjectReference to the demo: the suite boots Bit.BbScanner.Demo.Server from its build
         output as a separate process (Infrastructure/DemoHost.cs), so build the demo server first, in the
         configuration the tests run in. A reference would also make this project build the WebAssembly client
         a second time, into the same obj folders, on every test build. -->
    <ItemGroup>
        <ProjectReference Include="..\Bit.BbScanner.TestKit\Bit.BbScanner.TestKit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

</Project>
