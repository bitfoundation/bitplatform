<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!-- The browser half of the lazy loading sample: it downloads Bit.BlazeDb.wasm only when the todos page, the part of
         the app with the database, opens. It does everything the README's "Lazy loading on WebAssembly" section asks of
         such a project, and the end-to-end suite (Tests/Bit.BlazeDb.Tests.E2E, LazyLoadingTests) publishes it and checks
         it in a browser. -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
        <!-- The engine, browser backends included. -->
        <ProjectReference Include="..\..\..\Bit.BlazeDb\Bit.BlazeDb.csproj" />
        <!-- The generator as an analyzer, which is what the Bit.BlazeDb package adds to a consumer: it turns
             Data/TodoItem.cs into a table. A project reference to Bit.BlazeDb does not bring it, since the package
             carries it only as packed analyzer output. -->
        <ProjectReference Include="..\..\..\Bit.BlazeDb.Generators\Bit.BlazeDb.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- AOT builds load Bit.BlazeDb with the rest of the app. -->
    <ItemGroup Condition=" '$(RunAOTCompilation)' != 'true' ">
        <BlazorWebAssemblyLazyLoad Include="Bit.BlazeDb.wasm" />
        <RuntimeHostConfigurationOption Include="Bit.BlazeDb.Samples.Lazy.LazyLoadsBlazeDb" Value="true" Trim="true" />
    </ItemGroup>

</Project>
