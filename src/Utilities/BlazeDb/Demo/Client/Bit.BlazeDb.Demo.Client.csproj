<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The host owns the launch profile: this project is never started on its own. -->
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <!-- Publishes this project's static web assets at the app root (not under _content/), the
         way a Blazor Web App's client project is expected to contribute them. -->
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Bit.Minifier" Version="10.7.0-pre-04" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine, browser backends included. -->
    <ProjectReference Include="..\..\Bit.BlazeDb\Bit.BlazeDb.csproj" />
    <ProjectReference Include="..\..\Bit.BlazeDb.EntityFrameworkCore\Bit.BlazeDb.EntityFrameworkCore.csproj" />
    <!-- The generator as an analyzer, which is what the Bit.BlazeDb package adds to a consumer: a project reference
         to Bit.BlazeDb does not bring it, since the package carries it only as packed analyzer output. -->
    <ProjectReference Include="..\..\Bit.BlazeDb.Generators\Bit.BlazeDb.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
