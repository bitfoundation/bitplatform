@* One measured number - a cell of the site kit's .bb-stats strip: the label, the value, and an
   optional note saying where the number came from (usually the call that produced it). *@

<div class="bb-stat @ToneClass">
    <span class="bb-stat-label">@Label</span>
    <span class="bb-stat-value">@Value</span>
    @if (!string.IsNullOrWhiteSpace(Note))
    {
        <span class="bd-stat-note">@Note</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public string Value { get; set; } = "";

    [Parameter] public string? Note { get; set; }

    /// <summary>One of <c>""</c>, <c>accent</c> or <c>ok</c>.</summary>
    [Parameter] public string? Tone { get; set; }

    private string? ToneClass => Tone switch
    {
        "accent" => "bd-stat-accent",
        "ok" => "bd-stat-ok",
        _ => null,
    };
}
