@page "/changes"
@implements IAsyncDisposable

<PageTitle>Changes & live queries · BlazeDb</PageTitle>

<PageHeader Eyebrow="Changes" Title="Every commit, reported once"
            Lead="Tables and the database raise Changed after each commit with the net change to every row it touched, and Watch turns a query into a live one that re-runs only when a commit concerns it. A subscriber never sees a write that is rolled back, nor a state that only existed half-way through a transaction.">
    <span class="bb-badge bd-badge-neutral">After commit</span>
    <span class="bb-badge bd-badge-neutral">Net change per row</span>
    <span class="bb-badge bd-badge-neutral">No rolled-back writes</span>
</PageHeader>

<Section Title="Write, and watch what is reported"
         Lead="A private in-memory database with a live query over its open items. Each button is one commit - or one that never happens. The feed on the right is the database's Changed event; the counter under the list is how often the live query re-ran.">
    <div class="bd-main-side">
        <div class="bb-flex">
            <Panel Title="Commits" IconName="list">
                <div class="bd-actions">
                    <button type="button" class="btn btn-secondary" @onclick="Add"><Icon Name="plus" /> Insert one</button>
                    <button type="button" class="btn btn-secondary" disabled="@(Open.Count == 0)" @onclick="CompleteFirst"><Icon Name="check" /> Complete the first open item</button>
                    <button type="button" class="btn btn-secondary" disabled="@(_db is null)" @onclick="RenameDone"><Icon Name="code" /> Rename a done item</button>
                    <button type="button" class="btn btn-secondary" @onclick="Batch"><Icon Name="txn" /> Three writes, one transaction</button>
                    <button type="button" class="btn btn-secondary" @onclick="Churn"><Icon Name="history" /> Insert and delete in one transaction</button>
                    <button type="button" class="btn btn-secondary" @onclick="RolledBack"><Icon Name="refresh" /> Write, then roll back</button>
                    <button type="button" class="btn btn-secondary" @onclick="Savepoint"><Icon Name="history" /> Roll back to a savepoint, then commit</button>
                    <button type="button" class="btn btn-secondary" @onclick="Bulk"><Icon Name="layers" /> InsertMany - three rows</button>
                    <button type="button" class="btn btn-secondary" @onclick="HandlerWrites"><Icon Name="code" /> A handler that writes</button>
                    <button type="button" class="btn bd-btn-danger" @onclick="HandlerThrows"><Icon Name="alert" /> A handler that throws</button>
                </div>
            </Panel>

            <Panel Title="Live query: open items" IconName="database" Flush="true">
                <Actions>
                    <span class="bd-panel-sub">re-ran @(_live?.Version ?? 0)×</span>
                    <span class="bb-badge bd-badge-neutral" title="todos.Version - bumped by every commit that changed the table">todos.Version = @(_todos?.Version ?? 0)</span>
                    <button type="button" class="btn btn-secondary" @onclick="RefreshLive"><Icon Name="refresh" /> Refresh()</button>
                </Actions>
                <ChildContent>
                    @if (Open.Count == 0)
                    {
                        <div class="bb-empty">Nothing open.</div>
                    }
                    else
                    {
                        <div class="bd-rows">
                            @foreach (var row in Open)
                            {
                                <div class="bd-row">
                                    <div class="bd-row-main">
                                        <div class="bd-row-title">@row.Title</div>
                                        <div class="bd-row-meta"><span class="bb-mono">effort @row.Effort</span></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </ChildContent>
            </Panel>
            <CodeBlock Title="The live query above" Code="@LiveSnippet" />
        </div>

        <Panel Title="Change feed - db.Changed" IconName="history" Flush="true">
            <Actions>
                <span class="bd-panel-sub">@_feed.Count commits</span>
            </Actions>
            <ChildContent>
                @if (_feed.Count == 0)
                {
                    <div class="bb-empty">No commit yet.</div>
                }
                else
                {
                    <div class="bb-scroll">
                        <table class="bb-table">
                            <thead><tr><th>#</th><th>Action</th><th>Reported</th></tr></thead>
                            <tbody>
                                @foreach (var entry in Enumerable.Reverse(_feed))
                                {
                                    <tr>
                                        <td class="bb-mono">@entry.Number</td>
                                        <td>@entry.Action</td>
                                        <td class="bb-mono">@entry.Summary</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="bd-panel-pad bd-panel-foot">
                    <div class="bd-foot">@_note</div>
                </div>
            </ChildContent>
        </Panel>
    </div>
</Section>

<Section Title="Subscribing"
         Lead="Changed is an ordinary .NET event, raised synchronously on the thread that committed, after the commit has completed and the write lock is released.">
    <CodeBlock Title="A table, and the whole database" Code="@SubscribeSnippet" />
    <div class="bb-grid">
        <div class="bb-card">
            <h4 class="bb-card-title">Net change, once per commit</h4>
            <p class="bb-card-desc">A transaction that updates a row three times reports one update, from the row before the commit to the row after it. A row inserted and deleted again inside one commit is not reported at all.</p>
        </div>
        <div class="bb-card">
            <h4 class="bb-card-title">Only committed states</h4>
            <p class="bb-card-desc">Nothing is reported before the commit, nothing for a rollback, a savepoint rolled back to, or a commit the log refused. A subscriber's view of the table is always one the database really had.</p>
        </div>
        <div class="bb-card">
            <h4 class="bb-card-title">Handlers may read and write</h4>
            <p class="bb-card-desc">They run outside the write lock. A write made from a handler is reported once the current notification has reached every subscriber, so order is commit order.</p>
        </div>
        <div class="bb-card">
            <h4 class="bb-card-title">A failing handler is isolated</h4>
            <p class="bb-card-desc">Every subscriber hears of the commit even if one throws. The exceptions surface together from the write that committed, as a BlazeDbChangeHandlerException - the write has still committed, so it is not retried.</p>
        </div>
    </div>
    <Callout Tone="info" Title="Free when nobody listens.">
        A commit collects changes only for tables someone subscribed to (or when the database event has a subscriber),
        so an application that never subscribes pays one field read per write.
    </Callout>
    <div class="bb-grid">
        <div class="bb-card">
            <h4 class="bb-card-title">One thread, one order</h4>
            <p class="bb-card-desc">Handlers run on the thread that committed - each thread delivers its own commits - so a component re-renders through <code>InvokeAsync(StateHasChanged)</code>. A database-wide subscriber on a multi-threaded host that needs one ordered stream, an outbox, serializes itself there. See the <a href="hosting">threading model</a>.</p>
        </div>
        <div class="bb-card">
            <h4 class="bb-card-title">Through EF Core</h4>
            <p class="bb-card-desc"><code>SaveChanges</code> completes first - the change tracker accepts what was saved - and then throws the <code>BlazeDbChangeHandlerException</code>. The save did commit: do not retry it.</p>
        </div>
        <div class="bb-card">
            <h4 class="bb-card-title">Replicas report resets</h4>
            <p class="bb-card-desc">A read-only replica raises <code>Changed</code> with <code>IsReset</code> after <code>ReloadAsync</code>: the whole table was replaced, row by row changes are not known. <a href="tabs">Watch one reload</a>.</p>
        </div>
    </div>
    <div class="bb-split">
        <Panel Title="A live query" IconName="database">
            <ul class="bb-detail-list">
                <li><code>table.Watch(query)</code> runs the query now and again after every commit to the table; <code>Result</code> is the current value, <code>Version</code> counts the runs and <code>Changed</code> fires after each.</li>
                <li>Given <code>relevantTo</code>, it re-runs only after commits that changed a row the test accepts - before or after the change.</li>
                <li>Return a materialized result (<code>ToList()</code>, a count, a row): a lazy sequence would be enumerated later, against whatever the table holds by then.</li>
                <li><code>Refresh()</code> re-runs it on demand; <code>Dispose()</code> unsubscribes it, and <code>IsDisposed</code> says so.</li>
                <li>Without a subscription, <code>table.Version</code> - a counter every commit that changes the table moves on - tells a cache whether a result it holds is still current; it is what a stream checks between batches too.</li>
            </ul>
        </Panel>
        <CodeBlock Title="Typed changes, row by row" Code="@TypedSnippet" />
    </div>
</Section>

@code {
    private sealed record FeedEntry(int Number, string Action, string Summary);

    private BlazeDbDatabase? _db;
    private BlazeDbTable<Guid, TodoEntry>? _todos;
    private BlazeDbLiveQuery<List<TodoEntry>>? _live;
    private readonly List<FeedEntry> _feed = [];
    private string _action = "";
    private string _note = "Each row is one Changed event of the database: the tables it names and what happened to each row.";
    private int _counter;

    private IReadOnlyList<TodoEntry> Open => _live?.Result ?? [];

    protected override async Task OnInitializedAsync()
    {
        _db = await DemoSandbox.OpenAsync();
        _todos = _db.GetTable(TodoEntry.Table);
        _todos.InsertMany(Enumerable.Range(1, 3).Select(i => NewTodo($"Seeded item {i}", effort: i * 10)));

        _db.Changed += (_, e) =>
        {
            var summary = string.Join(", ", e.Changes.Select(Describe));
            _feed.Add(new FeedEntry(_feed.Count + 1, _action, summary));
        };
        _live = _todos.Watch(
            t => t.Lookup(TodoEntry.Indexes.Done, false).OrderBy(r => r.Effort).Take(8).ToList(),
            relevantTo: t => !t.Done);
    }

    private TodoEntry NewTodo(string title, int effort) => new()
    {
        Id = Guid.NewGuid(),
        Title = title,
        Effort = effort,
        CreatedAt = DateTime.UtcNow,
    };

    private static string Short(object key) => key is Guid id ? id.ToString()[..8] : key.ToString() ?? "";

    /// <summary>One row change as the feed shows it: the table, the kind, the key - and for an update, what moved.</summary>
    private static string Describe(BlazeDbRowChange change)
    {
        var text = $"{change.Table}: {change.Kind.ToString().ToLowerInvariant()} {Short(change.Key)}";
        if (change is { Kind: BlazeDbChangeKind.Updated, OldRow: TodoEntry before, NewRow: TodoEntry after })
        {
            if (before.Title != after.Title)
            {
                text += $" (\"{before.Title}\" → \"{after.Title}\")";
            }
            if (before.Done != after.Done)
            {
                text += $" (Done {before.Done} → {after.Done})";
            }
        }
        return text;
    }

    private void Run(string action, Action write, string note)
    {
        var before = _feed.Count;
        _action = action;
        write();
        _note = _feed.Count == before ? $"{note} Nothing was reported." : note;
    }

    private void Add() => Run("Insert", () => _todos!.Insert(NewTodo($"Item {++_counter}", effort: 5 + _counter % 40)),
        "An autocommit insert: one commit, one change.");

    private void CompleteFirst()
    {
        var first = Open[0];
        var done = first.Clone();
        done.Done = true;
        Run("Complete", () => _todos!.Update(done), "The live query re-ran: the old row was open, so the commit concerned it.");
    }

    private void RenameDone()
    {
        var target = _todos!.Lookup(TodoEntry.Indexes.Done, true).FirstOrDefault();
        if (target is null)
        {
            _note = "Complete an item first, then rename it.";
            return;
        }
        var renamed = target.Clone();
        renamed.Title += " (renamed)";
        Run("Rename done item", () => _todos.Update(renamed),
            "Reported to the database event, but the live query did not re-run: neither the old nor the new row is open.");
    }

    private void Batch() => Run("Transaction", () =>
    {
        _db!.RunInTransaction(() =>
        {
            var row = NewTodo("Batched", effort: 1);
            _todos!.Insert(row);
            var edited = row.Clone();
            edited.Title = "Batched and edited";
            _todos.Update(edited);
            _todos.Insert(NewTodo("Batched too", effort: 2));
        });
    }, "Three writes, one commit: the inserted-then-updated row is reported once, as an insert of its final state.");

    private void Churn() => Run("Insert + delete", () =>
    {
        _db!.RunInTransaction(() =>
        {
            var row = NewTodo("Here and gone", effort: 3);
            _todos!.Insert(row);
            _todos.Delete(row.Id);
        });
    }, "Inserted and deleted inside one commit: no state anyone could observe changed.");

    private void RolledBack() => Run("Rolled back", () =>
    {
        using var txn = _db!.BeginTransaction();
        _todos!.Insert(NewTodo("Never committed", effort: 4));
        txn.Rollback();
    }, "The transaction rolled back, so subscribers heard nothing.");

    private void Savepoint() => Run("Savepoint", () =>
    {
        using var txn = _db!.BeginTransaction();
        _todos!.Insert(NewTodo("Kept by the savepoint", effort: 6));
        var savepoint = txn.CreateSavepoint();
        _todos.Insert(NewTodo("Rolled back to the savepoint", effort: 7));
        txn.RollbackTo(savepoint);
        txn.Commit();
    }, "Two inserts, one of them rolled back to a savepoint: only the one that committed is reported.");

    private void Bulk() => Run("InsertMany", () => _todos!.InsertMany(
        Enumerable.Range(1, 3).Select(i => NewTodo($"Bulk {++_counter}", effort: 10 + i))),
        "A bulk write is one commit: one Changed event carrying three inserts.");

    private void HandlerWrites()
    {
        var settings = _db!.GetTable(Setting.Table);

        void Audit(object? sender, BlazeDbTableChangedEventArgs<Guid, TodoEntry> e)
        {
            // A write from a handler: delivered once this notification has reached every subscriber.
            settings.Upsert(new Setting { Name = "audit.last", Value = $"{e.Changes.Count} todo change(s)", UpdatedAt = DateTime.UtcNow });
        }

        _todos!.Changed += Audit;
        try
        {
            Run("Insert, audited by a handler", () => _todos.Insert(NewTodo($"Audited {++_counter}", effort: 8)),
                "The handler's own write is reported as the next commit, after this one reached every subscriber - commit order is kept.");
        }
        finally
        {
            _todos.Changed -= Audit;
        }
    }

    private void HandlerThrows()
    {
        static void Broken(object? sender, BlazeDbTableChangedEventArgs<Guid, TodoEntry> e) =>
            throw new InvalidOperationException("this subscriber has a bug");

        _todos!.Changed += Broken;
        var before = _todos.Count;
        try
        {
            Run("Insert, with a failing subscriber", () => _todos.Insert(NewTodo($"Committed anyway {++_counter}", effort: 9)), "");
            _note = "No exception - unexpected.";
        }
        catch (BlazeDbChangeHandlerException ex)
        {
            _note = $"The insert threw BlazeDbChangeHandlerException ({ex.InnerException?.Message}) - yet todos.Count went from {before} to {_todos.Count} and the feed still heard it: the write committed, every other subscriber was told, so do not retry it.";
        }
        finally
        {
            _todos.Changed -= Broken;
        }
    }

    private void RefreshLive()
    {
        _live?.Refresh();
        _note = $"_open.Refresh() re-ran the query on demand: Version = {_live?.Version}.";
    }

    public async ValueTask DisposeAsync()
    {
        _live?.Dispose();
        if (_db is not null)
        {
            await _db.DisposeAsync();
        }
    }

    private const string LiveSnippet = """
        @implements IDisposable

        @code {
            private BlazeDbLiveQuery<List<TodoEntry>> _open = null!;

            protected override void OnInitialized()
            {
                _open = todos.Watch(
                    t => t.Lookup(TodoEntry.Indexes.Done, false).OrderBy(r => r.Effort).Take(8).ToList(),
                    relevantTo: t => !t.Done);          // re-run only when an open row changed
                _open.Changed += (_, _) => InvokeAsync(StateHasChanged);
            }

            public void Dispose() => _open.Dispose();
        }
        """;

    private const string TypedSnippet = """
        todos.Changed += (_, e) =>
        {
            foreach (var change in e.Changes)        // BlazeDbRowChange<Guid, TodoEntry>
            {
                switch (change.Kind)
                {
                    case BlazeDbChangeKind.Inserted: Added(change.NewRow!); break;
                    case BlazeDbChangeKind.Updated:  Moved(change.OldRow!, change.NewRow!); break;
                    case BlazeDbChangeKind.Deleted:  Removed(change.Key); break;
                }
            }
            if (e.IsReset) ReloadEverything();     // a replica's ReloadAsync
        };
        """;

    private const string SubscribeSnippet = """
        // One table, typed: the net change to each row, after each commit.
        todos.Changed += (_, e) =>
        {
            foreach (var change in e.Changes)
            {
                // change.Kind: Inserted, Updated or Deleted
                // change.OldRow / change.NewRow: the row before and after the commit
            }
        };

        // Every table, untyped: an audit log, a sync outbox, a "saved" badge.
        db.Changed += (_, e) => outbox.Enqueue(e.Changes);   // e.Changes[i].Table names the table
        """;
}
