    private void ScenarioInPlace()
    {
        var people = _people!;
        var db = _db!;

        var row = people.Get(1)!;
        var previous = row.With(_ => { });
        row.City = "Paris";
        _log.Run("Changed the live row in place", "row.City = \"Paris\"",
            $"Lookup(CityRole, (\"London\", \"engineer\")) still finds it: {people.Lookup(Person.Indexes.CityRole, ("London", "engineer")).Count(p => p.Id == 1)} row(s), now in Paris.");

        var issues = db.VerifyIntegrity();
        _log.Error("db.VerifyIntegrity()", $"{issues.Count} issue(s)",
            string.Join(" · ", issues.Select(i => $"{i.Table} / {i.Index ?? "primary key"}: {i.Description}")));

        try
        {
            people.Update(row);
            _log.Error("No exception", "unexpected");
        }
        catch (InvalidOperationException ex)
        {
            _log.Error("Update(row) is refused", "InvalidOperationException", ex.Message);
        }

        people.UpdateInPlace(row, previous);
        _log.Ok("UpdateInPlace(row, previous)", "people.UpdateInPlace(row, previous)",
            $"Lookup(CityRole, (\"Paris\", \"engineer\")) → {people.Lookup(Person.Indexes.CityRole, ("Paris", "engineer")).Count()} row(s)");

        _log.Ok("db.VerifyIntegrity()", $"{db.VerifyIntegrity().Count} issue(s)", "Rows and indexes agree again.");
    }

    private void ScenarioStale()
    {
        var people = _people!;
        var db = _db!;

        var row = people.Get(4)!;
        var trackerA = row.With(_ => { });
        var trackerB = row.With(_ => { });
        _log.Run("Two editors share the live row", "trackerA, trackerB = copies of row 4", $"City = \"{row.City}\", Role = \"{row.Role}\"");

        row.City = "Houston";
        people.UpdateInPlace(row, trackerA);
        _log.Ok("A saves", "row.City = \"Houston\"; people.UpdateInPlace(row, trackerA)", "The CityRole entry moved to (Houston, researcher).");

        row.Role = "engineer";
        try
        {
            people.UpdateInPlace(row, trackerB);
            _log.Error("No exception", "unexpected");
        }
        catch (BlazeDbStaleRowException ex)
        {
            _log.Error("B saves with its originals",
                $"BlazeDbStaleRowException(table: \"{ex.TableName}\", index: \"{ex.IndexName}\")", ex.Message);
        }

        _log.Add("The row is still changed in place", $"db.VerifyIntegrity() → {db.VerifyIntegrity().Count} issue(s)",
            "B's in-place change is in memory but not indexed. Telling the table what it really holds fixes that:");

        people.UpdateInPlace(row, row.With(p => p.Role = "researcher"));
        _log.Ok("Retry with the values the indexes hold",
            "people.UpdateInPlace(row, row.With(p => p.Role = \"researcher\"))",
            $"db.VerifyIntegrity() → {db.VerifyIntegrity().Count} issue(s)");
    }

