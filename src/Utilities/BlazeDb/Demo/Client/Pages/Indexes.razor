@page "/indexes"
@implements IAsyncDisposable
@inject DemoDbService Db

<PageTitle>Indexes · BlazeDb</PageTitle>

<PageHeader Eyebrow="Indexes" Title="Two index kinds, both maintained for you"
            Lead="A hash index answers equality in constant time. An ordered index answers range and sort questions in logarithmic time. Either can be unique, span several properties, or key on a computed value - and every insert, update, delete and rollback keeps them in step: there is no reindex step and no stale index.">
    <span class="bb-badge">3 hash</span>
    <span class="bb-badge">2 ordered</span>
    <span class="bb-badge bd-badge-neutral">@(_todos?.Count ?? 0) rows</span>
</PageHeader>

@if (_todos is null)
{
    <div class="bb-empty"><span class="bb-spinner"></span> Opening the database…</div>
}
else
{
    <Section Title="Hash indexes - equality in O(1)"
             Lead="Lookup returns every row whose indexed value equals the key. CountBy answers the same question without materialising anything.">
        <div class="bd-main-side">
            <Panel Title="Try a lookup" IconName="search">
                <div class="bb-fields">
                    <div class="bb-field">
                        <label for="hash-index">Index</label>
                        <select id="hash-index" @bind="_hashIndex" @bind:after="RunHash">
                            <option value="Done">Indexes.Done - bool</option>
                            <option value="Category">Indexes.Category - string?</option>
                            <option value="ByPriority">Indexes.ByPriority - Priority enum</option>
                        </select>
                    </div>
                    <div class="bb-field">
                        <label for="hash-value">Key</label>
                        @if (_hashIndex == "Done")
                        {
                            <select id="hash-value" @bind="_doneKey" @bind:after="RunHash">
                                <option value="false">false</option>
                                <option value="true">true</option>
                            </select>
                        }
                        else if (_hashIndex == "Category")
                        {
                            <select id="hash-value" @bind="_categoryKey" @bind:after="RunHash">
                                @foreach (var c in DemoData.Categories)
                                {
                                    <option value="@c">@c</option>
                                }
                                <option value="__null">null</option>
                                <option value="__missing">"nonexistent"</option>
                            </select>
                        }
                        else
                        {
                            <select id="hash-value" @bind="_priorityKey" @bind:after="RunHash">
                                @foreach (var p in Enum.GetValues<Priority>())
                                {
                                    <option value="@p">Priority.@p</option>
                                }
                            </select>
                        }
                    </div>
                </div>

                <div class="bb-log bd-out">@_hashCode</div>

                <div class="bb-stats">
                    <StatTile Label="Lookup rows" Value="@_hashRows.Count.ToString("N0")" Tone="accent" />
                    <StatTile Label="CountBy" Value="@_hashCount.ToString("N0")" Note="no rows materialised" />
                    <StatTile Label="Elapsed" Value="@_hashTime" Note="both calls" />
                </div>

                @if (_hashRows.Count > 0)
                {
                    <div class="bd-rows bd-rows-framed">
                        @foreach (var row in _hashRows.Take(6))
                        {
                            <div class="bd-row">
                                <div class="bd-row-main">
                                    <div class="bd-row-title">@row.Title</div>
                                    <div class="bd-row-meta">
                                        <span class="bd-prio bd-prio-@row.Priority">@row.Priority</span>
                                        <span class="@Tones.Badge(row.Category is null ? "" : "accent")">@(row.Category ?? "null")</span>
                                        <span class="bb-mono">@(row.Done ? "done" : "open")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (_hashRows.Count > 6)
                    {
                        <p class="bd-foot">…and @(_hashRows.Count - 6) more.</p>
                    }
                }
                else
                {
                    <div class="bb-empty">@_hashEmptyNote</div>
                }
            </Panel>

            <div class="bb-flex">
                <Panel Title="Null keys are indexed like any other" IconName="alert">
                    <p>
                        A row whose indexed property is <code>null</code> is recorded in that index
                        under null, so <code>Lookup(Category, null)</code> finds the uncategorised rows
                        in one probe and an ordered index lists them first. Only a bounded
                        <code>Range</code> leaves them out - null is inside no interval - and a single-property
                        unique index never counts them as duplicates. (A compound unique index compares the whole
                        tuple, so there null members are not exempt.)
                    </p>
                    <dl class="bb-params">
                        <dt>Rows in table</dt>
                        <dd>@_todos.Count</dd>
                        <dt>Sum over categories</dt>
                        <dd>@_categorySum</dd>
                        <dt>Null category</dt>
                        <dd>@(_todos.Count - _categorySum)</dd>
                        <dt>Lookup(Category, null)</dt>
                        <dd>@_nullLookupCount rows</dd>
                    </dl>
                    <p class="bd-foot">
                        <code>CountBy</code> over the named categories plus the null bucket adds up to
                        <code>table.Count</code>.
                    </p>
                </Panel>

                <Panel Title="Every value with its count" IconName="list" Sub="CountBy(index) - filter facets">
                    <p>
                        Without a value, <code>CountBy</code> walks the index's buckets rather than the rows and returns
                        every distinct value with how many rows carry it - one step per value. Null is counted under null.
                    </p>
                    <div class="bb-scroll">
                        <table class="bb-table">
                            <thead><tr><th>todos.CountBy(Indexes.Category)</th><th class="bd-num">Rows</th></tr></thead>
                            <tbody>
                                @foreach (var facet in _todos.CountBy(TodoEntry.Indexes.Category).OrderByDescending(f => f.Value))
                                {
                                    <tr>
                                        <td class="bb-mono">@(facet.Key is null ? "null" : $"\"{facet.Key}\"")</td>
                                        <td class="bd-num">@facet.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </Panel>

                <Panel Title="Index versus scan" IconName="gauge">
                    <p>
                        Both of these compute the same number. One reads a bucket count; the other
                        walks every row.
                    </p>
                    <button type="button" class="btn btn-secondary" @onclick="CompareCounting">
                        <Icon Name="play" /> Measure @CompareIterations iterations of each
                    </button>
                    @if (_compareDone)
                    {
                        <div class="bb-scroll">
                            <table class="bb-table">
                                <thead><tr><th>Call</th><th class="bd-num">Per op</th></tr></thead>
                                <tbody>
                                    <tr>
                                        <td class="bb-mono">CountBy(Done, true)</td>
                                        <td class="bd-num bd-ok">@_countByTime</td>
                                    </tr>
                                    <tr>
                                        <td class="bb-mono">Scan().Count(t =&gt; t.Done)</td>
                                        <td class="bd-num">@_scanTime</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p class="bd-foot">
                            Same answer (@_compareResult rows) - @_compareFactor.
                        </p>
                    }
                </Panel>
            </div>
        </div>
    </Section>

    <Section Title="Ordered indexes - ranges and sort order"
             Lead="Range takes two bounds - inclusive unless made with BlazeDbBound.Exclusive - and walks the index in either direction. An unbounded end leaves the range open, and an implicit conversion means a bare value is accepted wherever a bound is expected.">
        <div class="bd-main-side">
            <Panel Title="Compose a range" IconName="filter">
                <div class="bb-fields">
                    <div class="bb-field">
                        <label for="ord-index">Index</label>
                        <select id="ord-index" @bind="_orderedIndex" @bind:after="RunOrdered">
                            <option value="Effort">Indexes.Effort - int</option>
                            <option value="CreatedAt">Indexes.CreatedAt - DateTime</option>
                        </select>
                    </div>
                    <div class="bb-field">
                        <span id="ord-direction">Direction</span>
                        <div class="bb-segmented" role="group" aria-labelledby="ord-direction">
                            <button type="button" aria-pressed="@(!_descending ? "true" : "false")" @onclick="() => SetDirection(false)">Ascending</button>
                            <button type="button" aria-pressed="@(_descending ? "true" : "false")" @onclick="() => SetDirection(true)">Descending</button>
                        </div>
                    </div>
                </div>

                @if (_orderedIndex == "Effort")
                {
                    <div class="bb-fields">
                        <div class="bb-field">
                            <label for="eff-from">From (@(_fromExclusive ? "exclusive" : "inclusive"))</label>
                            <input id="eff-from" class="bb-mono" type="number" min="0" max="600" disabled="@_fromUnbounded"
                                   @bind="_effortFrom" @bind:after="RunOrdered" />
                            <label class="bb-check">
                                <input type="checkbox" @bind="_fromUnbounded" @bind:after="RunOrdered" />
                                BlazeDbBound&lt;int&gt;.Unbounded
                            </label>
                            <label class="bb-check">
                                <input type="checkbox" disabled="@_fromUnbounded" @bind="_fromExclusive" @bind:after="RunOrdered" />
                                BlazeDbBound&lt;int&gt;.Exclusive
                            </label>
                        </div>
                        <div class="bb-field">
                            <label for="eff-to">To (@(_toExclusive ? "exclusive" : "inclusive"))</label>
                            <input id="eff-to" class="bb-mono" type="number" min="0" max="600" disabled="@_toUnbounded"
                                   @bind="_effortTo" @bind:after="RunOrdered" />
                            <label class="bb-check">
                                <input type="checkbox" @bind="_toUnbounded" @bind:after="RunOrdered" />
                                BlazeDbBound&lt;int&gt;.Unbounded
                            </label>
                            <label class="bb-check">
                                <input type="checkbox" disabled="@_toUnbounded" @bind="_toExclusive" @bind:after="RunOrdered" />
                                BlazeDbBound&lt;int&gt;.Exclusive
                            </label>
                        </div>
                    </div>
                }
                else
                {
                    <div class="bb-fields">
                        <div class="bb-field">
                            <label for="date-from">From (inclusive)</label>
                            <input id="date-from" class="bb-mono" type="date" disabled="@_fromUnbounded"
                                   @bind="_dateFrom" @bind:after="RunOrdered" />
                            <label class="bb-check">
                                <input type="checkbox" @bind="_fromUnbounded" @bind:after="RunOrdered" />
                                BlazeDbBound&lt;DateTime&gt;.Unbounded
                            </label>
                        </div>
                        <div class="bb-field">
                            <label for="date-to">To (inclusive)</label>
                            <input id="date-to" class="bb-mono" type="date" disabled="@_toUnbounded"
                                   @bind="_dateTo" @bind:after="RunOrdered" />
                            <label class="bb-check">
                                <input type="checkbox" @bind="_toUnbounded" @bind:after="RunOrdered" />
                                BlazeDbBound&lt;DateTime&gt;.Unbounded
                            </label>
                        </div>
                    </div>
                }

                <div class="bb-log bd-out">@_orderedCode</div>

                <div class="bb-stats">
                    <StatTile Label="Rows in range" Tone="accent" Value="@_orderedRows.Count.ToString("N0")" />
                    <StatTile Label="Elapsed" Value="@_orderedTime" />
                    <StatTile Label="Full traversal" Value="@_orderByCount.ToString("N0")"
                              Note="OrderBy(index) - every row" />
                </div>

                @if (_orderedRows.Count > 0)
                {
                    <div class="bb-scroll">
                        <table class="bb-table bb-compare">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th class="bd-num">Effort</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _orderedRows.Take(10))
                                {
                                    <tr>
                                        <td class="bd-strong">@row.Title</td>
                                        <td class="bd-num">@row.Effort</td>
                                        <td class="bb-mono bd-small">@row.CreatedAt.ToLocalTime().ToString("MMM d HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_orderedRows.Count > 10)
                    {
                        <p class="bd-foot">First 10 of @_orderedRows.Count in index order.</p>
                    }
                }
                else
                {
                    <div class="bb-empty">Nothing in that range.</div>
                }
            </Panel>

            <div class="bb-flex">
                <Panel Title="Every form of a range bound" IconName="code">
                    <CodeBlock Code="@BoundSnippet" />
                </Panel>

                <Panel Title="An inverted range is empty" IconName="info">
                    <p>
                        Bounds are not reordered for you. When <code>from</code> is greater than
                        <code>to</code> the result is empty rather than an error.
                    </p>
                    <button type="button" class="btn btn-secondary" @onclick="RunInverted">
                        <Icon Name="play" /> Range(Effort, 200, 10)
                    </button>
                    @if (_invertedNote is not null)
                    {
                        <div class="bb-log bd-out">@_invertedNote</div>
                    }
                </Panel>
            </div>
        </div>
    </Section>

    <Section Title="Compound, unique, prefix and computed indexes"
             Lead="TodoEntry declares only single-property indexes. This private database holds a second table, Person, that declares every other shape the attributes can express - each one live below.">
        <CodeBlock Title="Data/DemoModels.cs" Code="@PersonSource" />

        @if (_people is not null)
        {
            <div class="bb-split">
                <Panel Title="A compound hash index" IconName="index" Sub="one lookup for several equalities">
                    <div class="bb-fields">
                        <div class="bb-field">
                            <label for="cr-city">City</label>
                            <select id="cr-city" @bind="_city">
                                @foreach (var city in _people.Scan().Select(p => p.City).Distinct().Order())
                                {
                                    <option value="@city">@city</option>
                                }
                            </select>
                        </div>
                        <div class="bb-field">
                            <label for="cr-role">Role</label>
                            <select id="cr-role" @bind="_role">
                                <option value="engineer">engineer</option>
                                <option value="researcher">researcher</option>
                            </select>
                        </div>
                    </div>
                    <div class="bb-log bd-out">people.Lookup(Person.Indexes.CityRole, ("@_city", "@_role")) → @string.Join(", ", _people.Lookup(Person.Indexes.CityRole, (_city, _role)).Select(p => p.Name).DefaultIfEmpty("no rows"))</div>
                    <p class="bd-foot">
                        Keyed by the value tuple, so a filter on both members is one probe - not a lookup on one and a
                        scan of the other. The EF Core provider picks it when several equalities match its members.
                    </p>
                </Panel>

                <Panel Title="A prefix scan" IconName="search" Sub="StartsWith over an ordinal string index">
                    <div class="bb-fields">
                        <div class="bb-field">
                            <label for="pf-prefix">Name starts with</label>
                            <input id="pf-prefix" class="bb-mono" @bind="_prefix" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="bb-log bd-out">people.StartsWith(Person.Indexes.Name, "@_prefix") → @string.Join(", ", _people.StartsWith(Person.Indexes.Name, _prefix).Select(p => p.Name).DefaultIfEmpty("no rows"))

BlazeDbQuery&lt;int, Person&gt;.From(people).UseIndexPrefix(Person.Indexes.Name, "@_prefix", descending: true).Explain()
@PrefixPlan()</div>
                    <p class="bd-foot">
                        A range from the prefix to the first string that sorts after every string carrying it. The match is
                        ordinal, so <code>"a"</code> does not find <code>"Ada"</code>, and an index declared with a comparer
                        of its own refuses the call: strings that share a prefix need not sort together under it.
                    </p>
                </Panel>
            </div>

            <div class="bb-split">
                <Panel Title="Keyset paging" IconName="sort" Sub="Range from Exclusive(last row)">
                    <div class="bb-scroll">
                        <table class="bb-table bb-compare">
                            <thead><tr><th>Joined</th><th class="bd-num">Id</th><th>Name</th></tr></thead>
                            <tbody>
                                @foreach (var person in _page)
                                {
                                    <tr>
                                        <td class="bb-mono bd-small">@person.Joined.ToString("yyyy-MM-dd")</td>
                                        <td class="bd-num">@person.Id</td>
                                        <td class="bd-strong">@person.Name</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="bb-toolbar">
                        <button type="button" class="btn btn-secondary" @onclick="FirstPage"><Icon Name="refresh" /> First page</button>
                        <button type="button" class="btn btn-secondary" disabled="@(_page.Count < PeoplePageSize)" @onclick="NextPage"><Icon Name="arrow-down" /> Next page</button>
                    </div>
                    <div class="bb-log bd-out">@_pageCode</div>
                    <p class="bd-foot">
                        The next page starts strictly after the last row of this one. Two people joined on 2024-03-02, so
                        paging on the date alone would skip or repeat one; the compound index ends in the unique Id, which
                        makes every position distinct.
                    </p>
                </Panel>

                <div class="bb-flex">
                    <Panel Title="An index-only computed property" IconName="tag" Sub="indexed, never stored">
                        <div class="bb-scroll">
                            <table class="bb-table">
                                <thead><tr><th>people.CountBy(Person.Indexes.Domain)</th><th class="bd-num">Rows</th></tr></thead>
                                <tbody>
                                    @foreach (var facet in _people.CountBy(Person.Indexes.Domain).OrderByDescending(f => f.Value).ThenBy(f => f.Key))
                                    {
                                        <tr>
                                            <td class="bb-mono">"@facet.Key"</td>
                                            <td class="bd-num">@facet.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="bd-foot">
                            <code>Domain =&gt; Email[(Email.IndexOf('@@') + 1)..]</code> is computed from a stored property; the
                            index keys on it while the row bytes leave it out.
                        </p>
                    </Panel>

                    <Panel Title="A unique index" IconName="key" Sub="Person.Indexes.Email">
                        <dl class="bb-params">
                            <dt>Email.IsUnique</dt>
                            <dd>@Person.Indexes.Email.IsUnique.ToString().ToLowerInvariant()</dd>
                            <dt>CountBy(Email, null)</dt>
                            <dd>@_people.CountBy(Person.Indexes.Email, null) - nulls are never duplicates on a single-property index</dd>
                        </dl>
                        <p class="bd-foot">
                            Every write path checks it before anything changes, <code>TryInsert</code> included -
                            <a href="writes">see it refuse a duplicate</a>.
                        </p>
                    </Panel>
                </div>
            </div>

            <Panel Title="Person.Table.Indexes - what the generator emitted" IconName="layers" Flush="true">
                <div class="bb-scroll">
                    <table class="bb-table">
                        <thead><tr><th>Name</th><th>Kind</th><th>Members</th><th>Unique</th></tr></thead>
                        <tbody>
                            @foreach (var index in Person.Table.Indexes)
                            {
                                var hash = index.GetType().Name.StartsWith("BlazeDbHash", StringComparison.Ordinal);
                                <tr>
                                    <td class="bd-strong">@index.Name</td>
                                    <td><span class="@Tones.Badge(hash ? "info" : "accent")">@(hash ? "hash" : "ordered")</span></td>
                                    <td class="bb-mono">@string.Join(", ", index.Members)</td>
                                    <td>@(index.IsUnique ? "unique" : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Panel>
        }
    </Section>

    <Section Title="Indexes follow every mutation"
             Lead="This runs against a private in-memory database so you can watch bucket counts move without touching your own rows.">
        <div class="bd-main-side">
            <Panel Title="Index state" IconName="layers" Flush="true">
                <div class="bb-scroll">
                    <table class="bb-table">
                        <thead>
                            <tr><th>Index</th><th>Key</th><th class="bd-num">CountBy</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="bb-mono">Done</td><td class="bb-mono">false</td>
                                <td class="bd-num">@_sandboxOpen</td>
                            </tr>
                            <tr>
                                <td class="bb-mono">Done</td><td class="bb-mono">true</td>
                                <td class="bd-num">@_sandboxDone</td>
                            </tr>
                            <tr>
                                <td class="bb-mono">Category</td><td class="bb-mono">"engine"</td>
                                <td class="bd-num">@_sandboxEngine</td>
                            </tr>
                            <tr>
                                <td class="bb-mono">Category</td><td class="bb-mono">"docs"</td>
                                <td class="bd-num">@_sandboxDocs</td>
                            </tr>
                            <tr>
                                <td class="bb-mono">ByPriority</td><td class="bb-mono">Critical</td>
                                <td class="bd-num">@_sandboxCritical</td>
                            </tr>
                            <tr>
                                <td class="bb-mono bd-strong">table.Count</td><td></td>
                                <td class="bd-num bd-strong">@_sandboxCount</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </Panel>

            <div class="bb-flex">
                <Panel Title="Mutate" IconName="play">
                    <div class="bd-actions">
                        <button type="button" class="btn btn-secondary" @onclick="SandboxInsert">
                            <Icon Name="plus" /> Insert an open "engine" row
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="SandboxFlipDone" disabled="@(_sandboxCount == 0)">
                            <Icon Name="refresh" /> Update - flip Done on the first row
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="SandboxRecategorise" disabled="@(_sandboxCount == 0)">
                            <Icon Name="tag" /> Update - move a row to "docs"
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="SandboxPromote" disabled="@(_sandboxCount == 0)">
                            <Icon Name="bolt" /> Update - raise priority to Critical
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="SandboxSetNull" disabled="@(_sandboxCount == 0)">
                            <Icon Name="close" /> Update - set Category to null
                        </button>
                        <button type="button" class="btn bd-btn-danger" @onclick="SandboxDelete" disabled="@(_sandboxCount == 0)">
                            <Icon Name="trash" /> Delete the first row
                        </button>
                    </div>
                </Panel>

                <Panel Title="What happened" IconName="history" Flush="true">
                    <ScenarioSteps Steps="_log.Steps" EmptyText="Mutate the sandbox and watch the indexes react." />
                </Panel>
            </div>
        </div>
    </Section>
}

@code {
    private const int CompareIterations = 200;

    private BlazeDbTable<Guid, TodoEntry>? _todos;

    // hash section
    private string _hashIndex = "Done";
    private string _doneKey = "false";
    private string _categoryKey = "engine";
    private string _priorityKey = nameof(Priority.Critical);
    private List<TodoEntry> _hashRows = [];
    private int _hashCount;
    private string _hashCode = "";
    private string _hashTime = "-";
    private string _hashEmptyNote = "No rows for that key.";
    private int _categorySum;
    private int _nullLookupCount;

    // counting comparison
    private bool _compareDone;
    private string _countByTime = "";
    private string _scanTime = "";
    private int _compareResult;
    private string _compareFactor = "";

    // ordered section
    private string _orderedIndex = "Effort";
    private bool _descending;
    private bool _fromUnbounded;
    private bool _toUnbounded;
    private bool _fromExclusive;
    private bool _toExclusive;
    private int _effortFrom = 40;
    private int _effortTo = 100;
    private DateTime _dateFrom = DateTime.UtcNow.AddDays(-14);
    private DateTime _dateTo = DateTime.UtcNow;
    private List<TodoEntry> _orderedRows = [];
    private string _orderedCode = "";
    private string _orderedTime = "-";
    private int _orderByCount;
    private string? _invertedNote;

    // maintenance sandbox
    private BlazeDbDatabase? _sandbox;
    private BlazeDbTable<Guid, TodoEntry>? _sandboxTable;
    private readonly ScenarioLog _log = new();
    private int _sandboxCount;
    private int _sandboxOpen;
    private int _sandboxDone;
    private int _sandboxEngine;
    private int _sandboxDocs;
    private int _sandboxCritical;

    // the people database
    private const int PeoplePageSize = 2;
    private BlazeDbDatabase? _peopleDb;
    private BlazeDbTable<int, Person>? _people;
    private string _city = "London";
    private string _role = "engineer";
    private string _prefix = "A";
    private List<Person> _page = [];
    private string _pageCode = "";

    protected override async Task OnInitializedAsync()
    {
        await Db.GetDatabaseAsync();
        _todos = Db.Todos;
        if (DemoData.MedianCreatedAt(_todos) is { } median)
        {
            _dateFrom = median;
        }

        _sandbox = await DemoSandbox.OpenAsync();
        _sandboxTable = _sandbox.GetTable(TodoEntry.Table);

        _peopleDb = await BlazeDbDatabase.OpenAsync(new BlazeDbDatabaseOptions().AddTable(Person.Table));
        _people = _peopleDb.GetTable(Person.Table);
        _people.InsertMany(DemoData.People());
        FirstPage();

        RunHash();
        RunOrdered();
        RefreshSandbox();
    }

    // ------------------------------------------------------------ hash index

    private void RunHash()
    {
        if (_todos is null)
        {
            return;
        }

        var sw = Stopwatch.StartNew();

        switch (_hashIndex)
        {
            case "Done":
                var done = _doneKey == "true";
                _hashRows = _todos.Lookup(TodoEntry.Indexes.Done, done).ToList();
                _hashCount = _todos.CountBy(TodoEntry.Indexes.Done, done);
                _hashCode =
                    $"todos.Lookup(TodoEntry.Indexes.Done, {_doneKey})\n" +
                    $"todos.CountBy(TodoEntry.Indexes.Done, {_doneKey})";
                _hashEmptyNote = "No rows for that key.";
                break;

            case "Category":
                var key = _categoryKey switch
                {
                    "__null" => null,
                    "__missing" => "nonexistent",
                    _ => _categoryKey,
                };
                _hashRows = _todos.Lookup(TodoEntry.Indexes.Category, key).ToList();
                _hashCount = _todos.CountBy(TodoEntry.Indexes.Category, key);
                _hashCode =
                    $"todos.Lookup(TodoEntry.Indexes.Category, {Literal(key)})\n" +
                    $"todos.CountBy(TodoEntry.Indexes.Category, {Literal(key)})";
                _hashEmptyNote = key is null
                    ? "No rows have a null category right now; null is a key like any other."
                    : "No rows for that key; a missing key is not an error.";
                break;

            default:
                var priority = Enum.Parse<Priority>(_priorityKey);
                _hashRows = _todos.Lookup(TodoEntry.Indexes.ByPriority, priority).ToList();
                _hashCount = _todos.CountBy(TodoEntry.Indexes.ByPriority, priority);
                _hashCode =
                    $"todos.Lookup(TodoEntry.Indexes.ByPriority, Priority.{priority})\n" +
                    $"todos.CountBy(TodoEntry.Indexes.ByPriority, Priority.{priority})";
                _hashEmptyNote = "No rows at that priority.";
                break;
        }

        _hashTime = DemoSandbox.Duration(sw.Elapsed.TotalMilliseconds);
        _categorySum = DemoData.Categories.Sum(c => _todos.CountBy(TodoEntry.Indexes.Category, c));
        _nullLookupCount = _todos.Lookup(TodoEntry.Indexes.Category, null).Count();
    }

    private void CompareCounting()
    {
        if (_todos is null)
        {
            return;
        }

        var indexed = 0;
        var sw = Stopwatch.StartNew();
        for (var i = 0; i < CompareIterations; i++)
        {
            indexed = _todos.CountBy(TodoEntry.Indexes.Done, true);
        }
        var indexedMs = sw.Elapsed.TotalMilliseconds / CompareIterations;

        var scanned = 0;
        sw.Restart();
        for (var i = 0; i < CompareIterations; i++)
        {
            scanned = _todos.Scan().Count(t => t.Done);
        }
        var scanMs = sw.Elapsed.TotalMilliseconds / CompareIterations;

        _countByTime = DemoSandbox.Duration(indexedMs);
        _scanTime = DemoSandbox.Duration(scanMs);
        _compareResult = indexed;
        _compareFactor = indexedMs > 0
            ? $"the index is about {scanMs / indexedMs:0.#}× faster here, and the gap widens with row count"
            : "the indexed call is below the clock's resolution";
        _compareDone = scanned >= 0;
    }

    // --------------------------------------------------------- ordered index

    private void SetDirection(bool descending)
    {
        _descending = descending;
        RunOrdered();
    }

    private void RunOrdered()
    {
        if (_todos is null)
        {
            return;
        }

        var sw = Stopwatch.StartNew();

        if (_orderedIndex == "Effort")
        {
            var from = _fromUnbounded ? BlazeDbBound<int>.Unbounded
                : _fromExclusive ? BlazeDbBound<int>.Exclusive(_effortFrom) : BlazeDbBound<int>.At(_effortFrom);
            var to = _toUnbounded ? BlazeDbBound<int>.Unbounded
                : _toExclusive ? BlazeDbBound<int>.Exclusive(_effortTo) : BlazeDbBound<int>.At(_effortTo);

            _orderedRows = _todos.Range(TodoEntry.Indexes.Effort, from, to, _descending).ToList();
            _orderByCount = _todos.OrderBy(TodoEntry.Indexes.Effort, _descending).Count();
            _orderedCode =
                $"todos.Range(TodoEntry.Indexes.Effort,\n" +
                $"            {BoundCode("int", _fromUnbounded, _fromExclusive, _effortFrom.ToString())},\n" +
                $"            {BoundCode("int", _toUnbounded, _toExclusive, _effortTo.ToString())},\n" +
                $"            descending: {_descending.ToString().ToLowerInvariant()})";
        }
        else
        {
            var fromValue = DateTime.SpecifyKind(_dateFrom.Date, DateTimeKind.Utc);
            var toValue = DateTime.SpecifyKind(_dateTo.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc);
            var from = _fromUnbounded ? BlazeDbBound<DateTime>.Unbounded : BlazeDbBound<DateTime>.At(fromValue);
            var to = _toUnbounded ? BlazeDbBound<DateTime>.Unbounded : BlazeDbBound<DateTime>.At(toValue);

            _orderedRows = _todos.Range(TodoEntry.Indexes.CreatedAt, from, to, _descending).ToList();
            _orderByCount = _todos.OrderBy(TodoEntry.Indexes.CreatedAt, _descending).Count();
            _orderedCode =
                $"todos.Range(TodoEntry.Indexes.CreatedAt,\n" +
                $"            {(_fromUnbounded ? "BlazeDbBound<DateTime>.Unbounded" : $"new DateTime({fromValue:yyyy}, {fromValue:MM}, {fromValue:dd})")},\n" +
                $"            {(_toUnbounded ? "BlazeDbBound<DateTime>.Unbounded" : $"new DateTime({_dateTo:yyyy}, {_dateTo:MM}, {_dateTo:dd}).AddDays(1).AddTicks(-1)")}, // end of that day\n" +
                $"            descending: {_descending.ToString().ToLowerInvariant()})";
        }

        _orderedTime = DemoSandbox.Duration(sw.Elapsed.TotalMilliseconds);
    }

    private void RunInverted()
    {
        if (_todos is null)
        {
            return;
        }

        var count = _todos.Range(TodoEntry.Indexes.Effort, 200, 10).Count();
        _invertedNote = $"todos.Range(TodoEntry.Indexes.Effort, 200, 10).Count() → {count}";
    }

    // ------------------------------------------------------------- sandbox

    private void RefreshSandbox()
    {
        if (_sandboxTable is null)
        {
            return;
        }

        _sandboxCount = _sandboxTable.Count;
        _sandboxOpen = _sandboxTable.CountBy(TodoEntry.Indexes.Done, false);
        _sandboxDone = _sandboxTable.CountBy(TodoEntry.Indexes.Done, true);
        _sandboxEngine = _sandboxTable.CountBy(TodoEntry.Indexes.Category, "engine");
        _sandboxDocs = _sandboxTable.CountBy(TodoEntry.Indexes.Category, "docs");
        _sandboxCritical = _sandboxTable.CountBy(TodoEntry.Indexes.ByPriority, Priority.Critical);
    }

    private void SandboxInsert()
    {
        if (_sandboxTable is null)
        {
            return;
        }

        _sandboxTable.Insert(new TodoEntry
        {
            Id = Guid.NewGuid(),
            Title = $"sandbox row {_sandboxTable.Count + 1}",
            Category = "engine",
            Priority = Priority.Normal,
            Done = false,
            CreatedAt = DateTime.UtcNow,
            Effort = 30,
        });

        _log.Ok("Insert", "table.Insert(row)", "Added to the row store and to all three matching index buckets.");
        RefreshSandbox();
    }

    private void SandboxFlipDone() => MutateFirst(
        row => row.Done = !row.Done,
        "Update - Done flipped",
        "The row moved from one Done bucket to the other. Same key, same row store slot.");

    private void SandboxRecategorise() => MutateFirst(
        row => row.Category = row.Category == "docs" ? "engine" : "docs",
        "Update - Category changed",
        "Removed from the old Category bucket and added to the new one.");

    private void SandboxPromote() => MutateFirst(
        row => row.Priority = row.Priority == Priority.Critical ? Priority.Low : Priority.Critical,
        "Update - Priority changed",
        "ByPriority is a hash index over an enum, so this is a bucket move too.");

    private void SandboxSetNull() => MutateFirst(
        row => row.Category = null,
        "Update - Category set to null",
        "The row moved from its category's bucket to the null bucket; Lookup(Category, null) now finds it.");

    private void MutateFirst(Action<TodoEntry> mutate, string title, string note)
    {
        if (_sandboxTable is null)
        {
            return;
        }

        var first = _sandboxTable.Scan().FirstOrDefault();
        if (first is null)
        {
            return;
        }

        var updated = first.Clone();
        mutate(updated);
        _sandboxTable.Update(updated);
        _log.Ok(title, "table.Update(row)", note);
        RefreshSandbox();
    }

    private void SandboxDelete()
    {
        if (_sandboxTable is null)
        {
            return;
        }

        var first = _sandboxTable.Scan().FirstOrDefault();
        if (first is null)
        {
            return;
        }

        var removed = _sandboxTable.Delete(first.Id);
        _log.Ok(
            "Delete",
            $"table.Delete(key) → {removed.ToString().ToLowerInvariant()}",
            "Every index entry pointing at that row was removed with it.");
        RefreshSandbox();
    }

    private static string Literal(string? value) => value is null ? "null" : $"\"{value}\"";

    /// <summary>A bound as the code that builds it: Unbounded, Exclusive(v), or the bare value the implicit conversion takes.</summary>
    private static string BoundCode(string type, bool unbounded, bool exclusive, string value) =>
        unbounded ? $"BlazeDbBound<{type}>.Unbounded" : exclusive ? $"BlazeDbBound<{type}>.Exclusive({value})" : value;

    /// <summary>The prefix scan as a query source, and the plan it reports.</summary>
    private string PrefixPlan() =>
        BlazeDbQuery<int, Person>.From(_people!).UseIndexPrefix(Person.Indexes.Name, _prefix, descending: true).Explain();

    // ------------------------------------------------------------ keyset paging

    private void FirstPage()
    {
        if (_people is null)
        {
            return;
        }

        _page = _people.OrderBy(Person.Indexes.JoinedId).Take(PeoplePageSize).ToList();
        _pageCode = $"people.OrderBy(Person.Indexes.JoinedId).Take({PeoplePageSize})";
    }

    private void NextPage()
    {
        if (_people is null || _page.Count == 0)
        {
            return;
        }

        var last = _page[^1];
        _page = _people.Range(Person.Indexes.JoinedId,
                BlazeDbBound<(DateOnly, int)>.Exclusive((last.Joined, last.Id)),
                BlazeDbBound<(DateOnly, int)>.Unbounded)
            .Take(PeoplePageSize)
            .ToList();
        _pageCode =
            $"people.Range(Person.Indexes.JoinedId,\n" +
            $"    BlazeDbBound<(DateOnly, int)>.Exclusive((new DateOnly({last.Joined.Year}, {last.Joined.Month}, {last.Joined.Day}), {last.Id})),\n" +
            $"    BlazeDbBound<(DateOnly, int)>.Unbounded).Take({PeoplePageSize})";
    }

    public async ValueTask DisposeAsync()
    {
        if (_sandbox is not null)
        {
            await _sandbox.DisposeAsync();
        }
        if (_peopleDb is not null)
        {
            await _peopleDb.DisposeAsync();
        }
    }

    private const string PersonSource = """
        [BlazeDbTable("people")]
        [BlazeDbCompoundIndex("CityRole", nameof(City), nameof(Role))]              // hash over a tuple
        [BlazeDbCompoundOrderedIndex("JoinedId", nameof(Joined), nameof(Id))]       // ordered, ends unique
        public partial class Person
        {
            [BlazeDbKey] public int Id { get; set; }
            [BlazeDbIndex(Unique = true)] public string? Email { get; set; }        // unique, nulls allowed
            [BlazeDbOrderedIndex] public string Name { get; set; } = "";            // ordinal: prefix scans
            public string City { get; set; } = "";
            public string Role { get; set; } = "";
            public DateOnly Joined { get; set; }

            [BlazeDbIndex]                                                          // computed: index-only
            public string Domain => Email is { } email ? email[(email.IndexOf('@') + 1)..] : "";
        }
        """;

    private const string BoundSnippet = """
        // Both ends inclusive.
        todos.Range(index, 40, 100);

        // One end open.
        todos.Range(index, 40, BlazeDbBound<int>.Unbounded);

        // Everything, in index order.
        todos.Range(index,
                    BlazeDbBound<int>.Unbounded,
                    BlazeDbBound<int>.Unbounded);

        // Explicit form of the implicit conversion.
        todos.Range(index, BlazeDbBound<int>.At(40), BlazeDbBound<int>.At(100));

        // Reverse traversal.
        todos.Range(index, 40, 100, descending: true);

        // Exclusive ends: strictly after 40, strictly before 100 - the next page of a keyset pager.
        todos.Range(index, BlazeDbBound<int>.Exclusive(40), BlazeDbBound<int>.Exclusive(100));

        // Ordinal prefix scan, over an ordered index on a string property.
        people.StartsWith(Person.Indexes.Name, "Al");

        // A compound ordered index takes a tuple - the next keyset page.
        people.Range(Person.Indexes.JoinedId,
                     BlazeDbBound<(DateOnly, int)>.Exclusive((last.Joined, last.Id)),
                     BlazeDbBound<(DateOnly, int)>.Unbounded);
        """;
