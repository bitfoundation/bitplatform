@page "/errors"
@using Bit.BlazeDb.Browser

<PageTitle>Errors &amp; limits · BlazeDb</PageTitle>

<PageHeader Eyebrow="Errors & limits" Title="Every way BlazeDb says no"
            Lead="A database earns trust by failing predictably. Each case below is executed for real against a throwaway database and reports the exception type and message it actually produced.">
    <span class="bb-badge bd-badge-neutral">@Cases.Length executable cases</span>
    @if (_ran > 0)
    {
        <span class="@Tones.Badge(_failed == 0 ? "ok" : "err")">@(_ran - _failed)/@_ran behaved as documented</span>
    }
</PageHeader>

<Section Title="Run the failure modes"
         Lead="Nothing here is a screenshot. Each row opens its own database, provokes the failure and prints what came back.">
    <div class="bb-toolbar">
        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="RunAllAsync">
            <Icon Name="play" /> @(_busy ? "Running…" : "Run every case")
        </button>
        <button type="button" class="btn btn-secondary" disabled="@(_busy || _results.Count == 0)" @onclick="Clear">
            <Icon Name="refresh" /> Clear results
        </button>
    </div>

    @foreach (var group in Cases.GroupBy(c => c.Group))
    {
        <Panel Title="@group.Key" IconName="@GroupIcon(group.Key)" Flush="true">
            <div class="bd-cases">
                @foreach (var item in group)
                {
                    var result = _results.GetValueOrDefault(item.Id);
                    <div class="bd-case">
                        <div class="bd-case-head">
                            <div class="bd-case-what">
                                <div class="bd-case-title">@item.Title</div>
                                <code class="bd-case-api">@item.Api</code>
                            </div>
                            <div class="bd-case-side">
                                <span class="@Tones.Badge(ExpectedTone(item)) bb-mono">@item.Expected</span>
                                <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="() => RunCaseAsync(item)">
                                    <Icon Name="play" /> Run
                                </button>
                            </div>
                        </div>
                        <p class="bd-case-note">@item.Note</p>
                        @if (result is not null)
                        {
                            <div class="bd-case-result @(result.Tone == "ok" ? "bd-case-ok" : "bd-case-err")">
                                <Icon Name="@(result.Tone == "ok" ? "check" : "alert")" Size="14" />
                                <span>@result.Detail</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </Panel>
    }
</Section>

<Section Title="Things that look like errors but are not"
         Lead="Several operations that other databases treat as exceptional are ordinary return values here, because they are ordinary situations.">
    <div class="bb-flex">
        <Panel Title="Missing rows" IconName="search">
            <CodeBlock Code="@MissingSnippet" />
            <p>
                <code>Get</code> returns <code>default</code>, <code>TryGet</code> returns
                <code>false</code>, and <code>Delete</code> returns <code>false</code>. Only
                <code>Update</code> insists the row exists.
            </p>
        </Panel>
        <Panel Title="Null index keys" IconName="key">
            <CodeBlock Code="@NullIndexSnippet" />
            <p>
                A null is an index key like any other: a lookup with a null key returns the rows
                whose value is null, never an error, and a single-property unique index still allows
                any number of them. Only a bounded range excludes them, since null lies inside no interval.
            </p>
        </Panel>
        <Panel Title="Empty results" IconName="query">
            <CodeBlock Code="@EmptySnippet" />
            <p>
                A range with no matches, a lookup on an absent value and a query with an
                impossible predicate all yield an empty sequence - never null.
            </p>
        </Panel>
    </div>
</Section>

<Section Title="Handling patterns"
         Lead="Three patterns cover almost everything an application needs to do about failure.">
    <div class="bb-flex">
        <Panel Title="Open with a fallback" IconName="database" Sub="the one you must write">
            <CodeBlock Code="@OpenPatternSnippet" />
            <p>
                This site does the same, except that a locked or unavailable OPFS falls back to an
                in-memory database rather than a replica - the storage badge in the corner of the window shows which
                branch it took.
            </p>
        </Panel>
        <Panel Title="Guard a durability point" IconName="disk">
            <CodeBlock Code="@FlushPatternSnippet" />
            <p>
                A background flush failure never loses data - the bytes go back into the buffer and
                the flusher retries on its next tick. <code>db.LastBackgroundError</code> exposes the
                standing failure (and clears once a flush succeeds), and an explicit
                <code>FlushAsync</code> throws the storage error itself if it hits the same problem.
            </p>
        </Panel>
        <Panel Title="Keep memory and disk in step" IconName="txn">
            <CodeBlock Code="@TxnPatternSnippet" />
            <p>
                Rollback reverses in-memory state and index entries in reverse order and writes
                nothing to the log, so an abandoned transaction leaves no trace on either side.
            </p>
        </Panel>
    </div>

    <Callout Tone="warn" Title="One caveat worth internalising.">
        Rows are live objects, not copies. Mutating a row you fetched changes the table immediately,
        before and regardless of any <code>Update</code> call, and a rollback cannot undo it - and
        <code>Update</code> then refuses that instance if an indexed value moved. Build a new row and
        write it (the <a href="todos">CRUD page</a> does exactly that), or tell the table what the
        indexes hold with <code>UpdateInPlace</code>. <a href="writes">Every write, and what it promises</a>.
    </Callout>
</Section>

@code {
    private sealed record Case(
        string Id,
        string Group,
        string Title,
        string Api,
        string Expected,
        string Note,
        Func<Errors, Task<string>> Run);

    private sealed record Result(string Tone, string Detail);

    private readonly Dictionary<string, Result> _results = [];
    private bool _busy;
    private int _ran;
    private int _failed;

    private static readonly Case[] Cases =
    [
        new("dup", "Writes", "Inserting a key that already exists",
            "table.Insert(row)", nameof(BlazeDbDuplicateKeyException),
            "Insert refuses to overwrite. The check happens before anything reaches memory or the log, so the table is untouched.",
            static p => p.DuplicateKeyAsync()),

        new("update-missing", "Writes", "Updating a row that is not there",
            "table.Update(row)", nameof(KeyNotFoundException),
            "Update is strict on purpose: silently inserting would hide a bug in the calling code. Use Upsert when either outcome is fine.",
            static p => p.UpdateMissingAsync()),

        new("unique", "Writes", "Duplicating a unique index value",
            "table.TryInsert(row)", nameof(BlazeDbUniqueConstraintViolationException),
            "A different key, but a value a unique index already holds. TryInsert decides on the key alone, so even it throws - and the check runs before anything changes. Nulls are never duplicates.",
            static p => p.UniqueAsync()),

        new("mutated", "Writes", "Writing back a row changed in place",
            "row.Category = \"x\"; table.Update(row)", nameof(InvalidOperationException),
            "The live row's indexed value was changed on the instance the table holds, so the entry to retract is gone. Update takes a new instance; UpdateInPlace takes the values the indexes hold.",
            static p => p.MutatedInPlaceAsync()),

        new("stale", "Writes", "UpdateInPlace with stale previous values",
            "table.UpdateInPlace(row, previousValues)", nameof(BlazeDbStaleRowException),
            "The previous values no longer describe the indexes - the row was written since they were taken - so the write is refused rather than indexing the row twice. EF Core reports this as DbUpdateConcurrencyException.",
            static p => p.StaleRowAsync()),

        new("null-row", "Writes", "Storing a null row",
            "table.Insert(null)", nameof(ArgumentNullException),
            "Refused at the door with the table named, rather than as a bare null-argument error from deep inside a dictionary.",
            static p => p.NullRowAsync()),

        new("replica-write", "Writes", "Writing to a read-only replica",
            "replica.GetTable(...).Insert(row)", nameof(InvalidOperationException),
            "Writes belong to the tab holding the writer lock. A replica reloads from storage instead.",
            static p => p.ReplicaWriteAsync()),

        new("handler", "Writes", "A Changed handler that throws",
            "table.Insert(row)", nameof(BlazeDbChangeHandlerException),
            "Every subscriber still hears of the commit; the handler's exception surfaces from the write - which did commit, so it must not be retried.",
            static p => p.ChangeHandlerAsync()),

        new("delete-missing", "Writes", "Deleting a key that is not there",
            "table.Delete(key)", "returns false",
            "Deleting nothing is not a failure, so no exception is raised and no WAL record is written.",
            static p => p.DeleteMissingAsync()),

        new("unregistered", "Schema", "Asking for a table that was never registered",
            "db.GetTable(descriptor)", nameof(BlazeDbException),
            "Tables are created when the database opens. A descriptor missing from BlazeDbDatabaseOptions is a configuration mistake, caught on first access.",
            static p => p.UnregisteredTableAsync()),

        new("dup-table", "Schema", "Two tables with the same name",
            "options.AddTable(...).AddTable(...)", nameof(BlazeDbException),
            "Table names are the identity used in WAL records, so collisions are rejected while the database opens rather than during recovery.",
            static p => p.DuplicateTableNameAsync()),

        new("empty-index", "Schema", "An index with a blank name",
            "new BlazeDbHashIndexDefinition<T, TKey>(\"\", ...)", nameof(ArgumentException),
            "Index names identify the index in Lookup and Range calls, so an empty one is rejected at construction.",
            static p => p.EmptyIndexNameAsync()),

        new("foreign-index", "Schema", "Using an index that belongs to another table",
            "table.CountBy(otherIndex, value)", nameof(BlazeDbException),
            "Index definitions are matched by reference against the descriptor. A lookalike built at the call site is not the same index.",
            static p => p.ForeignIndexAsync()),

        new("nested", "Transactions", "Opening a transaction inside a transaction",
            "db.BeginTransaction()", nameof(InvalidOperationException),
            "The engine is single-writer, so there is exactly one ambient transaction. To nest a unit of work, use RunInTransaction or a savepoint, which compose inside it.",
            static p => p.NestedTransactionAsync()),

        new("reuse", "Transactions", "Committing the same transaction twice",
            "txn.Commit()", nameof(InvalidOperationException),
            "A transaction is a one-shot object. The second call cannot mean anything sensible, so it throws instead of guessing.",
            static p => p.ReuseTransactionAsync()),

        new("checkpoint", "Transactions", "Checkpointing while a transaction is open",
            "db.CheckpointAsync()", nameof(InvalidOperationException),
            "A snapshot must be a committed state. Explicit checkpoints refuse; the background checkpointer simply defers instead.",
            static p => p.CheckpointDuringTransactionAsync()),

        new("disposed", "Transactions", "Writing after the database is disposed",
            "table.Insert(row)", nameof(ObjectDisposedException),
            "Disposal flushes and stops the background loop. Later writes would never reach storage, so they are refused outright.",
            static p => p.DisposedAsync()),

        new("two-sources", "Queries", "Two index sources on one query",
            "query.UseIndex(a, ...).UseIndex(b, ...)", nameof(InvalidOperationException),
            "A query reads from exactly one source. Combining indexes is a deliberate non-feature - filter residually instead.",
            static p => p.TwoSourcesAsync()),

        new("stream", "Queries", "Writing while a stream has yielded",
            "await foreach (var r in query.ExecuteAsync())", nameof(InvalidOperationException),
            "Another handler wrote to the table between two batches, so the rest of the stream would describe neither the table as it was nor as it is. Run the query again, or materialize it first.",
            static p => p.StreamInterruptedAsync()),

        new("mutate-scan", "Queries", "Inserting while enumerating a scan",
            "foreach (var r in table.Scan()) table.Insert(...)", nameof(InvalidOperationException),
            "Scan is a lazy view over live storage, with the same rules as any dictionary enumeration. Materialise with ToList() first.",
            static p => p.MutateWhileScanningAsync()),

        new("corrupt-snapshot", "Persistence", "A snapshot with a flipped byte",
            "BlazeDbDatabase.OpenAsync(options)", nameof(BlazeDbCorruptDatabaseException),
            "Snapshots carry a CRC32 over their whole body. A single altered byte is caught before any of it is loaded.",
            static p => p.CorruptSnapshotAsync()),

        new("corrupt-manifest", "Persistence", "A manifest with a broken header",
            "BlazeDbDatabase.OpenAsync(options)", nameof(BlazeDbCorruptDatabaseException),
            "The manifest is the root of the file tree. It is validated by magic bytes, version and checksum before it is trusted.",
            static p => p.CorruptManifestAsync()),

        new("missing-snapshot", "Persistence", "A manifest pointing at a deleted snapshot",
            "BlazeDbDatabase.OpenAsync(options)", nameof(BlazeDbCorruptDatabaseException),
            "Recovery will not quietly start from an empty state when the snapshot it was promised has gone.",
            static p => p.MissingSnapshotAsync()),

        new("unknown-wal-table", "Persistence", "A log referencing a table you dropped",
            "BlazeDbDatabase.OpenAsync(options)", "opens, keeps the rows",
            "Replay names tables as strings. A table the options no longer register still opens - its rows carried as raw bytes through every checkpoint and named by db.UnregisteredTables - so dropping a type from the model loses nothing, and registering it again brings the rows back.",
            static p => p.UnknownWalTableAsync()),

        new("locked", "Persistence", "A second writer for the same browser database",
            "await BlazeDbIndexedDbStorage.CreateAsync(name)", nameof(BlazeDbDatabaseLockedException),
            "The first storage holds the database's Web Lock for as long as it lives. A second tab gets this - and opens a read-only replica, or falls back to memory.",
            static p => p.LockedAsync()),

        new("quota", "Persistence", "A flush that would not fit in the quota",
            "await db.FlushAsync()", nameof(BlazeDbStorageQuotaExceededException),
            "The engine checks the allowance before it writes, tries a checkpoint to compact, and only then refuses - deliberately, with the data still committed in memory.",
            static p => p.QuotaAsync()),

        new("wrong-key", "Persistence", "Opening an encrypted database with the wrong key",
            "BlazeDbDatabase.OpenAsync(options)", nameof(BlazeDbCorruptDatabaseException),
            "AES-GCM authenticates every frame, so a wrong key cannot decode anything - it is reported, never read as garbage.",
            static p => p.WrongKeyAsync()),

        new("bad-import", "Persistence", "Importing an altered backup",
            "BlazeDbDatabase.ImportAsync(file, storage)", nameof(BlazeDbCorruptDatabaseException),
            "An export carries a checksum, verified before anything is written to the destination.",
            static p => p.BadImportAsync()),

        new("truncated-row", "Persistence", "A row buffer that ends mid-field",
            "descriptor.RowReader(ref reader)", nameof(InvalidDataException),
            "Every read is bounds-checked. Unknown fields are skipped, but a length that overruns the buffer is damage, not evolution.",
            static p => p.TruncatedRowAsync()),
    ];

    // ------------------------------------------------------------------ runner

    private async Task RunAllAsync()
    {
        _busy = true;
        _results.Clear();
        StateHasChanged();

        try
        {
            foreach (var item in Cases)
            {
                await ExecuteAsync(item);
                StateHasChanged();
                await Task.Yield();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunCaseAsync(Case item)
    {
        _busy = true;
        StateHasChanged();
        await ExecuteAsync(item);
        _busy = false;
    }

    private async Task ExecuteAsync(Case item)
    {
        var expectsThrow = item.Expected.EndsWith("Exception", StringComparison.Ordinal);

        try
        {
            var detail = await item.Run(this);
            _results[item.Id] = expectsThrow
                ? new Result("err", $"No exception was raised. {detail}")
                : new Result("ok", detail);
        }
        catch (Exception ex)
        {
            var matched = expectsThrow && ex.GetType().Name == item.Expected;
            _results[item.Id] = new Result(matched ? "ok" : "err", $"{ex.GetType().Name}: {ex.Message}");
        }

        Recount();
    }

    private void Recount()
    {
        _ran = _results.Count;
        _failed = _results.Values.Count(r => r.Tone != "ok");
    }

    private void Clear()
    {
        _results.Clear();
        Recount();
    }

    // ------------------------------------------------------------------- cases

    private async Task<string> DuplicateKeyAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);
        var id = Guid.NewGuid();

        table.Insert(new TodoEntry { Id = id, Title = "first" });
        table.Insert(new TodoEntry { Id = id, Title = "second" });

        return $"Table holds {table.Count} rows.";
    }

    private async Task<string> UniqueAsync()
    {
        await using var db = await BlazeDbDatabase.OpenAsync(new BlazeDbDatabaseOptions().AddTable(Person.Table));
        var people = db.GetTable(Person.Table);
        people.Insert(new Person { Id = 1, Name = "Ada", Email = "ada@analytical.org" });

        people.TryInsert(new Person { Id = 2, Name = "Impostor", Email = "ada@analytical.org" });
        return "TryInsert accepted a duplicate email.";
    }

    private async Task<string> MutatedInPlaceAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);
        var id = Guid.NewGuid();
        table.Insert(new TodoEntry { Id = id, Title = "live", Category = "engine" });

        var row = table.Get(id)!;
        row.Category = "docs";
        table.Update(row);
        return "Update accepted the mutated instance.";
    }

    private async Task<string> StaleRowAsync()
    {
        await using var db = await BlazeDbDatabase.OpenAsync(new BlazeDbDatabaseOptions().AddTable(Person.Table));
        var people = db.GetTable(Person.Table);
        people.Insert(new Person { Id = 1, Name = "Ada", City = "London", Role = "engineer" });

        var row = people.Get(1)!;
        var first = row.With(_ => { });
        var second = row.With(_ => { });
        row.City = "Paris";
        people.UpdateInPlace(row, first);
        row.Role = "researcher";
        people.UpdateInPlace(row, second);
        return "UpdateInPlace accepted values the indexes no longer hold.";
    }

    private async Task<string> NullRowAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        db.GetTable(TodoEntry.Table).Insert(null!);
        return "A null row was stored.";
    }

    private async Task<string> ReplicaWriteAsync()
    {
        var storage = new BlazeDbInMemoryStorage();
        await using (var writer = await DemoSandbox.OpenAsync(storage))
        {
            await writer.CheckpointAsync();
        }

        var options = DemoSandbox.BuildOptions(storage);
        options.ReadOnly = true;
        await using var replica = await BlazeDbDatabase.OpenAsync(options);
        replica.GetTable(TodoEntry.Table).Insert(new TodoEntry { Id = Guid.NewGuid(), Title = "from a replica" });
        return "The replica accepted a write.";
    }

    private async Task<string> ChangeHandlerAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);
        table.Changed += (_, _) => throw new InvalidOperationException("a subscriber with a bug");

        table.Insert(new TodoEntry { Id = Guid.NewGuid(), Title = "committed anyway" });
        return "The write reported no handler failure.";
    }

    private async Task<string> StreamInterruptedAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);
        DemoData.SeedForBench(db, table, 2_000, out _);

        _ = WriteSoonAsync(table);
        var seen = 0;
        await foreach (var _ in BlazeDbQuery<Guid, TodoEntry>.From(table).ExecuteAsync(batchSize: 100))
        {
            seen++;
        }
        return $"Streamed all {seen} rows.";

        static async Task WriteSoonAsync(BlazeDbTable<Guid, TodoEntry> target)
        {
            await Task.Yield();
            target.Insert(new TodoEntry { Id = Guid.NewGuid(), Title = "written between two batches" });
        }
    }

    private async Task<string> LockedAsync()
    {
        const string name = "blazedb-errors-lock";
        using var first = await BlazeDbIndexedDbStorage.CreateAsync(name);
        using var second = await BlazeDbIndexedDbStorage.CreateAsync(name);
        return "Two storages hold the same writer lock.";
    }

    private async Task<string> QuotaAsync()
    {
        var storage = new QuotaLimitedStorage(quotaBytes: 16 * 1024);
        var options = DemoSandbox.BuildOptions(storage, flushInterval: TimeSpan.FromHours(1));
        options.QuotaReserveBytes = 1024;
        var db = await BlazeDbDatabase.OpenAsync(options);
        try
        {
            DemoData.Seed(db, db.GetTable(TodoEntry.Table), count: 300);
            await db.FlushAsync();
            return "The flush fit.";
        }
        finally
        {
            storage.QuotaBytes = long.MaxValue / 4;   // let the closing flush through
            await db.DisposeAsync();
        }
    }

    private async Task<string> WrongKeyAsync()
    {
        var inner = new BlazeDbInMemoryStorage();
        var salt = new byte[16];
        using (var storage = new BlazeDbEncryptedStorage(inner, await BlazeDbWebCryptoCipher.CreateAsync(BlazeDbEncryptedStorage.DeriveKey("right", salt, iterations: 1_000)), ownsCipher: true))
        await using (var db = await DemoSandbox.OpenAsync(storage))
        {
            DemoData.Seed(db, db.GetTable(TodoEntry.Table), count: 3);
        }

        using var wrong = new BlazeDbEncryptedStorage(inner, await BlazeDbWebCryptoCipher.CreateAsync(BlazeDbEncryptedStorage.DeriveKey("wrong", salt, iterations: 1_000)), ownsCipher: true);
        await using var reopened = await DemoSandbox.OpenAsync(wrong);
        return $"Opened with the wrong key: {reopened.GetTable(TodoEntry.Table).Count} rows.";
    }

    private async Task<string> BadImportAsync()
    {
        using var file = new MemoryStream();
        await using (var db = await DemoSandbox.OpenAsync())
        {
            DemoData.Seed(db, db.GetTable(TodoEntry.Table), count: 5);
            await db.ExportAsync(file);
        }

        var bytes = file.ToArray();
        bytes[bytes.Length / 2] ^= 0xFF;
        await BlazeDbDatabase.ImportAsync(new MemoryStream(bytes), new BlazeDbInMemoryStorage());
        return "The altered file was imported.";
    }

    private async Task<string> UpdateMissingAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);

        table.Update(new TodoEntry { Id = Guid.NewGuid(), Title = "never inserted" });

        return "Update succeeded.";
    }

    private async Task<string> DeleteMissingAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);

        var deleted = table.Delete(Guid.NewGuid());

        return $"Delete returned {deleted.ToString().ToLowerInvariant()}; the table still holds {table.Count} rows and nothing was logged.";
    }

    private async Task<string> UnregisteredTableAsync()
    {
        var options = new BlazeDbDatabaseOptions().AddTable(TodoEntry.Table);
        await using var db = await BlazeDbDatabase.OpenAsync(options);

        db.GetTable(MetricTable.Descriptor);

        return "GetTable returned a table.";
    }

    private async Task<string> DuplicateTableNameAsync()
    {
        var options = new BlazeDbDatabaseOptions()
            .AddTable(TodoEntry.Table)
            .AddTable(TodoEntry.Table);

        await using var db = await BlazeDbDatabase.OpenAsync(options);
        return "The database opened with a duplicate table.";
    }

    private Task<string> EmptyIndexNameAsync()
    {
        var index = new BlazeDbHashIndexDefinition<TodoEntry, bool>("", static r => r.Done);
        return Task.FromResult($"Created an index named '{index.Name}'.");
    }

    private async Task<string> ForeignIndexAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);

        // Same name, same selector, different object - the descriptor never saw it.
        var lookalike = new BlazeDbHashIndexDefinition<TodoEntry, bool>("Done", static r => r.Done);
        var count = table.CountBy(lookalike, true);

        return $"CountBy returned {count}.";
    }

    private async Task<string> NestedTransactionAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();

        using var outer = db.BeginTransaction();
        using var inner = db.BeginTransaction();

        return "Both transactions started.";
    }

    private async Task<string> ReuseTransactionAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);

        using var txn = db.BeginTransaction();
        table.Insert(new TodoEntry { Id = Guid.NewGuid(), Title = "committed once" });
        txn.Commit();
        txn.Commit();

        return "The transaction committed twice.";
    }

    private async Task<string> CheckpointDuringTransactionAsync()
    {
        await using var db = await DemoSandbox.OpenAsync(new BlazeDbInMemoryStorage());
        var table = db.GetTable(TodoEntry.Table);

        using var txn = db.BeginTransaction();
        table.Insert(new TodoEntry { Id = Guid.NewGuid(), Title = "uncommitted" });
        await db.CheckpointAsync();

        return "The checkpoint completed mid-transaction.";
    }

    private async Task<string> DisposedAsync()
    {
        var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);
        await db.DisposeAsync();

        table.Insert(new TodoEntry { Id = Guid.NewGuid(), Title = "after disposal" });

        return "The write was accepted.";
    }

    private async Task<string> TwoSourcesAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);

        var query = BlazeDbQuery<Guid, TodoEntry>.From(table)
            .UseIndex(TodoEntry.Indexes.Done, true)
            .UseIndex(TodoEntry.Indexes.Effort, BlazeDbBound<int>.At(0), BlazeDbBound<int>.Unbounded);

        return $"The query built with two sources and returned {query.Count()} rows.";
    }

    private async Task<string> MutateWhileScanningAsync()
    {
        await using var db = await DemoSandbox.OpenAsync();
        var table = db.GetTable(TodoEntry.Table);
        DemoData.Seed(db, table, count: 8);

        var seen = 0;
        foreach (var row in table.Scan())
        {
            if (seen++ == 0)
            {
                table.Insert(new TodoEntry { Id = Guid.NewGuid(), Title = "added mid-scan" });
            }
        }

        return $"Enumerated {seen} rows without complaint.";
    }

    private async Task<string> CorruptSnapshotAsync()
    {
        var storage = new BlazeDbInMemoryStorage();
        await using (var db = await DemoSandbox.OpenAsync(storage))
        {
            DemoData.Seed(db, db.GetTable(TodoEntry.Table), count: 6);
            await db.CheckpointAsync();
        }

        var name = storage.FileNames.First(f => f.StartsWith("snapshot-", StringComparison.Ordinal));
        var bytes = storage.GetFile(name)!;
        bytes[bytes.Length / 2] ^= 0xFF;
        storage.SetFile(name, bytes);

        await using var reopened = await DemoSandbox.OpenAsync(storage);
        return $"Reopened with {reopened.GetTable(TodoEntry.Table).Count} rows.";
    }

