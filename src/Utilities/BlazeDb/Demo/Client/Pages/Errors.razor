    private async Task<string> UnknownWalTableAsync()
    {
        var storage = new BlazeDbInMemoryStorage();
        await using (var db = await DemoSandbox.OpenAsync(storage))
        {
            db.GetTable(Setting.Table).Insert(new Setting
            {
                Name = "demo.flag",
                Value = "on",
                UpdatedAt = DateTime.UtcNow,
            });
            await db.FlushAsync();
        }

        // The log still names "settings", but this schema no longer has it.
        var narrowed = new BlazeDbDatabaseOptions { Storage = storage }.AddTable(TodoEntry.Table);
        string unregistered;
        await using (var reopened = await BlazeDbDatabase.OpenAsync(narrowed))
        {
            unregistered = string.Join(", ", reopened.UnregisteredTables);

            // The snapshot is written from this narrower schema, the table it does not know included.
            await reopened.CheckpointAsync();
        }

        await using var restored = await DemoSandbox.OpenAsync(storage);
        var flag = restored.GetTable(Setting.Table).Get("demo.flag")
            ?? throw new InvalidOperationException("The dropped table's row did not survive a checkpoint taken without it.");

        return $"db.UnregisteredTables → [{unregistered}]. Checkpointed without the table, then reopened with it registered again: settings.Get(\"demo.flag\").Value → \"{flag.Value}\".";
    }

    private Task<string> TruncatedRowAsync()
    {
        var writer = new BlazeDbBufferWriter();
        TodoEntry.Table.RowWriter(writer, new TodoEntry
        {
            Id = Guid.NewGuid(),
            Title = "a row whose final field gets clipped",
            Notes = "with notes attached",
            Payload = [1, 2, 3, 4, 5, 6, 7, 8],
        });

        // The last field written is the length-delimited payload; drop its tail so the
        // declared length overruns what is actually there.
        var full = writer.ToArray();
        var reader = new BlazeDbBufferReader(full.AsSpan(0, full.Length - 3));
        var row = TodoEntry.Table.RowReader(ref reader);

        return Task.FromResult($"Decoded a clipped buffer into Title = \"{row.Title}\".");
    }

