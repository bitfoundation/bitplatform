    private const string OpenPatternSnippet = """
        try
        {
            options.Storage = await BlazeDbOpfsStorage.CreateAsync("mydb");
        }
        catch (BlazeDbDatabaseLockedException)
        {
            // Another tab owns the write lock: open a read-only replica, or wait.
            options.Storage = await BlazeDbOpfsStorage.CreateReadOnlyAsync("mydb");
            options.ReadOnly = options.Storage is not null;
        }

        try
        {
            return await BlazeDbDatabase.OpenAsync(options);
        }
        catch (BlazeDbCorruptDatabaseException ex)
        {
            logger.LogError(ex, "Unreadable database; starting fresh.");
            options.Storage = new BlazeDbInMemoryStorage();
            return await BlazeDbDatabase.OpenAsync(options);
        }
        """;

    private const string FlushPatternSnippet = """
        try
        {
            await db.FlushAsync();
        }
        catch (BlazeDbStorageQuotaExceededException ex)
        {
            ShowStorageFullWarning(ex.Quota);   // data is safe in memory; free space, retry
        }
        catch (Exception ex)
        {
            // Storage rejected the append - permissions, a closed handle. Buffered
            // bytes were put back, so a later flush can still succeed.
            ShowUnsavedWarning(ex);
        }

        // Or, without forcing a flush, watch the background flusher:
        if (db.LastBackgroundError is { } standing) ShowUnsavedWarning(standing);
        """;

