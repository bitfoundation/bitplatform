@page "/hosting"
@using System.Runtime.InteropServices
@inject DemoDbService Db

<PageTitle>Hosting models · BlazeDb</PageTitle>

<PageHeader Eyebrow="Hosting models" Title="Where a database can live"
            Lead="Two facts decide it: the browser backends need the WebAssembly runtime, and the engine assumes one logical writer with no concurrent readers. Everything else - the tables, the queries, the EF Core provider - is the same wherever it runs.">
    <span class="bb-badge bd-badge-neutral">@(OperatingSystem.IsBrowser() ? "This page: in the browser" : "This page: outside the browser")</span>
    <span class="bb-badge bd-badge-neutral">@RendererInfo.Name, @(RendererInfo.IsInteractive ? "interactive" : "static")</span>
</PageHeader>

