<Section Title="Blazor WebAssembly"
         Lead="The model the engine is designed for. The database lives in the tab, in managed memory, persisted to OPFS. Open it once per tab and share it.">
    <div class="bb-split">
        <CodeBlock Title="AppDatabase.cs" Code="@WasmSnippet" />
        <Panel Title="This tab's database" IconName="database">
            <dl class="bb-params">
                <dt>Opened by</dt>
                <dd>DemoDbService, a singleton</dd>
                <dt>Backend</dt>
                <dd>@(Db.IsOpen ? Db.StorageLabel : "not opened yet")</dd>
                <dt>OperatingSystem.IsBrowser()</dt>
                <dd>@OperatingSystem.IsBrowser().ToString().ToLowerInvariant()</dd>
                <dt>Process architecture</dt>
                <dd>@RuntimeInformation.ProcessArchitecture</dd>
                <dt>Current managed thread</dt>
                <dd>@Environment.CurrentManagedThreadId</dd>
            </dl>
            <p class="bd-foot">
                Every page of this site asks the same singleton for the database, so they all share one instance - and
                one writer lock. The database does not own its storage: dispose the storage after the database, which
                is what releases the lock for the next tab.
            </p>
        </Panel>
    </div>
</Section>

<Section Title="Blazor Web App"
         Lead="The database still lives in the browser, so the code that opens it belongs in the .Client project. What changes is prerendering: a prerendered component runs on the server first, where there is no OPFS, no IndexedDB and no Web Locks.">
    <div class="bb-split">
        <CodeBlock Title="Either: no prerendering where the database is used" Code="@NoPrerenderSnippet" />
        <CodeBlock Title="Or: open it only once the component runs in the browser" Code="@AfterRenderSnippet" />
    </div>
    <Callout Tone="warn" Title="The browser backends throw outside the browser.">
        Every type in <code>Bit.BlazeDb.Browser</code> is <code>[SupportedOSPlatform("browser")]</code> - the rest of the
        engine is not. Under <code>InteractiveAuto</code> the same applies to the first visit, which renders on the server
        while the runtime downloads. This site turns prerendering off for the whole app, since every one of its pages
        opens the database.
    </Callout>
</Section>

<Section Title="Blazor Server and ASP.NET Core"
         Lead="The engine runs in the server process and persists through BlazeDbFileStorage. Every circuit and every request runs on its own thread, which the engine does not guard against.">
    <div class="bb-split">
        <CodeBlock Title="One database, one lock around every use" Code="@ServerSnippet" />
        <div class="bb-flex">
            <Callout Tone="err" Title="Not a multi-user database server.">
                Serialize all access to a shared database yourself, or give each user a database of their own in a
                directory of their own. For a store many users write at once, a database server is the right tool;
                BlazeDb is the local store of one user's application.
            </Callout>
            <Panel Title="Files on the desktop" IconName="disk">
                <p>
                    <code>BlazeDbFileStorage</code> takes an exclusive lock on its directory for as long as it lives - the
                    same single-writer guarantee the browser gets from Web Locks - so a second writer on the same directory
                    gets <code>BlazeDbDatabaseLockedException</code>. Dispose it when the database is closed.
                    <code>BlazeDbFileStorage.OpenReadOnly(directory)</code> opens the same directory for a follower that only
                    reads, and returns <code>null</code> when there is nothing there yet.
                    <code>BlazeDbDatabase.DeleteAsync(storage)</code> removes a database from any backend.
                </p>
            </Panel>
        </div>
    </div>
</Section>

<Section Title="Blazor Hybrid and desktop"
         Lead="MAUI, WPF and Windows Forms apps run .NET in-process, so the browser backends do not apply even though the UI is rendered in a WebView.">
    <div class="bb-split">
        <CodeBlock Title="MauiProgram.cs and AppDatabase.cs" Code="@HybridSnippet" />
        <Panel Title="Tools and tests" IconName="cpu">
            <p>
                Persist through <code>BlazeDbFileStorage</code> in the app's data directory (<code>FileSystem.AppDataDirectory</code>
                on MAUI), opened once for the app's lifetime and disposed when it closes. Components render on the UI
                thread, which serializes their access; marshal work from background threads back to it.
            </p>
            <p>
                Console tools and tests use <code>BlazeDbFileStorage</code> or <code>BlazeDbInMemoryStorage</code> - or no
                storage at all. In-memory storage is what makes crash and corruption scenarios reproducible: the
                <a href="durability">durability page</a> runs on it.
            </p>
        </Panel>
    </div>
</Section>

<Section Title="Lazy loading on WebAssembly" Id="lazy-loading"
         Lead="BlazeDb registers no services and each browser backend imports its module the first time it is used, so a WebAssembly app that is not compiled ahead of time can fetch the engine only when someone opens a part of the app that uses the database.">
    <div class="bb-split">
        <CodeBlock Title="The browser project's .csproj" Language="xml" Code="@LazyProjectSnippet" />
        <CodeBlock Title="App.razor, or a Web App client's Routes.razor" Language="razor" Code="@LazyRouterSnippet" />
    </div>
    <div class="bb-split">
        <CodeBlock Title="AppDatabase.cs, still registered in Program.cs" Code="@LazyServiceSnippet" />
        <Panel Title="What may run before the assembly is there" IconName="info">
            <ul class="bb-detail-list">
                <li><strong>Table types, yes.</strong> The code the generator adds keeps the engine's types out of a <code>[BlazeDbTable]</code> type's fields, so a layout every page shares can create one and read its properties. Only <code>Table</code> and <code>Indexes</code> need the assembly, and serializing one with System.Text.Json does too: it reads the BlazeDb attributes.</li>
                <li><strong>Engine code behind a check, no.</strong> The interpreter compiles a whole method the first time it is called and loads every type it names, so a layout every page shares cannot use the database even in a branch that never runs on the other pages.</li>
                <li><strong>A field of an engine type, no.</strong> Registering a service in <code>Program.cs</code> lays it out, and a field whose type cannot be loaded yet fails the app as it starts - hence the nested <code>Opened</code> class. Its methods may take and return the engine's types, and the pages the assembly is loaded for may keep them in fields.</li>
                <li><strong>A public type deriving from or implementing one of the engine's, no.</strong> The router reads the app's public types at startup: make an <code>IBlazeDbStorage</code> wrapper of your own <code>internal</code>, or lazy load it with Bit.BlazeDb.</li>
                <li><strong>EF Core.</strong> Lazy load <code>Bit.BlazeDb.EntityFrameworkCore.wasm</code> in the same call. <code>AddDbContext</code> with <code>UseBlazeDb()</code> can stay in <code>Program.cs</code>; a persistent store takes the opened database, <code>UseBlazeDb(await Database.GetAsync())</code>, as this site's <a href="efcore">EF Core page</a> does.</li>
            </ul>
        </Panel>
    </div>
    <Callout Tone="warn" Title="A failed attempt is final.">
        Once the runtime has tried to load Bit.BlazeDb before it was there - even in code that caught the exception - it
        does not try again, and the pages that use the database fail after the assembly has loaded too. In a Blazor Web App
        give <code>Routes</code> the <code>InteractiveWebAssembly</code> render mode so the router loads it in the browser,
        and register <code>LazyAssemblyLoader</code> in the server's <code>Program.cs</code> for the prerender. Under
        <code>InteractiveAuto</code> the first visit runs the router in a server circuit, which loads nothing in the
        browser. Do not lazy load in an AOT build: AOT compiles every assembly into <code>dotnet.native.wasm</code>.
    </Callout>
</Section>

<Section Title="The threading model"
         Lead="BlazeDb is built for Blazor WebAssembly, which has one thread, and its guarantees are those of a single logical writer with no concurrent readers.">
    <div class="bb-grid">
        <div class="bb-card">
            <h4 class="bb-card-title">Writes take a lock</h4>
            <p class="bb-card-desc">Writes are serialized, so the background flusher can snapshot consistently and two writers on different threads cannot both find a key free.</p>
        </div>
        <div class="bb-card">
            <h4 class="bb-card-title">Reads take none</h4>
            <p class="bb-card-desc"><code>Get</code>, <code>Scan</code>, every index lookup and every LINQ query through EF Core read the live dictionaries directly - on the platform the engine is designed for there is nothing to lock against. A read that overlaps a write on another thread is a data race, and may throw or return garbage.</p>
        </div>
        <div class="bb-card">
            <h4 class="bb-card-title">Notifications run on the committing thread</h4>
            <p class="bb-card-desc"><code>Changed</code> handlers and live queries run on the thread that committed, so a component hands its re-render to the renderer with <code>InvokeAsync(StateHasChanged)</code>. Each thread delivers its own commits.</p>
        </div>
        <div class="bb-card">
            <h4 class="bb-card-title">Outside the browser, serialize</h4>
            <p class="bb-card-desc">On ASP.NET Core or Blazor Server, <code>UseBlazeDb</code> shares one engine between every context of a type, and requests run on different threads: that is supported only when the application serializes all access itself.</p>
        </div>
    </div>
    <div class="bb-try">
        <a href="changes" class="btn btn-outline">Changed events and live queries →</a>
        <a href="efcore" class="btn btn-outline">The EF Core provider →</a>
    </div>
</Section>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Db.GetDatabaseAsync();
        }
        catch
        {
            // The panel says "not opened yet"; the other pages report why.
        }
    }

    private const string WasmSnippet = """
        public sealed class AppDatabase : IAsyncDisposable
        {
            private Task<BlazeDbDatabase>? _opening;
            private BlazeDbOpfsStorage? _storage;

            public Task<BlazeDbDatabase> GetAsync() => _opening ??= OpenAsync();

            private async Task<BlazeDbDatabase> OpenAsync()
            {
                _storage = await BlazeDbOpfsStorage.CreateAsync("app"); // takes this tab's writer lock
                return await BlazeDbDatabase.OpenAsync(new BlazeDbDatabaseOptions { Storage = _storage }.AddTable(TodoItem.Table));
            }

            public async ValueTask DisposeAsync()
            {
                if (_opening is not null) await (await _opening).DisposeAsync(); // flushes what is still pending
                _storage?.Dispose();                                             // and only then releases the lock
            }
        }

        // Program.cs
        builder.Services.AddSingleton<AppDatabase>();
        """;

    private const string NoPrerenderSnippet = """
        @* App.razor - what this site does, for every page *@
        <Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />

        @* or per page *@
        @rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
        """;

    private const string AfterRenderSnippet = """
        @inject AppDatabase Database

        @if (_todos is null)
        {
            <p>Loading…</p>   @* what the prerender, and the server-rendered Auto visit, show *@
        }

        @code {
            private List<TodoItem>? _todos;

            protected override async Task OnAfterRenderAsync(bool firstRender)
            {
                if (firstRender && OperatingSystem.IsBrowser())
                {
                    var db = await Database.GetAsync();
                    _todos = db.GetTable(TodoItem.Table).Lookup(TodoItem.Indexes.Done, false).ToList();
                    StateHasChanged();
                }
            }
        }
        """;

    private const string LazyProjectSnippet = """
        <ItemGroup>
          <BlazorWebAssemblyLazyLoad Include="Bit.BlazeDb.wasm" />
        </ItemGroup>
        """;

    private const string LazyRouterSnippet = """
        @using Microsoft.AspNetCore.Components.WebAssembly.Services
        @inject LazyAssemblyLoader LazyAssemblyLoader

        <Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="OnNavigateAsync">
            ...
        </Router>

        @code {
            private async Task OnNavigateAsync(NavigationContext context)
            {
                // The pages that use the database: fetch BlazeDb before they render.
                var path = context.Path.Split('?', '#')[0]; // the path keeps the query string
                if (path.Equals("todos", StringComparison.OrdinalIgnoreCase) || path.StartsWith("todos/", StringComparison.OrdinalIgnoreCase))
                    await LazyAssemblyLoader.LoadAssembliesAsync(["Bit.BlazeDb.wasm"]);
            }
        }
        """;

    private const string LazyServiceSnippet = """
        public sealed class AppDatabase : IAsyncDisposable
        {
            private Opened? _opened;   // not a Task<BlazeDbDatabase>: Program.cs names AppDatabase first

            public Task<BlazeDbDatabase> GetAsync()
            {
                if (_opened is null || _opened.Failed) _opened = new Opened(); // a failed open is tried again
                return _opened.Database;
            }

            public async ValueTask DisposeAsync()
            {
                if (_opened is { Failed: false }) await _opened.DisposeAsync();
            }

            // The engine's types live here, laid out only once a page asks for the database.
            private sealed class Opened : IAsyncDisposable
            {
                private BlazeDbOpfsStorage? _storage;

                public Opened() => Database = OpenAsync();

                public Task<BlazeDbDatabase> Database { get; }

                public bool Failed => Database.IsFaulted || Database.IsCanceled;

                private async Task<BlazeDbDatabase> OpenAsync()
                {
                    _storage = await BlazeDbOpfsStorage.CreateAsync("app");
                    try
                    {
                        return await BlazeDbDatabase.OpenAsync(new BlazeDbDatabaseOptions { Storage = _storage }.AddTable(TodoItem.Table));
                    }
                    catch
                    {
                        _storage.Dispose();   // releases the lock, for the next attempt or tab
                        throw;
                    }
                }

                public async ValueTask DisposeAsync()
                {
                    try
                    {
                        await (await Database).DisposeAsync();
                    }
                    finally
                    {
                        _storage?.Dispose();
                    }
                }
            }
        }
        """;

    private const string ServerSnippet = """
        public sealed class AppDatabase(IWebHostEnvironment environment) : IAsyncDisposable
        {
            private readonly SemaphoreSlim _gate = new(1, 1);
            private BlazeDbFileStorage? _storage;
            private BlazeDbDatabase? _db;

            public async Task<T> UseAsync<T>(Func<BlazeDbDatabase, T> work)
            {
                await _gate.WaitAsync();
                try
                {
                    _db ??= await OpenAsync();
                    return work(_db);   // copy what you render out of the lock: ToList()
                }
                finally
                {
                    _gate.Release();
                }
            }

            private async Task<BlazeDbDatabase> OpenAsync()
            {
                _storage = new BlazeDbFileStorage(Path.Combine(environment.ContentRootPath, "App_Data", "db"));
                return await BlazeDbDatabase.OpenAsync(new BlazeDbDatabaseOptions { Storage = _storage }.AddTable(TodoItem.Table));
            }

            public async ValueTask DisposeAsync()
            {
                if (_db is not null) await _db.DisposeAsync();   // flushes what is still pending
                _storage?.Dispose();                              // releases the directory lock
            }
        }
        """;

    private const string HybridSnippet = """
        // MauiProgram.cs (or the WPF / Windows Forms host)
        builder.Services.AddMauiBlazorWebView();
        builder.Services.AddSingleton(_ => new BlazeDbFileStorage(Path.Combine(FileSystem.AppDataDirectory, "db")));
        builder.Services.AddSingleton<AppDatabase>();

        // Data/AppDatabase.cs
        public sealed class AppDatabase(BlazeDbFileStorage storage) : IAsyncDisposable
        {
            private Task<BlazeDbDatabase>? _opening;

            public Task<BlazeDbDatabase> GetAsync() => _opening ??=
                BlazeDbDatabase.OpenAsync(new BlazeDbDatabaseOptions { Storage = storage }.AddTable(TodoItem.Table)).AsTask();

            public async ValueTask DisposeAsync()
            {
                if (_opening is not null) await (await _opening).DisposeAsync();
            }
        }
        // The container disposes the storage after the service that depends on it: the lock goes last.
        """;
}
