            <a href="todos" class="btn btn-secondary bb-btn-lg">Open the live app</a>
        </div>
    </section>
</div>

@code {
    private string _title = "";
    private string _lastInsert = "-";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Db.GetDatabaseAsync();
        }
        catch (Exception ex)
        {
            _error = $"The database could not be opened: {ex.Message}";
        }
    }

    private void Insert()
    {
        if (!Db.IsOpen || string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        var sw = System.Diagnostics.Stopwatch.StartNew();
        Db.Todos.Insert(new TodoEntry { Id = Guid.NewGuid(), Title = _title.Trim(), CreatedAt = DateTime.UtcNow });
        _lastInsert = DemoSandbox.Duration(sw.Elapsed.TotalMilliseconds);
        _title = "";
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Insert();
        }
    }
}
