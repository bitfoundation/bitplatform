<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>Bit.BlazeDb</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <Description>Memory-first, SQL-free embedded database engine for .NET, designed for Blazor WebAssembly: live rows in managed memory, source-generated serializers and indexes, atomic transactions, and WAL/snapshot persistence with no SQL and no JS interop on the read path. Add Bit.BlazeDb.Generators next to it for the source generator.</Description>
        <PackageTags>$(PackageTags);Blazor;WebAssembly;Database;Embedded;NoSQL;AOT;OPFS;IndexedDB</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- The EF Core provider works with tables whose key and row types it only knows at runtime,
             so it reaches for the boxed index accessors rather than the generic public API. -->
        <InternalsVisibleTo Include="Bit.BlazeDb.EntityFrameworkCore" PublicKey="" />
        <InternalsVisibleTo Include="Bit.BlazeDb.EntityFrameworkCore" PublicKey="" />
        <!-- The checksum and the opaque-table carrier are tested directly. -->
        <InternalsVisibleTo Include="Bit.BlazeDb.Tests" PublicKey="" />
    </ItemGroup>

</Project>
