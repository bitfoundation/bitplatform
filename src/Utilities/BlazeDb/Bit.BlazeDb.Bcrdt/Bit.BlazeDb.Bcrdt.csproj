<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.BlazeDb.Bcrdt</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
        <Description>Keeps Bit.Bcrdt collaborative documents in a Bit.BlazeDb database: an IBcrdtDocumentStore whose appends are journaled by BlazeDb's write-ahead log and whose compactions are single transactions, so offline edits survive restarts alongside the application's other data, encrypted and backed up with it.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;WebAssembly;Database;CRDT;Collaboration;Offline</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.BlazeDb\Bit.BlazeDb.csproj" />
        <ProjectReference Include="..\..\Bcrdt\Bit.Bcrdt\Bit.Bcrdt.csproj" />
        <!-- The record table is a [BlazeDbTable] type of this assembly, so the generator runs here. A consumer gets it
             through the Bit.BlazeDb package, which carries it. -->
        <ProjectReference Include="..\Bit.BlazeDb.Generators\Bit.BlazeDb.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
