<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>Bit.BevTools</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Builds on Bit.BevTools, which is not trim-safe (see Bit.BevTools.csproj). -->
        <IsTrimmable>false</IsTrimmable>
        <IsAotCompatible>false</IsAotCompatible>
        <PackageDescription>Blazor Server (interactive server / circuits) instrumentation for bit BevTools: circuit lifecycle, connection state, inbound activity and an active circuit overview.</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;devtools;diagnostics;circuit</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.BevTools\Bit.BevTools.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.BevTools.Tests" PublicKey="" />
    </ItemGroup>

</Project>
