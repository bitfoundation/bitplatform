<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- The repo's global.json mandates the Microsoft.Testing.Platform runner. EnableMSTestRunner
             builds that test host into the assembly itself, and it only generates the entry point for
             an executable project. -->
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <!-- Playwright itself, without a per-framework integration package: the suite manages the
             browser, the contexts and the sample host from its own infrastructure. -->
        <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
        <PackageReference Include="MSTest" Version="4.5.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- The lazy loading harness every lazy-loadable library shares (src/Utilities/Shared/LazyLoading.md). -->
        <Compile Include="..\..\..\Shared\Tests\E2E\*.cs" LinkBase="Shared" />
    </ItemGroup>

    <!-- Deliberately no ProjectReference to the sample. The suite boots Bit.BevTools.Samples.Lazy from its publish
         output as a separate process (Shared/LazyLoadingSample.cs), so publish it first, in the configuration the
         tests run in: only a publish trims the WebAssembly client and writes the lazy mark into its boot
         configuration. A reference would also make this project build the library and the client a second time,
         into the same obj folders, on every test build. -->

</Project>
