<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>preview</LangVersion>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- ASP0006: the scale fixtures generate repeated siblings on purpose, so their sequence numbers are computed.
             BL0006: the leak tests run on a renderer of their own, which is a RenderTree type, so that no test framework
             holds the components they check. -->
        <NoWarn>$(NoWarn);CS1591;ASP0006;BL0006</NoWarn>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\..\..\AssemblyOriginatorKeyFile.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.5.2" />
        <PackageReference Include="bunit" Version="2.15.2" />
        <!-- DbCommandsTests: what Entity Framework Core really logs for its commands, against an in-memory SQLite database. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.BevTools\Bit.BevTools.csproj" />
        <ProjectReference Include="..\..\Bit.BevTools.Loader\Bit.BevTools.Loader.csproj" />
        <ProjectReference Include="..\..\Bit.BevTools.Server\Bit.BevTools.Server.csproj" />
        <ProjectReference Include="..\..\Bit.BevTools.Cli\Bit.BevTools.Cli.csproj" />
        <ProjectReference Include="..\..\Bit.BevTools.Blex\Bit.BevTools.Blex.csproj" />
        <ProjectReference Include="..\..\Bit.BevTools.Belemetry\Bit.BevTools.Belemetry.csproj" />
        <!-- BlexIntegrationTests define a Blex store the way an app does: through Blex's source generator. -->
        <ProjectReference Include="..\..\..\Blex\Bit.Blex.Generators\Bit.Blex.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
