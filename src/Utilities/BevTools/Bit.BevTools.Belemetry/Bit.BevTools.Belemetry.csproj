<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.BevTools</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Builds on Bit.BevTools, which is not trim-safe (see Bit.BevTools.csproj). -->
        <IsTrimmable>false</IsTrimmable>
        <IsAotCompatible>false</IsAotCompatible>
        <PackageDescription>bit Belemetry integration for bit BevTools: a Support panel with Belemetry's diagnostic timeline and exception groups, a jump from a failure to its component in the tree, support bundle preview, export and import - and the component tree and render counts BevTools observes, added to Belemetry's captures.</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;devtools;diagnostics;telemetry;support;Belemetry</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.BevTools\Bit.BevTools.csproj" />
        <ProjectReference Include="..\..\Belemetry\Bit.Belemetry\Bit.Belemetry.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.BevTools.Tests" PublicKey="" />
    </ItemGroup>

</Project>
