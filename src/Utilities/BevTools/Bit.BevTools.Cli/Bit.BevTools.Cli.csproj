<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0</TargetFrameworks>
        <RollForward>Major</RollForward>
        <RootNamespace>Bit.BevTools</RootNamespace>
        <AssemblyName>bevtools</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- It reads exports with Bit.BevTools, which is not AOT compatible (see its project file). -->
        <IsAotCompatible>false</IsAotCompatible>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <DocumentationFile></DocumentationFile>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>bevtools</ToolCommandName>
        <Title>bit BevTools CLI</Title>
        <PackageDescription>Checks bit BevTools session exports in CI: fails a build on the findings of BevTools' diagnostics, or on render regressions between two recordings of the same interaction.</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;devtools;diagnostics;profiler;ci;cli</PackageTags>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.BevTools\Bit.BevTools.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.BevTools.Tests" PublicKey="" />
    </ItemGroup>

</Project>
