<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.BevTools</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageDescription>Lets a Blazor app load bit BevTools on demand: startup hooks (component activator, HTTP pipeline, service collection, framework diagnostics) that cost next to nothing until BevTools is attached, a service that lazy loads Bit.BevTools.wasm, attaches it to the running app and opens it, and a component that renders its panel.</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;devtools;diagnostics;lazy-loading</PackageTags>
        <!-- Unlike Bit.BevTools, this assembly is part of every startup download of the app that references it, AOT
             builds included, so it stays small, reflection free and trim/AOT safe (IsAotCompatible comes from
             Bit.Build.props). It must never reference a Bit.BevTools type: Bit.BevTools references it. -->
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.Components.Web" Version="[11.0.0-rc.1.26425.128,12.0.0)" />
        <!-- LazyAssemblyLoader. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.WebAssembly" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.Components.WebAssembly" Version="[11.0.0-rc.1.26425.128,12.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.Http" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.Extensions.Http" Version="[11.0.0-rc.1.26425.128,12.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.Hosting.Abstractions" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.Extensions.Hosting.Abstractions" Version="[11.0.0-rc.1.26425.128,12.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.BevTools" PublicKey="" />
        <InternalsVisibleTo Include="Bit.BevTools" PublicKey="" />
        <InternalsVisibleTo Include="Bit.BevTools.Tests" PublicKey="" />
    </ItemGroup>

</Project>
