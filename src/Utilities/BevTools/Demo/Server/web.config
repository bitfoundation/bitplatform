<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Publishing adds the handler and the rest of the aspNetCore element (processPath, arguments, hostingModel). -->
      <aspNetCore>
        <environmentVariables>
          <!--
            Where the server calls its own demo API (DemoApiAddress in Program.cs). Behind IIS out of process, Kestrel
            takes only the requests IIS forwards with its pairing token, so the server cannot call an address it listens
            on and calls the public one instead. Never the request's Host header: a visitor sets that.
          -->
          <environmentVariable name="DemoApiBaseAddress" value="https://bevtools.bitplatform.dev/" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
