@namespace Bit.BevTools.Demo.Client.Components
@inject FilterState Filter

<div class="bb-toolbar">
    <input type="search" class="demo-search" aria-label="Search products" placeholder="Search products (every keystroke notifies FilterState)" value="@Filter.Query" @oninput="OnQuery" />
    <select aria-label="Category" value="@Filter.Category" @onchange="OnCategory">
        <option>All</option>
        <option>Office</option>
        <option>Audio</option>
        <option>Furniture</option>
        <option>Outdoor</option>
        <option>Accessories</option>
    </select>
    <label class="bb-check">Max price <input type="range" min="10" max="1000" value="@Filter.MaxPrice" @oninput="OnPrice" /> <span class="demo-range-value">@Filter.MaxPrice.ToString("C0")</span></label>
    <button type="button" class="btn btn-secondary" @onclick="Filter.Touch">Notify without change (@Filter.ChangeCount)</button>
</div>

@code {
    private void OnQuery(ChangeEventArgs e) => Filter.Query = e.Value?.ToString() ?? string.Empty;

    private void OnCategory(ChangeEventArgs e) => Filter.Category = e.Value?.ToString() ?? "All";

    private void OnPrice(ChangeEventArgs e) => Filter.MaxPrice = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 1000;
}
