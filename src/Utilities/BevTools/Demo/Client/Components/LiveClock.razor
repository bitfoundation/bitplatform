@namespace Bit.BevTools.Demo.Client.Components
@implements IDisposable

<div class="demo-big demo-clock">@_now.ToString("HH:mm:ss.f")</div>
<div class="bb-muted">ticks every 500 ms (StateHasChanged from a timer)</div>

@code {
    private DateTime _now = DateTime.Now;
    private Timer? _timer;

    // A plain delegate, not an EventCallback: an EventCallback re-renders the component that handles it after every
    // call, so the whole dashboard would render on each tick whether or not the dashboard asked for it.
    [Parameter] public Action? OnTick { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            _timer = new Timer(_ => InvokeAsync(() =>
            {
                _now = DateTime.Now;
                StateHasChanged();
                OnTick?.Invoke();
            }), null, 500, 500);
        }
    }

    public void Dispose() => _timer?.Dispose();
}
