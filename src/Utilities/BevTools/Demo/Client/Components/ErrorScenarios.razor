@namespace Bit.BevTools.Demo.Client.Components
@inject ProductApi Api

@* A component of its own so the Errors page can wrap it in an ErrorBoundary: event handler exceptions are routed to
   the boundary above the component that owns the handler, so a boundary inside the page could not catch them. *@

<div class="bb-toolbar">
    <button type="button" class="btn btn-secondary" @onclick="ThrowInHandler">Throw in event handler</button>
    <button type="button" class="btn btn-secondary" @onclick="ThrowAsync">Throw after await</button>
    <button type="button" class="btn btn-secondary" @onclick="() => _renderBomb = true">Throw during render (inside ErrorBoundary)</button>
    <button type="button" class="btn btn-secondary" @onclick="() => _initBomb = true">Child throws in OnInitialized (inside ErrorBoundary)</button>
    <button type="button" class="btn btn-secondary" @onclick="Http404">HTTP 404</button>
    <button type="button" class="btn btn-outline" @onclick="() => { _renderBomb = false; _initBomb = false; _boundary?.Recover(); }">Reset</button>
</div>

<ErrorBoundary @ref="_boundary">
    <ChildContent>
        <div class="demo-tile">
            <h4 class="demo-tile-title">Protected area</h4>
            @if (_renderBomb)
            {
                <div>@ThrowingValue</div>
            }
            @if (_initBomb)
            {
                <BrokenChild />
            }
            <div class="bb-muted">Nothing exploded (yet).</div>
        </div>
    </ChildContent>
    <ErrorContent Context="ex">
        <div class="bb-note bb-note-danger">ErrorBoundary caught: @ex.GetType().Name — @ex.Message</div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private ErrorBoundary? _boundary;
    private bool _renderBomb;
    private bool _initBomb;

    private string ThrowingValue => throw new InvalidOperationException("Render-time failure: computed property threw while building the render tree.");

    private void ThrowInHandler() => throw new InvalidOperationException("Handler failure: simulated exception in an @onclick handler.");

    private async Task ThrowAsync()
    {
        await Task.Delay(150);
        throw new TimeoutException("Async failure: the continuation after an await threw.");
    }

    private async Task Http404()
    {
        var response = await Api.GetMissingAsync();
        response.EnsureSuccessStatusCode();
    }
}
