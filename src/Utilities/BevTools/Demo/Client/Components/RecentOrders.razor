@namespace Bit.BevTools.Demo.Client.Components
@inject ProductApi Api

<div class="demo-tile demo-span-2">
    <h4 class="demo-tile-title">Recent orders <span class="bb-muted">(HTTP, 1.2–2.6 s server delay)</span></h4>
    @if (_orders is null)
    {
        <div class="bb-muted demo-loading">
            @if (_error is null)
            {
                <span class="bb-spinner" aria-hidden="true"></span>
            }
            @(_error ?? "loading…")
        </div>
    }
    else
    {
        <div class="bb-scroll">
            <table class="bb-table">
                <thead><tr><th>#</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var o in _orders.Take(5))
                    {
                        <tr><td>@o.Id</td><td>@o.Customer</td><td>@o.Total.ToString("C")</td><td>@o.Status</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="bb-toolbar"><button type="button" class="btn btn-secondary" @onclick="Reload">Reload</button></div>
</div>

@code {
    private List<Order>? _orders;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            await Reload();
        }
    }

    private async Task Reload()
    {
        _orders = null;
        _error = null;
        StateHasChanged();
        try
        {
            _orders = await Api.GetOrdersAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        StateHasChanged();
    }
}
