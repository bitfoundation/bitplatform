@page "/checkout"
@inject CartState Cart
@inject AppState AppState

<PageTitle>Checkout · BevTools</PageTitle>

<div class="bb-intro">
    <p class="bb-overline">Scenario · State</p>
    <h1>Checkout</h1>
    <p class="bb-subtitle">
        A cart, two forms and a few application settings. <code>CartState</code> and <code>AppState</code> are ordinary
        scoped services that implement <code>IBevStateProvider</code>, so every action on them is a named state change
        in BevTools, with a before/after diff and the click that made it. The forms show what validates them and what
        does not, and the coupon box has an accessibility problem to find.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> The checkout</h3>
    <p class="bb-card-desc">
        Add, remove, apply the coupon (the ✓ button) or clear the cart, then fill the shipping form in and place the
        order - nothing is sent anywhere. The newsletter form below it subscribes even with an empty address. The two
        toggles change <code>AppState</code> values only; the site's own light/dark theme is the button in the header.
    </p>

    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live</span><RendererStatus /></div>

        <div class="demo-tiles demo-tiles-pair">
            <div class="demo-tile">
                <h4 class="demo-tile-title">Cart (@Cart.ItemCount items)</h4>
                @if (Cart.Lines.Count == 0)
                {
                    <div class="bb-muted">Empty. Add products from the <a href="products">products page</a> or:</div>
                    <div class="bb-toolbar"><button type="button" class="btn btn-secondary" @onclick="AddSample">Add sample items</button></div>
                }
                else
                {
                    <ul class="demo-cart">
                        @foreach (var line in Cart.Lines)
                        {
                            <li>
                                <span class="demo-cart-name">@line.Product.Name</span>
                                <span class="bb-nowrap">× @line.Quantity · @line.LineTotal.ToString("C")</span>
                                <button type="button" class="bb-icon-btn" aria-label="Remove @line.Product.Name" @onclick="() => Cart.Remove(line.Product.Id)">✕</button>
                            </li>
                        }
                    </ul>
                    <div><strong>Total @Cart.Total.ToString("C")</strong> @(Cart.CouponCode is null ? "" : $"(coupon {Cart.CouponCode})")</div>
                    <div class="bb-toolbar">
                        @* Planted problem 22: the field's only label is its placeholder, and the button's only content is
                           a glyph hidden from screen readers, so neither has a name a screen reader can announce. *@
                        <input class="demo-coupon" placeholder="Coupon code" @bind="_coupon" />
                        <button type="button" class="btn btn-secondary" @onclick="() => Cart.ApplyCoupon(_coupon)"><span aria-hidden="true">✓</span></button>
                        <button type="button" class="btn btn-secondary" @onclick="Cart.Clear">Clear</button>
                    </div>
                }
            </div>

            <div class="demo-tile demo-span-2">
                <h4 class="demo-tile-title">Shipping details</h4>
                <EditForm Model="_model" OnValidSubmit="Submit" FormName="checkout">
                    <DataAnnotationsValidator />
                    <div class="demo-form">
                        <label class="bb-field">Full name <InputText @bind-Value="_model.FullName" /></label>
                        <label class="bb-field">Email <InputText @bind-Value="_model.Email" /></label>
                        <label class="bb-field">Address <InputText @bind-Value="_model.Address" /></label>
                        <label class="bb-field">Postal code <InputText @bind-Value="_model.PostalCode" /></label>
                        <label class="bb-field demo-form-wide">Notes <InputTextArea @bind-Value="_model.Notes" /></label>
                        <label class="bb-check demo-form-wide"><InputCheckbox @bind-Value="_model.AcceptTerms" /> I accept the terms</label>
                    </div>
                    <ValidationSummary />
                    <div class="bb-toolbar">
                        <button type="submit" class="btn btn-primary">Place order</button>
                        <button type="button" class="btn btn-secondary" @onclick="ToggleTheme">Toggle AppState.Theme (@AppState.Theme)</button>
                        <button type="button" class="btn btn-secondary" @onclick="() => AppState.NotificationsEnabled = !AppState.NotificationsEnabled">Toggle notifications (@AppState.NotificationsEnabled)</button>
                    </div>
                </EditForm>
                @if (_submitted)
                {
                    <p class="bb-note bb-note-success">Order placed for @_model.FullName. (Nothing was actually sent.)</p>
                }
                <NewsletterSignup />
            </div>
        </div>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> State: history with diffs</h3>
    <p class="bb-card-desc">
        Open <strong>State</strong> and select <code>CartState</code>: the change history names each action
        (<code>Add</code>, <code>Remove</code>, <code>ApplyCoupon</code>, <code>Clear</code>), with the values before and
        after and a link to the UI event that triggered it. <code>AppState</code> records <code>SetTheme</code>,
        <code>ToggleNotifications</code>, <code>Click</code> and a <code>Visit</code> per navigation - and shows its
        <code>ApiKey</code> redacted.
    </p>
    <div class="bb-try">
        <a href="problems#problem-10" class="btn btn-outline">Problem 10 →</a>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Forms: what validates each form</h3>
    <p class="bb-card-desc">
        Press <em>Place order</em> with the form empty, then <em>Subscribe</em> with the newsletter field empty, and open
        <strong>Forms</strong>. It lists every <code>EditForm</code> on the page with its model:
    </p>
    <ul class="bb-detail-list">
        <li>The shipping form is <em>validated by DataAnnotationsValidator</em> and its messages are <em>shown by ValidationSummary</em>; the table has a row per field - modified or not, how many changes, and its validation messages.</li>
        <li>The newsletter form is <em>validated by nothing</em>, next to its model's rules (<em>Email: Required, EmailAddress</em>): it has no <code>&lt;DataAnnotationsValidator /&gt;</code>, so <code>OnValidSubmit</code> always runs. <strong>Diagnostics</strong> reports <em>NewsletterModel's validation attributes are never checked</em>.</li>
        <li>The <strong>Timeline</strong> records every validation with its outcome: <em>Form validated: NewsletterModel is valid</em>.</li>
    </ul>
    <div class="bb-try">
        <a href="problems#problem-17" class="btn btn-outline">Problem 17 →</a>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-danger"></span> Browser → Accessibility: a coupon box nobody can name</h3>
    <p class="bb-card-desc">
        Add something to the cart, then open <strong>Browser</strong> and press <em>Check the page</em>. Two findings
        point at the coupon box, each naming the component that rendered it (<code>Checkout</code>) and the WCAG
        criterion, with <em>Show</em> to outline the element: the field has no label - a placeholder disappears as soon as
        something is typed, so it is not one - and the ✓ button has no accessible name, because its only content is
        hidden from screen readers. <strong>Diagnostics</strong> repeats them. What markup cannot decide - contrast, focus
        order, whether a name makes sense - the panel leaves to a person.
    </p>
    <div class="bb-try">
        <a href="problems#problem-22" class="btn btn-outline">Problem 22 →</a>
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Exposing your own state</h3>
    <p class="bb-card-desc">
        A state container becomes a provider by implementing <code>IBevStateProvider</code> - a name, a snapshot and a
        <code>Changed</code> event carrying the action - and being registered with
        <code>AddBevToolsStateProvider</code>. This is the cart above, shortened:
    </p>
    <pre class="bb-code"><span class="k">public sealed class</span> CartState : IBevStateProvider
{
    <span class="k">public</span> List&lt;CartLine&gt; Lines { <span class="k">get</span>; } = [];

    <span class="k">public string</span> Name =&gt; <span class="s">"CartState"</span>;

    <span class="k">public string</span>? Description =&gt; <span class="s">"scoped service, one per circuit / app"</span>;

    <span class="k">public event</span> Action&lt;BevStateChangeInfo&gt;? Changed;

    <span class="k">public object</span>? GetSnapshot() =&gt; <span class="k">this</span>;

    <span class="k">public void</span> Add(Product product)
    {
        <span class="c">// … update Lines …</span>
        Changed?.Invoke(<span class="k">new</span> BevStateChangeInfo(<span class="s">"Add"</span>, product.Name));
    }
}

<span class="c">// Program.cs - registers it as a scoped service and as a state provider</span>
builder.Services.AddBevToolsStateProvider&lt;CartState&gt;();</pre>
    <p class="bb-card-desc">
        A store that cannot implement the interface - a library's, or one you would rather keep free of BevTools - gets
        an adapter instead: <code>AddBevToolsStateProvider&lt;TService&gt;(name, snapshot, subscribe)</code>, or an
        extension's <code>AddStateProvider</code>, which is how the <code>FilterState</code> of the Products page
        appears in the State panel (see <a href="extending">Extending</a>).
    </p>
</div>

@code {
    private readonly CheckoutModel _model = new();
    private bool _submitted;
    private string _coupon = "SAVE10";

    private void ToggleTheme() => AppState.Theme = AppState.Theme == "light" ? "dark" : "light";

    private void Submit()
    {
        _submitted = true;
        Cart.Clear();
    }

    private void AddSample()
    {
        Cart.Add(new Product(1, "Quantum Lamp 1", "Office", 46.99m, 12, 4.1));
        Cart.Add(new Product(2, "Rustic Keyboard 2", "Office", 83.99m, 3, 3.8));
        Cart.Add(new Product(1, "Quantum Lamp 1", "Office", 46.99m, 12, 4.1));
    }
}
