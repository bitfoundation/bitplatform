<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The pages every hosting sample (Server, WebAssembly, Auto, MAUI) renders, and the <BevToolsPanel /> they all
         share. Nothing in here knows which host it runs in: each host's Program.cs owns its BevTools setup, which is
         the part worth comparing. -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
        <ProjectReference Include="..\..\Bit.BevTools\Bit.BevTools.csproj" />
    </ItemGroup>

</Project>
