<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!-- The browser half of the lazy loading sample: it starts with Bit.BevTools.Loader only, and downloads
         Bit.BevTools.wasm when someone presses its "Open dev tools" button. It does what the README's "Opening it on
         demand, and lazy loading" section asks of such a project, and the end-to-end suite (Tests/Bit.BevTools.Tests.E2E,
         LazyLoadingTests) publishes it and checks it in a browser. -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <!-- No MetricsSupport: render-diff and lifecycle timings need it, and the README suggests it for Development
             only. This sample is about what ships, and the About panel says what is missing without it. -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
        <ProjectReference Include="..\..\..\Bit.BevTools\Bit.BevTools.csproj" />
        <ProjectReference Include="..\..\..\Bit.BevTools.Loader\Bit.BevTools.Loader.csproj" />
    </ItemGroup>

    <!-- AOT builds cannot lazy load, and start with Bit.BevTools instead. The loader needs no switch to tell: it looks
         among the assemblies the app started with before it asks LazyAssemblyLoader for the download. -->
    <ItemGroup Condition=" '$(RunAOTCompilation)' != 'true' ">
        <BlazorWebAssemblyLazyLoad Include="Bit.BevTools.wasm" />
    </ItemGroup>

</Project>
