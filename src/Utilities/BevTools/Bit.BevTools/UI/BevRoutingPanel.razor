@namespace Bit.BevTools
@inherits BevToolsTab

<div class="bev-toolbar">
    <input type="text" aria-label="Filter routes" placeholder="Filter routes (template, page, policy)…" value="@Query" @oninput="OnQuery" />
    <span class="bev-muted bev-nowrap">@_visibleRoutes.Count / @_snapshot.Routes.Count routes</span>
</div>
<div class="bev-scroll" style="flex:1">
    @{ var current = _snapshot.Current; }
    <div class="bev-section">
        <div class="bev-section-title">Current route</div>
        <div class="bev-section-body">
            <dl class="bev-kv">
                <dt>URI</dt><dd class="bev-mono">@(current.Uri ?? "unknown")</dd>
                @if (current.PageType is not null)
                {
                    <dt>Page</dt>
                    <dd>
                        @if (current.PageInstanceId is { } pageId)
                        {
                            <button type="button" class="bev-link bev-mono" @onclick="() => Host.SelectComponent(pageId)">@current.PageDisplayName</button>
                        }
                        else
                        {
                            <span class="bev-mono">@current.PageDisplayName</span>
                        }
                        <span class="bev-muted bev-mono">@current.PageType</span>
                    </dd>
                    <dt>Template</dt>
                    <dd class="bev-mono">@(current.Template ?? "unknown") @if (current.TemplateInferred) { <span class="bev-muted">(inferred: the page's only @@page, since this RouteData carries no template)</span> }</dd>
                    <dt>Layout</dt><dd class="bev-mono">@(current.Layout ?? "none")</dd>
                }
                <dt>Source</dt><dd class="bev-muted">@current.Source</dd>
            </dl>
            @if (current.RouteValues.Count > 0)
            {
                <strong>Route values</strong>
                @Pairs(current.RouteValues)
            }
            @if (current.Query.Count > 0)
            {
                <strong>Query string</strong>
                @Pairs(current.Query)
            }
        </div>
    </div>
    @if (_authentication is { } auth)
    {
        <div class="bev-section">
            <div class="bev-section-title">Authentication <button type="button" class="bev-link" style="margin-left:auto;font-weight:normal" @onclick='() => Host.ShowPanel("state", "Authentication")'>State ↗</button></div>
            <div class="bev-section-body">
                <dl class="bev-kv">
                    <dt>User</dt><dd>@(auth.IsAuthenticated ? Session.Inspector.Describe("Name", auth.Name).Display + " (" + auth.AuthenticationType + ")" : "anonymous")</dd>
                    @if (auth.IsAuthenticated)
                    {
                        <dt>Roles</dt><dd>@(auth.Roles.Count == 0 ? "none" : string.Join(", ", auth.Roles.Select(r => Session.Inspector.Describe("Role", r).Display)))</dd>
                        <dt>Claims</dt><dd>@auth.Claims.Count <span class="bev-muted">(listed in the State panel, with the change history)</span></dd>
                    }
                    @if (auth.Error is not null)
                    {
                        <dt>Error</dt><dd class="bev-err">@auth.Error</dd>
                    }
                </dl>
            </div>
        </div>
    }
    <div class="bev-section">
        <div class="bev-section-title">Navigation guards <span class="bev-muted" style="font-weight:normal">what can stop or confirm a navigation before it happens</span></div>
        <div class="bev-section-body">
            @if (!BevNavigationGuards.IsAvailable)
            {
                <div class="bev-muted">This framework version does not expose its LocationChanging handlers.</div>
            }
            else if (_guards.Count == 0)
            {
                <div class="bev-muted">None: no NavigationLock and no LocationChanging handler, so every navigation proceeds.</div>
            }
            else
            {
                <table>
                    <thead><tr><th>Guard</th><th>On</th><th>What it does</th></tr></thead>
                    <tbody>
                        @foreach (var guard in _guards)
                        {
                            <tr>
                                <td>@guard.Kind</td>
                                <td class="bev-mono">
                                    @if (guard.OwnerInstanceId is { } owner)
                                    {
                                        <button type="button" class="bev-link bev-mono" @onclick="() => Host.SelectComponent(owner)">@guard.OwnerName</button>
                                    }
                                    else
                                    {
                                        <span class="bev-muted">?</span>
                                    }
                                </td>
                                <td>@guard.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
    <div class="bev-section">
        <div class="bev-section-title">Navigation history <span class="bev-muted" style="font-weight:normal">newest first, from the timeline; renders counted until the next navigation</span></div>
        <div class="bev-section-body">
            @if (_navigations.Length == 0)
            {
                <div class="bev-muted">No navigation recorded yet.</div>
            }
            else
            {
                <table>
                    <thead><tr><th>Time</th><th>Navigation</th><th class="bev-num">Duration</th><th class="bev-num" title="@_costMeaning">Renders</th><th class="bev-num" title="@_costMeaning">Render time</th><th>How</th></tr></thead>
                    <tbody>
                        @foreach (var n in _navigations)
                        {
                            <tr class="bev-row" @onclick="() => Host.SelectEvent(n.Id)">
                                <td class="bev-mono">@BevFmt.Time(n.Timestamp)</td>
                                <td class="bev-mono bev-truncate" style="max-width:420px" title="@n.Title">@n.Title</td>
                                <td class="bev-num">@BevFmt.Ms(n.DurationMs)</td>
                                @if (_cost.TryGetValue(n.Id, out var cost))
                                {
                                    <td class="bev-num">@cost.Renders</td>
                                    <td class="bev-num">@BevFmt.Ms(cost.Ms)</td>
                                }
                                else
                                {
                                    <td class="bev-num bev-muted" title="Render events are not recorded (RecordRenderEvents is off), or fell out of the timeline">–</td>
                                    <td class="bev-num bev-muted">–</td>
                                }
                                <td class="bev-muted">@n.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
    <div class="bev-section">
        <div class="bev-section-title">Route table <span class="bev-muted" style="font-weight:normal">@_snapshot.RoutesSource</span></div>
        <div class="bev-section-body">
            @if (_visibleRoutes.Count == 0)
            {
                <div class="bev-muted">@(_snapshot.Routes.Count == 0 ? "No routable page found." : "No route matches the filter.")</div>
            }
            else
            {
                <table>
                    <thead><tr><th>Template</th><th>Page</th><th>Authorization</th><th>Render mode</th><th>Layout</th></tr></thead>
                    <tbody>
                        @foreach (var route in _visibleRoutes)
                        {
                            <tr class="@(route.PageType == current.PageType ? "bev-selected" : "")" title="@route.PageType (@route.Assembly)">
                                <td class="bev-mono">@string.Join(" · ", route.Templates)</td>
                                <td class="bev-mono">@route.PageDisplayName</td>
                                <td>
                                    @foreach (var a in route.Authorization)
                                    {
                                        <span class="bev-chip bev-warn">@a</span>
                                    }
                                    @if (route.AllowAnonymous)
                                    {
                                        <span class="bev-chip">AllowAnonymous</span>
                                    }
                                </td>
                                <td>@if (route.RenderMode is not null) { <span class="bev-chip">@route.RenderMode</span> }</td>
                                <td class="bev-mono bev-muted">@route.Layout</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (_snapshot.RouteAssemblies.Count > 0)
            {
                <div class="bev-muted" style="margin-top:4px">Assemblies: <span class="bev-mono">@string.Join(", ", _snapshot.RouteAssemblies)</span></div>
            }
        </div>
    </div>
</div>

@code {
    private BevRoutingSnapshot _snapshot = new(new BevCurrentRoute(null, null, null, null, null, false, [], [], null, ""), [], [], "");
    private List<BevRouteEntry> _visibleRoutes = [];
    private BevToolsEvent[] _navigations = [];
    private IReadOnlyList<BevNavigationGuard> _guards = [];
    private Dictionary<long, (int Renders, double Ms)> _cost = [];

    private string _costMeaning = "";

    /// <summary>
    /// What each navigation cost: the component renders it caused - each render event names the navigation that
    /// triggered it, where the runtime reports navigations as triggers (.NET 10) - so a click or a timer on the page
    /// afterwards is not counted. Where none does, the renders from the navigation until the next one, and the column
    /// says so. Only when render events are recorded.
    /// </summary>
    private Dictionary<long, (int Renders, double Ms)> NavigationCost(BevToolsEvent[] timeline)
    {
        var cost = new Dictionary<long, (int Renders, double Ms)>();
        if (!Session.Options.RecordRenderEvents || timeline.Length == 0)
        {
            return cost;
        }

        var navigationIds = timeline.Where(e => e.Kind == BevToolsEventKind.Navigation).Select(e => e.Id).ToHashSet();
        foreach (var render in timeline)
        {
            if (render.Kind == BevToolsEventKind.Render && render.ParentEventId is { } parent && navigationIds.Contains(parent))
            {
                var (count, total) = cost.GetValueOrDefault(parent);
                cost[parent] = (count + 1, total + (render.DurationMs ?? 0));
            }
        }

        if (cost.Count > 0)
        {
            _costMeaning = "The renders each navigation caused (later clicks and timers on the page are not counted)";
            return cost;
        }

        _costMeaning = "The renders from each navigation until the next one: this runtime does not say which renders a navigation caused";

        long? current = null;
        var renders = 0;
        var ms = 0.0;
        foreach (var e in timeline)
        {
            if (e.Kind == BevToolsEventKind.Navigation)
            {
                if (current is { } previous)
                {
                    cost[previous] = (renders, ms);
                }

                current = e.Id;
                renders = 0;
                ms = 0;
            }
            else if (e.Kind == BevToolsEventKind.Render && current is not null)
            {
                renders++;
                ms += e.DurationMs ?? 0;
            }
        }

        if (current is { } last)
        {
            cost[last] = (renders, ms);
        }

        return cost;
    }
    private BevAuthenticationSnapshot? _authentication;

    private string? Query => Ui.GetQuery("routing");

    protected override void OnParametersSet()
    {
        _snapshot = BevRoutingReader.Read(Session);
        var timeline = Session.Timeline.Snapshot();
        _navigations = timeline.Where(e => e.Kind == BevToolsEventKind.Navigation).Reverse().Take(25).ToArray();
        _guards = BevNavigationGuards.Read(Session);
        _cost = NavigationCost(timeline);
        _authentication = Session.State.Entries.FirstOrDefault(e => e.Provider is BevAuthenticationStateProvider)?.Provider.GetSnapshot() as BevAuthenticationSnapshot;
        Filter();
    }

    private void Filter()
    {
        var filter = BevQueryFilter.Parse(Query);
        _visibleRoutes = _snapshot.Routes
            .Where(r => filter.Terms.Count == 0 || filter.MatchesText(string.Join(" ", r.Templates), r.PageType, string.Join(" ", r.Authorization), r.RenderMode ?? "", r.Layout ?? ""))
            .ToList();
    }

    private void OnQuery(ChangeEventArgs e)
    {
        Ui.SetQuery("routing", e.Value?.ToString());
        Filter();
    }

    private static RenderFragment Pairs(IReadOnlyList<KeyValuePair<string, string>> pairs) => __builder =>
    {
        <table>
            <tbody>
                @foreach (var (key, value) in pairs)
                {
                    <tr><td class="bev-mono">@key</td><td class="bev-mono">@value</td></tr>
                }
            </tbody>
        </table>
    };
}
