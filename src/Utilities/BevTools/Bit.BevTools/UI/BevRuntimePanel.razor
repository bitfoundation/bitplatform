@namespace Bit.BevTools
@inherits BevToolsTab

<div class="bev-scroll" style="flex:1">
    @foreach (var section in _sections)
    {
        <div class="bev-section">
            <div class="bev-section-title">@section.Title @if (section.Scope is not null) { <span class="bev-muted" style="font-weight:normal">@section.Scope</span> }</div>
            <div class="bev-section-body">
                <dl class="bev-kv">
                    @foreach (var fact in section.Facts)
                    {
                        <dt>@fact.Name</dt>
                        <dd class="@BevFmt.SevClass(fact.Severity)">
                            <span class="@(fact.Severity == BevToolsSeverity.Info ? "" : "bev-chip " + (fact.Severity == BevToolsSeverity.Error ? "bev-err" : "bev-warn"))">@fact.Value</span>
                            @if (fact.Hint is not null)
                            {
                                <div class="bev-muted">@fact.Hint</div>
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>
    }
    @if (_memory.Length > 1)
    {
        var first = _memory[0];
        var last = _memory[^1];
        var max = Math.Max(1, _memory.Max(m => m.HeapBytes));
        var span = Math.Max(1, (last.At - first.At).TotalSeconds);
        // The collections of the window the chart draws, for the chart, its description and the row below alike.
        var collections = _collections.Where(c => c.At >= first.At).ToArray();
        <div class="bev-section">
            <div class="bev-section-title">Memory over time <span class="bev-muted" style="font-weight:normal">@(Session.IsInMultiUserHost ? "the process's heap, shared by every circuit" : "this runtime") · last @BevFmt.Num(span / 60) min, read once a second</span></div>
            <div class="bev-section-body">
                <svg viewBox="0 0 600 60" preserveAspectRatio="none" style="width:100%;height:60px" role="img" aria-label="Managed heap from @BevFmt.Bytes(first.HeapBytes) to @BevFmt.Bytes(last.HeapBytes), peak @BevFmt.Bytes(max); @collections.Length full collections">
                    <polyline fill="none" stroke="var(--bev-accent)" stroke-width="1.5" points="@Points(_memory, first.At, span, max)" />
                    @foreach (var c in collections)
                    {
                        var x = (c.At - first.At).TotalSeconds / span * 600;
                        <line x1="@x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" x2="@x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y1="0" y2="60" stroke="var(--bev-warn)" stroke-dasharray="2 2"><title>Full collection: heap after @BevFmt.Bytes(c.HeapAfterBytes)</title></line>
                    }
                </svg>
                <dl class="bev-kv">
                    <dt>Managed heap</dt><dd>@BevFmt.Bytes(last.HeapBytes) now · @BevFmt.Bytes(_memory.Min(m => m.HeapBytes)) to @BevFmt.Bytes(max) in this window</dd>
                    <dt>Full collections</dt><dd>@(last.FullCollections - first.FullCollections) in this window@(collections.Length > 0 ? " · heap after the last: " + BevFmt.Bytes(collections[^1].HeapAfterBytes) + (collections[^1].Exact ? "" : " (the first reading after it)") : "") <span class="bev-muted">(dashed lines; each is a timeline event)</span></dd>
                    @if (last.LinearMemoryBytes is { } linear)
                    {
                        <dt>WebAssembly memory</dt><dd>@BevFmt.Bytes(linear) <span class="bev-muted">(what the runtime got from the browser: it grows, never shrinks@(first.LinearMemoryBytes is { } was && was < linear ? "; " + BevFmt.Bytes(was) + " at the start of the window" : ""))</span></dd>
                    }
                </dl>
            </div>
        </div>
    }
    <div class="bev-section">
        <div class="bev-section-title">Disposed components still alive <span class="bev-muted" style="font-weight:normal">this session</span></div>
        <div class="bev-section-body">
            <div class="bev-toolbar" style="padding:0 0 4px">
                <button type="button" disabled="@(!Session.AllowsForcedCollection)" title="@CollectTitle" @onclick="CollectAndCheck">🧹 Collect garbage and check</button>
                <span class="bev-muted">@Session.Leaks.Watched disposed components watched@(Session.Leaks.LastForcedCheckAt is { } checkedAt ? " · last check " + BevFmt.Ago(checkedAt) : "")</span>
            </div>
            @if (_retained.Length == 0)
            {
                <div class="bev-muted">None found. A disposed component counts as still alive once two full garbage collections ran after its disposal and it survived them (or one you started here).</div>
            }
            else
            {
                <table>
                    <thead><tr><th>Component</th><th class="bev-num">Alive</th><th>Disposed</th><th>Held by</th></tr></thead>
                    <tbody>
                        @foreach (var group in _retained)
                        {
                            <tr>
                                <td class="bev-mono" title="@group.TypeName">@group.DisplayName</td>
                                <td class="bev-num"><span class="bev-chip bev-warn">@group.Count</span></td>
                                <td>@BevFmt.Ago(group.OldestDisposal) <span class="bev-muted">· @group.FullCollections+ full GCs since</span></td>
                                <td>
                                    @if (group.Causes.Count == 0)
                                    {
                                        <span class="bev-muted">nothing BevTools can see (a static, a cache, an object it handed itself to): take a heap snapshot</span>
                                    }
                                    @foreach (var cause in group.Causes)
                                    {
                                        <div><span class="bev-mono">@cause.Holder</span>: @cause.Detail <div class="bev-muted">@cause.Suggestion</div></div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
    @if (Session.Platform == "Server" && ExtensionPanelAvailable("circuit"))
    {
        <div class="bev-muted" style="padding:6px">Circuit connection, inbound message timing and the other circuits of this process: <button type="button" class="bev-link" @onclick='() => Host.ShowPanel("circuit")'>Circuit ↗</button></div>
    }
</div>

@code {
    private IReadOnlyList<BevRuntimeSection> _sections = [];

    private BevRetainedComponents[] _retained = [];

    private BevMemorySample[] _memory = [];

    private BevFullCollection[] _collections = [];

    protected override void OnParametersSet()
    {
        _sections = BevRuntimeInfo.Build(Session);
        _retained = Session.Leaks.Retained();
        _memory = Session.Memory.Samples;
        _collections = Session.Memory.FullCollections;
    }

    private static string Points(BevMemorySample[] samples, DateTimeOffset start, double span, long max) =>
        string.Join(" ", samples.Select(s => ((s.At - start).TotalSeconds / span * 600).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + ","
            + (58 - (double)s.HeapBytes / max * 56).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)));

    private string CollectTitle => !Session.AllowsForcedCollection
        ? "Not outside Development in a process that serves many users: a full collection pauses every circuit."
        : Session.IsInMultiUserHost
            ? "Runs full blocking garbage collections now. On Blazor Server this pauses the whole process, every circuit included, for a moment."
            : "Runs full blocking garbage collections now, then lists the disposed components that survived them.";

    private async Task CollectAndCheck()
    {
        if (!Session.AllowsForcedCollection)
        {
            return;
        }

        _retained = await Session.Leaks.CollectAndCheckAsync();
        Session.Diagnostics.Evaluate(force: true);
        Host.Notify(_retained.Length == 0 ? "No disposed component survived the collection" : _retained.Sum(r => r.Count) + " disposed component(s) survived the collection");
    }

    private bool ExtensionPanelAvailable(string id) => Host.ExtensionPanels.Any(p => p.Id == id);
}
