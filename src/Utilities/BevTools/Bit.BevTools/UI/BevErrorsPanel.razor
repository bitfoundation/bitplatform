@namespace Bit.BevTools
@inherits BevToolsTab

<div class="bev-split">
    <div class="bev-left" style="flex-basis:50%">
        <div class="bev-toolbar">
            <input type="text" aria-label="Filter errors" placeholder="Filter: text, source:render|blazor|error-boundary|http|javascript|resource|csp|circuit|signalr|js-interop" @bind:get="Query" @bind:set="OnQuery" @bind:event="oninput" />
            <span class="bev-segmented" role="group" aria-label="Show">
                <button type="button" aria-pressed="@(View.ByGroup ? "false" : "true")" @onclick="() => ShowGroups(false)">Errors</button>
                <button type="button" aria-pressed="@(View.ByGroup ? "true" : "false")" title="Errors that are one problem although their messages differ in ids, numbers or quoted values, thrown from the same place" @onclick="() => ShowGroups(true)">Groups</button>
            </span>
            <button type="button" @onclick="Clear">Clear</button>
            <span class="bev-muted bev-nowrap">@(View.ByGroup ? _groups.Count + " groups · " : "")@_rows.Count errors · @Session.Errors.TotalOccurrences occurrences</span>
        </div>
        @if (!View.ByGroup && View.Group is not null)
        {
            <div class="bev-toolbar">
                <span class="bev-muted">Group</span> <span class="bev-chip bev-on bev-mono bev-truncate" style="max-width:420px" title="@View.GroupTitle">@View.GroupTitle</span>
                <button type="button" aria-label="Show every error" @onclick="ClearGroup">✕</button>
            </div>
        }
        @* overflow inline too: Virtualize picks its scroll root when it first renders, which can be before the stylesheet applies. *@
        <div class="bev-scroll" style="overflow:auto">
            @if (View.ByGroup ? _groups.Count == 0 : _rows.Count == 0)
            {
                <div class="bev-empty">No errors. Render exceptions, event handler exceptions, ErrorBoundary catches, JS errors, HTTP failures, JS interop failures and circuit errors all land here.</div>
            }
            else if (View.ByGroup)
            {
                <table>
                    <thead>
                        <tr>
                            <BevSortHeader Key="last" Label="Last" Numeric="false" Active="@(View.Groups.Key == "last")" Ascending="View.Groups.Ascending" OnSort="SortGroups" />
                            <BevSortHeader Key="source" Label="Source" Numeric="false" Active="@(View.Groups.Key == "source")" Ascending="View.Groups.Ascending" OnSort="SortGroups" />
                            <BevSortHeader Key="error" Label="Error" Numeric="false" Active="@(View.Groups.Key == "error")" Ascending="View.Groups.Ascending" OnSort="SortGroups" />
                            <th>Components</th>
                            <BevSortHeader Key="messages" Label="Messages" Title="Different messages in the group: the values that differ (ids, numbers, quoted text) are replaced in its title" Active="@(View.Groups.Key == "messages")" Ascending="View.Groups.Ascending" OnSort="SortGroups" />
                            <BevSortHeader Key="occurrences" Label="×" Title="Occurrences" Active="@(View.Groups.Key == "occurrences")" Ascending="View.Groups.Ascending" OnSort="SortGroups" />
                            <BevSortHeader Key="first" Label="First" Numeric="false" Active="@(View.Groups.Key == "first")" Ascending="View.Groups.Ascending" OnSort="SortGroups" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in _groups)
                        {
                            var title = ErrorCenter.ShortTypeName(g.ExceptionType) + ": " + g.MessageTemplate;
                            <tr class="bev-row bev-sev-error" @onclick="() => OpenGroup(g, title)">
                                <td class="bev-mono">@BevFmt.Time(g.LastSeen)</td>
                                <td><span class="bev-chip">@g.Source</span></td>
                                <td class="bev-truncate" style="max-width:320px"><button type="button" class="bev-link" title="@(title + (g.SourceLocation is null ? "" : " at " + g.SourceLocation) + ": show its errors")" @onclick:stopPropagation="true" @onclick="() => OpenGroup(g, title)"><span class="bev-mono">@ErrorCenter.ShortTypeName(g.ExceptionType)</span>: @g.MessageTemplate</button>@if (g.SourceLocation is { } at) { <span class="bev-muted bev-mono" style="margin-left:4px">@("@ " + at)</span> }</td>
                                <td class="bev-truncate" style="max-width:180px" title="@string.Join(", ", g.Components)">@(g.Components.Count == 0 ? "–" : string.Join(", ", g.Components.Take(3)) + (g.Components.Count > 3 ? " +" + (g.Components.Count - 3) : ""))</td>
                                <td class="bev-num">@g.DistinctMessages</td>
                                <td class="bev-num">@g.Occurrences</td>
                                <td class="bev-mono">@BevFmt.Time(g.FirstAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <BevSortHeader Key="last" Label="Time" Numeric="false" Active="@(View.Errors.Key == "last")" Ascending="View.Errors.Ascending" OnSort="SortErrors" />
                            <BevSortHeader Key="source" Label="Source" Numeric="false" Active="@(View.Errors.Key == "source")" Ascending="View.Errors.Ascending" OnSort="SortErrors" />
                            <BevSortHeader Key="error" Label="Error" Numeric="false" Active="@(View.Errors.Key == "error")" Ascending="View.Errors.Ascending" OnSort="SortErrors" />
                            <BevSortHeader Key="component" Label="Component" Numeric="false" Active="@(View.Errors.Key == "component")" Ascending="View.Errors.Ascending" OnSort="SortErrors" />
                            <BevSortHeader Key="count" Label="×" Title="Occurrences" Active="@(View.Errors.Key == "count")" Ascending="View.Errors.Ascending" OnSort="SortErrors" />
                        </tr>
                    </thead>
                    <tbody>
                        <Virtualize Items="_rows" ItemSize="23" Context="e" SpacerElement="tr">
                            <tr class="bev-row bev-sev-error @(Ui.SelectedErrorId == e.Id ? "bev-selected" : "")" @onclick="() => { Ui.SelectedErrorId = e.Id; Ui.Touch(); }">
                                <td class="bev-mono">@BevFmt.Time(e.LastSeen)</td>
                                <td><span class="bev-chip">@e.Source</span></td>
                                <td class="bev-truncate" style="max-width:360px" title="@e.Message"><span class="bev-mono">@ErrorCenter.ShortTypeName(e.ExceptionType)</span>: @e.Message</td>
                                <td>@if (e.ComponentInstanceId is { } id) { <button type="button" class="bev-link" @onclick:stopPropagation="true" @onclick="() => Host.SelectComponent(id)">@e.ComponentName</button> }</td>
                                <td class="bev-num">@(e.Count > 1 ? e.Count : "")</td>
                            </tr>
                        </Virtualize>
                    </tbody>
                </table>
            }
        </div>
    </div>
    <div class="bev-right">
        @if (_selected is { } s)
        {
            <div class="bev-section">
                <div class="bev-section-title"><span class="bev-chip bev-err">@s.Source</span> <span class="bev-mono">@s.ExceptionType</span></div>
                <div class="bev-section-body">
                    <div style="margin-bottom:6px">@s.Message</div>
                    <dl class="bev-kv">
                        <dt>First seen</dt><dd>@BevFmt.Time(s.At)</dd>
                        <dt>Last seen</dt><dd>@BevFmt.Time(s.LastSeen) (@s.Count occurrence@(s.Count == 1 ? "" : "s"))</dd>
                        @if (s.SourceLocation is not null)
                        {
                            <dt>Location</dt><dd class="bev-mono">@s.SourceLocation</dd>
                        }
                        @if (s.ComponentInstanceId is { } cid)
                        {
                            <dt>Component</dt><dd><button type="button" class="bev-link" @onclick="() => Host.SelectComponent(cid)">@s.ComponentName #@cid ↗</button></dd>
                        }
                        <dt>Preceded by</dt>
                        <dd>@if (_preceding is { } p) { <button type="button" class="bev-link" @onclick="() => Host.SelectEvent(p.Id)"><span class="@BevFmt.KindClass(p.Kind)">@BevFmt.KindLabel(p.Kind)</span> @p.Title ↗</button> } else { <span class="bev-muted">no UI event recorded before this error</span> }</dd>
                        <dt>Timeline</dt><dd>@if (s.TimelineEventId > 0) { <button type="button" class="bev-link" @onclick="() => Host.SelectEvent(s.TimelineEventId)">open ↗</button> } else { <span class="bev-muted">not in the timeline (capture was paused when it occurred)</span> }</dd>
                    </dl>
                    @if (s.InnerError is { } inner)
                    {
                        <div style="margin-top:6px"><strong>Inner:</strong> <span class="bev-mono">@inner</span></div>
                    }
                    @if (s.StackTrace is not null)
                    {
                        <div style="margin-top:6px; display:flex; gap:6px; align-items:center"><strong>Stack trace</strong> <button type="button" @onclick="() => Copy(s)">Copy</button></div>
                        <pre class="bev-pre">@s.StackTrace</pre>
                    }
                </div>
            </div>
            <div class="bev-section">
                <div class="bev-section-title">Activity before the error</div>
                <div class="bev-section-body">
                    @if (_before.Count == 0)
                    {
                        <div class="bev-muted">Nothing recorded before it.</div>
                    }
                    @foreach (var b in _before)
                    {
                        <div><button type="button" class="bev-link" @onclick="() => Host.SelectEvent(b.Id)"><span class="@BevFmt.KindClass(b.Kind)">@BevFmt.KindLabel(b.Kind)</span> @b.Title</button> <span class="bev-muted">@BevFmt.Time(b.Timestamp)</span></div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="bev-empty">Select an error to see its stack trace, the component involved and what happened right before it.</div>
        }
    </div>
</div>

@code {
    private string? Query => Ui.GetQuery("errors");

    private BevErrorsView View => Ui.Errors;

    private List<BevErrorRecord> _rows = [];
    private List<BevErrorGroupSummary> _groups = [];
    private BevErrorRecord? _selected;
    private BevToolsEvent? _preceding;
    private List<BevToolsEvent> _before = [];

    protected override void OnParametersSet()
    {
        var filter = BevQueryFilter.Parse(Query);
        var source = filter.Token("source");
        var errors = Session.Errors.Snapshot();
        if (View.Group is { } group && !errors.Any(e => e.Group == group))
        {
            // Cleared, or every error of it left the buffer: nothing is left to filter by.
            View.Group = null;
            View.GroupTitle = null;
        }

        var matching = errors.Where(e => filter.MatchesText(e.Message, e.ExceptionType, e.ComponentName, e.Source) && (source is null || e.Source.StartsWith(source, StringComparison.OrdinalIgnoreCase)));
        if (View.ByGroup)
        {
            var ascending = View.Groups.Ascending;
            var groups = BevErrorGroups.Summarize(matching);
            _groups = (View.Groups.Key switch
            {
                "source" => Ordered(groups, g => g.Source, ascending),
                "error" => Ordered(groups, g => g.MessageTemplate, ascending),
                "messages" => Ordered(groups, g => g.DistinctMessages, ascending),
                "first" => Ordered(groups, g => g.FirstAt, ascending),
                "last" => Ordered(groups, g => g.LastSeen, ascending),
                _ => Ordered(groups, g => g.Occurrences, ascending),
            }).ToList();
        }
        else
        {
            _groups = [];
        }

        var rows = View.Group is { } only ? matching.Where(e => e.Group == only) : matching;
        var errorsAscending = View.Errors.Ascending;
        _rows = (View.Errors.Key switch
        {
            "source" => Ordered(rows, e => e.Source, errorsAscending),
            "error" => Ordered(rows, e => e.Message, errorsAscending),
            "component" => Ordered(rows, e => e.ComponentName ?? "", errorsAscending),
            "count" => Ordered(rows, e => e.Count, errorsAscending),
            _ => Ordered(rows, e => e.LastSeen, errorsAscending),
        }).ToList();
        _selected = Ui.SelectedErrorId is { } id ? Session.Errors.Find(id) : null;
        if (_selected is not null)
        {
            _preceding = _selected.PrecedingEventId is { } pid ? Session.Timeline.Find(pid) : null;
            var all = Session.Timeline.Snapshot();
            var index = Array.FindIndex(all, e => e.Id == _selected.TimelineEventId);
            _before = index <= 0 ? [] : all.Skip(Math.Max(0, index - 10)).Take(Math.Min(10, index)).Reverse().ToList();
        }
    }

    private void OnQuery(string? value)
    {
        Ui.SetQuery("errors", value);
        OnParametersSet();
    }

    private static IEnumerable<T> Ordered<T, TKey>(IEnumerable<T> rows, Func<T, TKey> key, bool ascending) =>
        ascending ? rows.OrderBy(key) : rows.OrderByDescending(key);

    private void ShowGroups(bool byGroup)
    {
        View.ByGroup = byGroup;
        if (byGroup)
        {
            // Every group again: a group opened earlier is not a filter of the groups.
            View.Group = null;
            View.GroupTitle = null;
        }

        OnParametersSet();
    }

    private void OpenGroup(BevErrorGroupSummary group, string title)
    {
        View.Group = group.Group;
        View.GroupTitle = title;
        View.ByGroup = false;
        Ui.SelectedErrorId = group.LatestId;
        Ui.Touch();
        OnParametersSet();
    }

    private void ClearGroup()
    {
        View.Group = null;
        View.GroupTitle = null;
        OnParametersSet();
    }

    private void Clear()
    {
        Session.Errors.Clear();
        ClearGroup();
    }

    private void SortErrors(string key)
    {
        View.Errors.Select(key, ascendingFirst: key is "source" or "error" or "component");
        OnParametersSet();
    }

    private void SortGroups(string key)
    {
        View.Groups.Select(key, ascendingFirst: key is "source" or "error");
        OnParametersSet();
    }

    private async Task Copy(BevErrorRecord e)
    {
        var ok = await Host.CopyAsync(e.ExceptionType + ": " + e.Message + "\n" + e.StackTrace);
        Host.Notify(ok ? "Copied" : "Clipboard unavailable");
    }
}
