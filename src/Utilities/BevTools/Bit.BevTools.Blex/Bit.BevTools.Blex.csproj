<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <RootNamespace>Bit.BevTools</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Builds on Bit.BevTools, which is not trim-safe (see Bit.BevTools.csproj). -->
        <IsTrimmable>false</IsTrimmable>
        <IsAotCompatible>false</IsAotCompatible>
        <PackageDescription>bit Blex integration for bit BevTools: every Blex store in the State panel, each action with its payload and the state it left, and restoring an earlier state through Blex's own time travel.</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;devtools;diagnostics;state;Blex</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.BevTools\Bit.BevTools.csproj" />
        <ProjectReference Include="..\..\Blex\Bit.Blex\Bit.Blex.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.BevTools.Tests" PublicKey="" />
    </ItemGroup>

</Project>
