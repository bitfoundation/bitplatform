<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- One Blazor Web App that serves the harness in any render mode, chosen at startup with
         BlexHarness:Mode (see HarnessRenderModes). A single host for every mode keeps the Program.cs and
         App.razor under test identical across modes, so a failure that shows up in one mode only belongs
         to the mode. Multi-targeted because the library is: the suites can run the harness on every
         runtime Bit.Blex ships for. -->

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0-rc.3.26522.148" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Blex.Tests.Harness.Web.Client\Bit.Blex.Tests.Harness.Web.Client.csproj" />
        <ProjectReference Include="..\Bit.Blex.Tests.Harness\Bit.Blex.Tests.Harness.csproj" />
    </ItemGroup>

</Project>
