{
  "profiles": {
    "ssr": {
      "commandName": "Project",
      "commandLineArgs": "--BlexHarness:Mode=ssr",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5291",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "server": {
      "commandName": "Project",
      "commandLineArgs": "--BlexHarness:Mode=server",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5291",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "wasm": {
      "commandName": "Project",
      "commandLineArgs": "--BlexHarness:Mode=wasm",
      "launchBrowser": true,
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "applicationUrl": "http://localhost:5291",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "auto": {
      "commandName": "Project",
      "commandLineArgs": "--BlexHarness:Mode=auto",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5291",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    }
  }
}
