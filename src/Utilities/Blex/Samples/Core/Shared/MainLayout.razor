@inherits LayoutComponentBase
@inject IBlexStorage Storage

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @* Which host is drawing the page, and where persisted state goes: the samples' whole point is
           that the same pages behave the same under every one of them. *@
        <div class="top-row px-4">
            <span class="text-muted small" role="status">
                Renderer: <strong>@RendererInfo.Name</strong>@(RendererInfo.IsInteractive ? null : " (prerendering)")
                &middot; Storage: <strong>@Storage.GetType().Name</strong>
            </span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
