{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "ES2019",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [ "DOM", "ESNext" ],
        // Each script is consumed by the C# side as its own ES module via JS `import(...)` (the DevTools
        // bridge is only loaded when it is enabled), so the sources are emitted per-file into wwwroot
        // with their `export`s preserved.
        "rootDir": "Scripts",
        "outDir": "wwwroot",
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [ "./Scripts/*.ts" ]
}
