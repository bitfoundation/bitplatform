@inherits BlexComponentBase
@inject CounterStore Counter

@*
    Subscribe(store, selector): re-renders only when the projected value changes. Mutating an
    unrelated field on the same store leaves this component alone.
*@
<div class="bb-card">
    <p class="bb-card-title"><code>Subscribe(Store, () =&gt; Store.Count)</code></p>
    <p class="bb-card-desc">Renders only when <code>Count</code> changes.</p>
    <div class="bb-stats">
        <div class="bb-stat">
            <span class="bb-stat-label">Count (displayed)</span>
            <span class="bb-stat-value">@Counter.Count</span>
        </div>
        <div class="bb-stat">
            <span class="bb-stat-label">Renders</span>
            <span class="bb-stat-value demo-accent">@_renders</span>
        </div>
    </div>
</div>

@code {
    private int _renders;

    protected override void OnInitialized() => Subscribe(Counter, () => Counter.Count);

    protected override void OnAfterRender(bool firstRender) => _renders++;
}
