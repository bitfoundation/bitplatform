    private const string AttributeSummary = """
        [BlexStore(Name = "cart", Persist = true)]
        public partial class CartStore
        {
            [BlexState]    private IReadOnlyList<CartLine> _lines = [];

            [BlexComputed] private decimal ComputeTotal() => Lines.Sum(l => l.Total);

            [BlexAction]   private void OnAdd(CartLine line) => Lines = [.. Lines, line];

            [BlexEffect(Concurrency = BlexEffectConcurrency.Drop)]
            private async Task OnCheckout(CancellationToken ct) => await _api.CheckoutAsync(Lines, ct);
        }
        """;

    // The generator's own ReservedNames list (Bit.Blex.Generators/BlexGenerator.cs), in its order.
    private const string Reserved = """
        Name                    Persist                 StateChanged
        PropertyChanged         SerializeState          DeserializeState
        InvalidateComputed      NotifyRestored          SetState
        SetEffectState          BeginEffect             EndEffect
        DebounceEffectAsync     RunEffectAttemptsAsync  Dispatch
        DispatchAsync           BeginAction             DispatchApprovedAsync
        Batch                   ResetState              RestoreState
        IsRestoring             IsObserved              Dispose
        IsDisposed              CancelEffects           InstanceKey
        WithInstanceKey         TimeProvider            ActionDescriptors
        FindAction              DescribeActions         EnforcesActions
        TransientStateKeys      CaptureRollbackState    ApplyRollbackState
        """;

