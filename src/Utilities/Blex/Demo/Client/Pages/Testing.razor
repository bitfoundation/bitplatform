    private const string Plain = """
        [Fact]
        public void Increment_adds_the_step()
        {
            var store = new CounterStore();

            store.SetStep(5);
            store.Increment();

            Assert.Equal(5, store.Count);
            Assert.Equal(10, store.DoubleCount);
        }
        """;

    private const string Harness = """
        using Bit.Blex.Testing;

        [Fact]
        public void Increment_dispatches_one_action()
        {
            using var harness = BlexTestHarness.For<CounterStore>();

            harness.Store.Increment();

            Assert.Equal(["Increment"], harness.Log.Names);
            Assert.Equal(1, harness.Snapshot()["Count"]!.GetValue<int>());
        }

        // For a store with dependencies, construct it yourself:
        using var harness = BlexTestHarness.For(new WeatherStore(httpClient));
        """;

    private const string Log = """
        using var harness = BlexTestHarness.For<CounterStore>();

        harness.Store.Increment();
        harness.Store.Increment();
        harness.Store.SetStep(3);

        Assert.Equal(3, harness.Log.Count);
        Assert.Equal(2, harness.Log.CountOf("Increment"));
        Assert.True(harness.Log.Contains("counter/SetStep"));
        Assert.Equal("SetStep", harness.Log.Last!.ActionName);

        // The state captured immediately after a specific action:
        var afterFirst = harness.Log.Actions[0].State;
        Assert.Equal(1, afterFirst["counter"]!["Count"]!.GetValue<int>());
        """;

    private const string Payload = """
        harness.Store.SetStep(5);

        var action = harness.Log.Last!;
        Assert.Equal("SetStep", action.ActionName);
        Assert.Single(action.Args);
        Assert.Equal("step", action.Args[0].Name);
        Assert.Equal(5, action.Args[0].Value);

        // A direct assignment records as "Set X", carrying the assigned value.
        harness.Store.Count = 42;
        Assert.Equal("Set Count", harness.Log.Last!.ActionName);
        Assert.Equal(42, harness.Log.Last!.Args[0].Value);
        """;

    private const string Effects = """
        [Fact]
        public async Task LoadUser_populates_the_user()
        {
            using var harness = BlexTestHarness.For(new UserStore(new FakeApi()));

            await harness.Store.LoadUser(42);

            Assert.False(harness.Store.LoadUserIsLoading);
            Assert.Null(harness.Store.LoadUserError);
            Assert.Equal("Ada", harness.Store.User!.Name);
        }

        [Fact]
        public async Task LoadUser_reports_loading_while_in_flight()
        {
            using var harness = BlexTestHarness.For(new UserStore(new SlowApi()));

            var pending = harness.Store.LoadUser(42);          // do not await yet
            Assert.True(harness.Store.LoadUserIsLoading);

            await pending;
            await harness.Store.WaitForAsync(() => !harness.Store.LoadUserIsLoading);
        }
        """;

    private const string EffectErrors = """
        [Fact]
        public async Task A_failing_effect_captures_the_exception()
        {
            using var harness = BlexTestHarness.For(new UserStore(new ThrowingApi()));

            await harness.Store.LoadUser(42);   // never throws

            Assert.IsType<HttpRequestException>(harness.Store.LoadUserError);
        }

        [Fact]
        public async Task Cancelling_is_not_an_error()
        {
            using var harness = BlexTestHarness.For(new UserStore(new SlowApi()));

            var pending = harness.Store.LoadUser(42);
            harness.Store.CancelLoadUser();
            await pending;

            Assert.Null(harness.Store.LoadUserError);   // our own cancellation is a normal outcome
        }
        """;

    private const string Notifications = """
        [Fact]
        public void An_action_notifies_once_however_many_fields_it_touches()
        {
            var store = new CounterStore();

            // OnApplyPreset assigns both Count and Step.
            var notifications = store.CountNotifications(() => store.ApplyPreset(10, 5));

            Assert.Equal(1, notifications);
        }
        """;

    private const string MiddlewareTest = """
        [Fact]
        public void A_filter_vetoes_the_action()
        {
            using var harness = BlexTestHarness.WithFilter<CounterStore>(_ => false);

            harness.Store.Increment();

            Assert.Equal(0, harness.Store.Count);   // the mutation never ran
            Assert.Empty(harness.Log.Actions);      // and nothing was recorded
        }

        [Fact]
        public void The_audit_middleware_sees_every_action()
        {
            var audit = new AuditMiddleware();
            using var harness = BlexTestHarness.WithMiddleware<CounterStore>(audit);

            harness.Store.Increment();

            Assert.Equal(["counter/Increment"], audit.Entries);
        }

