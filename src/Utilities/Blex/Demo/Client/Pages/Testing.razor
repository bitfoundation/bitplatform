    private const string Plain = """
        [Fact]
        public void Increment_adds_the_step()
        {
            var store = new CounterStore();

            store.SetStep(5);
            store.Increment();

            Assert.Equal(5, store.Count);
            Assert.Equal(10, store.DoubleCount);
        }
        """;

    private const string Harness = """
        using Bit.Blex.Testing;

        [Fact]
        public void Increment_dispatches_one_action()
        {
            using var harness = BlexTestHarness.For<CounterStore>();

            harness.Store.Increment();

            Assert.Equal(["Increment"], harness.Log.Names);
            Assert.Equal(1, harness.Snapshot()["Count"]!.GetValue<int>());
        }

        // For a store with dependencies, construct it yourself:
        using var harness = BlexTestHarness.For(new WeatherStore(httpClient));
        """;

    private const string Log = """
        using var harness = BlexTestHarness.For<CounterStore>();

        harness.Store.Increment();
        harness.Store.Increment();
        harness.Store.SetStep(3);

        Assert.Equal(3, harness.Log.Count);
        Assert.Equal(2, harness.Log.CountOf("Increment"));
        Assert.True(harness.Log.Contains("counter/SetStep"));
        Assert.Equal("SetStep", harness.Log.Last!.ActionName);

        // The state captured immediately after a specific action:
        var afterFirst = harness.Log.Actions[0].State;
        Assert.Equal(1, afterFirst["counter"]!["Count"]!.GetValue<int>());
        """;

    private const string Payload = """
        harness.Store.SetStep(5);

        var action = harness.Log.Last!;
        Assert.Equal("SetStep", action.ActionName);
        Assert.Single(action.Args);
        Assert.Equal("step", action.Args[0].Name);
        Assert.Equal(5, action.Args[0].Value);

        // A direct assignment records as "Set X", carrying the assigned value.
        harness.Store.Count = 42;
        Assert.Equal("Set Count", harness.Log.Last!.ActionName);
        Assert.Equal(42, harness.Log.Last!.Args[0].Value);
        """;

    private const string TypedPayload = """
        harness.Store.SetStep(2);
        harness.Store.ApplyPreset(10, 5);
        harness.Store.SetStep(3);

        Assert.Equal([2, 3], harness.Log.PayloadsOf(CounterStore.Actions.SetStep));
        Assert.Equal(2, harness.Log.CountOf(CounterStore.Actions.SetStep));

        // Several parameters come back as a tuple named after them:
        var preset = Assert.Single(harness.Log.PayloadsOf(CounterStore.Actions.ApplyPreset));
        Assert.Equal((10, 5), (preset.Count, preset.Step));

        // A failure reads the same way:
        Assert.True(UserStore.Actions.LoadUser.TryGetPayload(harness.Failures[0], out var userId));
        """;

    private const string Time = """
        using Microsoft.Extensions.Time.Testing;

        [Fact]
        public async Task Search_runs_once_the_typing_settles()
        {
            var time = new FakeTimeProvider();
            using var harness = BlexTestHarness.For(new SearchStore(new FakeApi()));
            harness.TimeProvider = time;                       // [BlexEffect(DebounceMilliseconds = 300)]

            var first = harness.Store.TypeAhead("bl");
            var second = harness.Store.TypeAhead("blex");

            time.Advance(TimeSpan.FromMilliseconds(299));
            Assert.Empty(harness.Log.Actions);                 // still inside the quiet period

            time.Advance(TimeSpan.FromMilliseconds(1));
            await Task.WhenAll(first, second);

            Assert.Equal(["blex"], harness.Log.PayloadsOf(SearchStore.Actions.TypeAhead));
        }

        // Without the harness - and for a debounced persistor, which reads the manager's clock too:
        var manager = new BlexManager { TimeProvider = time };
        """;

    private const string Replay = """
        [Fact]
        public async Task The_same_actions_arrive_at_the_same_state()
        {
            using var original = BlexTestHarness.For<CartStore>();
            original.Store.Add("apple");
            original.Store.SetQuantity("apple", 3);
            await original.Store.ApplyCoupon("SPRING");          // effects replay too

            using var replica = BlexTestHarness.For<CartStore>();
            await replica.Manager.ReplayAsync(original.Log.Actions);

            Assert.Equal(original.Snapshot().ToJsonString(), replica.Snapshot().ToJsonString());
        }
        """;

