        [Fact]
        public void Two_stores_share_one_filter()
        {
            var manager = new BlexManager([new BlexFilterMiddleware(ctx => ctx.Store.Name != "cart")]);
            manager.Register(new CartStore());
            manager.Register(new ProfileStore());
            using var log = manager.RecordActions();
            ...
        }
        """;

    private const string MultiStore = """
        [Fact]
        public void PlacingAnOrder_NotifiesTheUser()
        {
            using var harness = BlexTestHarness.For<OrdersStore>();
            var notifications = harness.Register(new NotificationsStore());

            using var wiring = harness.Manager.SubscribeTo<OrdersStore>(
                ctx => notifications.Push($"order: {ctx.ActionName}"));

            harness.Store.Place("Widget", 2);

            // One log, both stores:
            Assert.Equal(
                new[] { "orders/Place", "notifications/Push" },
                harness.Log.QualifiedNames);

            Assert.Equal(1, notifications.Unread);
        }

        [Fact]
        public async Task CheckoutSettlesAcrossStores()
        {
            using var harness = BlexTestHarness.For<CartStore>();
            var orders = harness.Register(new OrdersStore());

            var checkout = harness.Store.Checkout();

            await harness.Manager.WaitForAsync(
                () => !harness.Store.CheckoutIsLoading && orders.Count == 1);

            await checkout;
        }
        """;

    private const string FailureTest = """
        [Fact]
        public async Task AFailingLoad_IsReportedWithItsArguments()
        {
            using var harness = BlexTestHarness.For<DataStore>();
            harness.Store.ShouldThrow = true;

            // The effect wrapper captures the exception, so there is nothing to Assert.Throws on.
            await harness.Store.Load("orders");

            Assert.NotNull(harness.Store.LoadError);

            var failure = Assert.Single(harness.Failures);
            Assert.Equal("data/Load", failure.QualifiedName);
            Assert.Equal("orders", failure.Args[0].Value);
        }
        """;

    private const string PersistenceTest = """
        private sealed class MemoryStorage : IBlexStorage
        {
            public Dictionary<string, string> Values { get; } = [];

            public ValueTask<string?> GetAsync(string key, CancellationToken ct = default)
                => new(Values.TryGetValue(key, out var v) ? v : null);

            public ValueTask SetAsync(string key, string value, CancellationToken ct = default)
            {
                Values[key] = value;
                return ValueTask.CompletedTask;
            }

            public ValueTask RemoveAsync(string key, CancellationToken ct = default)
            {
                Values.Remove(key);
                return ValueTask.CompletedTask;
            }
        }

        [Fact]
        public async Task State_round_trips_through_storage()
        {
            var storage = new MemoryStorage();
            var manager = new BlexManager();
            var store = new SettingsStore();
            manager.Register(store);

            await using var persistor = new BlexStatePersistor(manager, storage);
            await persistor.StartAsync();

            store.SetAccent("teal");
            await persistor.FlushAsync();

            Assert.Contains("teal", storage.Values["blex:settings"]);

            // A fresh store rehydrates from the same storage.
            var manager2 = new BlexManager();
            var store2 = new SettingsStore();
            manager2.Register(store2);
            await using var persistor2 = new BlexStatePersistor(manager2, storage);
            await persistor2.StartAsync();

            Assert.Equal("teal", store2.Accent);
        }
        """;

    private const string HistoryTest = """
        [Fact]
        public void Undo_restores_the_previous_state()
        {
            var manager = new BlexManager();
            var store = new CounterStore();
            manager.Register(store);

            using var history = new BlexHistory(manager);
            history.Start();

            store.Increment();
            store.Increment();
            Assert.Equal(2, store.Count);

            history.Undo();
            Assert.Equal(1, store.Count);
            Assert.True(history.CanRedo);

            history.Redo();
            Assert.Equal(2, store.Count);
        }
        """;

    private const string Bunit = """
        [Fact]
        public void The_component_renders_the_current_count()
        {
            using var ctx = new Bunit.TestContext();
            ctx.Services.AddBitBlexServices();
            ctx.Services.AddBitBlexStore<CounterStore>();

            var component = ctx.RenderComponent<Counter>();
            var store = ctx.Services.GetRequiredService<CounterStore>();

            component.Find("button.increment").Click();

            Assert.Equal(1, store.Count);
            component.MarkupMatches("<p>Count: 1</p>*");
        }
        """;
