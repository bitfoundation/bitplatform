@page "/diagnostics"

<DocPage Href="diagnostics" Title="Compile-time diagnostics"
         Lead="The generator validates every store and fails the build with a precise message rather than emitting code that does not compile.">

    <div class="bb-card">
        <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Overview</h3>
        <p>
            All @DiagnosticsCatalog.All.Count diagnostics live in the <code>Bit.Blex.Generators</code> category. Of
            those, @ErrorCount are errors - they describe shapes the generator genuinely cannot emit - and @WarningCount
            are warnings about code that compiles but almost certainly does not do what you meant.
        </p>

        <div class="bb-scroll">
            <table class="bb-table">
                <thead>
                    <tr><th>Code</th><th>Severity</th><th>Summary</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in DiagnosticsCatalog.All)
                    {
                        <tr>
                            <td class="bb-table-key"><a href="diagnostics#@d.Code.ToLowerInvariant()"><code>@d.Code</code></a></td>
                            <td class="bb-table-key">
                                @if (d.IsError)
                                {
                                    <span class="bb-badge bb-badge-danger">Error</span>
                                }
                                else
                                {
                                    <span class="bb-badge bb-badge-warn">Warning</span>
                                }
                            </td>
                            <td>@d.Title</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Callout Kind="Callout.CalloutKind.Note" Title="Nothing is emitted for a rejected store">
            <p>
                When a store fails validation, the generator reports the diagnostic and emits
                <em>no</em> partial for it. Expect a cascade of "does not contain a definition for
                <code>Count</code>" errors alongside the Blex diagnostic - fix the Blex one first and
                the rest disappear.
            </p>
        </Callout>
    </div>

    <div class="bb-card">
        <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Suppressing a warning</h3>
        <p>
            The @WarningCount warnings are suppressible like any other. Blex's own test project suppresses
            <code>BLEX011</code> project-wide, because it has a fixture that deliberately declares a
            value-returning action.
        </p>
        <CodeBlock Code="@Suppress" Language="xml" FileName="MyApp.csproj" />
        <CodeBlock Code="@SuppressLocal" Title="Or locally" />
    </div>

    @foreach (var d in DiagnosticsCatalog.All)
    {
        <div class="bb-card" id="@d.Code.ToLowerInvariant()">
            <h3 class="bb-card-title"><span class="bb-dot @(d.IsError ? "bb-dot-danger" : "bb-dot-warning")"></span> <code>@d.Code</code> - @d.Title</h3>
            <p>@((MarkupString)d.Cause)</p>
            @if (!string.IsNullOrEmpty(d.Bad))
            {
                <CodeBlock Code="@d.Bad" Title="Rejected" />
            }
            @if (!string.IsNullOrEmpty(d.Good))
            {
                <CodeBlock Code="@d.Good" Title="Fix" />
            }
        </div>
    }

</DocPage>

@code {
    // Counted rather than written out, so the prose cannot fall behind the generator again.
    private static readonly int ErrorCount = DiagnosticsCatalog.All.Count(d => d.IsError);
    private static readonly int WarningCount = DiagnosticsCatalog.All.Count - ErrorCount;

    private const string Suppress = """
        <PropertyGroup>
          <NoWarn>$(NoWarn);BLEX011</NoWarn>
        </PropertyGroup>
        """;

    private const string SuppressLocal = """
        #pragma warning disable BLEX011
        [BlexAction] private int OnIncrement() => ++Count;
        #pragma warning restore BLEX011
        """;
}
