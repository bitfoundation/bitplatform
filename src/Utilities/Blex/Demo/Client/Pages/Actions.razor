    private int _notifications;
    private int _actions;
    private int _lastBatchNotifications;
    private int _lastBatchActions;

    [Inject] private BlexManager Manager { get; set; } = default!;

    private sealed record DispatchPreset(string Label, string Name, string Payload);

    private static readonly DispatchPreset[] DispatchPresets =
    [
        new("Apply preset", "counter/Apply preset", """{ "count": 7, "step": 2 }"""),
        new("SetStep", "counter/SetStep", """{ "step": 3 }"""),
        new("Set Count", "counter/Set Count", """{ "Count": 42 }"""),
        new("ResetState", "counter/ResetState", ""),
        new("An unknown action", "counter/Teleport", ""),
    ];

    private string _dispatchName = DispatchPresets[0].Name;
    private string _dispatchPayload = DispatchPresets[0].Payload;
    private string? _dispatchError;
    private string _lastPreset = "-";

    private string? _enforceError;
    private string _rollbackNote = "";
    private string _transactionNote = "";
    private int _progressNotifications;
    private int _progressActions;

    protected override void OnInitialized()
    {
        Subscribe(Counter, Account, Wallet, Ledger, Progress);
        Counter.StateChanged += CountNotification;
        Progress.StateChanged += CountProgressNotification;

        // OwnsSubscription hands the token to the base class, which disposes it with the component.
        OwnsSubscription(Manager.SubscribeTo<CounterStore>(_ => _actions++));
        OwnsSubscription(Manager.SubscribeTo<ProgressStore>(_ => _progressActions++));

        // Typed: the payload arrives as the (int Count, int Step) tuple the action takes.
        OwnsSubscription(Manager.SubscribeToAction(CounterStore.Actions.ApplyPreset,
            (_, preset) => _lastPreset = $"Count {preset.Count}, Step {preset.Step}"));
    }

    private void RunEnforced(Action act)
    {
        _enforceError = null;
        try
        {
            act();
        }
        catch (InvalidOperationException ex)
        {
            _enforceError = ex.Message;
        }
    }

    /// <summary>
    /// Runs one withdrawal and says what it left behind: whether it threw, and which actions it recorded - the
    /// difference between a store that keeps a failed action's changes and one that rolls them back.
    /// </summary>
    private string Attempt(string store, Action act)
    {
        var recorded = new List<string>();
        using var recording = Manager.Subscribe(ctx => recorded.Add(ctx.QualifiedName));
        try
        {
            act();
            return $"Withdrawn from {store}, and recorded as {string.Join(", ", recorded)}.";
        }
        catch (InvalidOperationException ex)
        {
            return recorded.Count == 0
                ? $"\"{ex.Message}\" reached the caller, and {store} is exactly as it was: nothing was notified, recorded, persisted or added to the undo history."
                : $"\"{ex.Message}\" reached the caller - and {store} kept what the action changed before the throw, recorded as {string.Join(", ", recorded)}.";
        }
    }

    private void Transfer(decimal amount, bool decline)
    {
        var recorded = new List<string>();
        using var recording = Manager.Subscribe(ctx => recorded.Add(ctx.QualifiedName));
        try
        {
            Manager.Transaction(() =>
            {
                Wallet.Withdraw(amount);
                Ledger.Deposit(amount);

                if (decline)
                    throw new InvalidOperationException("The bank declined the transfer.");
            });

            _transactionNote = $"Committed: {string.Join(", ", recorded)}.";
        }
        catch (InvalidOperationException ex)
        {
            _transactionNote = $"\"{ex.Message}\" - after {(recorded.Count == 0 ? "no action" : string.Join(", ", recorded))}. "
                + "Every store the body changed was put back in one restore, so both balances are what they were before the transfer.";
        }
    }

    private void ResetLedgers()
    {
        Wallet.ResetState();
        Ledger.ResetState();
        _rollbackNote = "";
        _transactionNote = "";
    }

    private void CountProgressNotification() => _progressNotifications++;

    private async Task RunProgress()
    {
        _progressNotifications = 0;
        _progressActions = 0;
        await Progress.Run(20, 100);
    }

    private Task Preset(DispatchPreset preset)
    {
        _dispatchName = preset.Name;
        _dispatchPayload = preset.Payload;
        return DispatchByName();
    }

    private Task OnDispatchKeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? DispatchByName() : Task.CompletedTask;

    private async Task DispatchByName()
    {
        _dispatchError = null;
        try
        {
            var payload = string.IsNullOrWhiteSpace(_dispatchPayload) ? null : JsonNode.Parse(_dispatchPayload) as JsonObject;
            await Manager.DispatchAsync(_dispatchName.Trim(), payload);
        }
        catch (Exception ex)
        {
            // Whatever was typed: an unknown name (InvalidOperationException), a missing or null argument
            // (ArgumentException), malformed JSON or a value that does not convert (JsonException) - or the action's
            // own throw, since any store's action can be named here. A typo must not take the app down.
            _dispatchError = ex.Message;
        }
    }

    private void CountNotification() => _notifications++;

    private void Measure(Action act)
    {
        _notifications = 0;
        _actions = 0;
        act();
        _lastBatchNotifications = _notifications;
        _lastBatchActions = _actions;
    }

    // Every button moves both fields on from where they are, so a second click has as much to report as the first.
    private void DirectAssignment() => Measure(() =>
    {
        Counter.Count += 10;
        Counter.Step += 1;
    });

    private void ViaAction() => Measure(() => Counter.ApplyPreset(Counter.Count + 20, Counter.Step + 1));

    // Not "Apply preset": that is the action's own name, so the typed ApplyPreset subscription above would take
    // this argument-less batch for it and fail to read its payload.
    private void ViaBatch() => Measure(() => Counter.Batch("Apply preset (batched)", () =>
    {
        Counter.Count += 30;
        Counter.Step += 1;
    }));

    // BlexComponentBase owns IDisposable; this is its hook for extra cleanup.
    protected override void Dispose(bool disposing)
    {
        Counter.StateChanged -= CountNotification;
        Progress.StateChanged -= CountProgressNotification;
    }

