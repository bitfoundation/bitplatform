    private const string Debounce = """
        builder.Services.AddBitBlexLocalStoragePersistence(options =>
        {
            // One write per quiet 300 ms...
            options.DebounceInterval = TimeSpan.FromMilliseconds(300);
            // ...but never postpone a pending change by more than 2 s.
            options.DebounceMaxDelay = TimeSpan.FromSeconds(2);
        });
        """;

    private const string Migrate = """
        builder.Services.AddBitBlexLocalStoragePersistence(options =>
        {
            options.Version = 2;
            options.Migrate = (storeName, fromVersion, state) =>
            {
                if (storeName != "settings")
                    return state;

                if (fromVersion < 2)
                {
                    // v1 stored a bool; v2 stores an enum.
                    var compact = state["Compact"]?.GetValue<bool>() ?? false;
                    state["Density"] = compact ? "Compact" : "Comfortable";
                    state.Remove("Compact");
                }

                return state;      // or null to discard the payload entirely
            };
        });
        """;

    private const string StoreVersion = """
        // Raised when the saved layout no longer fits. The other stores keep their saved state.
        [BlexStore(Name = "layout", Persist = true, Version = 2)]
        public partial class LayoutStore
        {
            [BlexState] private string _view = "grid";
        }

        // The one Migrate from above, with an arm for the layout. A scoped layout with a key is "layout:{key}".
        options.Migrate = (storeName, fromVersion, state) => storeName.Split(':')[0] switch
        {
            // The layout's own versions: 1, or 0 for what it saved before it had one. Keep all but the
            // removed "table" view; without this arm, the hook would keep that too.
            "layout" => state["View"]?.GetValue<string>() == "table" ? null : state,
            "settings" when fromVersion < 2 => UpgradeSettings(state),   // the v1 to v2 step above
            _ => state,
        };
        """;

