    private const string RollbackSample = """
        _add = Watch(QueryClient.Mutation<Todo, Todo>(
            (todo, ct) => Api.AddAsync(todo, ct),
            new()
            {
                OnMutate = todo =>
                {
                    var list = QueryClient.Optimistic<IReadOnlyList<Todo>>(["todos"], todos => [.. todos ?? [], todo]);
                    Badge.Increment();                                      // a store, outside the cache

                    // Undone together on failure, the badge first.
                    return BlexRollback.Combine(list, BlexRollback.From(Badge.Decrement));
                },
                OnSuccess = (saved, _) => QueryClient.SetQueryData(["todos", saved.Id], saved),
                OnError = (error, todo) => Toasts.Show($"\"{todo.Title}\" was not saved: {error.Message}"),
                OnSettled = _ => _input = "",
                Invalidates = ["todos"],
                RetryCount = 2,
            }));
        """;

