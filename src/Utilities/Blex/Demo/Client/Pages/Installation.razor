@page "/installation"

<DocPage Href="installation" Title="Installation"
         Lead="One package, one DI call per store, and one component wrapped around your router.">

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Packages</h2>
        <p>
            Reference <code>Bit.Blex</code>. It carries the runtime, the source generator that turns your
            <code>[BlexStore]</code> classes into reactive stores, and the Blazor integration (the
            <code>Bit.Blex.Blazor</code> namespace). The generator ships inside the package as an analyzer
            (under <code>analyzers/dotnet/cs</code>), so it adds nothing to your app's output - but NuGet
            does not flow analyzers to projects that only get a package transitively, so reference
            <code>Bit.Blex</code> directly from every project that declares stores. Every runtime package
            targets <code>net10.0</code> and <code>net11.0</code>.
        </p>

        <CodeBlock Code="@Install" Language="bash" Title="Add the packages" />

        <p>Or directly in the project file:</p>
        <CodeBlock Code="@CsprojSample" Language="xml" FileName="MyApp.csproj" />

        <Callout Kind="Callout.CalloutKind.Note" Title="Working inside this repository">
            <p>
                The sample and docs projects live next to the sources, so they reference the generator
                as an analyzer <em>project</em> reference instead of consuming the published package:
                <code>&lt;ProjectReference Include="..\..\Bit.Blex.Generators\Bit.Blex.Generators.csproj"
                OutputItemType="Analyzer" ReferenceOutputAssembly="false" /&gt;</code>.
            </p>
        </Callout>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Register the services</h2>
        <p>
            <code>AddBitBlexServices</code> registers the manager and the middleware pipeline;
            <code>AddBitBlexStore&lt;T&gt;</code> registers each store as a scoped service exposed both as
            its concrete type and as <code>IBlexStore</code>. A store is attached to the manager on first
            resolution, so its actions are observed even in hosts without a provider component - console
            apps, workers and tests included.
        </p>

        <CodeBlock Code="@ProgramSample" FileName="Program.cs" />

        <ApiTable Title="Registration APIs" Rows="@RegistrationRows" MemberHeader="Call" />

        <p>
            Every call takes a <code>lifetime</code>, <code>Scoped</code> by default - one manager, one set of stores
            per Blazor Server circuit, per WebAssembly app, per test scope. Give them all the same one: a host with no
            scopes registers <code>Singleton</code> throughout, which is what the <a href="maui">.NET MAUI</a>
            builder extensions do for you.
        </p>

        <ApiTable Title="BlexOptions - what AddBitBlexServices configures" Rows="@OptionRows" MemberHeader="Option" />
    </div>

    <div class="bb-card" id="hosting">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Hosting models</h2>
        <p>
            The store code is the same everywhere; what differs is which DI container registers Blex and where
            <code>&lt;BlexProvider&gt;</code> goes.
        </p>
        <div class="bb-scroll" tabindex="0" role="region" aria-label="Blex setup per hosting model">
            <table class="bb-table bb-compare demo-key-wide">
                <thead><tr><th>Host</th><th>Register Blex in, and what is worth knowing</th></tr></thead>
                <tbody>
                    <tr>
                        <td>Blazor Server<br /><span class="bb-muted">InteractiveServer</span></td>
                        <td>The server's <code>Program.cs</code>. Every circuit is a scope, so each user gets their own manager and stores. Browser storage is unreachable while prerendering; <code>&lt;BlexProvider&gt;</code> hydrates on the first interactive render instead. Set <code>EnableDevTools="false"</code> unless you want the state tree streamed over the circuit.</td>
                    </tr>
                    <tr>
                        <td>Blazor Web App<br /><span class="bb-muted">InteractiveWebAssembly, prerendered</span></td>
                        <td><strong>Both</strong> <code>Program.cs</code> files, through one shared extension method. The server prerenders the same components the browser then runs, so both containers must resolve every store. Prerendered state is handed over through <code>PersistentComponentState</code>. This site is wired exactly this way.</td>
                    </tr>
                    <tr>
                        <td>Blazor Web App<br /><span class="bb-muted">InteractiveAuto</span></td>
                        <td>Both, as above. A first visit runs on the server, a later one in WebAssembly, and a store starts over when the runtime changes: mark what must survive the switch <code>Persist = true</code>.</td>
                    </tr>
                    <tr>
                        <td>Static server rendering</td>
                        <td>The server's <code>Program.cs</code>. <code>&lt;BlexProvider&gt;</code> renders its content and the stores render their state; nothing that needs JS interop - browser storage, the DevTools bridge - is attempted, and nothing fails for want of it. Persistence and DevTools need the provider inside an interactive boundary.</td>
                    </tr>
                    <tr>
                        <td>Standalone Blazor WebAssembly</td>
                        <td><code>Program.cs</code>. One container, no prerendering - the samples above, as written.</td>
                    </tr>
                    <tr>
                        <td>.NET MAUI Blazor Hybrid</td>
                        <td><code>MauiProgram.cs</code>, scoped as in Blazor: the <code>BlazorWebView</code> creates the scope. No browser extension exists in a WebView, so set <code>EnableDevTools="false"</code>. Persist to the WebView's <code>localStorage</code> or to OS-native <code>Preferences</code>. See <a href="maui">.NET MAUI</a>.</td>
                    </tr>
                    <tr>
                        <td>.NET MAUI<br /><span class="bb-muted">native XAML</span></td>
                        <td><code>MauiProgram.cs</code>, through <code>builder.UseBitBlex()</code>. No scopes and no <code>&lt;BlexProvider&gt;</code>: the <code>Bit.Blex.Maui</code> builder extensions register singletons and do the provider's startup work at <code>MauiApp.Build()</code>. XAML binds to stores directly. See <a href="maui">.NET MAUI</a>.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <Callout Kind="Callout.CalloutKind.Tip" Title="Ask the MCP server for a working project">
            <p>
                <a href="mcp"><code>GetBlexSetupGuide</code></a> returns the checklist and the real files of a
                working project for each of these hosts - <code>server</code>, <code>wasm</code>, <code>auto</code>,
                <code>standalone-wasm</code>, <code>maui-hybrid</code> and <code>maui</code>.
            </p>
        </Callout>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Add the provider</h2>
        <p>
            <code>&lt;BlexProvider&gt;</code> goes once, near the root of the app, wrapping the router.
            On initialization it registers every <code>IBlexStore</code> with the manager, restores
            prerendered and persisted state, and starts undo/redo recording; on first render it connects
            the Redux DevTools bridge.
        </p>

        <CodeBlock Code="@AppSample" Language="razor" FileName="App.razor" />

        <ApiTable Title="&lt;BlexProvider&gt; parameters" Rows="@ProviderRows" MemberHeader="Parameter" />

        <Callout Kind="Callout.CalloutKind.Warning" Title="Turn DevTools off in production">
            <p>
                While enabled, the entire application state tree is serialized and handed to the Redux
                DevTools browser extension on every action. Bind <code>EnableDevTools</code> to your host
                environment so production builds never expose application state to an installed extension.
                See <a href="devtools">DevTools &amp; time travel</a> for redaction options.
            </p>
        </Callout>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Without Blazor</h2>
        <p>
            Stores, the manager and persistence never touch Blazor or JavaScript - only the
            <code>Bit.Blex.Blazor</code> namespace does. In a console app, worker or test, resolve
            the stores from DI (which registers them with the manager) and drive them directly. For
            persistence, implement <code>IBlexStorage</code> over a file or database and call
            <code>AddBitBlexPersistence()</code>.
        </p>

        <CodeBlock Code="@HeadlessSample" Title="Headless host" />
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Trimming and AOT</h2>
        <p>
            Snapshots - <code>SerializeState</code>, persistence, the DevTools payload - go through
            <code>System.Text.Json</code>. By default that is the reflection-based serializer, whose
            metadata a trimmed publish (the Blazor WebAssembly release default) is free to strip for
            types it cannot see being used. Point the shared options at a source-generated context and
            every generated snapshot uses it instead.
        </p>
        <CodeBlock Code="@AotSample" FileName="Program.cs" />

        <Callout Kind="Callout.CalloutKind.Tip" Title="Register the state types, not the stores">
            <p>
                A store class is never serialized - only the value of each <code>[BlexState]</code>
                field, one property at a time. So the context needs <code>CartLine</code> and
                <code>BlexEntityState&lt;Todo, int&gt;</code>, not <code>CartStore</code>. A store whose
                state is all primitives and strings needs nothing at all.
            </p>
        </Callout>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Requirements</h2>
        <ul class="bb-detail-list">
            <li><strong>.NET 10 or 11</strong> for <code>Bit.Blex</code>, <code>Bit.Blex.Maui</code> and <code>Bit.Blex.Testing</code> - each ships <code>net10.0</code> and <code>net11.0</code> builds.</li>
            <li><strong>netstandard2.0</strong> for the generator, as Roslyn analyzers require.</li>
            <li>Nullable reference types are supported and expected; generated code is annotated.</li>
        </ul>
    </div>

</DocPage>

@code {
    private static readonly IReadOnlyList<ApiTable.Row> RegistrationRows =
    [
        new("AddBitBlexServices(Action&lt;BlexOptions&gt;?, ServiceLifetime = Scoped)", "Registers <code>BlexManager</code> and the middleware pipeline. The options object configures the DevTools name, sanitizers, middleware, logging, the clock and the error sinks - every option is listed below."),
        new("AddBitBlexStore&lt;TStore&gt;(ServiceLifetime = Scoped)", "Registers a store, resolvable both as <code>TStore</code> and as <code>IBlexStore</code>. Constructor dependencies are injected, so a store can take an <code>HttpClient</code> like any other service. A <a href=\"scoped-stores\">scoped store</a> is not registered here."),
        new("AddBitBlexPersistence(Action&lt;BlexPersistenceOptions&gt;?, ServiceLifetime = Scoped)", "Enables durable persistence for stores marked <code>Persist = true</code>. Requires an <code>IBlexStorage</code> registration. See <a href=\"persistence\">Persistence</a>."),
        new("AddBitBlexLocalStoragePersistence(…)", "Blazor: registers <code>BlexBrowserStorage</code> over <code>window.localStorage</code> and calls <code>AddBitBlexPersistence</code>."),
        new("AddBitBlexSessionStoragePersistence(…)", "Blazor: the same, over <code>window.sessionStorage</code> - cleared when the tab closes."),
        new("AddBitBlexQueries(Action&lt;BlexQueryClientOptions&gt;?, ServiceLifetime = Scoped)", "Registers <code>BlexQueryClient</code>, the server-state cache behind <code>UseQuery</code> and <code>&lt;BlexQueryView&gt;</code>. See <a href=\"queries\">Server state &amp; queries</a>."),
        new("AddBitBlexHistory(int maxEntries = 100, lifetime, filter?, groupBy?)", "Registers <code>BlexHistory</code> for in-app undo/redo. <code>&lt;BlexProvider&gt;</code> starts recording once rehydration completes. An overload takes a <code>scope</code> over the stores it covers. See <a href=\"history\">Undo &amp; redo</a>."),
        new("AddBitBlexHistory&lt;TStore&gt;(int maxEntries = 100, lifetime, filter?, groupBy?)", "Registers <code>BlexHistory&lt;TStore&gt;</code>: an undo stack over one store type, beside or instead of the app-wide one."),
    ];

    private static readonly IReadOnlyList<ApiTable.Row> OptionRows =
    [
        new("string DevToolsName", "The instance name in the Redux DevTools dropdown. Default <code>\"Blex\"</code>. See <a href=\"devtools\">DevTools</a>."),
        new("RedactDevToolsKeys(params string[]) / DevToolsStateSanitizer / DevToolsActionSanitizer", "What the DevTools monitor is shown - redacted keys, a rewritten tree, rewritten action labels."),
        new("UseMiddleware&lt;T&gt;() / UseMiddleware(instance) / UseMiddleware(Action&lt;BlexActionContext&gt;)", "Middleware that observes every action, run in registration order. See <a href=\"middleware\">Middleware</a>."),
        new("UseFilter(predicate) / UseFilter(BlexAction&lt;…&gt;, predicate)", "Veto filters - for every action, or for one action by its typed descriptor."),
        new("UseLogging(LogLevel actionLevel = Debug)", "Every action, action failure and isolated failure to the host's <code>ILogger</code>. See <a href=\"errors#observability\">Logging and tracing</a>."),
        new("Action&lt;BlexError&gt;? OnError", "The sink for every failure Blex isolates from the pipeline. Without one they go to <code>Console.Error</code>. See <a href=\"errors\">Error isolation</a>."),
        new("Action&lt;BlexActionErrorContext&gt;? OnActionError", "Hears every action body that throws - an effect's captured failure included. The exception still propagates."),
        new("TimeProvider? TimeProvider", "The clock for timestamps, debounces, retries and the query cache. Unset: one registered in the container, else the system clock. See <a href=\"testing#time\">Deterministic time</a>."),
        new("bool ReportOffDispatcherChanges", "Report a store changed off the renderer's dispatcher (source <code>\"dispatcher\"</code>). Default <code>true</code>. See <a href=\"stores#dispatcher\">Threads and the dispatcher</a>."),
        new("bool DetectInPlaceMutations", "Development aid: report an action that changed state without assigning a property (source <code>\"mutation\"</code>). Default <code>false</code>. See <a href=\"stores#change-detection\">Change detection</a>."),
    ];

    private static readonly IReadOnlyList<ApiTable.Row> ProviderRows =
    [
        new("EnableDevTools", "<code>bool</code>, default <code>true</code>. Connects the Redux DevTools bridge on first render. Set to <code>false</code> in production."),
        new("PersistComponentState", "<code>bool</code>, default <code>true</code>. Hands prerendered store state to the interactive render through Blazor's <code>PersistentComponentState</code>, avoiding the prerender \"double render\" flicker. No effect when the framework service is unavailable."),
        new("ChildContent", "The application content rendered inside the provider."),
    ];

    private const string Install = """
        dotnet add package Bit.Blex

        # .NET MAUI: XAML-bindable stores, the startup initializer, Preferences persistence
        dotnet add package Bit.Blex.Maui

        # optional, for unit tests
        dotnet add package Bit.Blex.Testing
        """;

    private const string CsprojSample = """
        <ItemGroup>
          <PackageReference Include="Bit.Blex" Version="11.0.0-pre-13" />
        </ItemGroup>
        """;

    private const string ProgramSample = """
        using Bit.Blex;
        using Bit.Blex.Blazor;

        var builder = WebAssemblyHostBuilder.CreateDefault(args);
        builder.RootComponents.Add<App>("#app");

        builder.Services.AddBitBlexServices(options =>
        {
            options.DevToolsName = "My App";
            options.UseMiddleware(ctx => Console.WriteLine($"[blex] {ctx.QualifiedName}"));
        });

        builder.Services.AddBitBlexStore<CounterStore>();
        builder.Services.AddBitBlexStore<TodoStore>();

        // Optional extras
        builder.Services.AddBitBlexLocalStoragePersistence();
        builder.Services.AddBitBlexHistory();

        await builder.Build().RunAsync();
        """;

    private const string AppSample = """
        @using Microsoft.AspNetCore.Components.WebAssembly.Hosting
        @inject IWebAssemblyHostEnvironment HostEnvironment

        <BlexProvider EnableDevTools="@HostEnvironment.IsDevelopment()">
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                </Found>
                <NotFound>
                    <p>Not found.</p>
                </NotFound>
            </Router>
        </BlexProvider>
        """;

    private const string AotSample = """
        [JsonSerializable(typeof(CartLine))]
        [JsonSerializable(typeof(BlexEntityState<Todo, int>))]
        internal partial class AppJsonContext : JsonSerializerContext;

        // Before any store is resolved or snapshotted -- the options instance becomes
        // read-only on first use, so this belongs in startup.
        BlexJson.Configure(o => o.TypeInfoResolver = AppJsonContext.Default);
        """;

    private const string HeadlessSample = """
        var services = new ServiceCollection();
        services.AddBitBlexServices();
        services.AddBitBlexStore<CounterStore>();

        var provider = services.BuildServiceProvider();

        // Resolving the store registers it with the manager.
        var store = provider.GetRequiredService<CounterStore>();
        var manager = provider.GetRequiredService<BlexManager>();

        store.Increment();
        Console.WriteLine(manager.CaptureGlobalState().ToJsonString());
        // {"counter":{"Count":1,"Step":1}}
        """;
}
