@page "/errors"
@inherits BlexComponentBase
@inject BlexManager Manager
@inject CounterStore Counter
@inject ErrorLog Log

<DocPage Href="errors" Title="Error isolation"
         Lead="Blex refuses to let a misbehaving observer break dispatch. Everything it swallows is handed to you instead.">

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> The problem</h2>
        <p>
            A dispatch fans out to middleware, the DevTools bridge, persistence, history and every
            subscriber. If any one of them throws and the exception escapes, the observers registered
            after it never run - persistence silently stops saving because an unrelated analytics handler
            had a bad day. Blex isolates each of those call sites and routes the failure to a single
            sink.
        </p>

        <CodeBlock Code="@Setup" FileName="Program.cs" />

        <p>
            Without a handler, isolated errors are written to <code>Console.Error</code> - visible in the
            browser console, but easy to miss. Setting <code>OnError</code> is the first thing to do in
            any real app.
        </p>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> BlexError</h2>
        <CodeBlock Code="@Record" />
        <ApiTable Rows="@ErrorRows" />
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> What gets reported</h2>
        <div class="bb-scroll">
            <table class="bb-table">
                <thead><tr><th>Source</th><th>Raised when</th></tr></thead>
                <tbody>
                    <tr><td class="bb-table-key"><code>subscriber</code></td><td>A handler passed to <code>Subscribe</code> / <code>SubscribeTo</code> / <code>SubscribeToAction</code> threw. <code>Detail</code> is the qualified action name.</td></tr>
                    <tr><td class="bb-table-key"><code>async reactor</code></td><td>A <code>SubscribeAsync</code> handler's task faulted.</td></tr>
                    <tr><td class="bb-table-key"><code>middleware</code></td><td>A middleware's <code>BeforeAction</code> or <code>OnAction</code> threw. The pipeline continues with the next middleware.</td></tr>
                    <tr><td class="bb-table-key"><code>persistence</code></td><td>Rehydrating, unprotecting, applying, serializing, protecting, scheduling or writing a persisted slice failed - including the hydration of a store that registered after startup (its saves stay held until it hydrates) and the save a leaving store still owed. <code>Detail</code> names the store or key.</td></tr>
                    <tr><td class="bb-table-key"><code>restore</code></td><td>A store's slice could not be deserialized during <code>RestoreGlobalState</code>, or a <code>StateRestored</code> handler threw. A failing store is skipped; the others still restore.</td></tr>
                    <tr><td class="bb-table-key"><code>devtools</code></td><td>A time-travel snapshot from the extension was malformed, a sanitizer threw, the JS bridge failed to load or send, or an action typed into the dispatcher could not be dispatched - not JSON, no <code>type</code>, an unknown action, a missing argument, or an action that threw.</td></tr>
                    <tr><td class="bb-table-key"><code>history</code></td><td>A <code>BlexHistory.Changed</code> handler threw while recording or after an external restore, or a history filter, <code>groupBy</code> or scope predicate threw.</td></tr>
                    <tr><td class="bb-table-key"><code>reset</code></td><td>A store failed to reset during <code>BlexManager.ResetAll()</code>. That store is skipped; the rest still reset.</td></tr>
                    <tr><td class="bb-table-key"><code>register</code></td><td>Two stores were registered under the same name, so their state slices, DevTools entries and storage keys collide - or a <code>StoreRegistered</code> handler threw.</td></tr>
                    <tr><td class="bb-table-key"><code>unregister</code></td><td>A <code>StoreUnregistered</code> handler threw as a store left the manager. <code>Detail</code> names the store.</td></tr>
                    <tr><td class="bb-table-key"><code>dispose</code></td><td>Cancelling a store's in-flight effects threw while the store was disposed - a scope closing, or the container being torn down. The rest of the disposal carries on. <code>Detail</code> names the store.</td></tr>
                    <tr><td class="bb-table-key"><code>prerender</code></td><td>Handing a store's state - or the query cache - across the prerender-to-interactive boundary failed. The store simply renders from its own state instead, and a query fetches again - the worst case is rendering twice.</td></tr>
                    <tr><td class="bb-table-key"><code>dispatcher</code></td><td>A store changed outside the dispatcher its state belongs to (a timer, a background task, a SignalR handler). The change applied, but raced the renderer. <code>Detail</code> names the store. See <a href="stores#dispatcher">Threads and the dispatcher</a>.</td></tr>
                    <tr><td class="bb-table-key"><code>mutation</code></td><td>With <code>DetectInPlaceMutations</code> on: an action changed state without assigning a property. <code>Detail</code> is the qualified action name.</td></tr>
                    <tr><td class="bb-table-key"><code>query</code></td><td>A query observer's or mutation's handler threw, a mutation callback threw, or a handed-over query could not be read. <code>Detail</code> is the query key, when there is one.</td></tr>
                </tbody>
            </table>
        </div>

        <DemoCard Title="Break a subscriber on purpose"
                  Description="This registers a subscriber that throws on the next counter/Increment. The action still applies, the other observers still run, and the failure lands in the log below - and in the Inspector's Errors tab."
                  Source="@DemoSource">
            <div class="bb-toolbar">
                <button class="btn demo-btn-danger" @onclick="BreakSubscriber">Arm a throwing subscriber, then increment</button>
                <button class="btn btn-secondary" @onclick="Counter.Increment">Plain increment</button>
                <button class="btn btn-secondary" @onclick="Log.Clear">Clear log</button>
            </div>

            <div class="bb-stats">
                <div class="bb-stat">
                    <span class="bb-stat-label">Count</span>
                    <span class="bb-stat-value demo-accent"><Persisted>@Counter.Count</Persisted></span>
                </div>
                <div class="bb-stat">
                    <span class="bb-stat-label">Errors captured</span>
                    <span class="bb-stat-value">@Log.Errors.Count</span>
                </div>
            </div>

            @if (Log.Errors.Count > 0)
            {
                <ul class="err-list">
                    @foreach (var error in Log.Errors)
                    {
                        <li>
                            <span class="err-list__source">@error.Source</span>
                            <span class="err-list__detail">@error.Detail</span>
                            <span class="err-list__msg">@error.Exception.Message</span>
                        </li>
                    }
                </ul>
            }
            <p class="bb-card-desc">
                Note that <code>Count</code> still went up. The mutation had already been applied when the
                subscriber ran - isolation protects the pipeline, it does not roll anything back.
            </p>
        </DemoCard>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Guarantees</h2>
        <ul class="bb-detail-list">
            <li>
                <strong>The mutation is recorded even if a subscriber throws.</strong> A standalone
                <code>Set X</code> whose <code>StateChanged</code> handler throws is still recorded,
                because the state genuinely changed - skipping the record would leave persistence,
                history and DevTools out of sync with reality.
            </li>
            <li>
                <strong>Sanitizers fail closed.</strong> If your DevTools state sanitizer throws, Blex
                sends an <em>empty</em> tree rather than the unsanitized one, so a bug in redaction
                cannot leak the data it was meant to hide. A failing action sanitizer sends
                <code>&lt;sanitizer-error&gt;</code>.
            </li>
            <li>
                <strong>Corrupt persisted data never blocks startup.</strong> An unreadable payload is
                reported, discarded and removed from storage; the app starts with defaults.
            </li>
            <li>
                <strong>The handler itself is guarded.</strong> If your <code>OnError</code> throws, that
                exception is swallowed - it is the last line of defence, and there is nowhere left to
                report to.
            </li>
        </ul>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> A realistic handler</h2>
        <CodeBlock Code="@Logging" />

        <Callout Kind="Callout.CalloutKind.Gotcha" Title="OnError is captured on the singleton options">
            <p>
                <code>BlexOptions</code> is registered as a singleton, and the delegate you assign is
                copied onto each scoped <code>BlexManager</code> as it is created. Do not close over a
                scoped service in it - under Blazor Server that would capture one circuit's dependency
                and share it with all of them. Close over something process-wide (an
                <code>ILoggerFactory</code>, a metrics client), or assign
                <code>manager.OnError</code> per scope instead.
            </p>
        </Callout>
    </div>

    <div class="bb-card" id="observability">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Logging and tracing</h2>
        <p>
            <code>options.UseLogging()</code> does the handler above for you, through the host's
            <code>ILogger</code> (category <code>Bit.Blex</code>): every action at <code>Debug</code> - or
            the level you pass, <code>LogLevel.None</code> for failures only - every action failure as an
            error, and every isolated failure as a warning, before your own <code>OnError</code> sees it too.
            Names only: arguments and state never reach the log.
        </p>
        <p>
            Tracing and metrics go through the standard <code>ActivitySource</code> and <code>Meter</code>
            named <code>BlexDiagnostics.SourceName</code>, so OpenTelemetry, dotnet-counters and Application
            Insights pick them up with no Blex-specific code - and with nothing listening, an action pays two
            flag reads.
        </p>
        <CodeBlock Code="@Telemetry" FileName="Program.cs" />
        <ApiTable Title="What is recorded" Rows="@TelemetryRows" />
        <Callout Kind="Callout.CalloutKind.Note" Title="Safe to export by design">
            <p>
                Only names are recorded - never action arguments or state. A store's metric tag is its
                declared name, without a scoped instance's key (which goes on the span only), so a thousand
                open documents are one series. A query is named by its key's first part: <code>["todos", 42]</code>
                is <code>"todos"</code>, so keep that part a fixed word rather than an id.
            </p>
        </Callout>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Setting it per scope</h2>
        <p>
            <code>OnError</code> is also a settable property on <code>BlexManager</code>, so a scoped
            component or service can install its own handler where a scoped dependency is genuinely
            needed.
        </p>
        <CodeBlock Code="@PerScope" />

        <Callout Kind="Callout.CalloutKind.Warning" Title="Errors inside an action body are not isolated">
            <p>
                This is about the <em>observers</em> of an action. An exception thrown by your own
                <code>[BlexAction]</code> method body propagates to the caller as usual - only
                <code>[BlexEffect]</code> bodies capture their exception, into the generated
                <code>XxxError</code> property.
            </p>
        </Callout>
    </div>

</DocPage>

@code {
    protected override void OnInitialized()
    {
        Subscribe(Counter);
        Log.Changed += OnLogChanged;
    }

    private void OnLogChanged() => _ = InvokeAsync(StateHasChanged);

    private void BreakSubscriber()
    {
        // A one-shot subscriber that throws. The manager catches it, reports it through
        // options.OnError, and carries on with the remaining observers.
        IDisposable? token = null;
        token = Manager.SubscribeToAction("counter/Increment", _ =>
        {
            token?.Dispose();
            throw new InvalidOperationException("This subscriber is deliberately broken.");
        });

        Counter.Increment();
    }

    protected override void Dispose(bool disposing) => Log.Changed -= OnLogChanged;

    private static readonly IReadOnlyList<ApiTable.Row> ErrorRows =
    [
        new("string Source", "Which part of the pipeline failed: <code>subscriber</code>, <code>async reactor</code>, <code>middleware</code>, <code>persistence</code>, <code>restore</code>, <code>devtools</code>, <code>history</code>, <code>reset</code>, <code>register</code>, <code>unregister</code>, <code>dispose</code>, <code>prerender</code>, <code>dispatcher</code>, <code>mutation</code> or <code>query</code> - the table above says when each is raised."),
        new("Exception Exception", "The captured exception."),
        new("string? Detail", "Context - usually the store name, storage key or qualified action name."),
    ];

    private const string Setup = """
        builder.Services.AddBitBlexServices(options =>
        {
            options.OnError = error => logger.LogWarning(
                error.Exception,
                "[blex:{Source}] {Detail}",
                error.Source,
                error.Detail);
        });
        """;

    private const string Record = """
        public readonly record struct BlexError(
            string Source,
            Exception Exception,
            string? Detail = null);
        """;

    private const string DemoSource = """
        IDisposable? token = null;
        token = Manager.SubscribeToAction("counter/Increment", _ =>
        {
            token?.Dispose();
            throw new InvalidOperationException("This subscriber is deliberately broken.");
        });

        Counter.Increment();
        // -> the action applies, other observers still run,
        //    and options.OnError receives BlexError("subscriber", ex, "counter/Increment").
        """;

    private const string Logging = """
        builder.Services.AddBitBlexServices(options =>
        {
            options.OnError = error =>
            {
                // Persistence and restore failures are worth alerting on; a broken
                // analytics subscriber usually is not.
                var level = error.Source is "persistence" or "restore"
                    ? LogLevel.Error
                    : LogLevel.Warning;

                logger.Log(level, error.Exception,
                    "Blex {Source} failed ({Detail})", error.Source, error.Detail);
            };
        });
        """;

    private const string Telemetry = """
        builder.Services.AddBitBlexServices(options => options.UseLogging());

        builder.Services.AddOpenTelemetry()
            .WithTracing(tracing => tracing.AddSource(BlexDiagnostics.SourceName))
            .WithMetrics(metrics => metrics.AddMeter(BlexDiagnostics.SourceName));
        """;

    private static readonly IReadOnlyList<ApiTable.Row> TelemetryRows =
    [
        new("Span \"{store}/{action}\"", "Every action and effect; one that runs inside another is its child. Tags <code>blex.store</code>, <code>blex.action</code>, <code>blex.store.instance</code>. Failed: status <code>Error</code> and <code>error.type</code>. Cancelled: <code>blex.cancelled</code>. An effect's retries are <code>blex.effect.retry</code> events."),
        new("Span \"query {resource}\"", "Every query fetch, its retries included, with <code>blex.query.outcome</code>: <code>success</code>, <code>error</code> or <code>cancelled</code>."),
        new("blex.actions / blex.action.errors", "Counters by <code>blex.store</code> and <code>blex.action</code>."),
        new("blex.action.duration", "Histogram, in seconds - an async action's includes its awaits."),
        new("blex.query.fetches / blex.query.duration", "By <code>blex.query.resource</code> and <code>blex.query.outcome</code>."),
    ];

    private const string PerScope = """
        [Inject] private BlexManager Manager { get; set; } = default!;
        [Inject] private IToastService Toasts { get; set; } = default!;   // scoped

        protected override void OnInitialized()
            => Manager.OnError = error => Toasts.ShowWarning($"{error.Source}: {error.Exception.Message}");
        """;
}
