    private const string DiSample = """
        [BlexStore(Name = "weather")]
        public partial class WeatherStore
        {
            private readonly HttpClient _http;

            // Constructor injection works exactly as it does for any other scoped service.
            public WeatherStore(HttpClient http) => _http = http;

            [BlexState] private Forecast[]? _forecasts;

            [BlexEffect]
            private async Task OnLoad(CancellationToken ct)
                => Forecasts = await _http.GetFromJsonAsync<Forecast[]>("forecasts.json", ct);
        }
        """;

    private const string StateSample = """
        [BlexState] private int _count;                       // -> public int Count
        [BlexState] private string _name = "";                // -> public string Name
        [BlexState] private IReadOnlyList<Todo> _todos = [];   // -> public IReadOnlyList<Todo> Todos
        [BlexState] private Filter _filter = Filter.All;       // -> public Filter Filter (enum, stored as a string)
        """;

    private const string EqualitySource = """
        [BlexStore(Name = "equalityDemo")]
        public partial class EqualityDemoStore
        {
            [BlexState] private List<string> _items = ["alpha"];

            [BlexComputed] private int ComputeCount() => Items.Count;

            // The trap: contents change, the reference does not -- nothing notifies.
            [BlexAction] private void OnMutateInPlace() => Items.Add($"item {Items.Count}");

            // The fix: a new instance, so the reference differs and change detection fires.
            [BlexAction] private void OnAssignNew() => Items = [.. Items, $"item {Items.Count}"];
        }
        """;

    private const string IStoreSample = """
        public interface IBlexStore
