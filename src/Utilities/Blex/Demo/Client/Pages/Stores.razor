@page "/stores"
@using System.Text.Json
@using System.Text.Json.Nodes
@inherits BlexComponentBase
@inject CounterStore Counter
@inject EqualityDemoStore Equality
@inject BlexManager Manager
@inject ErrorLog Errors

<DocPage Href="stores" Title="Stores & state"
         Lead="A store is a partial class that owns a slice of state. The generator turns its fields into reactive properties and gives it a JSON identity.">

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> The [BlexStore] attribute</h2>
        <p>
            Mark a <code>partial class</code> with <code>[BlexStore]</code> and the generator makes it derive
            from <code>BlexStoreBase</code>, emits the reactive members and implements the snapshot methods.
        </p>

        <CodeBlock Code="@StoreDecl" />

        <ApiTable Title="[BlexStore] properties" Rows="@StoreAttrRows" MemberHeader="Property" />

        <Callout Kind="Callout.CalloutKind.Note" Title="Name is the slice key">
            <p>
                <code>Name</code> is what identifies the store in the global state tree, in DevTools, in
                action labels (<code>counter/Increment</code>) and in persistence keys. Changing it
                changes the persistence key, which strands previously saved data - bump
                <code>options.Version</code> and migrate if you rename a persisted store. A
                <a href="scoped-stores">scoped instance</a> appends its key: <code>counter:left</code>.
            </p>
        </Callout>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Shape requirements</h2>
        <p>The generator writes a flat, top-level partial declaration, so the class must be one it can extend:</p>
        <ul class="bb-detail-list">
            <li>declared <code>partial</code> - otherwise <code>BLEX001</code>;</li>
            <li>a plain class, not a <code>record</code> - <code>BLEX015</code>. Records get value equality and a synthesized clone that fight a mutable reactive container;</li>
            <li>top-level, non-generic and non-static - <code>BLEX006</code>;</li>
            <li>with no other base class, since the generated partial adds <code>: Bit.Blex.BlexStoreBase</code> - <code>BLEX016</code>.</li>
        </ul>
        <p>
            Constructors, interfaces, ordinary members and dependency injection all work normally. A
            store is just a service, so it can take an <code>HttpClient</code> or a repository in its
            constructor.
        </p>

        <CodeBlock Code="@DiSample" Title="A store with dependencies" />
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> [BlexState] fields</h2>
        <p>
            Each <code>[BlexState]</code> field becomes a public property whose setter runs through the
            dispatch pipeline: it compares, assigns, invalidates computed values, notifies subscribers
            and records the change for time-travel.
        </p>

        <CodeBlock Code="@StateSample" />

        <p>The property name is derived by trimming a leading underscore and capitalizing:</p>
        <div class="bb-scroll">
            <table class="bb-table">
                <thead><tr><th>Field</th><th>Property</th></tr></thead>
                <tbody>
                    <tr><td><code>_count</code></td><td><code>Count</code></td></tr>
                    <tr><td><code>count</code></td><td><code>Count</code></td></tr>
                    <tr><td><code>_isLoggedIn</code></td><td><code>IsLoggedIn</code></td></tr>
                    <tr><td><code>Count</code></td><td class="bb-soft">error <code>BLEX012</code> - the field and property would collide</td></tr>
                </tbody>
            </table>
        </div>
        <p>
            A <code>[BlexState]</code> field must be a writable instance field: <code>static</code>,
            <code>const</code> and <code>readonly</code> are rejected with <code>BLEX008</code>.
        </p>
        <p>
            In a store marked <code>Persist = true</code>, <code>[BlexState(Persist = false)]</code> keeps one
            field out of storage - a search box's text, a selection, a cached response - while it stays
            part of the snapshot that DevTools, undo/redo and the prerender handoff see. See
            <a href="persistence">Persistence</a>.
        </p>
        <p>
            By default the properties have public setters, and an outside assignment becomes a
            <code>Set X</code> action. <code>[BlexStore(EnforceActions = true)]</code> makes the setters
            private instead, so state can only change through the store's own actions - see
            <a href="actions">Actions</a>.
        </p>
    </div>

    <div class="bb-card" id="change-detection">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Change detection</h2>
        <p>
            Setters compare with <code>EqualityComparer&lt;T&gt;.Default</code>. For value types and
            records that is structural equality, which is what you want. For a <code>List&lt;T&gt;</code>,
            an array or any class that does not override equality, it is <strong>reference</strong>
            equality - so mutating a collection in place changes nothing as far as Blex is concerned.
        </p>

        <DemoCard Title="In-place mutation vs. assignment"
                  Description="Both buttons add an item. Only one of them notifies anybody - watch the rendered count and the Inspector's action feed."
                  Source="@EqualitySource">
            <div class="bb-stats">
                <div class="bb-stat">
                    <span class="bb-stat-label">Rendered count</span>
                    <span class="bb-stat-value demo-accent">@Equality.Count</span>
                </div>
                <div class="bb-stat">
                    <span class="bb-stat-label">Actual list length</span>
                    <span class="bb-stat-value">@Equality.Items.Count</span>
                </div>
                <div class="bb-stat">
                    <span class="bb-stat-label">Items</span>
                    <span class="bb-stat-value demo-stat-text">@string.Join(", ", Equality.Items)</span>
                </div>
            </div>
            <div class="bb-toolbar">
                <button class="btn demo-btn-danger" @onclick="Equality.MutateInPlace">Items.Add(…) - in place</button>
                <button class="btn btn-primary" @onclick="Equality.AssignNew">Items = [.. Items, …] - new instance</button>
                <button class="btn btn-secondary" @onclick="Equality.Reset">Reset</button>
            </div>
            <p class="bb-card-desc">
                After clicking the red button the two numbers disagree: the list really did grow, but no
                notification fired, so the UI still shows the stale computed value. Click the blue one
                and both catch up.
            </p>
        </DemoCard>

        <Callout Kind="Callout.CalloutKind.Tip" Title="Treat state as immutable">
            <p>
                Always assign a new instance: <code>Items = [.. Items, newItem]</code>. Besides making
                change detection work, immutable slices are what let time-travel, undo/redo and
                persistence snapshot state safely. For collections that change often, use the
                <a href="entities">entity adapter</a>, which is immutable by construction.
            </p>
        </Callout>

        <h3>Let Blex catch it while you develop</h3>
        <p>
            <code>options.DetectInPlaceMutations = true</code> reports, through <code>OnError</code> (source
            <code>"mutation"</code>), every action that changed its store's state without assigning a property -
            exactly what the red button above does. It serializes the store before and after each action, so turn
            it on in development only. It catches an action that assigned nothing at all; one that assigned a
            property and also mutated another in place is announced anyway, through the property it did assign.
        </p>
        <CodeBlock Code="@DetectSample" FileName="Program.cs" />

        <DemoCard Title="In-place mutations, reported"
                  Description="Turn detection on and press the red button above again. The action still changes nothing anyone can see - but this time OnError hears about it, with the fix in the message, and so does the Inspector's Errors tab."
                  Source="@DetectSource">
            <div class="bb-toolbar">
                <label class="bb-check">
                    <input type="checkbox" checked="@Manager.DetectInPlaceMutations" @onchange="OnDetectToggle" />
                    <strong>manager.DetectInPlaceMutations</strong>
                </label>
                <button class="btn demo-btn-danger" @onclick="Equality.MutateInPlace">Items.Add(…) - in place</button>
            </div>
            @if (LastMutationReport is { } report)
            {
                <div class="bb-note bb-note-danger" role="status">
                    <strong class="demo-note-title">OnError("mutation", @report.Detail)</strong>
                    <p>@report.Exception.Message</p>
                </div>
            }
            else
            {
                <p class="bb-card-desc">Nothing reported yet.</p>
            }
            <p class="bb-card-desc">
                The switch sets the property on this app's manager while this page is open, and puts it back when
                you leave - so the rest of the site keeps the default, off.
            </p>
        </DemoCard>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Serialization</h2>
        <p>
            Every store gets generated <code>SerializeState()</code> and <code>DeserializeState()</code>
            methods keyed by the <em>property</em> names. This is the identity used for DevTools, undo/redo
            and persistence. Values round-trip through <code>System.Text.Json</code> with
            <code>BlexJson.Options</code> (web defaults, case-insensitive, enums as strings).
        </p>

        <DemoCard Title="Live snapshot"
                  Description="SerializeState() on the counter store, re-read on every change. Keep a copy, change the counter, then put the copy back with RestoreState: the counter jumps back at once, yet the Inspector's feed gains no entry - a restore is not an action."
                  Source="@SnapshotSource">
            <CodeBlock Code="@CounterJson" Language="json" />
            <div class="bb-toolbar">
                <button class="btn btn-secondary" @onclick="Counter.Increment">Increment</button>
                <button class="btn btn-secondary" @onclick="() => Counter.SetStep(Counter.Step + 1)">Step + 1</button>
                <button class="btn btn-secondary" @onclick="Counter.ResetState">ResetState()</button>
            </div>
            <div class="bb-toolbar">
                <button class="btn btn-primary" @onclick="KeepSnapshot">Keep a copy: SerializeState()</button>
                <button class="btn btn-primary" @onclick="RestoreSnapshot" disabled="@(_snapshot is null)">RestoreState(copy)</button>
                @if (_snapshot is not null)
                {
                    <code>@_snapshot.ToJsonString()</code>
                }
            </div>
        </DemoCard>

        <p>
            <code>RestoreState</code> is the public way to put a snapshot back by hand: it applies the values,
            invalidates the computed ones and raises <code>StateChanged</code> once, then
            <code>StoreRestored</code> and <code>StateRestored</code> on the manager - so cross-store selectors,
            undo/redo and persistence (which writes the restored state back) all follow. It records no action.
            <code>DeserializeState</code> is the raw half underneath: field writes and nothing else.
        </p>

        <Callout Kind="Callout.CalloutKind.Gotcha" Title="Present-but-null vs. missing">
            <p>
                On restore, a property that is <em>present</em> but JSON-null resets the field to
                <code>default</code>; a <em>missing</em> property leaves the current value untouched.
                That is what lets you add a new <code>[BlexState]</code> field without invalidating payloads
                saved by an older build.
            </p>
        </Callout>
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> BlexStoreBase API</h2>
        <p>
            Your store inherits these. The <code>public</code> members are meant for callers; the
            <code>protected</code> ones are what the generated code calls, and are available if you hand-write
            a store.
        </p>

        <ApiTable Title="Public" Rows="@PublicRows" />
        <ApiTable Title="Protected" Rows="@ProtectedRows" />
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> The IBlexStore interface</h2>
        <p>
            Everything the manager needs from a store. Implement it directly only if you want a store
            outside the generator's conventions - you then also give up batching and action recording
            unless you call the <code>BlexStoreBase</code> helpers yourself.
        </p>
        <CodeBlock Code="@IStoreSample" />
    </div>

    <div class="bb-card">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Lifetime</h2>
        <p>
            <code>AddBitBlexStore&lt;T&gt;</code> registers the store as <strong>scoped</strong>. In Blazor
            WebAssembly there is one scope for the whole app, so a store is effectively a singleton. In
            Blazor Server each circuit gets its own scope, so every user has an independent copy of the
            state - which is what you want. The same applies to <code>BlexManager</code>,
            <code>BlexStatePersistor</code> and <code>BlexHistory</code>.
        </p>
        <p>
            That is one instance per DI scope. When a part of the page needs its <em>own</em> instance -
            the form in each of two open dialogs, one editor per tab - see
            <a href="scoped-stores">Scoped stores</a>.
        </p>
    </div>

    <div class="bb-card" id="dispatcher">
        <h2 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Threads and the dispatcher</h2>
        <p>
            Stores are not synchronized, and neither is the dispatch pipeline: a Blazor Server circuit
            and a BlazorWebView keep them consistent by running every event handler, lifecycle method
            and render on one <em>dispatcher</em>. Code that is not already there - a
            <code>System.Threading.Timer</code> callback, a SignalR <code>HubConnection.On</code> handler,
            a <code>Task.Run</code> body, a continuation after <code>ConfigureAwait(false)</code> - races
            all of them when it changes a store.
        </p>
        <p>
            <code>&lt;BlexProvider&gt;</code> binds the renderer's dispatcher to
            <code>BlexManager.Dispatcher</code>, and <code>manager.InvokeAsync(...)</code> gets there from
            a service that has no component to call <code>InvokeAsync</code> on. A store changed outside
            the dispatcher anyway is reported through <code>OnError</code> (source
            <code>"dispatcher"</code>, the store's name as the detail) - the change still applies, but the
            report points at a race that would otherwise surface only as rare corruption in production.
            Turn it off with <code>options.ReportOffDispatcherChanges = false</code>.
        </p>
        <CodeBlock Code="@DispatcherSample" />
        <p>
            Blazor WebAssembly is single-threaded, so its dispatcher never reports anything. Outside
            Blazor no dispatcher is bound unless you assign an <code>IBlexDispatcher</code> yourself.
        </p>
    </div>

</DocPage>

@code {
    private static readonly JsonSerializerOptions Indented = new() { WriteIndented = true };

    // The manager's own setting when the page opened, put back when it closes: detection is this page's
    // demonstration, not something the rest of the site should pay for.
    private bool _detectBefore;
    private JsonObject? _snapshot;

    protected override void OnInitialized()
    {
        Subscribe(Counter, Equality);
        _detectBefore = Manager.DetectInPlaceMutations;

        // The report lands in the site's OnError sink, which is no store: re-render when it moves.
        Errors.Changed += OnErrorsChanged;
    }

    private void OnErrorsChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        Errors.Changed -= OnErrorsChanged;
        Manager.DetectInPlaceMutations = _detectBefore;
    }

    private void OnDetectToggle(ChangeEventArgs e) => Manager.DetectInPlaceMutations = (bool)(e.Value ?? false);

    private BlexError? LastMutationReport => Errors.Errors.FirstOrDefault(e => e.Source == "mutation") is { Exception: not null } error ? error : null;

    private void KeepSnapshot() => _snapshot = Counter.SerializeState();

    // A copy of the copy: the store must not end up sharing the instance this page keeps showing.
    private void RestoreSnapshot()
    {
        if (_snapshot is not null)
            Counter.RestoreState((JsonObject)_snapshot.DeepClone());
    }

    private string CounterJson => Counter.SerializeState().ToJsonString(Indented);

    private static readonly IReadOnlyList<ApiTable.Row> StoreAttrRows =
    [
        new("Name", "Display name and slice key. Defaults to the class name. Used in the state tree, DevTools, qualified action names and persistence keys."),
        new("Persist", "When <code>true</code>, the store is rehydrated on startup and saved after every action - provided a persistence provider is registered. Single fields opt out with <code>[BlexState(Persist = false)]</code>. See <a href=\"persistence\">Persistence</a>."),
        new("Version", "With <code>Persist = true</code>, the version of this store's saved state, used for it instead of <code>options.Version</code>: state saved under another version goes to <code>Migrate</code>, or is dropped. Default <code>0</code> - follow <code>options.Version</code>. See <a href=\"persistence#store-version\">A store's own version</a>."),
        new("EnforceActions", "When <code>true</code>, state changes only through the store's own actions: the generated setters are <code>private</code> (an outside assignment does not compile), and an assignment the store's own code makes outside an action throws once it is registered. See <a href=\"actions\">Actions</a>."),
        new("RollbackOnError", "When <code>true</code>, every synchronous action is a transaction: if it throws, the store's fields go back to what they held when it started, and nothing is notified, recorded, persisted or added to the undo history. See <a href=\"actions#rollback\">When an action throws</a>."),
    ];

    private static readonly IReadOnlyList<ApiTable.Row> PublicRows =
    [
        new("string Name", "The store's slice key."),
        new("bool Persist", "Whether the store opts in to durable persistence."),
        new("int PersistVersion", "The store's own version of its saved state, <code>0</code> when it follows <code>options.Version</code>. Generated for <code>[BlexStore(Version = n)]</code>."),
        new("event Action? StateChanged", "Raised after state changes so views can re-render. Fires once per action, not once per field."),
        new("event PropertyChangedEventHandler? PropertyChanged", "<code>INotifyPropertyChanged</code>, raised right after <code>StateChanged</code> with an empty property name - \"everything may have changed\" - so a XAML binding refreshes computed and effect-lifecycle properties too. What <a href=\"maui\">.NET MAUI</a> binds to."),
        new("JsonObject SerializeState()", "Captures the current state as JSON. Generated."),
        new("void DeserializeState(JsonObject)", "Raw field writes from a snapshot, without notification. Generated. Prefer <code>RestoreState</code>."),
        new("void RestoreState(JsonObject)", "The safe public way to hydrate a store by hand: applies the snapshot, invalidates computed values and raises <code>StateChanged</code> exactly once, without recording an action."),
        new("void Batch(string, Action)", "Groups ad-hoc mutations into one named action - one notification, one history entry, one middleware pass. The equivalent of Pinia's <code>$patch</code>."),
        new("void ResetState()", "Restores the state the store had when it was first registered, recorded as a normal, vetoable <code>ResetState</code> action. No-op if the store was never registered."),
        new("string? InstanceKey", "The key of a <a href=\"scoped-stores\">scoped</a> instance, or <code>null</code> for the usual single instance."),
        new("IReadOnlyList&lt;BlexActionDescriptor&gt; ActionDescriptors", "Every action of the store as data: its actions and effects, a <code>Set X</code> per assignable property, and <code>ResetState</code>. What dispatch by name uses."),
        new("BlexActionDescriptor? FindAction(string)", "The descriptor of the action dispatched under that name, or <code>null</code>."),
        new("void Dispose()", "Cancels in-flight effects and pending debounce waits. The DI container calls it when the scope ends. The store stays usable - disposal is a quiesce, not a kill - and a second call does nothing."),
    ];

    private static readonly IReadOnlyList<ApiTable.Row> ProtectedRows =
    [
        new("bool IsRestoring", "True while the manager is applying a time-travel or restore snapshot. Use it to skip side-effects that should not run during a rewind."),
        new("bool IsObserved", "Whether anything (middleware, DevTools, subscribers, <code>ActionFailed</code> handlers) is watching. Generated wrappers use it to skip argument capture when nobody is listening."),
        new("TimeProvider TimeProvider", "The manager's clock (<code>BlexManager.TimeProvider</code>), or the system clock while unregistered. Debounced effects wait on it; read it in an action for timestamps a test can control."),
        new("string WithInstanceKey(string)", "Appends the instance key to the declared name. The generated <code>Name</code> returns it; a hand-written store that should support scoping must too."),
        new("IReadOnlyList&lt;BlexActionDescriptor&gt; DescribeActions()", "Generated override listing the store's own action descriptors."),
        new("bool EnforcesActions", "Generated <code>true</code> for <code>EnforceActions</code> stores: the runtime half of the guarantee."),
        new("IReadOnlyCollection&lt;string&gt; TransientStateKeys", "Generated: the properties marked <code>[BlexState(Persist = false)]</code>."),
        new("void SetState&lt;T&gt;(ref T, T, string?)", "The generated property setter. Compares, assigns, invalidates, notifies, and records a standalone <code>Set X</code> action when called outside a dispatch."),
        new("void SetEffectState&lt;T&gt;(ref T, T)", "Assigns a transient effect field (loading/error). Notifies, but never records a time-travel action."),
        new("void BeginEffect(ref int) / EndEffect(ref int)", "Reference-count an effect's in-flight runs so <code>IsLoading</code> stays true until the last one finishes."),
        new("Task DebounceEffectAsync(int, CancellationToken)", "Waits out an effect's <code>DebounceMilliseconds</code> on the manager's <code>TimeProvider</code> - at once during a replay."),
        new("Task RunEffectAttemptsAsync(attempt, token, retryCount, retryDelayMilliseconds, timeoutMilliseconds)", "Runs an effect body with its retries, exponential backoff and per-attempt timeout, all inside one recorded action."),
        new("void Dispatch(string, Action, BlexActionArg[]?)", "Runs a mutation as one named, batched, recorded action."),
        new("Task DispatchAsync(string, Func&lt;Task&gt;, BlexActionArg[]?)", "The async variant: state changes render as they happen, but the whole operation records as one action."),
        new("bool BeginAction(string, BlexActionArg[]?) / Task DispatchApprovedAsync(...)", "The two halves of <code>DispatchAsync</code>: the veto decision first, then the body. An effect wrapper asks before it touches anything observable, so a vetoed invocation leaves no trace."),
        new("void InvalidateComputed()", "Generated override that marks every memoized computed value stale - after a restore, a reset, a rollback or an effect's loading flags."),
        new("void InvalidateComputed(string?)", "Generated override that marks stale only the computed values that read the named property, as found in their bodies. What a setter calls; an unknown name falls back to <code>InvalidateComputed()</code>."),
        new("object?[]? CaptureRollbackState() / ApplyRollbackState(object?[])", "Generated for <code>RollbackOnError</code> stores: the shallow copy of the state fields a synchronous action starts from, and putting it back when the action throws."),
        new("void NotifyRestored()", "Invalidates computed values and raises <code>StateChanged</code> - for hand-written stores that restore state out of band."),
        new("void CancelEffects()", "Generated override cancelling every in-flight effect and pending debounce. What <code>Dispose</code> calls."),
        new("bool IsDisposed / void Dispose(bool)", "Whether <code>Dispose</code> has run, and the hook to release resources of your own - call the base, which cancels the effects."),
    ];

    private const string DetectSample = """
        builder.Services.AddBitBlexServices(options =>
        {
            // Development only: every action serializes its store before and after.
            options.DetectInPlaceMutations = builder.HostEnvironment.IsDevelopment();
            options.OnError = error => logger.LogWarning(error.Exception, "[blex:{Source}] {Detail}", error.Source, error.Detail);
        });

        // OnError("mutation", "equalityDemo/MutateInPlace"):
        //   The action 'equalityDemo/MutateInPlace' changed the store's state without assigning any
        //   [BlexState] property ... Assign a new value instead: Items = [.. Items, item].
        """;

    private const string DetectSource = """
        @inject BlexManager Manager

        @* The option is a settable property on the manager too, read on every action. *@
        <input type="checkbox" checked="@Manager.DetectInPlaceMutations"
               @onchange="e => Manager.DetectInPlaceMutations = (bool)(e.Value ?? false)" />

        <button @onclick="Equality.MutateInPlace">Items.Add(…) - in place</button>

        [BlexAction] private void OnMutateInPlace() => Items.Add($"item {Items.Count}");
        """;

    private const string SnapshotSource = """
        private JsonObject? _snapshot;

        private void Keep() => _snapshot = Counter.SerializeState();       // { "Count": 3, "Step": 1 }

        private void Restore()
            => Counter.RestoreState((JsonObject)_snapshot!.DeepClone());   // no action, one StateChanged
        """;

    private const string DispatcherSample = """
