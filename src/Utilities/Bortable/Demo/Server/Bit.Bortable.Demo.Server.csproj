<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <!-- Serves the client's _framework payload and enables WebAssembly debugging from this host. -->
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0-rc.2.26504.105" />
        <!-- The MCP server (see Controllers/McpController.cs), mapped at /mcp. -->
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Bortable\Bit.Bortable.csproj" />
        <ProjectReference Include="..\Client\Bit.Bortable.Demo.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Bit.Bortable" />
        <Using Include="Microsoft.AspNetCore.Mvc" />
    </ItemGroup>

    <ItemGroup>
        <!-- The MCP tests boot this very app: WebApplicationFactory needs its entry point type, which
             top-level statements declare as internal. -->
        <InternalsVisibleTo Include="Bit.Bortable.Tests.Mcp" />
    </ItemGroup>

    <!-- Text the MCP server hands out. It is embedded rather than read from disk so the tools keep
         working from a published deployment, where none of these files exist next to the app.
         LogicalName is set explicitly because the resource name IS the path an MCP client asks for. -->
    <ItemGroup>
        <EmbeddedResource Include="..\..\README.md" LogicalName="BortableDocs/README.md" />

        <!-- The stylesheet as written, comments included: the theme tool reads its custom properties - the
             ones :root declares and the ones the state rules only read with a fallback - and its drag-state
             classes out of it, with the comments that say why each rule exists. -->
        <EmbeddedResource Include="..\..\Bit.Bortable\Styles\bit-bortable.css" LogicalName="BortableSource/Library/Styles/bit-bortable.css" />

        <!-- The component itself, markup and engine: the README promises the library's component next to its
             stylesheet, and "why was my drop refused" is answered most exactly by CanAccept and CanReceiveFrom. -->
        <EmbeddedResource Include="..\..\Bit.Bortable\Components\Bortable.razor" LogicalName="BortableSource/Library/Components/Bortable.razor" />
        <EmbeddedResource Include="..\..\Bit.Bortable\Components\Bortable.razor.cs" LogicalName="BortableSource/Library/Components/Bortable.razor.cs" />

        <!-- Every demo page and the samples it renders - each sample a working list - plus the "view code"
             toggle and the client half of the hosting. The MCP page describes this server rather than the library, and the not-found
             page teaches nothing about lists. -->
        <EmbeddedResource Include="..\Client\**\*.razor;..\Client\**\*.cs"
                          Exclude="..\Client\bin\**;..\Client\obj\**;..\Client\Pages\McpServer.razor;..\Client\Pages\NotFound.razor">
            <LogicalName>BortableSource/Demo/Client/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <EmbeddedResource Include="Program.cs" LogicalName="BortableSource/Demo/Server/Program.cs" />

        <!-- The Components\ prefix is written out: %(RecursiveDir) only captures what the '**' matched.
             Error.razor is the template's own error page and says nothing about lists. -->
        <EmbeddedResource Include="Components\**\*.razor" Exclude="Components\Pages\Error.razor">
            <LogicalName>BortableSource/Demo/Server/Components/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
