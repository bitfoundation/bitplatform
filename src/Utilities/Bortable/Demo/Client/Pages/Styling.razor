@page "/styling"
@using System.Globalization

<PageTitle>Styling · Bortable</PageTitle>

<div class="bb-intro">
    <h1>Styling</h1>
    <p class="bb-subtitle">
        The stylesheet draws the drag states only - the ghost, the chosen item, the preview, the swap target, the
        selection, the locked items - and leaves the look of your list to you. Every state is tinted with one accent and
        tuned through custom properties, and each state's class can be replaced with one of your own.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> An accent and a few properties</h3>
    <p class="bb-card-desc">
        These two lists use the stylesheet's own drag states, with no class of this site's. The controls set the
        stylesheet's custom properties on the element around them, and the lists inherit them: the accent every state is
        tinted with, how transparent the dragged item is, and outlines for the lists that take a drag.
    </p>

    <div class="bb-demo">
        <div class="demo-controls">
            <div class="demo-control">
                <span id="styling-accent-label"><code>--bit-bortable-accent-rgb</code></span>
                <div class="bb-segmented" role="group" aria-labelledby="styling-accent-label">
                    @foreach (var (name, rgb) in Accents)
                    {
                        <button type="button" aria-pressed="@(_accent == rgb ? "true" : "false")" @onclick="() => _accent = rgb">@name</button>
                    }
                </div>
            </div>
            <label>
                <code>--bit-bortable-ghost-opacity</code>: <strong id="styling-opacity-value">@Format(_opacity)</strong>
                <input id="styling-opacity" type="range" min="0.1" max="1" step="0.05" value="@Format(_opacity)" @oninput="OnOpacityChanged" />
            </label>
            <label class="demo-check">
                <input id="styling-targets" type="checkbox" @bind="_targets" />
                Outline the lists that take the drag (<code>--bit-bortable-accepts-outline</code>, <code>--bit-bortable-over-outline</code>)
            </label>
        </div>

        <div class="demo-columns" style="@ThemeStyle">
            <div class="demo-col">
                <div class="demo-col-title">Fruit</div>
                <Bortable @bind-Items="_fruit" TItem="string" Group="styling" Id="styling-fruit" AriaLabel="Fruit"
                          Class="demo-list" ItemClass="styling-item">
                    <ItemTemplate Context="item">@item</ItemTemplate>
                </Bortable>
            </div>
            <div class="demo-col">
                <div class="demo-col-title">Basket</div>
                <Bortable @bind-Items="_basket" TItem="string" Group="styling" Id="styling-basket" AriaLabel="Basket"
                          Class="demo-list" ItemClass="styling-item">
                    <ItemTemplate Context="item">@item</ItemTemplate>
                </Bortable>
            </div>
        </div>

        <pre class="bb-code" id="styling-css">@ThemeCss</pre>
    </div>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Classes of your own</h3>
    <p class="bb-card-desc">
        <code>GhostClass</code>, <code>ChosenClass</code> and <code>DragClass</code> replace the class of a state with your
        own, for a list that wants its own look instead of the stylesheet's: here a dashed amber ghost, an amber chosen
        item, and a tilted preview. The list has <code>ForceFallback</code>, so the mouse drags with the preview too.
    </p>

    <div class="bb-demo">
        <Bortable @bind-Items="_own" TItem="string" Id="styling-own" AriaLabel="Own classes"
                  GhostClass="my-ghost" ChosenClass="my-chosen" DragClass="my-drag" ForceFallback="true"
                  Class="demo-list" ItemClass="styling-item">
            <ItemTemplate Context="item">@item</ItemTemplate>
        </Bortable>

        <pre class="bb-code">.<span class="k">my-ghost</span>  { opacity: .55; outline: 2px dashed var(--bb-warning); outline-offset: -2px; }
.<span class="k">my-chosen</span> { background-color: var(--bb-warning-soft); }
.<span class="k">my-drag</span>   { rotate: -3deg; opacity: .95; outline: 2px solid var(--bb-warning); box-shadow: 0 18px 36px rgba(0, 0, 0, .25); }</pre>

        <p class="demo-order"><strong>Order:</strong> <span id="styling-own-order">@string.Join(", ", _own)</span></p>
    </div>
</section>

<DemoCode />

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Try it</h3>
    <ul class="bb-detail-list">
        <li>Pick <strong>Violet</strong> and drag a fruit: the dragged item and its preview in the Basket are tinted violet.</li>
        <li>Lower the ghost opacity to <code>0.1</code>: the dragged item almost disappears from its place.</li>
        <li>Tick the outlines and drag a fruit: both lists are outlined dashed, and the one under the pointer solid.</li>
        <li>
            Drag an item of the last list with the mouse: the preview that follows the pointer is tilted, the place it
            left is dashed. Pick one up from the keyboard: a keyboard drag wears only the chosen class.
        </li>
    </ul>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Every custom property</h3>
    <p class="bb-card-desc">
        Override them on <code>:root</code> for the whole app, on one list's <code>Class</code>, or inline through its
        <code>Style</code>. The colours are worked out on the item itself, so an accent set on one list reaches its items.
    </p>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Property</th><th>Default</th><th>Used for</th></tr>
            </thead>
            <tbody>
                <tr><td class="bb-table-key"><code>--bit-bortable-accent-rgb</code></td><td><code>13, 110, 253</code></td><td>The accent every state is tinted with, as an <code>r, g, b</code> triplet.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-ghost-opacity</code></td><td><code>0.4</code></td><td>The dragged item and the drop placeholder.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-chosen-bg</code></td><td>the accent at 12%</td><td>The chosen item's background.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-swap-bg</code></td><td>the accent at 18%</td><td>The swap target's background.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-swap-outline</code></td><td><code>2px dashed</code>, accent at 60%</td><td>The swap target's outline.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-selected-bg</code></td><td>the accent at 25%</td><td>A multi-drag selected item's background.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-selected-ring</code></td><td><code>inset</code> 2px, accent at 80%</td><td>A multi-drag selected item's ring (a <code>box-shadow</code>).</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-filtered-opacity</code></td><td><code>0.7</code></td><td>A filtered item.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-focus-outline</code></td><td><code>2px solid</code>, accent at 90%</td><td>The outline of an item focused from the keyboard.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-focus-offset</code></td><td><code>2px</code></td><td>How far that outline sits outside the item.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-lifted-outline-style</code></td><td><code>dashed</code></td><td>The outline style of an item picked up from the keyboard.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-drag-opacity</code></td><td><code>0.92</code></td><td>The preview that follows a finger, a pen or a <code>ForceFallback</code> mouse.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-drag-shadow</code></td><td>a soft shadow</td><td>That preview's shadow.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-accepts-outline</code></td><td><code>none</code></td><td>During a drag, the outline of every list that takes it.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-over-outline</code></td><td><code>none</code></td><td>The outline of the list under the pointer.</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-refused-outline</code></td><td><code>none</code></td><td>The outline of that list when it refused the position (see <a href="rules">rules</a>).</td></tr>
                <tr><td class="bb-table-key"><code>--bit-bortable-target-offset</code></td><td><code>2px</code></td><td>How far those outlines sit outside the list.</td></tr>
            </tbody>
        </table>
    </div>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> The classes</h3>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Class</th><th>Set on</th><th>Replaced by</th></tr>
            </thead>
            <tbody>
                <tr><td class="bb-table-key"><code>bit-bortable</code></td><td>The list container.</td><td></td></tr>
                <tr><td class="bb-table-key"><code>bit-bortable-item</code></td><td>Every item wrapper, and the drop placeholder.</td><td></td></tr>
                <tr><td class="bb-table-key"><code>bit-bortable-ghost</code></td><td>The item being dragged with a pointer, in its list, and the drop placeholder.</td><td><code>GhostClass</code></td></tr>
                <tr><td class="bb-table-key"><code>bit-bortable-chosen</code></td><td>The item being dragged - also from the keyboard - and the drop placeholder.</td><td><code>ChosenClass</code></td></tr>
                <tr><td class="bb-table-key"><code>bit-bortable-drag</code></td><td>The preview that follows a finger, a pen or a <code>ForceFallback</code> mouse.</td><td><code>DragClass</code></td></tr>
                <tr><td class="bb-table-key"><code>bit-bortable-hidden</code></td><td>The original of a moved item while it is previewed in another list.</td><td></td></tr>
                <tr><td class="bb-table-key"><code>bit-bortable-swap-highlight</code></td><td>The swap target, in <a href="swap">swap mode</a>.</td><td><code>SwapClass</code></td></tr>
                <tr><td class="bb-table-key"><code>bit-bortable-selected</code></td><td>The items of a <a href="multi-drag">multi-drag</a> selection.</td><td><code>SelectedClass</code></td></tr>
                <tr><td class="bb-table-key"><code>bit-bortable-filtered</code></td><td>Items the <a href="filter">Filter</a> locks.</td><td></td></tr>
                <tr><td class="bb-table-key"><code>bit-bortable-disabled</code></td><td>The container of a <a href="disable-sort">Disabled</a> list.</td><td></td></tr>
                <tr><td class="bb-table-key"><code>bit-bortable-has-handle</code></td><td>The container of a list with a <a href="handle">Handle</a>.</td><td></td></tr>
            </tbody>
        </table>
    </div>
    <p class="bb-card-desc">
        While a drag runs, the browser layer also sets attributes you can style, at no render cost:
        <code>data-bortable-accepts</code> on every list that takes the drag, <code>data-bortable-over</code> on the one
        under the pointer, <code>data-bortable-refused</code> on that one when it refused the position, and
        <code>data-bortable-dragging</code> on <code>&lt;html&gt;</code>, set to <code>native</code>,
        <code>pointer</code> or <code>keyboard</code>. Your own look for the list and its items goes through
        <code>Class</code> and <code>Style</code> on the container and <code>ItemClass</code> and
        <code>ItemClassSelector</code> on the items.
    </p>
    <div class="bb-note">
        <code>GhostClass</code>, <code>ChosenClass</code>, <code>DragClass</code>, <code>SwapClass</code> and
        <code>SelectedClass</code> can also be set once for every list of the app, in
        <a href="getting-started">the app-wide defaults</a>.
    </div>
</section>

@code {
    private static readonly (string Name, string Rgb)[] Accents =
    [
        ("Blue", "13, 110, 253"),
        ("Violet", "109, 40, 217"),
        ("Green", "22, 163, 74"),
        ("Orange", "234, 88, 12"),
    ];

    private IList<string> _fruit = new List<string> { "Apple", "Banana", "Cherry", "Date" };
    private IList<string> _basket = new List<string> { "Fig", "Grape" };
    private IList<string> _own = new List<string> { "One", "Two", "Three", "Four" };

    private string _accent = "13, 110, 253";
    private double _opacity = 0.4;
    private bool _targets = true;

    private string ThemeStyle =>
        $"--bit-bortable-accent-rgb: {_accent}; --bit-bortable-ghost-opacity: {Format(_opacity)};" +
        (_targets ? $" --bit-bortable-accepts-outline: 2px dashed rgba({_accent}, .5); --bit-bortable-over-outline: 2px solid rgb({_accent});" : "");

    // The same declarations, as they would be written in a stylesheet.
    private string ThemeCss => ".board {\n    " + ThemeStyle.Replace("; ", ";\n    ", StringComparison.Ordinal) + "\n}";

    private static string Format(double value) => value.ToString("0.00", CultureInfo.InvariantCulture);

    private void OnOpacityChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var v)) _opacity = v;
    }
}
