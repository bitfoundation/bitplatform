@page "/swap"

<PageTitle>Swap - bit Bortable</PageTitle>

<div class="demo-header">
    <h3>Swap</h3>
    <p class="text-muted">
        With <code>Swap="true"</code> the list no longer sorts. Instead, the item you drag over is highlighted, and
        on drop the dragged item trades places with it. Swapping works inside a single list and between lists that
        share a group. This mirrors the SortableJS
        <a href="https://github.com/SortableJS/Sortable/tree/master/plugins/Swap" target="_blank" rel="noopener">Swap plugin</a>.
    </p>
</div>

<DemoCode />

<div class="demo-col-title">Single list</div>
<Bortable @bind-Items="_list" TItem="string" Swap="true" Id="swap-list"
          Class="demo-list" ItemClass="demo-item" GhostClass="demo-ghost">
    <ItemTemplate Context="item">@item</ItemTemplate>
</Bortable>

<p class="demo-order"><strong>Order:</strong> <span id="swap-order">@string.Join(", ", _list)</span></p>

<div class="demo-col-title demo-col-title--spaced">Across two lists</div>
<div class="demo-columns">
    <div class="demo-col">
        <Bortable @bind-Items="_left" TItem="string" Group="swap-shared" Swap="true" Id="swap-left"
                  Class="demo-list" ItemClass="demo-item" GhostClass="demo-ghost">
            <ItemTemplate Context="item">@item</ItemTemplate>
        </Bortable>
    </div>
    <div class="demo-col">
        <Bortable @bind-Items="_right" TItem="string" Group="swap-shared" Swap="true" Id="swap-right"
                  Class="demo-list" ItemClass="demo-item tinted" GhostClass="demo-ghost">
            <ItemTemplate Context="item">@item</ItemTemplate>
        </Bortable>
    </div>
</div>

<p class="demo-order"><strong>Left:</strong> <span id="swap-left-order">@string.Join(", ", _left)</span></p>
<p class="demo-order"><strong>Right:</strong> <span id="swap-right-order">@string.Join(", ", _right)</span></p>

@code {
    private IList<string> _list = new List<string>
    {
        "Item 1", "Item 2", "Item 3", "Item 4", "Item 5", "Item 6"
    };

    private IList<string> _left = new List<string> { "Item 1", "Item 2", "Item 3", "Item 4" };
    private IList<string> _right = new List<string> { "Item A", "Item B", "Item C", "Item D" };
}
