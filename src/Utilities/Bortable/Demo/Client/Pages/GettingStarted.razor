@page "/getting-started"

<PageTitle>Getting started · Bortable</PageTitle>

<div class="bb-intro">
    <h1>Getting started</h1>
    <p class="bb-subtitle">
        One package, one service registration and one stylesheet - then any <code>IList&lt;TItem&gt;</code>
        on an interactively rendered page becomes a list people can put in order by hand.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Install</h3>
    <p class="bb-card-desc">
        In a Blazor Web App with an interactive client, the package belongs in the <code>.Client</code>
        project, and the services are registered in both projects - the server prerenders the same
        components the client runs.
    </p>
    <pre class="bb-code">dotnet add package Bit.Bortable</pre>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Register the services</h3>
    <p class="bb-card-desc">
        It registers one scoped service: the coordinator that holds the drag in progress, so lists
        sharing a group can hand an item to each other. Scoped means one per circuit on Blazor Server
        and one per application on WebAssembly, so two users never share a drag. Calling it more than once
        is harmless; without it, the first list that renders throws. Outside AOT builds, a WebAssembly app can
        also <a href="getting-started#lazy-loading">lazy load</a> the library instead of registering it.
    </p>
    <pre class="bb-code"><span class="c">// Program.cs - in every project that renders a list</span>
builder.Services.AddBitBortableServices();</pre>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Reference the stylesheet</h3>
    <p class="bb-card-desc">
        It styles the drag states only - the ghost, the chosen item, the hidden original, the swap
        target, the multi-drag selection - and leaves the look of the list to you. It is not injected for
        you: link it from the host page, <code>App.razor</code> or <code>index.html</code>. The script module
        needs no tag: the lists import it on demand, once for all of them.
    </p>
    <pre class="bb-code">&lt;<span class="k">link</span> rel=<span class="s">"stylesheet"</span> href=<span class="s">"_content/Bit.Bortable/bit-bortable.css"</span> /&gt;</pre>
    <p class="bb-card-desc">And the namespace, in <code>_Imports.razor</code>:</p>
    <pre class="bb-code"><span class="k">@@using</span> Bit.Bortable</pre>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> A first list</h3>
    <p class="bb-card-desc">
        Each item is wrapped in a <code>&lt;div&gt;</code> that carries the drag handlers;
        <code>ItemTemplate</code> renders what goes inside it. <code>Class</code> and <code>Style</code> go
        to the list container, <code>ItemClass</code> to every item wrapper. <code>@@bind-Items</code> keeps
        your field in step: the list is changed in place, so the order a user makes is the order your
        code reads back.
    </p>
    <pre class="bb-code">&lt;<span class="k">Bortable</span> @@bind-Items=<span class="s">"_items"</span> TItem=<span class="s">"string"</span> Class=<span class="s">"todo"</span> ItemClass=<span class="s">"todo-item"</span>&gt;
    &lt;<span class="k">ItemTemplate</span> Context=<span class="s">"item"</span>&gt;@@item&lt;/<span class="k">ItemTemplate</span>&gt;
&lt;/<span class="k">Bortable</span>&gt;

<span class="k">@@code</span> {
    <span class="k">private</span> IList&lt;<span class="k">string</span>&gt; _items = <span class="k">new</span> List&lt;<span class="k">string</span>&gt; { <span class="s">"Write the spec"</span>, <span class="s">"Review the PR"</span>, <span class="s">"Ship it"</span> };
}</pre>

    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live</span></div>
        <Bortable @bind-Items="_items" TItem="string" Id="getting-started-list"
                  Class="demo-list" ItemClass="demo-item" GhostClass="demo-ghost">
            <ItemTemplate Context="item">@item</ItemTemplate>
        </Bortable>
        <p class="demo-order"><strong>Order:</strong> <span id="getting-started-order">@string.Join(", ", _items)</span></p>
    </div>

    <div class="bb-note">
        The list must be mutable - a <code>List&lt;T&gt;</code> or anything else whose
        <code>IsReadOnly</code> is <code>false</code> - and the field declared as <code>IList&lt;TItem&gt;</code>,
        the parameter's type. Items are rendered with <code>@@key</code>, so they must be unique within a list.
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> An interactive render mode</h3>
    <p class="bb-card-desc">
        A list answers a drag only on a page that renders interactively. A statically rendered page shows the items
        but never drags them; a prerendered one shows them at once and starts dragging as soon as it is interactive.
    </p>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Hosting model</th><th>Register the services in</th><th>Link the stylesheet from</th></tr>
            </thead>
            <tbody>
                <tr><td class="bb-table-key">Blazor WebAssembly</td><td><code>Program.cs</code></td><td><code>wwwroot/index.html</code></td></tr>
                <tr><td class="bb-table-key">Blazor Server</td><td><code>Program.cs</code></td><td><code>App.razor</code></td></tr>
                <tr><td class="bb-table-key">Blazor Web App</td><td>Both <code>Program.cs</code> files, with the pages in the <code>.Client</code> project for a WebAssembly or Auto render mode</td><td>The server's <code>App.razor</code></td></tr>
                <tr><td class="bb-table-key">Blazor Hybrid</td><td><code>MauiProgram.cs</code></td><td><code>wwwroot/index.html</code></td></tr>
            </tbody>
        </table>
    </div>
    <p class="bb-card-desc">
        On Blazor Server the pointer is followed and measured in the browser, and the circuit carries only what changes:
        the start of a drag, each new drop position and its end - so a drag stays smooth there too.
    </p>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> App-wide defaults</h3>
    <p class="bb-card-desc">
        The same registration takes defaults for every list of the app - the announcements in its language, a longer
        long press, a slower slide. A default replaces the parameter's own default for every list that does not set the
        parameter itself; a list that does keeps its value. Several calls add up, in order.
    </p>
    <pre class="bb-code">builder.Services.AddBitBortableServices(options =&gt;
{
    options.Messages = MyTexts.German;   <span class="c">// the texts screen readers hear</span>
    options.TouchDelay = 300;            <span class="c">// a longer long press</span>
    options.Animation = 200;             <span class="c">// a slower slide</span>
});</pre>
    <p class="bb-card-desc">
        <code>BortableOptions</code> covers <code>Animation</code>, <code>SwapThreshold</code>, <code>Delay</code>,
        <code>TouchDelay</code>, <code>DelayTolerance</code>, <code>ForceFallback</code>, <code>Scroll</code>,
        <code>ScrollSensitivity</code>, <code>ScrollSpeed</code>, <code>Keyboard</code>, <code>RevertOnSpill</code>,
        <code>Messages</code>, and the classes <code>GhostClass</code>, <code>ChosenClass</code>, <code>DragClass</code>,
        <code>SwapClass</code> and <code>SelectedClass</code>. A property left <code>null</code> leaves the parameter's
        own default.
    </p>
</div>

<div class="bb-card" id="lazy-loading">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Lazy loading on WebAssembly</h3>
    <p class="bb-card-desc">
        The lists also work without <code>AddBitBortableServices</code> on WebAssembly, so an app can fetch Bortable only
        when someone opens a part of the app that has a list. When the services are not registered, the lists create
        their drag coordinator themselves, once per WebAssembly runtime, and share it: lists of a group still hand items
        to each other. Mark the assembly as lazy loaded in the project that runs in the browser, with a runtime switch
        next to the mark so the router knows it is there to load, and load it before the first page that uses it
        renders:
    </p>
    <CodeBlock Code="@LazyProjectCode" />
    <CodeBlock Code="@LazyRouterCode" />
    <ul class="bb-detail-list">
        <li>Leave <code>AddBitBortableServices</code> out of that project's <code>Program.cs</code>: calling it references Bortable's types before the assembly is there. For the same reason only what renders after the assembly has loaded may use Bortable's types - the pages it is loaded for and a layout only they use, not <code>App.razor</code>, <code>Routes.razor</code>, a layout every page shares, <code>Program.cs</code> or the method that calls <code>LoadAssembliesAsync</code>.</li>
        <li>No public type in an assembly the router reads when the app starts - the app's own assembly first of all - may derive from one of Bortable's, or from a generic type closed over one: no component that inherits <code>Bortable&lt;TItem&gt;</code>, no <code>BortableMessages</code> subclass. On WebAssembly such a type fails to load before Bit.Bortable is there, and keeps failing after it has loaded. Make it <code>internal</code>, or put it in a library that is lazy loaded together with Bit.Bortable.</li>
        <li>Without the registration there are no app-wide defaults: set <code>Messages</code>, <code>TouchDelay</code>, <code>Animation</code> and the classes on the lists themselves. The lists log one warning that the services are not registered - expected here; <code>builder.Logging.AddFilter("Bit.Bortable.BitBortable", LogLevel.None)</code> silences it.</li>
        <li>Only WebAssembly goes without the registration: on Blazor Server, in Blazor Hybrid and on a server that prerenders, a list without it still throws.</li>
        <li>In a Blazor Web App only the browser lazy loads. Give <code>Routes</code> the <code>InteractiveWebAssembly</code> or <code>InteractiveAuto</code> render mode in <code>App.razor</code>, so the router - and its <code>OnNavigateAsync</code> - runs in the browser. The server project loads Bortable with the rest of the app, keeps its <code>AddBitBortableServices()</code> - it prerenders the lists - and registers <code>LazyAssemblyLoader</code>, which <code>Routes.razor</code> injects there too: <code>builder.Services.AddScoped&lt;LazyAssemblyLoader&gt;()</code>.</li>
        <li>Do not lazy load in an AOT build. AOT compiles every assembly into <code>dotnet.native.wasm</code>, so there is nothing left to download later, and lazy loading an AOT-compiled assembly can fail at startup - the condition on the <code>ItemGroup</code> leaves it out, and the switch skips the load with it.</li>
    </ul>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-danger"></span> When something does not work</h3>
    <ul class="bb-detail-list">
        <li>
            <strong>"Bit.Bortable's services are not registered"</strong> - call
            <code>AddBitBortableServices()</code>, in both projects of a Blazor Web App. Only WebAssembly goes without
            it, to <a href="getting-started#lazy-loading">lazy load</a> Bortable.
        </li>
        <li>
            <strong>Defaults from <code>Program.cs</code> stop working once the page turns interactive</strong> - the
            services are registered in only one project of a Blazor Web App; the lists in the other log a warning saying
            so. Call <code>AddBitBortableServices</code> in both, through one shared method.
        </li>
        <li><strong>The items render, but nothing can be dragged</strong> - the page is not interactive. Give it, or the app, an interactive render mode.</li>
        <li>
            <strong>The dragged item is not dimmed, and the original does not hide while it is previewed in another
            list</strong> - the stylesheet is missing.
        </li>
        <li>
            <strong>An item cannot be dropped into another list</strong> - both lists need the same <code>Group</code> and
            <code>TItem</code>; the source's <code>Pull</code> must not be <code>None</code>; the target must have
            <code>Put</code>, not be <code>Disabled</code> or full, be mutable, and not already hold an equal item.
        </li>
        <li><strong>An empty list cannot be dropped into</strong> - it has no height. Give it a <code>min-height</code> or some padding.</li>
        <li><strong><code>@@bind-Items</code> does not compile</strong> - declare the field as <code>IList&lt;TItem&gt;</code>.</li>
    </ul>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Where to go next</h3>
    <div class="bb-try">
        <a href="shared" class="btn btn-outline">Drag between lists →</a>
        <a href="cloning" class="btn btn-outline">Copy instead of move →</a>
        <a href="handle" class="btn btn-outline">Drag by a handle →</a>
        <a href="rules" class="btn btn-outline">Allow or refuse a drop →</a>
        <a href="accessibility" class="btn btn-outline">Keyboard and screen readers →</a>
        <a href="events" class="btn btn-outline">React to a drop →</a>
        <a href="styling" class="btn btn-outline">Style the drag →</a>
    </div>
</div>

@code {
    private IList<string> _items = new List<string> { "Write the spec", "Review the PR", "Ship it" };

    private const string LazyProjectCode = """
        <!-- The browser project's .csproj. AOT builds are left out. -->
        <ItemGroup Condition=" '$(RunAOTCompilation)' != 'true' ">
          <BlazorWebAssemblyLazyLoad Include="Bit.Bortable.wasm" />
          <RuntimeHostConfigurationOption Include="MyApp.LazyLoadsBortable" Value="true" Trim="true" />
        </ItemGroup>
        """;

    private const string LazyRouterCode = """
        @* App.razor - in a Blazor Web App, the client project's Routes.razor: the router waits for OnNavigateAsync
           before it renders the page. typeof(Program) is the project the router's file is in, in either kind of app. *@
        @using Microsoft.AspNetCore.Components.WebAssembly.Services
        @inject LazyAssemblyLoader LazyAssemblyLoader

        <Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="OnNavigateAsync">
            ...
        </Router>

        @code {
            // Set only where Bit.Bortable.wasm is marked: loading an assembly that is not marked throws.
            private static readonly bool LazyLoadsBortable = AppContext.TryGetSwitch("MyApp.LazyLoadsBortable", out var on) && on;

            private async Task OnNavigateAsync(NavigationContext context)
            {
                // The pages with lists: fetch Bortable before they render. A second call loads nothing again.
                if (LazyLoadsBortable && IsBoardPage(context.Path))
                    await LazyAssemblyLoader.LoadAssembliesAsync(["Bit.Bortable.wasm"]);
            }

            // /board and the routes beneath it, such as /Board/2 (routes match regardless of case), but not
            // /board-settings. The path keeps any query and fragment.
            private static bool IsBoardPage(string path)
            {
                path = path.Split('?', '#')[0];
                return path.Equals("board", StringComparison.OrdinalIgnoreCase)
                    || path.StartsWith("board/", StringComparison.OrdinalIgnoreCase);
            }
        }
        """;
}
