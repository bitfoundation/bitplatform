@page "/multi-drag"

<PageTitle>Multi-drag · Bortable</PageTitle>

<div class="bb-intro">
    <h1>Multi-drag</h1>
    <p class="bb-subtitle">
        With <code>MultiDrag="true"</code> you can click items to select several of them, then drag any one of the
        selected items to move the whole group together. The selection keeps its order and lands as a contiguous
        block where you drop it. Click an item to toggle its selection; Shift+click selects a range. This mirrors the
        SortableJS <a href="https://sortablejs.github.io/Sortable/#multi-drag" target="_blank" rel="noopener">multi-drag demo</a>.
    </p>
</div>

<DemoCode />

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> A single list, with a bound selection</h3>
    <p class="bb-card-desc">
        <code>@@bind-SelectedItems</code> keeps the selection in step with a field of the page, both ways: the list
        reports every change, and takes a selection the page sets - the two buttons below just assign the field.
    </p>

    <div class="bb-demo">
        <div class="bb-toolbar">
            <button type="button" id="multi-select-all" class="btn btn-secondary" @onclick="() => _selected = _list.ToList()">Select all</button>
            <button type="button" id="multi-clear" class="btn btn-secondary" @onclick="() => _selected = []">Clear the selection</button>
        </div>

        <Bortable @bind-Items="_list" @bind-SelectedItems="_selected" TItem="string" MultiDrag="true" Id="multi-list"
                  AriaLabel="Single list" OnEnd="OnListDragEnd"
                  Class="demo-list" ItemClass="demo-item" GhostClass="demo-ghost">
            <ItemTemplate Context="item">@item</ItemTemplate>
        </Bortable>

        <p class="demo-order"><strong>Order:</strong> <span id="multi-order">@string.Join(", ", _list)</span></p>
        <p class="demo-order"><strong>Selected:</strong> <span id="multi-selected">@(_selected.Count == 0 ? "nothing" : string.Join(", ", _selected))</span></p>
        <p class="demo-order"><strong>Last drag moved:</strong> <span id="multi-last">@_lastDrag</span></p>
    </div>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Across two lists</h3>
    <p class="bb-card-desc">
        Both lists share a group, so a selection made in one can be dragged into the other.
    </p>

    <div class="bb-demo">
        <div class="demo-columns">
            <div class="demo-col">
                <Bortable @bind-Items="_left" TItem="string" Group="multi-shared" MultiDrag="true" Id="multi-left"
                          AriaLabel="Left"
                          Class="demo-list" ItemClass="demo-item" GhostClass="demo-ghost">
                    <ItemTemplate Context="item">@item</ItemTemplate>
                </Bortable>
            </div>
            <div class="demo-col">
                <Bortable @bind-Items="_right" TItem="string" Group="multi-shared" MultiDrag="true" Id="multi-right"
                          AriaLabel="Right"
                          Class="demo-list" ItemClass="demo-item tinted" GhostClass="demo-ghost">
                    <ItemTemplate Context="item">@item</ItemTemplate>
                </Bortable>
            </div>
        </div>

        <p class="demo-order"><strong>Left:</strong> <span id="multi-left-order">@string.Join(", ", _left)</span></p>
        <p class="demo-order"><strong>Right:</strong> <span id="multi-right-order">@string.Join(", ", _right)</span></p>
    </div>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Try it</h3>
    <ul class="bb-detail-list">
        <li>
            Click <em>Item 2</em> and <em>Item 5</em>, then drag <em>Item 5</em> to the top: both land there, together and
            in their order. The selection is spent by the move, and <strong>Last drag moved</strong> lists what the drag
            carried - the event's <code>Items</code>.
        </li>
        <li>Click <em>Item 2</em>, then Shift+click <em>Item 5</em>: every item from 2 to 5 is selected.</li>
        <li>With a few items selected, drag an item that is <em>not</em> selected: the selection is cleared, and only that item moves.</li>
        <li>Select <em>Item 1</em> and <em>Item 3</em> on the left and drag them into the right list.</li>
        <li>
            From the keyboard, focus an item and press <kbd>Shift</kbd>+<kbd>Space</kbd> to select it (it is announced:
            "Item 2 selected. 1 item selected."); pick a selected item up with <kbd>Space</kbd>, and the whole selection
            moves with the arrows.
        </li>
    </ul>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Good to know</h3>
    <ul class="bb-detail-list">
        <li>
            The selection is published in list order, through <code>SelectedItemsChanged</code>, whenever it changes - a
            click, a range, <kbd>Shift</kbd>+<kbd>Space</kbd>, a drag that spends it or one that clears it.
        </li>
        <li>
            A selection the page sets leaves out the items that are not in the list, and those a <code>Filter</code>
            locks. Items that leave the list, or are replaced with the whole <code>Items</code> list, leave the selection
            too.
        </li>
        <li>
            The selected items wear <code>SelectedClass</code> (<code>bit-bortable-selected</code> by default), drawn with
            <code>--bit-bortable-selected-bg</code> and <code>--bit-bortable-selected-ring</code>.
        </li>
        <li>
            Combined with a <code>Clone</code> pull, dragging into another list clones only the dragged item. A move made
            by code (<code>MoveAsync</code>) moves one item and does not carry the selection along.
        </li>
    </ul>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Parameters on this page</h3>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Parameter</th><th>Here</th><th>What it does</th></tr>
            </thead>
            <tbody>
                <tr><td class="bb-table-key"><code>MultiDrag</code></td><td><code>true</code></td><td>Clicks select items, and dragging a selected item moves the whole selection.</td></tr>
                <tr><td class="bb-table-key"><code>@@bind-SelectedItems</code></td><td><code>_selected</code></td><td>The selection, to read or set; <code>SelectedItemsChanged</code> reports it.</td></tr>
                <tr><td class="bb-table-key"><code>OnEnd</code></td><td><code>OnListDragEnd</code></td><td>Reads <code>Items</code>, every item the drag moved.</td></tr>
            </tbody>
        </table>
    </div>
</section>

@code {
    private IList<string> _list = new List<string>
    {
        "Item 1", "Item 2", "Item 3", "Item 4", "Item 5", "Item 6"
    };

    private IReadOnlyCollection<string> _selected = [];
    private string _lastDrag = "nothing yet";

    private IList<string> _left = new List<string> { "Item 1", "Item 2", "Item 3", "Item 4" };
    private IList<string> _right = new List<string> { "Item A", "Item B", "Item C", "Item D" };

    private void OnListDragEnd(BortableEventArgs<string> e)
        => _lastDrag = e.Canceled ? "nothing (cancelled)" : $"{string.Join(", ", e.Items)} - dragged by {e.Item}";
}
