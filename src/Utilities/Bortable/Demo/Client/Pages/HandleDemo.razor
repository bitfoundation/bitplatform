@page "/handle"

<PageTitle>Handle - bit Bortable</PageTitle>

<div class="demo-header">
    <h3>Handle</h3>
    <p class="text-muted">
        With <code>Handle=".handle"</code> a row can only be dragged by grabbing the handle icon. The rest of the
        row stays selectable and clickable.
    </p>
</div>

<DemoCode />

<Bortable @bind-Items="_items" TItem="string" Handle=".handle" Id="handle-list"
          Class="demo-list" ItemClass="demo-item" GhostClass="demo-ghost">
    <ItemTemplate Context="item">
        <span class="handle">☰</span>@item
    </ItemTemplate>
</Bortable>

<p class="demo-order"><strong>Order:</strong> <span id="handle-order">@string.Join(", ", _items)</span></p>

@code {
    private IList<string> _items = new List<string>
    {
        "Item 1", "Item 2", "Item 3", "Item 4", "Item 5", "Item 6"
    };
}
