<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- The host owns the launch profile: this project is never started on its own. -->
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <!-- Publishes this project's static web assets at the app root (not under _content/), the
             way a Blazor Web App's client project is expected to contribute them. -->
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Bit.Minifier" Version="11.0.0-pre-14" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Bortable\Bit.Bortable.csproj" />
    </ItemGroup>

    <!--
        Generates a compiled lookup (DemoSources.g.cs) that maps each file of the Samples folder to
        its source text, so the "View code" panel under a demo sample shows the code of that sample
        and nothing else. Every sample is a component of its own - the very one the page renders - so
        what the panel shows is what runs; a sample built from more files (the recursive
        NestedList.razor, a plain .cs model) names them in <DemoCode Files="..." />.
    -->
    <UsingTask TaskName="GenerateDemoSources"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <SourceDir ParameterType="System.String" Required="true" />
            <OutputFile ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs">
<![CDATA[
var files = new StringBuilder();
var root = Path.GetFullPath(SourceDir).TrimEnd('\\', '/') + Path.DirectorySeparatorChar;
var sources = Directory.GetFiles(SourceDir, "*.razor", SearchOption.AllDirectories)
    .Concat(Directory.GetFiles(SourceDir, "*.cs", SearchOption.AllDirectories))
    .OrderBy(f => f, StringComparer.Ordinal);
foreach (var file in sources)
{
    // Shown verbatim, under its path relative to Samples: "CloneSource.razor".
    var path = Path.GetFullPath(file).Substring(root.Length).Replace('\\', '/');
    var content = File.ReadAllText(file).Trim('\r', '\n', ' ', '\t');
    files.Append("        [@\"").Append(path.Replace("\"", "\"\"")).Append("\"] = @\"")
         .Append(content.Replace("\"", "\"\"")).AppendLine("\",");
}

var sb = new StringBuilder();
sb.AppendLine("// <auto-generated />");
sb.AppendLine("namespace Bit.Bortable.Demo.Client.Examples;");
sb.AppendLine("public static class DemoSources");
sb.AppendLine("{");
// Case-insensitive, like the file system the samples come from.
sb.AppendLine("    public static readonly System.Collections.Generic.Dictionary<string, string> Files = new(System.StringComparer.OrdinalIgnoreCase)");
sb.AppendLine("    {");
sb.Append(files);
sb.AppendLine("    };");
sb.AppendLine("}");

// Only touch the file when its content changed: rewriting it on every build would bump its
// timestamp and force a full recompile of the demo even when no sample was edited.
var text = sb.ToString();
if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
{
    Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
    File.WriteAllText(OutputFile, text, new UTF8Encoding(false));
}
]]>
            </Code>
        </Task>
    </UsingTask>

    <Target Name="GenerateDemoSources" BeforeTargets="BeforeCompile;CoreCompile">
        <PropertyGroup>
            <DemoSourcesFile>$(IntermediateOutputPath)DemoSources.g.cs</DemoSourcesFile>
        </PropertyGroup>
        <GenerateDemoSources SourceDir="$(MSBuildProjectDirectory)\Samples" OutputFile="$(DemoSourcesFile)" />
        <!-- Unconditional: the file has to be compiled whether or not this build rewrote it.
             FileWrites lets Clean delete it. -->
        <ItemGroup>
            <Compile Include="$(DemoSourcesFile)" />
            <FileWrites Include="$(DemoSourcesFile)" />
        </ItemGroup>
    </Target>

</Project>
