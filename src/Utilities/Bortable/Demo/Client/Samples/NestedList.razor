@* Recursive component: a sortable list whose items can each contain another sortable list.
   Every level shares the "nested" group, so items can move between branches. Every item renders a
   list of its own, empty or not, so any item can take children. *@

<Bortable Items="Items" TItem="NestedItem" Group="nested" SwapThreshold="0.65" Id="@Id"
          ItemsChanged="OnItemsChanged"
          Class="nested-list" ItemClass="nested-item" GhostClass="demo-ghost">
    <ItemTemplate Context="item">
        <div class="nested-item__name">@item.Name</div>
        <NestedList Items="item.Children" Id="@ListIdOf(item)" OnTreeChanged="OnTreeChanged" />
    </ItemTemplate>
</Bortable>

@code {
    [Parameter, EditorRequired] public List<NestedItem> Items { get; set; } = new();

    /// <summary>The list's DOM id: "nested-root" for the top level, "nested-item-1-1" for the children of "Item 1.1".</summary>
    [Parameter] public string Id { get; set; } = "nested-root";

    /// <summary>Raised when any list of the tree changed, so the page can show the new tree.</summary>
    [Parameter] public EventCallback OnTreeChanged { get; set; }

    private Task OnItemsChanged(IList<NestedItem> items) => OnTreeChanged.InvokeAsync();

    // The id follows the item that owns the list, wherever the item is moved.
    private static string ListIdOf(NestedItem item)
        => "nested-" + item.Name.ToLowerInvariant().Replace(' ', '-').Replace('.', '-');
}
