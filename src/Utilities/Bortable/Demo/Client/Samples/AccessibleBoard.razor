@* Two lists to drive from the keyboard: every step is announced, in English or in German, and the
   buttons on each item move it without a drag, with MoveAsync and MoveToAsync. *@

<div class="demo-controls">
    <div class="demo-control">
        <span id="a11y-language-label">Announcements in</span>
        <div class="bb-segmented" role="group" aria-labelledby="a11y-language-label">
            <button type="button" id="a11y-english" aria-pressed="@(!_german ? "true" : "false")" @onclick="() => _german = false">English</button>
            <button type="button" id="a11y-german" aria-pressed="@(_german ? "true" : "false")" @onclick="() => _german = true">Deutsch</button>
        </div>
    </div>
</div>

<div class="demo-columns">
    <div class="demo-col">
        <div class="demo-col-title" id="a11y-backlog-title">Backlog</div>
        <Bortable @ref="_backlogList" @bind-Items="_backlog" TItem="string" Group="a11y" Id="a11y-backlog"
                  AriaLabel="Backlog" OnEnd="Log" Messages="Texts"
                  Class="demo-list" ItemClass="demo-item a11y-item" GhostClass="demo-ghost">
            <ItemTemplate Context="item">
                <span>@item</span>
                <span class="a11y-actions">
                    <button type="button" aria-label="@($"Move {item} up")" @onclick="() => MoveUp(_backlogList, _backlog, item)">↑</button>
                    <button type="button" aria-label="@($"Move {item} down")" @onclick="() => MoveDown(_backlogList, _backlog, item)">↓</button>
                    <button type="button" aria-label="@($"Move {item} to the Sprint")" @onclick='() => _backlogList.MoveToAsync(item, "a11y-sprint", _sprint.Count)'>→</button>
                </span>
            </ItemTemplate>
        </Bortable>
    </div>
    <div class="demo-col">
        <div class="demo-col-title" id="a11y-sprint-title">Sprint</div>
        <Bortable @ref="_sprintList" @bind-Items="_sprint" TItem="string" Group="a11y" Id="a11y-sprint"
                  AriaLabel="Sprint" OnEnd="Log" Messages="Texts"
                  Class="demo-list" ItemClass="demo-item a11y-item tinted" GhostClass="demo-ghost">
            <ItemTemplate Context="item">
                <span>@item</span>
                <span class="a11y-actions">
                    <button type="button" aria-label="@($"Move {item} up")" @onclick="() => MoveUp(_sprintList, _sprint, item)">↑</button>
                    <button type="button" aria-label="@($"Move {item} down")" @onclick="() => MoveDown(_sprintList, _sprint, item)">↓</button>
                    <button type="button" aria-label="@($"Move {item} back to the Backlog")" @onclick='() => _sprintList.MoveToAsync(item, "a11y-backlog", _backlog.Count)'>←</button>
                </span>
            </ItemTemplate>
        </Bortable>
    </div>
</div>

<p class="demo-order"><strong>Backlog:</strong> <span id="a11y-backlog-order">@string.Join(", ", _backlog)</span></p>
<p class="demo-order"><strong>Sprint:</strong> <span id="a11y-sprint-order">@string.Join(", ", _sprint)</span></p>

<div class="demo-columns">
    <div class="demo-col">
        <p class="demo-log-title" id="a11y-heard-title">What a screen reader hears</p>
        <div class="bb-log event-log" id="a11y-heard" aria-labelledby="a11y-heard-title">
            @if (_heard.Count == 0)
            {
                <div class="bb-log-empty event-log__empty">Nothing announced yet…</div>
            }
            @foreach (var line in _heard)
            {
                <div class="bb-log-line event-log__line">@line</div>
            }
        </div>
    </div>
    <div class="demo-col">
        <p class="demo-log-title" id="a11y-log-title">Moves (OnEnd, with its Input)</p>
        <div class="bb-log event-log" id="a11y-log" aria-labelledby="a11y-log-title">
            @if (_log.Count == 0)
            {
                <div class="bb-log-empty event-log__empty">No moves yet…</div>
            }
            @foreach (var line in _log)
            {
                <div class="bb-log-line event-log__line">@line</div>
            }
        </div>
    </div>
</div>

@code {
    private Bortable<string> _backlogList = default!;
    private Bortable<string> _sprintList = default!;
    private IList<string> _backlog = new List<string> { "Sign-up page", "Password reset", "Audit log", "Dark mode" };
    private IList<string> _sprint = new List<string> { "Search", "Export to CSV" };
    private readonly List<string> _log = [];
    private readonly List<string> _heard = [];
    private bool _german;

    private BortableMessages? _englishTexts, _germanTexts;

    // The lists' texts. Wrapped only so this page can show what is announced; an app passes its messages as they are.
    private BortableMessages Texts => _german ? (_germanTexts ??= Overheard(German)) : (_englishTexts ??= Overheard(BortableMessages.Default));

    private static Task MoveUp(Bortable<string> list, IList<string> items, string item)
        => list.MoveAsync(item, Math.Max(0, items.IndexOf(item) - 1));

    private static Task MoveDown(Bortable<string> list, IList<string> items, string item)
        => list.MoveAsync(item, Math.Min(items.Count - 1, items.IndexOf(item) + 1));

    private void Log(BortableEventArgs<string> e)
    {
        var what = e.Canceled ? "cancelled" : e.CrossedLists ? $"{e.FromId} -> {e.ToId}#{e.NewIndex}" : $"#{e.OldIndex} -> #{e.NewIndex}";
        _log.Insert(0, $"[{e.Input.ToString().ToLowerInvariant()}] {e.Item}: {what}");
        if (_log.Count > 12) _log.RemoveAt(_log.Count - 1);
    }

    private static readonly BortableMessages German = new()
    {
        Instructions = "Leertaste oder Eingabetaste nimmt das Element auf. Danach verschieben es die Pfeiltasten, Pos1 und Ende an den " +
                       "Anfang oder das Ende der Liste, Leertaste oder Eingabetaste legt es ab, und Escape bringt es zurück.",
        SelectionInstructions = "Umschalt und Leertaste wählen das Element aus oder ab; ein ausgewähltes Element nimmt die ganze Auswahl mit.",
        RoleDescription = "sortierbares Element",
        PickedUp = a => $"{a.Item} aufgenommen. Position {a.Position} von {a.Count}{In(a.List)}.",
        Moved = a => $"{a.Item} auf Position {a.Position} von {a.Count}{In(a.List)} verschoben.",
        SwapTarget = a => a.Target is null ? $"{a.Item} bleibt, wo es ist." : $"{a.Item} tauscht den Platz mit {a.Target}.",
        Dropped = a => a.Returned
            ? $"{a.Item} abgelegt. Wieder auf Position {a.Position} von {a.Count}{In(a.List)}."
            : $"{a.Item} auf Position {a.Position} von {a.Count}{In(a.List)} abgelegt.",
        Canceled = a => $"Abgebrochen. {a.Item} ist wieder auf Position {a.Position} von {a.Count}{In(a.List)}.",
        Refused = a => $"{a.Item} kann nicht dorthin verschoben werden.",
        Locked = a => $"{a.Item} kann nicht verschoben werden.",
        Selected = a => $"{a.Item} ausgewählt. {a.Selected} ausgewählt.",
        Deselected = a => $"{a.Item} abgewählt. {a.Selected} ausgewählt.",
    };

    private static string In(string? list) => list is null ? "" : $" in {list}";

    // The same messages, each also written to the page's "What a screen reader hears" log.
    private BortableMessages Overheard(BortableMessages m) => new()
    {
        Instructions = m.Instructions,
        SelectionInstructions = m.SelectionInstructions,
        RoleDescription = m.RoleDescription,
        PickedUp = a => Heard(m.PickedUp(a)),
        Moved = a => Heard(m.Moved(a)),
        SwapTarget = a => Heard(m.SwapTarget(a)),
        Dropped = a => Heard(m.Dropped(a)),
        Canceled = a => Heard(m.Canceled(a)),
        Refused = a => Heard(m.Refused(a)),
        Locked = a => Heard(m.Locked(a)),
        Selected = a => Heard(m.Selected(a)),
        Deselected = a => Heard(m.Deselected(a)),
    };

    // A message is made while the list is busy with the drag: the log is shown once the list is done.
    private string Heard(string text)
    {
        _heard.Insert(0, text);
        if (_heard.Count > 12) _heard.RemoveAt(_heard.Count - 1);
        _ = ShowHeardAsync();
        return text;
    }

    private async Task ShowHeardAsync()
    {
        await Task.Yield();
        StateHasChanged();
    }
}
