@* Swap mode across two lists of one group: each list keeps its length. *@

<div class="demo-columns">
    <div class="demo-col">
        <Bortable @bind-Items="_left" TItem="string" Group="swap-shared" Swap="true" Id="swap-left" AriaLabel="Left"
                  Class="demo-list" ItemClass="demo-item" GhostClass="demo-ghost">
            <ItemTemplate Context="item">@item</ItemTemplate>
        </Bortable>
    </div>
    <div class="demo-col">
        <Bortable @bind-Items="_right" TItem="string" Group="swap-shared" Swap="true" Id="swap-right" AriaLabel="Right"
                  Class="demo-list" ItemClass="demo-item tinted" GhostClass="demo-ghost">
            <ItemTemplate Context="item">@item</ItemTemplate>
        </Bortable>
    </div>
</div>

<p class="demo-order"><strong>Left:</strong> <span id="swap-left-order">@string.Join(", ", _left)</span></p>
<p class="demo-order"><strong>Right:</strong> <span id="swap-right-order">@string.Join(", ", _right)</span></p>

@code {
    private IList<string> _left = new List<string> { "Item 1", "Item 2", "Item 3", "Item 4" };
    private IList<string> _right = new List<string> { "Item A", "Item B", "Item C", "Item D" };
}
