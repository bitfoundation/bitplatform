@* Locks that follow the data: Filter reads each task's Locked flag, which a button in the task toggles. *@

<Bortable @bind-Items="_tasks" TItem="TaskItem" Id="filter-tasks" AriaLabel="Tasks"
          Filter="t => t.Locked" ItemLabel="t => t.Title"
          Class="demo-list" ItemClass="demo-item" GhostClass="demo-ghost">
    <ItemTemplate Context="task">
        <span class="demo-row">
            <span class="demo-row__text">@task.Title</span>
            <button type="button" class="demo-icon-btn" aria-pressed="@(task.Locked ? "true" : "false")"
                    aria-label="@($"Lock {task.Title}")" @onclick="() => task.Locked = !task.Locked">@(task.Locked ? "🔒" : "🔓")</button>
        </span>
    </ItemTemplate>
</Bortable>

<p class="demo-order"><strong>Tasks:</strong> <span id="filter-tasks-order">@string.Join(", ", _tasks.Select(t => t.Locked ? $"{t.Title} (locked)" : t.Title))</span></p>

@code {
    private IList<TaskItem> _tasks = new List<TaskItem>
    {
        new() { Title = "Write the tests" },
        new() { Title = "Release notes", Locked = true },
        new() { Title = "Deploy" },
        new() { Title = "Announce" },
    };

    public sealed class TaskItem
    {
        public required string Title { get; init; }
        public bool Locked { get; set; }
    }
}
