@* A list in swap mode: the item dropped on trades places with the dragged one, and nothing moves meanwhile. *@

<Bortable @bind-Items="_list" TItem="string" Swap="true" Id="swap-list" AriaLabel="Single list" OnUpdate="OnSwapped"
          Class="demo-list" ItemClass="demo-item" GhostClass="demo-ghost">
    <ItemTemplate Context="item">@item</ItemTemplate>
</Bortable>

<p class="demo-order"><strong>Order:</strong> <span id="swap-order">@string.Join(", ", _list)</span></p>
<p class="demo-order"><strong>Last swap:</strong> <span id="swap-last">@_lastSwap</span></p>

@code {
    private IList<string> _list = new List<string>
    {
        "Item 1", "Item 2", "Item 3", "Item 4", "Item 5", "Item 6"
    };

    private string _lastSwap = "nothing yet";

    // SwappedWith names the item the dragged one traded places with: both moves, for a handler that saves them.
    private void OnSwapped(BortableEventArgs<string> e)
        => _lastSwap = e.IsSwap ? $"{e.Item} ⇄ {e.SwappedWith}" : $"{e.Item} moved";
}
