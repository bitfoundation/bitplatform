@namespace Bit.Bortable.Demo.Client.Examples
@inject NavigationManager Nav

@* A collapsible "View code" panel that shows the .razor source of the current demo page.
   The source is resolved from the build-generated DemoSources lookup, keyed by route. A page
   built from more than one file names the others in Files (paths relative to Pages, separated
   by commas), and they are shown after it. *@

<div class="bb-source demo-code">
    <button type="button"
            class="btn btn-secondary demo-code__toggle"
            aria-expanded="@_open.ToString().ToLowerInvariant()"
            @onclick="Toggle">
        <span class="demo-code__caret">@(_open ? "▾" : "▸")</span>
        <span class="demo-code__glyph">&lt;/&gt;</span>
        @(_open ? "Hide code" : "View code")
    </button>

    @if (_open)
    {
        @if (_sources.Count == 0)
        {
            <div class="bb-empty demo-code__empty">Source for this page is not available.</div>
        }
        else
        {
            @foreach (var (path, source) in _sources)
            {
                @if (_sources.Count > 1)
                {
                    <div class="bb-source-file demo-code__file">@path</div>
                }
                <pre class="bb-code demo-code__pre"><code class="demo-code__code">@source</code></pre>
            }
        }
    }
</div>

@code {
    private bool _open;
    private bool _resolved;
    private List<(string Path, string Source)> _sources = [];

    /// <summary>Other files of the Pages folder this page is built from, separated by commas.</summary>
    [Parameter] public string? Files { get; set; }

    private void Toggle()
    {
        _open = !_open;
        if (_open && !_resolved)
        {
            _sources = Resolve();
            _resolved = true;
        }
    }

    private List<(string Path, string Source)> Resolve()
    {
        var key = Nav.ToBaseRelativePath(Nav.Uri);

        // Drop any query string or fragment so the key matches the @page route. The lookup
        // itself ignores case, as the router does.
        var cut = key.IndexOfAny(['?', '#']);
        if (cut >= 0) key = key[..cut];
        key = key.TrimEnd('/');

        var sources = new List<(string Path, string Source)>();
        if (!DemoSources.ByRoute.TryGetValue(key, out var page)) return sources;

        sources.Add((DemoSources.PathByRoute.GetValueOrDefault(key, key), page));
        foreach (var file in (Files ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (DemoSources.ByFile.TryGetValue(file, out var source)) sources.Add((file, source));
        }
        return sources;
    }
}
