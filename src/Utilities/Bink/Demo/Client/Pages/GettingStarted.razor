        <a href="collaboration" class="btn btn-outline">Draw together →</a>
        <a href="extending" class="btn btn-outline">Your own brushes and elements →</a>
    </div>
</div>

@code {
    private BinkCanvas? _canvas;
    private CanvasStatus? _status;
    private string? _unavailable;

    private bool IsEmpty => _canvas?.CurrentDocument.IsEmpty ?? true;

    // Built once, by the engine alone: the "drawing without a canvas" above is this document, exported as SVG.
    private static readonly string HeadlessSvg = BuildHeadlessDrawing();

    private static string BuildHeadlessDrawing()
    {
        BinkColor blue = BinkColor.Parse("#1d4ed8");
        var frame = new BinkShapeStyle { StrokeColor = BinkColor.Parse("#94a3b8"), StrokeWidth = 2f, Dash = [6f, 5f] };
        BinkTextStyle label = BinkTextStyle.Default with { FontSize = 15f, Bold = true, Color = BinkColor.Parse("#334155") };

        var document = new BinkDocument(new BinkDocumentSettings { Width = 400, Height = 160 });
        var points = BinkStrokePoints.FromPositions([new(40, 112), new(120, 52), new(200, 104), new(280, 48), new(360, 100)]);
        document.AddElement(new BinkStroke(points, new BinkPenBrush { Width = 7f, Color = blue }));
        document.AddElement(new BinkRectangleShape(new BinkRect(16, 16, 368, 128)) { CornerRadius = 12f, Style = frame });
        document.AddElement(new BinkTextElement(new System.Numerics.Vector2(30, 26), "Built in C#") { Style = label });

        return BinkSvgExporter.Export(document, new BinkSvgExportOptions { Title = "A drawing built in C#, exported without a canvas" });
    }
}
