@page "/mcp-server"

@* Describes the MCP server this demo's host maps at /mcp. Its route differs from the endpoint's on
   purpose: two literal endpoints on /mcp would make a GET of it ambiguous. *@

<PageTitle>MCP server · Bink</PageTitle>

<div class="bb-intro">
    <h1>MCP server</h1>
    <p class="bb-subtitle">
        This site hosts a Model Context Protocol server at <code>/mcp</code>, so an AI agent writing drawing code
        with Bit.Bink reads the library itself - its compiled API documentation, its guide, its brush registry, its
        serializer and these demo pages - instead of guessing at an API it half remembers. Every tool is read-only.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Connect a client</h3>

    <p>
        The endpoint is plain Streamable HTTP, so any MCP client connects with a URL and nothing else. The same tools
        are also served, version by version, through the bit platform's own server at
        <code>https://bitplatform.dev/mcp</code>, next to the other bit libraries.
    </p>

    <pre class="bb-code">@ClientConfig</pre>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Tools</h3>

    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Tool</th><th>What it answers</th></tr>
            </thead>
            <tbody>
                @foreach (var tool in Tools)
                {
                    <tr>
                        <td class="bb-table-key"><code>@tool.Name</code></td>
                        <td>@tool.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p>
        The guide, the API, the brushes, a sample document and the sources are also exposed as <code>bink://</code>
        resources, and three prompts - <code>add-bink-to-app</code>, <code>implement-bink-feature</code> and
        <code>debug-bink-canvas</code> - walk an agent through the common jobs in the right order.
    </p>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> The same tools over plain HTTP</h3>

    <p>
        Every tool is also a <code>GET</code> under <code>/api/mcp/...</code>: open one in a browser tab to read
        exactly what an agent is handed.
    </p>

    <ul class="bb-detail-list">
        @foreach (var (href, text) in HttpExamples)
        {
            <li><a href="@href" target="_blank" rel="noopener">@text</a></li>
        }
    </ul>
</section>

@code {
    private const string ClientConfig = """
        // .mcp.json (Claude Code, VS Code, and anything else reading this shape)
        {
          "mcpServers": {
            "bink": {
              "type": "http",
              "url": "https://bink.bitplatform.dev/mcp"
            }
          }
        }
        """;

    // The server's tools, in the order an agent usually needs them. The one place to change when a tool is
    // added, renamed or retired.
    private static readonly (string Name, string Description)[] Tools =
    [
        ("SearchBink",
            "Everything at once - the guide, every public member, the brushes, the setup guides, the stylesheet and the demo sources - each hit with the exact follow-up call."),
        ("GetBinkSetupGuide",
            "The complete wiring for one render mode: server, wasm, auto, standalone-wasm or hybrid."),
        ("GetBinkGuideSection",
            "One section of the reference guide, or the index of sections."),
        ("GetBinkApi",
            "One public type with every parameter, property and method, its real default and its documentation - or the index of types."),
        ("GetBinkBrushes",
            "The built-in brushes with their real defaults, their geometry and the JSON a stroke stores them as."),
        ("InspectBinkDocument",
            "What the library's own serializer and exporters make of a saved document - or a sample document, to see the format."),
        ("GetBinkSourceFile",
            "One demo or library file verbatim - every page here is a working drawing surface - or the index of files."),
    ];

    private static readonly (string Href, string Text)[] HttpExamples =
    [
        ("/api/mcp/SearchBink?query=signature%20pad%20export%20png", "/api/mcp/SearchBink?query=signature pad export png"),
        ("/api/mcp/GetBinkApi?typeName=BinkCanvas", "/api/mcp/GetBinkApi?typeName=BinkCanvas"),
        ("/api/mcp/GetBinkBrushes?kind=pen", "/api/mcp/GetBinkBrushes?kind=pen"),
        ("/api/mcp/InspectBinkDocument", "/api/mcp/InspectBinkDocument"),
        ("/api/mcp/GetBinkSourceFile?path=Demo/Client/Pages/Signature.razor", "/api/mcp/GetBinkSourceFile?path=Demo/Client/Pages/Signature.razor"),
    ];
}
