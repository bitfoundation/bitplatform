                    </p>
                    <a href="whiteboard">Whiteboard →</a>
                </div>
                <pre class="bb-code">&lt;<span class="k">BinkCanvas</span> Tool=<span class="s">"_tool"</span> Brush=<span class="s">"_brush"</span> Height=<span class="s">"400px"</span> /&gt;

<span class="k">private</span> IBinkTool _tool = <span class="k">new</span> BinkDrawTool();
<span class="k">private</span> BinkBrush _brush = <span class="k">new</span> BinkPenBrush { Color = BinkColor.Parse(<span class="s">"#1d4ed8"</span>), Width = 5f };

<span class="k">private void</span> UseEraser() =&gt; _tool = <span class="k">new</span> BinkEraserTool { Mode = BinkEraserMode.Stroke, Radius = 12f };</pre>
            </div>
            <div class="bb-walkthrough-row">
