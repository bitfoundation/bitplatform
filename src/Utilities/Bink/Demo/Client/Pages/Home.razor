@page "/"
@layout MainLayout

<PageTitle>Bink - drawing and ink for Blazor</PageTitle>

@* The landing page: hero → proof strip → use cases → code walkthrough → comparison with a JavaScript
   drawing library → persona tiles → FAQ → final call to action. Everything else on the site is a
   documentation page under DocsLayout. The hero's sample is a live canvas rather than a picture of
   one - an ink library is best introduced by being drawn on. *@

<div class="bb-landing">

    @* ============================== Hero ============================== *@

    <section class="bb-hero">
        <div class="bb-hero-copy">
            <span class="bb-hero-eyebrow">
                <span class="bb-dot bb-dot-success"></span>
                Open source · MIT · net8.0 / net9.0 / net10.0
            </span>
            <h1>Drawing and ink for Blazor,<br /><span class="bb-hero-accent">engineered in C#.</span></h1>
            <p class="bb-hero-sub">
                Signature fields, handwriting, whiteboards, image markup and document review on one vector
                document model. The stroke model, smoothing, pressure response, hit testing, undo, serialization
                and export are C#; JavaScript only collects pointer input and replays a command buffer onto a
                canvas - there is no JavaScript drawing library underneath.
            </p>
            <pre class="bb-code bb-hero-install">dotnet add package Bit.Bink</pre>
            <div class="bb-hero-actions">
                <a href="getting-started" class="btn btn-primary bb-btn-lg">Get started →</a>
                <a href="whiteboard" class="btn btn-secondary bb-btn-lg">Live demos</a>
                <a class="btn btn-secondary bb-btn-lg" href="@SiteInfo.ProjectUrl" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            </div>
        </div>

        @* The sample, framed as a window: the markup on top, and the canvas it renders underneath -
           live, so the first thing a visitor can do here is draw on it. *@
        <div class="bb-hero-code">
            <div class="bb-browser">
                <div class="bb-browser-bar">
                    <span class="bb-browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="bb-browser-url">Sketch.razor</span>
                </div>
                <pre class="bb-code">&lt;<span class="k">BinkCanvas</span> @@ref=<span class="s">"_canvas"</span> Height=<span class="s">"240px"</span> Brush=<span class="s">"_pen"</span>
            EnableTouchGestures=<span class="s">"true"</span> /&gt;

<span class="k">private</span> BinkBrush _pen = <span class="k">new</span> BinkPenBrush { Width = 4f };</pre>
                <div class="bink-hero-live">
                    <div class="bink-surface">
                        @* A host that reads canvas state (such as the undo button below) re-renders on these
                           callbacks. Pointer input itself never re-renders anything. *@
                        <BinkCanvas @ref="_canvas" Height="240px" Brush="_pen" EnableTouchGestures="true"
                                    AriaLabel="Try drawing here"
                                    HistoryChanged="() => StateHasChanged()"
                                    DocumentChanged="() => StateHasChanged()" />
                        @if (_canvas is null || _canvas.CurrentDocument.IsEmpty)
                        {
                            <span class="bink-surface-hint" aria-hidden="true">Draw here with a mouse, a finger or a stylus</span>
                        }
                    </div>
                    <div class="bb-toolbar bink-toolbar">
                        <span class="bink-hint">Ink is a vector document, not pixels.</span>
                        <span class="bb-spacer"></span>
                        <button type="button" class="btn btn-secondary" disabled="@(_canvas is null || !_canvas.History.CanUndo)" @onclick="Undo">Undo</button>
                        <button type="button" class="btn btn-secondary bink-danger" disabled="@(_canvas is null || _canvas.CurrentDocument.IsEmpty)" @onclick="Clear">Clear</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ============================== Proof strip ============================== *@

    <section class="bb-proof">
        <div><strong>Engine in C#</strong><span>strokes, geometry, hit testing and undo</span></div>
        <div><strong>A vector document</strong><span>saved, versioned and re-rendered at any size</span></div>
        <div><strong>Pen-grade input</strong><span>pressure, tilt, palm rejection, coalesced samples</span></div>
        <div><strong>Every hosting model</strong><span>WebAssembly, Server, Web App and Hybrid</span></div>
    </section>

