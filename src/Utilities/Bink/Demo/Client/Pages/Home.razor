@code {
    // The theme's text colour (--bit-clr-fg-pri in app.css), so the sketch reads on the theme's surface the way
    // the page's own text does.
    private static readonly BinkColor LightInk = BinkColor.Parse("#1A1A1A");
    private static readonly BinkColor DarkInk = BinkColor.Parse("#E6ECF2");

    private BinkCanvas? _canvas;
    private readonly BinkDocument _sketch = new(BinkDocumentSettings.Default with { Background = BinkColor.Transparent });
    private BinkBrush _pen = new BinkPenBrush { Width = 4f, Color = LightInk };
    private DotNetObjectReference<Home>? _self;
    private IJSObjectReference? _themeSubscription;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender is false) return;

        // Not during prerendering, where OnAfterRender does not run: the pen starts in the light theme's ink, and
        // theme.js calls back with the current theme at once, recolouring anything drawn in between.
        _self = DotNetObjectReference.Create(this);
        _themeSubscription = await JSRuntime.InvokeAsync<IJSObjectReference>("bitDemoTheme.subscribe", _self, nameof(OnThemeChanged));
    }

    /// <summary>Called by theme.js with "light" or "dark" when subscribing and after every change.</summary>
    [JSInvokable]
    public Task OnThemeChanged(string theme) => InvokeAsync(() =>
    {
        BinkColor ink = theme == "dark" ? DarkInk : LightInk;
        if (_pen.Color == ink) return;

        _pen = _pen with { Color = ink };
        RecolorInk();
        StateHasChanged();
    });

    /// <summary>
    /// Gives the other theme's ink the current theme's colour; any other colour is left as drawn. It is applied the
    /// way a loaded document is, which history does not record, so undo never brings the old ink back.
    /// </summary>
    private void RecolorInk()
    {
        BinkColor stale = _pen.Color == DarkInk ? LightInk : DarkInk;
        var strokes = new List<BinkStroke>();
        foreach (BinkLayer layer in _sketch.Layers)
            foreach (BinkElement element in layer.Elements)
                if (element is BinkStroke { IsEraser: false } stroke && stroke.Brush.Color == stale) strokes.Add(stroke);
        if (strokes.Count == 0) return;

        using (_sketch.BeginBatch("Theme", BinkChangeOrigin.Load))
        {
            foreach (BinkStroke stroke in strokes) _sketch.ReplaceElement(stroke with { Brush = stroke.Brush with { Color = _pen.Color } });
        }
    }

    // Undo and redo put strokes back exactly as history recorded them, so a stroke cleared or undone before the theme
    // changed comes back in the other theme's ink.
    private void OnSketchChanged(BinkDocumentChangedEventArgs e)
    {
        if (e.Origin is BinkChangeOrigin.Undo or BinkChangeOrigin.Redo) RecolorInk();
    }

    private void Undo() => _canvas?.Undo();

    private void Clear() => _canvas?.Clear();

    public async ValueTask DisposeAsync()
    {
        if (_themeSubscription is not null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("bitDemoTheme.unsubscribe", _themeSubscription);
                await _themeSubscription.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; there is nothing on the other side to unsubscribe from.
            }
            _themeSubscription = null;
        }

        _self?.Dispose();
        _self = null;
    }
}
