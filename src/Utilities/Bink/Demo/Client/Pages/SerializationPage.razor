@page "/serialization"
@using System.Numerics
@inject FileDownloads Downloads

<PageTitle>Serialization · Bink</PageTitle>

<div class="bb-intro">
    <h1>Serialization</h1>
    <p class="bb-subtitle">
        Drawings are vector documents, not pictures. Draw on the left, then save, reload and export on the right.
        The compact format stores a handwriting point in a few bytes; the readable format is the same data as plain
        JSON for diffing and inspection.
    </p>
</div>

<div class="bb-demo bink-editor bb-page-wide">
    <div class="bink-pair">
        <div class="bink-peer">
            <div class="bb-toolbar bink-toolbar">
                <span class="bink-hint">Draw something, then save it.</span>
                <span class="bb-spacer"></span>
                <div class="bink-group" role="group" aria-label="History">
                    <button type="button" class="btn btn-secondary" disabled="@(_canvas is not { History.CanUndo: true })" @onclick="() => _canvas?.Undo()">Undo</button>
                    <button type="button" class="btn btn-secondary bink-danger" disabled="@(_canvas is null || _canvas.CurrentDocument.IsEmpty)" @onclick="() => _canvas?.Clear()">Clear</button>
                </div>
            </div>
            <div class="bink-surface">
                <BinkCanvas @ref="_canvas" HistoryChanged="() => StateHasChanged()" Height="340px" Brush="_brush" AriaLabel="Source drawing"
                           ViewportChanged="_status?.ViewportChanged ?? default"
                           DocumentChanged="() => StateHasChanged()"
                           Ready="() => StateHasChanged()" />
            </div>
            <CanvasStatus @ref="_status" Canvas="_canvas" />
        </div>

        <div class="bink-peer">
            <div class="bb-toolbar bink-toolbar">
                <button type="button" class="btn btn-primary" @onclick="Save">Save</button>
                <button type="button" class="btn btn-secondary" disabled="@(_saved is null)" @onclick="Load">Load into the canvas</button>
                <button type="button" class="btn btn-secondary" disabled="@(_saved is null)" @onclick="DownloadAsync">Download</button>
                <label class="btn btn-secondary">
                    Open file
                    <InputFile OnChange="OpenAsync" accept=".json,.bink,application/json" class="bink-file-input" />
                </label>
                <span class="bb-spacer"></span>
                <label class="bb-check">
                    <input type="checkbox" checked="@_readable" @onchange="OnReadableChanged" />
                    Readable JSON
                </label>
            </div>

            <div class="bink-pane">
                @if (_stats is not null)
                {
                    <dl class="bb-params">
                        <dt>Elements</dt><dd>@_stats.Elements</dd>
                        <dt>Stroke points</dt><dd>@_stats.Points</dd>
                        <dt>Compact document</dt><dd>@FormatBytes(_stats.CompactBytes)</dd>
                        <dt>Readable document</dt><dd>@FormatBytes(_stats.ReadableBytes)</dd>
                        <dt>Bytes per point (compact)</dt><dd>@(_stats.Points == 0 ? "-" : (_stats.CompactBytes / (double)_stats.Points).ToString("0.0"))</dd>
                        <dt>SVG export</dt><dd>@FormatBytes(_stats.SvgBytes)</dd>
                        <dt>PNG export (1x)</dt><dd>@FormatBytes(_stats.PngBytes)</dd>
                        <dt>Round trip identical</dt><dd>@(_stats.RoundTripStable ? "yes" : "no")</dd>
                    </dl>
                }
                else
                {
                    <div class="bb-empty">Save the drawing to see how it is stored.</div>
                }
            </div>
        </div>
    </div>
</div>

@if (_error is not null)
{
    <div class="bb-note bb-note-danger" role="alert">@_error</div>
}

@if (_saved is not null)
{
    <div class="bb-card">
        <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Stored document</h3>
        <p class="bb-card-desc">
            This is the text that was saved, and you can edit it. Change a number and load it to see the edit take
            effect, or break the JSON to see the loader refuse it with a reason instead of loading half a drawing.
        </p>
        <textarea class="bink-json" aria-label="Stored document" spellcheck="false" rows="14"
                  value="@_saved" @onchange="e => _saved = e.Value?.ToString()"></textarea>
    </div>
}

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> The API</h3>
    <p class="bb-card-desc">
        Saving is one call and so is loading. For anything that came from outside your own code - a file a person
        opened, a request body - use <code>TryDeserialize</code>, which reports a message instead of throwing.
    </p>
    <pre class="bb-code"><span class="k">string</span> compact = BinkSerializer.Serialize(document);
<span class="k">string</span> readable = BinkSerializer.Serialize(document, BinkSerializerOptions.Readable);

<span class="k">if</span> (BinkSerializer.TryDeserialize(json, <span class="k">out</span> BinkDocument? loaded, <span class="k">out string</span>? error) &amp;&amp; loaded <span class="k">is not null</span>)
{
    _canvas.LoadDocument(loaded);
}</pre>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Compatibility</h3>
    <p class="bb-card-desc">
        The format carries a schema version. A document written by a newer version is refused with an explanation
        rather than being partially read, and elements of unknown types are preserved untouched through a load and
        save, so an old build never silently destroys work made by a new one.
    </p>
</div>

@code {
    private sealed record Stats(int Elements, long Points, int CompactBytes, int ReadableBytes, int SvgBytes, int PngBytes, bool RoundTripStable);

    private BinkCanvas? _canvas;
    private CanvasStatus? _status;
    private readonly BinkBrush _brush = new BinkPenBrush { Width = 4f, Color = BinkColor.Parse("#111827") };
    private BinkDocument? _snapshot;
    private string? _saved;
    private string? _error;
    private bool _readable;
    private Stats? _stats;

    private void OnReadableChanged(ChangeEventArgs e)
    {
        _readable = e.Value is true;
        // Re-show what was saved in the other format. The drawing may have changed since; that is not saved yet.
        if (_snapshot is not null) Show(_snapshot);
    }

    private void Save()
    {
        if (_canvas is null) return;
        _error = null;
        _snapshot = _canvas.CurrentDocument.Clone();
        Show(_snapshot);
    }

    private void Show(BinkDocument document)
    {
        string compact = BinkSerializer.Serialize(document);
        string readable = BinkSerializer.Serialize(document, BinkSerializerOptions.Readable);
        _saved = _readable ? readable : compact;

        // A round trip must be byte-for-byte stable, otherwise saving twice would create spurious changes.
        string again = BinkSerializer.Serialize(BinkSerializer.Deserialize(compact));

        _stats = new Stats(
            document.ElementCount,
            document.TotalPointCount,
            System.Text.Encoding.UTF8.GetByteCount(compact),
            System.Text.Encoding.UTF8.GetByteCount(readable),
            System.Text.Encoding.UTF8.GetByteCount(BinkSvgExporter.Export(document)),
            BinkPngExporter.Export(document).Length,
            string.Equals(compact, again, StringComparison.Ordinal));
    }

    private void Load()
    {
        if (_canvas is null || _saved is null) return;
        if (BinkSerializer.TryDeserialize(_saved, out BinkDocument? document, out string? error) && document is not null)
        {
            _error = null;
            _canvas.LoadDocument(document);
            _snapshot = document.Clone();
        }
        else
        {
            // The text stays as it is, so the mistake can be found and fixed.
            _error = "Could not load: " + error;
        }
    }

    private async Task DownloadAsync()
    {
        if (_saved is null) return;
        await Downloads.SaveAsync("drawing.bink.json", System.Text.Encoding.UTF8.GetBytes(_saved), "application/json");
    }

    private async Task OpenAsync(InputFileChangeEventArgs args)
    {
        const long maxBytes = 20 * 1024 * 1024;
        try
        {
            using var reader = new StreamReader(args.File.OpenReadStream(maxBytes));
            _saved = await reader.ReadToEndAsync();
            _error = null;
            Load();
        }
        catch (IOException ex)
        {
            _error = "That file could not be read: " + ex.Message;
        }
    }

    private static string FormatBytes(long bytes)
        => bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024.0:0.#} KB";
}
