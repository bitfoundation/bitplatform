@* Shows what the engine and the device are actually doing. Useful for judging the library, not decoration.
   The first number is the element count, which is what the E2E suite reads back from it. *@
@implements IHandleEvent

@if (Canvas is not null)
{
    <div class="bink-status" aria-live="off">
        <span><strong>@Canvas.CurrentDocument.ElementCount</strong> elements</span>
        <span><strong>@Canvas.CurrentDocument.TotalPointCount</strong> points</span>
        <span><strong>@Canvas.History.UndoCount</strong> undo steps</span>
        <span>Zoom <strong>@((Canvas.CurrentViewport.Zoom * 100).ToString("0"))%</strong></span>
        <span class="@Badge(Canvas.UsesFastRenderPath)">
            @(Canvas.UsesFastRenderPath ? "zero-copy render" : "standard interop")
        </span>
        <span class="@Badge(Canvas.Capabilities.CoalescedEvents)">coalesced input</span>
        <span class="@Badge(Canvas.Capabilities.ObservedPressure)">
            @(Canvas.Capabilities.ObservedPressure ? "pen pressure" : "no pressure hardware")
        </span>
        @if (Canvas.Capabilities.ObservedTilt)
        {
            <span class="@Badge(true)">tilt</span>
        }
        <span>DPR <strong>@Canvas.Capabilities.DevicePixelRatio.ToString("0.##")</strong></span>
        @ChildContent
    </div>
}

@code {
    [Parameter] public BinkCanvas? Canvas { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    // The zoom this line shows, so a change is noticed whichever render showed the last one.
    private float _zoom = 1f;

    protected override void OnParametersSet() => _zoom = Canvas?.CurrentViewport.Zoom ?? 1f;

    /// <summary>
    /// For the canvas's <c>ViewportChanged</c>, so the zoom shown follows the wheel, a pinch and the keyboard, not
    /// only the page's own buttons. It re-renders this line alone, and only when the zoom changed: a pan raises the
    /// same callback every frame and must not re-render anything.
    /// </summary>
    public EventCallback<BinkViewport> ViewportChanged => EventCallback.Factory.Create<BinkViewport>(this, OnViewportChanged);

    private void OnViewportChanged(BinkViewport viewport)
    {
        if (viewport.Zoom == _zoom) return;
        _zoom = viewport.Zoom;
        StateHasChanged();
    }

    // Events render only when OnViewportChanged asks for it, not after every one as ComponentBase would.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) => callback.InvokeAsync(arg);

    /// <summary>A capability the canvas has is a success badge; one it lacks is a neutral one.</summary>
    public static string Badge(bool on) => on ? "bb-badge bb-badge-success" : "bb-badge bink-badge-off";
}
