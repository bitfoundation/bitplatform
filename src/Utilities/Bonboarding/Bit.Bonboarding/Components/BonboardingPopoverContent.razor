@namespace Bit.Bonboarding

@* The default popover chrome. Replaced wholesale by BonboardingRoot.ChildContent, a tour Template
   or a step Template, so nothing here is load-bearing for the engine. *@

<div class="bit-bonboarding-popover-inner">

    @if (Model.Step.Header is not null)
    {
        @Model.Step.Header(Model)
    }
    else if (!string.IsNullOrEmpty(Model.Title) || ShowClose)
    {
        <div class="bit-bonboarding-header">
            @if (!string.IsNullOrEmpty(Model.Title))
            {
                <h2 class="bit-bonboarding-title" id="@TitleId">@Model.Title</h2>
            }

            @if (ShowClose)
            {
                <button type="button"
                        class="bit-bonboarding-close"
                        aria-label="@Model.Labels.Close"
                        data-bonboarding-action="close"
                        @onclick="Model.CloseAsync">
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </button>
            }
        </div>
    }

    @if (Model.Step.Body is not null)
    {
        <div class="bit-bonboarding-body">@Model.Step.Body(Model)</div>
    }
    else if (!string.IsNullOrEmpty(Model.Description))
    {
        <div class="bit-bonboarding-body">
            <p class="bit-bonboarding-description" id="@DescriptionId">@Model.Description</p>
        </div>
    }

    @* An alert, so it is read out the moment the user is told no; it stays until the step changes. *@
    @if (!string.IsNullOrEmpty(Model.ValidationMessage))
    {
        <p class="bit-bonboarding-validation" role="alert">@Model.ValidationMessage</p>
    }

    @if (Model.Step.Footer is not null)
    {
        @Model.Step.Footer(Model)
    }
    else if (HasFooter)
    {
        <div class="bit-bonboarding-footer">
            <BonboardingProgress Model="Model" />

            <div class="bit-bonboarding-footer-actions">
                @if (Options.ShowSkip && !Model.IsLast)
                {
                    <button type="button"
                            class="bit-bonboarding-button bit-bonboarding-button-ghost"
                            data-bonboarding-action="skip"
                            @onclick="Model.SkipAsync">@Model.SkipLabel</button>
                }

                @if (Options.ShowPrevious && !Model.IsFirst)
                {
                    <button type="button"
                            class="bit-bonboarding-button bit-bonboarding-button-secondary"
                            data-bonboarding-action="previous"
                            @onclick="Model.PreviousAsync">@Model.PreviousLabel</button>
                }

                @if (Model.Step.Actions is { Count: > 0 } actions)
                {
                    @foreach (var action in actions)
                    {
                        // aria-disabled rather than disabled while the handler runs: a disabled button drops
                        // the focus of the keyboard user who just pressed it. The click is ignored anyway.
                        var running = Model.IsRunning(action);

                        <button type="button"
                                class="@BonboardingCss.Classes("bit-bonboarding-button", StyleClass(action.Style), action.CssClass)"
                                data-bonboarding-action="@(action.Id ?? action.Label)"
                                data-bonboarding-autofocus="@(action.AutoFocus ? "true" : null)"
                                aria-busy="@(running ? "true" : null)"
                                aria-disabled="@(running ? "true" : null)"
                                disabled="@IsDisabled(action)"
                                @onclick="() => Model.InvokeAsync(action)">@action.Label</button>
                    }
                }

                @if (Options.ShowNext)
                {
                    <button type="button"
                            class="bit-bonboarding-button bit-bonboarding-button-primary"
                            data-bonboarding-action="next"
                            data-bonboarding-autofocus="@(HasCustomAutoFocus ? null : "true")"
                            @onclick="Model.NextAsync">@Model.NextLabel</button>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>The step being rendered, together with the commands that drive the tour.</summary>
    [Parameter, EditorRequired] public required BonboardingStepRenderContext Model { get; set; }

    /// <summary>Id the dialog points at with <c>aria-labelledby</c>.</summary>
    [Parameter] public string? TitleId { get; set; }

    /// <summary>Id the dialog points at with <c>aria-describedby</c>.</summary>
    [Parameter] public string? DescriptionId { get; set; }

    private BonboardingEffectiveStepOptions Options => Model.Options;

    private bool ShowClose => Options.ShowClose;

    private bool HasFooter
        => Options.ShowNext
        || Options.ShowSkip
        || Options.ShowPrevious
        || Options.Progress != BonboardingProgressStyle.None
        || Model.Step.Actions is { Count: > 0 };

    private bool HasCustomAutoFocus => Model.Step.Actions?.Any(action => action.AutoFocus) == true;

    private bool IsDisabled(BonboardingStepAction action)
        => action.IsDisabled is not null
            && action.IsDisabled(new BonboardingStepContext(Model.Session, Model.Step, Model.Index, ServiceProvider));

    [Inject] private IServiceProvider ServiceProvider { get; set; } = default!;

    private BonboardingStepRenderContext? _rendered;

    /// <summary>
    /// The host hands over a new context whenever the step, its options or the session's state change, and keeps the
    /// same one while only the geometry moves, which this markup does not read. An action whose IsDisabled reads the
    /// application's own state is asked again on every render, as it always was.
    /// </summary>
    protected override bool ShouldRender()
        => !ReferenceEquals(_rendered, Model) || Model.Step.Actions?.Any(action => action.IsDisabled is not null) == true;

    protected override void OnAfterRender(bool firstRender) => _rendered = Model;

    private static string StyleClass(BonboardingStepActionStyle style) => style switch
    {
        BonboardingStepActionStyle.Primary => "bit-bonboarding-button-primary",
        BonboardingStepActionStyle.Ghost => "bit-bonboarding-button-ghost",
        BonboardingStepActionStyle.Danger => "bit-bonboarding-button-danger",
        _ => "bit-bonboarding-button-secondary",
    };
}
