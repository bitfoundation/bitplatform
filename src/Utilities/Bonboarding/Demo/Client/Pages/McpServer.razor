@page "/mcp-server"

@* Describes the MCP server this demo's host maps at /mcp. Its route differs from the endpoint's on
   purpose: two literal endpoints on /mcp would make a GET of it ambiguous. *@

<PageTitle>MCP server · Bonboarding</PageTitle>

<div class="bb-intro">
    <h1>MCP server</h1>
    <p class="bb-subtitle">
        This site hosts a Model Context Protocol server at <code>/mcp</code>, so an AI agent building tours with
        Bit.Bonboarding reads the library itself - its compiled API documentation, its guide, its stylesheet and these
        demo pages - instead of guessing at an API it half remembers. Every tool is read-only.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Connect a client</h3>

    <p>
        The endpoint is plain Streamable HTTP, so any MCP client connects with a URL and nothing else.
    </p>

    <pre class="bb-code" tabindex="0">@ClientConfig</pre>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Tools</h3>

    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Tool</th><th>What it answers</th></tr>
            </thead>
            <tbody>
                @foreach (var tool in Tools)
                {
                    <tr>
                        <td class="bb-table-key"><code>@tool.Name</code></td>
                        <td>@((MarkupString)tool.Description)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p>
        The guide, the API, the theme and the sources are also exposed as <code>bonboarding://</code> resources, and
        three prompts - <code>add-bonboarding-to-app</code>, <code>implement-bonboarding-tour</code> and
        <code>debug-bonboarding-tour</code> - walk an agent through the common jobs in the right order.
    </p>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> The same tools over plain HTTP</h3>

    <p>
        Every tool is also a <code>GET</code> under <code>/api/mcp/...</code>: open one in a browser tab to read
        exactly what an agent is handed.
    </p>

    <ul class="bb-detail-list">
        @foreach (var (href, text) in HttpExamples)
        {
            <li><a href="@href" target="_blank" rel="noopener">@text</a></li>
        }
    </ul>
</section>

@code {
    private const string ClientConfig = """
        // .mcp.json (Claude Code, VS Code, and anything else reading this shape)
        {
          "mcpServers": {
            "bonboarding": {
              "type": "http",
              "url": "https://bonboarding.bitplatform.dev/mcp"
            }
          }
        }
        """;

    // The server's tools, in the order an agent usually needs them. The one place to change when a tool is
    // added, renamed or retired; the description is markup.
    private static readonly (string Name, string Description)[] Tools =
    [
        ("SearchBonboarding",
            "Everything at once - the guide, every public member, the theme variables and the demo sources - each hit with the exact follow-up call."),
        ("GetBonboardingSetupGuide",
            "The complete wiring for one render mode: server, wasm, auto or standalone-wasm."),
        ("GetBonboardingGuideSection",
            "One section of the reference guide, or the index of sections."),
        ("GetBonboardingApi",
            "One public type with every parameter, property and method, its real default and its documentation - or the index of types."),
        ("GetBonboardingThemeVariables",
            "Every <code>--bit-bonboarding-*</code> variable with its light and dark value."),
        ("InspectBonboardingPlacement",
            "Where the library's own placement engine puts a popover for a given target, popover and viewport, and why."),
        ("GetBonboardingSourceFile",
            "One demo file verbatim - every page here is a working tour - or the index of files."),
    ];

    private static readonly (string Href, string Text)[] HttpExamples =
    [
        ("/api/mcp/SearchBonboarding?query=advance%20when%20the%20user%20clicks", "/api/mcp/SearchBonboarding?query=advance when the user clicks"),
        ("/api/mcp/GetBonboardingApi?typeName=BonboardingStep", "/api/mcp/GetBonboardingApi?typeName=BonboardingStep"),
        ("/api/mcp/GetBonboardingThemeVariables", "/api/mcp/GetBonboardingThemeVariables"),
        ("/api/mcp/InspectBonboardingPlacement?targetX=1200&targetY=20&targetWidth=60&targetHeight=30&placement=Right",
            "/api/mcp/InspectBonboardingPlacement?targetX=1200&targetY=20&targetWidth=60&targetHeight=30&placement=Right"),
        ("/api/mcp/GetBonboardingSourceFile?path=Demo/Client/Pages/Flows.razor", "/api/mcp/GetBonboardingSourceFile?path=Demo/Client/Pages/Flows.razor"),
    ];
}
