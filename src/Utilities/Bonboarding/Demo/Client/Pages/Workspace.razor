@page "/workspace"
@inject IBonboardingService BonboardingService
@inject NavigationManager Navigation

<PageTitle>Multi-page tour · Bonboarding</PageTitle>

<div class="bb-intro">
    <h1>Multi-page tour</h1>
    <p class="bb-subtitle">
        Steps can declare the route they belong to. The engine navigates there, waits for the page to render, and
        only then shows the step. If you wander off mid-tour it holds its place instead of dragging you back, and
        picks up where it left off when you return.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> A tour across two pages</h3>
    <p>
        The tour starts here, crosses to the settings page for two steps and comes back for the last one - the
        navigation is the engine's, not this page's.
    </p>

    <div class="bb-demo">
        <div class="bb-demo-bar">
            <span class="bb-demo-label">Live</span>
            <button type="button" class="btn btn-primary" @onclick="StartAsync">Run the multi-page tour</button>
            <a class="btn btn-secondary" href="workspace/settings">Go to settings manually</a>
        </div>

        <div class="bb-note">
            While the tour is on a settings step, try navigating back here with the docs navigation. The tour waits,
            and resumes the moment you return.
        </div>

        <AppWindow OnSettingsClick="GoToSettings" />
    </div>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Giving a step a route</h3>
    <p>
        The tour itself is plain data, defined once in C# and started from either page, which keeps its step ids
        stable - what makes resuming across a reload work.
    </p>

    <pre class="bb-code">@Example</pre>
</section>

@code {
    private void GoToSettings() => Navigation.NavigateTo("workspace/settings");

    private Task StartAsync() => BonboardingService.StartAsync(WorkspaceTour.Create());

    private const string Example = """
        new BonboardingStepDefinition
        {
            Id = "api-keys",
            Route = "workspace/settings",        // navigate here first, then show the step
            Target = BonboardingStepTarget.Anchor("api-keys"),
            Title = "Your API keys",
        }

        // A trailing * makes the route a constraint rather than a destination:
        // the step waits until the user is somewhere under /workspace, without navigating.
        new BonboardingStepDefinition { Route = "workspace/*", ... }
        """;
}
