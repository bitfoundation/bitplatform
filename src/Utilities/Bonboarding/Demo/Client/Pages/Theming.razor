@page "/theming"
@inject IBonboardingService BonboardingService

<PageTitle>Theming &amp; RTL · Bonboarding</PageTitle>

<div class="bb-intro">
    <h1>Theming &amp; RTL</h1>
    <p class="bb-subtitle">
        Every value in the default look is a CSS custom property under <code>.bit-bonboarding-root</code> (the tour layer)
        and <code>.bit-bonboarding-themed</code> (the beacons, checklists and tour lists on the page). Restyling the library
        is a matter of overriding variables in your own stylesheet, with no selector fights and no framework to install.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Try it</h3>
    <p>
        Pick a theme, a direction, a progress style, an animation speed and a skin, then run the tour over the product
        below. With the theme left to the site, its last step points at the header's light/dark switch - press it while
        the card is up.
    </p>
    <ul class="bb-detail-list">
        <li><strong>Theme</strong>: <code>Light</code> and <code>Dark</code> force a palette; <code>System</code> follows the operating system, or your stylesheet.</li>
        <li>
            <strong>Direction</strong>: <code>Auto</code> follows the page's <code>dir</code>; <code>RightToLeft</code> mirrors the
            card, its alignment and the arrow keys.
        </li>
        <li>
            <strong>Progress</strong>: <code>Dots</code> (the default), <code>Bar</code> (a <code>progressbar</code> a screen reader
            reads as "2 of 4"), <code>Text</code>, or <code>None</code>.
        </li>
        <li>
            <strong>Animation</strong>: <code>AnimationDuration</code> times the fades and the spotlight's move between steps;
            under reduced motion it is zero whatever you set, unless <code>RespectReducedMotion = false</code>.
        </li>
        <li><strong>Skin</strong>: a <code>PopoverClass</code> that re-points the variables for one tour.</li>
    </ul>

    <div class="bb-demo">
        <div class="bb-demo-bar">
            <span class="bb-demo-label">Live</span>
            <button type="button" class="btn btn-primary" @onclick="StartAsync">Run the tour</button>
        </div>

        <div class="bb-fields">
            <label class="bb-field">
                Theme
                <select @bind="_theme">
                    <option value="">Not set (follows the site)</option>
                    @foreach (var value in Enum.GetValues<BonboardingTheme>())
                    {
                        <option value="@value">@value</option>
                    }
                </select>
            </label>

            <label class="bb-field">
                Direction
                <select @bind="_direction">
                    @foreach (var value in Enum.GetValues<BonboardingDirection>())
                    {
                        <option value="@value">@value</option>
                    }
                </select>
            </label>

            <label class="bb-field">
                Progress
                <select @bind="_progress">
                    @foreach (var value in Enum.GetValues<BonboardingProgressStyle>())
                    {
                        <option value="@value">@value</option>
                    }
                </select>
            </label>

            <label class="bb-field">
                Animation
                <select @bind="_animationMs">
                    <option value="220">Default (220 ms)</option>
                    <option value="600">Slow (600 ms)</option>
                    <option value="0">None (0 ms)</option>
                </select>
            </label>

            <label class="bb-field">
                Skin
                <select @bind="_skin">
                    <option value="">Fluent 2 (this site)</option>
                    <option value="brand-popover">Brand (amber on navy)</option>
                </select>
            </label>
        </div>

        <div class="bb-note">
            Left unset - or set to <code>System</code> - the tour leaves its colours to your stylesheet, and this site's
            stylesheet follows its own light/dark switch. <code>Light</code> and <code>Dark</code> win over the switch.
        </div>

        <AppWindow />
    </div>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Localisation</h3>
    <p>
        Every string the default card renders comes from a <code>BonboardingLabels</code> instance - set globally, per tour
        (replacing the global set wholesale; <code>Clone()</code> one to change a few strings), or per step with
        <code>NextLabel</code>, <code>PreviousLabel</code>, <code>SkipLabel</code> and <code>DoneLabel</code>. Each button
        below runs the tour with a translated label set; the Arabic one is also right-to-left.
    </p>

    <div class="bb-try">
        <button type="button" class="btn btn-secondary" @onclick='() => StartLocalizedAsync("en")'>English</button>
        <button type="button" class="btn btn-secondary" @onclick='() => StartLocalizedAsync("de")'>Deutsch</button>
        <button type="button" class="btn btn-secondary" @onclick='() => StartLocalizedAsync("ar")'>العربية (RTL)</button>
    </div>

    <p>
        Translate the labels a screen reader hears, too: <code>DialogLabel</code>, <code>StepAnnouncementFormat</code>,
        <code>WaitingAnnouncement</code> and <code>ProgressLabel</code> are never shown, and they are all a screen reader user
        gets. For resource files or a translation service, register your own <code>IBonboardingLocalizer</code>: it supplies
        the labels, and its <code>Localize</code> lets step titles and descriptions be resource keys. Progress numbers are
        formatted in the current culture; the CSS the library writes always uses the invariant one.
    </p>

    <pre class="bb-code" tabindex="0">@LabelsExample</pre>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Right-to-left</h3>
    <p>
        <code>Direction = Auto</code> (the default) follows the document: set <code>dir="rtl"</code> on <code>&lt;html&gt;</code>
        as you already would, and tours follow. Set <code>LeftToRight</code> or <code>RightToLeft</code> on a tour for a page
        of one direction with a tour of the other. Direction changes more than text alignment:
    </p>
    <ul class="bb-detail-list">
        <li><code>Start</code> and <code>End</code> alignments mirror: <code>BottomStart</code> aligns to the target's right edge.</li>
        <li>
            <code>InlineStart</code> and <code>InlineEnd</code> are logical sides: <code>InlineEnd</code> is on the right in
            English and on the left in Arabic, so one placement serves both. <code>Left</code> and <code>Right</code> stay physical.
        </li>
        <li>The arrow keys swap: Left advances and Right goes back, in reading order.</li>
        <li>Padding, margins and the footer's button order flip, and the root carries <code>dir</code>, so a template inherits it.</li>
    </ul>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> The variables</h3>
    <p>
        This site does exactly what the snippet below shows: every tour card on it is the library's default markup
        with Fluent 2 values poured into these variables, light and dark, in the demo's <code>wwwroot/demo.css</code>.
        Apart from shielding the card from the site's own global element styles, none of the library's rules is
        overridden.
    </p>

    <div class="bb-scroll" tabindex="0" role="region" aria-label="Theme variables">
        <table class="bb-table">
            <thead>
                <tr><th>Group</th><th>Variables</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td class="bb-table-key">Colour</td>
                    <td>
                        <code>--bit-bonboarding-surface</code>, <code>-surface-subtle</code>, <code>-text</code>, <code>-text-muted</code>,
                        <code>-border</code>, <code>-border-strong</code>, <code>-accent</code> (with <code>-hover</code>, <code>-active</code>,
                        <code>-text</code>, <code>-soft</code>), <code>-danger</code>, <code>-overlay</code> (an <code>R, G, B</code> triple),
                        <code>-spotlight-ring</code>, <code>-spotlight-glow</code>
                    </td>
                </tr>
                <tr>
                    <td class="bb-table-key">Shape and depth</td>
                    <td><code>--bit-bonboarding-radius</code>, <code>-radius-sm</code>, <code>-radius-pill</code>, <code>-shadow</code>, <code>-focus-ring</code></td>
                </tr>
                <tr>
                    <td class="bb-table-key">Typography</td>
                    <td><code>--bit-bonboarding-font</code>, <code>-font-size</code>, <code>-font-size-sm</code>, <code>-title-size</code>, <code>-title-weight</code>, <code>-line-height</code></td>
                </tr>
                <tr>
                    <td class="bb-table-key">Metrics and motion</td>
                    <td><code>--bit-bonboarding-popover-width</code>, <code>-popover-max-height</code>, <code>-space</code>, <code>-ease</code></td>
                </tr>
                <tr>
                    <td class="bb-table-key">Beacons</td>
                    <td><code>--bit-bonboarding-beacon-size</code>, <code>-beacon-dot</code>, <code>-beacon-color</code></td>
                </tr>
                <tr>
                    <td class="bb-table-key">Set by the engine</td>
                    <td>
                        <code>--bit-bonboarding-z</code>, <code>-duration</code>, <code>-overlay-opacity</code> and <code>-arrow</code> are written
                        inline from <code>ZIndex</code>, <code>AnimationDuration</code>, <code>OverlayOpacity</code> and <code>ArrowSize</code>,
                        so a stylesheet cannot override them: change the option instead.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <p>
        Every variable with its light and dark default is one request away:
        <a href="/api/mcp/GetBonboardingThemeVariables" target="_blank" rel="noopener">GetBonboardingThemeVariables</a>.
    </p>

    <pre class="bb-code" tabindex="0">@ThemeExample</pre>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Following your own theme switch</h3>
    <p>
        A tour that leaves its theme unset is drawn with <code>data-bonboarding-theme="system"</code>. Out of the box the
        library's stylesheet gives that the dark palette while the operating system asks for a dark scheme, and the light
        one otherwise, following a change of the system setting at once. An application with a theme switch of its own maps
        <code>system</code> to that switch in CSS, as this site does - or binds the switch to the host, whose
        <code>Theme</code> overrides the tour's and the global one alike.
    </p>
    <p>
        An explicit <code>Light</code> or <code>Dark</code> also sets <code>color-scheme</code> on the card, so native controls
        in a custom step body match it; <code>System</code> inherits the page's.
    </p>

    <pre class="bb-code" tabindex="0">@FollowExample</pre>
</section>

@code {
    private BonboardingTheme? _theme;
    private BonboardingDirection _direction = BonboardingDirection.Auto;
    private BonboardingProgressStyle _progress = BonboardingProgressStyle.Dots;
    private int _animationMs = 220;
    private string _skin = string.Empty;

    private Task StartAsync() => BonboardingService.StartAsync(BuildTour(
        id: "theming",
        labels: null,
        direction: _direction));

    private Task StartLocalizedAsync(string culture)
    {
        var (labels, direction) = culture switch
        {
            "de" => (new BonboardingLabels
            {
                Next = "Weiter",
                Previous = "Zurück",
                Skip = "Überspringen",
                Done = "Fertig",
                Close = "Schließen",
                DialogLabel = "Produktrundgang",
                ProgressFormat = "{0} von {1}",
                StepAnnouncementFormat = "Schritt {0} von {1}. {2}",
                ProgressLabel = "Fortschritt",
                WaitingAnnouncement = "Warten auf den nächsten Teil der Seite.",
            }, BonboardingDirection.LeftToRight),

            "ar" => (new BonboardingLabels
            {
                Next = "التالي",
                Previous = "السابق",
                Skip = "تخطي",
                Done = "إنهاء",
                Close = "إغلاق",
                DialogLabel = "جولة المنتج",
                ProgressFormat = "{0} من {1}",
                StepAnnouncementFormat = "الخطوة {0} من {1}. {2}",
                ProgressLabel = "التقدم",
                WaitingAnnouncement = "في انتظار الجزء التالي من الصفحة.",
            }, BonboardingDirection.RightToLeft),

            _ => (new BonboardingLabels(), BonboardingDirection.LeftToRight),
        };

        return BonboardingService.StartAsync(BuildTour($"theming-{culture}", labels, direction));
    }

    private BonboardingTourDefinition BuildTour(string id, BonboardingLabels? labels, BonboardingDirection direction) => new()
    {
        Id = id,
        Persist = false,
        Theme = _theme,
        Direction = direction,
        Progress = _progress,
        AnimationDuration = TimeSpan.FromMilliseconds(_animationMs),
        Labels = labels,
        PopoverClass = string.IsNullOrEmpty(_skin) ? null : _skin,
        Steps =
        {
            new BonboardingStepDefinition
            {
                Id = "create",
                Target = BonboardingStepTarget.Anchor("new-project"),
                Title = "Create a project",
                Description = "The default look is deliberately quiet, so it sits inside your product rather than on top of it.",
            },
            new BonboardingStepDefinition
            {
                Id = "usage",
                Target = BonboardingStepTarget.Anchor("usage"),
                Title = "Usage",
                Description = "Colours, radii, shadows, spacing and motion are all custom properties.",
                Placement = BonboardingPlacement.Bottom,
            },
            new BonboardingStepDefinition
            {
                Id = "settings",
                Target = BonboardingStepTarget.Anchor("settings"),
                Title = "Settings",
                Description = "Change the skin above to see a completely different visual identity, with no library changes.",
                Placement = BonboardingPlacement.BottomEnd,
            },
            new BonboardingStepDefinition
            {
                Id = "site-theme",
                // The site's own header, found by CSS selector: a target does not have to be marked up
                // for the tour.
                Target = BonboardingStepTarget.Css(".bb-theme-toggle"),
                Title = "Follows the site",
                Description = "This tour leaves its colours to the stylesheet, and this site's follows its own switch. Press it: the card changes theme with the page.",
                Placement = BonboardingPlacement.BottomEnd,
                // The spotlight hole is click-through, so the switch can be used while the card is up.
                Interaction = BonboardingInteractionMode.TargetOnly,
                // Only true of a tour that has not chosen a palette of its own.
                When = _ => ValueTask.FromResult(_theme is null or BonboardingTheme.System),
            },
        },
    };

    private const string ThemeExample = """
        /* Your stylesheet, loaded after the library's. The second selector reaches the beacons,
           checklists and tour lists, which render on the page rather than in the tour layer. */
        .bit-bonboarding-root,
        .bit-bonboarding-themed {
            --bit-bonboarding-accent: #f59e0b;
            --bit-bonboarding-accent-text: #1f1300;
            --bit-bonboarding-surface: #101828;
            --bit-bonboarding-text: #f9fafb;
            --bit-bonboarding-radius: 6px;
            --bit-bonboarding-overlay: 15, 23, 42;   /* dim with a brand colour rather than black */
        }

        /* Scope it to one tour with PopoverClass - it lands on the card. To restyle the overlay and
           the spotlight as well, put the class on the host: <BonboardingRoot Class="checkout-theme" />. */
        .checkout-tour { --bit-bonboarding-accent: #16a34a; }

        /* A wider card for a step with a form: PopoverClass = "wide-step" on that step. */
        .wide-step { --bit-bonboarding-popover-width: 32rem; }

        // Motion, stacking and dimming are options, not variables:
        new BonboardingTourDefinition { AnimationDuration = TimeSpan.FromMilliseconds(160), ZIndex = 9000, OverlayOpacity = 0.4 }
        """;

    private const string LabelsExample = """
        // Globally:
        builder.Services.AddBitBonboardingServices(options =>
        {
            options.Labels.Next = "Weiter";
            options.Labels.Done = "Fertig";
        });

        // Per tour - a whole set; Clone() the default to change a few strings:
        var labels = BonboardingLabels.Default.Clone();
        labels.Next = "Weiter";
        labels.StepAnnouncementFormat = "Schritt {0} von {1}. {2}";   // read by screen readers
        new BonboardingTourDefinition { Id = "welcome", Labels = labels, Direction = BonboardingDirection.Auto };

        // Per step:
        new BonboardingStepDefinition { NextLabel = "Show me", DoneLabel = "Finish setup" };

        // From resource files:
        builder.Services.AddBitBonboardingLocalizer<ResourceOnboardingLocalizer>();
        """;

    private const string FollowExample = """
        /* This site: a tour with no theme of its own goes dark with the page's own switch. */
        :root[bit-theme="dark"] .bit-bonboarding-root[data-bonboarding-theme="system"],
        :root[bit-theme="dark"] .bit-bonboarding-themed[data-bonboarding-theme="system"] {
            --bit-bonboarding-surface: #15191E;
            --bit-bonboarding-text: #E6ECF2;
            --bit-bonboarding-accent: #4FA3F4;
            /* ... */
        }

        @* Or from C#: the host's Theme overrides the tour's and the global one. *@
        <BonboardingRoot Theme="@(_dark ? BonboardingTheme.Dark : BonboardingTheme.Light)" />
        """;
}
