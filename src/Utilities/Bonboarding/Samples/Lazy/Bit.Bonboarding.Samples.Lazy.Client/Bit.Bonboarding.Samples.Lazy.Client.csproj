<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!-- The browser half of the lazy loading sample: it downloads Bit.Bonboarding.wasm only when an admin page, the one
         part of the app with a tour, opens. It does everything the README's "Lazy loading on WebAssembly" section asks
         of such a project, and the end-to-end suite (Tests/Bit.Bonboarding.Tests.E2E, LazyLoadingTests) publishes it and
         checks it in a browser. -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
        <ProjectReference Include="..\..\..\Bit.Bonboarding\Bit.Bonboarding.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Program.cs leaves AddBitBonboardingServices out in every build, an AOT one included, so the switch is on in
             every build: the components create their services themselves, and the pages take the same service from
             GetBonboardingService(). -->
        <RuntimeHostConfigurationOption Include="Bit.Bonboarding.LazyLoad" Value="true" />
    </ItemGroup>

    <!-- AOT builds load Bit.Bonboarding with the rest of the app. -->
    <ItemGroup Condition=" '$(RunAOTCompilation)' != 'true' ">
        <BlazorWebAssemblyLazyLoad Include="Bit.Bonboarding.wasm" />
        <RuntimeHostConfigurationOption Include="Bit.Bonboarding.Samples.Lazy.LazyLoadsBonboarding" Value="true" Trim="true" />
    </ItemGroup>

</Project>
