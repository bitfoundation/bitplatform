@* The router waits for OnNavigateAsync before it renders a page, so Bit.Bonboarding.wasm is there before an admin page
   renders its tour. This file renders before the assembly is downloaded, so it may not use Bonboarding's types itself.
   The server prerenders it too: it registers LazyAssemblyLoader for that (its Program.cs), and does not set the switch,
   as it loads Bonboarding with the rest of the app. *@
@using Microsoft.AspNetCore.Components.WebAssembly.Services
@inject LazyAssemblyLoader LazyAssemblyLoader

<Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Set only where Bit.Bonboarding.wasm is marked (the project file): loading an assembly that is not marked throws.
    private static readonly bool LazyLoadsBonboarding = AppContext.TryGetSwitch("Bit.Bonboarding.Samples.Lazy.LazyLoadsBonboarding", out var on) && on;

    private async Task OnNavigateAsync(NavigationContext context)
    {
        // The pages with tours: fetch Bonboarding before they render. A second call loads nothing again.
        if (LazyLoadsBonboarding && IsAdminPage(context.Path))
            await LazyAssemblyLoader.LoadAssembliesAsync(["Bit.Bonboarding.wasm"]);
    }

    // /admin and the routes beneath it (routes match regardless of case), but not /administrators. The path keeps any
    // query and fragment.
    private static bool IsAdminPage(string path)
    {
        path = path.Split('?', '#')[0];
        return path.Equals("admin", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("admin/", StringComparison.OrdinalIgnoreCase);
    }
}
