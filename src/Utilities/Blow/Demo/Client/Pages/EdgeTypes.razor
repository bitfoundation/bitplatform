@page "/edge-types"

<PageTitle>Edge Types · Blow</PageTitle>

<div class="bb-intro">
    <h1>Edge Types &amp; Markers</h1>
    <p class="bb-subtitle">
        Four of the five built-in edge path algorithms: bezier, straight, step and smoothstep.
        The last two show <strong>arrow markers</strong> - a closed arrowhead and a double-ended edge.
    </p>
</div>

<DemoCode />

<div class="bb-demo blow-demo bb-page-wide">
    <div class="demo-canvas">
        <BlowCanvas Nodes="_nodes" Edges="_edges" FitViewOnInit="true" DefaultEdgeType="BlowEdgeType.SmoothStep">
            <BlowBackground />
            <BlowControls />
            <BlowMiniMap />
        </BlowCanvas>
    </div>
</div>

@code {
    private List<BlowNode> _nodes = new();
    private List<BlowEdge> _edges = new();

    protected override void OnInitialized()
    {
        // Left to right, each target a little lower than its source: between a bottom and a top handle on one level
        // every path type has to double back on itself, and between two handles at the same height they would all
        // be the same straight line.
        _nodes =
        [
            Source("a1", "A", 40),
            Target("a2", "B", 40),
            Source("b1", "C", 170),
            Target("b2", "D", 170),
            Source("c1", "E", 300),
            Target("c2", "F", 300),
            Source("d1", "G", 430),
            Target("d2", "H", 430),
        ];

        _edges =
        [
            new BlowEdge { Id = "e-bezier",     Source = "a1", Target = "a2", Type = BlowEdgeType.Bezier,     Label = "bezier" },
            new BlowEdge { Id = "e-straight",   Source = "b1", Target = "b2", Type = BlowEdgeType.Straight,   Label = "straight" },
            new BlowEdge { Id = "e-step",       Source = "c1", Target = "c2", Type = BlowEdgeType.Step,       Label = "closed marker", MarkerType = BlowMarkerType.ArrowClosed },
            new BlowEdge { Id = "e-smoothstep", Source = "d1", Target = "d2", Type = BlowEdgeType.SmoothStep, Label = "double-ended", Animated = true, MarkerStart = true },
        ];
    }

    private static BlowNode Source(string id, string label, double y) =>
        new() { Id = id, Label = label, Position = new(40, y), SourcePosition = BlowPosition.Right, TargetPosition = BlowPosition.Left };

    private static BlowNode Target(string id, string label, double y) =>
        new() { Id = id, Label = label, Position = new(360, y + 60), SourcePosition = BlowPosition.Right, TargetPosition = BlowPosition.Left };
}
