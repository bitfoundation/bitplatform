];

<span class="k">private</span> List&lt;BlowEdge&gt; _edges =
[
    <span class="k">new</span>() { Id = <span class="s">"e1-2"</span>, Source = <span class="s">"1"</span>, Target = <span class="s">"2"</span>, Animated = <span class="k">true</span> },
    <span class="k">new</span>() { Id = <span class="s">"e2-3"</span>, Source = <span class="s">"2"</span>, Target = <span class="s">"3"</span>, Label = <span class="s">"ok"</span> },
];</pre>
                <div class="home-hero-flow">
                    <BlowCanvas Nodes="_nodes" Edges="_edges" FitViewOnInit="true" AriaLabel="A live approval workflow">
