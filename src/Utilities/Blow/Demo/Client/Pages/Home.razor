@page "/"
@layout MainLayout

<PageTitle>Blow - node-based editors and diagrams for Blazor</PageTitle>

@* The landing page: hero → proof strip → feature grid → code walkthrough → the React Flow mapping →
   persona tiles → FAQ → final call to action. Everything else on the site is a documentation page
   under DocsLayout. The hero's flow is live rather than a picture of one - a node editor is best
   introduced by dragging a node. *@

<div class="bb-landing">

    @* ============================== Hero ============================== *@

    <section class="bb-hero">
        <div class="bb-hero-copy">
            <span class="bb-hero-eyebrow">
                <span class="bb-dot bb-dot-success"></span>
                Open source · MIT · net8.0 / net9.0 / net10.0
            </span>
            <h1>Node-based editors for Blazor,<br /><span class="bb-hero-accent">the React Flow way.</span></h1>
            <p class="bb-hero-sub">
                Workflow editors, pipelines, state machines and diagrams: a pannable, zoomable <code>BlowCanvas</code>
                over your own <code>List&lt;BlowNode&gt;</code> and <code>List&lt;BlowEdge&gt;</code>, with custom
                nodes, handles and typed ports, six edge paths, sub-flows, a minimap, auto-layout and undo. Dragging,
                connecting, keyboard handling, layout and edge geometry are written in C# - there is no JavaScript
                diagram library underneath.
            </p>
            <pre class="bb-code bb-hero-install">dotnet add package Bit.Blow</pre>
            <div class="bb-hero-actions">
                <a href="getting-started" class="btn btn-primary bb-btn-lg">Get started →</a>
                <a href="examples" class="btn btn-secondary bb-btn-lg">Browse the examples</a>
                <a class="btn btn-secondary bb-btn-lg" href="@SiteInfo.ProjectUrl" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            </div>
        </div>

        @* The sample, framed as a window: the markup on top, and what it renders underneath - live, so
           the first thing a visitor can do here is drag a node or draw an edge. *@
        <div class="bb-hero-code">
            <div class="bb-browser">
                <div class="bb-browser-bar">
                    <span class="bb-browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="bb-browser-url">Workflow.razor</span>
                </div>
                <pre class="bb-code">&lt;<span class="k">BlowCanvas</span> Nodes=<span class="s">"_nodes"</span> Edges=<span class="s">"_edges"</span> FitViewOnInit=<span class="s">"true"</span>&gt;
    &lt;<span class="k">BlowBackground</span> /&gt;
    &lt;<span class="k">BlowControls</span> /&gt;
&lt;/<span class="k">BlowCanvas</span>&gt;

<span class="k">private</span> List&lt;BlowNode&gt; _nodes =
[
    <span class="k">new</span>() { Id = <span class="s">"1"</span>, Type = <span class="s">"input"</span>, Label = <span class="s">"Request"</span>, Position = <span class="k">new</span>(0, 0) },
    <span class="k">new</span>() { Id = <span class="s">"2"</span>, Label = <span class="s">"Review"</span>, Position = <span class="k">new</span>(-90, 110) },
