@page "/labels-handles"

<PageTitle>Labels &amp; Drag Handles · Blow</PageTitle>

<div class="bb-intro">
    <h1>HTML Edge Labels &amp; Drag Handles</h1>
    <p class="bb-subtitle">
        An <code>EdgeLabelTemplate</code> turns every edge label into HTML - here with a delete button in it - drawn
        in an overlay that keeps a constant size at any zoom. The purple nodes set <code>UseCustomDragHandle</code>,
        so only the <code>BlowDragHandle</code> grip in their template moves them.
    </p>
</div>

<div class="bb-demo blow-demo bb-page-wide">
    <div class="demo-canvas">
        <BlowCanvas Nodes="_nodes" Edges="_edges" FitViewOnInit="true">
            <NodeTemplate Context="node">
                @if (node.Type == "panel")
                {
                    <BlowHandle Type="BlowHandleType.Target" Position="BlowPosition.Top" />
                    <div class="panel-node">
                        <BlowDragHandle Class="panel-node__grip">⠿</BlowDragHandle>
                        <div class="panel-node__title">@node.Label</div>
                    </div>
                    <BlowHandle Type="BlowHandleType.Source" Position="BlowPosition.Bottom" />
                }
                else
                {
                    <BlowDefaultNode Node="node" />
                }
            </NodeTemplate>

            <EdgeLabelTemplate Context="ctx">
                <div class="edge-label">
                    <span>@(ctx.Edge.Label ?? ctx.Edge.Id)</span>
                    @* nodrag nopan: a press on the label would otherwise start a pan, and the pan's pointer capture
                       would take the click away from the button. *@
                    <button class="edge-label__btn nodrag nopan" title="Delete edge" @onclick="() => RemoveEdge(ctx.Edge)">×</button>
                </div>
            </EdgeLabelTemplate>

            <ChildContent>
                <BlowBackground Variant="BlowBackgroundVariant.Dots" Gap="20" />
                <BlowControls />
                <BlowMiniMap />
            </ChildContent>
        </BlowCanvas>
    </div>
</div>

<DemoCode />

<DemoNotes>
    <TryIt>
        <li><strong>Drag a purple node by its ⠿ grip</strong> to move it. Dragging its body does not move it - a press there only selects it.</li>
        <li><strong>Drag the plain node</strong> from anywhere on it, as any node without a custom drag handle.</li>
        <li><strong>Click ×</strong> on an edge's label to delete that edge.</li>
        <li><strong>Scroll to zoom</strong> in and out: the nodes grow and shrink, while the labels and their buttons keep the same size on screen.</li>
        <li><strong>Connect two nodes</strong>: the new edge has no <code>Label</code>, so its HTML label shows the edge's id instead.</li>
    </TryIt>
    <HowItWorks>
        <li><code>EdgeLabelTemplate</code> is a <code>RenderFragment&lt;BlowEdgeContext&gt;</code> rendered as HTML at each edge's label point, in a layer above the graph that is not zoomed. Once it is set it replaces the built-in SVG labels.</li>
        <li>The delete button carries <code>nodrag nopan</code>: without them a press on it would start a pan, the pane would capture the pointer, and the click would never reach the button. It removes the edge from <code>_edges</code>, and the canvas drops it on the next render.</li>
        <li><code>UseCustomDragHandle = true</code> on a node stops its body from starting drags; only a <code>BlowDragHandle</code> inside its template does, and its <code>Class</code> styles the grip.</li>
        <li>The plain node is handed back to <code>BlowDefaultNode</code>, the built-in look, from the same <code>NodeTemplate</code>.</li>
        <li>Every node element carries <code>bit-blow-node-{Type}</code>, so the page tints the <code>panel</code> nodes with a <code>.bit-blow-node-panel</code> rule alone, mixed into <code>--bit-blow-node-bg</code> so it suits both colour modes.</li>
        <li>The edges are a <code>SmoothStep</code> path and a bezier with a closed arrowhead (<code>MarkerType = ArrowClosed</code>).</li>
    </HowItWorks>
</DemoNotes>

<style>
    .panel-node { display:flex; align-items:center; gap:8px; padding:2px 4px; }
    .panel-node__grip { font-size:16px; color:#8b5cf6; user-select:none; }
    .panel-node__title { font-weight:600; }
    /* A violet tint mixed into the node's own fill, so it reads in the light and the dark mode alike. */
    .bit-blow-node-panel { background:color-mix(in srgb, #8b5cf6 14%, var(--bit-blow-node-bg)); border-color:#8b5cf6; }

    .edge-label {
        display:flex; align-items:center; gap:6px;
        background:var(--bit-blow-surface); color:var(--bit-blow-text); border:1px solid var(--bit-blow-border); border-radius:6px;
        padding:2px 6px; font-size:12px; box-shadow:0 1px 3px var(--bit-blow-shadow);
    }
    .edge-label__btn {
        border:none; background:color-mix(in srgb, #ef4444 16%, var(--bit-blow-surface)); color:#ef4444; border-radius:4px;
        width:18px; height:18px; line-height:1; cursor:pointer; padding:0;
    }
    .edge-label__btn:hover { background:color-mix(in srgb, #ef4444 28%, var(--bit-blow-surface)); }
</style>

@code {
    private List<BlowNode> _nodes = new();
    private List<BlowEdge> _edges = new();

    protected override void OnInitialized()
    {
        _nodes =
        [
            new BlowNode { Id = "1", Type = "panel", Label = "Source",  Position = new(120, 40),  UseCustomDragHandle = true, Width = 160 },
            new BlowNode { Id = "2", Type = "panel", Label = "Process", Position = new(120, 200), UseCustomDragHandle = true, Width = 160 },
            new BlowNode { Id = "3",                 Label = "Plain (drag anywhere)", Position = new(380, 120), Width = 180 },
        ];

        _edges =
        [
            new BlowEdge { Id = "e1-2", Source = "1", Target = "2", Label = "validate", Type = BlowEdgeType.SmoothStep },
            new BlowEdge { Id = "e2-3", Source = "2", Target = "3", Label = "emit",     MarkerType = BlowMarkerType.ArrowClosed },
        ];
    }

    private void RemoveEdge(BlowEdge edge) => _edges.RemoveAll(e => e.Id == edge.Id);
}
