@page "/examples/easy-connect"

<PageTitle>Easy Connect · Blow</PageTitle>

<ExampleScaffold Title="Easy Connect"
                 Summary="Each node is almost entirely covered by one connectable handle, so a connection starts and ends anywhere inside a node instead of on an 8px dot. Loose connection mode lets that single handle take both ends of an edge, and floating edges attach to whichever side faces the other node.">
    <ChildContent>
        <BlowCanvas Nodes="_nodes" Edges="_edges" FitViewOnInit="true"
                    ConnectionMode="BlowConnectionMode.Loose" ConnectionLineType="BlowEdgeType.Straight">
            <NodeTemplate Context="node">
                <div class="easy-node">@node.Label</div>
                @* Inset, not edge to edge: a handle covering the whole node would leave nothing to
                   press that drags the node instead of starting a connection. *@
                <BlowHandle Type="BlowHandleType.Source" Position="BlowPosition.Top"
                            Style="position:absolute;inset:8px;width:auto;height:auto;border-radius:6px;background:transparent;border:1px dashed #a5b4fc;transform:none;" />
            </NodeTemplate>
            <EdgeTemplate Context="ctx">
                <BlowBaseEdge Path="@FloatingPath(ctx.Edge)" StrokeWidth="2" />
            </EdgeTemplate>
            <ChildContent>
                <BlowBackground Variant="BlowBackgroundVariant.Dots" Gap="16" />
                <BlowControls />
            </ChildContent>
        </BlowCanvas>
    </ChildContent>
    <TryIt>
        <li><strong>Press anywhere inside the dashed outline</strong> of a node and drag: a connection starts. <strong>Release anywhere over another node</strong> to connect the two.</li>
        <li><strong>Drag a node by its rim</strong> - the thin strip outside the dashed outline - to move it; its edges slide round to the side that faces the other node.</li>
        <li>Release over the node you started from: nothing is connected. The canvas refuses self-connections by default, and even <code>AllowSelfConnections</code> needs two different handles - each node here has one.</li>
        <li><strong>Click</strong> an edge to select it and press <strong>Delete</strong> or <strong>Backspace</strong> to remove it.</li>
    </TryIt>
    <HowItWorks>
        <li>Each node draws a single <code>BlowHandle</code>, stretched by its <code>Style</code> to 8px inside the node (<code>position:absolute; inset:8px; width:auto; height:auto; transform:none</code>). The rim outside it is still the node, so pressing there drags.</li>
        <li><code>ConnectionMode="BlowConnectionMode.Loose"</code> lets any handle connect to any other. The only handle here is a source, and in the default <code>Strict</code> mode a source can never be dropped on another source.</li>
        <li>A drop counts anywhere over the target handle, because the canvas looks for the handle under the pointer; within <code>ConnectionRadius</code> (20px) of a handle's centre it also snaps to it.</li>
        <li>A handle's anchor is its centre, so here the line drawn while connecting starts in the middle of the node; <code>ConnectionLineType="BlowEdgeType.Straight"</code> draws it straight, like the edges.</li>
        <li>The <code>EdgeTemplate</code> ignores the handles: <code>BlowGraphUtils.GetFloatingEdgeParams(source, target)</code> finds the point and side on each node's border facing the other, <code>BlowEdgePath.Compute</code> turns them into a straight path, and <code>BlowBaseEdge</code> draws it, together with the wide invisible path that makes a thin edge easy to click.</li>
        <li>The node's <code>Class</code>, <code>easy-shell</code>, strips the default node chrome (padding, border, minimum width) so the node draws its own box, edge to edge.</li>
    </HowItWorks>
</ExampleScaffold>

<style>
    /* The node element keeps the library's default chrome - padding, border, white background,
       an 80px minimum width - unless told otherwise; this node draws its own, edge to edge. */
    .bit-blow-node.easy-shell { padding:0; border:0; background:none; min-width:0; box-shadow:none; border-radius:10px; }
    .bit-blow-node.easy-shell.selected { box-shadow:0 0 0 2px var(--bit-blow-node-selected); }

    .easy-node {
        display:flex; align-items:center; justify-content:center;
        width:100%; height:100%; box-sizing:border-box; border-radius:10px;
        background:color-mix(in srgb, #6366f1 14%, var(--bit-blow-node-bg)); color:var(--bit-blow-node-color); border:2px solid #6366f1; font-weight:600;
    }
</style>

@code {
    private List<BlowNode> _nodes = [];
    private List<BlowEdge> _edges = [];

    protected override void OnInitialized()
    {
        _nodes =
        [
            new BlowNode { Id = "1", Label = "Drag me", Position = new(40, 40), Width = 80, Height = 50, Class = "easy-shell" },
            new BlowNode { Id = "2", Label = "to me", Position = new(300, 60), Width = 80, Height = 50, Class = "easy-shell" },
            new BlowNode { Id = "3", Label = "or me", Position = new(180, 220), Width = 80, Height = 50, Class = "easy-shell" },
        ];
        _edges = [ new BlowEdge { Id = "e1-2", Source = "1", Target = "2" } ];
    }

    private string FloatingPath(BlowEdge edge)
    {
        var s = _nodes.FirstOrDefault(n => n.Id == edge.Source);
        var t = _nodes.FirstOrDefault(n => n.Id == edge.Target);
        if (s is null || t is null) return string.Empty;
        var (src, srcPos, tgt, tgtPos) = BlowGraphUtils.GetFloatingEdgeParams(s, t);
        return BlowEdgePath.Compute(BlowEdgeType.Straight, src.X, src.Y, srcPos, tgt.X, tgt.Y, tgtPos).Path;
    }
}
