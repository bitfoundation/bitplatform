@page "/examples"
@using Bit.Blow.Demo.Client.Examples

<PageTitle>React Flow Examples · Blow</PageTitle>

<div class="bb-intro">
    <h1>React Flow Examples</h1>
    <p class="bb-subtitle">
        Blow ports of the official <a href="https://github.com/xyflow/xyflow/tree/main/examples/react" target="_blank" rel="noopener">React Flow examples</a>.
        Each card links to a self-contained page demonstrating one feature, with its source a click away.
        @ExampleCatalog.All.Count examples in total.
    </p>
</div>

@foreach (var group in ExampleCatalog.Grouped())
{
    <h2 @key="group.Key">@group.Key</h2>
    <div class="bb-grid">
        @foreach (var ex in group)
        {
            <a class="bb-card example-card" href="examples/@ex.Route" @key="ex.Route">
                <span class="example-card__title">@ex.Title</span>
                <span class="example-card__summary">@ex.Summary</span>
            </a>
        }
    </div>
}
