@page "/examples/workflow-runner"
<PageTitle>Workflow Runner · Blow</PageTitle>

<ExampleScaffold Title="Workflow Runner"
                 Summary="A pipeline executed by BlowRunner, Blow's headless workflow engine: steps run in dependency order and in parallel, a branch picks one path, a join waits for both inputs, a flaky step is retried with backoff, an approval step waits for you, and the run can be paused, stopped, re-run from a step and played back. The canvas only shows the run, through RunStates fed by BlowRunStates.">
    <Toolbar>
        <button class="btn btn-primary" disabled="@_running" @onclick="() => Run()">▶ Run</button>
        <button class="btn btn-secondary" disabled="@(!_running)" @onclick="TogglePause">@(_control.IsPaused ? "⏵ Resume" : "⏸ Pause")</button>
        <button class="btn btn-secondary" disabled="@(!_running)" @onclick="Stop">■ Stop</button>
        <button class="btn btn-secondary" disabled="@(_running || _last is null || !_nodes.Any(n => n.Selected))" @onclick="RunFromSelection">Run from selected</button>
        @if (_waiting)
        {
            <button class="btn btn-primary" @onclick="() => Approve(true)">✓ Approve</button>
            <button class="btn btn-secondary" @onclick="() => Approve(false)">✕ Reject</button>
        }
        <label>Rows <input type="number" min="0" max="1000" step="50" @bind="_rows" disabled="@_running" style="width:5em" aria-label="Rows fetched" /></label>
        <label><input type="checkbox" @bind="_flaky" disabled="@_running" /> Enrich is flaky</label>
        <label><input type="checkbox" @bind="_broken" disabled="@_running" /> Enrich is down</label>
        <span class="wf-status" role="status">@_status</span>
    </Toolbar>
    <ChildContent>
        <BlowCanvas @ref="_flow" Nodes="_nodes" Edges="_edges" FitViewOnInit="true"
                    AriaLabel="Data pipeline"
                    RunStates="_shown" Validation="_validation"
                    DefaultEdgeType="BlowEdgeType.SmoothStep"
                    EdgesChanged="_ => Validate()" NodesChanged="_ => Validate()"
                    OnSelectionChange="_ => StateHasChanged()">
            <BlowBackground Variant="BlowBackgroundVariant.Dots" Gap="16" />
            <BlowControls />
        </BlowCanvas>
    </ChildContent>
    <Footer>
        @if (_last is { } last && !_running)
        {
            <label class="wf-replay">
                Replay
                <input type="range" min="0" max="@last.Events.Count" value="@_replayAt" @oninput="Replay" aria-label="Replay the last run" />
                <span>event @_replayAt of @last.Events.Count</span>
            </label>
            <ul class="wf-log">
                @foreach (var record in last.Nodes.Values.Where(r => r.Attempts > 0 || r.Restored))
                {
                    <li>
                        <strong>@Name(record.NodeId)</strong>: @record.Status
                        @(record.Restored ? " (from the last run)" : $" after {record.Attempts} attempt{(record.Attempts == 1 ? "" : "s")}, {record.Duration?.TotalMilliseconds:0} ms")
                        @if (record.Message is { } message) { <span> - @message</span> }
                    </li>
                }
            </ul>
        }
    </Footer>
    <TryIt>
        <li>Press <strong>▶ Run</strong>. Validate and Enrich run at once after Parse; Merge waits for both; <em>Big batch?</em> sends the rows down one branch only, and the step on the other branch is skipped. Edges that carried a value are animated.</li>
        <li>Set <strong>Rows</strong> over 100 and run: the big-batch branch stops at <strong>Approve</strong>, shown as waiting with a pause bar. Press <strong>✓ Approve</strong> or <strong>✕ Reject</strong> in the toolbar.</li>
        <li>Tick <strong>Enrich is flaky</strong>: it fails twice and succeeds on its third attempt - the status line says each retry. Tick <strong>Enrich is down</strong> instead: it fails after three attempts, and Merge and everything after it are skipped.</li>
        <li>Press <strong>⏸ Pause</strong> during a run: the steps working finish, nothing new starts until <strong>⏵ Resume</strong>. <strong>■ Stop</strong> cancels the working step (a square badge) and skips the rest.</li>
        <li>After a run, <strong>select</strong> a node and press <strong>Run from selected</strong>: only it and what follows run again; the steps before it keep their results. Drag the <strong>Replay</strong> slider to play the last run back event by event.</li>
        <li>Break the graph - drag from Notify's handle back to Fetch - and Run refuses with the reason, marked on the node.</li>
    </TryIt>
    <HowItWorks>
        <li><code>new BlowRunner(options).Handle("step", handler, new BlowNodeRunOptions { Retry = ..., Join = BlowJoinMode.All })</code> registers what runs each node type. <code>RunAsync(nodes, edges, request, token)</code> runs the graph with no UI and returns a <code>BlowRunResult</code>: an outcome, a record per node (status, attempts, duration, error) and every event.</li>
        <li>A handler reads its inputs from the <code>BlowNodeRunContext</code> (<code>GetInput&lt;T&gt;</code>, <code>RunInput</code>) and returns a <code>BlowNodeResult</code>: <code>Done(value)</code> sends the value along every edge, <code>Branch("big", value)</code> only along the edges from that handle, so the other path is skipped.</li>
        <li><code>ctx.WaitAsync(task, "Waiting for approval")</code> shows the node as <code>BlowRunStatus.Waiting</code> until the task completes. <code>BlowRetryPolicy</code> tries again with exponential backoff; a <code>BlowNodeException</code>'s message is shown, any other exception's is not.</li>
        <li><code>BlowRunRequest.OnEvent = _states.Apply</code> keeps a <code>BlowRunStates</code> up to date, handed straight to <code>RunStates</code>; its <code>ActiveEdges</code> animate the edges. <code>Control = new BlowRunControl()</code> pauses and resumes, the token stops.</li>
        <li><code>StartAt = selected ids, Resume = last.ToCheckpoint()</code> re-runs part of the graph. <code>last.StatesAt(n)</code> gives the states after the first <em>n</em> events, for the replay slider.</li>
    </HowItWorks>
</ExampleScaffold>

<style>
    .wf-status { margin-left: auto; font-size: 12px; color: var(--bb-text-soft); }
    .wf-replay { display: flex; gap: 8px; align-items: center; font-size: 13px; }
    .wf-replay input { flex: 1; }
    .wf-log { margin: 6px 0 0; padding-left: 18px; font-size: 12px; columns: 2 240px; }
</style>

@code {
    private BlowCanvas? _flow;
    private List<BlowNode> _nodes = [];
    private List<BlowEdge> _edges = [];
    private BlowRunStates _states = new();
    private IReadOnlyDictionary<string, BlowRunState> _shown = new Dictionary<string, BlowRunState>();
    private BlowValidationResult _validation = BlowValidationResult.Empty;
    private readonly BlowRunControl _control = new();
    private BlowRunner _runner = default!;
    private BlowRunResult? _last;
    private CancellationTokenSource? _cts;
    private TaskCompletionSource<bool>? _approval;
    private bool _running, _waiting, _flaky, _broken;
    private int _rows = 60, _enrichCalls, _replayAt;
    private string _status = "Ready to run.";

    private static readonly BlowGraphValidator Validator = BlowGraphValidator.CreateDefault()
        .Add(BlowValidationRules.NoCycles())
        .Add(BlowValidationRules.AllReachableFrom(n => n.Id == "fetch", BlowValidationSeverity.Error));

    protected override void OnInitialized()
    {
        BlowNode Step(string id, string label, double x, double y, string type = "step") => new()
        {
            Id = id, Type = type, Label = label, Position = new(x, y), Width = 130, Height = 40,
            SourcePosition = BlowPosition.Right, TargetPosition = BlowPosition.Left,
        };

        var size = Step("size", "Big batch?", 800, 100, "branch");
        size.Ports =
        [
            new BlowPort { Type = BlowHandleType.Target },
            new BlowPort { Type = BlowHandleType.Source, Id = "big", Label = "Big" },
            new BlowPort { Type = BlowHandleType.Source, Id = "small", Label = "Small" },
        ];
        _nodes =
        [
            Step("fetch", "Fetch", 0, 100),
            Step("parse", "Parse", 200, 100),
            Step("validate", "Validate", 400, 30),
            Step("enrich", "Enrich", 400, 170, "enrich"),
            Step("merge", "Merge", 600, 100, "merge"),
            size,
            Step("approve", "Approve", 1000, 20, "approve"),
            Step("archive", "Archive", 1200, 20),
            Step("store", "Store", 1100, 180),
            Step("notify", "Notify", 1400, 100),
        ];
        BlowEdge Link(string source, string target, string? handle = null) => new()
        {
            Id = $"{source}-{target}", Source = source, SourceHandle = handle, Target = target, Label = handle,
            Type = BlowEdgeType.SmoothStep, MarkerEnd = true,
        };
        _edges =
        [
            Link("fetch", "parse"), Link("parse", "validate"), Link("parse", "enrich"),
            Link("validate", "merge"), Link("enrich", "merge"), Link("merge", "size"),
            Link("size", "approve", "big"), Link("approve", "archive"), Link("size", "store", "small"),
            Link("archive", "notify"), Link("store", "notify"),
        ];

        _runner = new BlowRunner(new BlowRunnerOptions { MaxConcurrency = 4 })
            .Handle("step", async ctx =>
            {
                await Task.Delay(500, ctx.CancellationToken);
                return BlowNodeResult.Done(ctx.Node.Id == "fetch" ? ctx.RunInput : ctx.Input);
            })
            .Handle("enrich", async ctx =>
            {
                await Task.Delay(400, ctx.CancellationToken);
                _enrichCalls++;
                if (_broken || (_flaky && _enrichCalls < 3)) throw new BlowNodeException("The enrichment service timed out.");
                return BlowNodeResult.Done(ctx.Input);
            }, new BlowNodeRunOptions { Retry = new BlowRetryPolicy { MaxAttempts = 3, Delay = TimeSpan.FromMilliseconds(300) } })
            // Waits for both of its inputs: a branch that carried nothing would skip it, rather than run it half-fed.
            .Handle("merge", async ctx =>
            {
                await Task.Delay(300, ctx.CancellationToken);
                return BlowNodeResult.Done(ctx.Input);
            }, new BlowNodeRunOptions { Join = BlowJoinMode.All })
            .Handle("branch", ctx =>
            {
                var rows = ctx.Input as int? ?? 0;
                ctx.Report($"{rows} rows");
                return BlowNodeResult.Branch(rows > 100 ? "big" : "small", rows);
            })
            .Handle("approve", async ctx =>
            {
                _approval = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
                _waiting = true;
                StateHasChanged();
                try
                {
                    var approved = await ctx.WaitAsync(_approval.Task, "Waiting for your approval.");
                    if (!approved) throw new BlowNodeException("Rejected.") { IsTransient = false };
                    return BlowNodeResult.Done(ctx.Input);
                }
                finally
                {
                    _waiting = false;
                }
            });
        Validate();
    }

    private void Validate() => _validation = Validator.Validate(_nodes, _edges);

    private async Task Run(BlowRunRequest? from = null)
    {
        Validate();
        _enrichCalls = 0;
        _cts = new CancellationTokenSource();
        _running = true;
        _states = new BlowRunStates();
        _shown = _states;
        foreach (var edge in _edges) edge.Animated = false;

        var request = new BlowRunRequest
        {
            Input = _rows,
            Control = _control,
            StartAt = from?.StartAt,
            Resume = from?.Resume,
            Validator = Validator,
            OnEvent = OnEvent,
        };
        try
        {
            _last = await _runner.RunAsync(_nodes, _edges, request, _cts.Token);
            _replayAt = _last.Events.Count;
            Report(_last.Outcome switch
            {
                BlowRunOutcome.Succeeded => $"Run finished in {_last.Duration.TotalSeconds:0.0} s: every step that ran succeeded.",
                BlowRunOutcome.Failed => $"Run finished: {_last.Nodes.Values.Count(r => r.Status == BlowRunStatus.Failed)} step failed, what depends on it was skipped.",
                BlowRunOutcome.Cancelled => "Run stopped.",
                BlowRunOutcome.Refused => $"Not run: {_last.Problems[0].Message}",
                _ => _last.Outcome.ToString(),
            });
        }
        finally
        {
            _running = false;
            _control.Resume();
            _cts.Dispose();
            _cts = null;
        }
    }

    private void OnEvent(BlowRunEvent e)
    {
        _states.Apply(e);
        if (e.Kind == BlowRunEventKind.EdgeActivated && _edges.FirstOrDefault(x => x.Id == e.EdgeId) is { } edge) edge.Animated = true;
        var message = e.Kind switch
        {
            BlowRunEventKind.RunStarted => "Run started.",
            BlowRunEventKind.NodeStarted when e.Attempt > 1 => $"{Name(e.NodeId)}: attempt {e.Attempt}.",
            BlowRunEventKind.NodeStarted => $"{Name(e.NodeId)} running.",
            BlowRunEventKind.NodeRetrying => $"{Name(e.NodeId)}: {e.Message}",
            BlowRunEventKind.NodeWaiting => $"{Name(e.NodeId)} is waiting for your approval.",
            BlowRunEventKind.NodeFailed => $"{Name(e.NodeId)} failed: {e.Message}",
            _ => null,
        };
        if (message is not null) Report(message);
        else StateHasChanged();
    }

    private Task RunFromSelection()
        => Run(new BlowRunRequest { StartAt = [.. _nodes.Where(n => n.Selected).Select(n => n.Id)], Resume = _last?.ToCheckpoint() });

    private void TogglePause()
    {
        if (_control.IsPaused) _control.Resume();
        else _control.Pause();
        Report(_control.IsPaused ? "Paused: the working steps finish, nothing new starts." : "Resumed.");
    }

    private void Stop()
    {
        _control.Resume();
        _cts?.Cancel();
    }

    private void Approve(bool approved) => _approval?.TrySetResult(approved);

    private void Replay(ChangeEventArgs e)
    {
        if (_last is null || !int.TryParse(e.Value?.ToString(), out var at)) return;
        _replayAt = at;
        var states = _last.StatesAt(at);
        _shown = states;
        foreach (var edge in _edges) edge.Animated = states.ActiveEdges.Contains(edge.Id);
    }

    private string Name(string? id) => _nodes.FirstOrDefault(n => n.Id == id)?.Label ?? id ?? "";

    /// <summary>Shows the status, tells a screen reader through the canvas's live region, and redraws.</summary>
    private void Report(string message)
    {
        _status = message;
        _flow?.Announce(message);
        StateHasChanged();
    }
}
