@page "/examples/connection-rules"

<PageTitle>Connection Rules · Blow</PageTitle>

<ExampleScaffold Title="Connection Rules"
                 Summary="The canvas rejects connections that would duplicate an existing edge, touch a node that opted out of connecting, or loop a node back to itself - unless you allow it. Toggle the rules and watch which handles light up green while you drag.">
    <Toolbar>
        <label><input type="checkbox" checked="@_preventDuplicates" @onchange="@(e => _preventDuplicates = (bool)e.Value!)" /> Prevent duplicate edges</label>
        <label><input type="checkbox" checked="@_allowSelf" @onchange="@(e => _allowSelf = (bool)e.Value!)" /> Allow self-connections</label>
        <button class="btn btn-primary" @onclick="Reset">Reset edges</button>
    </Toolbar>
    <ChildContent>
        <BlowCanvas @ref="_flow"
                    Nodes="_nodes"
                    Edges="_edges"
                    FitViewOnInit="true"
                    PreventDuplicateEdges="_preventDuplicates"
                    AllowSelfConnections="_allowSelf"
                    ConnectionRadius="30"
                    OnConnect="OnConnect">
            <NodeTemplate Context="node">
                <BlowHandle Type="BlowHandleType.Target" Id="in" Position="BlowPosition.Left" />
                <div class="rule-node">
                    <strong>@node.Label</strong>
                    @if (!node.Connectable)
                    {
                        <div class="rule-flag">not connectable</div>
                    }
                </div>
                <BlowHandle Type="BlowHandleType.Source" Id="out" Position="BlowPosition.Right" />
            </NodeTemplate>
            <ChildContent>
                <BlowBackground Variant="BlowBackgroundVariant.Dots" Gap="16" />
                <BlowControls />
            </ChildContent>
        </BlowCanvas>
    </ChildContent>
    <Footer>
        @* Under the canvas: as a panel in its corner the list grew over node B and its output handle. *@
        <strong>Edges (@_edges.Count)</strong>
        @foreach (var edge in _edges)
        {
            <div>@edge.Source → @edge.Target</div>
        }
    </Footer>
</ExampleScaffold>

<style>
    .rule-node { padding: 4px 2px; }
    .rule-flag { margin-top: 4px; font-size: 10px; color: #ef4444; }
</style>

@code {
    private BlowCanvas? _flow;
    private bool _preventDuplicates = true;
    private bool _allowSelf;

    private List<BlowNode> _nodes = [];
    private List<BlowEdge> _edges = [];

    protected override void OnInitialized()
    {
        _nodes =
        [
            new BlowNode { Id = "a", Label = "A", Position = new(0, 40) },
            new BlowNode { Id = "b", Label = "B", Position = new(240, 40) },
            new BlowNode { Id = "locked", Label = "Locked", Position = new(120, 190), Connectable = false },
        ];

        Reset();
    }

    private void Reset()
    {
        _edges.Clear();
        _edges.Add(new BlowEdge { Id = "a-b", Source = "a", Target = "b", SourceHandle = "out", TargetHandle = "in" });
        _flow?.Refresh(remeasure: false);
    }

    private void OnConnect(BlowConnection connection) => StateHasChanged();
}
