@page "/examples/grouping"
<PageTitle>Grouping &amp; Transactions · Blow</PageTitle>

<ExampleScaffold Title="Grouping &amp; Transactions"
                 Summary="Group the selected nodes into a container and dissolve it again without anything moving on screen, change the stacking order, and make several changes as one edit with EditAsync. Every edit is one labelled undo step and one OnGraphChanged event, logged under the canvas with its kind, origin and label.">
    <Toolbar>
        <button class="btn btn-secondary" disabled="@(!_state.CanUndo)" @onclick="Undo">↶ Undo @_state.UndoLabel</button>
        <button class="btn btn-secondary" disabled="@(!_state.CanRedo)" @onclick="Redo">↷ Redo @_state.RedoLabel</button>

        <span class="group-label">Selection</span>
        <button class="btn btn-secondary" disabled="@(_selected.Count == 0)" @onclick="Group">Group</button>
        <button class="btn btn-secondary" disabled="@(SelectedGroup is null)" @onclick="Ungroup">Ungroup</button>
        <button class="btn btn-secondary" disabled="@(_selected.Count == 0)" @onclick="BringToFront">Bring to front</button>
        <button class="btn btn-secondary" disabled="@(_selected.Count == 0)" @onclick="SendToBack">Send to back</button>

        <span class="group-label">Edit</span>
        <button class="btn btn-secondary" @onclick="AddChain">Add a chain (one step)</button>
        <button class="btn btn-secondary" @onclick="SimulateRemote">Simulate a remote edit</button>
    </Toolbar>
    <ChildContent>
        <BlowCanvas @ref="_flow"
                    Nodes="_nodes"
                    Edges="_edges"
                    HistoryEnabled="true"
                    OnHistoryChanged="s => _state = s"
                    OnGraphChanged="OnGraphChanged"
                    OnSelectionChange="s => _selected = s.Nodes"
                    ZIndexMode="BlowZIndexMode.Basic"
                    ClipboardShortcutsEnabled="true"
                    FitViewOnInit="true">
            <BlowBackground Variant="BlowBackgroundVariant.Dots" Gap="20" />
            <BlowControls />
        </BlowCanvas>
    </ChildContent>
    <Footer>
        @* Under the canvas: as a panel over it the log covered the nodes the chain button adds. *@
        <section class="log" aria-label="Graph changes">
            <h2>Graph changes</h2>
            @if (_log.Count == 0)
            {
                <p class="empty">Drag a node, connect two, or use the toolbar.</p>
            }
            <ol>
                @foreach (var entry in _log)
                {
                    <li><span class="kind">@entry.Kind</span> <span class="origin">@entry.Origin</span> @entry.Label <span class="counts">@entry.Counts</span></li>
                }
            </ol>
        </section>
    </Footer>
    <TryIt>
        <li>Parse and Check start selected: press <strong>Group</strong> and they are wrapped in a group that is selected in their place - nothing moves. <strong>Drag</strong> the group and they go with it.</li>
        <li>With the group selected, press <strong>Ungroup</strong>: the group goes and its nodes stay exactly where they are.</li>
        <li>Click the background to clear the selection, <strong>drag</strong> Parse on top of Check and press <strong>Send to back</strong>. Parse stays on top while it is selected; click the background again and it is drawn beneath Check. Select it and press <strong>Bring to front</strong> to put it back above.</li>
        <li><strong>Add a chain (one step)</strong> adds three nodes and two edges in one edit: one line in the log, and one <strong>Undo</strong> takes all of it back.</li>
        <li><strong>Simulate a remote edit</strong> moves Store as another user's change would: it is logged with the origin <em>Remote</em>, and undo never takes it back - with nothing else done, Undo stays disabled.</li>
        <li>The Undo and Redo buttons name the step they would take back or bring back - <em>group</em>, <em>order</em>, <em>add chain</em>, <em>move</em>. <strong>Ctrl/Cmd+Z</strong> and <strong>Ctrl/Cmd+Shift+Z</strong> do the same, and <strong>Ctrl/Cmd+C</strong>, <strong>V</strong>, <strong>X</strong> and <strong>D</strong> copy, paste, cut and duplicate - groups and all.</li>
    </TryIt>
    <HowItWorks>
        <li><code>GroupSelectionAsync(padding: 24)</code> creates a node of type <code>group</code> sized to enclose the selected nodes with 24 units to spare, makes it their parent - turning each position into one relative to the group - and selects it. It returns null and does nothing when nothing is selected or the selected nodes have different parents.</li>
        <li><code>UngroupAsync(group)</code> hands the children to the group's own parent, again without moving them on screen, and removes the group as a deletion: <code>Deletable</code> and <code>OnBeforeDelete</code> apply to it.</li>
        <li><code>BringToFrontAsync()</code> and <code>SendToBackAsync()</code> move the selection, with everything nested in it, to the end or the start of <code>Nodes</code> - within its parent, so a child never goes behind its own group. <code>ZIndexMode="BlowZIndexMode.Basic"</code> draws nodes in list order, so that order is the stacking order - except that a selected or dragged node is lifted above the rest while it is, which is why the change shows once Parse is deselected. An explicit <code>ZIndex</code> still wins.</li>
        <li><code>EditAsync(action, label: "add chain")</code> makes everything inside the action one edit, however many nodes and edges it adds: one undo step under that label, one <code>OnGraphChanged</code>, one <code>NodesChanged</code> and <code>EdgesChanged</code>, and one render.</li>
        <li>The remote edit passes <code>origin: BlowChangeOrigin.Remote</code> and <code>recordHistory: false</code>: a change listener can tell not to send it back to the server, and instead of becoming a step it is written into every step the history holds (<code>BlowHistory.Rebase</code>).</li>
        <li><code>OnGraphChanged</code> receives a <code>BlowGraphChange</code> per completed edit - its <code>Kind</code> (<code>Moved</code>, <code>Connected</code>, <code>Edited</code>, <code>Replaced</code>, ...), <code>Origin</code> (<code>User</code>, <code>Api</code>, <code>History</code>, <code>Remote</code>), <code>Label</code>, and the <code>Nodes</code>, <code>Edges</code>, <code>RemovedNodes</code> and <code>RemovedEdges</code> it touched - which the log prints. Undo and redo arrive as <code>Replaced</code> changes from <code>History</code>.</li>
        <li><code>HistoryEnabled</code> keeps the undo stack and <code>OnHistoryChanged</code> reports its state to the toolbar; <code>OnSelectionChange</code> keeps the page's copy of the selection, which enables the selection buttons.</li>
    </HowItWorks>
</ExampleScaffold>

<style>
    .group-label { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--bb-text-soft); margin-left: .75rem; }
    .log { font-size: 12px; line-height: 1.5; }
    .log h2 { margin: 0 0 4px; font-size: 12px; }
    .log ol { margin: 0; padding-left: 18px; }
    .log .empty { margin: 0; color: var(--bb-text-soft); }
    .log .kind { font-weight: 600; }
    .log .origin { padding: 0 4px; border: 1px solid var(--bb-border); border-radius: 3px; }
    .log .counts { color: var(--bb-text-soft); }
</style>

@code {
    private sealed record LogEntry(BlowChangeKind Kind, BlowChangeOrigin Origin, string? Label, string Counts);

    private BlowCanvas _flow = default!;
    private List<BlowNode> _nodes = [];
    private List<BlowEdge> _edges = [];
    private BlowHistoryState _state;
    private IReadOnlyList<BlowNode> _selected = [];
    private readonly List<LogEntry> _log = [];
    private int _chains;

    private BlowNode? SelectedGroup => _selected.Count == 1 && _nodes.Any(n => n.ParentId == _selected[0].Id) ? _selected[0] : null;

    protected override void OnInitialized()
    {
        _nodes =
        [
            new BlowNode { Id = "fetch", Type = "input", Label = "Fetch", Position = new(40, 40) },
            new BlowNode { Id = "parse", Label = "Parse", Position = new(40, 160), Selected = true },
            new BlowNode { Id = "check", Label = "Check", Position = new(240, 160), Selected = true },
            new BlowNode { Id = "store", Type = "output", Label = "Store", Position = new(140, 300) },
        ];

        _edges =
        [
            new BlowEdge { Id = "fetch-parse", Source = "fetch", Target = "parse" },
            new BlowEdge { Id = "parse-check", Source = "parse", Target = "check" },
            new BlowEdge { Id = "check-store", Source = "check", Target = "store" },
        ];

        _selected = _nodes.Where(n => n.Selected).ToList();
    }

    private void OnGraphChanged(BlowGraphChange change)
    {
        var counts = new List<string>();
        if (change.Kind != BlowChangeKind.Replaced && change.Nodes.Count > 0) counts.Add($"{change.Nodes.Count} node(s)");
        if (change.Kind != BlowChangeKind.Replaced && change.Edges.Count > 0) counts.Add($"{change.Edges.Count} edge(s)");
        if (change.RemovedNodes.Count > 0) counts.Add($"-{change.RemovedNodes.Count} node(s)");
        if (change.RemovedEdges.Count > 0) counts.Add($"-{change.RemovedEdges.Count} edge(s)");

        _log.Insert(0, new LogEntry(change.Kind, change.Origin, change.Label, string.Join(", ", counts)));
        if (_log.Count > 30) _log.RemoveAt(_log.Count - 1);
    }

    private Task Undo() => _flow.UndoAsync();

    private Task Redo() => _flow.RedoAsync();

    private Task Group() => _flow.GroupSelectionAsync(padding: 24);

    private Task Ungroup() => SelectedGroup is { } group ? _flow.UngroupAsync(group) : Task.CompletedTask;

    private Task BringToFront() => _flow.BringToFrontAsync();

    private Task SendToBack() => _flow.SendToBackAsync();

    private Task AddChain()
    {
        // Three nodes and two edges, added in one edit: one undo step, one change event, one render.
        var n = ++_chains;
        return AddChainAsync();

        async Task AddChainAsync()
        {
            await _flow.EditAsync(() =>
            {
                for (var i = 0; i < 3; i++)
                {
                    _nodes.Add(new BlowNode { Id = $"chain-{n}-{i}", Label = $"Step {n}.{i + 1}", Position = new(420 + i * 170, 40 + n * 90) });
                    if (i > 0) _edges.Add(new BlowEdge { Id = $"chain-{n}-{i}-e", Source = $"chain-{n}-{i - 1}", Target = $"chain-{n}-{i}" });
                }
            }, label: "add chain");

            // The chain goes to the right of the graph, past the edge of the view: bring it in.
            await _flow.FitViewAsync(new BlowFitViewOptions { Duration = 300 });
        }
    }

    private Task SimulateRemote()
    {
        // What a collaboration adapter does with another user's edit: applied as one change, marked Remote so the
        // change listener would not send it back, and kept out of this user's undo history.
        var target = _nodes.FirstOrDefault(n => n.Id == "store") ?? _nodes[^1];
        return _flow.EditAsync(() => target.Position = new(target.Position.X + 40, target.Position.Y),
            label: "remote move", origin: BlowChangeOrigin.Remote, recordHistory: false);
    }
}
