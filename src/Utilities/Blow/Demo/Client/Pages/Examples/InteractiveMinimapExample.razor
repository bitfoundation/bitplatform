@page "/examples/interactive-minimap"

<PageTitle>Interactive MiniMap · Blow</PageTitle>

<ExampleScaffold Title="Interactive MiniMap"
                 Summary="A BlowMiniMap that steers the main view: with Pannable a click or drag on it moves the view there, with Zoomable the wheel over it zooms, and either way it takes keyboard focus and can be steered from the keyboard. OnNodeClick tells you which node was picked on the map - here it selects that node on the canvas.">
    <Toolbar>
        @* The values are written invariantly: a range input reads "0,1" as no value at all. *@
        <label><input type="checkbox" checked="@_pannable" @onchange="@(e => _pannable = (bool)e.Value!)" /> Pannable</label>
        <label><input type="checkbox" checked="@_zoomable" @onchange="@(e => _zoomable = (bool)e.Value!)" /> Zoomable</label>
        <label>Zoom step @_zoomStep.ToString("0")%
            <input type="range" min="5" max="50" step="5" value="@Inv(_zoomStep)" disabled="@(!_zoomable)"
                   @oninput="@(e => _zoomStep = ToDouble(e.Value, 10))" />
        </label>
        <label>Arrow step @_panStep.ToString("0.00")
            <input type="range" min="0.05" max="0.5" step="0.05" value="@Inv(_panStep)" disabled="@(!_pannable)"
                   @oninput="@(e => _panStep = ToDouble(e.Value, 0.1))" />
        </label>
        <span class="im-picked">@(_picked is null ? "Click a node on the map" : $"Picked on the map: {_picked}")</span>
    </Toolbar>
    <ChildContent>
        <BlowCanvas @ref="_flow" Nodes="_nodes" Edges="_edges" FitViewOnInit="true">
            <BlowBackground Variant="BlowBackgroundVariant.Dots" Gap="16" />
            <BlowControls />
            @* demo-minimap-keep keeps the map on a phone too, where the site hides the other samples' minimaps. *@
            <BlowMiniMap Class="demo-minimap-keep" Width="240" Height="180"
                         Pannable="_pannable"
                         Zoomable="_zoomable"
                         ZoomStep="_zoomStep"
                         KeyboardPanStep="_panStep"
                         OnNodeClick="PickNode"
                         AriaLabel="Pipeline overview"
                         RoleDescription="overview map"
                         KeyboardInstructions="@Instructions" />
        </BlowCanvas>
    </ChildContent>
    <TryIt>
        <li><strong>Click</strong> anywhere on the minimap to centre the main view there, or <strong>drag</strong> across it to steer the view continuously; the clear window on the map is what the canvas shows.</li>
        <li><strong>Click a node</strong> on the map: the view moves to it, the node is selected on the canvas (and turns the selection colour on the map), and the toolbar names it.</li>
        <li><strong>Scroll</strong> over the map to zoom the main view about its centre; drag <strong>Zoom step</strong> to change how far each wheel notch zooms.</li>
        <li><strong>Tab</strong> to the map (or click it), then press the <strong>arrow keys</strong> to move the view, <strong>Shift+arrow</strong> to move it five times as far, <strong>+</strong> and <strong>-</strong> to zoom and <strong>Home</strong> to fit the whole flow. The keys stay with the map: the page does not scroll and selected nodes do not move. Drag <strong>Arrow step</strong> to change how far one press goes.</li>
        <li>Untick <strong>Pannable</strong> or <strong>Zoomable</strong> to turn off that half - clicks or the wheel then do nothing on the map. With both off the map is only a picture, and Tab skips it.</li>
        <li>With a screen reader, Tab to the map: it is announced as "Pipeline overview, overview map", followed by the keys it answers to.</li>
    </TryIt>
    <HowItWorks>
        <li><code>Pannable</code> (default <code>true</code>) moves the main view to the point pressed or dragged on the map; <code>Zoomable</code> (default <code>false</code>) zooms it with the wheel, by <code>ZoomStep</code> percent (10) per notch.</li>
        <li>A pannable or zoomable map is in the tab order: arrows pan by <code>KeyboardPanStep</code> (0.1 of the pane, five times that with Shift), <strong>+</strong> and <strong>-</strong> zoom by <code>ZoomStep</code>, and <strong>Home</strong> fits the flow. A map that steers nothing renders as an image, out of the tab order.</li>
        <li><code>OnNodeClick</code> is raised with the node under the pointer when the map is pressed; the page passes it to <code>SelectAsync([node])</code>, which makes it the canvas's selection.</li>
        <li><code>AriaLabel</code> (default "Mini map") is the map's accessible name and <code>RoleDescription</code> (default "mini map") what a screen reader calls it while it can be steered.</li>
        <li><code>KeyboardInstructions</code> is read as the map's description. Left <code>null</code> it describes the keys the map answers to in English; the page writes its own so it can mention Shift, and keeps it in step with the two checkboxes. An empty string leaves it undescribed.</li>
        <li><code>Width</code> and <code>Height</code> (200 by 150) size the map in screen pixels.</li>
    </HowItWorks>
</ExampleScaffold>

<style>
    .im-picked { margin-left: auto; color: var(--bb-text-soft); }
</style>

@code {
    private BlowCanvas? _flow;
    private List<BlowNode> _nodes = [];
    private List<BlowEdge> _edges = [];
    private bool _pannable = true;
    private bool _zoomable = true;
    private double _zoomStep = 10;
    private double _panStep = 0.1;
    private string? _picked;

    // What the map says about its keys, matched to what it answers to right now. Spelled out rather than left to the
    // built-in description so it can mention Shift, which the built-in one does not.
    private string Instructions => (_pannable, _zoomable) switch
    {
        (true, true) => "Arrow keys move the view, Shift with an arrow moves it further, plus and minus zoom, Home shows the whole flow.",
        (true, false) => "Arrow keys move the view, Shift with an arrow moves it further, Home shows the whole flow.",
        (false, true) => "Plus and minus zoom, Home shows the whole flow.",
        _ => "",
    };

    protected override void OnInitialized()
    {
        // Eleven in a grid four wide, so the last row ends short and leaves its corner to the minimap.
        for (var i = 0; i < 11; i++)
        {
            _nodes.Add(new BlowNode
            {
                Id = i.ToString(),
                Label = $"Node {i}",
                Position = new((i % 4) * 200, (i / 4) * 160),
            });
            if (i > 0)
                _edges.Add(new BlowEdge { Id = $"e{i}", Source = (i - 1).ToString(), Target = i.ToString() });
        }
    }

    private async Task PickNode(BlowNode node)
    {
        _picked = node.Label;
        if (_flow is not null) await _flow.SelectAsync([node]);
    }

    private static double ToDouble(object? raw, double fallback)
        => double.TryParse(raw?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed : fallback;

    private static string Inv(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
