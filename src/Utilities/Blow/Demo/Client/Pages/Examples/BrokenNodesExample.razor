@page "/examples/broken-nodes"

<PageTitle>Broken Nodes · Blow</PageTitle>

<ExampleScaffold Title="Broken Nodes"
                 Summary="Edges that reference a missing node are simply skipped instead of throwing, and an edge naming a handle its node does not have is drawn to the middle of that node's side. Toggle the missing node to see its edges appear and disappear.">
    <Toolbar>
        <button class="btn btn-secondary" @onclick="ToggleGhost">@(_hasGhost ? "Remove" : "Add") node 3</button>
    </Toolbar>
    <ChildContent>
        <BlowCanvas @ref="_flow" Nodes="_nodes" Edges="_edges" FitViewOnInit="true">
            <BlowBackground />
            <BlowControls />
        </BlowCanvas>
    </ChildContent>
</ExampleScaffold>

@code {
    private List<BlowNode> _nodes = [];
    private List<BlowEdge> _edges = [];
    private bool _hasGhost;
    private BlowCanvas? _flow;

    protected override void OnInitialized() => Build();

    private void Build()
    {
        _nodes =
        [
            new BlowNode { Id = "1", Type = "input", Label = "Node 1", Position = new(100, 50) },
            new BlowNode { Id = "2", Label = "Node 2", Position = new(100, 200) },
        ];
        if (_hasGhost)
            _nodes.Add(new BlowNode { Id = "3", Type = "output", Label = "Node 3", Position = new(320, 200) });

        // e1-3 / e3-2 reference node "3" which may not exist; they are skipped gracefully.
        _edges =
        [
            new BlowEdge { Id = "e1-2", Source = "1", Target = "2" },
            new BlowEdge { Id = "e1-3", Source = "1", Target = "3" },
            new BlowEdge { Id = "e3-2", Source = "3", Target = "2", TargetHandle = "does-not-exist" },
        ];
    }

    private async Task ToggleGhost()
    {
        _hasGhost = !_hasGhost;
        Build();

        // Node 3 sits to the right of the two the view was fitted to. The canvas has the new lists once this page has
        // rendered, which it does at the first await.
        await Task.Yield();
        if (_flow is not null) await _flow.FitViewAsync(300);
    }
}
