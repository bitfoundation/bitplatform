@page "/examples/edge-toolbar"

<PageTitle>Edge Toolbar · Blow</PageTitle>

<ExampleScaffold Title="Edge Toolbar"
                 Summary="Selecting an edge reveals an BlowEdgeToolbar anchored at its midpoint (constant screen size). Use it to relabel, recolor or delete the edge.">
    <BlowCanvas Nodes="_nodes" Edges="_edges" FitViewOnInit="true" DefaultEdgeType="BlowEdgeType.SmoothStep" Class="recolor-edges">
        <EdgeTemplate Context="ctx">
            <g style="--edge-colour:@(EdgeColour(ctx.Edge))">
                <BlowBaseEdge Path="@ctx.Geometry.Path"
                          Stroke="@(EdgeColour(ctx.Edge))"
                          StrokeWidth="@(ctx.Edge.Selected ? 3 : 1.5)"
                          Label="@ctx.Edge.Label"
                          LabelX="@ctx.Geometry.LabelX"
                          LabelY="@ctx.Geometry.LabelY" />
            </g>
        </EdgeTemplate>
        <EdgeLabelTemplate Context="ctx">
            @if (ctx.Edge.Selected)
            {
                @* Lifted above the label point, so the label the pencil changes is not hidden under it. *@
                <BlowEdgeToolbar Style="translate:0 -26px">
                    <button class="btn-mini" @onclick="() => Relabel(ctx.Edge)">✎</button>
                    <button class="btn-mini" @onclick="() => Recolor(ctx.Edge)">🎨</button>
                    <button class="btn-mini danger" @onclick="() => Remove(ctx.Edge)">×</button>
                </BlowEdgeToolbar>
            }
        </EdgeLabelTemplate>
        <ChildContent>
            <BlowBackground Variant="BlowBackgroundVariant.Dots" Gap="16" />
            <BlowControls />
        </ChildContent>
    </BlowCanvas>
</ExampleScaffold>

<style>
    /* Selection is shown by the width on this page: the selected edge keeps the colour it was given, instead of
       taking the selection colour that would hide what the recolour button just did. */
    .recolor-edges .bit-blow-edge.selected .bit-blow-edge-path { stroke: var(--edge-colour) !important; }
    /* Painted with the canvas's own --bit-blow-* colours, so the toolbar follows its colour mode. */
    .btn-mini { border:1px solid var(--bit-blow-border); background:var(--bit-blow-surface); color:var(--bit-blow-text); border-radius:4px; cursor:pointer; padding:1px 6px; font-size:13px; }
    .btn-mini:hover { background:var(--bit-blow-surface-hover); }
    .btn-mini.danger { color:#ef4444; border-color:color-mix(in srgb, #ef4444 45%, transparent); }
    .btn-mini.danger:hover { background:color-mix(in srgb, #ef4444 14%, var(--bit-blow-surface)); }
</style>

@code {
    private List<BlowNode> _nodes = [];
    private List<BlowEdge> _edges = [];
    private int _n;

    protected override void OnInitialized()
    {
        _nodes =
        [
            new BlowNode { Id = "1", Type = "input", Label = "Start", Position = new(240, 20) },
            new BlowNode { Id = "2", Label = "Middle", Position = new(240, 150) },
            new BlowNode { Id = "3", Type = "output", Label = "End", Position = new(240, 290) },
        ];
        _edges =
        [
            new BlowEdge { Id = "e1-2", Source = "1", Target = "2", Label = "step 1", Data = "#2563eb" },
            new BlowEdge { Id = "e2-3", Source = "2", Target = "3", Label = "step 2", Data = "#16a34a" },
        ];
    }

    private void Relabel(BlowEdge edge) => edge.Label = $"label {++_n}";

    private void Recolor(BlowEdge edge)
    {
        // The next colour round, so every click shows a change.
        var colors = new[] { "#16a34a", "#dc2626", "#2563eb", "#9333ea", "#ea580c" };
        edge.Data = colors[(Array.IndexOf(colors, edge.Data as string) + 1) % colors.Length];
    }

    private void Remove(BlowEdge edge) => _edges.RemoveAll(e => e.Id == edge.Id);

    private static string EdgeColour(BlowEdge edge) => (edge.Data as string) ?? "var(--bit-blow-edge-stroke)";
}
