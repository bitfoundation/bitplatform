@page "/examples/multi-set-nodes"

<PageTitle>Multi setNodes · Blow</PageTitle>

<ExampleScaffold Title="Multi setNodes"
                 Summary="Apply several independent updates to the node list within a single handler. All mutations are coalesced into one render, mirroring multiple setNodes calls in React.">
    <Toolbar>
        <button class="btn btn-primary" @onclick="ShuffleAndRecolor">Shuffle + recolor (one tick)</button>
        <button class="btn btn-secondary" @onclick="Reset">Reset</button>
    </Toolbar>
    <ChildContent>
        <BlowCanvas @ref="_flow" Nodes="_nodes" Edges="_edges" FitViewOnInit="true">
            <BlowBackground Variant="BlowBackgroundVariant.Dots" Gap="16" />
            <BlowControls />
        </BlowCanvas>
    </ChildContent>
</ExampleScaffold>

@code {
    private BlowCanvas? _flow;
    private List<BlowNode> _nodes = [];
    private List<BlowEdge> _edges = [];
    private static readonly string[] Colors = ["#3b82f6", "#22c55e", "#ef4444", "#eab308", "#a855f7"];

    // A tint of the colour mixed into the node's own fill rather than a fixed pastel, so the node reads
    // in the light and the dark colour mode alike.
    private static string Tint(string color) => $"background:color-mix(in srgb, {color} 20%, var(--bit-blow-node-bg));";

    protected override void OnInitialized() => Reset();

    private void Reset()
    {
        _nodes = Enumerable.Range(1, 5)
            .Select(i => new BlowNode { Id = i.ToString(), Label = $"Node {i}", Position = new(i * 90, 120), Style = "background:var(--bit-blow-node-bg);" })
            .ToList();
        _edges = [];
        _flow?.Refresh(remeasure: true);
    }

    private void ShuffleAndRecolor()
    {
        // Multiple successive "set" operations applied before a single re-render.
        foreach (var n in _nodes)
            n.Position = new(Random.Shared.Next(20, 460), Random.Shared.Next(20, 260));
        foreach (var n in _nodes)
            n.Style = Tint(Colors[Random.Shared.Next(Colors.Length)]);
        foreach (var n in _nodes)
            n.Label = $"{n.Id}·{Random.Shared.Next(100)}";
        _flow?.Refresh(remeasure: true);
    }
}
