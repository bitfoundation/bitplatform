@page "/examples/edge-routing"
<PageTitle>Edge Routing · Blow</PageTitle>

<ExampleScaffold Title="Edge Routing"
                 Summary="Edges of type BlowEdgeType.Routed go round the nodes in their way: horizontal and vertical segments that leave each handle straight, keep a margin from every node and prefer few bends. Drag the blocks about and the routes follow. The same router is a pure function, BlowEdgeRouting.Orthogonal, and the router itself can be replaced: the custom one here bends each route round wide curves, as wide as its margin from the nodes allows. The graph exports as a standalone SVG image with ToSvg.">
    <Toolbar>
        <label>Margin <input type="range" min="0" max="40" step="2" value="@_margin" @oninput="SetMargin" aria-label="Routing margin" /></label>
        <span class="er-value">@_margin</span>
        <label>
            Router
            <select @bind="_router" @bind:after="ApplyRouter">
                <option value="built-in">Built-in (square corners rounded)</option>
                <option value="curved">Custom (wide curves)</option>
            </select>
        </label>
        <label><input type="checkbox" @bind="_routed" @bind:after="ApplyType" /> Route round nodes</label>
        <a class="btn btn-secondary" download="routing.svg" href="@SvgUrl()">Export SVG</a>
    </Toolbar>
    <ChildContent>
        @* Handling OnInit and the change events re-renders this page once the canvas is there and after every edit,
           so the export link always carries the graph as it is. *@
        <BlowCanvas @ref="_flow" Nodes="_nodes" Edges="_edges" FitViewOnInit="true" Routing="_routing"
                    AriaLabel="Routing playground"
                    OnInit="_ => { }" NodesChanged="_ => { }" EdgesChanged="_ => { }">
            <BlowBackground Variant="BlowBackgroundVariant.Lines" Gap="20" />
            <BlowControls />
        </BlowCanvas>
    </ChildContent>
</ExampleScaffold>

<style>
    .er-value { font-size: 12px; min-width: 2em; }
</style>

@code {
    private BlowCanvas? _flow;
    private List<BlowNode> _nodes = [];
    private List<BlowEdge> _edges = [];
    private IBlowEdgeRouter _routing = new BlowRoutingOptions { Margin = 16 };
    private int _margin = 16;
    private string _router = "built-in";
    private bool _routed = true;

    protected override void OnInitialized()
    {
        BlowNode Box(string id, string label, double x, double y, double w = 120, double h = 44) => new()
        {
            Id = id, Label = label, Position = new(x, y), Width = w, Height = h,
            SourcePosition = BlowPosition.Right, TargetPosition = BlowPosition.Left,
        };

        _nodes =
        [
            Box("in-1", "Input A", 0, 0),
            Box("in-2", "Input B", 0, 220),
            Box("block-1", "Block", 220, -40, 80, 180),
            Box("block-2", "Block", 220, 200, 80, 120),
            Box("mid", "Transform", 420, 100),
            Box("block-3", "Block", 640, 40, 60, 200),
            Box("out-1", "Output A", 820, 0),
            Box("out-2", "Output B", 820, 260),
        ];
        _edges =
        [
            new() { Id = "a-mid", Source = "in-1", Target = "mid", MarkerEnd = true },
            new() { Id = "b-mid", Source = "in-2", Target = "mid", MarkerEnd = true },
            new() { Id = "mid-a", Source = "mid", Target = "out-1", MarkerEnd = true },
            new() { Id = "mid-b", Source = "mid", Target = "out-2", MarkerEnd = true },
            new() { Id = "a-b", Source = "in-1", Target = "out-2", MarkerEnd = true, Label = "bypass" },
        ];
        ApplyType();
    }

    private void ApplyType()
    {
        foreach (var edge in _edges) edge.Type = _routed ? BlowEdgeType.Routed : BlowEdgeType.SmoothStep;
    }

    private void SetMargin(ChangeEventArgs e)
    {
        _margin = int.TryParse(e.Value?.ToString(), out var m) ? m : _margin;
        ApplyRouter();
    }

    // A new router, so the canvas sees a new parameter and routes again.
    private void ApplyRouter()
        => _routing = _router == "curved" ? new CurvedRouter(_margin) : new BlowRoutingOptions { Margin = _margin };

    /// <summary>
    /// A router of the page's own: the built-in router's corner points, each corner bent round a quadratic curve as
    /// wide as the route's margin allows. A corner sits at least the margin from the node it turns round, and a curve
    /// with legs shorter than four margins never reaches the node, so three margins keeps it clear.
    /// </summary>
    private sealed class CurvedRouter(double margin) : IBlowEdgeRouter
    {
        public BlowPathResult? Route(BlowRouteRequest r)
        {
            var points = BlowEdgeRouting.Orthogonal(r.Source, r.SourceSide, r.Target, r.TargetSide, r.Obstacles,
                new BlowRoutingOptions { Margin = margin });
            if (points is not { Count: >= 2 }) return null;

            static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            static double Length(BlowXYPosition a, BlowXYPosition b) => Math.Abs(b.X - a.X) + Math.Abs(b.Y - a.Y);
            static BlowXYPosition Toward(BlowXYPosition from, BlowXYPosition to, double by)
            {
                var length = Length(from, to);
                return length == 0 ? from : new(from.X + (to.X - from.X) * by / length, from.Y + (to.Y - from.Y) * by / length);
            }

            var d = new System.Text.StringBuilder($"M{F(points[0].X)} {F(points[0].Y)}");
            for (var i = 1; i < points.Count - 1; i++)
            {
                var leg = Math.Min(3 * margin, Math.Min(Length(points[i - 1], points[i]), Length(points[i], points[i + 1])) / 2);
                var from = Toward(points[i], points[i - 1], leg);
                var to = Toward(points[i], points[i + 1], leg);
                d.Append($"L{F(from.X)} {F(from.Y)}Q{F(points[i].X)} {F(points[i].Y)} {F(to.X)} {F(to.Y)}");
            }
            d.Append($"L{F(points[^1].X)} {F(points[^1].Y)}");

            var middle = points.Count / 2;
            return new BlowPathResult(d.ToString(), (points[middle - 1].X + points[middle].X) / 2, (points[middle - 1].Y + points[middle].Y) / 2);
        }
    }

    private string SvgUrl()
        => _flow is null ? "#" : "data:image/svg+xml;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(_flow.ToSvg()));
}
