@namespace Bit.Blow
@{
    _renderedLook = CurrentLook();
    var state = Settings.State?.Invoke(Edge);
    var severity = state is { Issues.Count: > 0 } st && st.Issues[0].Severity != BlowValidationSeverity.Info ? st.Issues[0].Severity : (BlowValidationSeverity?)null;
    var stateText = TabIndex is not null && state is { } s ? AriaLabels.EdgeState(s) : null;
}
<g class="bit-blow-edge @(Edge.Selected ? "selected" : null) @(Edge.Animated ? "animated" : null) @(Edge.Class + BlowNodeRenderer.SeverityClass(severity))"
   data-id="@Edge.Id"
   role="group"
   aria-roledescription="@AriaLabels.EdgeRoleDescription"
   tabindex="@TabIndex"
   aria-label="@AriaLabel"
   aria-describedby="@DescribedByWith(stateText)"
   @onkeydown="OnKeyDown"
   @onpointerdown="OnPointerDown"
   @onpointerdown:stopPropagation="true"
   @onclick="OnClick"
   @onclick:stopPropagation="true"
   @ondblclick="OnDoubleClick"
   @ondblclick:stopPropagation="true"
   @oncontextmenu="OnContextMenu"
   @oncontextmenu:stopPropagation="true"
   @oncontextmenu:preventDefault="@OnContextMenu.HasDelegate"
   @onmouseenter="OnMouseEnter"
   @onmousemove="MouseMoveHandler"
   @onmouseleave="OnMouseLeave">

    @if (!string.IsNullOrEmpty(stateText))
    {
        @* Never drawn; reached through aria-describedby. *@
        <desc id="@_stateId">@stateText</desc>
    }

    @* Invisible wide path to make the edge easy to click. Its width is in screen pixels, so a zoomed-out edge is
       as easy to hit as one at full size; the attribute is the fallback outside a canvas. *@
    <path class="bit-blow-edge-interaction" d="@Geometry.Path" fill="none" stroke="transparent"
          stroke-width="@Inv(Edge.InteractionWidth)" style="@BlowEdgeStyles.InteractionWidth(Edge.InteractionWidth)" />

    @if (Template is not null)
    {
        @Template(Context)
    }
    else
    {
        <path class="bit-blow-edge-path"
              d="@Geometry.Path"
              fill="none"
              stroke="@(Edge.Stroke ?? "var(--bit-blow-edge-stroke)")"
              stroke-width="@Inv(Edge.StrokeWidth)"
              style="@Edge.Style"
              marker-start="@Context.MarkerStartUrl"
              marker-end="@Context.MarkerEndUrl" />

        @if (!SuppressLabel && !string.IsNullOrEmpty(Edge.Label))
        {
            <BlowEdgeText X="Geometry.LabelX" Y="Geometry.LabelY"
                      Label="@Edge.Label"
                      ShowBg="Edge.LabelShowBg"
                      Style="@Edge.LabelStyle"
                      BgStyle="@Edge.LabelBgStyle"
                      PaddingX="Edge.LabelBgPaddingX"
                      PaddingY="Edge.LabelBgPaddingY"
                      BorderRadius="Edge.LabelBgBorderRadius" />
        }
    }
</g>

@code {
    [Parameter, EditorRequired] public BlowEdge Edge { get; set; } = default!;
    [Parameter, EditorRequired] public BlowEdgeContext Context { get; set; } = default!;

    /// <summary>What the canvas tells every edge alike: the template, its graph version, focus and labels.</summary>
    [Parameter, EditorRequired] public BlowEdgeRenderSettings Settings { get; set; } = new();

    /// <summary>The callbacks this edge raises into its canvas.</summary>
    [Parameter] public BlowEdgeCallbacks Callbacks { get; set; } = BlowEdgeCallbacks.None;

    private RenderFragment<BlowEdgeContext>? Template => Settings.Template;
    private bool SuppressLabel => Settings.SuppressLabel;
    private bool Focusable => Settings.Focusable;
    private string? DescribedBy => Settings.DescribedBy;
    private BlowAriaLabels AriaLabels => Settings.AriaLabels;

    private EventCallback<bool> OnActivate => Callbacks.Activate;
    private EventCallback<PointerEventArgs> OnSelect => Callbacks.Select;
    private EventCallback<MouseEventArgs> OnClick => Callbacks.Click;
    private EventCallback<MouseEventArgs> OnDoubleClick => Callbacks.DoubleClick;
    private EventCallback<MouseEventArgs> OnContextMenu => Callbacks.ContextMenu;
    private EventCallback<MouseEventArgs> OnMouseEnter => Callbacks.MouseEnter;
    private EventCallback<MouseEventArgs> OnMouseMove => Callbacks.MouseMove;
    private EventCallback<MouseEventArgs> OnMouseLeave => Callbacks.MouseLeave;

    private Look _renderedLook;

    /// <summary>
    /// What the edge is drawn from. <see cref="Context"/> is compared by reference: the canvas hands back the same
    /// context for as long as the edge's geometry is unchanged, and a new one as soon as it is not - and so is the data.
    /// </summary>
    private readonly record struct Look(
        object Context, bool Selected, bool Animated, string? Class, string? Style, string? Stroke, double StrokeWidth,
        string? Label, string? LabelStyle, bool LabelShowBg, string? LabelBgStyle, double LabelBgPaddingX,
        double LabelBgPaddingY, double LabelBgBorderRadius, double InteractionWidth, bool Focusable,
        string Source, string Target, BlowSameReference Data, object Settings);

    private Look CurrentLook() => new(
        Context, Edge.Selected, Edge.Animated, Edge.Class, Edge.Style, Edge.Stroke, Edge.StrokeWidth,
        Edge.Label, Edge.LabelStyle, Edge.LabelShowBg, Edge.LabelBgStyle, Edge.LabelBgPaddingX,
        Edge.LabelBgPaddingY, Edge.LabelBgBorderRadius, Edge.InteractionWidth, Edge.Focusable,
        Edge.Source, Edge.Target, new(Edge.Data), Settings);

    /// <summary>Skips the render when neither the canvas's graph version nor anything the edge is drawn from changed.</summary>
    protected override bool ShouldRender() => CurrentLook() != _renderedLook;

    private static int s_ids;

    /// <summary>The id of the element describing the edge's state; unique on the page whatever the edge's id.</summary>
    private readonly string _stateId = $"bit-blow-edge-state-{Interlocked.Increment(ref s_ids)}";

    /// <summary>The state first, then the keyboard instructions.</summary>
    private string? DescribedByWith(string? stateText)
    {
        if (TabIndex is null) return null;
        if (string.IsNullOrEmpty(stateText)) return DescribedBy;
        return DescribedBy is null ? _stateId : $"{_stateId} {DescribedBy}";
    }
    private BlowPathResult Geometry => Context.Geometry;

    private static string Inv(double v) => v.ToString(CultureInfo.InvariantCulture);

    private string AriaLabel => string.IsNullOrWhiteSpace(Edge.Label)
        ? AriaLabels.EdgeLabel(Settings.NodeName?.Invoke(Edge.Source) ?? Edge.Source, Settings.NodeName?.Invoke(Edge.Target) ?? Edge.Target)
        : Edge.Label;

    private string? TabIndex => Focusable && Edge.Focusable ? "0" : null;

    // Only attach the high-frequency move listener when someone is listening for it;
    // an empty EventCallback makes the renderer omit the attribute entirely.
    private EventCallback<MouseEventArgs> MouseMoveHandler =>
        OnMouseMove.HasDelegate ? OnMouseMove : default;

    private Task OnPointerDown(PointerEventArgs e) => OnSelect.InvokeAsync(e);

    /// <summary>Enter/Space toggles selection, matching how a focused node is activated; the connection key picks up an end.</summary>
    private Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") return OnActivate.InvokeAsync(e.ShiftKey);

        if (Settings.ConnectionKey is { } key && !e.CtrlKey && !e.MetaKey && !e.AltKey
            && string.Equals(e.Key, key, StringComparison.OrdinalIgnoreCase))
        {
            return Callbacks.Connect.InvokeAsync();
        }

        return Task.CompletedTask;
    }
}
