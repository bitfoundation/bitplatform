@namespace Bit.Blow
@using Microsoft.AspNetCore.Components.Rendering
@{
    _renderedLook = CurrentLook();
    var state = Settings.State?.Invoke(Node);
    var severity = Severity(state);
    var stateText = TabIndex is not null && state is { } s ? AriaLabels.NodeState(s) : null;
}

<div class="@(CssClass + SeverityClass(severity) + RunClass(state))"
     data-id="@Node.Id"
     style="@StyleString"
     tabindex="@TabIndex"
     role="group"
     aria-roledescription="@AriaLabels.NodeRoleDescription"
     aria-label="@AriaLabel"
     aria-describedby="@DescribedByWith(stateText)"
     @onkeydown="OnKeyDown"
     @onfocus="OnFocus"
     @onpointerdown="OnPointerDown"
     @onpointerdown:stopPropagation="true"
     @onclick="OnClick"
     @onclick:stopPropagation="true"
     @ondblclick="OnDoubleClick"
     @ondblclick:stopPropagation="true"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:stopPropagation="true"
     @oncontextmenu:preventDefault="@OnContextMenu.HasDelegate"
     @onmouseenter="OnMouseEnter"
     @onmousemove="MouseMoveHandler"
     @onmouseleave="OnMouseLeave">
    <CascadingValue Value="_nodeContext" IsFixed="true">
        @if (Template is not null)
        {
            @Template(Node)
        }
        else
        {
            <BlowDefaultNode Node="Node" />
        }
    </CascadingValue>
</div>
@if (!string.IsNullOrEmpty(stateText))
{
    @* Beside the node rather than in it, so it is no part of the node's own content; hidden, so it is read only
       through aria-describedby, which reads hidden text. *@
    <span id="@_stateId" hidden>@stateText</span>
}

@code {
    [Parameter, EditorRequired] public BlowNode Node { get; set; } = default!;

    /// <summary>What the canvas tells every node alike: the template, its graph version, focus and stacking.</summary>
    [Parameter, EditorRequired] public BlowNodeRenderSettings Settings { get; set; } = new();

    /// <summary>The callbacks this node raises into its canvas.</summary>
    [Parameter] public BlowNodeCallbacks Callbacks { get; set; } = BlowNodeCallbacks.None;

    private RenderFragment<BlowNode>? Template => Settings.Template;
    private bool Focusable => Settings.Focusable;
    private string? DescribedBy => Settings.DescribedBy;
    private bool Elevate => Settings.Elevate;
    private bool ElevateWhileDragging => Settings.ElevateWhileDragging;
    private BlowAriaLabels AriaLabels => Settings.AriaLabels;

    private EventCallback<PointerEventArgs> OnDragStart => Callbacks.DragStart;
    private EventCallback<bool> OnActivate => Callbacks.Activate;
    private EventCallback<FocusEventArgs> OnFocus => Callbacks.Focus;
    private EventCallback<MouseEventArgs> OnClick => Callbacks.Click;
    private EventCallback<MouseEventArgs> OnDoubleClick => Callbacks.DoubleClick;
    private EventCallback<MouseEventArgs> OnContextMenu => Callbacks.ContextMenu;
    private EventCallback<MouseEventArgs> OnMouseEnter => Callbacks.MouseEnter;
    private EventCallback<MouseEventArgs> OnMouseMove => Callbacks.MouseMove;
    private EventCallback<MouseEventArgs> OnMouseLeave => Callbacks.MouseLeave;

    /// <summary>
    /// Effective stacking order: an explicit <c>BlowNode.ZIndex</c> always wins, otherwise a
    /// selected or dragged node is lifted above the rest so it isn't hidden behind them.
    /// </summary>
    private int? ZIndex
    {
        get
        {
            if (Node.ZIndex is { } explicitZ) return explicitZ;
            if (ElevateWhileDragging && Node.Dragging) return ElevatedZIndex + 1;
            if (Elevate && Node.Selected) return ElevatedZIndex;
            return null;
        }
    }

    private const int ElevatedZIndex = 1000;

    // Only attach the high-frequency move listener when someone is listening for it;
    // an empty EventCallback makes the renderer omit the attribute entirely.
    private EventCallback<MouseEventArgs> MouseMoveHandler =>
        OnMouseMove.HasDelegate ? OnMouseMove : default;

    private string? TabIndex => (Focusable && Node.Focusable) ? "0" : null;
    // A blank label names nothing: the node is called by its id rather than by nothing at all.
    private string AriaLabel => AriaLabels.NodeLabel(Named(Node.AriaLabel) ?? Named(Node.Label) ?? $"Node {Node.Id}");

    private static string? Named(string? text) => string.IsNullOrWhiteSpace(text) ? null : text;

    private string CssClass
    {
        get
        {
            var sb = new System.Text.StringBuilder("bit-blow-node bit-blow-node-");
            sb.Append(Node.Type);
            if (Node.Selected) sb.Append(" selected");
            if (Node.Dragging) sb.Append(" dragging");
            if (Node.Resizing) sb.Append(" resizing");
            if (Node.Collapsed) sb.Append(" collapsed");
            // Not "nodrag": that is the canvas's escape-hatch class, and the guard behind it
            // swallows every press inside the element - selecting the node and its handles too.
            if (!Node.Draggable) sb.Append(" undraggable");
            if (!string.IsNullOrEmpty(Node.Class)) sb.Append(' ').Append(Node.Class);
            return sb.ToString();
        }
    }

    private BlowNodeContext _nodeContext = default!;

    // ---- state and validation ----

    private static int s_ids;

    /// <summary>The id of the hidden element describing the node's state; unique on the page whatever the node's id.</summary>
    private readonly string _stateId = $"bit-blow-state-{Interlocked.Increment(ref s_ids)}";

    /// <summary>The state first, then the keyboard instructions.</summary>
    private string? DescribedByWith(string? stateText)
    {
        if (TabIndex is null) return null;
        if (string.IsNullOrEmpty(stateText)) return DescribedBy;
        return DescribedBy is null ? _stateId : $"{_stateId} {DescribedBy}";
    }

    /// <summary>The most serious issue that marks the node: an error or a warning. Notes are not marked.</summary>
    internal static BlowValidationSeverity? Severity(BlowNodeState? state)
        => state is { Issues.Count: > 0 } s && s.Issues[0].Severity != BlowValidationSeverity.Info ? s.Issues[0].Severity : null;

    /// <summary>The class a run status marks the node with: <c>bit-blow-run-running</c> and so on; none when idle.</summary>
    private static string? RunClass(BlowNodeState? state) => state?.Run.Status switch
    {
        BlowRunStatus.Queued => " bit-blow-run-queued",
        BlowRunStatus.Running => " bit-blow-run-running",
        BlowRunStatus.Succeeded => " bit-blow-run-succeeded",
        BlowRunStatus.Failed => " bit-blow-run-failed",
        BlowRunStatus.Skipped => " bit-blow-run-skipped",
        _ => null,
    };

    internal static string? SeverityClass(BlowValidationSeverity? severity) => severity switch
    {
        BlowValidationSeverity.Error => " bit-blow-error",
        BlowValidationSeverity.Warning => " bit-blow-warning",
        _ => null,
    };

    // ---- rendering only what changed ----

    private Look _renderedLook;

    /// <summary>
    /// Everything the node's markup is drawn from: its geometry and the state the canvas maintains during a
    /// gesture, and the settings it was handed - a new settings object whenever the canvas's graph version, or
    /// anything else in it, changes. The callbacks are left out: which ones are wired up only changes when the
    /// canvas's parameters do, and that changes the graph version too. The data is compared by reference: a node given
    /// new data is drawn again, and one whose data was changed in place is drawn again when the canvas next is.
    /// </summary>
    private readonly record struct Look(
        BlowXYPosition Position, double? Width, double? Height, BlowDimensions Measured,
        bool Selected, bool Dragging, bool Resizing, bool Draggable, bool Connectable, bool Focusable, bool Collapsed,
        string Type, string? Label, string? AriaLabel, string? Class, string? Style, int? ZIndex,
        BlowSameReference Data, object? Ports, BlowPosition SourcePosition, BlowPosition TargetPosition,
        object Settings);

    private Look CurrentLook() => new(
        Node.AbsolutePosition, Node.Width, Node.Height, Node.Measured,
        Node.Selected, Node.Dragging, Node.Resizing, Node.Draggable, Node.Connectable, Node.Focusable, Node.Collapsed,
        Node.Type, Node.Label, Node.AriaLabel, Node.Class, Node.Style, Node.ZIndex,
        new(Node.Data), Node.Ports, Node.SourcePosition, Node.TargetPosition,
        Settings);

    /// <summary>
    /// Skips the render when neither the canvas's graph version nor anything the node is drawn from has changed -
    /// which is every node on every frame of a pan, and every node but the dragged ones on every frame of a drag.
    /// </summary>
    protected override bool ShouldRender() => CurrentLook() != _renderedLook;

    protected override void OnParametersSet()
    {
        // The context is cascaded as fixed, so content only ever sees the first instance. A new
        // Node under the same id (restored, undone) is pointed at in place; replacing the context
        // would leave handles and drag handles acting on a node no longer in the graph.
        if (_nodeContext is null) _nodeContext = new BlowNodeContext { Node = Node };
        else _nodeContext.Node = Node;
    }

    private string StyleString
    {
        get
        {
            var s = string.Create(CultureInfo.InvariantCulture,
                $"transform:translate({Node.AbsolutePosition.X}px,{Node.AbsolutePosition.Y}px);");
            // An explicit size is the size: the stylesheet's minimum for auto-sized nodes must not
            // quietly overrule it, or the box on screen and the one every hit-test uses disagree.
            if (Node.Width is { } w)
                s += string.Create(CultureInfo.InvariantCulture, $"width:{w}px;min-width:0;");
            if (Node.Height is { } h)
                s += string.Create(CultureInfo.InvariantCulture, $"height:{h}px;min-height:0;");
            // Invariant: some cultures write a negative number with U+2212, which CSS rejects.
            if (ZIndex is { } z)
                s += string.Create(CultureInfo.InvariantCulture, $"z-index:{z};");
            if (!string.IsNullOrEmpty(Node.Style))
                s += Node.Style;
            return s;
        }
    }

    // Note: this fires regardless of Node.Draggable - the canvas uses it for selection too,
    // and a non-draggable node must still be selectable.
    private async Task OnPointerDown(PointerEventArgs e)
    {
        if (e.Button == 0)
            await OnDragStart.InvokeAsync(e);
    }

    /// <summary>
    /// Enter/Space selects the focused node, and the connection key starts a connection from it. Arrow keys are
    /// deliberately left to bubble up to the pane, which moves the whole selection.
    /// </summary>
    private Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") return OnActivate.InvokeAsync(e.ShiftKey);

        if (Settings.ConnectionKey is { } key && !e.CtrlKey && !e.MetaKey && !e.AltKey
            && string.Equals(e.Key, key, StringComparison.OrdinalIgnoreCase))
        {
            return Callbacks.Connect.InvokeAsync();
        }

        return Task.CompletedTask;
    }
}
