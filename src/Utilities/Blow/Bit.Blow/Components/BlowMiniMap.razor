@namespace Bit.Blow
@* The viewBox is on an inner <svg>, not on the root that takes focus: WebKit scrolls a focused <svg> into view by
   its content's bounds in user units, unscaled - a graph hundreds of units tall - so tabbing to the minimap, or
   steering it with the arrow keys, would scroll the page by that much. The inner one is laid out at the root's size,
   so it draws exactly what a viewBox on the root would. *@
<svg class="bit-blow-minimap bit-blow-minimap-@PositionClass @(Pannable ? "pannable" : null) @(Zoomable ? "zoomable" : null) @Class"
     width="@Width" height="@Height"
     style="@StyleString"
     role="@(Interactive ? "group" : "img")"
     aria-roledescription="@(Interactive ? RoleDescription : null)"
     aria-label="@AriaLabel"
     aria-describedby="@(Interactive && !string.IsNullOrEmpty(Instructions) ? _descriptionId : null)"
     tabindex="@(Interactive ? "0" : null)"
     @onkeydown="KeyDownHandler"
     @ref="_self"
     @onpointerdown="OnPointerDown"
     @onpointerdown:stopPropagation="true"
     @onpointermove="PointerMoveHandler"
     @onpointerup="PointerEndHandler"
     @onpointerleave="PointerEndHandler"
     @onpointercancel="PointerEndHandler"
     @onwheel="OnWheel"
     @onwheel:stopPropagation="true"
     @onwheel:preventDefault="Zoomable"
     @onclick:stopPropagation="true"
     @ondblclick:stopPropagation="true"
     @oncontextmenu:stopPropagation="true">
    @if (Interactive && !string.IsNullOrEmpty(Instructions))
    {
        <desc id="@_descriptionId">@Instructions</desc>
    }
    <svg class="bit-blow-minimap-graph" width="100%" height="100%" viewBox="@ViewBox" aria-hidden="true">
        @foreach (var node in Nodes)
        {
            if (node.Hidden) continue;
            var r = node.GetRect();
            @if (NodeTemplate is not null)
            {
                <g transform="@($"translate({Inv(r.X)},{Inv(r.Y)})")">
                    @NodeTemplate(node)
                </g>
            }
            else
            {
                <rect class="bit-blow-minimap-node @(node.Selected ? "selected" : null) @NodeClassFunc?.Invoke(node)"
                      x="@Inv(r.X)" y="@Inv(r.Y)"
                      width="@Inv(r.Width)" height="@Inv(r.Height)"
                      rx="@Inv(BorderRadius)"
                      fill="@(NodeColorFunc?.Invoke(node) ?? (node.Selected ? "var(--bit-blow-node-selected)" : NodeColor))"
                      stroke="@(NodeStrokeColorFunc?.Invoke(node) ?? NodeStrokeColor)"
                      stroke-width="@Inv(NodeStrokeWidth)" />
            }
        }
        <path class="bit-blow-minimap-mask"
              d="@MaskPath"
              fill="@MaskColor"
              stroke="@MaskStrokeColor"
              stroke-width="@Inv(MaskStrokeWidth)"
              fill-rule="evenodd" />
    </svg>
</svg>

@code {
    [CascadingParameter(Name = BlowCascadingNames.Context)] private IBlowContext Flow { get; set; } = default!;
    [CascadingParameter(Name = BlowCascadingNames.ViewportVersion)] private int ViewportVersion { get; set; }
    [CascadingParameter(Name = BlowCascadingNames.GeometryVersion)] private int GeometryVersion { get; set; }

    [Parameter] public int Width { get; set; } = 200;
    [Parameter] public int Height { get; set; } = 150;
    /// <summary>
    /// Default node fill. Defaults to the theme's minimap colour, so it follows the colour mode. A selected node is
    /// filled with the theme's selection colour instead, unless <see cref="NodeColorFunc"/> decides every fill.
    /// </summary>
    [Parameter] public string NodeColor { get; set; } = "var(--bit-blow-minimap-node)";

    /// <summary>Fill of the area outside the visible viewport. Defaults to the theme's mask colour.</summary>
    [Parameter] public string MaskColor { get; set; } = "var(--bit-blow-minimap-mask)";

    /// <summary>Default node outline color.</summary>
    [Parameter] public string NodeStrokeColor { get; set; } = "transparent";

    /// <summary>Default node outline width (in flow units).</summary>
    [Parameter] public double NodeStrokeWidth { get; set; } = 2;

    /// <summary>Corner radius of the default node rectangles.</summary>
    [Parameter] public double BorderRadius { get; set; } = 2;

    /// <summary>Per-node fill color, selected nodes included. Overrides <see cref="NodeColor"/> when provided.</summary>
    [Parameter] public Func<BlowNode, string>? NodeColorFunc { get; set; }

    /// <summary>Per-node outline color. Overrides <see cref="NodeStrokeColor"/> when provided.</summary>
    [Parameter] public Func<BlowNode, string>? NodeStrokeColorFunc { get; set; }

    /// <summary>Per-node extra CSS class for the minimap rectangle.</summary>
    [Parameter] public Func<BlowNode, string?>? NodeClassFunc { get; set; }

    /// <summary>Optional SVG template for each minimap node, rendered translated to the node origin.</summary>
    [Parameter] public RenderFragment<BlowNode>? NodeTemplate { get; set; }

    /// <summary>When true, clicking or dragging on the minimap pans the main viewport.</summary>
    [Parameter] public bool Pannable { get; set; } = true;

    /// <summary>When true, scrolling over the minimap zooms the main viewport.</summary>
    [Parameter] public bool Zoomable { get; set; }

    /// <summary>Percentage the viewport zooms by per wheel notch when <see cref="Zoomable"/> is on.</summary>
    [Parameter] public double ZoomStep { get; set; } = 10;

    /// <summary>Corner the minimap is anchored to. Defaults to bottom-right.</summary>
    [Parameter] public BlowPanelPosition Position { get; set; } = BlowPanelPosition.BottomRight;

    /// <summary>Outline color of the viewport mask.</summary>
    [Parameter] public string MaskStrokeColor { get; set; } = "transparent";

    /// <summary>Outline width of the viewport mask, in flow units.</summary>
    [Parameter] public double MaskStrokeWidth { get; set; } = 1;

    /// <summary>Background color of the minimap surface. Falls back to the stylesheet when null.</summary>
    [Parameter] public string? BgColor { get; set; }

    /// <summary>Raised when a minimap node is clicked.</summary>
    [Parameter] public EventCallback<BlowNode> OnNodeClick { get; set; }

    [Parameter] public string AriaLabel { get; set; } = "Mini map";

    /// <summary>What a screen reader calls the minimap while it can be steered from the keyboard.</summary>
    [Parameter] public string RoleDescription { get; set; } = "mini map";

    /// <summary>
    /// How to steer the minimap from the keyboard, read as its description while it is pannable or zoomable. Null
    /// describes the keys it actually answers to, in English; an empty string leaves it undescribed.
    /// </summary>
    [Parameter] public string? KeyboardInstructions { get; set; }

    /// <summary>
    /// How far one press of an arrow key moves the view, as a fraction of the pane; Shift moves it five times as far.
    /// </summary>
    [Parameter] public double KeyboardPanStep { get; set; } = 0.1;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private BlowRect _bounds;
    private bool _panning;
    private ElementReference _self;

    private static int s_ids;
    private readonly string _descriptionId = $"bit-blow-minimap-help-{Interlocked.Increment(ref s_ids)}";

    /// <summary>
    /// True when the minimap steers the view, and so takes keyboard focus: the arrow keys pan, plus and minus zoom,
    /// Home fits the whole flow in view.
    /// </summary>
    private bool Interactive => Attached && (Pannable || Zoomable);

    private string? Instructions => KeyboardInstructions ?? (Pannable, Zoomable) switch
    {
        (true, true) => "Arrow keys move the view, plus and minus zoom, Home shows the whole flow.",
        (true, false) => "Arrow keys move the view, Home shows the whole flow.",
        (false, true) => "Plus and minus zoom, Home shows the whole flow.",
        _ => null,
    };

    /// <summary>
    /// False when the minimap was placed outside a <c>BlowCanvas</c>. It still renders - an empty
    /// frame beats bringing the page down with a null reference - but shows nothing and does nothing.
    /// </summary>
    private bool Attached => Flow is not null;

    /// <summary>The nodes to draw; empty when there is no canvas to read them from.</summary>
    private IReadOnlyList<BlowNode> Nodes => Attached ? Flow.CurrentNodes : [];

    private string PositionClass => BlowPanelPositionClass.For(Position);

    private string? StyleString =>
        BgColor is null ? Style : "background:" + BgColor + ";" + Style;

    private string ViewBox => string.Create(CultureInfo.InvariantCulture,
        $"{_bounds.X} {_bounds.Y} {_bounds.Width} {_bounds.Height}");

    // The frame is held still while the user is steering with it. The bounds include the
    // viewport, so recomputing them as the drag moves the viewport would move the frame under the
    // pointer, the same pixel would then map further out, and the view would run away.
    protected override void OnParametersSet()
    {
        if (!_panning) _bounds = ComputeBounds();
    }

    private BlowRect ComputeBounds()
    {
        // Union of all node rects, padded; falls back to the visible viewport area.
        double minX = double.MaxValue, minY = double.MaxValue, maxX = double.MinValue, maxY = double.MinValue;
        bool any = false;
        foreach (var n in Nodes)
        {
            if (n.Hidden) continue;
            any = true;
            var r = n.GetRect();
            minX = Math.Min(minX, r.X);
            minY = Math.Min(minY, r.Y);
            maxX = Math.Max(maxX, r.Right);
            maxY = Math.Max(maxY, r.Bottom);
        }

        if (!any)
            return new BlowRect(0, 0, Width, Height);

        // Include the current viewport rectangle so the mask is always visible.
        var vp = VisibleRect();
        minX = Math.Min(minX, vp.X);
        minY = Math.Min(minY, vp.Y);
        maxX = Math.Max(maxX, vp.Right);
        maxY = Math.Max(maxY, vp.Bottom);

        var w = maxX - minX;
        var h = maxY - minY;
        var pad = Math.Max(w, h) * 0.1 + 10;
        return FitAspect(new BlowRect(minX - pad, minY - pad, w + pad * 2, h + pad * 2));
    }

    /// <summary>
    /// Grows the view box on whichever axis is short so its aspect ratio matches the minimap
    /// element's. Without this the SVG's own <c>preserveAspectRatio</c> letterboxes the content,
    /// which both wastes half the minimap and - because the letterbox is invisible to C# - makes
    /// every pointer position mapped back into flow space wrong by the size of the bars.
    /// </summary>
    private BlowRect FitAspect(BlowRect bounds)
    {
        if (Width <= 0 || Height <= 0 || bounds.Width <= 0 || bounds.Height <= 0) return bounds;

        var target = (double)Width / Height;
        var current = bounds.Width / bounds.Height;
        if (Math.Abs(target - current) < 1e-9) return bounds;

        if (current < target)
        {
            var w = bounds.Height * target;
            return new BlowRect(bounds.X - (w - bounds.Width) / 2, bounds.Y, w, bounds.Height);
        }

        var h = bounds.Width / target;
        return new BlowRect(bounds.X, bounds.Y - (h - bounds.Height) / 2, bounds.Width, h);
    }

    /// <summary>
    /// Maps a minimap-local pixel to the flow point drawn there. Linear because
    /// <see cref="FitAspect"/> has already made the view box match the element's shape.
    /// </summary>
    private BlowXYPosition ToFlow(double offsetX, double offsetY) => new(
        _bounds.X + offsetX * (_bounds.Width / Width),
        _bounds.Y + offsetY * (_bounds.Height / Height));

    private BlowRect VisibleRect()
    {
        if (!Attached) return new BlowRect(0, 0, Width, Height);

        var vp = Flow.Viewport;
        var pane = Flow.PaneSize;
        var topLeft = vp.ScreenToFlow(0, 0);
        return new BlowRect(topLeft.X, topLeft.Y, pane.Width / vp.Zoom, pane.Height / vp.Zoom);
    }

    private string MaskPath
    {
        get
        {
            var b = _bounds;
            var v = VisibleRect();
            // Outer rect (clockwise) + inner viewport rect (counter-clockwise) => mask everything except viewport.
            return string.Create(CultureInfo.InvariantCulture,
                $"M{b.X},{b.Y}h{b.Width}v{b.Height}h{-b.Width}z " +
                $"M{v.X},{v.Y}v{v.Height}h{v.Width}v{-v.Height}z");
        }
    }

    private static string Inv(double v) => v.ToString(CultureInfo.InvariantCulture);

    private async Task OnPointerDown(PointerEventArgs e)
    {
        if (!Attached || e.Button != 0) return;

        // The press never reaches the pane: the canvas is told of it, so what was left waiting ends as it would there.
        Flow.PointerPressed();

        if (Pannable)
        {
            _panning = true;

            // Capture the pointer so a drag that wanders off the minimap keeps steering the
            // viewport, rather than stopping dead at the minimap's border.
            Flow.CapturePointer(_self, e.PointerId);
            PanTo(e.OffsetX, e.OffsetY);
        }

        if (OnNodeClick.HasDelegate && NodeAt(e.OffsetX, e.OffsetY) is { } hit)
            await OnNodeClick.InvokeAsync(hit);
    }

    // Only listened for while panning: every hover move (and leave) would otherwise round-trip into
    // .NET and re-render the minimap for nothing. An empty callback makes the renderer omit the attribute.
    private EventCallback<PointerEventArgs> PointerMoveHandler => _panning
        ? EventCallback.Factory.Create<PointerEventArgs>(this, OnPointerMove)
        : default;

    private EventCallback<PointerEventArgs> PointerEndHandler => _panning
        ? EventCallback.Factory.Create<PointerEventArgs>(this, OnPointerUp)
        : default;

    private void OnPointerMove(PointerEventArgs e)
    {
        if (_panning) PanTo(e.OffsetX, e.OffsetY);
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        if (!_panning) return;
        _panning = false;
        _bounds = ComputeBounds();
    }

    private void OnWheel(WheelEventArgs e)
    {
        if (!Attached || !Zoomable || e.DeltaY == 0) return;

        // One notch of a mouse wheel zooms by ZoomStep percent; the small deltas a trackpad
        // sends zoom by the matching fraction of that, rather than a full step each.
        var notches = e.DeltaMode switch
        {
            1 => e.DeltaY / 3,  // lines
            2 => e.DeltaY,      // pages
            _ => e.DeltaY / 100 // pixels
        };
        ZoomBy(-Math.Clamp(notches, -1, 1));
    }

    // Only listened for while the minimap can take focus; an empty callback makes the renderer omit the attribute.
    private EventCallback<KeyboardEventArgs> KeyDownHandler => Interactive
        ? EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDown)
        : default;

    /// <summary>
    /// The minimap's own keys. The ones it acts on are marked handled, so the pane leaves them alone - the same arrows
    /// on the pane move the selected nodes, which is not what a user steering the view means. Any other key, Escape
    /// among them, goes on to the pane as usual.
    /// </summary>
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (!Interactive || e.CtrlKey || e.MetaKey || e.AltKey) return;
        var acted = (Pannable && e.Key.StartsWith("Arrow", StringComparison.Ordinal))
                    || (Zoomable && e.Key is "+" or "=" or "-" or "_")
                    || e.Key == "Home";
        if (!acted) return;
        Flow.MarkKeyHandled(e.Key);

        var pane = Flow.PaneSize;
        var step = Math.Max(0, KeyboardPanStep) * (e.ShiftKey ? 5 : 1);
        var (dx, dy) = e.Key switch
        {
            // The view moves the way the arrow points, so the graph slides the other way.
            "ArrowLeft" => (pane.Width * step, 0.0),
            "ArrowRight" => (-pane.Width * step, 0.0),
            "ArrowUp" => (0.0, pane.Height * step),
            "ArrowDown" => (0.0, -pane.Height * step),
            _ => (0.0, 0.0),
        };

        if ((dx != 0 || dy != 0) && Pannable)
        {
            var vp = Flow.Viewport;
            Flow.SetViewport(vp with { X = vp.X + dx, Y = vp.Y + dy });
        }
        else if (Zoomable && e.Key is "+" or "=") ZoomBy(1);
        else if (Zoomable && e.Key is "-" or "_") ZoomBy(-1);
        else if (e.Key == "Home") Flow.FitView();
    }

    /// <summary>Zooms about the pane's centre by <paramref name="notches"/> steps of <see cref="ZoomStep"/> percent.</summary>
    private void ZoomBy(double notches)
    {
        var step = 1 + Math.Max(0, ZoomStep) / 100.0;
        var factor = Math.Pow(step, notches);

        // Clamped first, so that at a zoom limit the view stays put instead of the focus point
        // being scaled anyway and the view sliding sideways on every notch.
        var vp = Flow.Viewport;
        var newZoom = Math.Clamp(vp.Zoom * factor, Flow.MinZoom, Flow.MaxZoom);
        if (Math.Abs(newZoom - vp.Zoom) < 1e-9) return;

        // Zoom about the pane centre and go through SetViewport so TranslateExtent is respected.
        var pane = Flow.PaneSize;
        var cx = pane.Width / 2;
        var cy = pane.Height / 2;
        var focus = vp.ScreenToFlow(cx, cy);
        Flow.SetViewport(new BlowViewport(cx - focus.X * newZoom, cy - focus.Y * newZoom, newZoom));
    }

    /// <summary>Maps a minimap-local pixel to the topmost node under it, or null.</summary>
    private BlowNode? NodeAt(double offsetX, double offsetY)
    {
        if (Width <= 0 || Height <= 0) return null;
        var p = ToFlow(offsetX, offsetY);

        BlowNode? found = null;
        foreach (var n in Nodes)
        {
            if (n.Hidden) continue;
            var r = n.GetRect();
            if (p.X >= r.Left && p.X <= r.Right && p.Y >= r.Top && p.Y <= r.Bottom) found = n;
        }
        return found;
    }

    /// <summary>Centers the main viewport on the flow point under the given minimap-local pixel.</summary>
    private void PanTo(double offsetX, double offsetY)
    {
        if (!Attached || Width <= 0 || Height <= 0) return;
        var p = ToFlow(offsetX, offsetY);

        var vp = Flow.Viewport;
        var pane = Flow.PaneSize;
        var x = pane.Width / 2 - p.X * vp.Zoom;
        var y = pane.Height / 2 - p.Y * vp.Zoom;
        Flow.SetViewport(new BlowViewport(x, y, vp.Zoom));
    }
}
