<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!-- The browser half of the lazy loading sample: it downloads Bit.Blow.wasm only when the page with a canvas opens.
         It does everything the README's "Lazy loading on WebAssembly" section asks of such a project, and the
         end-to-end suite (Tests/Bit.Blow.Tests.E2E, LazyLoadingTests) publishes it and checks it in a browser. -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
        <ProjectReference Include="..\..\..\Bit.Blow\Bit.Blow.csproj" />
    </ItemGroup>

    <!-- AOT builds load Bit.Blow with the rest of the app. -->
    <ItemGroup Condition=" '$(RunAOTCompilation)' != 'true' ">
        <BlazorWebAssemblyLazyLoad Include="Bit.Blow.wasm" />
        <RuntimeHostConfigurationOption Include="Bit.Blow.Samples.Lazy.LazyLoadsBlow" Value="true" Trim="true" />
    </ItemGroup>

</Project>
