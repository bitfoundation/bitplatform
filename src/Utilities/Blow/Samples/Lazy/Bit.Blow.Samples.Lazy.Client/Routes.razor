@* The router waits for OnNavigateAsync before it renders a page, so Bit.Blow.wasm is there before the workflow renders
   its canvas. This file renders before the assembly is downloaded, so it may not use Blow's types itself. The server
   prerenders it too: it registers LazyAssemblyLoader for that (its Program.cs), and does not set the switch, as it
   loads Blow with the rest of the app. *@
@using Microsoft.AspNetCore.Components.WebAssembly.Services
@inject LazyAssemblyLoader LazyAssemblyLoader

<Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Set only where Bit.Blow.wasm is marked (the project file): loading an assembly that is not marked throws.
    private static readonly bool LazyLoadsBlow = AppContext.TryGetSwitch("Bit.Blow.Samples.Lazy.LazyLoadsBlow", out var on) && on;

    private async Task OnNavigateAsync(NavigationContext context)
    {
        // The pages with a canvas: fetch Blow before they render. A second call loads nothing again.
        if (LazyLoadsBlow && IsEditorPage(context.Path))
            await LazyAssemblyLoader.LoadAssembliesAsync(["Bit.Blow.wasm"]);
    }

    // /workflow and the routes beneath it, such as /Workflow/42 (routes match regardless of case), but not
    // /workflow-archive. The path keeps any query and fragment.
    private static bool IsEditorPage(string path)
    {
        var page = path.Split('?', '#')[0].Split('/')[0];
        return page.Equals("workflow", StringComparison.OrdinalIgnoreCase);
    }
}
