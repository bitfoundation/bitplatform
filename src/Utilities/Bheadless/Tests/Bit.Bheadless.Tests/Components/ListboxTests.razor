    [TestMethod]
    public void Anchored_panel_scrolls_to_the_highlight_once_it_is_revealed()
    {
        // An anchored / portalled panel stays hidden until the runtime has opened it: a scroll sent before
        // that does nothing. The open is held in flight here.
        var module = JSInterop.SetupModule(BitBhInterop.ModulePath);
        var open = module.Setup<int>("floating.open", _ => true);
        var cut = Render(
            @<BitBhListbox TValue="int" DefaultValue="3">
                <BitBhListboxButton TValue="int" aria-label="Count">Count</BitBhListboxButton>
                <BitBhListboxOptions TValue="int" Anchor="@("bottom start")">
                    <BitBhListboxOption TValue="int" Value="1">One</BitBhListboxOption>
                    <BitBhListboxOption TValue="int" Value="2">Two</BitBhListboxOption>
                    <BitBhListboxOption TValue="int" Value="3">Three</BitBhListboxOption>
                </BitBhListboxOptions>
            </BitBhListbox>);

        cut.Find("[role=combobox]").Press("Enter");
        Assert.AreEqual("Three", Text(ActiveOf(cut.Find("[role=combobox]"))));
        Assert.AreEqual(1, Count("floating.open"));
        Assert.AreEqual(0, Count("dom.scrollIntoView"));
        open.SetResult(1);
        cut.WaitForAssertion(() => Assert.AreEqual(1, Count("dom.scrollIntoView")));

        // Home / End while closed: the same.
        cut.Find("[role=combobox]").Press("Escape");
        var reopen = module.Setup<int>("floating.open", _ => true);
        cut.Find("[role=combobox]").Press("End");
        Assert.AreEqual("Three", Text(ActiveOf(cut.Find("[role=combobox]"))));
        Assert.AreEqual(1, Count("dom.scrollIntoView"));
        reopen.SetResult(2);
        cut.WaitForAssertion(() => Assert.AreEqual(2, Count("dom.scrollIntoView")));
    }

    [TestMethod]
    public void Unmounted_options_still_name_the_selection_and_Home_End_highlight_after_opening()
    {
        var cut = Render(
            @<BitBhListbox TValue="string">
                <BitBhListboxButton TValue="string" aria-label="Fruit" Placeholder="Pick" />
                <BitBhListboxOptions TValue="string" Unmount="true">
                    <BitBhListboxOption TValue="string" Value="@("a")">Apple</BitBhListboxOption>
                    <BitBhListboxOption TValue="string" Value="@("b")">Banana</BitBhListboxOption>
                </BitBhListboxOptions>
            </BitBhListbox>);
        Assert.IsEmpty(cut.FindAll("[role=option]"));
        Assert.AreEqual("Pick", cut.Find("[role=combobox]").TextContent);

        // The options mount as the panel opens: End highlights the last one once they are there.
        cut.Find("[role=combobox]").Press("End");
        Assert.AreEqual("Banana", Text(ActiveOf(cut.Find("[role=combobox]"))));

        cut.Find("[role=combobox]").Press("Enter");
        Assert.IsEmpty(cut.FindAll("[role=option]"));
        Assert.AreEqual("Banana", cut.Find("[role=combobox]").TextContent);

        cut.Find("[role=combobox]").Press("Home");
        Assert.AreEqual("Apple", Text(ActiveOf(cut.Find("[role=combobox]"))));
    }

    [TestMethod]
    public void A_selection_whose_unmounted_options_never_rendered_is_named_by_ValueText()
    {
        var cut = Render(
            @<BitBhListbox TValue="string" DefaultValue="@("b")" ValueText="@(v => v == "b" ? "Banana" : v)">
                <BitBhListboxButton TValue="string" aria-label="Fruit" Placeholder="Pick" />
                <BitBhListboxOptions TValue="string" Unmount="true">
                    <BitBhListboxOption TValue="string" Value="@("a")">Apple</BitBhListboxOption>
                    <BitBhListboxOption TValue="string" Value="@("b")">Banana</BitBhListboxOption>
                </BitBhListboxOptions>
            </BitBhListbox>);

        // Nothing rendered an option yet, but something is selected: the placeholder would say otherwise.
        Assert.IsEmpty(cut.FindAll("[role=option]"));
        Assert.AreEqual("Banana", cut.Find("[role=combobox]").TextContent);
    }

