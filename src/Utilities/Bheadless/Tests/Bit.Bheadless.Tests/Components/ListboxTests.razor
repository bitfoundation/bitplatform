    [TestMethod]
    public void A_value_type_listbox_without_a_default_selects_nothing()
    {
        // default(int) is 0, an option value: only a supplied DefaultValue selects.
        var cut = Render(
            @<BitBhListbox TValue="int" Name="count">
                <BitBhListboxButton TValue="int" aria-label="Count" Placeholder="Pick" />
                <BitBhListboxOptions TValue="int">
                    <BitBhListboxOption TValue="int" Value="0" Label="Zero">Zero</BitBhListboxOption>
                    <BitBhListboxOption TValue="int" Value="1" Label="One">One</BitBhListboxOption>
                </BitBhListboxOptions>
            </BitBhListbox>);

        Assert.AreEqual("Pick", cut.Find("[role=combobox]").TextContent);
        Assert.IsEmpty(cut.FindAll("input[type=hidden]"));
        foreach (var option in cut.FindAll("[role=option]")) Assert.AreEqual("false", option.GetAttribute("aria-selected"));
    }

    [TestMethod]
    public void Hidden_input_posts_culture_invariant_values_and_nothing_while_disabled()
    {
        var culture = CultureInfo.CurrentCulture;
        CultureInfo.CurrentCulture = new CultureInfo("de-DE");
        try
        {
            var cut = Render(
                @<div>
                    <BitBhListbox TValue="double" DefaultValue="1.5" Name="ratio">
                        <BitBhListboxButton TValue="double" aria-label="Ratio" />
                        <BitBhListboxOptions TValue="double">
                            <BitBhListboxOption TValue="double" Value="1.5">1.5</BitBhListboxOption>
                        </BitBhListboxOptions>
                    </BitBhListbox>
                    <BitBhListbox TValue="double" DefaultValue="2.5" Name="locked" Disabled="true">
                        <BitBhListboxButton TValue="double" aria-label="Locked" />
                        <BitBhListboxOptions TValue="double">
                            <BitBhListboxOption TValue="double" Value="2.5">2.5</BitBhListboxOption>
                        </BitBhListboxOptions>
                    </BitBhListbox>
                </div>);

            Assert.AreEqual("1.5", cut.Find("input[type=hidden][name=ratio]").GetAttribute("value"));
            // Like a native disabled control, a disabled listbox posts nothing.
            Assert.IsEmpty(cut.FindAll("input[type=hidden][name=locked]"));
        }
        finally
        {
            CultureInfo.CurrentCulture = culture;
        }
    }

    [TestMethod]
    public void Tab_accepts_the_highlighted_option()
    {
        var cut = Render(
            @<Stateful T="string" Context="s">
                <BitBhListbox TValue="string" Value="s.Value" ValueChanged="s.Set">
                    <BitBhListboxButton TValue="string" aria-label="Person" />
                    <BitBhListboxOptions TValue="string">
                        <BitBhListboxOption TValue="string" Value="@("ada")">Ada</BitBhListboxOption>
                        <BitBhListboxOption TValue="string" Value="@("cy")">Cy</BitBhListboxOption>
                    </BitBhListboxOptions>
                </BitBhListbox>
            </Stateful>);

        cut.Find("[role=combobox]").PressSequence("ArrowDown", "ArrowDown");
        cut.Find("[role=combobox]").Press("Tab");
        // Select-only combobox (APG): Tab selects the highlighted option, then focus moves on.
        Assert.AreEqual("cy", cut.FindComponent<Stateful<string>>().Instance.Value);
        Assert.AreEqual("false", cut.Find("[role=combobox]").GetAttribute("aria-expanded"));
    }

    [TestMethod]
    public async Task Alt_ArrowUp_does_not_choose_a_highlighted_option_that_became_disabled()
    {
        var chosen = new List<string?>();
        var cut = Render(
            @<Stateful T="bool" Context="s">
                <BitBhListbox TValue="string" ValueChanged="v => chosen.Add(v)">
                    <BitBhListboxButton TValue="string" aria-label="Person">Person</BitBhListboxButton>
                    <BitBhListboxOptions TValue="string">
                        <BitBhListboxOption TValue="string" Value="@("ada")" Disabled="s.Value">Ada</BitBhListboxOption>
                        <BitBhListboxOption TValue="string" Value="@("cy")">Cy</BitBhListboxOption>
                    </BitBhListboxOptions>
                </BitBhListbox>
            </Stateful>);

        cut.Find("[role=combobox]").Press("ArrowDown");
        Assert.AreEqual("Ada", Text(ActiveOf(cut.Find("[role=combobox]"))));
        await cut.InvokeAsync(() => cut.FindComponent<Stateful<bool>>().Instance.Set(true));

        cut.Find("[role=combobox]").Press("ArrowUp", alt: true);
        Assert.IsEmpty(chosen);
        Assert.AreEqual("false", cut.Find("[role=combobox]").GetAttribute("aria-expanded"));
    }

    [TestMethod]
    public void Multi_select_listbox_selects_all_and_extends_with_shift()
    {
        IReadOnlyCollection<string>? values = null;
        var cut = Render(
            @<BitBhListbox TValue="string" Multiple="true" ValuesChanged="v => values = v">
                <BitBhListboxButton TValue="string" aria-label="Colours">Pick</BitBhListboxButton>
                <BitBhListboxOptions TValue="string">
                    <BitBhListboxOption TValue="string" Value="@("red")">Red</BitBhListboxOption>
                    <BitBhListboxOption TValue="string" Value="@("green")" Disabled="true">Green</BitBhListboxOption>
                    <BitBhListboxOption TValue="string" Value="@("blue")">Blue</BitBhListboxOption>
                    <BitBhListboxOption TValue="string" Value="@("cyan")">Cyan</BitBhListboxOption>
                </BitBhListboxOptions>
            </BitBhListbox>);

        cut.Find("[role=combobox]").Press("ArrowDown");
        Assert.Contains("Ctrl+a", cut.Find("[role=combobox]").GetAttribute("data-bit-bh-keys")!);
        cut.Find("[role=combobox]").Press("a", ctrl: true);
        CollectionAssert.AreEquivalent(new[] { "red", "blue", "cyan" }, values!.ToArray());
        cut.Find("[role=combobox]").Press("a", ctrl: true);
        Assert.IsEmpty(values!);

        // Shift+Down moves past the disabled option and selects what it lands on.
        cut.Find("[role=combobox]").Press("ArrowDown", shift: true);
        CollectionAssert.AreEqual(new[] { "blue" }, values!.ToArray());
        cut.Find("[role=combobox]").Press("ArrowDown", shift: true);
        CollectionAssert.AreEquivalent(new[] { "blue", "cyan" }, values!.ToArray());
    }

    [TestMethod]
    public void A_key_pressed_while_the_opening_click_is_still_focusing_the_button_is_kept()
    {
        // Over a Blazor Server connection a key pressed right after the click (End) arrives while the click's focus
        // call is still in flight - held here. The click toggles from the state it saw, before that call: otherwise the
        // key opened the panel and the click, once its focus landed, closed it again.
        var module = JSInterop.SetupModule(BitBhInterop.ModulePath);
        var focus = module.Setup<bool>("focus.focus", _ => true);
        var cut = Render(
            @<BitBhListbox TValue="int">
                <BitBhListboxButton TValue="int" aria-label="Count">Count</BitBhListboxButton>
                <BitBhListboxOptions TValue="int">
                    <BitBhListboxOption TValue="int" Value="1">One</BitBhListboxOption>
                    <BitBhListboxOption TValue="int" Value="2">Two</BitBhListboxOption>
                    <BitBhListboxOption TValue="int" Value="3">Three</BitBhListboxOption>
                </BitBhListboxOptions>
            </BitBhListbox>);

        cut.Find("[role=combobox]").Click();
        Assert.AreEqual("true", cut.Find("[role=combobox]").GetAttribute("aria-expanded"));
        cut.Find("[role=combobox]").Press("End");
        focus.SetResult(true);

        cut.WaitForAssertion(() => Assert.AreEqual("Three", Text(ActiveOf(cut.Find("[role=combobox]")))));
        Assert.AreEqual("true", cut.Find("[role=combobox]").GetAttribute("aria-expanded"));
    }

    private static readonly string[] Thousand = Enumerable.Range(1, 1000).Select(i => $"Item {i}").ToArray();

    private RenderFragment VariableListbox(bool variable = true) =>
        @<BitBhListbox TValue="string">
            <BitBhListboxButton TValue="string" aria-label="Item" Placeholder="Pick" />
            <BitBhListboxOptions TValue="string" Items="Thousand" Virtualize="true" VariableItemSize="variable" ItemSize="48" Context="o">
                <ItemTemplate>@o.Value</ItemTemplate>
            </BitBhListboxOptions>
        </BitBhListbox>;

    [TestMethod]
    public void Options_of_different_heights_render_a_window_between_spacers_the_runtime_sizes()
    {
        var cut = Render(VariableListbox());
        cut.Find("[role=combobox]").Press("ArrowDown");

        var options = cut.FindAll("[role=option]");
        Assert.AreEqual(BitBhVirtualizer<string>.InitialCount, options.Count);
        Assert.AreEqual("1000", options[0].GetAttribute("aria-setsize"));
        Assert.AreEqual("20", options[19].GetAttribute("aria-posinset"));
        Assert.AreEqual("Item 1", Text(ActiveOf(cut.Find("[role=combobox]"))));

        var spacers = cut.FindAll("[data-bit-bh-spacer]");
        Assert.AreEqual(2, spacers.Count);
        Assert.AreEqual("LI", spacers[0].TagName);
        Assert.AreEqual("0 20 1000 1", spacers[0].GetAttribute("data-bit-bh-range"));
        // Sized by the runtime through the CSSOM: no inline style attribute, which a strict style-src would refuse.
        Assert.IsTrue(spacers.All(s => s.GetAttribute("aria-hidden") == "true" && !s.HasAttribute("style")));

        var attach = JSInterop.Invocations.Single(i => i.Identifier == "dom.attachVirtualList");
        Assert.AreEqual(48f, attach.Arguments[3]);
        Assert.AreEqual(5, attach.Arguments[4]);
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public async Task The_runtime_moves_the_window_and_the_keys_reach_every_option_of_different_heights()
    {
        var cut = Render(VariableListbox());
        cut.Find("[role=combobox]").Press("ArrowDown");
        var virtualizer = cut.FindComponent<BitBhVirtualizer<string>>().Instance;

        await cut.InvokeAsync(() => virtualizer.SetRange(500, 512, 1));
        var options = cut.FindAll("[role=option]");
        Assert.AreEqual(12, options.Count);
        Assert.AreEqual("501", options[0].GetAttribute("aria-posinset"));
        Assert.AreEqual("500 512 1000 1", cut.Find("[data-bit-bh-spacer=before]").GetAttribute("data-bit-bh-range"));

        // A request made for a list since replaced is dropped; one past the end is clamped.
        await cut.InvokeAsync(() => virtualizer.SetRange(0, 10, 0));
        Assert.AreEqual("501", cut.FindAll("[role=option]")[0].GetAttribute("aria-posinset"));
        await cut.InvokeAsync(() => virtualizer.SetRange(995, 2000, 1));
        Assert.AreEqual("995 1000 1000 1", cut.Find("[data-bit-bh-spacer=before]").GetAttribute("data-bit-bh-range"));

        // End highlights the last of the 1,000 and asks the runtime to reveal it - fully, once it has rendered.
        cut.Find("[role=combobox]").Press("End");
        Assert.AreEqual(cut.Find("[role=listbox]").Id + "-o999", cut.Find("[role=combobox]").GetAttribute("aria-activedescendant"));
        var reveal = JSInterop.Invocations.Last(i => i.Identifier == "dom.scrollToIndex");
        Assert.AreEqual(cut.Find("[role=listbox]").Id, reveal.Arguments[0]);
        Assert.AreEqual(999, reveal.Arguments[1]);
        Assert.AreEqual(48f, reveal.Arguments[2]);
    }

    [TestMethod]
    public void Options_of_one_height_keep_Blazors_virtualization()
    {
        var cut = Render(VariableListbox(variable: false));
        cut.Find("[role=combobox]").Press("ArrowDown");
        Assert.IsEmpty(cut.FindAll("[data-bit-bh-spacer]"));
        Assert.IsEmpty(JSInterop.Invocations.Where(i => i.Identifier == "dom.attachVirtualList"));
        Assert.AreEqual("Item 1", Text(ActiveOf(cut.Find("[role=combobox]"))));
    }
}
