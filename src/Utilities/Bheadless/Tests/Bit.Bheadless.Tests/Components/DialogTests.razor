@inherits TestBase
@attribute [TestClass]

@code {
    [TestMethod]
    public void Closed_dialog_renders_nothing()
    {
        var cut = Render(@<BitBhDialog Open="false"><BitBhDialogPanel>Hi</BitBhDialogPanel></BitBhDialog>);
        Assert.IsEmpty(cut.FindAll("[role=dialog]"));
    }

    [TestMethod]
    public void Open_dialog_is_labelled_by_its_title_only_when_present()
    {
        var cut = Render(
            @<BitBhDialog Open="true">
                <BitBhDialogBackdrop />
                <BitBhDialogPanel>
                    <BitBhDialogTitle>Delete file</BitBhDialogTitle>
                    <button>OK</button>
                </BitBhDialogPanel>
            </BitBhDialog>);

        var dialog = cut.Find("[role=dialog]");
        Assert.AreEqual("true", dialog.GetAttribute("aria-modal"));
        Assert.AreEqual("Delete file", dialog.AccessibleName());
        // No description rendered → no dangling aria-describedby.
        Assert.IsNull(dialog.GetAttribute("aria-describedby"));
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void Escape_and_backdrop_click_close_the_dialog()
    {
        var open = true;
        var closed = 0;
        var cut = Render(
            @<BitBhDialog @bind-Open="open" OnClose="() => closed++">
                <BitBhDialogBackdrop />
                <BitBhDialogPanel aria-label="Settings"><button>OK</button></BitBhDialogPanel>
            </BitBhDialog>);

        cut.Find("[role=dialog]").Press("Escape");
        Assert.IsFalse(open);
        Assert.AreEqual(1, closed);

        open = true;
        cut.Render();
        cut.Find("[aria-hidden=true]").Click();
        Assert.IsFalse(open);
    }

    [TestMethod]
    public void Dismissal_can_be_cancelled()
    {
        var open = true;
        var cut = Render(
            @<BitBhDialog @bind-Open="open" OnDismissRequest="r => r.Cancel = true">
                <BitBhDialogPanel aria-label="Unsaved changes"><button>OK</button></BitBhDialogPanel>
            </BitBhDialog>);
        cut.Find("[role=dialog]").Press("Escape");
        Assert.IsTrue(open);
    }

    [TestMethod]
    public void CloseButton_closes_the_nearest_dialog()
    {
        var open = true;
        var cut = Render(
            @<BitBhDialog @bind-Open="open">
                <BitBhDialogPanel aria-label="Info"><BitBhCloseButton>Close</BitBhCloseButton></BitBhDialogPanel>
            </BitBhDialog>);
        cut.Find("button").Click();
        Assert.IsFalse(open);
    }

    [TestMethod]
    public void Alert_dialog_has_its_role_and_opens_from_its_trigger()
    {
        var acted = false;
        var cut = Render(
            @<BitBhAlertDialog>
                <BitBhAlertDialogTrigger>Delete account</BitBhAlertDialogTrigger>
                <BitBhAlertDialogOverlay />
                <BitBhAlertDialogContent>
                    <BitBhAlertDialogTitle>Are you sure?</BitBhAlertDialogTitle>
                    <BitBhAlertDialogDescription>This cannot be undone.</BitBhAlertDialogDescription>
                    <BitBhAlertDialogCancel>Cancel</BitBhAlertDialogCancel>
                    <BitBhAlertDialogAction OnClick="() => acted = true">Delete</BitBhAlertDialogAction>
                </BitBhAlertDialogContent>
            </BitBhAlertDialog>);

        Assert.IsEmpty(cut.FindAll("[role=alertdialog]"));
        cut.Find("button[aria-haspopup=dialog]").Click();

        var dialog = cut.Find("[role=alertdialog]");
        Assert.AreEqual("Are you sure?", dialog.AccessibleName());
        Assert.AreEqual("This cannot be undone.", dialog.AccessibleDescription());
        cut.ShouldBeAccessible();

        cut.FindAll("[role=alertdialog] button")[1].Click();
        Assert.IsTrue(acted);
        Assert.AreEqual("false", cut.Find("button[aria-haspopup=dialog]").GetAttribute("aria-expanded"));
    }
    private ElementReference _confirm;

    [TestMethod]
    public async Task InitialFocus_reaches_the_runtime_on_every_open()
    {
        var cut = Render(
            @<Stateful T="bool" Context="s">
                <BitBhDialog Open="s.Value">
                    <BitBhDialogPanel aria-label="Delete file" InitialFocus="() => _confirm">
                        <button>Cancel</button>
                        <button @ref="_confirm">Delete</button>
                    </BitBhDialogPanel>
                </BitBhDialog>
            </Stateful>);
        var host = cut.FindComponent<Stateful<bool>>().Instance;

        // The button gets its reference while the panel renders, after the panel's parameters were set: what the
        // runtime is asked to focus is read once the open dialog has rendered.
        await cut.InvokeAsync(() => host.Set(true));
        var first = AutoFocusOfOpen(cut, 1);
        Assert.IsNotNull(first.Id);
        Assert.AreEqual(_confirm.Id, first.Id);

        // The content is removed while closed: the next open focuses the new button, not the removed one.
        await cut.InvokeAsync(() => host.Set(false));
        cut.WaitForAssertion(() => Assert.IsEmpty(cut.FindAll("[role=dialog]")));
        await cut.InvokeAsync(() => host.Set(true));
        var second = AutoFocusOfOpen(cut, 2);
        Assert.AreEqual(_confirm.Id, second.Id);
        Assert.AreNotEqual(first.Id, second.Id);
    }

    // The open is sent after the render, through the renderer's queue.
    private ElementReference AutoFocusOfOpen(IRenderedComponent<Bunit.Rendering.ContainerFragment> cut, int open)
    {
        cut.WaitForAssertion(() => Assert.HasCount(open, JSInterop.Invocations["floating.open"]));
        var options = (IDictionary<string, object?>)JSInterop.Invocations["floating.open"][open - 1].Arguments[2]!;
        return (ElementReference)((IDictionary<string, object?>)options["focus"]!)["autoFocus"]!;
    }

    [TestMethod]
    public void A_CloseButton_rendered_as_a_link_stays_a_link()
    {
        var open = true;
        var cut = Render(
            @<BitBhDialog @bind-Open="open">
                <BitBhDialogPanel aria-label="Info">
                    <BitBhCloseButton As="a" href="/docs">Read the docs</BitBhCloseButton>
                    <BitBhCloseButton As="a">Close</BitBhCloseButton>
                </BitBhDialogPanel>
            </BitBhDialog>);

        // A link with an href is focusable, activates with Enter and is announced as a link by itself.
        var link = cut.Find("a[href]");
        Assert.IsNull(link.GetAttribute("role"));
        Assert.IsNull(link.GetAttribute("tabindex"));
        Assert.IsNull(link.GetAttribute("data-bit-bh-keys"));
        // Without one it is no link: it is made a button.
        var bare = cut.Find("a:not([href])");
        Assert.AreEqual("button", bare.GetAttribute("role"));
        Assert.AreEqual("0", bare.GetAttribute("tabindex"));

        link.Click();
        Assert.IsFalse(open);
    }

    [TestMethod]
    public void Nested_dialogs_mark_themselves_and_the_dialog_behind()
    {
        var cut = Render(
            @<BitBhDialog DefaultOpen="true" Portal="false" class="outer">
                <BitBhDialogPanel class="outer-panel">
                    <BitBhDialogTitle>Settings</BitBhDialogTitle>
                    <BitBhDialog DefaultOpen="true" Portal="false" class="inner">
                        <BitBhDialogPanel class="inner-panel"><BitBhDialogTitle>Confirm</BitBhDialogTitle></BitBhDialogPanel>
                    </BitBhDialog>
                </BitBhDialogPanel>
            </BitBhDialog>);

        Assert.IsTrue(cut.Find(".inner").HasAttribute("data-nested"));
        Assert.IsTrue(cut.Find(".inner-panel").HasAttribute("data-nested"));
        Assert.IsFalse(cut.Find(".outer").HasAttribute("data-nested"));
        cut.WaitForAssertion(() => Assert.IsTrue(cut.Find(".outer-panel").HasAttribute("data-nested-dialog-open")));
        Assert.Contains("--bit-bh-nested-dialogs:1", cut.Find(".outer").GetAttribute("style")!);
    }
}
