@inherits TestBase
@attribute [TestClass]
@using Microsoft.JSInterop

@code {
    private RenderFragment Sheet(BitBhDrawerSide side = BitBhDrawerSide.Bottom, bool modal = true, bool swipe = true,
                                 Action<BitBhDismissRequest>? onDismiss = null) =>
        @<BitBhDrawer Side="side" Modal="modal" DismissOnSwipe="swipe" OnDismissRequest="@(r => onDismiss?.Invoke(r))">
            <BitBhDrawerTrigger>Filters</BitBhDrawerTrigger>
            <BitBhDrawerBackdrop />
            <BitBhDrawerPanel>
                <BitBhDrawerHandle />
                <BitBhDrawerTitle>Filters</BitBhDrawerTitle>
                <BitBhDrawerDescription>Narrow the results.</BitBhDrawerDescription>
                <label>Search <input /></label>
                <BitBhDrawerClose>Done</BitBhDrawerClose>
            </BitBhDrawerPanel>
        </BitBhDrawer>;

    private static AngleSharp.Dom.IElement TriggerOf(IRenderedComponent<Bunit.Rendering.ContainerFragment> cut)
        => cut.Find("button[aria-haspopup=dialog]");

    private IDictionary<string, object?> LastOpenOptions()
        => (IDictionary<string, object?>)JSInterop.Invocations["floating.open"].Last().Arguments[2]!;

    private BunitJSModuleInterop Module()
    {
        var module = JSInterop.SetupModule(BitBhInterop.ModulePath);
        module.Mode = JSRuntimeMode.Loose;
        return module;
    }

    // The drawer's swipe callbacks are a private type: call them the way the runtime does, by name.
    private static async Task<bool> SwipeDismissAsync(IRenderedComponent<Bunit.Rendering.ContainerFragment> cut, JSRuntimeInvocation attach)
    {
        var reference = attach.Arguments[0]!;
        var callbacks = reference.GetType().GetProperty("Value")!.GetValue(reference)!;
        var method = callbacks.GetType().GetMethod("OnSwipeDismiss")!;
        return await cut.InvokeAsync(() => (Task<bool>)method.Invoke(callbacks, null)!);
    }

    [TestMethod]
    public void A_closed_drawer_renders_its_trigger_only()
    {
        var cut = Render(Sheet());
        var trigger = TriggerOf(cut);
        Assert.AreEqual("false", trigger.GetAttribute("aria-expanded"));
        Assert.IsNull(trigger.GetAttribute("aria-controls"));
        Assert.AreEqual("bottom", trigger.GetAttribute("data-side"));
        Assert.IsEmpty(cut.FindAll("[role=dialog]"));
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void The_open_drawer_is_a_modal_dialog_named_by_its_title()
    {
        var cut = Render(Sheet());
        TriggerOf(cut).Click();

        var panel = cut.Find("[role=dialog]");
        Assert.AreEqual("true", panel.GetAttribute("aria-modal"));
        Assert.AreEqual("Filters", panel.AccessibleName());
        Assert.AreEqual("Narrow the results.", panel.AccessibleDescription());
        Assert.AreEqual("-1", panel.GetAttribute("tabindex"));
        Assert.AreEqual("open", panel.GetAttribute("data-state"));
        Assert.AreEqual("bottom", panel.GetAttribute("data-side"));
        Assert.AreEqual("true", TriggerOf(cut).GetAttribute("aria-expanded"));
        Assert.AreEqual(panel.Id, TriggerOf(cut).GetAttribute("aria-controls"));

        var handle = cut.Find("[data-bit-bh-drawer-handle]");
        Assert.AreEqual("true", handle.GetAttribute("aria-hidden"));
        Assert.Contains("touch-action:none", handle.GetAttribute("style")!);
        cut.ShouldBeAccessible();

        // Dialog machinery: a trap, an inert page with its scroll locked, focus back to the trigger.
        cut.WaitForAssertion(() => Assert.IsNotEmpty(JSInterop.Invocations["floating.open"]));
        var options = LastOpenOptions();
        var modal = (IDictionary<string, object?>)options["modal"]!;
        Assert.IsTrue((bool)modal["hideOthers"]!);
        var focus = (IDictionary<string, object?>)options["focus"]!;
        Assert.IsTrue((bool)focus["trap"]!);
        Assert.AreEqual(TriggerOf(cut).Id, focus["returnFocusId"]);
        var surfaces = (string?[])options["portalIds"]!;
        CollectionAssert.AreEqual(new[] { cut.Find("[data-bit-bh-dismiss-ignore]").Id, panel.Id }, surfaces);
    }

    [TestMethod]
    public void Escape_the_backdrop_and_the_close_buttons_close_it()
    {
        var open = true;
        var cut = Render(
            @<BitBhDrawer @bind-Open="open">
                <BitBhDrawerBackdrop />
                <BitBhDrawerPanel aria-label="Cart">
                    <BitBhDrawerClose>Done</BitBhDrawerClose>
                    <BitBhCloseButton>Close</BitBhCloseButton>
                </BitBhDrawerPanel>
            </BitBhDrawer>);

        cut.Find("[role=dialog]").Press("Escape");
        Assert.IsFalse(open);

        open = true;
        cut.Render();
        cut.Find("[aria-hidden=true]").Click();
        Assert.IsFalse(open);

        open = true;
        cut.Render();
        cut.FindAll("[role=dialog] button")[0].Click();
        Assert.IsFalse(open);

        open = true;
        cut.Render();
        cut.FindAll("[role=dialog] button")[1].Click();
        Assert.IsFalse(open);
    }

    [TestMethod]
    public void Dismissal_can_be_turned_off_or_cancelled()
    {
        var open = true;
        var cut = Render(
            @<BitBhDrawer @bind-Open="open" DismissOnEscape="false" DismissOnOutsideClick="false">
                <BitBhDrawerBackdrop />
                <BitBhDrawerPanel aria-label="Terms"><BitBhDrawerClose>Accept</BitBhDrawerClose></BitBhDrawerPanel>
            </BitBhDrawer>);
        cut.Find("[role=dialog]").Press("Escape");
        cut.Find("[aria-hidden=true]").Click();
        Assert.IsTrue(open);

        var reasons = new List<BitBhDismissReason>();
        var cancelled = Render(Sheet(onDismiss: r => { reasons.Add(r.Reason); r.Cancel = true; }));
        TriggerOf(cancelled).Click();
        cancelled.Find("[role=dialog]").Press("Escape");
        Assert.AreEqual("true", TriggerOf(cancelled).GetAttribute("aria-expanded"));
        CollectionAssert.AreEqual(new[] { BitBhDismissReason.EscapeKey }, reasons);
    }

    [TestMethod]
    public async Task Controlled_open_follows_its_owner()
    {
        var changes = new List<bool>();
        var cut = Render(
            @<Stateful T="bool" Context="s">
                <BitBhDrawer Open="s.Value" OpenChanged="v => changes.Add(v)">
                    <BitBhDrawerTrigger>Menu</BitBhDrawerTrigger>
                    <BitBhDrawerPanel aria-label="Menu"><a href="#home">Home</a></BitBhDrawerPanel>
                </BitBhDrawer>
            </Stateful>);
        var host = cut.FindComponent<Stateful<bool>>().Instance;

        TriggerOf(cut).Click();
        CollectionAssert.AreEqual(new[] { true }, changes);
        Assert.IsEmpty(cut.FindAll("[role=dialog]"));

        await cut.InvokeAsync(() => host.Set(true));
        Assert.HasCount(1, cut.FindAll("[role=dialog]"));
        await cut.InvokeAsync(() => host.Set(false));
        cut.WaitForAssertion(() => Assert.IsEmpty(cut.FindAll("[role=dialog]")));
    }

    [TestMethod]
    public void Start_and_end_follow_the_reading_direction()
    {
        var cut = Render(
            @<BitBhDirectionProvider Dir="BitBhDirection.Rtl">
                <BitBhDrawer DefaultOpen="true" Side="BitBhDrawerSide.Start">
                    <BitBhDrawerPanel aria-label="Navigation">…</BitBhDrawerPanel>
                </BitBhDrawer>
                <BitBhDrawer DefaultOpen="true" Side="BitBhDrawerSide.End" Dir="BitBhDirection.Ltr">
                    <BitBhDrawerPanel aria-label="Details">…</BitBhDrawerPanel>
                </BitBhDrawer>
                <BitBhDrawer DefaultOpen="true" Side="BitBhDrawerSide.Top">
                    <BitBhDrawerPanel aria-label="Search">…</BitBhDrawerPanel>
                </BitBhDrawer>
            </BitBhDirectionProvider>);

        var panels = cut.FindAll("[role=dialog]");
        Assert.AreEqual("right", panels[0].GetAttribute("data-side"));
        Assert.Contains("right:0", panels[0].GetAttribute("style")!);
        Assert.AreEqual("right", panels[1].GetAttribute("data-side"));
        Assert.AreEqual("top", panels[2].GetAttribute("data-side"));
        Assert.Contains("top:0", panels[2].GetAttribute("style")!);
    }

    [TestMethod]
    public async Task A_swipe_past_the_threshold_dismisses_it()
    {
        var module = Module();
        module.Setup<int>("drawer.attach", _ => true).SetResult(5);
        var reasons = new List<BitBhDismissReason>();
        var cut = Render(Sheet(side: BitBhDrawerSide.Left, onDismiss: r => reasons.Add(r.Reason)));
        TriggerOf(cut).Click();

        cut.WaitForAssertion(() => Assert.IsNotEmpty(JSInterop.Invocations["drawer.attach"]));
        var attach = JSInterop.Invocations["drawer.attach"].Last();
        Assert.AreEqual(cut.Find("[role=dialog]").Id, attach.Arguments[1]);
        var options = (IDictionary<string, object?>)attach.Arguments[2]!;
        Assert.AreEqual("left", options["side"]);
        Assert.AreEqual(0.25, options["threshold"]);
        Assert.AreEqual(cut.Find("[data-bit-bh-dismiss-ignore]").Id, options["backdropId"]);
        Assert.IsTrue((bool)options["enabled"]!);

        Assert.IsTrue(await SwipeDismissAsync(cut, attach));
        CollectionAssert.AreEqual(new[] { BitBhDismissReason.Swipe }, reasons);
        Assert.AreEqual("false", TriggerOf(cut).GetAttribute("aria-expanded"));
        // Closed: the runtime stops following drags.
        cut.WaitForAssertion(() => Assert.AreEqual(5, JSInterop.Invocations["drawer.detach"].Last().Arguments[0]));
    }

    [TestMethod]
    public async Task A_declined_swipe_leaves_the_drawer_open()
    {
        var module = Module();
        module.Setup<int>("drawer.attach", _ => true).SetResult(3);
        var cut = Render(Sheet(swipe: false));
        TriggerOf(cut).Click();
        cut.WaitForAssertion(() => Assert.IsNotEmpty(JSInterop.Invocations["drawer.attach"]));
        var attach = JSInterop.Invocations["drawer.attach"].Last();
        Assert.IsFalse((bool)((IDictionary<string, object?>)attach.Arguments[2]!)["enabled"]!);

        // The runtime is told the drawer stays: the panel settles back.
        Assert.IsFalse(await SwipeDismissAsync(cut, attach));
        Assert.AreEqual("true", TriggerOf(cut).GetAttribute("aria-expanded"));

        var cancelling = Render(Sheet(onDismiss: r => r.Cancel = true));
        TriggerOf(cancelling).Click();
        cancelling.WaitForAssertion(() => Assert.HasCount(2, JSInterop.Invocations["drawer.attach"]));
        Assert.IsFalse(await SwipeDismissAsync(cancelling, JSInterop.Invocations["drawer.attach"].Last()));
        Assert.AreEqual("true", TriggerOf(cancelling).GetAttribute("aria-expanded"));
    }

    [TestMethod]
    public void A_non_modal_drawer_leaves_the_page_usable_and_its_trigger_toggles_it()
    {
        var cut = Render(Sheet(side: BitBhDrawerSide.Right, modal: false));
        TriggerOf(cut).Click();

        Assert.IsNull(cut.Find("[role=dialog]").GetAttribute("aria-modal"));
        cut.WaitForAssertion(() => Assert.IsNotEmpty(JSInterop.Invocations["floating.open"]));
        var options = LastOpenOptions();
        Assert.IsNull(options["modal"]);
        Assert.IsFalse((bool)((IDictionary<string, object?>)options["focus"]!)["trap"]!);
        var layer = (IDictionary<string, object?>)options["layer"]!;
        Assert.Contains(TriggerOf(cut).Id, (string?[])layer["ids"]!);

        TriggerOf(cut).Click();
        Assert.AreEqual("false", TriggerOf(cut).GetAttribute("aria-expanded"));
    }

    [TestMethod]
    public void A_drawer_opened_from_another_marks_both()
    {
        var cut = Render(
            @<BitBhDrawer DefaultOpen="true">
                <BitBhDrawerPanel aria-label="Settings">
                    <BitBhDrawer>
                        <BitBhDrawerTrigger>Advanced</BitBhDrawerTrigger>
                        <BitBhDrawerPanel aria-label="Advanced settings">…</BitBhDrawerPanel>
                    </BitBhDrawer>
                </BitBhDrawerPanel>
            </BitBhDrawer>);

        Assert.IsNull(cut.Find("[aria-label=Settings]").GetAttribute("data-nested-drawer-open"));
        TriggerOf(cut).Click();

        cut.WaitForAssertion(() => Assert.IsTrue(cut.Find("[aria-label=Settings]").HasAttribute("data-nested-drawer-open")));
        Assert.Contains("--bit-bh-nested-drawers:1", cut.Find("[aria-label=Settings]").GetAttribute("style")!);
        Assert.IsTrue(cut.Find("[aria-label='Advanced settings']").HasAttribute("data-nested"));
        cut.ShouldBeAccessible();
    }

    // ── Snap points ──────────────────────────────────────────────────────────

    private static readonly BitBhDrawerSnapPoint[] Points = ["160px", 0.5, 1];

    private static AngleSharp.Dom.IElement HandleOf(IRenderedComponent<Bunit.Rendering.ContainerFragment> cut)
        => cut.Find("[data-bit-bh-drawer-handle]");

    private static async Task<int> SnapPointChangeAsync(IRenderedComponent<Bunit.Rendering.ContainerFragment> cut, JSRuntimeInvocation attach, int index)
    {
        var reference = attach.Arguments[0]!;
        var callbacks = reference.GetType().GetProperty("Value")!.GetValue(reference)!;
        var method = callbacks.GetType().GetMethod("OnSnapPointChange")!;
        return await cut.InvokeAsync(() => (Task<int>)method.Invoke(callbacks, [index])!);
    }

    [TestMethod]
    public void Snap_point_values_parse_compare_and_print_invariantly()
    {
        Assert.AreEqual(BitBhDrawerSnapPoint.Fraction(0.5), BitBhDrawerSnapPoint.Parse("50%"));
        BitBhDrawerSnapPoint fromNumber = 0.5, fromText = "0.5", fromPixels = "160px";
        Assert.AreEqual(fromNumber, fromText);
        Assert.AreEqual(BitBhDrawerSnapPoint.Pixels(160), fromPixels);
        Assert.AreNotEqual(BitBhDrawerSnapPoint.Pixels(1), BitBhDrawerSnapPoint.Fraction(1));
        Assert.AreEqual("160px", ((BitBhDrawerSnapPoint)" 160 PX ").ToString());
        Assert.AreEqual("0.25", ((BitBhDrawerSnapPoint)0.25).ToString());
        Assert.IsTrue(((BitBhDrawerSnapPoint)"12.5px").IsPixels);
        Assert.AreEqual(12.5, ((BitBhDrawerSnapPoint)"12.5px").Value);
        Assert.ThrowsExactly<FormatException>(() => BitBhDrawerSnapPoint.Parse("half"));
        Assert.ThrowsExactly<FormatException>(() => BitBhDrawerSnapPoint.Parse("1rem"));
    }

    [TestMethod]
    public void A_drawer_with_snap_points_rests_at_the_first_and_its_handle_is_a_slider()
    {
        Module().Setup<int>("drawer.attach", _ => true).SetResult(4);
        var cut = Render(
            @<BitBhDrawer SnapPoints="Points">
                <BitBhDrawerTrigger>Filters</BitBhDrawerTrigger>
                <BitBhDrawerBackdrop />
                <BitBhDrawerPanel class="sheet">
                    <BitBhDrawerHandle />
                    <BitBhDrawerTitle>Filters</BitBhDrawerTitle>
                    <BitBhDrawerClose>Done</BitBhDrawerClose>
                </BitBhDrawerPanel>
            </BitBhDrawer>);
        TriggerOf(cut).Click();

        var panel = cut.Find("[role=dialog]");
        Assert.AreEqual("160px", panel.GetAttribute("data-snap-point"));
        Assert.AreEqual("160px", cut.Find("[data-bit-bh-dismiss-ignore]").GetAttribute("data-snap-point"));
        // Never a style attribute: the runtime places the panel (CSP-safe).
        Assert.IsNull(panel.GetAttribute("style"));

        var handle = HandleOf(cut);
        Assert.AreEqual("slider", handle.GetAttribute("role"));
        Assert.IsNull(handle.GetAttribute("aria-hidden"));
        Assert.AreEqual("0", handle.GetAttribute("tabindex"));
        Assert.AreEqual("Drawer size", handle.AccessibleName());
        Assert.AreEqual("vertical", handle.GetAttribute("aria-orientation"));
        Assert.AreEqual("1", handle.GetAttribute("aria-valuemin"));
        Assert.AreEqual("3", handle.GetAttribute("aria-valuemax"));
        Assert.AreEqual("1", handle.GetAttribute("aria-valuenow"));
        Assert.AreEqual("1 of 3", handle.GetAttribute("aria-valuetext"));
        Assert.AreEqual(panel.Id, handle.GetAttribute("aria-controls"));
        Assert.AreEqual("160px", handle.GetAttribute("data-snap-point"));
        Assert.AreEqual("ArrowUp ArrowDown Home End Enter Space", handle.GetAttribute(BitBhKeyboard.KeysAttribute));
        cut.ShouldBeAccessible();

        cut.WaitForAssertion(() => Assert.IsNotEmpty(JSInterop.Invocations["drawer.attach"]));
        var options = (IDictionary<string, object?>)JSInterop.Invocations["drawer.attach"].Last().Arguments[2]!;
        CollectionAssert.AreEqual(new[] { "160px", "0.5", "1" }, (string[])options["snapPoints"]!);
        Assert.AreEqual(0, options["activeSnapPoint"]);
        Assert.AreEqual(0, options["fadeFromIndex"]);
        Assert.IsFalse((bool)options["sequential"]!);
    }

    [TestMethod]
    public void The_handle_steps_through_the_snap_points_with_the_keyboard()
    {
        var changes = new List<BitBhDrawerSnapPoint?>();
        var cut = Render(
            @<Stateful T="BitBhDrawerSnapPoint?" Context="s">
                <BitBhDrawer DefaultOpen="true" SnapPoints="Points" ActiveSnapPoint="s.Value" ActiveSnapPointChanged="s.Set"
                             OnActiveSnapPointChange="p => changes.Add(p)">
                    <BitBhDrawerPanel aria-label="Filters"><BitBhDrawerHandle /></BitBhDrawerPanel>
                </BitBhDrawer>
            </Stateful>);
        var host = cut.FindComponent<Stateful<BitBhDrawerSnapPoint?>>().Instance;

        HandleOf(cut).Press("ArrowUp");
        Assert.AreEqual((BitBhDrawerSnapPoint)0.5, host.Value);
        Assert.AreEqual("0.5", cut.Find("[role=dialog]").GetAttribute("data-snap-point"));
        Assert.AreEqual("2", HandleOf(cut).GetAttribute("aria-valuenow"));
        Assert.AreEqual("2 of 3", HandleOf(cut).GetAttribute("aria-valuetext"));

        HandleOf(cut).Press("ArrowUp");
        HandleOf(cut).Press("ArrowUp");      // already the largest
        Assert.AreEqual((BitBhDrawerSnapPoint)1, host.Value);
        HandleOf(cut).Press("ArrowDown");
        Assert.AreEqual((BitBhDrawerSnapPoint)0.5, host.Value);
        HandleOf(cut).Press("Home");
        Assert.AreEqual((BitBhDrawerSnapPoint)"160px", host.Value);
        HandleOf(cut).Press("End");
        Assert.AreEqual((BitBhDrawerSnapPoint)1, host.Value);
        // Activation cycles: from the largest back to the smallest.
        HandleOf(cut).Press("Enter");
        Assert.AreEqual((BitBhDrawerSnapPoint)"160px", host.Value);
        HandleOf(cut).Press(" ");
        Assert.AreEqual((BitBhDrawerSnapPoint)0.5, host.Value);
        // Keys across a vertical drawer's axis are left alone.
        HandleOf(cut).Press("ArrowRight");
        Assert.AreEqual((BitBhDrawerSnapPoint)0.5, host.Value);

        CollectionAssert.AreEqual(new BitBhDrawerSnapPoint?[] { 0.5, 1, 0.5, "160px", 1, "160px", 0.5 }, changes);
        Assert.AreEqual(7, host.Changes);
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void The_arrow_pointing_away_from_the_edge_opens_the_drawer_further()
    {
        var cut = Render(
            @<BitBhDirectionProvider Dir="BitBhDirection.Rtl">
                <BitBhDrawer DefaultOpen="true" Side="BitBhDrawerSide.Top" SnapPoints="Points">
                    <BitBhDrawerPanel aria-label="Search"><BitBhDrawerHandle /></BitBhDrawerPanel>
                </BitBhDrawer>
                <BitBhDrawer DefaultOpen="true" Side="BitBhDrawerSide.Left" SnapPoints="Points">
                    <BitBhDrawerPanel aria-label="Navigation"><BitBhDrawerHandle /></BitBhDrawerPanel>
                </BitBhDrawer>
                @* Start is the right edge in right-to-left. *@
                <BitBhDrawer DefaultOpen="true" Side="BitBhDrawerSide.Start" SnapPoints="Points">
                    <BitBhDrawerPanel aria-label="Details"><BitBhDrawerHandle /></BitBhDrawerPanel>
                </BitBhDrawer>
            </BitBhDirectionProvider>);

        AngleSharp.Dom.IElement Handle(int i) => cut.FindAll("[data-bit-bh-drawer-handle]")[i];
        string? Now(int i) => Handle(i).GetAttribute("aria-valuenow");

        Handle(0).Press("ArrowUp");                 // towards a top drawer's edge
        Assert.AreEqual("1", Now(0));
        Handle(0).Press("ArrowDown");
        Assert.AreEqual("2", Now(0));

        Assert.AreEqual("horizontal", Handle(1).GetAttribute("aria-orientation"));
        Assert.AreEqual("ArrowUp ArrowDown ArrowLeft ArrowRight Home End Enter Space", Handle(1).GetAttribute(BitBhKeyboard.KeysAttribute));
        Handle(1).Press("ArrowRight");
        Assert.AreEqual("2", Now(1));
        Handle(1).Press("ArrowLeft");
        Assert.AreEqual("1", Now(1));
        Handle(1).Press("ArrowUp");                 // a horizontal slider's Up still steps it up
        Assert.AreEqual("2", Now(1));

        Assert.AreEqual("right", cut.FindAll("[role=dialog]")[2].GetAttribute("data-side"));
        Handle(2).Press("ArrowLeft");
        Assert.AreEqual("2", Now(2));
        Handle(2).Press("ArrowRight");
        Assert.AreEqual("1", Now(2));
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void A_press_on_the_handle_cycles_unless_PreventCycle()
    {
        var cut = Render(
            @<div>
                <BitBhDrawer DefaultOpen="true" SnapPoints="Points">
                    <BitBhDrawerPanel aria-label="Cycling"><BitBhDrawerHandle /></BitBhDrawerPanel>
                </BitBhDrawer>
                <BitBhDrawer DefaultOpen="true" SnapPoints="Points" DefaultActiveSnapPoint="1">
                    <BitBhDrawerPanel aria-label="Fixed"><BitBhDrawerHandle PreventCycle="true" aria-label="Sheet height" /></BitBhDrawerPanel>
                </BitBhDrawer>
            </div>);
        var cycling = () => cut.FindAll("[data-bit-bh-drawer-handle]")[0];
        var fixedHandle = () => cut.FindAll("[data-bit-bh-drawer-handle]")[1];

        cycling().Click();
        Assert.AreEqual("0.5", cycling().GetAttribute("data-snap-point"));
        cycling().Click();
        cycling().Click();
        Assert.AreEqual("160px", cycling().GetAttribute("data-snap-point"));

        Assert.AreEqual("Sheet height", fixedHandle().AccessibleName());
        Assert.AreEqual("3", fixedHandle().GetAttribute("aria-valuenow"));
        Assert.AreEqual("ArrowUp ArrowDown Home End", fixedHandle().GetAttribute(BitBhKeyboard.KeysAttribute));
        fixedHandle().Click();
        fixedHandle().Press("Enter");
        Assert.AreEqual("3", fixedHandle().GetAttribute("aria-valuenow"));
        fixedHandle().Press("ArrowDown");
        Assert.AreEqual("2", fixedHandle().GetAttribute("aria-valuenow"));
    }

    [TestMethod]
    public void An_uncontrolled_drawer_reopens_at_its_default_snap_point()
    {
        var cut = Render(
            @<BitBhDrawer SnapPoints="Points" DefaultActiveSnapPoint="0.5">
                <BitBhDrawerTrigger>Filters</BitBhDrawerTrigger>
                <BitBhDrawerPanel aria-label="Filters">
