    [TestMethod]
    public async Task The_runtime_reports_where_a_drag_settled_and_shows_the_owners_answer()
    {
        var module = Module();
        module.Setup<int>("drawer.attach", _ => true).SetResult(7);
        var cut = Render(
            @<Stateful T="BitBhDrawerSnapPoint?" Initial="0.5" Context="s">
                <BitBhDrawer DefaultOpen="true" SnapPoints="Points" ActiveSnapPoint="s.Value"
                             ActiveSnapPointChanged="@(p => { if (p != (BitBhDrawerSnapPoint)1) s.Set(p); })"
                             FadeFromIndex="1" SnapToSequentialPoint="true" DismissOnSwipe="false">
                    <BitBhDrawerPanel aria-label="Filters"><BitBhDrawerHandle /></BitBhDrawerPanel>
                </BitBhDrawer>
            </Stateful>);
        cut.WaitForAssertion(() => Assert.IsNotEmpty(JSInterop.Invocations["drawer.attach"]));
        var attach = JSInterop.Invocations["drawer.attach"].Last();
        var options = (IDictionary<string, object?>)attach.Arguments[2]!;
        Assert.AreEqual(1, options["activeSnapPoint"]);
        Assert.AreEqual(1, options["fadeFromIndex"]);
        Assert.IsTrue((bool)options["sequential"]!);
        // A swipe may not close it, but it still moves between the snap points.
        Assert.IsFalse((bool)options["enabled"]!);

        Assert.AreEqual(0, await SnapPointChangeAsync(cut, attach, 0));
        Assert.AreEqual("160px", cut.Find("[role=dialog]").GetAttribute("data-snap-point"));
        cut.WaitForAssertion(() => Assert.AreEqual(0, ((IDictionary<string, object?>)JSInterop.Invocations["drawer.update"].Last().Arguments[1]!)["activeSnapPoint"]));
        Assert.AreEqual(7, JSInterop.Invocations["drawer.update"].Last().Arguments[0]);

        // The owner keeps the drawer off the largest snap point: the runtime is told it stays where it was.
        Assert.AreEqual(0, await SnapPointChangeAsync(cut, attach, 2));
        Assert.AreEqual("160px", cut.Find("[role=dialog]").GetAttribute("data-snap-point"));
        Assert.AreEqual(0, await SnapPointChangeAsync(cut, attach, 9));
    }

    [TestMethod]
    public void Without_two_snap_points_the_handle_stays_decorative()
    {
        var cut = Render(
            @<div>
                <BitBhDrawer DefaultOpen="true">
                    <BitBhDrawerPanel aria-label="Plain"><BitBhDrawerHandle /></BitBhDrawerPanel>
                </BitBhDrawer>
                <BitBhDrawer DefaultOpen="true" SnapPoints="@(["240px"])">
                    <BitBhDrawerPanel aria-label="Peek"><BitBhDrawerHandle /></BitBhDrawerPanel>
                </BitBhDrawer>
            </div>);

        var panels = cut.FindAll("[role=dialog]");
        var handles = cut.FindAll("[data-bit-bh-drawer-handle]");
        Assert.IsNull(panels[0].GetAttribute("data-snap-point"));
        Assert.AreEqual("240px", panels[1].GetAttribute("data-snap-point"));
        foreach (var handle in handles)
        {
            Assert.AreEqual("true", handle.GetAttribute("aria-hidden"));
            Assert.IsNull(handle.GetAttribute("role"));
            Assert.IsNull(handle.GetAttribute("tabindex"));
        }
        handles[1].Press("ArrowUp");
        Assert.AreEqual("240px", cut.FindAll("[role=dialog]")[1].GetAttribute("data-snap-point"));
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void The_handle_speaks_the_registered_strings()
    {
        Services.AddBitBheadlessServices(strings =>
        {
            strings.DrawerSize = "Höhe";
            strings.DrawerSnapPoint = (i, n) => $"Stufe {i + 1}/{n}";
        });
        var cut = Render(
            @<BitBhDrawer DefaultOpen="true" SnapPoints="Points">
                <BitBhDrawerPanel aria-label="Filter"><BitBhDrawerHandle /></BitBhDrawerPanel>
            </BitBhDrawer>);
        Assert.AreEqual("Höhe", HandleOf(cut).AccessibleName());
        Assert.AreEqual("Stufe 1/3", HandleOf(cut).GetAttribute("aria-valuetext"));
    }
