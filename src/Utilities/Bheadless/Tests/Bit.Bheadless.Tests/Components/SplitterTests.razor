    [TestMethod]
    public void Uncontrolled_sizes_are_kept_and_reported()
    {
        var changes = new List<IReadOnlyList<double>>();
        var cut = Render(
            @<BitBhSplitter OnSizesChange="s => changes.Add(s)">
                <BitBhSplitterPanel>One</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel>Two</BitBhSplitterPanel>
            </BitBhSplitter>);

        cut.Find("[role=separator]").Press("End");
        Assert.AreEqual("100", Now(cut.Find("[role=separator]")));
        // At the edge nothing changes, and nothing is reported.
        cut.Find("[role=separator]").Press("End");
