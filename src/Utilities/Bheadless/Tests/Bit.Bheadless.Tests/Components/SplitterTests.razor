    [TestMethod]
    public void Panels_that_join_take_their_share()
    {
        var cut = Render(
            @<Stateful T="bool" Initial="false" Context="s">
                <BitBhSplitter>
                    <BitBhSplitterPanel Key="a" Order="1">A</BitBhSplitterPanel>
                    <BitBhSplitterHandle />
                    <BitBhSplitterPanel Key="b" Order="2">B</BitBhSplitterPanel>
                    @if (s.Value)
                    {
                        <BitBhSplitterHandle />
                        <BitBhSplitterPanel Key="c" Order="3" DefaultSize="20">C</BitBhSplitterPanel>
                    }
                </BitBhSplitter>
            </Stateful>);

        var splitter = cut.FindComponent<BitBhSplitter>().Instance;
        cut.Find("[role=separator]").Press("ArrowRight");
        Assert.AreSequenceEqual(new[] { 55d, 45d }, splitter.CurrentSizes.ToArray());

        var host = cut.FindComponent<Stateful<bool>>().Instance;
        cut.InvokeAsync(() => host.Set(true));
        // The newcomer gets its default; the others keep their proportions in what is left.
        var sizes = splitter.CurrentSizes.ToArray();
        Assert.HasCount(3, sizes);
        Assert.AreEqual(44, sizes[0], 0.0001);
        Assert.AreEqual(36, sizes[1], 0.0001);
        Assert.AreEqual(20, sizes[2], 0.0001);
        Assert.HasCount(2, cut.FindAll("[role=separator]"));
        cut.ShouldBeAccessible();

        cut.InvokeAsync(() => host.Set(false));
        Assert.AreSequenceEqual(new[] { 55d, 45d }, splitter.CurrentSizes.Select(s => Math.Round(s, 6)).ToArray());
    }

    [TestMethod]
    public void Nested_splitters_are_independent()
    {
        var cut = Render(
            @<BitBhSplitter class="outer">
                <BitBhSplitterPanel>Sidebar</BitBhSplitterPanel>
                <BitBhSplitterHandle class="outer-handle" aria-label="Resize sidebar" />
                <BitBhSplitterPanel>
                    <BitBhSplitter class="inner" Orientation="BitBhOrientation.Vertical">
                        <BitBhSplitterPanel>Editor</BitBhSplitterPanel>
                        <BitBhSplitterHandle class="inner-handle" aria-label="Resize terminal" />
                        <BitBhSplitterPanel>Terminal</BitBhSplitterPanel>
                    </BitBhSplitter>
                </BitBhSplitterPanel>
            </BitBhSplitter>);

        Assert.AreEqual(cut.Find(".outer").Id, cut.Find(".outer-handle").GetAttribute("data-bit-bh-splitter-handle"));
        Assert.AreEqual(cut.Find(".inner").Id, cut.Find(".inner-handle").GetAttribute("data-bit-bh-splitter-handle"));
        cut.Find(".inner-handle").Press("ArrowDown");
        Assert.AreEqual("55", Now(cut.Find(".inner-handle")));
        Assert.AreEqual("50", Now(cut.Find(".outer-handle")));
        Assert.HasCount(2, cut.TabSequence());
        cut.ShouldBeAccessible();
    }

