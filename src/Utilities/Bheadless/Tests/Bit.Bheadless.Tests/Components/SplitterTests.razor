    [TestMethod]
    public void A_panel_at_its_minimum_passes_the_resize_on_to_the_next()
    {
        var cut = Render(
            @<BitBhSplitter DefaultSizes="@(new double[] { 30, 40, 30 })" KeyboardStep="20">
                <BitBhSplitterPanel>One</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel MinSize="30">Two</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel MinSize="10">Three</BitBhSplitterPanel>
            </BitBhSplitter>);

        var splitter = cut.FindComponent<BitBhSplitter>().Instance;
        cut.FindAll("[role=separator]")[0].Press("ArrowRight");
        // Two gives 10 down to its minimum, Three the other 10.
        Assert.AreSequenceEqual(new[] { 50d, 30d, 20d }, splitter.CurrentSizes.ToArray());
        // Two can't give more; Three can give 10 more.
        Assert.AreEqual("60", cut.FindAll("[role=separator]")[0].GetAttribute("aria-valuemax"));
        cut.FindAll("[role=separator]")[0].Press("End");
        Assert.AreSequenceEqual(new[] { 60d, 30d, 10d }, splitter.CurrentSizes.ToArray());
        cut.ShouldBeAccessible();
    }

