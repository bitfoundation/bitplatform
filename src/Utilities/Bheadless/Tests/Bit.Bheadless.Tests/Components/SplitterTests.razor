    [TestMethod]
    public void Controlled_sizes_follow_the_bound_value()
    {
        var commits = new List<IReadOnlyList<double>>();
        var cut = Render(
            @<Stateful T="IReadOnlyList<double>" Initial="@(new double[] { 25, 75 })" Context="s">
                <BitBhSplitter Sizes="s.Value" SizesChanged="s.Set" OnSizesCommit="c => commits.Add(c)">
                    <BitBhSplitterPanel class="p">One</BitBhSplitterPanel>
                    <BitBhSplitterHandle />
                    <BitBhSplitterPanel class="p">Two</BitBhSplitterPanel>
                </BitBhSplitter>
            </Stateful>);

        var host = cut.FindComponent<Stateful<IReadOnlyList<double>>>().Instance;
        Assert.AreEqual("25", Now(cut.Find("[role=separator]")));
        cut.Find("[role=separator]").Press("ArrowRight");
        Assert.AreSequenceEqual(new[] { 30d, 70d }, host.Value!.ToArray());
        Assert.AreEqual("30", Now(cut.Find("[role=separator]")));
        Assert.HasCount(1, commits);

        cut.InvokeAsync(() => host.Set(new double[] { 60, 40 }));
        Assert.AreEqual("60", Now(cut.Find("[role=separator]")));
        Assert.Contains("flex:60 1 0px", cut.FindAll(".p")[0].GetAttribute("style")!);
    }

