    [TestMethod]
    public void Enter_collapses_and_restores_a_collapsible_panel()
    {
        var changes = new List<bool>();
        var cut = Render(
            @<BitBhSplitter DefaultSizes="@(new double[] { 30, 70 })">
                <BitBhSplitterPanel class="side" MinSize="20" Collapsible="true" OnCollapsedChange="c => changes.Add(c)"><button>Inside</button></BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel>Main</BitBhSplitterPanel>
            </BitBhSplitter>);

        var handle = cut.Find("[role=separator]");
        Assert.AreEqual("ArrowLeft ArrowRight Home End Enter", handle.GetAttribute("data-bit-bh-keys"));
        // Collapsible: the smallest size is the collapsed one.
        Assert.AreEqual("0", handle.GetAttribute("aria-valuemin"));

        handle.Press("Enter");
        var side = cut.Find(".side");
        Assert.AreEqual("collapsed", side.GetAttribute("data-state"));
        Assert.IsTrue(side.HasAttribute("data-collapsed"));
        // Nothing in a panel squeezed to nothing is reachable.
        Assert.IsTrue(side.HasAttribute("inert"));
        Assert.AreEqual("0", Now(cut.Find("[role=separator]")));
        Assert.ContainsSingle(cut.TabSequence());
        cut.ShouldBeAccessible();

        cut.Find("[role=separator]").Press("Enter");
        Assert.AreEqual("expanded", cut.Find(".side").GetAttribute("data-state"));
        Assert.IsFalse(cut.Find(".side").HasAttribute("inert"));
        Assert.AreEqual("30", Now(cut.Find("[role=separator]")));
        Assert.AreSequenceEqual(new[] { true, false }, changes);
    }

