@using System.Reflection
@using AngleSharp.Dom
@using Microsoft.JSInterop
@inherits TestBase
@attribute [TestClass]

@code {
    private static string Now(IElement handle) => handle.GetAttribute("aria-valuenow")!;

    [TestMethod]
    public void Handles_are_focusable_window_splitters()
    {
        var cut = Render(
            @<BitBhSplitter>
                <BitBhSplitterPanel class="first" MinSize="20" MaxSize="70">One</BitBhSplitterPanel>
                <BitBhSplitterHandle class="handle" />
                <BitBhSplitterPanel class="second" MinSize="10">Two</BitBhSplitterPanel>
            </BitBhSplitter>);

        var handle = cut.Find(".handle");
        Assert.AreEqual("separator", handle.Role());
        Assert.AreEqual("0", handle.GetAttribute("tabindex"));
        Assert.AreEqual("50", Now(handle));
        Assert.AreEqual("20", handle.GetAttribute("aria-valuemin"));
        Assert.AreEqual("70", handle.GetAttribute("aria-valuemax"));
        Assert.AreEqual(cut.Find(".first").Id, handle.GetAttribute("aria-controls"));
        // The bar between side-by-side panels is vertical (APG).
        Assert.AreEqual("vertical", handle.GetAttribute("aria-orientation"));
        Assert.AreEqual("horizontal", handle.GetAttribute("data-orientation"));
        Assert.AreEqual("Resize panels", handle.AccessibleName());
        Assert.AreEqual("ArrowLeft ArrowRight Home End", handle.GetAttribute("data-bit-bh-keys"));
        Assert.ContainsSingle(cut.TabSequence());
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void A_vertical_splitter_has_a_horizontal_bar_moved_by_Up_and_Down()
    {
        var cut = Render(
            @<BitBhSplitter Orientation="BitBhOrientation.Vertical" class="root">
                <BitBhSplitterPanel>Top</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel>Bottom</BitBhSplitterPanel>
            </BitBhSplitter>);

        var handle = cut.Find("[role=separator]");
        Assert.AreEqual("horizontal", handle.GetAttribute("aria-orientation"));
        Assert.AreEqual("ArrowUp ArrowDown Home End", handle.GetAttribute("data-bit-bh-keys"));
        Assert.Contains("flex-direction:column", cut.Find(".root").GetAttribute("style")!);

        handle.Press("ArrowRight");
        Assert.AreEqual("50", Now(cut.Find("[role=separator]")));
        cut.Find("[role=separator]").Press("ArrowDown");
        Assert.AreEqual("55", Now(cut.Find("[role=separator]")));
        cut.Find("[role=separator]").Press("ArrowUp");
        Assert.AreEqual("50", Now(cut.Find("[role=separator]")));
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void A_label_the_consumer_gives_wins()
    {
        var cut = Render(
            @<div>
                <span id="sidebar-label">Sidebar</span>
                <BitBhSplitter>
                    <BitBhSplitterPanel>One</BitBhSplitterPanel>
                    <BitBhSplitterHandle class="labelled" aria-label="Resize sidebar" />
                    <BitBhSplitterPanel>Two</BitBhSplitterPanel>
                    <BitBhSplitterHandle class="by" aria-labelledby="sidebar-label" />
                    <BitBhSplitterPanel>Three</BitBhSplitterPanel>
                </BitBhSplitter>
            </div>);
        Assert.AreEqual("Resize sidebar", cut.Find(".labelled").AccessibleName());
        Assert.IsNull(cut.Find(".by").GetAttribute("aria-label"));
        Assert.AreEqual("Sidebar", cut.Find(".by").AccessibleName());
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void Panels_share_the_space_by_their_defaults()
    {
        var cut = Render(
            @<BitBhSplitter>
                <BitBhSplitterPanel class="p" DefaultSize="40">One</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel class="p">Two</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel class="p">Three</BitBhSplitterPanel>
            </BitBhSplitter>);

        var panels = cut.FindAll(".p");
        Assert.Contains("flex:40 1 0px", panels[0].GetAttribute("style")!);
        Assert.Contains("flex:30 1 0px", panels[1].GetAttribute("style")!);
        Assert.Contains("flex:30 1 0px", panels[2].GetAttribute("style")!);
        Assert.Contains("overflow:hidden", panels[0].GetAttribute("style")!);
        Assert.AreEqual("expanded", panels[0].GetAttribute("data-state"));
        var handles = cut.FindAll("[role=separator]");
        Assert.AreEqual("40", Now(handles[0]));
        Assert.AreEqual("30", Now(handles[1]));
        Assert.AreEqual(panels[1].Id, handles[1].GetAttribute("aria-controls"));
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void DefaultSizes_are_brought_within_constraints_and_to_100()
    {
        IReadOnlyList<double>? reported = null;
        var cut = Render(
            @<BitBhSplitter DefaultSizes="@(new double[] { 10, 90 })" OnSizesChange="s => reported = s">
                <BitBhSplitterPanel MinSize="30">One</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel>Two</BitBhSplitterPanel>
            </BitBhSplitter>);

        Assert.AreEqual("30", Now(cut.Find("[role=separator]")));
        var splitter = cut.FindComponent<BitBhSplitter>().Instance;
        Assert.AreSequenceEqual(new[] { 30d, 70d }, splitter.CurrentSizes.ToArray());
        // Nothing was changed by the user: nothing is reported.
        Assert.IsNull(reported);

        // A total short of 100 is shared by the panels that can still grow.
        var shortOf100 = Render(
            @<BitBhSplitter DefaultSizes="@(new double[] { 20, 10 })">
                <BitBhSplitterPanel>One</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel MaxSize="40">Two</BitBhSplitterPanel>
            </BitBhSplitter>);
        Assert.AreSequenceEqual(new[] { 60d, 40d }, shortOf100.FindComponent<BitBhSplitter>().Instance.CurrentSizes.ToArray());
    }

    [TestMethod]
    public void Arrow_keys_resize_by_the_step_and_Shift_by_the_large_step()
    {
        var commits = new List<IReadOnlyList<double>>();
        var cut = Render(
            @<BitBhSplitter OnSizesCommit="s => commits.Add(s)">
                <BitBhSplitterPanel>One</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel>Two</BitBhSplitterPanel>
            </BitBhSplitter>);

        IElement Handle() => cut.Find("[role=separator]");
        Handle().Press("ArrowRight");
        Assert.AreEqual("55", Now(Handle()));
        Handle().Press("ArrowLeft");
        Handle().Press("ArrowLeft");
        Assert.AreEqual("45", Now(Handle()));
        Handle().Press("ArrowRight", shift: true);
        Assert.AreEqual("65", Now(Handle()));
        Assert.HasCount(4, commits);
        Assert.AreSequenceEqual(new[] { 65d, 35d }, commits[^1].ToArray());
    }

