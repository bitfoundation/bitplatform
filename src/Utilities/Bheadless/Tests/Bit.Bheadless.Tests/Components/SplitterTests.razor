    [TestMethod]
    public void Disposing_detaches_the_runtime()
    {
        var module = JSInterop.SetupModule(BitBhInterop.ModulePath);
        module.Setup<int>("splitter.attach", _ => true).SetResult(6);
        var cut = Render(
            @<Stateful T="bool" Initial="true" Context="s">
                @if (s.Value)
                {
                    <BitBhSplitter>
                        <BitBhSplitterPanel>One</BitBhSplitterPanel>
                        <BitBhSplitterHandle />
                        <BitBhSplitterPanel>Two</BitBhSplitterPanel>
                    </BitBhSplitter>
                }
            </Stateful>);

        cut.InvokeAsync(() => cut.FindComponent<Stateful<bool>>().Instance.Set(false));
        cut.WaitForAssertion(() =>
            Assert.ContainsSingle(JSInterop.Invocations.Where(i => i.Identifier == "splitter.detach" && Equals(i.Arguments[0], 6))));
    }
