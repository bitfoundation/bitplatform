        Assert.AreSequenceEqual(new[] { 100d, 0d }, changes[0].ToArray());
        // A non-collapsible panel dragged to nothing is out of reach too.
        Assert.IsTrue(cut.FindAll("[data-bit-bh-splitter-panel]")[1].HasAttribute("inert"));
    }

