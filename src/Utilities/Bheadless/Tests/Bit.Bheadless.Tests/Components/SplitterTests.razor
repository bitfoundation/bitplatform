    [TestMethod]
    public void Panels_have_a_programmatic_api()
    {
        var cut = Render(
            @<BitBhSplitter>
                <BitBhSplitterPanel class="side" MinSize="20" Collapsible="true">Side</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel>Main</BitBhSplitterPanel>
            </BitBhSplitter>);

        var side = cut.FindComponents<BitBhSplitterPanel>()[0].Instance;
        var main = cut.FindComponents<BitBhSplitterPanel>()[1].Instance;
        cut.InvokeAsync(() => side.ResizeAsync(35));
        Assert.AreEqual(35, side.Size);
        cut.InvokeAsync(() => side.CollapseAsync());
        Assert.IsTrue(side.IsCollapsed);
        cut.InvokeAsync(() => side.ExpandAsync());
        Assert.AreEqual(35, side.Size);
        // The last panel moves the handle before it.
        cut.InvokeAsync(() => main.ResizeAsync(80));
        Assert.AreEqual(20, side.Size);

        var splitter = cut.FindComponent<BitBhSplitter>().Instance;
        cut.InvokeAsync(() => splitter.SetSizesAsync([90, 10]));
        Assert.AreSequenceEqual(new[] { 90d, 10d }, splitter.CurrentSizes.ToArray());
    }

