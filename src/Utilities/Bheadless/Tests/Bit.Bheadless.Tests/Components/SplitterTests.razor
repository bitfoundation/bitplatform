    [TestMethod]
    public void Constraints_stop_the_handle()
    {
        var cut = Render(
            @<BitBhSplitter KeyboardStep="10">
                <BitBhSplitterPanel MaxSize="60">One</BitBhSplitterPanel>
                <BitBhSplitterHandle />
