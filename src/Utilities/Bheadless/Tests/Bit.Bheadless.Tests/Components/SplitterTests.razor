    private static MethodInfo PointerMethod(object callbacks, out object target)
    {
        target = callbacks.GetType().GetProperty("Value")!.GetValue(callbacks)!;
        return target.GetType().GetMethod("OnSplitterPointer")!;
    }

    [TestMethod]
    public void A_pointer_drag_resizes_live_and_commits_once()
    {
        var module = JSInterop.SetupModule(BitBhInterop.ModulePath);
        var attach = module.Setup<int>("splitter.attach", _ => true);
        var changes = new List<IReadOnlyList<double>>();
        var commits = new List<IReadOnlyList<double>>();
        var cut = Render(
            @<BitBhSplitter class="root" OnSizesChange="s => changes.Add(s)" OnSizesCommit="s => commits.Add(s)">
                <BitBhSplitterPanel>One</BitBhSplitterPanel>
                <BitBhSplitterHandle class="handle" />
                <BitBhSplitterPanel MinSize="30">Two</BitBhSplitterPanel>
            </BitBhSplitter>);
        attach.SetResult(1);

        // The runtime gets a callback object, not the component (whose callback would be public API).
        var callbacks = attach.Invocations.Single().Arguments[0]!;
        Assert.IsFalse(typeof(BitBhSplitter).GetMethods().Any(m => m.IsDefined(typeof(JSInvokableAttribute), true)));
        Assert.AreEqual(cut.Find(".root").Id, attach.Invocations.Single().Arguments[1]);
        Assert.AreEqual("horizontal", ((IDictionary<string, object?>)attach.Invocations.Single().Arguments[2]!)["orientation"]);

        var pointer = PointerMethod(callbacks, out var target);
        var id = cut.Find(".handle").Id!;
        void Send(string phase, double delta) => cut.InvokeAsync(() => (Task)pointer.Invoke(target, [phase, id, delta])!).GetAwaiter().GetResult();

        Send("start", 0);
        Assert.IsTrue(cut.Find(".handle").HasAttribute("data-dragging"));
        Assert.IsTrue(cut.Find(".root").HasAttribute("data-dragging"));
        Send("move", 10);
        Assert.AreEqual("60", Now(cut.Find(".handle")));
        // Distances are from where the drag started, so the handle follows the pointer back and forth.
        Send("move", -5);
        Assert.AreEqual("45", Now(cut.Find(".handle")));
        Send("move", 40);
        Assert.AreEqual("70", Now(cut.Find(".handle")));
        Assert.IsEmpty(commits);
        Send("end", 40);
        Assert.IsFalse(cut.Find(".handle").HasAttribute("data-dragging"));
        Assert.HasCount(3, changes);
        Assert.ContainsSingle(commits);
        Assert.AreSequenceEqual(new[] { 70d, 30d }, commits[0].ToArray());
    }

    [TestMethod]
    public void Escape_during_a_drag_puts_the_panels_back()
    {
        var module = JSInterop.SetupModule(BitBhInterop.ModulePath);
        var attach = module.Setup<int>("splitter.attach", _ => true);
        var commits = 0;
        var cut = Render(
            @<BitBhSplitter OnSizesCommit="_ => commits++">
                <BitBhSplitterPanel>One</BitBhSplitterPanel>
                <BitBhSplitterHandle class="handle" />
                <BitBhSplitterPanel>Two</BitBhSplitterPanel>
            </BitBhSplitter>);
        attach.SetResult(1);

        var pointer = PointerMethod(attach.Invocations.Single().Arguments[0]!, out var target);
        var id = cut.Find(".handle").Id!;
        void Send(string phase, double delta) => cut.InvokeAsync(() => (Task)pointer.Invoke(target, [phase, id, delta])!).GetAwaiter().GetResult();

        Send("start", 0);
        Send("move", 20);
        Assert.AreEqual("70", Now(cut.Find(".handle")));
        Send("cancel", 20);
        Assert.AreEqual("50", Now(cut.Find(".handle")));
        Assert.AreEqual(0, commits);
    }

    [TestMethod]
    public void A_drag_past_half_the_minimum_collapses_a_collapsible_panel()
    {
        var module = JSInterop.SetupModule(BitBhInterop.ModulePath);
        var attach = module.Setup<int>("splitter.attach", _ => true);
        var cut = Render(
            @<BitBhSplitter DefaultSizes="@(new double[] { 30, 70 })">
                <BitBhSplitterPanel class="side" MinSize="20" Collapsible="true">Side</BitBhSplitterPanel>
                <BitBhSplitterHandle class="handle" />
                <BitBhSplitterPanel>Main</BitBhSplitterPanel>
            </BitBhSplitter>);
        attach.SetResult(1);

        var pointer = PointerMethod(attach.Invocations.Single().Arguments[0]!, out var target);
        var id = cut.Find(".handle").Id!;
        void Send(string phase, double delta) => cut.InvokeAsync(() => (Task)pointer.Invoke(target, [phase, id, delta])!).GetAwaiter().GetResult();

        Send("start", 0);
        Send("move", -15);
        // 15 is below the minimum but above half of it: the panel stops at its minimum.
        Assert.AreEqual("20", Now(cut.Find(".handle")));
        Send("move", -21);
        Assert.AreEqual("0", Now(cut.Find(".handle")));
        Assert.AreEqual("collapsed", cut.Find(".side").GetAttribute("data-state"));
        Send("move", -15);
        Assert.AreEqual("20", Now(cut.Find(".handle")));
        Send("end", -15);
    }

    [TestMethod]
    public void A_saved_layout_is_restored_and_commits_are_saved()
    {
        var module = JSInterop.SetupModule(BitBhInterop.ModulePath);
        var load = module.Setup<double[]?>("splitter.load", _ => true);
        load.SetResult([35, 65]);
        IReadOnlyList<double>? bound = null;
        var cut = Render(
            @<BitBhSplitter AutoSaveId="editor" SizesChanged="s => bound = s">
                <BitBhSplitterPanel Key="files">Files</BitBhSplitterPanel>
                <BitBhSplitterHandle />
                <BitBhSplitterPanel>Editor</BitBhSplitterPanel>
            </BitBhSplitter>);

        Assert.AreEqual("bit-bh-splitter:editor:files,1", load.Invocations.Single().Arguments[0]);
        cut.WaitForAssertion(() => Assert.AreEqual("35", Now(cut.Find("[role=separator]"))));
        Assert.AreSequenceEqual(new[] { 35d, 65d }, bound!.ToArray());

        cut.Find("[role=separator]").Press("ArrowRight");
        var save = JSInterop.Invocations.Single(i => i.Identifier == "splitter.save");
        Assert.AreEqual("bit-bh-splitter:editor:files,1", save.Arguments[0]);
        Assert.AreSequenceEqual(new[] { 40d, 60d }, (double[])save.Arguments[1]!);
    }

