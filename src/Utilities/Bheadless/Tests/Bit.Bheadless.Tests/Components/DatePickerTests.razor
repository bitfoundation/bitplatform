@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inherits TestBase
@attribute [TestClass]

@code {
    private static readonly CultureInfo En = CultureInfo.GetCultureInfo("en-US");
    private static readonly CultureInfo De = CultureInfo.GetCultureInfo("de-DE");
    private static readonly DateOnly Nov8 = new(2026, 11, 8);

    private static RenderFragment Parts() =>
        @<text>
            <BitBhDatePickerGroup class="group">
                <BitBhDateFieldSegments />
                <BitBhDatePickerTrigger class="trigger">▾</BitBhDatePickerTrigger>
            </BitBhDatePickerGroup>
            <BitBhDatePickerContent class="popover">
                <BitBhCalendar>
                    <BitBhCalendarPrevious>‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading />
                    <BitBhCalendarNext>›</BitBhCalendarNext>
                    <BitBhCalendarGrid />
                </BitBhCalendar>
            </BitBhDatePickerContent>
        </text>;

    private static AngleSharp.Dom.IElement Cell(IRenderedComponent<Bunit.Rendering.ContainerFragment> cut, string date)
        => cut.Find($"td[data-date='{date}']:not([data-outside-month])");

    private static string Shown(IRenderedComponent<Bunit.Rendering.ContainerFragment> cut)
        => string.Concat(cut.FindAll("[data-type]").Select(s => s.TextContent));

    private IRenderedComponent<Bunit.Rendering.ContainerFragment> Labelled(RenderFragment picker)
        => Render(
            @<BitBhField>
                <BitBhLabel>Departure</BitBhLabel>
                @picker
            </BitBhField>);

    [TestMethod]
    public void A_range_calendar_in_a_date_picker_keeps_its_own_range()
    {
        // The calendar selects something else than the picker: it keeps it itself, as outside a picker.
        BitBhDateRange? range = null;
        DateOnly? value = Nov8;
        var cut = Render(
            @<BitBhDatePicker Culture="En" DefaultValue="Nov8" ValueChanged="v => value = v" aria-label="Departure">
                <BitBhDatePickerTrigger class="trigger">▾</BitBhDatePickerTrigger>
                <BitBhDatePickerContent>
                    <BitBhCalendar DefaultFocusedDate="Nov8" OnRangeChange="r => range = r"><BitBhCalendarGrid /></BitBhCalendar>
                </BitBhDatePickerContent>
            </BitBhDatePicker>);

        cut.Find(".trigger").Click();
        Cell(cut, "2026-11-10").Click();
        Cell(cut, "2026-11-12").Click();

        Assert.AreEqual(new BitBhDateRange(new DateOnly(2026, 11, 10), new DateOnly(2026, 11, 12)), range);
        Assert.IsTrue(Cell(cut, "2026-11-11").HasAttribute("data-selected"));
        Assert.AreEqual(Nov8, value);
    }

    [TestMethod]
    public void Closed_picker_is_a_labelled_group_with_a_choose_date_button()
    {
        var cut = Labelled(@<BitBhDatePicker Culture="En" DefaultValue="Nov8">@Parts()</BitBhDatePicker>);

        var group = cut.Find(".group");
        Assert.AreEqual("group", group.GetAttribute("role"));
        Assert.AreEqual("Departure", group.AccessibleName());
        Assert.AreEqual("11/8/2026", Shown(cut));

        var trigger = cut.Find(".trigger");
        Assert.AreEqual("Choose date Departure", trigger.AccessibleName());
        Assert.AreEqual("dialog", trigger.GetAttribute("aria-haspopup"));
        Assert.AreEqual("false", trigger.GetAttribute("aria-expanded"));
        Assert.IsFalse(trigger.HasAttribute("aria-controls"));
        // The calendar is not on the page while closed.
        Assert.IsEmpty(cut.FindAll("[role=dialog]"));
        Assert.AreEqual("closed", cut.Find(".group").GetAttribute("data-state"));
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void Opening_shows_the_calendar_on_the_value_and_moves_the_focus_to_it()
    {
        var cut = Labelled(@<BitBhDatePicker Culture="En" DefaultValue="Nov8">@Parts()</BitBhDatePicker>);

        cut.Find(".trigger").Click();
        var dialog = cut.Find("[role=dialog]");
        Assert.AreEqual("Departure", dialog.AccessibleName());
        Assert.IsFalse(dialog.HasAttribute("aria-modal"));
        var trigger = cut.Find(".trigger");
        Assert.AreEqual("true", trigger.GetAttribute("aria-expanded"));
        Assert.AreEqual(dialog.Id, trigger.GetAttribute("aria-controls"));
        Assert.AreEqual("open", cut.Find(".group").GetAttribute("data-state"));

        Assert.AreEqual("November 2026", Text(cut.Find("h2")));
        var selected = Cell(cut, "2026-11-08");
        Assert.AreEqual("true", selected.GetAttribute("aria-selected"));
        // The popover's focus scope lands on the element marked for it: the focused date.
        Assert.IsTrue(selected.HasAttribute("data-bit-bh-autofocus"));
        Assert.HasCount(1, cut.FindAll("[data-bit-bh-autofocus]"));
        var open = JSInterop.Invocations.Last(i => i.Identifier == "floating.open");
        Assert.AreEqual(dialog.Id, open.Arguments[1]);
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void Picking_a_date_sets_the_value_closes_the_popover_and_fills_the_segments()
    {
        var cut = Render(
            @<Stateful T="DateOnly?" Initial="Nov8">
                <BitBhDatePicker Culture="En" Value="context.Value" ValueChanged="context.Set" aria-label="Departure">@Parts()</BitBhDatePicker>
                <output>@context.Value?.ToString("yyyy-MM-dd")</output>
            </Stateful>);

        cut.Find(".trigger").Click();
        Cell(cut, "2026-11-20").Click();
        Assert.AreEqual("2026-11-20", Text(cut.Find("output")));
        Assert.IsEmpty(cut.FindAll("[role=dialog]"));
        Assert.AreEqual("11/20/2026", Shown(cut));
        Assert.AreEqual("false", cut.Find(".trigger").GetAttribute("aria-expanded"));
        Assert.IsTrue(Announcer.Messages.Contains("Selected date: Friday, November 20, 2026"));
    }

    [TestMethod]
    public void A_typed_date_is_where_the_calendar_opens()
    {
        DateOnly? value = null;
        var cut = Render(@<BitBhDatePicker Culture="En" ValueChanged="v => value = v" aria-label="Departure">@Parts()</BitBhDatePicker>);

        foreach (var key in "3") cut.Find("[aria-label=month]").Press(key.ToString());
        foreach (var key in "15") cut.Find("[aria-label=day]").Press(key.ToString());
        foreach (var key in "2027") cut.Find("[aria-label=year]").Press(key.ToString());
        Assert.AreEqual(new DateOnly(2027, 3, 15), value);

        cut.Find(".trigger").Click();
        Assert.AreEqual("March 2027", Text(cut.Find("h2")));
        Assert.AreEqual("0", Cell(cut, "2027-03-15").GetAttribute("tabindex"));
    }

    [TestMethod]
    public void Escape_alt_arrow_down_and_the_trigger_open_and_close_it()
    {
        var opens = new List<bool>();
        var cut = Render(@<BitBhDatePicker Culture="En" DefaultValue="Nov8" OnOpenChange="o => opens.Add(o)" aria-label="Departure">@Parts()</BitBhDatePicker>);

        cut.Find("[aria-label=day]").Press("ArrowDown", alt: true);
        Assert.HasCount(1, cut.FindAll("[role=dialog]"));

        cut.Find("[role=dialog]").Press("Escape");
        Assert.IsEmpty(cut.FindAll("[role=dialog]"));

        cut.Find(".trigger").Click();
        Assert.AreEqual("Escape", cut.Find(".trigger").GetAttribute("data-bit-bh-keys"));
        cut.Find(".trigger").Press("Escape");
        Assert.IsEmpty(cut.FindAll("[role=dialog]"));

        cut.Find(".trigger").Click();
        cut.Find(".trigger").Click();
        Assert.IsEmpty(cut.FindAll("[role=dialog]"));
        CollectionAssert.AreEqual(new[] { true, false, true, false, true, false }, opens);
    }

    [TestMethod]
    public void Limits_and_unavailable_dates_reach_the_calendar_and_mark_a_typed_date_invalid()
    {
        var cut = Render(@<BitBhDatePicker Culture="En" DefaultValue="Nov8" Min="new DateOnly(2026, 11, 5)"
                                      IsDateUnavailable="d => d.DayOfWeek == DayOfWeek.Sunday" aria-label="Departure">@Parts()</BitBhDatePicker>);

        // The 8th is a Sunday.
        Assert.IsTrue(cut.Find(".group").HasAttribute("data-invalid"));
        Assert.AreEqual("true", cut.Find("[aria-label=day]").GetAttribute("aria-invalid"));

        cut.Find(".trigger").Click();
        Assert.IsTrue(Cell(cut, "2026-11-04").HasAttribute("data-disabled"));
        Assert.IsTrue(Cell(cut, "2026-11-15").HasAttribute("data-unavailable"));
        Cell(cut, "2026-11-15").Click();
        Assert.HasCount(1, cut.FindAll("[role=dialog]"));

        Cell(cut, "2026-11-16").Click();
        Assert.IsFalse(cut.Find(".group").HasAttribute("data-invalid"));
    }

    [TestMethod]
    public void The_calendar_follows_the_pickers_culture()
    {
        var cut = Render(@<BitBhDatePicker Culture="De" DefaultValue="Nov8" aria-label="Abflug">@Parts()</BitBhDatePicker>);
        Assert.AreEqual("08.11.2026", Shown(cut));
        cut.Find(".trigger").Click();
        Assert.AreEqual("Montag", cut.Find("th").AccessibleName());
        Assert.AreEqual("Sonntag, 8. November 2026", Cell(cut, "2026-11-08").AccessibleName());
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void Disabled_picker_does_not_open()
    {
        var cut = Render(@<BitBhDatePicker Culture="En" Disabled="true" aria-label="Departure">@Parts()</BitBhDatePicker>);
        Assert.IsTrue(cut.Find(".trigger").HasAttribute("disabled"));
        Assert.IsEmpty(cut.TabSequence());
        cut.Find(".trigger").Click();
        Assert.IsEmpty(cut.FindAll("[role=dialog]"));
        cut.ShouldBeAccessible();
    }

    [TestMethod]
    public void Edit_form_validation_and_hidden_input()
    {
        var model = new Trip();
        var cut = Render(
            @<EditForm Model="model">
                <DataAnnotationsValidator />
                <BitBhField>
                    <BitBhLabel>Departure</BitBhLabel>
                    <BitBhDatePicker Culture="En" @bind-Value="model.Departure" Name="departure">@Parts()</BitBhDatePicker>
                    <BitBhErrorMessage />
                </BitBhField>
            </EditForm>);

        cut.Find("form").Submit();
        Assert.IsTrue(cut.Find(".group").HasAttribute("data-invalid"));
        Assert.Contains("required", cut.Find(".group").AccessibleDescription());

        cut.Find(".trigger").Click();
        Cell(cut, cut.Find("td[tabindex='0']").GetAttribute("data-date")!).Click();
        Assert.IsNotNull(model.Departure);
        Assert.AreEqual(model.Departure!.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), cut.Find("input[type=hidden]").GetAttribute("value"));
        Assert.IsFalse(cut.Find(".group").HasAttribute("data-invalid"));
        cut.ShouldBeAccessible();
    }

    private sealed class Trip
    {
        [Required(ErrorMessage = "A departure date is required.")]
        public DateOnly? Departure { get; set; }
    }
}
