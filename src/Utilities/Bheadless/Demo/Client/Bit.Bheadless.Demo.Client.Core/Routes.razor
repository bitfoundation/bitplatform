@* The site's root component. App.razor (in the server project) gives it its render mode - the same
   one HeadOutlet gets, so <PageTitle> keeps updating once the app is interactive. A page sets no
   @rendermode of its own.

   Every page but the landing page renders inside the docs shell (Layout/DocsLayout.razor); the
   landing, not-found and error pages opt out with @layout MainLayout. After a navigation the
   page's own H1 takes focus, so a screen reader starts reading at the new page.

   The portal outlet sits after the router rather than in a layout: it is where every BitBhPortal of
   every page renders its content - dialogs, popovers, menus, toasts - so it is mounted once, outside
   the site chrome, and survives navigations. *@
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Bheadless</PageTitle>
<Router AppAssembly="typeof(Routes).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.DocsLayout)" />
        @* Not on arrival: <FocusOnNavigate> also fires on its first render, which here is the
           moment the app turns interactive - seconds after the page appeared - and it would pull
           focus away from wherever the reader had already tabbed to, the skip link included. It
           joins the tree with the first navigation, and its first render then is that one. *@
        @if (_navigated)
        {
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        }
    </Found>
</Router>

<BitBhPortalOutlet />

@code {
    private bool _navigated;
    private bool _loading;
    private IDisposable? _locationChanging;

    // Subscribed ahead of the router (a parent initializes before the children it renders), so the
    // flag is already set when the router renders the page the navigation asked for.
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    // Interactive only: a prerender's navigation manager takes no location-changing handler.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _locationChanging = Nav.RegisterLocationChangingHandler(OnLocationChanging);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _navigated = true;

    // /strict-csp has a root of its own (StrictCspRoutes, which cascades the strict CSP options) and a policy of its
    // own, and both come with the document (App.razor, Program.cs): routed to from here, it would render under this root
    // with neither. It is loaded instead.
    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (_loading || IsStrictCsp(context.TargetLocation) is false) return ValueTask.CompletedTask;
        context.PreventNavigation();
        // The forced load goes through this handler too.
        _loading = true;
        Nav.NavigateTo(context.TargetLocation, forceLoad: true);
        return ValueTask.CompletedTask;
    }

    private bool IsStrictCsp(string location)
    {
        var uri = Nav.ToAbsoluteUri(location).AbsoluteUri;
        if (uri.StartsWith(Nav.BaseUri, StringComparison.OrdinalIgnoreCase) is false) return false;
        var path = uri[Nav.BaseUri.Length..].Split('?', '#')[0];
        return path.Equals("strict-csp", StringComparison.OrdinalIgnoreCase) || path.StartsWith("strict-csp/", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _locationChanging?.Dispose();
    }
}
