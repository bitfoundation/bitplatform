@*
    The Tailwind section's demo block: DemoBlock with a Preview / Razor pair of tabs - each example's Razor
    tab shows the complete source (markup + @code), Tailwind utility classes inline, so there is no CSS tab.
*@

<DemoBlock Title="@Title" Description="Description" LiveContent="LiveContent" Code="@Code" Tailwind="true" />

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? Description { get; set; }
    [Parameter] public RenderFragment? LiveContent { get; set; }

    /// <summary>The complete Razor source that reproduces the demo.</summary>
    [Parameter] public string? Code { get; set; }
}
