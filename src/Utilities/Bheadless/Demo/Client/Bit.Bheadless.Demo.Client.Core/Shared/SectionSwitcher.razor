@*
    Lets visitors flip between the CSS and Tailwind versions of the current demo page. It follows the page
    intro of both versions, drawn as the site kit's segmented control, and sticks under the header while the
    page scrolls - so it goes after the intro's closing tag, not inside it (see demo.css). The version on
    screen is the one NavLink marks active (and aria-current="page").

    Usage:
        <SectionSwitcher Slug="button" />
*@

<div class="bh-styling-switch" role="group" aria-label="Styling implementation">
    <span class="bh-styling-switch-label">Styled with</span>
    <span class="bb-segmented">
        <NavLink href="@Slug" Match="NavLinkMatch.All" ActiveClass="active">CSS</NavLink>
        <NavLink href="@($"tw/{Slug}")" Match="NavLinkMatch.All" ActiveClass="active">Tailwind</NavLink>
    </span>
</div>

@code {
    /// <summary>The component slug, e.g. <c>button</c> or <c>accordion</c>.</summary>
    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;
}
