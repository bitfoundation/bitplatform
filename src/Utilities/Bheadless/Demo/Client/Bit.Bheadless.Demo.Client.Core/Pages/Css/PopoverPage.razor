/* All styles are consumer-authored — the library ships zero CSS */
.popover-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 120ms ease;
}

.popover-button:hover               { border-color: #a1a1af; }
.popover-button:focus-visible       { outline: 2px solid #2563eb; outline-offset: 2px; }
.popover-button[data-state="open"]  { border-color: #2563eb; }

.popover-chevron       { transition: transform 200ms ease; color: #71717a; }
.popover-chevron.open  { transform: rotate(180deg); }

.popover-body   { font-size: 0.875rem; color: #71717a; margin: 0; }

/* When using Anchor, the panel is position:fixed by the JS engine.
   No position:relative on parent needed. */
.popover-anchored { display: inline-block; }

.popover-panel-anchored {
    z-index: 31;
    min-width: 16rem;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    padding: 1rem;
}
""";

