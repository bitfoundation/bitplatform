            </svg>
        </BitBhToggleGroupItem>
    </BitBhToggleGroup>
    <BitBhToolbarLink href="https://www.w3.org/WAI/ARIA/apg/patterns/toolbar/" target="_blank" rel="noopener"
                   class="toolbar-link">
        Toolbar pattern ↗
    </BitBhToolbarLink>
    <BitBhToolbarButton OnClick='@(() => Log("Shared"))' class="toolbar-button toolbar-button-primary">Share</BitBhToolbarButton>
</BitBhToolbar>

<p class="toolbar-preview" style="@PreviewStyle">
    The quick brown fox jumps over the lazy dog.
</p>

<span class="demo-output">
