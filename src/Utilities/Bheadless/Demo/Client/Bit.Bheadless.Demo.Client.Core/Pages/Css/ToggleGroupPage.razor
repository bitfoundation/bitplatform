    // ── CSS (mirrors wwwroot/demos/toggle-group.css) ───────────────────────────

    private const string _toggleBtnCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.toggle-btn {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #fff;
    color: #3f3f46;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
}

.toggle-btn:hover:enabled { background: #f4f4f5; }
.toggle-btn:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }

/* aria-pressed="true" / data-state="on" while pressed */
.toggle-btn[data-state="on"] {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #1d4ed8;
}

.toggle-btn[data-state="on"]:hover:enabled { background: #dbeafe; }
""";

    private const string _toggleCss = _toggleBtnCss + """


.toggle-btn[data-disabled] { opacity: 0.5; cursor: not-allowed; }

/* Demo layout */
.toggle-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }

.toggle-output { margin: 0; font-size: 0.85rem; color: #71717a; }
.toggle-output strong { color: #18181b; font-weight: 600; }
""";

    private const string _templateCss = _toggleBtnCss + """


.toggle-icon { font-size: 1rem; line-height: 1; }

.toggle-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
""";

    private const string _groupCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.toggle-group {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.6rem;
    background: #f4f4f5;
}

.toggle-item {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.25rem;
    height: 2rem;
    padding: 0 0.6rem;
    border-radius: 0.4rem;
    color: #52525b;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease, box-shadow 120ms ease;
}

.toggle-item:hover:enabled:not([data-state="on"]) { background: #e4e4e7; color: #18181b; }
.toggle-item:focus-visible { outline: 2px solid #2563eb; outline-offset: 1px; }

/* data-state="on": aria-checked="true" (Single) or aria-pressed="true" (Multiple) */
.toggle-item[data-state="on"] {
    background: #fff;
    color: #2563eb;
    box-shadow: 0 1px 2px rgba(24, 24, 27, 0.12);
}
""";

    private const string _previewCss = """


/* Demo layout */
.toggle-demo {
    display: grid;
    gap: 1rem;
    width: 100%;
    justify-items: start;
}

.toggle-preview {
    width: 100%;
    max-width: 28rem;
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.95rem;
    color: #27272a;
}
""";

    private const string _multipleCss = _groupCss + _previewCss + """


.toggle-output { margin: 0; font-size: 0.85rem; color: #71717a; }
.toggle-output strong { color: #18181b; font-weight: 600; }
""";

    private const string _singleCss = _groupCss + _previewCss;

    private const string _verticalCss = _groupCss + """


/* data-orientation="vertical" when Orientation="BitBhRovingOrientation.Vertical" */
.toggle-group[data-orientation="vertical"] { flex-direction: column; min-width: 9rem; }
.toggle-group[data-orientation="vertical"] .toggle-item { justify-content: flex-start; }

.toggle-check { display: inline-block; width: 1rem; color: #2563eb; }
""";

    private const string _disabledCss = _groupCss + """


/* Hooks emitted for disabled items / groups */
.toggle-group[data-disabled]      { opacity: 0.6; }
.toggle-item[data-disabled] { opacity: 0.4; cursor: not-allowed; }

.toggle-demo { display: grid; gap: 1rem; width: 100%; justify-items: start; }
""";
