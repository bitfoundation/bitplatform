    private const string _virtualCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.listbox-anchored { display: inline-block; min-width: 14rem; }

.listbox-button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.9rem;
    cursor: pointer;
}
.listbox-button:focus-visible      { outline: 2px solid #2563eb; outline-offset: 2px; }
.listbox-button[data-state="open"] { border-color: #2563eb; }

/* Button without content: add the chevron with CSS, mute the placeholder */
.listbox-button-auto::after         { content: "\25BE"; color: #71717a; }
.listbox-button-auto[data-placeholder] { color: #71717a; }

/* Virtualized panel: a fixed-height scroll container (positioned by Anchor) */
.listbox-virtual {
    z-index: 9999;
    width: var(--button-width);
    height: 16rem;
    overflow-y: auto;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
}
.listbox-virtual[hidden] { display: none; }

/* Data-driven options carry no class — target the role.
   Every option must be exactly ItemSize (36px) tall. */
.listbox-virtual > [role="option"] {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 36px;
    box-sizing: border-box;
    padding: 0 0.65rem;
    border-radius: 0.35rem;
    font-size: 0.9rem;
    white-space: nowrap;
    cursor: pointer;
}
.listbox-virtual > [role="option"][data-active]   { background: #eff6ff; }
.listbox-virtual > [role="option"][data-selected] { font-weight: 600; }

.listbox-virtual-check { width: 1rem; color: #2563eb; font-weight: 700; }
""";

