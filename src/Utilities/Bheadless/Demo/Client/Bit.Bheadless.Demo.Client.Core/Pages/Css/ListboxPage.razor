    private const string _listboxCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.listbox          { position: relative; display: inline-block; min-width: 14rem; }

.listbox-button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.85rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.9rem;
    cursor: pointer;
}

.listbox-button:focus-visible       { outline: 2px solid #2563eb; outline-offset: 2px; }
.listbox-button[data-state="open"]  { border-color: #2563eb; }
.listbox-button[data-disabled]      { opacity: 0.5; cursor: not-allowed; }

