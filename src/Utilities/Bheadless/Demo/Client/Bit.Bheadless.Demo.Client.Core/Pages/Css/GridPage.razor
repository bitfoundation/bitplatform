@page "/grid"

<PageTitle>Grid / TreeGrid — bit Bheadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Grid / TreeGrid</h1>
        <p>An interactive two-dimensional widget — data tables, spreadsheets-lite, file trees with columns, calendars — with roving cell focus, row selection, sorting and expandable rows.</p>
        <SectionSwitcher Slug="grid" />
    </header>

    <DemoBlock Title="Sortable data grid"
               Code="@_sortCode"
               Css="@_sortCss">
        <Description>
            The WAI-ARIA Data Grid pattern on a real <code>&lt;table&gt;</code> (<code>As="table"</code> /
            <code>"thead"</code> / <code>"tbody"</code> / <code>"tr"</code> / <code>"th"</code> / <code>"td"</code>).
            The grid is a single tab stop: arrow keys move between cells, Home / End jump to the ends of the row,
            Ctrl + Home / End to the corners, PageUp / PageDown move by <code>PageSize</code> rows. Column headers are
            cells too — click one or press Enter on it and its <code>OnActivate</code> toggles the sort, which
            <code>Sort</code> announces as <code>aria-sort</code>.
        </Description>
        <LiveContent>
            <div class="datagrid-demo">
                <div class="datagrid-frame">
                    <BitBhGrid As="table" aria-label="Planets" class="datagrid">
                        <BitBhGridRowGroup As="thead">
                            <BitBhGridRow As="tr" IsHeaderRow="true">
                                <BitBhGridCell As="th" Header="true" class="datagrid-sortable"
                                            Sort="@(SortOf("name"))" OnActivate="@(() => SortBy("name"))">
                                    Planet<span class="datagrid-sort" aria-hidden="true">▲</span>
                                </BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="datagrid-sortable"
                                            Sort="@(SortOf("type"))" OnActivate="@(() => SortBy("type"))">
                                    Type<span class="datagrid-sort" aria-hidden="true">▲</span>
                                </BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="datagrid-sortable num"
                                            Sort="@(SortOf("diameter"))" OnActivate="@(() => SortBy("diameter"))">
                                    Diameter<span class="datagrid-sort" aria-hidden="true">▲</span>
                                </BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="datagrid-sortable num"
                                            Sort="@(SortOf("moons"))" OnActivate="@(() => SortBy("moons"))">
                                    Moons<span class="datagrid-sort" aria-hidden="true">▲</span>
                                </BitBhGridCell>
                            </BitBhGridRow>
                        </BitBhGridRowGroup>
                        <BitBhGridRowGroup As="tbody">
                            @foreach (var planet in SortedPlanets)
                            {
                                <BitBhGridRow As="tr" @key="planet.Name" Key="@planet.Name">
                                    <BitBhGridCell As="th" RowHeader="true">@planet.Name</BitBhGridCell>
                                    <BitBhGridCell As="td">@planet.Type</BitBhGridCell>
                                    <BitBhGridCell As="td" class="num">@planet.DiameterKm.ToString("N0") km</BitBhGridCell>
                                    <BitBhGridCell As="td" class="num">@planet.Moons</BitBhGridCell>
                                </BitBhGridRow>
                            }
                        </BitBhGridRowGroup>
                    </BitBhGrid>
                </div>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Multi-row selection"
               Code="@_selectionCode"
               Css="@_selectionCss">
        <Description>
            <code>SelectionMode="BitBhGridSelectionMode.Multiple"</code> with <code>@@bind-SelectedKeys</code> (every
            data row needs a <code>Key</code>). Click toggles a row and Shift + click selects a range; Space toggles
            the focused row, Shift + Space or Shift + Up / Down extend the selection, Ctrl + A selects every row.
            Rows get <code>aria-selected</code>, so the check boxes are pure CSS; the header box uses
            <code>OnActivate</code> to select or clear everything.
        </Description>
        <LiveContent>
            <div class="datagrid-demo">
                <div class="datagrid-toolbar">
                    <span><strong>@selectedInvoices.Count</strong> selected · total <strong>@FormatMoney(SelectedTotal)</strong></span>
                    <button type="button" class="datagrid-button" disabled="@(selectedInvoices.Count == 0)"
                            @onclick="ClearInvoices">Clear selection</button>
                </div>

                <div class="datagrid-frame">
                    <BitBhGrid As="table" aria-label="Invoices" class="datagrid datagrid-selectable"
                            SelectionMode="BitBhGridSelectionMode.Multiple"
                            @bind-SelectedKeys="selectedInvoices">
                        <BitBhGridRowGroup As="thead">
                            <BitBhGridRow As="tr" IsHeaderRow="true">
                                <BitBhGridCell As="th" Header="true" class="datagrid-check-cell" OnActivate="ToggleAllInvoices">
                                    <BitBhVisuallyHidden>Select all</BitBhVisuallyHidden>
                                    <span class="datagrid-check" data-checked="@AllInvoicesState" aria-hidden="true"></span>
                                </BitBhGridCell>
                                <BitBhGridCell As="th" Header="true">Invoice</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true">Customer</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true">Status</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="num">Amount</BitBhGridCell>
                            </BitBhGridRow>
                        </BitBhGridRowGroup>
                        <BitBhGridRowGroup As="tbody">
                            @foreach (var invoice in invoices)
                            {
                                <BitBhGridRow As="tr" @key="invoice.Id" Key="@invoice.Id">
                                    <BitBhGridCell As="td" class="datagrid-check-cell">
                                        <span class="datagrid-check" aria-hidden="true"></span>
                                    </BitBhGridCell>
                                    <BitBhGridCell As="td">@invoice.Id</BitBhGridCell>
                                    <BitBhGridCell As="td">@invoice.Customer</BitBhGridCell>
                                    <BitBhGridCell As="td">
                                        <span class="datagrid-badge" data-status="@invoice.Status.ToLowerInvariant()">@invoice.Status</span>
                                    </BitBhGridCell>
                                    <BitBhGridCell As="td" class="num">@FormatMoney(invoice.Amount)</BitBhGridCell>
                                </BitBhGridRow>
                            }
                        </BitBhGridRowGroup>
                    </BitBhGrid>
                </div>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Row activation"
               Code="@_activationCode"
               Css="@_activationCss">
        <Description>
            <code>OnRowActivate</code> fires with the row's <code>Key</code> when the user presses Enter on any of its
            cells or double-clicks it — open a message, navigate to a record, start editing. Here
            <code>BitBhGridSelectionMode.Single</code> marks the current row, and opening a message marks it as read.
        </Description>
        <LiveContent>
            <div class="datagrid-demo">
                <div class="datagrid-frame">
                    <BitBhGrid As="table" aria-label="Inbox" class="datagrid datagrid-selectable"
                            SelectionMode="BitBhGridSelectionMode.Single"
                            @bind-SelectedKeys="selectedMessage"
                            OnRowActivate="OpenMessage">
                        <BitBhGridRowGroup As="thead">
                            <BitBhGridRow As="tr" IsHeaderRow="true">
                                <BitBhGridCell As="th" Header="true">From</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true">Subject</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="num">Received</BitBhGridCell>
                            </BitBhGridRow>
                        </BitBhGridRowGroup>
                        <BitBhGridRowGroup As="tbody">
                            @foreach (var message in messages)
                            {
                                <BitBhGridRow As="tr" @key="message.Id" Key="@message.Id"
                                           data-unread="@(!readMessages.Contains(message.Id))">
                                    <BitBhGridCell As="td"><span class="datagrid-dot" aria-hidden="true"></span>@message.From</BitBhGridCell>
                                    <BitBhGridCell As="td">@message.Subject</BitBhGridCell>
                                    <BitBhGridCell As="td" class="num">@message.Received</BitBhGridCell>
                                </BitBhGridRow>
                            }
                        </BitBhGridRowGroup>
                    </BitBhGrid>
                </div>

                @if (OpenedMessage is { } opened)
                {
                    <div class="datagrid-preview">
                        <strong>@opened.Subject</strong>
                        From @opened.From — @opened.Body
                    </div>
                }
                else
                {
                    <p class="datagrid-output">Press Enter on a row, or double-click it, to open the message.</p>
                }
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="TreeGrid"
               Code="@_treeGridCode"
               Css="@_treeGridCss">
        <Description>
            <code>TreeGrid="true"</code> renders <code>role="treegrid"</code>. Give each row its <code>Level</code>,
            <code>HasChildren</code> and <code>ParentKey</code>: rows under a collapsed folder get the
            <code>hidden</code> attribute and are skipped by the keyboard. On a row's first cell, Right expands it
            (then moves into the row) and Left collapses it (then jumps to the parent row). The chevron is a
            <code>BitBhGridRowToggle</code>: a mouse shortcut, hidden from assistive tech, that toggles the row (synced through <code>@@bind-ExpandedKeys</code>); indentation comes from the
            <code>--bit-bh-grid-level</code> variable on each row.
        </Description>
        <LiveContent>
            <div class="datagrid-demo">
                <div class="datagrid-frame">
                    <BitBhGrid As="table" TreeGrid="true" aria-label="Project files" class="datagrid datagrid-selectable"
                            SelectionMode="BitBhGridSelectionMode.Single"
                            @bind-SelectedKeys="selectedEntry"
                            @bind-ExpandedKeys="expandedFolders">
                        <BitBhGridRowGroup As="thead">
                            <BitBhGridRow As="tr" IsHeaderRow="true">
                                <BitBhGridCell As="th" Header="true">Name</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true">Kind</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="num">Size</BitBhGridCell>
                            </BitBhGridRow>
                        </BitBhGridRowGroup>
                        <BitBhGridRowGroup As="tbody">
                            @foreach (var entry in fileSystem)
                            {
                                <BitBhGridRow As="tr" @key="entry.Path" Key="@entry.Path"
                                           Level="entry.Level" ParentKey="@entry.Parent" HasChildren="entry.IsFolder">
                                    <BitBhGridCell As="td">
                                        <span class="treegrid-name">
                                            @if (entry.IsFolder)
                                            {
                                                <BitBhGridRowToggle class="treegrid-toggle">▸</BitBhGridRowToggle>
                                                <span>@(expandedFolders.Contains(entry.Path) ? "📂" : "📁")</span>
                                            }
                                            else
                                            {
                                                <span class="treegrid-spacer"></span>
                                                <span>📄</span>
                                            }
                                            @entry.Name
                                        </span>
                                    </BitBhGridCell>
                                    <BitBhGridCell As="td">@entry.Kind</BitBhGridCell>
                                    <BitBhGridCell As="td" class="num">@FormatSize(SizeOf(entry))</BitBhGridCell>
                                </BitBhGridRow>
                            }
                        </BitBhGridRowGroup>
                    </BitBhGrid>
                </div>

                <p class="datagrid-output">Selected: <strong>@(selectedEntry.FirstOrDefault() ?? "(none)")</strong></p>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Div-based grid (calendar)"
               Code="@_calendarCode"
               Css="@_calendarCss">
        <Description>
            <code>BitBhGrid</code>, <code>BitBhGridRowGroup</code>, <code>BitBhGridRow</code> and <code>BitBhGridCell</code> render
            <code>&lt;div&gt;</code>s with <code>role="grid"</code> / <code>"rowgroup"</code> / <code>"row"</code> /
            <code>"gridcell"</code> by default, so any layout works — here each row is a 7-column CSS grid. Arrow keys
            move by day and week, Home / End go to the start / end of the week, and Enter or a click picks a date
            through each cell's <code>OnActivate</code>. <code>aria-selected</code>, <code>aria-current</code> and
            <code>aria-disabled</code> on the cells are plain attributes set by the page.
        </Description>
        <LiveContent>
            <div class="datagrid-demo">
                <div class="calendar-card">
                    <div id="grid-calendar-title" class="calendar-title">@MonthStart.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
                    <BitBhGrid aria-labelledby="grid-calendar-title" class="calendar">
                        <BitBhGridRowGroup>
                            <BitBhGridRow IsHeaderRow="true" class="calendar-row">
                                @foreach (var (shortName, longName) in weekdays)
                                {
                                    <BitBhGridCell Header="true" class="calendar-weekday">
                                        <abbr title="@longName">@shortName</abbr>
                                    </BitBhGridCell>
                                }
                            </BitBhGridRow>
                        </BitBhGridRowGroup>
                        <BitBhGridRowGroup class="calendar-weeks">
                            @foreach (var week in Weeks)
                            {
                                <BitBhGridRow class="calendar-row">
                                    @foreach (var day in week)
                                    {
                                        <BitBhGridCell class="calendar-day"
                                                    aria-selected="@(day == pickedDate ? "true" : null)"
                                                    aria-current="@(day == today ? "date" : null)"
                                                    aria-disabled="@(day.Month != MonthStart.Month ? "true" : null)"
                                                    OnActivate="() => PickDate(day)">@day.Day</BitBhGridCell>
                                    }
                                </BitBhGridRow>
                            }
                        </BitBhGridRowGroup>
                    </BitBhGrid>
                </div>

                <p class="datagrid-output">
                    Picked: <strong>@(pickedDate?.ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture) ?? "(none)")</strong>
                </p>
            </div>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    // ── Sortable data grid ───────────────────────────────────────────────────
    private sealed record Planet(string Name, string Type, int DiameterKm, int Moons);

    private readonly Planet[] planets =
    [
        new("Mercury", "Terrestrial", 4_879, 0),
        new("Venus", "Terrestrial", 12_104, 0),
        new("Earth", "Terrestrial", 12_756, 1),
        new("Mars", "Terrestrial", 6_792, 2),
        new("Jupiter", "Gas giant", 142_984, 95),
        new("Saturn", "Gas giant", 120_536, 146),
        new("Uranus", "Ice giant", 51_118, 28),
        new("Neptune", "Ice giant", 49_528, 16),
    ];

    private string sortColumn = "name";
    private BitBhSortDirection sortDirection = BitBhSortDirection.Ascending;

    private BitBhSortDirection SortOf(string column) => sortColumn == column ? sortDirection : BitBhSortDirection.None;

    private void SortBy(string column)
    {
        sortDirection = sortColumn == column && sortDirection == BitBhSortDirection.Ascending
            ? BitBhSortDirection.Descending
            : BitBhSortDirection.Ascending;
        sortColumn = column;
    }

    private IEnumerable<Planet> SortedPlanets
    {
        get
        {
            Func<Planet, object> key = sortColumn switch
            {
                "type" => p => p.Type,
                "diameter" => p => p.DiameterKm,
                "moons" => p => p.Moons,
                _ => p => p.Name,
            };
            return sortDirection == BitBhSortDirection.Descending ? planets.OrderByDescending(key) : planets.OrderBy(key);
        }
    }

    // ── Multi-row selection ──────────────────────────────────────────────────
    private sealed record Invoice(string Id, string Customer, string Status, decimal Amount);

    private readonly Invoice[] invoices =
    [
        new("INV-1042", "Acme Corp", "Paid", 1_250.00m),
        new("INV-1043", "Globex", "Pending", 830.50m),
        new("INV-1044", "Initech", "Overdue", 4_200.00m),
        new("INV-1045", "Umbrella", "Paid", 615.75m),
        new("INV-1046", "Hooli", "Pending", 2_980.00m),
        new("INV-1047", "Stark Industries", "Paid", 12_400.00m),
    ];

    private IReadOnlyCollection<string> selectedInvoices = [];

    private decimal SelectedTotal => invoices.Where(i => selectedInvoices.Contains(i.Id)).Sum(i => i.Amount);

    private string AllInvoicesState =>
        selectedInvoices.Count == 0 ? "false" : selectedInvoices.Count == invoices.Length ? "true" : "mixed";

    private void ToggleAllInvoices() =>
        selectedInvoices = selectedInvoices.Count == invoices.Length ? [] : invoices.Select(i => i.Id).ToArray();

    private void ClearInvoices() => selectedInvoices = [];

    private static string FormatMoney(decimal amount) =>
        "$" + amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    // ── Row activation ───────────────────────────────────────────────────────
    private sealed record Message(string Id, string From, string Subject, string Received, string Body);

    private readonly Message[] messages =
    [
        new("m1", "Ada Lovelace", "Notes on the Analytical Engine", "09:24", "I have attached my notes — see note G."),
        new("m2", "Grace Hopper", "Found a bug (an actual moth)", "08:51", "Taped it into the logbook for posterity."),
        new("m3", "Alan Turing", "Can machines think?", "Yesterday", "Let us play the imitation game this Friday."),
        new("m4", "Margaret Hamilton", "Priority displays", "Mon", "The guidance computer recovered beautifully."),
    ];

    private IReadOnlyCollection<string> selectedMessage = [];
    private readonly HashSet<string> readMessages = ["m3"];
    private string? openedMessageId;

    private Message? OpenedMessage => messages.FirstOrDefault(m => m.Id == openedMessageId);

    private void OpenMessage(string id)
    {
        openedMessageId = id;
        readMessages.Add(id);
    }

    // ── TreeGrid ─────────────────────────────────────────────────────────────
    private sealed record FsEntry(string Path, string Name, string Kind, long Bytes, int Level, string? Parent, bool IsFolder);

    // Flattened in document (depth-first) order.
    private readonly FsEntry[] fileSystem =
    [
        new("project", "project", "Folder", 0, 1, null, true),
        new("project/src", "src", "Folder", 0, 2, "project", true),
        new("project/src/app.ts", "app.ts", "TypeScript", 14_236, 3, "project/src", false),
        new("project/src/router.ts", "router.ts", "TypeScript", 6_812, 3, "project/src", false),
        new("project/src/styles.css", "styles.css", "Stylesheet", 3_154, 3, "project/src", false),
        new("project/assets", "assets", "Folder", 0, 2, "project", true),
        new("project/assets/logo.svg", "logo.svg", "SVG image", 2_048, 3, "project/assets", false),
        new("project/assets/hero.png", "hero.png", "PNG image", 482_113, 3, "project/assets", false),
        new("project/package.json", "package.json", "JSON", 1_240, 2, "project", false),
        new("project/README.md", "README.md", "Markdown", 4_502, 2, "project", false),
        new("notes.txt", "notes.txt", "Text", 1_024, 1, null, false),
    ];

    private IReadOnlyCollection<string> selectedEntry = [];
    private IReadOnlyCollection<string> expandedFolders = ["project", "project/src"];


    private long SizeOf(FsEntry entry) =>
        entry.IsFolder ? fileSystem.Where(e => e.Parent == entry.Path).Sum(e => SizeOf(e)) : entry.Bytes;

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB",
    };

    // ── Div-based grid (calendar) ────────────────────────────────────────────
    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? pickedDate;

    private readonly (string Short, string Long)[] weekdays =
    [
        ("Su", "Sunday"), ("Mo", "Monday"), ("Tu", "Tuesday"), ("We", "Wednesday"),
        ("Th", "Thursday"), ("Fr", "Friday"), ("Sa", "Saturday"),
    ];

    private DateOnly MonthStart => new(today.Year, today.Month, 1);

    // Whole weeks (Sunday → Saturday) covering the current month.
    private IEnumerable<DateOnly[]> Weeks
    {
        get
        {
            var monthEnd = MonthStart.AddMonths(1).AddDays(-1);
            for (var start = MonthStart.AddDays(-(int)MonthStart.DayOfWeek); start <= monthEnd; start = start.AddDays(7))
            {
                var weekStart = start;
                yield return Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToArray();
            }
        }
    }

    private void PickDate(DateOnly day)
    {
        if (day.Month == MonthStart.Month) pickedDate = day;
    }

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _sortCode = """
<div class="datagrid-frame">
    <BitBhGrid As="table" aria-label="Planets" class="datagrid">
        <BitBhGridRowGroup As="thead">
            <BitBhGridRow As="tr" IsHeaderRow="true">
                <BitBhGridCell As="th" Header="true" class="datagrid-sortable"
                            Sort="@(SortOf("name"))" OnActivate="@(() => SortBy("name"))">
                    Planet<span class="datagrid-sort" aria-hidden="true">▲</span>
                </BitBhGridCell>
                <BitBhGridCell As="th" Header="true" class="datagrid-sortable"
                            Sort="@(SortOf("type"))" OnActivate="@(() => SortBy("type"))">
                    Type<span class="datagrid-sort" aria-hidden="true">▲</span>
                </BitBhGridCell>
                <BitBhGridCell As="th" Header="true" class="datagrid-sortable num"
                            Sort="@(SortOf("diameter"))" OnActivate="@(() => SortBy("diameter"))">
                    Diameter<span class="datagrid-sort" aria-hidden="true">▲</span>
                </BitBhGridCell>
                <BitBhGridCell As="th" Header="true" class="datagrid-sortable num"
