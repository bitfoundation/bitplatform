                </BitBhGridCell>
            </BitBhGridRow>
        </BitBhGridRowGroup>
        <BitBhGridRowGroup As="tbody">
            @foreach (var planet in SortedPlanets)
            {
                <BitBhGridRow As="tr" @key="planet.Name" Key="@planet.Name">
                    <BitBhGridCell As="th" RowHeader="true">@planet.Name</BitBhGridCell>
                    <BitBhGridCell As="td">@planet.Type</BitBhGridCell>
                    <BitBhGridCell As="td" class="num">@planet.DiameterKm.ToString("N0") km</BitBhGridCell>
