@page "/date-picker"
@using System.ComponentModel.DataAnnotations
@using System.Globalization

<PageTitle>Date Picker · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Date Picker</h1>
    <p class="bb-subtitle">A segmented date input with a button that opens a calendar in a popover: type the date, or pick it.</p>
</div>

<SectionSwitcher Slug="date-picker" />

<DemoBlock Title="Date picker" Code="@_basicCode" Css="@_css">
    <Description>
        <code>BitBhDatePicker</code> is a date field — the segments type and step like <code>BitBhDateField</code> — whose
        <code>BitBhDatePickerTrigger</code> ("Choose date", <code>aria-haspopup="dialog"</code>) opens
        <code>BitBhDatePickerContent</code>: a non-modal dialog anchored under the group, named by the field's label. Opening
        moves the focus to the selected date (or today) in the calendar; picking a date closes it and returns the focus to the
        button, as do <kbd>Escape</kbd>, a click outside and tabbing away. <kbd>Alt</kbd>+↓ in the segments opens it too.
    </Description>
    <LiveContent>
        <div class="date-picker-demo">
            <BitBhField>
                <BitBhLabel class="date-picker-label">Departure</BitBhLabel>
                <BitBhDatePicker @bind-Value="departure" Culture="DemoDateCultures.EnUs">
                    <BitBhDatePickerGroup class="date-picker-group">
                        <BitBhDateFieldSegments />
                        <BitBhDatePickerTrigger class="date-picker-trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="date-picker-popover">
                        <BitBhCalendar class="calendar">
                            <div class="calendar-header">
                                <BitBhCalendarPrevious class="calendar-nav">‹</BitBhCalendarPrevious>
                                <BitBhCalendarHeading As="h3" class="calendar-heading" />
                                <BitBhCalendarNext class="calendar-nav">›</BitBhCalendarNext>
                            </div>
                            <BitBhCalendarGrid class="calendar-grid">
                                <BitBhCalendarCell Day="context" class="calendar-cell" />
                            </BitBhCalendarGrid>
                        </BitBhCalendar>
                    </BitBhDatePickerContent>
                </BitBhDatePicker>
            </BitBhField>
            <p class="date-picker-value">Value: <strong>@(departure?.ToString("D", DemoDateCultures.EnUs) ?? "none")</strong></p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="Date and time" Code="@_dateTimeCode" Css="@_css">
    <Description>
        <code>BitBhDateTimePicker</code> takes the same parts around a <code>BitBhDateTimeField</code>: the segments edit the
        date and the time (<code>Granularity</code>, <code>HourCycle</code>), and <code>@@bind-Value</code> is a
        <code>DateTime?</code>. The calendar picks the date and keeps the time — the time typed, or midnight.
    </Description>
    <LiveContent>
        <div class="date-picker-demo">
            <BitBhField>
                <BitBhLabel class="date-picker-label">Appointment</BitBhLabel>
                <BitBhDateTimePicker @bind-Value="appointment" Culture="DemoDateCultures.EnUs">
                    <BitBhDatePickerGroup class="date-picker-group">
                        <BitBhDateFieldSegments />
                        <BitBhDatePickerTrigger class="date-picker-trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="date-picker-popover">
                        <BitBhCalendar class="calendar">
                            <div class="calendar-header">
                                <BitBhCalendarPrevious class="calendar-nav">‹</BitBhCalendarPrevious>
                                <BitBhCalendarHeading As="h3" class="calendar-heading" />
                                <BitBhCalendarNext class="calendar-nav">›</BitBhCalendarNext>
                            </div>
                            <BitBhCalendarGrid class="calendar-grid">
                                <BitBhCalendarCell Day="context" class="calendar-cell" />
                            </BitBhCalendarGrid>
                        </BitBhCalendar>
                    </BitBhDatePickerContent>
                </BitBhDateTimePicker>
            </BitBhField>
            <p class="date-picker-value date-time-picker-value">Value: <strong>@(appointment?.ToString("f", DemoDateCultures.EnUs) ?? "none")</strong></p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="Limits and unavailable dates" Code="@_limitsCode" Css="@_css">
    <Description>
        <code>Min</code>, <code>Max</code> and <code>IsDateUnavailable</code> go to the calendar (unless it is given its own):
        weekends here are unavailable and only the next three months can be picked. A typed date that breaks them is kept and
        marks the picker invalid (<code>data-invalid</code>, <code>aria-invalid</code>) — type a Saturday to see it.
    </Description>
    <LiveContent>
        <div class="date-picker-demo">
            <BitBhField>
                <BitBhLabel class="date-picker-label">Delivery</BitBhLabel>
                <BitBhDatePicker @bind-Value="delivery" Min="today" Max="today.AddMonths(3)" IsDateUnavailable="IsWeekend"
                                 Culture="DemoDateCultures.EnUs">
                    <BitBhDatePickerGroup class="date-picker-group">
                        <BitBhDateFieldSegments />
                        <BitBhDatePickerTrigger class="date-picker-trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="date-picker-popover">
                        <BitBhCalendar class="calendar">
                            <div class="calendar-header">
                                <BitBhCalendarPrevious class="calendar-nav">‹</BitBhCalendarPrevious>
                                <BitBhCalendarHeading As="h3" class="calendar-heading" />
                                <BitBhCalendarNext class="calendar-nav">›</BitBhCalendarNext>
                            </div>
                            <BitBhCalendarGrid class="calendar-grid">
                                <BitBhCalendarCell Day="context" class="calendar-cell" />
                            </BitBhCalendarGrid>
                        </BitBhCalendar>
                    </BitBhDatePickerContent>
                </BitBhDatePicker>
                <BitBhDescription class="date-picker-description">Weekdays in the next three months.</BitBhDescription>
            </BitBhField>
            <p class="date-picker-value">Value: <strong>@(delivery?.ToString("D", DemoDateCultures.EnUs) ?? "none")</strong></p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="In a German form" Code="@_formCode" Css="@_css">
    <Description>
        The picker joins <code>EditForm</code> validation through <code>@@bind-Value</code>; <code>BitBhErrorMessage</code>
        describes the group once invalid, and <code>Name</code> posts a hidden <code>yyyy-MM-dd</code> input. With a German
        <code>Culture</code> the segments read <code>dd.MM.yyyy</code> and the calendar starts its weeks on Monday.
    </Description>
    <LiveContent>
        <EditForm Model="form" OnValidSubmit="() => sent = form.Birthday">
            <DataAnnotationsValidator />
            <BitBhField>
                <BitBhLabel class="date-picker-label">Geburtstag</BitBhLabel>
                <BitBhDatePicker @bind-Value="form.Birthday" Max="today" Name="birthday" Culture="DemoDateCultures.DeDe">
                    <BitBhDatePickerGroup class="date-picker-group">
                        <BitBhDateFieldSegments />
                        <BitBhDatePickerTrigger aria-label="Datum wählen" class="date-picker-trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="date-picker-popover">
                        <BitBhCalendar class="calendar">
                            <div class="calendar-header">
                                <BitBhCalendarPrevious aria-label="Vorheriger Monat" class="calendar-nav">‹</BitBhCalendarPrevious>
                                <BitBhCalendarHeading As="h3" class="calendar-heading" />
                                <BitBhCalendarNext aria-label="Nächster Monat" class="calendar-nav">›</BitBhCalendarNext>
                            </div>
                            <BitBhCalendarGrid Context="day" class="calendar-grid">
                                <BitBhCalendarCell Day="day" class="calendar-cell" />
                            </BitBhCalendarGrid>
                        </BitBhCalendar>
                    </BitBhDatePickerContent>
                </BitBhDatePicker>
                <BitBhErrorMessage class="date-picker-error" />
            </BitBhField>
            <button type="submit" class="date-picker-submit">Senden</button>
            @if (sent is { } birthday)
            {
                <p class="date-picker-value">Gesendet: <strong>@birthday.ToString("D", DemoDateCultures.DeDe)</strong></p>
            }
        </EditForm>
    </LiveContent>
</DemoBlock>

@code {
    private static readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? departure;
    private DateTime? appointment;
    private DateOnly? delivery;
    private readonly BirthdayForm form = new();
    private DateOnly? sent;

    private static bool IsWeekend(DateOnly d) => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    private sealed class BirthdayForm
    {
        [Required(ErrorMessage = "Bitte ein Datum eingeben.")]
        public DateOnly? Birthday { get; set; }
    }

    private static readonly RenderFragment CalendarIcon =
        @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
        </svg>;

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _calendar = """
        <BitBhDatePickerContent class="date-picker-popover">
            <BitBhCalendar class="calendar">
                <div class="calendar-header">
