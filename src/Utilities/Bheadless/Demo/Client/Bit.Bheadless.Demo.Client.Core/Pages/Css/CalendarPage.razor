@page "/calendar"
@using System.ComponentModel.DataAnnotations
@using System.Globalization

<PageTitle>Calendar · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Calendar</h1>
    <p class="bb-subtitle">Month grids to pick a date, a range or several dates from — the WAI-ARIA date grid with one tab stop, full keyboard support, limits, unavailable dates and the reader's own calendar.</p>
</div>

<SectionSwitcher Slug="calendar" />

<DemoBlock Title="Single date" Code="@_singleCode" Css="@_css">
    <Description>
        <code>BitBhCalendarGrid</code> is a <code>&lt;table role="grid"&gt;</code> named by the heading; each date is a
        <code>gridcell</code> named by the full date, with <code>aria-selected</code> and <code>aria-current="date"</code>
        on today. The grid is one tab stop: ← / → move a day, ↑ / ↓ a week, <kbd>PageUp</kbd> / <kbd>PageDown</kbd> a month
        (<kbd>Shift</kbd>: a year), <kbd>Home</kbd> / <kbd>End</kbd> to the ends of the week, <kbd>Enter</kbd> or
        <kbd>Space</kbd> select. Moving past the month shows the next one. The previous / next buttons keep the focus and
        announce the month they show.
    </Description>
    <LiveContent>
        <div class="calendar-demo">
            <BitBhCalendar @bind-Value="date" Culture="DemoDateCultures.EnUs" aria-label="Appointment" class="calendar">
                <div class="calendar-header">
                    <BitBhCalendarPrevious class="calendar-nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="calendar-heading" />
                    <BitBhCalendarNext class="calendar-nav">›</BitBhCalendarNext>
                </div>
                <BitBhCalendarGrid class="calendar-grid">
                    <BitBhCalendarCell Day="context" class="calendar-cell" />
                </BitBhCalendarGrid>
            </BitBhCalendar>
            <p class="calendar-value">Selected: <strong>@(date?.ToString("D", DemoDateCultures.EnUs) ?? "none")</strong></p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="A range across two months" Code="@_rangeCode" Css="@_css">
    <Description>
        <code>@@bind-Range</code> makes it a range calendar: the first press sets one end, the range follows the pointer
        and the focus (<code>data-highlighted</code>) until the second press, and <kbd>Escape</kbd> drops a half-picked
        range. <code>VisibleMonths="2"</code> with a grid per <code>Offset</code> shows two months; the buttons page by two.
        Booked nights are <code>IsDateUnavailable</code>: focusable and announced, not selectable — and a range can't span
        them (<code>AllowsNonContiguousRanges</code> lifts that).
    </Description>
    <LiveContent>
        <div class="calendar-demo">
            <BitBhCalendar @bind-Range="stay" VisibleMonths="2" IsDateUnavailable="IsBooked" Min="today"
                           Culture="DemoDateCultures.EnUs" aria-label="Stay" class="calendar">
                <div class="calendar-header">
                    <BitBhCalendarPrevious class="calendar-nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="calendar-heading" />
                    <BitBhCalendarNext class="calendar-nav">›</BitBhCalendarNext>
                </div>
                <div class="calendar-months">
                    @for (var i = 0; i < 2; i++)
                    {
                        var offset = i;
                        <div>
                            <BitBhCalendarHeading Offset="offset" As="h4" class="calendar-month-title" aria-hidden="true" />
                            <BitBhCalendarGrid Offset="offset" class="calendar-grid">
                                <BitBhCalendarCell Day="context" class="calendar-cell" />
                            </BitBhCalendarGrid>
                        </div>
                    }
                </div>
            </BitBhCalendar>
            <p class="calendar-value">
                Stay: <strong>@(stay is null ? "none" : $"{stay.Start.ToString("MMM d", DemoDateCultures.EnUs)} – {stay.End.ToString("MMM d", DemoDateCultures.EnUs)} ({stay.Days - 1} nights)")</strong>
            </p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="Limits, weekends and outside days" Code="@_limitsCode" Css="@_css">
    <Description>
        <code>Min</code> / <code>Max</code> disable the dates outside them (<code>aria-disabled</code>, <code>data-disabled</code>,
        not focusable): the arrow keys stop at the limits and the buttons are <code>aria-disabled</code> at the last month.
        Weekends are unavailable here (<code>data-unavailable</code>). <code>ShowOutsideDays</code> fills the first and last
        weeks with the neighbouring months' dates (<code>data-outside-month</code>), hidden from assistive technology.
    </Description>
    <LiveContent>
        <div class="calendar-demo">
            <BitBhCalendar @bind-Value="delivery" Min="today.AddDays(1)" Max="today.AddMonths(2)" ShowOutsideDays="true"
                           IsDateUnavailable="d => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday"
                           Culture="DemoDateCultures.EnUs" aria-label="Delivery date" class="calendar">
                <div class="calendar-header">
                    <BitBhCalendarPrevious class="calendar-nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="calendar-heading" />
                    <BitBhCalendarNext class="calendar-nav">›</BitBhCalendarNext>
                </div>
                <BitBhCalendarGrid WeekdayFormat="BitBhCalendarWeekdayFormat.Abbreviated" class="calendar-grid">
                    <BitBhCalendarCell Day="context" class="calendar-cell" />
                </BitBhCalendarGrid>
            </BitBhCalendar>
            <p class="calendar-value">Delivery: <strong>@(delivery?.ToString("D", DemoDateCultures.EnUs) ?? "none")</strong></p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="Cultures, calendars and right to left" Code="@_cultureCode" Css="@_css">
    <Description>
        <code>Culture</code> sets the month and day names, the first day of the week and the calendar itself: the German
        week starts on Monday; the Persian culture shows the Persian calendar's months (its year starts in March) and, in a
        right-to-left page, ← / → are mirrored. The value is a <code>DateOnly</code> either way. (This WebAssembly demo
        runs without ICU, where the Persian calendar isn't available.)
    </Description>
    <LiveContent>
        <div class="calendar-demo">
            <BitBhCalendar @bind-Value="cultureDate" Culture="DemoDateCultures.DeDe" aria-label="Datum" class="calendar">
                <div class="calendar-header">
                    <BitBhCalendarPrevious aria-label="Vorheriger Monat" class="calendar-nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="calendar-heading" />
                    <BitBhCalendarNext aria-label="Nächster Monat" class="calendar-nav">›</BitBhCalendarNext>
                </div>
                <BitBhCalendarGrid class="calendar-grid">
                    <BitBhCalendarCell Day="context" class="calendar-cell" />
                </BitBhCalendarGrid>
            </BitBhCalendar>
            @if (DemoDateCultures.FaIr is { } persian)
            {
                <div dir="rtl" lang="fa">
                    <BitBhCalendar @bind-Value="cultureDate" Culture="persian" Dir="BitBhDirection.Rtl" aria-label="تاریخ" class="calendar">
                        <div class="calendar-header">
                            <BitBhCalendarPrevious aria-label="ماه قبل" class="calendar-nav">›</BitBhCalendarPrevious>
                            <BitBhCalendarHeading As="h3" class="calendar-heading" />
                            <BitBhCalendarNext aria-label="ماه بعد" class="calendar-nav">‹</BitBhCalendarNext>
                        </div>
                        <BitBhCalendarGrid class="calendar-grid">
                            <BitBhCalendarCell Day="context" class="calendar-cell" />
                        </BitBhCalendarGrid>
                    </BitBhCalendar>
                </div>
            }
            <p class="calendar-value">Value: <strong>@(cultureDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "none")</strong></p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="Several dates" Code="@_multipleCode" Css="@_css">
    <Description>
        <code>@@bind-Values</code> selects any number of dates; each press toggles one. The grid is
        <code>aria-multiselectable</code>. A cell's <code>Template</code> receives the day's state — used here to mark
        the dates that already have a shift.
    </Description>
    <LiveContent>
        <div class="calendar-demo">
            <BitBhCalendar @bind-Values="shifts" Culture="DemoDateCultures.EnUs" aria-label="Shifts" class="calendar">
                <div class="calendar-header">
                    <BitBhCalendarPrevious class="calendar-nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="calendar-heading" />
                    <BitBhCalendarNext class="calendar-nav">›</BitBhCalendarNext>
                </div>
                <BitBhCalendarGrid class="calendar-grid">
                    <BitBhCalendarCell Day="context" class="calendar-cell">
                        <Template Context="day">@day.Text@(day.IsSelected ? "•" : "")</Template>
                    </BitBhCalendarCell>
                </BitBhCalendarGrid>
            </BitBhCalendar>
            <p class="calendar-value">Shifts: <strong>@(shifts.Count == 0 ? "none" : string.Join(", ", shifts.Select(d => d.ToString("MMM d", DemoDateCultures.EnUs))))</strong></p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="In a form" Code="@_formCode" Css="@_css">
    <Description>
        In a <code>BitBhField</code> the calendar's group is labelled by <code>BitBhLabel</code> and described by
        <code>BitBhDescription</code> and, once invalid, <code>BitBhErrorMessage</code>; clicking the label focuses the
        focused date. <code>@@bind-Value</code> takes part in <code>EditForm</code> validation, and <code>Name</code> posts a
        hidden <code>yyyy-MM-dd</code> input.
    </Description>
    <LiveContent>
        <EditForm Model="booking" OnValidSubmit="() => submitted = booking.CheckIn">
            <DataAnnotationsValidator />
            <BitBhField>
                <BitBhLabel class="calendar-label">Check-in</BitBhLabel>
                <BitBhCalendar @bind-Value="booking.CheckIn" Min="today" Name="checkin" Culture="DemoDateCultures.EnUs" class="calendar">
                    <div class="calendar-header">
                        <BitBhCalendarPrevious class="calendar-nav">‹</BitBhCalendarPrevious>
                        <BitBhCalendarHeading As="h3" class="calendar-heading" />
                        <BitBhCalendarNext class="calendar-nav">›</BitBhCalendarNext>
                    </div>
                    <BitBhCalendarGrid Context="day" class="calendar-grid">
                        <BitBhCalendarCell Day="day" class="calendar-cell" />
                    </BitBhCalendarGrid>
                </BitBhCalendar>
                <BitBhDescription class="calendar-description">Check-in is from 3 pm.</BitBhDescription>
                <BitBhErrorMessage class="calendar-error" />
            </BitBhField>
            <button type="submit" class="calendar-submit">Book</button>
            @if (submitted is { } checkIn)
            {
                <p class="calendar-value">Booked from <strong>@checkIn.ToString("D", DemoDateCultures.EnUs)</strong>.</p>
            }
        </EditForm>
    </LiveContent>
</DemoBlock>

