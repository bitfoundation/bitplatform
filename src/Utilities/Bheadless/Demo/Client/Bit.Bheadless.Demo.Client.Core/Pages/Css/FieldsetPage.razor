    // ── Styles (these are appended to wwwroot/app.css; here they're shown for documentation) ──

    private const string _basicCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.fieldset {
    /* Reset native <fieldset> defaults and re-style as a card */
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin: 0;
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    max-width: 28rem;
}

.fieldset-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid #f4f4f5;
}

.fieldset-legend {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
}

.fieldset-hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
}

/* Field primitives used inside the fieldset */
.field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
}

.field-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #18181b;
}

.field-label[data-disabled] { opacity: 0.5; }

.field-input {
    padding: 0.5rem 0.75rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.4rem;
    font-size: 0.9rem;
    font-family: inherit;
    color: #18181b;
    background: #fff;
    transition: border-color 120ms ease;
}

.field-input:hover          { border-color: #a1a1af; }
.field-input:focus-visible  { outline: 2px solid #2563eb; outline-offset: 1px; }
.field-input[data-disabled] { opacity: 0.5; cursor: not-allowed; background: #fafafa; }

.field-select   { appearance: none; padding-right: 2rem; }
.field-textarea { resize: vertical; min-height: 4rem; }
""";

