@page "/accordion"

<PageTitle>Accordion — bit Bheadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Accordion</h1>
        <p>A vertically stacked set of collapsible sections, single or multiple open at a time.</p>
        <SectionSwitcher Slug="accordion" />
    </header>

    <DemoBlock Title="Basic Accordion (Single)"
               Code="@_basicCode"
               Css="@_accordionCss">
        <Description>
            Only one item can be open at a time. <code>DefaultValue</code> seeds the initial open item.
            Each trigger gets <code>aria-expanded</code> and <code>aria-controls</code> automatically.
        </Description>
        <LiveContent>
            <BitBhAccordion DefaultValue="item-1" class="accordion">
                <BitBhAccordionItem Value="item-1" class="accordion-item">
                    <BitBhAccordionTrigger class="accordion-trigger">
                        <Template Context="t">
                            What is bit Bheadless?
                            <span class="accordion-chevron @(t.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhAccordionTrigger>
                    <BitBhAccordionContent class="accordion-content">
                        <div class="accordion-body">
                            bit Bheadless is a headless component library for Blazor.
                            Behaviour and accessibility are built in; styling is entirely up to you.
                        </div>
                    </BitBhAccordionContent>
                </BitBhAccordionItem>

                <BitBhAccordionItem Value="item-2" class="accordion-item">
                    <BitBhAccordionTrigger class="accordion-trigger">
                        <Template Context="t">
                            Why headless?
                            <span class="accordion-chevron @(t.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhAccordionTrigger>
                    <BitBhAccordionContent class="accordion-content">
                        <div class="accordion-body">
                            You own the look and feel entirely. ARIA and keyboard support never have to be
                            re-implemented.
                        </div>
                    </BitBhAccordionContent>
                </BitBhAccordionItem>

                <BitBhAccordionItem Value="item-3" class="accordion-item">
                    <BitBhAccordionTrigger class="accordion-trigger">
                        <Template Context="t">
                            How do I style it?
                            <span class="accordion-chevron @(t.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhAccordionTrigger>
                    <BitBhAccordionContent class="accordion-content">
                        <div class="accordion-body">
                            Use <code>data-state="open"|"closed"</code> on any element, or just apply
                            classes. The library emits no styles of its own.
                        </div>
                    </BitBhAccordionContent>
                </BitBhAccordionItem>
            </BitBhAccordion>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Multiple Open Items"
               Code="@_multipleCode"
               Css="@_multipleCss">
        <Description>
            Set <code>Type="BitBhAccordionType.Multiple"</code> to allow any number of panels open
            simultaneously.
        </Description>
        <LiveContent>
            <BitBhAccordion Type="BitBhAccordionType.Multiple" class="accordion">
                <BitBhAccordionItem Value="faq-1" class="accordion-item">
                    <BitBhAccordionTrigger class="accordion-trigger">
                        <Template Context="t">
                            Can I open multiple panels?
                            <span class="accordion-chevron @(t.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhAccordionTrigger>
                    <BitBhAccordionContent class="accordion-content">
                        <div class="accordion-body">
                            Yes — every panel is independent. Try opening both!
                        </div>
                    </BitBhAccordionContent>
                </BitBhAccordionItem>

                <BitBhAccordionItem Value="faq-2" class="accordion-item">
                    <BitBhAccordionTrigger class="accordion-trigger">
                        <Template Context="t">
                            Does this one close when I open another?
                            <span class="accordion-chevron @(t.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhAccordionTrigger>
                    <BitBhAccordionContent class="accordion-content">
                        <div class="accordion-body">
                            No — both can be open at once.
                        </div>
                    </BitBhAccordionContent>
                </BitBhAccordionItem>
            </BitBhAccordion>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled Item"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            Individual items can be disabled via <code>Disabled="true"</code>. The whole accordion can
            also be disabled at the root.
        </Description>
        <LiveContent>
            <BitBhAccordion class="accordion">
                <BitBhAccordionItem Value="d-1" class="accordion-item">
                    <BitBhAccordionTrigger class="accordion-trigger">
                        <Template Context="t">
                            I am enabled
                            <span class="accordion-chevron @(t.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhAccordionTrigger>
                    <BitBhAccordionContent class="accordion-content">
                        <div class="accordion-body">This item works normally.</div>
                    </BitBhAccordionContent>
                </BitBhAccordionItem>

                <BitBhAccordionItem Value="d-2" Disabled="true" class="accordion-item">
                    <BitBhAccordionTrigger class="accordion-trigger">
                        <Template Context="t">
                            I am disabled
                            <span class="accordion-chevron @(t.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhAccordionTrigger>
                    <BitBhAccordionContent class="accordion-content">
                        <div class="accordion-body">You should not be able to open this.</div>
                    </BitBhAccordionContent>
                </BitBhAccordionItem>
            </BitBhAccordion>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Controlled Accordion"
               Code="@_controlledCode"
               Css="@_controlledCss">
        <Description>
            Drive the open state externally with <code>Value</code> + <code>OnValueChange</code>. The
            button below toggles "Panel 2" programmatically.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:1rem; width:100%">
                <div class="demo-row">
                    <BitBhButton OnClick="ToggleControlledItem" class="btn">
                        Toggle "Panel 2"
                    </BitBhButton>
                    <span class="demo-output">Open: @(controlledValue ?? "none")</span>
                </div>

                <BitBhAccordion Value="@controlledValue"
                            OnValueChange="v => controlledValue = v"
                            class="accordion">
                    <BitBhAccordionItem Value="ctrl-1" class="accordion-item">
                        <BitBhAccordionTrigger class="accordion-trigger">
                            <Template Context="t">
                                Panel 1
                                <span class="accordion-chevron @(t.IsOpen ? "open" : "")">▾</span>
                            </Template>
                        </BitBhAccordionTrigger>
                        <BitBhAccordionContent class="accordion-content">
                            <div class="accordion-body">Controlled by external state.</div>
                        </BitBhAccordionContent>
                    </BitBhAccordionItem>

                    <BitBhAccordionItem Value="ctrl-2" class="accordion-item">
                        <BitBhAccordionTrigger class="accordion-trigger">
                            <Template Context="t">
                                Panel 2
                                <span class="accordion-chevron @(t.IsOpen ? "open" : "")">▾</span>
                            </Template>
                        </BitBhAccordionTrigger>
                        <BitBhAccordionContent class="accordion-content">
                            <div class="accordion-body">This panel is toggled by the button above.</div>
                        </BitBhAccordionContent>
                    </BitBhAccordionItem>
                </BitBhAccordion>
            </div>
        </LiveContent>
    </DemoBlock>
</div>

