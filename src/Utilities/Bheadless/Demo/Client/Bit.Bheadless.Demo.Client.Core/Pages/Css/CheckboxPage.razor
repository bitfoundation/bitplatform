@page "/checkbox"

<PageTitle>Checkbox — bit Bheadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Checkbox</h1>
        <p>An accessible tri-state checkbox primitive with full keyboard support and zero visual opinion.</p>
        <SectionSwitcher Slug="checkbox" />
    </header>

    <DemoBlock Title="Basic Checkbox (Uncontrolled)"
               Code="@_basicCode"
               Css="@_checkboxCss">
        <Description>
            Renders a native <code>&lt;button&gt;</code> with <code>role="checkbox"</code> and
            <code>aria-checked</code>. Click or press Space to toggle.
            <code>DefaultChecked</code> seeds the initial state.
        </Description>
        <LiveContent>
            <BitBhCheckbox aria-label="Remember me" class="checkbox">
                <Template Context="c">
                    @if (c.IsChecked) { <span class="checkbox-tick">✓</span> }
                </Template>
            </BitBhCheckbox>

            <BitBhCheckbox aria-label="Keep me signed in" DefaultChecked="true" class="checkbox">
                <Template Context="c">
                    @if (c.IsChecked) { <span class="checkbox-tick">✓</span> }
                </Template>
            </BitBhCheckbox>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Controlled"
               Code="@_controlledCode"
               Css="@_controlledCss">
        <Description>
            Drive state externally with <code>Checked</code> + <code>OnCheckedChange</code>.
        </Description>
        <LiveContent>
            <div style="display:flex; align-items:center; gap:1rem;">
                <BitBhCheckbox aria-label="Accept the terms" Checked="@acceptedTerms"
                           OnCheckedChange="v => acceptedTerms = v"
                           class="checkbox">
                    <Template Context="c">
                        @if (c.IsChecked) { <span class="checkbox-tick">✓</span> }
                    </Template>
                </BitBhCheckbox>

                <span class="demo-output">
                    Terms accepted: <strong>@(acceptedTerms ? "yes" : "no")</strong>
                </span>

                <BitBhButton OnClick="() => acceptedTerms = !acceptedTerms" class="btn">
                    Toggle from outside
                </BitBhButton>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            Set <code>Disabled="true"</code> to block interaction. Receives the native
            <code>disabled</code> attribute and a <code>data-disabled</code> hook.
        </Description>
        <LiveContent>
            <BitBhCheckbox aria-label="Unavailable option" Disabled="true" class="checkbox">
                <Template Context="c">
                    @if (c.IsChecked) { <span class="checkbox-tick">✓</span> }
                </Template>
            </BitBhCheckbox>

            <BitBhCheckbox aria-label="Locked option" DefaultChecked="true" Disabled="true" class="checkbox">
                <Template Context="c">
                    @if (c.IsChecked) { <span class="checkbox-tick">✓</span> }
                </Template>
            </BitBhCheckbox>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Indeterminate (Select All pattern)"
               Code="@_indeterminateCode"
               Css="@_indeterminateCss">
        <Description>
            Setting <code>Indeterminate="true"</code> emits <code>aria-checked="mixed"</code>
            and <code>data-state="indeterminate"</code>. The classic use-case is a "select all"
            checkbox that reflects partial child selection. Clicking an indeterminate checkbox
            advances it to checked.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:0.5rem;">
                <label class="checkbox-label">
                    <BitBhCheckbox Checked="@SelectAllChecked"
                               Indeterminate="@SelectAllIndeterminate"
                               OnCheckedChange="HandleSelectAll"
                               class="checkbox">
                        <Template Context="c">
                            @if (c.IsIndeterminate)  { <span class="checkbox-dash">–</span> }
                            else if (c.IsChecked)    { <span class="checkbox-tick">✓</span> }
                        </Template>
                    </BitBhCheckbox>
                    <strong>Select all</strong>
                </label>

                <div style="display:flex; flex-direction:column; gap:0.4rem; margin-left:1.6rem;">
                    @for (var i = 0; i < items.Length; i++)
                    {
                        var captured = i;
                        <label class="checkbox-label">
                            <BitBhCheckbox Checked="@items[captured]"
                                       OnCheckedChange="v => HandleItemChange(captured, v)"
                                       class="checkbox">
                                <Template Context="c">
                                    @if (c.IsChecked) { <span class="checkbox-tick">✓</span> }
                                </Template>
                            </BitBhCheckbox>
                            <span>@($"Item {captured + 1}")</span>
                        </label>
                    }
                </div>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="With label"
               Code="@_labelCode"
               Css="@_labelCss">
        <Description>
            Wrap the checkbox in a <code>&lt;label&gt;</code> so clicking the text toggles the
            checkbox — standard HTML behaviour.
        </Description>
        <LiveContent>
            <label class="checkbox-label">
                <BitBhCheckbox class="checkbox">
                    <Template Context="c">
                        @if (c.IsChecked) { <span class="checkbox-tick">✓</span> }
                    </Template>
                </BitBhCheckbox>
                <span>Send me product updates</span>
            </label>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Form Submission"
               Code="@_formCode"
               Css="@_formCss">
        <Description>
            Set <code>Name</code> to render an adjacent <code>&lt;input type="hidden"&gt;</code>
            so the checkbox state participates in plain form posts. The hidden input is only
            present when the checkbox is checked or indeterminate, mirroring native checkbox behaviour.
        </Description>
        <LiveContent>
            <form @onsubmit="HandleFormSubmit"
                  @onsubmit:preventDefault="true"
                  style="display:flex; flex-direction:column; gap:0.5rem; align-items:flex-start;">
                <label class="checkbox-label">
                    <BitBhCheckbox Name="agree" Value="yes"
                               class="checkbox">
                        <Template Context="c">
                            @if (c.IsChecked) { <span class="checkbox-tick">✓</span> }
                        </Template>
                    </BitBhCheckbox>
                    <span>I agree to the terms</span>
                </label>

                <button type="submit" class="btn btn-primary">Submit</button>

                @if (lastSubmitted is not null)
                {
                    <span class="demo-output">@lastSubmitted</span>
                }
            </form>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Group with select all"
               Code="@_groupCode"
               Css="@_groupCss">
        <Description>
            <code>BitBhCheckboxGroup</code> binds one collection with <code>@@bind-Values</code> and
            renders <code>role="group"</code>; each <code>BitBhCheckbox</code> with a <code>Value</code>
            toggles that value. <code>SelectAll="true"</code> turns a checkbox into the tri-state
            parent — checked when every value is selected, <code>aria-checked="mixed"</code> /
            <code>data-state="indeterminate"</code> when only some are. <code>BitBhCheckboxIndicator</code>
            renders only while its checkbox is checked or mixed, and mirrors its <code>data-state</code>.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:1rem;">
                <BitBhCheckboxGroup @bind-Values="toppings" aria-label="Pizza toppings" class="checkbox-group">
                    <BitBhCheckbox SelectAll="true" class="checkbox-row checkbox-row-all">
                        <span class="checkbox-box"><BitBhCheckboxIndicator class="checkbox-indicator" /></span>
                        All toppings
                    </BitBhCheckbox>
                    <div class="checkbox-group-items">
                        @foreach (var topping in allToppings)
                        {
                            <BitBhCheckbox Value="@topping" class="checkbox-row">
                                <span class="checkbox-box"><BitBhCheckboxIndicator class="checkbox-indicator" /></span>
                                @topping
                            </BitBhCheckbox>
                        }
                    </div>
                </BitBhCheckboxGroup>

                <span class="demo-output">
                    Values: <strong>@(toppings.Count == 0 ? "(none)" : string.Join(", ", toppings))</strong>
                </span>
            </div>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    private bool acceptedTerms;
    private string[] allToppings = new[] { "Cheese", "Mushrooms", "Olives", "Peppers" };
    private IReadOnlyCollection<string> toppings = new[] { "Cheese", "Olives" };
    private bool[] items = new[] { false, false, false };
    private string? lastSubmitted;

    private bool SelectAllChecked => items.All(x => x);
    private bool SelectAllIndeterminate => items.Any(x => x) && !SelectAllChecked;

    private void HandleSelectAll(bool checkAll)
    {
        for (var i = 0; i < items.Length; i++)
            items[i] = checkAll;
    }

    private void HandleItemChange(int index, bool value)
    {
        items[index] = value;
    }

    private void HandleFormSubmit()
    {
        // In a real app the browser would post the hidden input.
        lastSubmitted = "(submitted — when checked, the form posts agree=yes)";
    }

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _groupCode = """
<BitBhCheckboxGroup @bind-Values="toppings" aria-label="Pizza toppings" class="checkbox-group">
    @* Tri-state parent: checked / mixed / unchecked from the group's values *@
    <BitBhCheckbox SelectAll="true" class="checkbox-row checkbox-row-all">
        <span class="checkbox-box"><BitBhCheckboxIndicator class="checkbox-indicator" /></span>
        All toppings
    </BitBhCheckbox>

    <div class="checkbox-group-items">
        @foreach (var topping in allToppings)
        {
            <BitBhCheckbox Value="@topping" class="checkbox-row">
                <span class="checkbox-box"><BitBhCheckboxIndicator class="checkbox-indicator" /></span>
                @topping
            </BitBhCheckbox>
        }
    </div>
</BitBhCheckboxGroup>

<span class="demo-output">
    Values: <strong>@(toppings.Count == 0 ? "(none)" : string.Join(", ", toppings))</strong>
</span>

@code {
    private string[] allToppings = new[] { "Cheese", "Mushrooms", "Olives", "Peppers" };
    private IReadOnlyCollection<string> toppings = new[] { "Cheese", "Olives" };
}
""";

    private const string _groupCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.checkbox-group       { display: flex; flex-direction: column; gap: 0.5rem; }
.checkbox-group-items { display: flex; flex-direction: column; gap: 0.4rem; padding-left: 1.6rem; }

/* The checkbox button holds the box and the label text (its accessible name) */
.checkbox-row {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border-radius: 0.25rem;
    font-size: 0.9rem;
    cursor: pointer;
    user-select: none;
}
.checkbox-row:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
.checkbox-row-all           { font-weight: 600; }

.checkbox-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
    border: 1px solid #d4d4d8;
    border-radius: 0.25rem;
    background: #fff;
    color: #fff;
    transition: background 120ms ease, border-color 120ms ease;
}
.checkbox-row:hover .checkbox-box { border-color: #a1a1af; }

/* Hooks emitted by BitBhCheckbox */
.checkbox-row[data-state="checked"] .checkbox-box,
.checkbox-row[data-state="indeterminate"] .checkbox-box {
    background: #2563eb;
    border-color: #2563eb;
}

/* BitBhCheckboxIndicator mirrors the state, so CSS picks the glyph */
.checkbox-indicator { font-size: 0.8rem; font-weight: 700; line-height: 1; }
.checkbox-indicator[data-state="checked"]::before       { content: "\2713"; }   /* ✓ */
.checkbox-indicator[data-state="indeterminate"]::before { content: "\2013"; }   /* – */

.demo-output { font-size: 0.875rem; color: #71717a; }
""";

