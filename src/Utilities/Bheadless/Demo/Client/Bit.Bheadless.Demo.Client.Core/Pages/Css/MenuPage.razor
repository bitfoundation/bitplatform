@page "/menu"

<PageTitle>Menu — bit Bheadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Menu</h1>
        <p>An accessible dropdown menu with keyboard navigation, typeahead, and zero visual opinion.</p>
        <SectionSwitcher Slug="menu" />
    </header>

    <DemoBlock Title="Basic Menu"
               Code="@_basicCode"
               Css="@_menuCss">
        <Description>
            Click the button or press Space / Enter / arrow keys to open. Use Up / Down to
            navigate, Home / End to jump, Enter / Space to activate, Escape to close.
            Type a letter to jump to the first matching item. ARIA wiring
            (<code>aria-haspopup="menu"</code>, <code>aria-expanded</code>,
            <code>aria-activedescendant</code>) is handled automatically.
        </Description>
        <LiveContent>
            <BitBhMenu class="menu">
                <BitBhMenuButton class="menu-button">
                    <Template Context="b">
                        Options
                        <span class="menu-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </Template>
                </BitBhMenuButton>
                <BitBhMenuItems class="menu-items">
                    <BitBhMenuItem OnClick='@(() => Log("Edit"))'      class="menu-item" Label="Edit">Edit</BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Duplicate"))' class="menu-item" Label="Duplicate">Duplicate</BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Archive"))'   class="menu-item" Label="Archive">Archive</BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Delete"))'    class="menu-item" Label="Delete">Delete</BitBhMenuItem>
                </BitBhMenuItems>
            </BitBhMenu>

            <span class="demo-output">Last action: <strong>@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled Items"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            Set <code>Disabled="true"</code> on individual items. Disabled items receive
            <code>data-disabled</code> for CSS, are skipped by arrow-key nav, and are
            ignored by typeahead.
        </Description>
        <LiveContent>
            <BitBhMenu class="menu">
                <BitBhMenuButton class="menu-button">
                    <Template Context="b">
                        Account
                        <span class="menu-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </Template>
                </BitBhMenuButton>
                <BitBhMenuItems class="menu-items">
                    <BitBhMenuItem OnClick='@(() => Log("Profile"))'  class="menu-item" Label="Profile">Profile</BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Settings"))' class="menu-item" Label="Settings">Settings</BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Billing"))'  class="menu-item" Label="Billing"
                               Disabled="true">Billing (unavailable)</BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Sign out"))' class="menu-item" Label="Sign out">Sign out</BitBhMenuItem>
                </BitBhMenuItems>
            </BitBhMenu>

            <span class="demo-output">Last action: <strong>@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Rich item content"
               Code="@_richCode"
               Css="@_richCss">
        <Description>
            Items can contain any markup. Use the <code>data-active</code> hook to drive
            the highlighted style and provide a <code>Label</code> string so typeahead
            still works when the content is rich.
        </Description>
        <LiveContent>
            <BitBhMenu class="menu">
                <BitBhMenuButton class="menu-button">
                    <Template Context="b">
                        File
                        <span class="menu-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </Template>
                </BitBhMenuButton>
                <BitBhMenuItems class="menu-items menu-items-wide">
                    <BitBhMenuItem OnClick='@(() => Log("New file"))' class="menu-item" Label="New file">
                        <Template Context="i">
                            <span class="menu-item-icon">📄</span>
                            <span class="menu-item-body">
                                <strong>New file</strong>
                                <span>Create a blank document</span>
                            </span>
                            <span class="menu-item-shortcut">⌘N</span>
                        </Template>
                    </BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Open"))' class="menu-item" Label="Open">
                        <Template Context="i">
                            <span class="menu-item-icon">📂</span>
                            <span class="menu-item-body">
                                <strong>Open…</strong>
                                <span>Browse for a file</span>
                            </span>
                            <span class="menu-item-shortcut">⌘O</span>
                        </Template>
                    </BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Save"))' class="menu-item" Label="Save">
                        <Template Context="i">
                            <span class="menu-item-icon">💾</span>
                            <span class="menu-item-body">
                                <strong>Save</strong>
                                <span>Save the current document</span>
                            </span>
                            <span class="menu-item-shortcut">⌘S</span>
                        </Template>
                    </BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Export"))' class="menu-item" Label="Export"
                               Disabled="true">
                        <Template Context="i">
                            <span class="menu-item-icon">📤</span>
                            <span class="menu-item-body">
                                <strong>Export</strong>
                                <span>Not available in this plan</span>
                            </span>
                        </Template>
                    </BitBhMenuItem>
                </BitBhMenuItems>
            </BitBhMenu>

            <span class="demo-output">Last action: <strong>@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Sections and dividers"
               Code="@_sectionsCode"
               Css="@_sectionsCss">
        <Description>
            Group related items with a plain <code>&lt;li&gt;</code> divider or a
            section heading. These are regular HTML elements — the menu component
            doesn't need to know about them.
        </Description>
        <LiveContent>
            <BitBhMenu class="menu">
                <BitBhMenuButton class="menu-button">
                    <Template Context="b">
                        More
                        <span class="menu-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </Template>
                </BitBhMenuButton>
                <BitBhMenuItems class="menu-items">
                    <li class="menu-section-label" role="presentation">View</li>
                    <BitBhMenuItem OnClick='@(() => Log("Zoom in"))'     class="menu-item" Label="Zoom in">Zoom in</BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Zoom out"))'    class="menu-item" Label="Zoom out">Zoom out</BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Full screen"))' class="menu-item" Label="Full screen">Full screen</BitBhMenuItem>

                    <li class="menu-divider" role="separator"></li>

                    <li class="menu-section-label" role="presentation">Help</li>
                    <BitBhMenuItem OnClick='@(() => Log("Documentation"))'    class="menu-item" Label="Documentation">Documentation</BitBhMenuItem>
                    <BitBhMenuItem OnClick='@(() => Log("Keyboard shortcuts"))' class="menu-item" Label="Keyboard shortcuts">Keyboard shortcuts</BitBhMenuItem>
                </BitBhMenuItems>
            </BitBhMenu>

            <span class="demo-output">Last action: <strong>@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Anchor Positioning"
               Code="@_anchorCode"
               Css="@_anchorCss">
        <Description>
            Set <code>Anchor</code> on <code>BitBhMenuItems</code> to automatically position the
            dropdown relative to the button. The panel uses <code>position: fixed</code> and
            auto-updates on scroll/resize. It flips to the opposite side if there's not enough
            space, and shifts to stay within the viewport. CSS custom properties
            <code>--button-width</code>, <code>--anchor-gap</code> are exposed on the panel.
        </Description>
        <LiveContent>
            <div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:flex-start;">
                <BitBhMenu class="menu">
                    <BitBhMenuButton class="menu-button">
                        <Template Context="b">
                            Bottom Start
                            <span class="menu-chevron @(b.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhMenuButton>
                    <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })"
                                class="menu-items-anchored">
                        <BitBhMenuItem OnClick='@(() => Log("Edit"))'      class="menu-item" Label="Edit">Edit</BitBhMenuItem>
                        <BitBhMenuItem OnClick='@(() => Log("Duplicate"))' class="menu-item" Label="Duplicate">Duplicate</BitBhMenuItem>
                        <BitBhMenuItem OnClick='@(() => Log("Archive"))'   class="menu-item" Label="Archive">Archive</BitBhMenuItem>
                    </BitBhMenuItems>
                </BitBhMenu>

                <BitBhMenu class="menu">
                    <BitBhMenuButton class="menu-button">
                        <Template Context="b">
                            Bottom End
                            <span class="menu-chevron @(b.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhMenuButton>
                    <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom end", Gap = 4 })"
                                class="menu-items-anchored">
                        <BitBhMenuItem OnClick='@(() => Log("Cut"))'   class="menu-item" Label="Cut">Cut</BitBhMenuItem>
                        <BitBhMenuItem OnClick='@(() => Log("Copy"))'  class="menu-item" Label="Copy">Copy</BitBhMenuItem>
                        <BitBhMenuItem OnClick='@(() => Log("Paste"))' class="menu-item" Label="Paste">Paste</BitBhMenuItem>
                    </BitBhMenuItems>
                </BitBhMenu>

                <BitBhMenu class="menu">
                    <BitBhMenuButton class="menu-button">
                        <Template Context="b">
                            Match Width
                            <span class="menu-chevron @(b.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhMenuButton>
                    <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom", Gap = 4 })"
                                class="menu-items-anchored menu-items-match-width">
                        <BitBhMenuItem OnClick='@(() => Log("Option A"))' class="menu-item" Label="Option A">Option A</BitBhMenuItem>
                        <BitBhMenuItem OnClick='@(() => Log("Option B"))' class="menu-item" Label="Option B">Option B</BitBhMenuItem>
                        <BitBhMenuItem OnClick='@(() => Log("Option C"))' class="menu-item" Label="Option C">Option C</BitBhMenuItem>
                    </BitBhMenuItems>
                </BitBhMenu>
            </div>

            <span class="demo-output">Last action: <strong>@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Polymorphic items"
               Code="@_polymorphicCode"
               Css="@_polymorphicCss">
        <Description>
            Set <code>As="a"</code> on an item to render it as an anchor tag — useful for
            navigation links inside a menu. The item still participates in keyboard nav
            and receives all the ARIA attributes.
        </Description>
        <LiveContent>
            <BitBhMenu class="menu">
                <BitBhMenuButton class="menu-button">
                    <Template Context="b">
                        Navigate
                        <span class="menu-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </Template>
                </BitBhMenuButton>
                <BitBhMenuItems class="menu-items">
                    <BitBhMenuItem As="a" href="/button"     class="menu-item" Label="Button">Button</BitBhMenuItem>
                    <BitBhMenuItem As="a" href="/switch"     class="menu-item" Label="Switch">Switch</BitBhMenuItem>
                    <BitBhMenuItem As="a" href="/disclosure" class="menu-item" Label="Disclosure">Disclosure</BitBhMenuItem>
                    <BitBhMenuItem As="a" href="/accordion"  class="menu-item" Label="Accordion">Accordion</BitBhMenuItem>
                </BitBhMenuItems>
            </BitBhMenu>
        </LiveContent>
    </DemoBlock>
</div>

