/* All styles are consumer-authored — the library ships zero CSS */
.menu          { position: relative; display: inline-block; }

.menu-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 120ms ease;
}

.menu-button:hover               { border-color: #a1a1af; }
.menu-button:focus-visible       { outline: 2px solid #2563eb; outline-offset: 2px; }
.menu-button[data-state="open"]  { border-color: #2563eb; }
.menu-button[data-disabled]      { opacity: 0.5; cursor: not-allowed; }

.menu-chevron       { transition: transform 200ms ease; color: #71717a; }
.menu-chevron.open  { transform: rotate(180deg); }

/* When using Anchor, the panel is position:fixed by the JS engine.
   No need for position:relative on the parent or position:absolute on the panel.
   Use a high z-index to ensure the panel renders above all other page content. */
.menu-items-anchored {
    z-index: 9999;
    min-width: 10rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
}

/* Use the --button-width CSS variable to match the trigger width */
.menu-items-match-width {
    min-width: unset;
    width: var(--button-width);
}

/* Items inside the anchored panel */
.menu-items-anchored .menu-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.65rem;
    border-radius: 0.35rem;
    font-size: 0.9rem;
    cursor: pointer;
    color: #18181b;
    list-style: none;
}

.menu-items-anchored .menu-item[data-active] { background: #eff6ff; color: #1d4ed8; }
.menu-items-anchored .menu-item[data-disabled] { opacity: 0.4; cursor: not-allowed; }

.demo-output { font-size: 0.875rem; color: #71717a; }
""";

