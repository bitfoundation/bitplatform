    // ── CSS (mirrors wwwroot/demos/date-field.css) ─────────────────────────────

    private const string _css = """
/* All styles are consumer-authored — the library ships zero CSS */

/* The field: its root is the role="group" */
.date-field {
    display: inline-flex;
    align-items: center;
    min-width: 10rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border-control);
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    cursor: text;
}

.date-field:hover { border-color: var(--color-border-control-hover); }
/* data-focused while a segment has focus */
.date-field[data-focused] { outline: 2px solid var(--color-focus); outline-offset: 2px; }
.date-field[data-invalid] { border-color: var(--color-danger); }
.date-field[data-disabled] { opacity: 0.55; cursor: not-allowed; }

/* Segments: data-type, data-placeholder */
.date-field [data-type] {
    padding: 0.1rem 0.15rem;
    border-radius: 0.25rem;
}

/* At least 24 x 24 px: each segment is a pointer target of its own. */
.date-field [role="spinbutton"] {
    display: inline-block;
    min-width: 1.5rem;
    min-height: 1.5rem;
    line-height: 1.5rem;
    text-align: center;
    outline: none;
}
.date-field [role="spinbutton"]:focus { background: var(--color-primary); color: #fff; }
.date-field [data-placeholder] { color: var(--color-muted); }
.date-field [data-placeholder]:focus { color: #fff; }
.date-field [data-type="literal"] { padding: 0; color: var(--color-muted); }
.date-field[data-invalid] [role="spinbutton"]:not(:focus) { color: var(--color-danger-text); }

/* Field parts */
.date-field-label { display: block; margin-bottom: 0.35rem; font-size: 0.875rem; font-weight: 600; color: var(--color-text); }
.date-field-description { margin: 0.35rem 0 0; font-size: 0.8rem; color: var(--color-muted); }
.date-field-error { margin: 0.35rem 0 0; font-size: 0.8rem; color: var(--color-danger-text); }

/* Demo layout */
.date-field-demo { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1.5rem; }
.date-field-value { margin: 0; font-size: 0.85rem; color: var(--color-muted); }
.date-field-value strong { color: var(--color-text); font-weight: 600; font-variant-numeric: tabular-nums; }

.date-field-submit {
    margin-top: 0.75rem;
    padding: 0.45rem 0.9rem;
    border: none;
    border-radius: 0.5rem;
    background: var(--color-primary);
    color: #fff;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
}

.date-field-submit:hover { background: var(--color-primary-hover); }
.date-field-submit:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
""";
}
