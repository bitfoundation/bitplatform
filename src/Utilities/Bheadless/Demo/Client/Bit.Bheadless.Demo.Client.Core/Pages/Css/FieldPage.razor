    private const string _editFormCss = """
/* All styles are consumer-authored — the library ships zero CSS.
   Builds on .field / .field-label / .field-input / .field-description from
   the "Basic Field" demo and .checkbox from the Checkbox page. */
.validation-form { display: flex; flex-direction: column; gap: 1rem; max-width: 24rem; }

/* BitBhLabel emits data-required / data-invalid from its field */
.validation-form .field-label[data-required]::after { content: " *"; color: #dc2626; }
.validation-form .field-label[data-invalid]         { color: #b91c1c; }

/* BitBhInput: aria-invalid="true" + data-invalid */
.field-input[data-invalid]               { border-color: #dc2626; }
.field-input[data-invalid]:focus-visible { outline-color: #dc2626; }

/* BitBhErrorMessage: rendered only while the field is invalid */
.validation-message {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    color: #dc2626;
    font-size: 0.8rem;
    font-weight: 500;
}
.validation-message::before {
    content: "!";
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 999px;
    background: #dc2626;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
}

/* Radio group as pills — the radio's text is its accessible name */
.validation-radios { display: flex; flex-wrap: wrap; gap: 0.5rem; }

.validation-radio {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.875rem;
    cursor: pointer;
}
.validation-radio:focus-visible            { outline: 2px solid #2563eb; outline-offset: 2px; }
.validation-radio[data-state="checked"]    { border-color: #2563eb; background: #eff6ff; }
.validation-radios[aria-invalid="true"] .validation-radio { border-color: #fca5a5; }

.validation-radio-dot {
    width: 0.9rem;
    height: 0.9rem;
    box-sizing: border-box;
    border: 1px solid #a1a1aa;
    border-radius: 999px;
    background: #fff;
}
.validation-radio[data-state="checked"] .validation-radio-dot { border: 4px solid #2563eb; }

/* Checkbox + label row */
.validation-check       { display: flex; align-items: center; gap: 0.55rem; }
.validation-check-label { font-size: 0.875rem; cursor: pointer; }
.validation-form .checkbox[data-invalid] { border-color: #dc2626; }

.validation-actions { display: flex; gap: 0.5rem; }

/* The live region stays rendered; style it only when it has content */
.validation-success:not(:empty) {
    padding: 0.6rem 0.85rem;
    border: 1px solid #bbf7d0;
    border-radius: 0.5rem;
    background: #f0fdf4;
    color: #166534;
    font-size: 0.875rem;
}
""";

