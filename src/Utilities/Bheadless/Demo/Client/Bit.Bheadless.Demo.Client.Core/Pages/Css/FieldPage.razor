/* All styles are consumer-authored — the library ships zero CSS */
.field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
    max-width: 24rem;
}

.field-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #18181b;
}

.field-label[data-disabled] { opacity: 0.5; }

.field-input {
    padding: 0.5rem 0.75rem;
