/* The overflow variables are the pixels of content hidden past each edge */
.scroll-area-faded .scroll-area-viewport {
    mask-image: linear-gradient(to bottom,
        transparent 0,
        #000 min(2.5rem, var(--bit-bh-scroll-area-overflow-y-start, 0px)),
        #000 calc(100% - min(2.5rem, var(--bit-bh-scroll-area-overflow-y-end, 0px))),
        transparent 100%);
}

.scroll-area-content   { padding: 0.75rem 1rem; }
.scroll-area-paragraph { margin: 0 0 0.75rem; font-size: 0.875rem; line-height: 1.6; }
""";

    private const string _rtlCss = _baseCss + """


/* Horizontal chips */
.scroll-area-strip { max-width: 22rem; height: auto; }
.scroll-area-strip .scroll-area-viewport { height: auto; }

.scroll-area-chips {
    display: flex;
    gap: 0.5rem;
    width: max-content;
    padding: 0.75rem 0.75rem 1rem;
}

.scroll-area-chip {
    min-height: 2rem;
    padding: 0 0.85rem;
    border: 1px solid var(--color-border-control);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: 0.8125rem;
    white-space: nowrap;
    cursor: pointer;
}

.scroll-area-chip:hover { background: var(--color-fill); }
.scroll-area-chip:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
.scroll-area-chip[aria-pressed="true"] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #fff;
}

.scroll-area-demo   { display: grid; gap: 0.75rem; width: 100%; }
.scroll-area-output { margin: 0; font-size: 0.85rem; color: var(--color-muted); }
.scroll-area-output strong { color: var(--color-text); font-weight: 600; }
""";
