    // ── CSS (mirrors wwwroot/demos/scroll-area.css) ─────────────────────────────

    private const string _baseCss = """
/* All styles are consumer-authored — the library ships zero CSS */

/* Root: a size, a frame, and overflow hidden (inline: position: relative) */
.scroll-area {
    width: 100%;
    max-width: 18rem;
    height: 15rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
}

/* Viewport: fills the root (inline: overflow: scroll, native scrollbars hidden) */
.scroll-area-viewport {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    outline: none;
}

/* A viewport with nothing focusable inside is a tab stop: show where the keyboard is. */
.scroll-area-viewport:focus-visible { box-shadow: inset 0 0 0 2px var(--color-focus); }

/* Scrollbar: a 10px track (inline: position: absolute along the edge) */
.scroll-area-scrollbar {
    display: flex;
    padding: 2px;
    background: transparent;
    transition: opacity 160ms ease, background-color 160ms ease;
}

.scroll-area-scrollbar[data-orientation="vertical"]   { width: 10px; }
.scroll-area-scrollbar[data-orientation="horizontal"] { height: 10px; flex-direction: column; }

.scroll-area-scrollbar[data-hovering],
.scroll-area-scrollbar[data-dragging] { background: var(--color-fill); }

/* Hidden by the area's Type: fade out (the scrollbar takes no pointer input meanwhile). */
.scroll-area-scrollbar[data-state="hidden"] { opacity: 0; }

/* Thumb (inline: its length from --bit-bh-scroll-area-thumb-height / -width, its position a transform) */
.scroll-area-thumb {
    flex: 1;
    border-radius: 999px;
    background: var(--color-border-control);
}

.scroll-area-thumb:hover,
.scroll-area-thumb[data-dragging] { background: var(--color-border-control-hover); }
""";

    private const string _listCss = _baseCss + """


/* Tags list */
.scroll-area-content { padding: 0.75rem 1rem; }

.scroll-area-heading {
