    private const string _radioCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.radio-group {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
}

.radio-group[data-orientation="horizontal"] {
    flex-direction: row;
    gap: 1.25rem;
}

.radio-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    user-select: none;
    font-size: 0.9rem;
}

.radio {
    /* Reset native button */
    all: unset;
    box-sizing: border-box;

    /* Outer ring */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    border: 1px solid #d4d4d8;
    border-radius: 999px;
    background: #fff;
    cursor: pointer;
    transition: border-color 120ms ease;
    flex-shrink: 0;
}

.radio:hover         { border-color: #a1a1af; }
.radio:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }

/* Hooks emitted by BitBhRadio */
.radio[data-state="checked"] { border-color: #2563eb; }
.radio[data-disabled]        { opacity: 0.5; cursor: not-allowed; }

/* Inner dot */
.radio-dot {
    width: 0.55rem;
    height: 0.55rem;
    background: #2563eb;
    border-radius: 999px;
}
""";

