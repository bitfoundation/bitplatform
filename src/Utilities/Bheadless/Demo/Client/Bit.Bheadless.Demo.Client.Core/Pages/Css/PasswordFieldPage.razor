@page "/password-field"

<PageTitle>Password Field · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Password Field</h1>
    <p class="bb-subtitle">A password input with a show / hide toggle that keeps typing and focus where people expect them.</p>
</div>

<SectionSwitcher Slug="password-field" />

<DemoBlock Title="Show / hide" Code="@_code" Css="@_css">
    <Description>
        The toggle is named "Show password" / "Hide password" and controls the input. Toggled with a pointer the focus goes back
        to the input so typing carries on; toggled from the keyboard it stays on the toggle. The input is a
        <code>BitBhInput</code> - <code>@@bind-Value</code>, validation and the field's label all work - with
        <code>autocomplete="current-password"</code> and no spell-checking.
    </Description>
    <LiveContent>
        <BitBhField>
            <BitBhLabel style="display:block;margin-bottom:0.35rem;font-size:0.875rem;font-weight:500">Password</BitBhLabel>
            <BitBhPasswordField class="password">
                <BitBhPasswordFieldInput @bind-Value="password" class="ix-input" />
                <BitBhPasswordFieldToggle class="ix-icon-btn">
                    <Template Context="visible">@(visible ? "Hide" : "Show")</Template>
                </BitBhPasswordFieldToggle>
            </BitBhPasswordField>
        </BitBhField>
    </LiveContent>
</DemoBlock>

@code {
    private string? password;

    private const string _code = """
<BitBhField>
    <BitBhLabel>Password</BitBhLabel>
    <BitBhPasswordField class="password">
        <BitBhPasswordFieldInput @bind-Value="password" class="ix-input" />
        <BitBhPasswordFieldToggle class="ix-icon-btn">
            <Template Context="visible">@(visible ? "Hide" : "Show")</Template>
        </BitBhPasswordFieldToggle>
    </BitBhPasswordField>
</BitBhField>
""";

    private const string _css = """
/* All styles are consumer-authored — the library ships zero CSS */
.password {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    background: var(--color-surface);
}

.password:focus-within { outline: 2px solid var(--color-focus); outline-offset: 1px; }
.password .ix-input { border: none; outline: none; }
/* data-visible on the root, the input and the toggle while the password shows */
""";
}
