@page "/navigation-menu"

<PageTitle>Navigation Menu · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Navigation Menu</h1>
    <p class="bb-subtitle">Site navigation made of links and disclosure buttons that open panels of links - on hover with intent, on click and from the keyboard - with an optional shared viewport, an indicator and directional motion.</p>
</div>

<SectionSwitcher Slug="navigation-menu" />

<DemoBlock Title="Basic" Code="@_basicCode" Css="@_css">
    <Description>
        A <code>&lt;nav&gt;</code> of disclosure buttons (<code>aria-expanded</code>, <code>aria-controls</code>) and links - not a
        <code>role="menu"</code>, which is for application menus. Hover a trigger and its content opens after
        <code>DelayDuration</code> (200 ms); while one is open the next opens at once. Click, Enter or Space toggles;
        <kbd>↓</kbd> opens and moves into the content, where every arrow key moves between the links; <kbd>Tab</kbd> from an open
        trigger enters it; <kbd>Escape</kbd> closes it and returns to the trigger; <kbd>←</kbd> / <kbd>→</kbd>, <kbd>Home</kbd> and
        <kbd>End</kbd> move between the top-level items, which are all tab stops too. Pressing outside, focus leaving the menu or
        choosing a link closes it.
    </Description>
    <LiveContent>
        <div class="navigation-menu-demo">
            <BitBhNavigationMenu aria-label="Products (example)" class="navigation-menu">
                <BitBhNavigationMenuList class="navigation-menu-list">
                    <BitBhNavigationMenuItem Value="products" class="navigation-menu-item">
                        <BitBhNavigationMenuTrigger class="navigation-menu-trigger">
                            Products
                            <svg class="navigation-menu-chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                        </BitBhNavigationMenuTrigger>
                        <BitBhNavigationMenuContent class="navigation-menu-content">
                            <ul class="navigation-menu-links">
                                @foreach (var (title, text) in products)
                                {
                                    <li>
                                        <BitBhNavigationMenuLink href="@($"navigation-menu#{title.ToLowerInvariant()}")" OnSelect="() => chosen = title" class="navigation-menu-link">
                                            <span class="navigation-menu-link-title">@title</span>
                                            <span class="navigation-menu-link-text">@text</span>
                                        </BitBhNavigationMenuLink>
                                    </li>
                                }
                            </ul>
                        </BitBhNavigationMenuContent>
                    </BitBhNavigationMenuItem>
                    <BitBhNavigationMenuItem Value="resources" class="navigation-menu-item">
                        <BitBhNavigationMenuTrigger class="navigation-menu-trigger">
                            Resources
                            <svg class="navigation-menu-chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                        </BitBhNavigationMenuTrigger>
                        <BitBhNavigationMenuContent class="navigation-menu-content">
                            <ul class="navigation-menu-links navigation-menu-links-stack">
                                @foreach (var title in resources)
                                {
                                    <li>
                                        <BitBhNavigationMenuLink href="@($"navigation-menu#{title.ToLowerInvariant()}")" OnSelect="() => chosen = title" class="navigation-menu-link">
                                            <span class="navigation-menu-link-title">@title</span>
                                        </BitBhNavigationMenuLink>
                                    </li>
                                }
                            </ul>
                        </BitBhNavigationMenuContent>
                    </BitBhNavigationMenuItem>
                    <BitBhNavigationMenuItem class="navigation-menu-item">
                        <BitBhNavigationMenuLink href="navigation-menu#pricing" Active="true" OnSelect="@(() => chosen = "Pricing")" class="navigation-menu-top-link">Pricing</BitBhNavigationMenuLink>
                    </BitBhNavigationMenuItem>
                </BitBhNavigationMenuList>
            </BitBhNavigationMenu>
            <p class="demo-output">Last chosen: <strong>@(chosen ?? "nothing yet")</strong></p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="Viewport, indicator and motion" Code="@_viewportCode" Css="@_css">
    <Description>
        With a <code>BitBhNavigationMenuViewport</code> the open content is moved into one shared panel, which takes its size
        through <code>--bit-bh-navigation-menu-viewport-width</code> / <code>-height</code> and so animates between contents; the
        Tab order and the reading order stay those of a content that follows its trigger. Contents get
        <code>data-motion="from-start|from-end|to-start|to-end"</code> by where the newly open item is relative to the previous
        one, so they slide in from the side they come from. <code>BitBhNavigationMenuIndicator</code> follows the open trigger
        through <code>--bit-bh-indicator-left</code> / <code>-width</code>.
    </Description>
    <LiveContent>
        <div class="navigation-menu-demo">
            <BitBhNavigationMenu aria-label="Site (viewport example)" class="navigation-menu">
                <BitBhNavigationMenuList class="navigation-menu-list">
                    <BitBhNavigationMenuItem Value="learn" class="navigation-menu-item">
                        <BitBhNavigationMenuTrigger class="navigation-menu-trigger">Learn</BitBhNavigationMenuTrigger>
                        <BitBhNavigationMenuContent class="navigation-menu-panel">
                            <ul class="navigation-menu-links">
                                @foreach (var (title, text) in learn)
                                {
                                    <li>
                                        <BitBhNavigationMenuLink href="@($"navigation-menu#{title.ToLowerInvariant().Replace(' ', '-')}")" class="navigation-menu-link">
                                            <span class="navigation-menu-link-title">@title</span>
                                            <span class="navigation-menu-link-text">@text</span>
                                        </BitBhNavigationMenuLink>
                                    </li>
                                }
                            </ul>
                        </BitBhNavigationMenuContent>
                    </BitBhNavigationMenuItem>
                    <BitBhNavigationMenuItem Value="overview" class="navigation-menu-item">
                        <BitBhNavigationMenuTrigger class="navigation-menu-trigger">Overview</BitBhNavigationMenuTrigger>
                        <BitBhNavigationMenuContent class="navigation-menu-panel">
                            <ul class="navigation-menu-links navigation-menu-links-stack">
                                @foreach (var title in overview)
                                {
                                    <li>
                                        <BitBhNavigationMenuLink href="@($"navigation-menu#{title.ToLowerInvariant().Replace(' ', '-')}")" class="navigation-menu-link">
                                            <span class="navigation-menu-link-title">@title</span>
                                        </BitBhNavigationMenuLink>
                                    </li>
                                }
                            </ul>
                        </BitBhNavigationMenuContent>
                    </BitBhNavigationMenuItem>
                    <BitBhNavigationMenuItem class="navigation-menu-item">
                        <BitBhNavigationMenuLink href="navigation-menu#github" class="navigation-menu-top-link">GitHub</BitBhNavigationMenuLink>
                    </BitBhNavigationMenuItem>
                    <BitBhNavigationMenuIndicator class="navigation-menu-indicator" />
                </BitBhNavigationMenuList>
                <div class="navigation-menu-viewport-position">
                    <BitBhNavigationMenuViewport class="navigation-menu-viewport" />
                </div>
            </BitBhNavigationMenu>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="Vertical and bound" Code="@_verticalCode" Css="@_css">
    <Description>
        <code>Orientation="BitBhOrientation.Vertical"</code> makes <kbd>↑</kbd> / <kbd>↓</kbd> move between the items and
        <kbd>→</kbd> (<kbd>←</kbd> in right-to-left) open the content and move into it. <code>@@bind-Value</code> holds the open
        item's value - null when the menu is closed - so code can open and close it too.
    </Description>
    <LiveContent>
        <div class="navigation-menu-demo navigation-menu-sidebar">
            <BitBhNavigationMenu aria-label="Docs (vertical example)" Orientation="BitBhOrientation.Vertical" @bind-Value="openSection">
                <BitBhNavigationMenuList class="navigation-menu-list">
                    @foreach (var (section, pages) in docs)
                    {
                        <BitBhNavigationMenuItem Value="@section" class="navigation-menu-item">
                            <BitBhNavigationMenuTrigger class="navigation-menu-trigger">@section</BitBhNavigationMenuTrigger>
                            <BitBhNavigationMenuContent class="navigation-menu-content">
                                <ul class="navigation-menu-links navigation-menu-links-stack">
                                    @foreach (var title in pages)
                                    {
                                        <li>
                                            <BitBhNavigationMenuLink href="@($"navigation-menu#{title.ToLowerInvariant().Replace(' ', '-')}")" class="navigation-menu-link">
                                                <span class="navigation-menu-link-title">@title</span>
                                            </BitBhNavigationMenuLink>
                                        </li>
                                    }
                                </ul>
                            </BitBhNavigationMenuContent>
                        </BitBhNavigationMenuItem>
                    }
                </BitBhNavigationMenuList>
            </BitBhNavigationMenu>
        </div>
        <div class="demo-row">
            <span class="demo-output">Open: <strong>@(openSection ?? "none")</strong></span>
            <button type="button" class="btn" @onclick="@(() => openSection = "Components")">Open “Components”</button>
        </div>
    </LiveContent>
</DemoBlock>

@code {
    private string? chosen;
    private string? openSection;

    private readonly (string Title, string Text)[] products =
    [
        ("Analytics", "See how visitors find and use your site."),
        ("Automation", "Run the busywork on a schedule."),
        ("Security", "Keep accounts and data safe."),
        ("Integrations", "Connect the tools you already use."),
    ];

    private readonly string[] resources = ["Guides", "Changelog", "Community"];

    private readonly (string Title, string Text)[] learn =
    [
        ("Introduction", "Unstyled, accessible components for Blazor."),
        ("Getting started", "Install the package and register the services."),
        ("Styling", "Style every state with data attributes."),
        ("Testing", "Audit accessibility in your unit tests."),
    ];

    private readonly string[] overview = ["Accessibility", "Releases", "Roadmap"];

    private readonly (string Section, string[] Pages)[] docs =
    [
        ("Guides", ["Installation", "Forms", "Theming"]),
        ("Components", ["Dialog", "Drawer", "Navigation Menu"]),
        ("Testing", ["Audits", "Keyboard helpers"]),
    ];

    private const string _basicCode = """
