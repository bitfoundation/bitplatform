    private const string _viewportCode = """
<BitBhNavigationMenu aria-label="Site" class="navigation-menu">
    <BitBhNavigationMenuList class="navigation-menu-list">
        <BitBhNavigationMenuItem Value="learn" class="navigation-menu-item">
            <BitBhNavigationMenuTrigger class="navigation-menu-trigger">Learn</BitBhNavigationMenuTrigger>
            <BitBhNavigationMenuContent class="navigation-menu-panel">
                <ul class="navigation-menu-links">…</ul>
            </BitBhNavigationMenuContent>
        </BitBhNavigationMenuItem>
        <BitBhNavigationMenuItem Value="overview" class="navigation-menu-item">
            <BitBhNavigationMenuTrigger class="navigation-menu-trigger">Overview</BitBhNavigationMenuTrigger>
            <BitBhNavigationMenuContent class="navigation-menu-panel">
                <ul class="navigation-menu-links navigation-menu-links-stack">…</ul>
            </BitBhNavigationMenuContent>
