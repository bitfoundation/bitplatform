@page "/avatar"

<PageTitle>Avatar — bit Bheadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Avatar</h1>
        <p>An image element with a graceful fallback for representing a user or entity.</p>
        <SectionSwitcher Slug="avatar" />
    </header>

    <DemoBlock Title="Basic"
               Code="@_basicCode"
               Css="@_basicCss">
        <Description>
            Compose <code>BitBhAvatarImage</code> with a <code>BitBhAvatarFallback</code> inside
            <code>BitBhAvatar</code>. The image is only shown once it loads successfully — until
            then the fallback initials are displayed.
        </Description>
        <LiveContent>
            <BitBhAvatar class="avatar">
                <BitBhAvatarImage class="avatar-image"
                               Src="https://images.unsplash.com/photo-1492633423870-43d1cd2775eb?w=128&h=128&dpr=2&q=80"
                               Alt="Colm Tuite" />
                <BitBhAvatarFallback class="avatar-fallback">CT</BitBhAvatarFallback>
            </BitBhAvatar>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Fallback (broken image)"
               Code="@_fallbackCode"
               Css="@_fallbackCss">
        <Description>
            When the image fails to load (or no <code>Src</code> is given), the fallback is
            shown instead of a broken-image icon. Here the source is intentionally invalid.
        </Description>
        <LiveContent>
            <BitBhAvatar class="avatar">
                <BitBhAvatarImage class="avatar-image"
                               Src="https://example.com/does-not-exist.jpg"
                               Alt="Jane Doe" />
                <BitBhAvatarFallback class="avatar-fallback">JD</BitBhAvatarFallback>
            </BitBhAvatar>

            <BitBhAvatar class="avatar">
                <BitBhAvatarFallback class="avatar-fallback avatar-fallback-icon">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                         stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </BitBhAvatarFallback>
            </BitBhAvatar>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Delayed fallback"
               Code="@_delayCode"
               Css="@_delayCss">
        <Description>
            Set <code>DelayMs</code> on the fallback to wait before showing it. This avoids a
            flash of initials for images that load quickly. The fallback only appears if the
            image hasn't loaded by the time the delay elapses.
        </Description>
        <LiveContent>
            <BitBhAvatar class="avatar">
                <BitBhAvatarImage class="avatar-image"
                               Src="https://images.unsplash.com/photo-1511485977113-f34c92461ad9?w=128&h=128&dpr=2&q=80"
                               Alt="Pedro Duarte" />
                <BitBhAvatarFallback class="avatar-fallback" DelayMs="600">PD</BitBhAvatarFallback>
            </BitBhAvatar>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Sizes and shapes"
               Code="@_variantsCode"
               Css="@_variantsCss">
        <Description>
            The library ships zero styling, so size and shape are entirely up to your CSS.
            Override <code>class</code> per avatar for circles, squares, or stacked groups.
        </Description>
        <LiveContent>
            <div class="avatar-row">
                <BitBhAvatar class="avatar avatar-sm">
                    <BitBhAvatarImage class="avatar-image"
                                   Src="https://images.unsplash.com/photo-1607746882042-944635dfe10e?w=96&h=96&dpr=2&q=80"
                                   Alt="" />
                    <BitBhAvatarFallback class="avatar-fallback">AB</BitBhAvatarFallback>
                </BitBhAvatar>

                <BitBhAvatar class="avatar">
                    <BitBhAvatarImage class="avatar-image"
                                   Src="https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=128&h=128&dpr=2&q=80"
                                   Alt="" />
                    <BitBhAvatarFallback class="avatar-fallback">CD</BitBhAvatarFallback>
                </BitBhAvatar>

                <BitBhAvatar class="avatar avatar-lg avatar-square">
                    <BitBhAvatarImage class="avatar-image"
                                   Src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=160&h=160&dpr=2&q=80"
                                   Alt="" />
                    <BitBhAvatarFallback class="avatar-fallback">EF</BitBhAvatarFallback>
                </BitBhAvatar>
            </div>
        </LiveContent>
    </DemoBlock>
</div>

