@page "/tree"

<PageTitle>Tree View — bit Bheadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Tree View</h1>
        <p>A hierarchical list — file explorers, navigation, nested settings — with expand / collapse, single, multiple and checkbox selection, lazy loading and typeahead.</p>
        <SectionSwitcher Slug="tree" />
    </header>

    <DemoBlock Title="File explorer"
               Code="@_explorerCode"
               Css="@_explorerCss">
        <Description>
            The WAI-ARIA Tree View pattern. Click a row to select it (<code>@@bind-SelectedValue</code>) or
            the chevron (<code>BitBhTreeItemToggle</code>) to expand without selecting. Keyboard: Up / Down move,
            Right expands or enters a folder, Left collapses or returns to the parent, Home / End jump,
            <code>*</code> expands every sibling, Enter (or double click) fires <code>OnItemActivate</code>,
            and typing a name jumps to it (typeahead, matched against <code>Label</code>).
            <code>aria-level</code>, <code>aria-setsize</code>, <code>aria-posinset</code> and the roving
            <code>tabindex</code> are computed for you; disabled items are skipped.
        </Description>
        <LiveContent>
            <div class="tree-demo">
                <BitBhTree TValue="string" aria-label="Project files" class="tree"
                        @bind-SelectedValue="selectedFile"
                        DefaultExpandedValues="@(new[] { "src/", "src/components/" })"
                        OnItemActivate="v => openedFile = v">
                    <BitBhTreeItem TValue="string" Value="@("src/")" Label="src" class="tree-item">
                        <Template Context="srcDir">
                            <div class="tree-row">
                                <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                <span class="tree-icon">@(srcDir.IsExpanded ? "📂" : "📁")</span>
                                <span>src</span>
                            </div>
                            <BitBhTreeGroup TValue="string" class="tree-group">
                                <BitBhTreeItem TValue="string" Value="@("src/components/")" Label="components" class="tree-item">
                                    <Template Context="componentsDir">
                                        <div class="tree-row">
                                            <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                            <span class="tree-icon">@(componentsDir.IsExpanded ? "📂" : "📁")</span>
                                            <span>components</span>
                                        </div>
                                        <BitBhTreeGroup TValue="string" class="tree-group">
                                            <BitBhTreeItem TValue="string" Value="@("src/components/Button.razor")" Label="Button.razor" class="tree-item">
                                                <div class="tree-row">
                                                    <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                                    <span class="tree-icon">📄</span>
                                                    <span>Button.razor</span>
                                                </div>
                                            </BitBhTreeItem>
                                            <BitBhTreeItem TValue="string" Value="@("src/components/Tree.razor")" Label="Tree.razor" class="tree-item">
                                                <div class="tree-row">
                                                    <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                                    <span class="tree-icon">📄</span>
                                                    <span>Tree.razor</span>
                                                </div>
                                            </BitBhTreeItem>
                                        </BitBhTreeGroup>
                                    </Template>
                                </BitBhTreeItem>
                                <BitBhTreeItem TValue="string" Value="@("src/services/")" Label="services" class="tree-item">
                                    <Template Context="servicesDir">
                                        <div class="tree-row">
                                            <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                            <span class="tree-icon">@(servicesDir.IsExpanded ? "📂" : "📁")</span>
                                            <span>services</span>
                                        </div>
                                        <BitBhTreeGroup TValue="string" class="tree-group">
                                            <BitBhTreeItem TValue="string" Value="@("src/services/ApiClient.cs")" Label="ApiClient.cs" class="tree-item">
                                                <div class="tree-row">
                                                    <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                                    <span class="tree-icon">📄</span>
                                                    <span>ApiClient.cs</span>
                                                </div>
                                            </BitBhTreeItem>
                                            <BitBhTreeItem TValue="string" Value="@("src/services/AuthService.cs")" Label="AuthService.cs" class="tree-item">
                                                <div class="tree-row">
                                                    <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                                    <span class="tree-icon">📄</span>
                                                    <span>AuthService.cs</span>
                                                </div>
                                            </BitBhTreeItem>
                                        </BitBhTreeGroup>
                                    </Template>
                                </BitBhTreeItem>
                                <BitBhTreeItem TValue="string" Value="@("src/Program.cs")" Label="Program.cs" class="tree-item">
                                    <div class="tree-row">
                                        <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                        <span class="tree-icon">📄</span>
                                        <span>Program.cs</span>
                                    </div>
                                </BitBhTreeItem>
                            </BitBhTreeGroup>
                        </Template>
                    </BitBhTreeItem>
                    <BitBhTreeItem TValue="string" Value="@("wwwroot/")" Label="wwwroot" class="tree-item">
                        <Template Context="wwwDir">
                            <div class="tree-row">
                                <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                <span class="tree-icon">@(wwwDir.IsExpanded ? "📂" : "📁")</span>
                                <span>wwwroot</span>
                            </div>
                            <BitBhTreeGroup TValue="string" class="tree-group">
                                <BitBhTreeItem TValue="string" Value="@("wwwroot/app.css")" Label="app.css" class="tree-item">
                                    <div class="tree-row">
                                        <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                        <span class="tree-icon">🎨</span>
                                        <span>app.css</span>
                                    </div>
                                </BitBhTreeItem>
                                <BitBhTreeItem TValue="string" Value="@("wwwroot/favicon.png")" Label="favicon.png" class="tree-item">
                                    <div class="tree-row">
                                        <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                        <span class="tree-icon">🖼️</span>
                                        <span>favicon.png</span>
                                    </div>
                                </BitBhTreeItem>
                            </BitBhTreeGroup>
                        </Template>
                    </BitBhTreeItem>
                    <BitBhTreeItem TValue="string" Value="@("secrets.json")" Label="secrets.json" Disabled="true" class="tree-item">
                        <div class="tree-row">
                            <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                            <span class="tree-icon">🔒</span>
                            <span>secrets.json</span>
                            <span class="tree-meta">locked</span>
                        </div>
                    </BitBhTreeItem>
                    <BitBhTreeItem TValue="string" Value="@("README.md")" Label="README.md" class="tree-item">
                        <div class="tree-row">
                            <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                            <span class="tree-icon">📄</span>
                            <span>README.md</span>
                        </div>
                    </BitBhTreeItem>
                </BitBhTree>

                <p class="tree-output">
                    Selected: <strong>@(selectedFile ?? "(none)")</strong> ·
                    Last activated: <strong>@(openedFile ?? "—")</strong>
                </p>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Data-driven (recursive)"
               Code="@_recursiveCode"
               Css="@_recursiveCss">
        <Description>
            Render the tree from a model with a recursive <code>RenderFragment&lt;Node&gt;</code> helper. Each
            <code>BitBhTreeItem</code> works out its depth from where it is rendered, so the markup is the same at
            every level. Supplying <code>@@bind-ExpandedValues</code> makes expansion controlled, so plain
            buttons can expand or collapse everything.
        </Description>
        <LiveContent>
            <div class="tree-demo">
                <div class="tree-actions">
                    <button type="button" class="tree-button" @onclick="ExpandAllDocs">Expand all</button>
                    <button type="button" class="tree-button" @onclick="CollapseAllDocs">Collapse all</button>
                </div>

                <BitBhTree TValue="string" aria-label="Documentation" class="tree"
                        @bind-SelectedValue="selectedDoc"
                        @bind-ExpandedValues="expandedDocs">
                    @foreach (var node in docs)
                    {
                        @DocItem(node)
                    }
                </BitBhTree>

                <p class="tree-output">
                    Selected: <strong>@(selectedDoc ?? "(none)")</strong> ·
                    Expanded: <strong>@expandedDocs.Count</strong>
                </p>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Multiple selection"
               Code="@_multiCode"
               Css="@_multiCss">
        <Description>
            <code>SelectionMode="BitBhTreeSelectionMode.Multiple"</code> sets <code>aria-multiselectable</code> and
            binds with <code>@@bind-SelectedValues</code>. Click selects one item, Ctrl / ⌘ + click toggles,
            Shift + click selects a range. Keyboard: Space toggles the focused item, Shift + Up / Down extends
            the selection, Ctrl + A selects everything.
        </Description>
        <LiveContent>
            <div class="tree-demo">
                <BitBhTree TValue="string" aria-label="Mailboxes" class="tree"
                        SelectionMode="BitBhTreeSelectionMode.Multiple"
                        @bind-SelectedValues="selectedBoxes"
                        DefaultExpandedValues="@(new[] { "Inbox", "Projects" })">
                    @foreach (var (icon, name, children) in mailboxes)
                    {
                        <BitBhTreeItem TValue="string" Value="@name" Label="@name" class="tree-item">
                            <div class="tree-row">
                                <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                <span class="tree-icon">@icon</span>
                                <span>@name</span>
                                <span class="tree-count">@children.Length</span>
                            </div>
                            <BitBhTreeGroup TValue="string" class="tree-group">
                                @foreach (var child in children)
                                {
                                    <BitBhTreeItem TValue="string" Value="@($"{name}/{child}")" Label="@child" class="tree-item">
                                        <div class="tree-row">
                                            <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                                            <span class="tree-icon">📁</span>
                                            <span>@child</span>
                                        </div>
                                    </BitBhTreeItem>
                                }
                            </BitBhTreeGroup>
                        </BitBhTreeItem>
                    }
                </BitBhTree>

                <p class="tree-output">
                    @selectedBoxes.Count selected: <strong>@(selectedBoxes.Count == 0 ? "—" : string.Join(", ", selectedBoxes))</strong>
                </p>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Hierarchical checkboxes"
               Code="@_checkboxCode"
               Css="@_checkboxCss">
        <Description>
            <code>Checkboxes="true"</code> turns the tree into a hierarchical picker: checking a parent checks all
            of its descendants, and a parent whose leaves are only partly checked reports
            <code>aria-checked="mixed"</code>. Every item also emits <code>data-checked="true|false|mixed"</code>,
            so the box below is drawn with CSS alone. Click a row or press Space to toggle it.
        </Description>
        <LiveContent>
            <div class="tree-demo">
                <BitBhTree TValue="string" aria-label="Features to install" class="tree"
                        Checkboxes="true"
                        @bind-SelectedValues="checkedFeatures"
                        DefaultExpandedValues="@(new[] { "app", "app-themes" })">
                    @foreach (var node in features)
                    {
                        @FeatureItem(node)
                    }
                </BitBhTree>

                <p class="tree-output">
                    Installing: <strong>@(InstalledFeatures.Any() ? string.Join(", ", InstalledFeatures) : "nothing")</strong>
                </p>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Lazy loading"
               Code="@_lazyCode"
               Css="@_lazyCss">
        <Description>
            Mark folders whose children are not loaded yet with <code>HasChildren="true"</code> and supply
            <code>LoadChildren</code>. It runs the first time a folder expands; meanwhile the item reports
            <code>aria-busy="true"</code> (and <code>IsLoading</code> in its <code>Template</code>) so you can show
            a spinner. The folder opens once the children are rendered.
        </Description>
        <LiveContent>
            <div class="tree-demo">
                <BitBhTree TValue="string" aria-label="Cloud storage" class="tree"
                        LoadChildren="LoadChildrenAsync">
                    @foreach (var bucket in buckets)
                    {
                        @RemoteItem(bucket)
                    }
                </BitBhTree>
            </div>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    // ── File explorer ────────────────────────────────────────────────────────
    private string? selectedFile = "src/components/Tree.razor";
    private string? openedFile;

    // ── Data-driven (recursive) ──────────────────────────────────────────────
    private sealed record Node(string Id, string Name, Node[] Children);

    private readonly Node[] docs =
    [
        new("start", "Getting started",
        [
            new("installation", "Installation", []),
            new("quick-start", "Quick start", []),
        ]),
        new("components", "Components",
        [
            new("overlays", "Overlays",
            [
                new("dialog", "Dialog", []),
                new("popover", "Popover", []),
                new("tooltip", "Tooltip", []),
            ]),
            new("collections", "Collections",
            [
                new("listbox", "Listbox", []),
                new("tree", "Tree View", []),
                new("grid", "Grid", []),
            ]),
        ]),
        new("styling", "Styling",
        [
            new("plain-css", "Plain CSS", []),
            new("tailwind", "Tailwind", []),
        ]),
    ];

    private string? selectedDoc = "tree";
    private IReadOnlyCollection<string> expandedDocs = ["components", "collections"];

    private void ExpandAllDocs() => expandedDocs = Branches(docs).ToArray();

    private void CollapseAllDocs() => expandedDocs = [];

    private static IEnumerable<string> Branches(IEnumerable<Node> nodes) =>
        nodes.Where(n => n.Children.Length > 0).SelectMany(n => Branches(n.Children).Prepend(n.Id));

    private RenderFragment<Node> DocItem => node =>
        @<BitBhTreeItem TValue="string" Value="@node.Id" Label="@node.Name" class="tree-item">
            <div class="tree-row">
                <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                <span>@node.Name</span>
                @if (node.Children.Length > 0)
                {
                    <span class="tree-count">@node.Children.Length</span>
                }
            </div>
            @if (node.Children.Length > 0)
            {
                <BitBhTreeGroup TValue="string" class="tree-group">
                    @foreach (var child in node.Children)
                    {
                        @DocItem(child)
                    }
                </BitBhTreeGroup>
            }
        </BitBhTreeItem>;

    // ── Multiple selection ───────────────────────────────────────────────────
    private readonly (string Icon, string Name, string[] Children)[] mailboxes =
    [
        ("📥", "Inbox", ["Work", "Personal", "Receipts"]),
        ("🗂️", "Projects", ["Apollo", "Gemini", "Mercury"]),
        ("🗄️", "Archive", ["2024", "2025"]),
    ];

    private IReadOnlyCollection<string> selectedBoxes = [];

    // ── Hierarchical checkboxes ──────────────────────────────────────────────
    private readonly Node[] features =
    [
        new("app", "Desktop app",
        [
            new("app-core", "Core runtime", []),
            new("app-spellcheck", "Spell checker", []),
            new("app-themes", "Themes",
            [
                new("theme-light", "Light", []),
                new("theme-dark", "Dark", []),
                new("theme-contrast", "High contrast", []),
            ]),
        ]),
        new("cli", "Command-line tools",
        [
            new("cli-core", "CLI", []),
            new("cli-completions", "Shell completions", []),
        ]),
        new("offline-docs", "Offline documentation", []),
    ];

    private IReadOnlyCollection<string> checkedFeatures = ["app-core", "theme-light", "theme-dark"];

    private IEnumerable<string> InstalledFeatures =>
        Leaves(features).Where(n => checkedFeatures.Contains(n.Id)).Select(n => n.Name);

    private static IEnumerable<Node> Leaves(IEnumerable<Node> nodes) =>
        nodes.SelectMany(n => n.Children.Length == 0 ? new[] { n } : Leaves(n.Children));

    private RenderFragment<Node> FeatureItem => node =>
        @<BitBhTreeItem TValue="string" Value="@node.Id" Label="@node.Name" class="tree-item">
            <div class="tree-row">
                <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                <span class="tree-check" aria-hidden="true"></span>
                <span>@node.Name</span>
            </div>
            @if (node.Children.Length > 0)
            {
                <BitBhTreeGroup TValue="string" class="tree-group">
                    @foreach (var child in node.Children)
                    {
                        @FeatureItem(child)
                    }
                </BitBhTreeGroup>
            }
        </BitBhTreeItem>;

    // ── Lazy loading ─────────────────────────────────────────────────────────
    private sealed record RemoteEntry(string Path, string Name, bool IsFolder);

    private readonly RemoteEntry[] buckets =
    [
        new("media", "media-bucket", true),
        new("logs", "logs-bucket", true),
        new("backups", "backups-bucket", true),
    ];

    private readonly Dictionary<string, RemoteEntry[]> loadedChildren = new();

    private async Task LoadChildrenAsync(string path)
    {
        await Task.Delay(800); // simulate a network round-trip

        if (path.Contains('/'))
        {
            loadedChildren[path] =
            [
                new($"{path}/january.csv", "january.csv", false),
                new($"{path}/february.csv", "february.csv", false),
            ];
        }
        else
        {
            loadedChildren[path] =
            [
                new($"{path}/2025", "2025", true),
                new($"{path}/2026", "2026", true),
                new($"{path}/manifest.json", "manifest.json", false),
            ];
        }

        StateHasChanged();
    }

    private RenderFragment<RemoteEntry> RemoteItem => entry =>
        @<BitBhTreeItem TValue="string" Value="@entry.Path" Label="@entry.Name" HasChildren="entry.IsFolder" class="tree-item">
            <Template Context="state">
                <div class="tree-row">
                    <BitBhTreeItemToggle TValue="string" class="tree-toggle">▸</BitBhTreeItemToggle>
                    <span class="tree-icon">@(entry.IsFolder ? (state.IsExpanded ? "📂" : "📁") : "📄")</span>
                    <span>@entry.Name</span>
                    @if (state.IsLoading)
                    {
                        <span class="tree-meta">Loading…</span>
                        <span class="tree-spinner" aria-hidden="true"></span>
                    }
                </div>
                @if (loadedChildren.TryGetValue(entry.Path, out var children))
                {
                    <BitBhTreeGroup TValue="string" class="tree-group">
                        @foreach (var child in children)
                        {
                            @RemoteItem(child)
                        }
                    </BitBhTreeGroup>
                }
            </Template>
        </BitBhTreeItem>;

    // ── Source snippets shown alongside each live demo ─────────────────────────

