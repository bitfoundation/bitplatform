    private const string _treeBaseCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.tree-demo { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; width: 100%; }
.tree-output { font-size: 0.875rem; color: #71717a; }
.tree-output strong { color: #18181b; font-weight: 600; }

/* BitBhTree renders <ul role="tree">, BitBhTreeGroup <ul role="group">. */
.tree,
.tree-group {
    margin: 0;
    padding: 0;
    list-style: none;
}

.tree {
    width: 100%;
    max-width: 22rem;
    padding: 0.375rem;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    color: #18181b;
}

/* <li role="treeitem"> wraps its own row AND its child group, so state styles
   target the item's direct .tree-row child — a selected folder must not tint
   the rows of its children. */
.tree-item { outline: none; }

.tree-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 1.875rem;
    padding: 0.2rem 0.5rem;
    /* --bit-bh-tree-level (1, 2, 3, …) is emitted on every BitBhTreeItem. */
    padding-inline-start: calc((var(--bit-bh-tree-level, 1) - 1) * 1.25rem + 0.375rem);
    border-radius: 0.375rem;
    cursor: pointer;
    user-select: none;
}
.tree-row:hover { background: #f4f4f5; }

/* Roving focus: the focused <li> draws its ring on its own row. */
.tree-item:focus-visible > .tree-row { outline: 2px solid #2563eb; outline-offset: -2px; }

/* aria-selected is emitted in single / multiple selection mode. */
.tree-item[aria-selected="true"] > .tree-row { background: #eff6ff; color: #1d4ed8; font-weight: 500; }

.tree-item[data-disabled] > .tree-row { background: transparent; opacity: 0.45; cursor: not-allowed; }

/* BitBhTreeItemToggle: data-state="open|closed" on branches, data-leaf on leaves. */
.tree-toggle {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 0.25rem;
    color: #a1a1aa;
    font-size: 0.75rem;
    transition: transform 150ms ease;
}
.tree-toggle:hover              { background: #e4e4e7; color: #18181b; }
.tree-toggle[data-state="open"] { transform: rotate(90deg); }
.tree-toggle[data-leaf]         { visibility: hidden; }

.tree-icon { flex: none; width: 1.25rem; text-align: center; }
""";

