@page "/combobox"

<PageTitle>Combobox — bit Bheadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Combobox</h1>
        <p>An accessible typeable autocomplete with consumer-driven filtering.</p>
        <SectionSwitcher Slug="combobox" />
    </header>

    <DemoBlock Title="Basic Combobox"
               Code="@_basicCode"
               Css="@_comboboxCss">
        <Description>
            Type to filter, use Up / Down to navigate, Enter to select, Escape to close.
            The combobox emits an <code>OnQueryChange</code> event; you do the filtering
            in your own code and pass only the matching options as children.
        </Description>
        <LiveContent>
            <BitBhCombobox TValue="string"
                       Value="@selectedFruit"
                       OnValueChange="v => selectedFruit = v"
                       OnQueryChange="HandleFruitQuery"
                       DisplayValue="v => v ?? string.Empty"
                       class="combobox">
                <div class="combobox-input-wrapper">
                    <BitBhComboboxInput TValue="string"
                                    Placeholder="Pick a fruit…"
                                    class="combobox-input" />
                    <BitBhComboboxButton TValue="string" class="combobox-button">
                        <Template Context="b">
                            <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhComboboxButton>
                </div>
                <BitBhComboboxOptions TValue="string" class="combobox-options">
                    @if (filteredFruits.Count == 0)
                    {
                        <li class="combobox-empty">No matches.</li>
                    }
                    else
                    {
                        @foreach (var fruit in filteredFruits)
                        {
                            <BitBhComboboxOption TValue="string" Value="@fruit" class="combobox-option">
                                <Template Context="o">
                                    <span>@fruit</span>
                                    @if (o.IsSelected) { <span class="combobox-tick">✓</span> }
                                </Template>
                            </BitBhComboboxOption>
                        }
                    }
                </BitBhComboboxOptions>
            </BitBhCombobox>

            <span class="demo-output">Selected: <strong>@(selectedFruit ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Multi-select with chips"
               Code="@_multiCode"
               Css="@_multiCss">
        <Description>
            Set <code>Multiple="true"</code> to allow many selections. Selected values are
            shown as chips above the input (each with a remove button). The panel stays
            open after each pick.
        </Description>
        <LiveContent>
            <BitBhCombobox TValue="string" Multiple="true"
                       Values="@pickedTags"
                       OnValuesChange="v => pickedTags = v"
                       OnQueryChange="HandleTagQuery"
                       class="combobox">
                <div class="combobox-input-wrapper combobox-input-wrapper-multi">
                    @foreach (var tag in pickedTags)
                    {
                        <span class="combobox-chip">
                            @tag
                            <button type="button"
                                    class="combobox-chip-remove"
                                    @onclick="() => RemoveTag(tag)"
                                    aria-label="@($"Remove {tag}")">×</button>
                        </span>
                    }
                    <BitBhComboboxInput TValue="string"
                                    Placeholder="@(pickedTags.Count == 0 ? "Pick tags…" : "")"
                                    class="combobox-input combobox-input-inline" />
                    <BitBhComboboxButton TValue="string" class="combobox-button">
                        <Template Context="b">
                            <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhComboboxButton>
                </div>
                <BitBhComboboxOptions TValue="string" class="combobox-options">
                    @if (filteredTags.Count == 0)
                    {
                        <li class="combobox-empty">No matches.</li>
                    }
                    else
                    {
                        @foreach (var tag in filteredTags)
                        {
                            <BitBhComboboxOption TValue="string" Value="@tag" class="combobox-option">
                                <Template Context="o">
                                    <span class="combobox-tick">@(o.IsSelected ? "✓" : "")</span>
                                    <span>@tag</span>
                                </Template>
                            </BitBhComboboxOption>
                        }
                    }
                </BitBhComboboxOptions>
            </BitBhCombobox>

            <span class="demo-output">Picked: <strong>@(pickedTags.Count == 0 ? "(none)" : string.Join(", ", pickedTags))</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Object values with rich content"
               Code="@_objectCode"
               Css="@_objectCss">
        <Description>
            Bind to objects rather than strings. Provide a <code>DisplayValue</code> function
            that converts the selected object back to the input text, and render rich content
            inside each option.
        </Description>
        <LiveContent>
            <BitBhCombobox TValue="Person"
                       Value="@selectedPerson"
                       OnValueChange="v => selectedPerson = v"
                       OnQueryChange="HandlePersonQuery"
                       DisplayValue="p => p?.Name ?? string.Empty"
                       class="combobox">
                <div class="combobox-input-wrapper">
                    <BitBhComboboxInput TValue="Person"
                                    Placeholder="Search people…"
                                    class="combobox-input" />
                    <BitBhComboboxButton TValue="Person" class="combobox-button">
                        <Template Context="b">
                            <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhComboboxButton>
                </div>
                <BitBhComboboxOptions TValue="Person" class="combobox-options">
                    @if (filteredPeople.Count == 0)
                    {
                        <li class="combobox-empty">No matches.</li>
                    }
                    else
                    {
                        @foreach (var person in filteredPeople)
                        {
                            <BitBhComboboxOption TValue="Person" Value="@person" class="combobox-option">
                                <Template Context="o">
                                    <div class="person-row">
                                        <span class="person-avatar">@person.Initials</span>
                                        <div class="person-info">
                                            <strong>@person.Name</strong>
                                            <span>@person.Email</span>
                                        </div>
                                        @if (o.IsSelected) { <span class="combobox-tick">✓</span> }
                                    </div>
                                </Template>
                            </BitBhComboboxOption>
                        }
                    }
                </BitBhComboboxOptions>
            </BitBhCombobox>

            <span class="demo-output">
                Selected: <strong>@(selectedPerson?.Name ?? "(none)")</strong>
            </span>
        </LiveContent>
    </DemoBlock>
    <DemoBlock Title="Anchor Positioning"
               Code="@_anchorCode"
               Css="@_anchorCss">
        <Description>
            Set <code>Anchor</code> on <code>BitBhComboboxOptions</code> to automatically position
            the dropdown relative to the input using <code>position: fixed</code>. The panel
            flips to the opposite side when there's not enough space, shifts to stay within
            the viewport, and auto-updates on scroll/resize. No <code>position: relative</code>
            on the parent is needed.
        </Description>
        <LiveContent>
            <div style="display:flex; gap:2rem; flex-wrap:wrap; align-items:flex-end;">
                <div>
                    <p style="font-size:0.8rem; color:var(--color-muted); margin:0 0 0.5rem;">Bottom Start</p>
                    <BitBhCombobox TValue="string"
                               Value="@anchorFruit"
                               OnValueChange="v => anchorFruit = v"
                               OnQueryChange="HandleAnchorFruitQuery"
                               DisplayValue="v => v ?? string.Empty"
                               class="combobox-anchored">
                        <div class="combobox-input-wrapper">
                            <BitBhComboboxInput TValue="string"
                                            Placeholder="Pick a fruit…"
                                            class="combobox-input" />
                            <BitBhComboboxButton TValue="string" class="combobox-button">
                                <Template Context="b">
                                    <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                                </Template>
                            </BitBhComboboxButton>
                        </div>
                        <BitBhComboboxOptions TValue="string"
                                          Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })"
                                          class="combobox-options-anchored">
                            @if (anchorFilteredFruits.Count == 0)
                            {
                                <li class="combobox-empty">No matches.</li>
                            }
                            else
                            {
                                @foreach (var fruit in anchorFilteredFruits)
                                {
                                    <BitBhComboboxOption TValue="string" Value="@fruit" class="combobox-option">
                                        <Template Context="o">
                                            <span>@fruit</span>
                                            @if (o.IsSelected) { <span class="combobox-tick">✓</span> }
                                        </Template>
                                    </BitBhComboboxOption>
                                }
                            }
                        </BitBhComboboxOptions>
                    </BitBhCombobox>
                </div>

                <div>
                    <p style="font-size:0.8rem; color:var(--color-muted); margin:0 0 0.5rem;">Top Start (flips down if no space)</p>
                    <BitBhCombobox TValue="string"
                               Value="@anchorFruit2"
                               OnValueChange="v => anchorFruit2 = v"
                               OnQueryChange="HandleAnchorFruitQuery2"
                               DisplayValue="v => v ?? string.Empty"
                               class="combobox-anchored">
                        <div class="combobox-input-wrapper">
                            <BitBhComboboxInput TValue="string"
                                            Placeholder="Pick a fruit…"
                                            class="combobox-input" />
                            <BitBhComboboxButton TValue="string" class="combobox-button">
                                <Template Context="b">
                                    <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                                </Template>
                            </BitBhComboboxButton>
                        </div>
                        <BitBhComboboxOptions TValue="string"
                                          Anchor="@(new BitBhAnchorOptions { To = "top start", Gap = 4 })"
                                          class="combobox-options-anchored">
                            @if (anchorFilteredFruits2.Count == 0)
                            {
                                <li class="combobox-empty">No matches.</li>
                            }
                            else
                            {
                                @foreach (var fruit in anchorFilteredFruits2)
                                {
                                    <BitBhComboboxOption TValue="string" Value="@fruit" class="combobox-option">
                                        <Template Context="o">
                                            <span>@fruit</span>
                                            @if (o.IsSelected) { <span class="combobox-tick">✓</span> }
                                        </Template>
                                    </BitBhComboboxOption>
                                }
                            }
                        </BitBhComboboxOptions>
                    </BitBhCombobox>
                </div>
            </div>

            <span class="demo-output" style="margin-top:0.75rem;">
                Selected: <strong>@(anchorFruit ?? anchorFruit2 ?? "(none)")</strong>
            </span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Large lists (virtualized)"
               Code="@_virtualCode"
               Css="@_virtualCss">
        <Description>
            Pass the matching data to <code>BitBhComboboxOptions</code> through <code>Items</code> with an
            <code>ItemTemplate</code>, and set <code>Virtualize="true"</code> so only the options in view
            are rendered (fixed <code>ItemSize</code>, scrollable panel). Filtering stays yours:
            <code>OnQueryChange</code> runs <code>BitBhFilter.Contains</code> — case- and
            accent-insensitive — over 10,000 items on every keystroke. Child content such as
            <code>BitBhComboboxEmpty</code> still renders after the data options.
        </Description>
        <LiveContent>
            <BitBhCombobox TValue="string"
                        @bind-Value="virtualPick"
                        OnQueryChange="HandleVirtualQuery"
                        DisplayValue="v => v ?? string.Empty"
                        class="combobox-anchored">
                <div class="combobox-input-wrapper">
                    <BitBhComboboxInput TValue="string" Placeholder="Search 10,000 animals…" class="combobox-input" />
                    <BitBhComboboxButton TValue="string" class="combobox-button">
                        <Template Context="b">
                            <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                        </Template>
                    </BitBhComboboxButton>
                </div>
                <BitBhComboboxOptions TValue="string"
                                   Items="@virtualMatches"
                                   Virtualize="true"
                                   ItemSize="36"
                                   Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })"
                                   class="combobox-virtual">
                    <ItemTemplate Context="o">
                        <span>@o.Value</span>
                        @if (o.IsSelected) { <span class="combobox-tick">✓</span> }
                    </ItemTemplate>
                    <ChildContent>
                        <BitBhComboboxEmpty TValue="string" class="combobox-empty">No animals match.</BitBhComboboxEmpty>
                    </ChildContent>
                </BitBhComboboxOptions>
            </BitBhCombobox>

            <span class="demo-output">
                @virtualMatches.Count.ToString("N0") matches · Selected: <strong>@(virtualPick ?? "(none)")</strong>
            </span>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    // ── Large lists (virtualized) ───────────────────────────────────────────

    // 10 adjectives × 10 animals × 100 = 10,000 items.
    private static readonly string[] VirtualItems = BuildVirtualItems();
    private IReadOnlyList<string> virtualMatches = VirtualItems;
    private string? virtualPick;

    private static string[] BuildVirtualItems()
    {
        string[] adjectives = ["Amber", "Brave", "Calm", "Dusty", "Eager", "Fuzzy", "Gentle", "Hazy", "Icy", "Jolly"];
        string[] animals = ["Badger", "Crane", "Dingo", "Falcon", "Gecko", "Heron", "Ibis", "Jaguar", "Koala", "Lynx"];
        return Enumerable.Range(0, 10_000)
            .Select(i => $"{adjectives[i / 1000]} {animals[i / 100 % 10]} {i % 100 + 1}")
            .ToArray();
    }

    private void HandleVirtualQuery(string query) =>
        virtualMatches = VirtualItems.Where(item => BitBhFilter.Contains(item, query)).ToArray();

    // ── Single-select (fruits) ──────────────────────────────────────────────

    private string? selectedFruit;
    private string fruitQuery = string.Empty;
    private string[] allFruits = new[] {
        "Apple", "Apricot", "Banana", "Blueberry", "Cherry",
        "Coconut", "Cranberry", "Grape", "Kiwi", "Lemon",
        "Lime", "Mango", "Orange", "Papaya", "Peach",
        "Pear", "Pineapple", "Plum", "Raspberry", "Strawberry"
    };
    private List<string> filteredFruits = new();

    private void HandleFruitQuery(string query)
    {
        fruitQuery = query;
        filteredFruits = string.IsNullOrWhiteSpace(query)
            ? allFruits.ToList()
            : allFruits
                .Where(f => f.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    // ── Anchor positioning demo ─────────────────────────────────────────────

    private string? anchorFruit;
    private string? anchorFruit2;
    private List<string> anchorFilteredFruits = new();
    private List<string> anchorFilteredFruits2 = new();

    private void HandleAnchorFruitQuery(string query)
    {
        anchorFilteredFruits = string.IsNullOrWhiteSpace(query)
            ? allFruits.ToList()
            : allFruits
                .Where(f => f.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private void HandleAnchorFruitQuery2(string query)
    {
        anchorFilteredFruits2 = string.IsNullOrWhiteSpace(query)
            ? allFruits.ToList()
            : allFruits
                .Where(f => f.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    // ── Multi-select (tags) ─────────────────────────────────────────────────

    private IReadOnlyCollection<string> pickedTags = Array.Empty<string>();
    private string tagQuery = string.Empty;
    private string[] allTags = new[] {
        "design", "engineering", "marketing", "sales", "support",
        "research", "product", "operations", "finance", "legal"
    };
    private List<string> filteredTags = new();

    private void HandleTagQuery(string query)
    {
        tagQuery = query;
        filteredTags = string.IsNullOrWhiteSpace(query)
            ? allTags.ToList()
            : allTags
                .Where(t => t.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private void RemoveTag(string tag)
    {
        pickedTags = pickedTags.Where(t => t != tag).ToList();
    }

    // ── Object values (people) ──────────────────────────────────────────────

    public sealed record Person(string Name, string Email)
    {
        public string Initials =>
            string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                              .Take(2)
                              .Select(p => p[0]));
    }

    private Person? selectedPerson;
    private string personQuery = string.Empty;
    private Person[] allPeople = new[]
    {
        new Person("Alice Anderson",  "alice@example.com"),
        new Person("Benjamin Brown",  "ben@example.com"),
        new Person("Caterina Costa",  "cat@example.com"),
        new Person("Daniel Davis",    "dan@example.com"),
        new Person("Eleanor Evans",   "ellie@example.com"),
        new Person("Felix Foster",    "felix@example.com"),
        new Person("Genevieve Gomez", "gen@example.com"),
        new Person("Henry Hughes",    "henry@example.com"),
    };
    private List<Person> filteredPeople = new();

    private void HandlePersonQuery(string query)
    {
        personQuery = query;
        filteredPeople = string.IsNullOrWhiteSpace(query)
            ? allPeople.ToList()
            : allPeople
                .Where(p => p.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                         || p.Email.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    protected override void OnInitialized()
    {
        // Seed each demo's filtered list with everything so the panel has data on first open.
        filteredFruits = allFruits.ToList();
        filteredTags   = allTags.ToList();
        filteredPeople = allPeople.ToList();
        anchorFilteredFruits = allFruits.ToList();
        anchorFilteredFruits2 = allFruits.ToList();
    }

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _virtualCode = """
<BitBhCombobox TValue="string"
            @bind-Value="virtualPick"
            OnQueryChange="HandleVirtualQuery"
            DisplayValue="v => v ?? string.Empty"
            class="combobox-anchored">
    <div class="combobox-input-wrapper">
        <BitBhComboboxInput TValue="string" Placeholder="Search 10,000 animals…" class="combobox-input" />
        <BitBhComboboxButton TValue="string" class="combobox-button">
            <Template Context="b">
                <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
            </Template>
        </BitBhComboboxButton>
    </div>

    <BitBhComboboxOptions TValue="string"
                       Items="@virtualMatches"
                       Virtualize="true"
                       ItemSize="36"
                       Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })"
                       class="combobox-virtual">
        <ItemTemplate Context="o">
            <span>@o.Value</span>
            @if (o.IsSelected) { <span class="combobox-tick">✓</span> }
        </ItemTemplate>
        <ChildContent>
            @* Rendered after the data options when nothing matches *@
            <BitBhComboboxEmpty TValue="string" class="combobox-empty">No animals match.</BitBhComboboxEmpty>
        </ChildContent>
    </BitBhComboboxOptions>
</BitBhCombobox>

@code {
    // 10 adjectives × 10 animals × 100 = 10,000 items.
    private static readonly string[] VirtualItems = BuildVirtualItems();
    private IReadOnlyList<string> virtualMatches = VirtualItems;
    private string? virtualPick;

    private static string[] BuildVirtualItems()
    {
        string[] adjectives = ["Amber", "Brave", "Calm", "Dusty", "Eager", "Fuzzy", "Gentle", "Hazy", "Icy", "Jolly"];
        string[] animals = ["Badger", "Crane", "Dingo", "Falcon", "Gecko", "Heron", "Ibis", "Jaguar", "Koala", "Lynx"];
        return Enumerable.Range(0, 10_000)
            .Select(i => $"{adjectives[i / 1000]} {animals[i / 100 % 10]} {i % 100 + 1}")
            .ToArray();
    }

    // Case- and accent-insensitive "contains" match.
    private void HandleVirtualQuery(string query) =>
        virtualMatches = VirtualItems.Where(item => BitBhFilter.Contains(item, query)).ToArray();
}
""";

    private const string _virtualCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.combobox-anchored { display: inline-block; min-width: 18rem; }

.combobox-input-wrapper {
    display: flex;
    align-items: center;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    background: #fff;
}
.combobox-input-wrapper:focus-within { border-color: #2563eb; }

.combobox-input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.5rem 0.85rem;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 0.9rem;
    outline: none;
}

.combobox-button { all: unset; display: inline-flex; padding: 0 0.65rem; cursor: pointer; color: #71717a; }
.combobox-chevron      { transition: transform 200ms ease; }
.combobox-chevron.open { transform: rotate(180deg); }

/* Virtualized panel: a scroll container with a bounded height (positioned by Anchor) */
.combobox-virtual {
    z-index: 9999;
    width: 18rem;
    max-height: 16rem;
    overflow-y: auto;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
}
.combobox-virtual[hidden] { display: none; }

/* Data-driven options carry no class — target the role.
   Every option must be exactly ItemSize (36px) tall. */
.combobox-virtual > [role="option"] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    box-sizing: border-box;
    padding: 0 0.65rem;
    border-radius: 0.35rem;
    font-size: 0.9rem;
    white-space: nowrap;
    cursor: pointer;
}
.combobox-virtual > [role="option"][data-active]   { background: #eff6ff; }
.combobox-virtual > [role="option"][data-selected] { font-weight: 600; }

.combobox-empty { padding: 0.6rem 0.65rem; color: #71717a; font-size: 0.85rem; font-style: italic; }
.combobox-tick  { color: #2563eb; font-weight: 700; }
""";

    private const string _basicCode = """
