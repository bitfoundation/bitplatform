                        <span class="cmd-item-icon" aria-hidden="true">⚙️</span> Settings…
                        <span class="cmd-item-arrow" aria-hidden="true">›</span>
                    </BitBhCommandItem>
                    <BitBhCommandItem Value="Invite teammates" OnSelect='@(() => CompleteAsync(cmd, "Invite teammates"))' class="cmd-item">
                        <span class="cmd-item-icon" aria-hidden="true">✉️</span> Invite teammates
                    </BitBhCommandItem>
                </BitBhCommandGroup>
            </Template>
        </BitBhCommandPage>

        <BitBhCommandPage Name="Projects">
            <Template Context="cmd">
                @foreach (var project in projects)
                {
