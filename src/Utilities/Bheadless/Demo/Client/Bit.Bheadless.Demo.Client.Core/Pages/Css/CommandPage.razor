    </div>
    <div class="cmd-input-row">
        <BitBhCommandInput AutoFocus="false" class="cmd-input" placeholder="@PagePlaceholder" />
    </div>
    <BitBhCommandList class="cmd-list">
        <BitBhCommandEmpty class="cmd-empty">No results found.</BitBhCommandEmpty>

        <BitBhCommandPage>
            <Template Context="cmd">
                <BitBhCommandGroup Heading="Workspace" class="cmd-group">
                    <BitBhCommandItem Value="Search projects" OnSelect='@(() => cmd.PushPageAsync("Projects"))' class="cmd-item">
