@code {
    private sealed record Doc(string Name, string Summary);

    private static readonly Doc[] _docs =
    [
        new("Accordion", "Vertically stacked, collapsible sections"),
        new("Checkbox", "Two- or three-state toggle with a label"),
        new("Combobox", "Text input with a filterable list of options"),
        new("Command Palette", "Searchable, keyboard-first list of actions"),
        new("Dialog", "Modal window with a focus trap"),
        // …
    ];

    private IReadOnlyList<Doc> docResults = _docs.Take(6).ToList();
    private string docsQuery = "";
    private bool searching;
    private int searchVersion;
    private string? lastCommand;

    private void Run(string command) => lastCommand = command;

    private async Task SearchDocsAsync(string query)
    {
        docsQuery = query;
        var version = ++searchVersion;
        searching = true;

        await Task.Delay(350); // pretend this is an HTTP call
        if (version != searchVersion) return; // a newer keystroke superseded this one

        docResults = string.IsNullOrWhiteSpace(query)
            ? _docs.Take(6).ToList()
            : BitBhFilter.Fuzzy(_docs, query, d => d.Name).ToList();
        searching = false;
    }
}
""";

