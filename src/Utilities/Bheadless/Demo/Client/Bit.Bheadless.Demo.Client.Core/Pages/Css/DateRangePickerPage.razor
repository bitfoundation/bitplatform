@page "/date-range-picker"
@using System.ComponentModel.DataAnnotations
@using System.Globalization

<PageTitle>Date Range Picker · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Date Range Picker</h1>
    <p class="bb-subtitle">A start and an end date, each typed into its own segments, with a button that opens a range calendar in a popover.</p>
</div>

<SectionSwitcher Slug="date-range-picker" />

<DemoBlock Title="Date range picker" Code="@_basicCode" Css="@_css">
    <Description>
        <code>BitBhDateRangePicker</code> holds two <code>BitBhDateRangePickerInput</code>s — the start and the end, each a
        date field of its own, a <code>role="group"</code> named "Start date" / "End date" and the field's label — the
        <code>BitBhDatePickerTrigger</code> ("Choose date range") and the <code>BitBhDatePickerContent</code> popover, where
        the <code>BitBhCalendar</code> picks ranges. Type a whole range in one go: the focus runs on from the start's year
        into the end's month (and <kbd>Backspace</kbd> or ← back). In the calendar the first press sets one end and the
        second the other, which closes the popover and returns the focus to the button; <kbd>Escape</kbd> drops a
        half-picked range. <code>@@bind-Value</code> is a <code>BitBhDateRange?</code>, set once both dates are in, in order.
    </Description>
    <LiveContent>
        <div class="date-range-picker-demo">
            <BitBhField>
                <BitBhLabel class="date-range-picker-label">Stay</BitBhLabel>
                <BitBhDateRangePicker @bind-Value="stay" Culture="DemoDateCultures.EnUs">
                    <BitBhDatePickerGroup class="date-range-picker-group">
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.Start" class="date-range-picker-input" />
                        <span class="date-range-picker-separator" aria-hidden="true">–</span>
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.End" class="date-range-picker-input" />
                        <BitBhDatePickerTrigger class="date-range-picker-trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="date-range-picker-popover">
                        @RangeCalendar
                    </BitBhDatePickerContent>
                </BitBhDateRangePicker>
            </BitBhField>
            <p class="date-range-picker-value">Stay: <strong>@Describe(stay)</strong></p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="Limits and unavailable dates" Code="@_limitsCode" Css="@_css">
    <Description>
        <code>Min</code>, <code>Max</code>, <code>IsDateUnavailable</code> and <code>AllowsNonContiguousRanges</code> go to
        the calendar (unless it is given its own): booked nights are unavailable, and a range can't span them. A typed
        range that breaks them — or an end before its start — is kept and marks the picker invalid (<code>data-invalid</code>,
        <code>aria-invalid</code> on both dates).
    </Description>
    <LiveContent>
        <div class="date-range-picker-demo">
            <BitBhField>
                <BitBhLabel class="date-range-picker-label">Booking</BitBhLabel>
                <BitBhDateRangePicker @bind-Value="booking" Min="today" Max="today.AddMonths(6)" IsDateUnavailable="IsBooked"
                                      Culture="DemoDateCultures.EnUs">
                    <BitBhDatePickerGroup class="date-range-picker-group">
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.Start" class="date-range-picker-input" />
                        <span class="date-range-picker-separator" aria-hidden="true">–</span>
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.End" class="date-range-picker-input" />
                        <BitBhDatePickerTrigger class="date-range-picker-trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="date-range-picker-popover">
                        @RangeCalendar
                    </BitBhDatePickerContent>
                </BitBhDateRangePicker>
                <BitBhDescription class="date-range-picker-description">The next six months; struck-through nights are booked.</BitBhDescription>
            </BitBhField>
            <p class="date-range-picker-value">Booking: <strong>@Describe(booking)</strong></p>
        </div>
    </LiveContent>
</DemoBlock>

<DemoBlock Title="In a German form" Code="@_formCode" Css="@_css">
    <Description>
        The picker joins <code>EditForm</code> validation through <code>@@bind-Value</code>; <code>BitBhErrorMessage</code>
        describes the group once invalid, and <code>Name</code> posts the range as an ISO interval
        (<code>2026-11-08/2026-11-12</code>), as a range calendar does. The inputs and the button take German names
        (<code>aria-label</code>), and with a German <code>Culture</code> the segments read <code>dd.MM.yyyy</code>.
    </Description>
    <LiveContent>
        <EditForm Model="form" OnValidSubmit="() => sent = form.Holiday">
            <DataAnnotationsValidator />
            <BitBhField>
                <BitBhLabel class="date-range-picker-label">Urlaub</BitBhLabel>
                <BitBhDateRangePicker @bind-Value="form.Holiday" Name="holiday" Culture="DemoDateCultures.DeDe">
                    <BitBhDatePickerGroup class="date-range-picker-group">
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.Start" aria-label="Erster Tag" class="date-range-picker-input" />
                        <span class="date-range-picker-separator" aria-hidden="true">–</span>
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.End" aria-label="Letzter Tag" class="date-range-picker-input" />
                        <BitBhDatePickerTrigger aria-label="Zeitraum wählen" class="date-range-picker-trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="date-range-picker-popover">
                        @RangeCalendar
                    </BitBhDatePickerContent>
                </BitBhDateRangePicker>
                <BitBhErrorMessage class="date-range-picker-error" />
            </BitBhField>
            <button type="submit" class="date-range-picker-submit">Senden</button>
            @if (sent is { } holiday)
            {
                <p class="date-range-picker-value">Gesendet: <strong>@holiday.Start.ToString("d", DemoDateCultures.DeDe) – @holiday.End.ToString("d", DemoDateCultures.DeDe)</strong></p>
            }
        </EditForm>
    </LiveContent>
</DemoBlock>

@code {
    private static readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private BitBhDateRange? stay;
    private BitBhDateRange? booking;
    private readonly HolidayForm form = new();
    private BitBhDateRange? sent;

    private static bool IsBooked(DateOnly d) => d.DayNumber % 9 is 4 or 5;

    private static string Describe(BitBhDateRange? range) => range is null
        ? "none"
        : $"{range.Start.ToString("MMM d", DemoDateCultures.EnUs)} – {range.End.ToString("MMM d, yyyy", DemoDateCultures.EnUs)} ({range.Days - 1} nights)";

    private sealed class HolidayForm
    {
        [Required(ErrorMessage = "Bitte einen Zeitraum wählen.")]
        public BitBhDateRange? Holiday { get; set; }
    }

    private static readonly RenderFragment CalendarIcon =
        @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
        </svg>;

    // Two months side by side, with the Calendar page's .calendar-* classes.
    private static readonly RenderFragment RangeCalendar =
        @<BitBhCalendar VisibleMonths="2" class="calendar">
            <div class="calendar-header">
                <BitBhCalendarPrevious class="calendar-nav">‹</BitBhCalendarPrevious>
                <BitBhCalendarHeading As="h3" class="calendar-heading" />
                <BitBhCalendarNext class="calendar-nav">›</BitBhCalendarNext>
            </div>
            <div class="calendar-months">
                @for (var i = 0; i < 2; i++)
                {
                    var offset = i;
                    <div>
                        <BitBhCalendarHeading Offset="offset" As="h4" class="calendar-month-title" aria-hidden="true" />
                        <BitBhCalendarGrid Offset="offset" Context="day" class="calendar-grid">
                            <BitBhCalendarCell Day="day" class="calendar-cell" />
                        </BitBhCalendarGrid>
                    </div>
                }
            </div>
        </BitBhCalendar>;

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _calendar = """
        <BitBhDatePickerContent class="date-range-picker-popover">
            <BitBhCalendar VisibleMonths="2" class="calendar">
                <div class="calendar-header">
                    <BitBhCalendarPrevious class="calendar-nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="calendar-heading" />
                    <BitBhCalendarNext class="calendar-nav">›</BitBhCalendarNext>
                </div>
                <div class="calendar-months">
                    @for (var i = 0; i < 2; i++)
                    {
                        var offset = i;
                        <div>
                            <BitBhCalendarHeading Offset="offset" As="h4" class="calendar-month-title" aria-hidden="true" />
                            <BitBhCalendarGrid Offset="offset" class="calendar-grid">
                                <BitBhCalendarCell Day="context" class="calendar-cell" />
                            </BitBhCalendarGrid>
                        </div>
                    }
                </div>
            </BitBhCalendar>
        </BitBhDatePickerContent>
""";

    private const string _basicCode = """
<BitBhField>
    <BitBhLabel class="date-range-picker-label">Stay</BitBhLabel>
    <BitBhDateRangePicker @bind-Value="stay">
        <BitBhDatePickerGroup class="date-range-picker-group">
            <BitBhDateRangePickerInput Part="BitBhDateRangePart.Start" class="date-range-picker-input" />
            <span class="date-range-picker-separator" aria-hidden="true">–</span>
            <BitBhDateRangePickerInput Part="BitBhDateRangePart.End" class="date-range-picker-input" />
            <BitBhDatePickerTrigger class="date-range-picker-trigger">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
            </BitBhDatePickerTrigger>
        </BitBhDatePickerGroup>
""" + _calendar + """
    </BitBhDateRangePicker>
</BitBhField>

@code {
    private BitBhDateRange? stay;
}
""";

    private const string _limitsCode = """
<BitBhField>
    <BitBhLabel class="date-range-picker-label">Booking</BitBhLabel>
    <BitBhDateRangePicker @bind-Value="booking" Min="today" Max="today.AddMonths(6)" IsDateUnavailable="IsBooked">
        <BitBhDatePickerGroup class="date-range-picker-group">
            <BitBhDateRangePickerInput Part="BitBhDateRangePart.Start" class="date-range-picker-input" />
            <span class="date-range-picker-separator" aria-hidden="true">–</span>
            <BitBhDateRangePickerInput Part="BitBhDateRangePart.End" class="date-range-picker-input" />
            <BitBhDatePickerTrigger class="date-range-picker-trigger">@* the icon *@</BitBhDatePickerTrigger>
        </BitBhDatePickerGroup>
""" + _calendar + """
    </BitBhDateRangePicker>
    <BitBhDescription class="date-range-picker-description">The next six months; struck-through nights are booked.</BitBhDescription>
</BitBhField>

@code {
    private static readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private BitBhDateRange? booking;

    private static bool IsBooked(DateOnly d) => d.DayNumber % 9 is 4 or 5;
}
""";

    private const string _formCode = """
<EditForm Model="form" OnValidSubmit="() => sent = form.Holiday">
    <DataAnnotationsValidator />
    <BitBhField>
        <BitBhLabel class="date-range-picker-label">Urlaub</BitBhLabel>
        <BitBhDateRangePicker @bind-Value="form.Holiday" Name="holiday" Culture="@(CultureInfo.GetCultureInfo("de-DE"))">
            <BitBhDatePickerGroup class="date-range-picker-group">
                <BitBhDateRangePickerInput Part="BitBhDateRangePart.Start" aria-label="Erster Tag" class="date-range-picker-input" />
                <span class="date-range-picker-separator" aria-hidden="true">–</span>
                <BitBhDateRangePickerInput Part="BitBhDateRangePart.End" aria-label="Letzter Tag" class="date-range-picker-input" />
                <BitBhDatePickerTrigger aria-label="Zeitraum wählen" class="date-range-picker-trigger">@* the icon *@</BitBhDatePickerTrigger>
            </BitBhDatePickerGroup>
            @* The popover and calendar as above. *@
        </BitBhDateRangePicker>
        <BitBhErrorMessage class="date-range-picker-error" />
    </BitBhField>
    <button type="submit" class="date-range-picker-submit">Senden</button>
</EditForm>

@code {
    private readonly HolidayForm form = new();
    private BitBhDateRange? sent;

    private sealed class HolidayForm
    {
        [Required(ErrorMessage = "Bitte einen Zeitraum wählen.")]
        public BitBhDateRange? Holiday { get; set; }
    }
}
""";

    // ── CSS (mirrors wwwroot/demos/date-range-picker.css; the calendar uses calendar.css) ──

    private const string _css = """
/* date range picker demo styles — plain CSS section. The library ships zero CSS.
   The calendar inside the popover uses the .calendar-* classes of the Calendar page. */

/* ---- The group: start, end and trigger (role="group") ------------------------- */
.date-range-picker-group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.25rem 0.25rem 0.6rem;
    border: 1px solid var(--color-border-control);
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
}

.date-range-picker-group:hover { border-color: var(--color-border-control-hover); }
/* data-focused while a segment of either date has focus; data-state="open" while the calendar is open */
.date-range-picker-group[data-focused],
.date-range-picker-group[data-state="open"] { outline: 2px solid var(--color-focus); outline-offset: 2px; }
.date-range-picker-group[data-invalid] { border-color: var(--color-danger); }
.date-range-picker-group[data-disabled] { opacity: 0.55; }

/* ---- The start and the end (each a role="group", data-part="start|end") -------- */
.date-range-picker-input { display: inline-flex; align-items: center; }
.date-range-picker-separator { padding: 0 0.2rem; color: var(--color-muted); }

/* Segments (data-type, data-placeholder), at least 24 x 24 px each */
.date-range-picker-group [data-type] { padding: 0.1rem 0.15rem; border-radius: 0.25rem; }

.date-range-picker-group [role="spinbutton"] {
    display: inline-block;
    min-width: 1.5rem;
    min-height: 1.5rem;
    line-height: 1.5rem;
    text-align: center;
    outline: none;
}

.date-range-picker-group [role="spinbutton"]:focus { background: var(--color-primary); color: #fff; }
.date-range-picker-group [data-placeholder] { color: var(--color-muted); }
.date-range-picker-group [data-placeholder]:focus { color: #fff; }
.date-range-picker-group [data-type="literal"] { padding: 0; color: var(--color-muted); }
.date-range-picker-group[data-invalid] [role="spinbutton"]:not(:focus) { color: var(--color-danger-text); }

/* ---- Trigger ------------------------------------------------------------------- */
.date-range-picker-trigger {
    all: unset;
    box-sizing: border-box;
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-inline-start: auto;
    border-radius: 0.375rem;
    color: var(--color-text-secondary);
    cursor: pointer;
}

.date-range-picker-trigger:hover:enabled,
.date-range-picker-trigger[data-state="open"] { background: var(--color-fill); }
.date-range-picker-trigger:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 1px; }
.date-range-picker-trigger:disabled { cursor: not-allowed; }
.date-range-picker-trigger svg { width: 1.1rem; height: 1.1rem; }

/* ---- Popover (role="dialog", positioned by the runtime) ------------------------- */
.date-range-picker-popover {
    z-index: 30;
    max-width: calc(100vw - 1rem);
    border-radius: 0.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18), 0 2px 6px rgba(0, 0, 0, 0.08);
    outline: none;
}

.date-range-picker-popover[data-state="open"] { animation: date-range-picker-in 120ms ease-out; }

@keyframes date-range-picker-in {
    from { opacity: 0; transform: translateY(-4px); }
}

@media (prefers-reduced-motion: reduce) {
    .date-range-picker-popover[data-state="open"] { animation: none; }
}

/* ---- Field parts and demo layout ------------------------------------------------ */
.date-range-picker-label { display: block; margin-bottom: 0.35rem; font-size: 0.875rem; font-weight: 600; color: var(--color-text); }
.date-range-picker-description { margin: 0.35rem 0 0; font-size: 0.8rem; color: var(--color-muted); }
.date-range-picker-error { margin: 0.35rem 0 0; font-size: 0.8rem; color: var(--color-danger-text); }
.date-range-picker-demo { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1.5rem; }
.date-range-picker-value { margin: 0; font-size: 0.85rem; color: var(--color-muted); }
.date-range-picker-value strong { color: var(--color-text); font-weight: 600; }

.date-range-picker-submit {
    margin-top: 0.75rem;
    padding: 0.45rem 0.9rem;
    border: none;
    border-radius: 0.5rem;
    background: var(--color-primary);
    color: #fff;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
}

.date-range-picker-submit:hover { background: var(--color-primary-hover); }
.date-range-picker-submit:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
""";
}
