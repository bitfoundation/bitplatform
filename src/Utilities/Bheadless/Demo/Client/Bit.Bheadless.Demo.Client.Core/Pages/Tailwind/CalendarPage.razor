@page "/tw/calendar"
@using System.ComponentModel.DataAnnotations
@using System.Globalization

<PageTitle>Calendar (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Calendar</h1>
    <p class="bb-subtitle">Month grids to pick a date, a range or several dates from — the WAI-ARIA date grid with one tab stop, full keyboard support, limits, unavailable dates and the reader's own calendar.</p>
</div>

<SectionSwitcher Slug="calendar" />

<TwDemoBlock Title="Single date" Code="@_singleCode">
    <Description>
        The grid is a <code>&lt;table role="grid"&gt;</code> named by the heading and one tab stop: ← / → move a day, ↑ / ↓ a
        week, <kbd>PageUp</kbd> / <kbd>PageDown</kbd> a month (<kbd>Shift</kbd>: a year), <kbd>Home</kbd> / <kbd>End</kbd> to
        the ends of the week, <kbd>Enter</kbd> or <kbd>Space</kbd> select. The cells are styled with Tailwind's
        <code>data-*:</code> variants (<code>data-today:</code>, <code>data-selected:</code>, <code>data-hover:</code> …), the
        week-day headers through the grid (<code>[&amp;_th]:</code>).
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-start gap-6">
            <BitBhCalendar @bind-Value="date" Culture="DemoDateCultures.EnUs" aria-label="Appointment" class="@Root">
                <div class="flex items-center gap-2">
                    <BitBhCalendarPrevious class="@Nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                    <BitBhCalendarNext class="@Nav">›</BitBhCalendarNext>
                </div>
                <BitBhCalendarGrid class="@Grid">
                    <BitBhCalendarCell Day="context" class="@Cell" />
                </BitBhCalendarGrid>
            </BitBhCalendar>
            <p class="m-0 text-sm text-zinc-500">Selected: <strong class="font-semibold text-zinc-900">@(date?.ToString("D", DemoDateCultures.EnUs) ?? "none")</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="A range across two months" Code="@_rangeCode">
    <Description>
        <code>@@bind-Range</code>: the first press sets one end, the range follows the pointer and the focus until the
        second press (<code>data-highlighted:</code>), <kbd>Escape</kbd> drops it. The ends get
        <code>data-selection-start:</code> / <code>data-selection-end:</code>, the days between <code>data-range-middle:</code>.
        Booked nights are unavailable and a range can't span them.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-start gap-6">
            <BitBhCalendar @bind-Range="stay" VisibleMonths="2" IsDateUnavailable="IsBooked" Min="today"
                           Culture="DemoDateCultures.EnUs" aria-label="Stay" class="@Root">
                <div class="flex items-center gap-2">
                    <BitBhCalendarPrevious class="@Nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                    <BitBhCalendarNext class="@Nav">›</BitBhCalendarNext>
                </div>
                <div class="flex flex-wrap gap-5">
                    @for (var i = 0; i < 2; i++)
                    {
                        var offset = i;
                        <div>
                            <BitBhCalendarHeading Offset="offset" As="h4" aria-hidden="true" class="m-0 mb-1 text-center text-sm font-semibold" />
                            <BitBhCalendarGrid Offset="offset" class="@Grid">
                                <BitBhCalendarCell Day="context" class="@RangeCell" />
                            </BitBhCalendarGrid>
                        </div>
                    }
                </div>
            </BitBhCalendar>
            <p class="m-0 text-sm text-zinc-500">
                Stay: <strong class="font-semibold text-zinc-900">@(stay is null ? "none" : $"{stay.Start.ToString("MMM d", DemoDateCultures.EnUs)} – {stay.End.ToString("MMM d", DemoDateCultures.EnUs)} ({stay.Days - 1} nights)")</strong>
            </p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Limits, weekends and outside days" Code="@_limitsCode">
    <Description>
        Dates outside <code>Min</code> / <code>Max</code> are disabled and not focusable (<code>data-disabled:</code>); weekends
        are unavailable (<code>data-unavailable:</code>); <code>ShowOutsideDays</code> fills the first and last weeks
        (<code>data-outside-month:</code>), hidden from assistive technology.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-start gap-6">
            <BitBhCalendar @bind-Value="delivery" Min="today.AddDays(1)" Max="today.AddMonths(2)" ShowOutsideDays="true"
                           IsDateUnavailable="d => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday"
                           Culture="DemoDateCultures.EnUs" aria-label="Delivery date" class="@Root">
                <div class="flex items-center gap-2">
                    <BitBhCalendarPrevious class="@Nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                    <BitBhCalendarNext class="@Nav">›</BitBhCalendarNext>
                </div>
                <BitBhCalendarGrid WeekdayFormat="BitBhCalendarWeekdayFormat.Abbreviated" class="@Grid">
                    <BitBhCalendarCell Day="context" class="@Cell" />
                </BitBhCalendarGrid>
            </BitBhCalendar>
            <p class="m-0 text-sm text-zinc-500">Delivery: <strong class="font-semibold text-zinc-900">@(delivery?.ToString("D", DemoDateCultures.EnUs) ?? "none")</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Cultures, calendars and right to left" Code="@_cultureCode">
    <Description>
        <code>Culture</code> sets the names, the first day of the week and the calendar: the German week starts on Monday;
        the Persian culture shows the Persian calendar's months, right to left, with ← / → mirrored. (This WebAssembly demo
        runs without ICU, where the Persian calendar isn't available.)
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-start gap-6">
            <BitBhCalendar @bind-Value="cultureDate" Culture="DemoDateCultures.DeDe" aria-label="Datum" class="@Root">
                <div class="flex items-center gap-2">
                    <BitBhCalendarPrevious aria-label="Vorheriger Monat" class="@Nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                    <BitBhCalendarNext aria-label="Nächster Monat" class="@Nav">›</BitBhCalendarNext>
                </div>
                <BitBhCalendarGrid class="@Grid">
                    <BitBhCalendarCell Day="context" class="@Cell" />
                </BitBhCalendarGrid>
            </BitBhCalendar>
            @if (DemoDateCultures.FaIr is { } persian)
            {
                <div dir="rtl" lang="fa">
                    <BitBhCalendar @bind-Value="cultureDate" Culture="persian" Dir="BitBhDirection.Rtl" aria-label="تاریخ" class="@Root">
                        <div class="flex items-center gap-2">
                            <BitBhCalendarPrevious aria-label="ماه قبل" class="@Nav">›</BitBhCalendarPrevious>
                            <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                            <BitBhCalendarNext aria-label="ماه بعد" class="@Nav">‹</BitBhCalendarNext>
                        </div>
                        <BitBhCalendarGrid class="@Grid">
                            <BitBhCalendarCell Day="context" class="@Cell" />
                        </BitBhCalendarGrid>
                    </BitBhCalendar>
                </div>
            }
            <p class="m-0 text-sm text-zinc-500">Value: <strong class="font-semibold text-zinc-900">@(cultureDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "none")</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Several dates" Code="@_multipleCode">
    <Description>
        <code>@@bind-Values</code> selects any number of dates; each press toggles one. A cell's <code>Template</code> receives
        the day's state.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-start gap-6">
            <BitBhCalendar @bind-Values="shifts" Culture="DemoDateCultures.EnUs" aria-label="Shifts" class="@Root">
                <div class="flex items-center gap-2">
                    <BitBhCalendarPrevious class="@Nav">‹</BitBhCalendarPrevious>
                    <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                    <BitBhCalendarNext class="@Nav">›</BitBhCalendarNext>
                </div>
                <BitBhCalendarGrid class="@Grid">
                    <BitBhCalendarCell Day="context" class="@Cell">
                        <Template Context="day">@day.Text@(day.IsSelected ? "•" : "")</Template>
                    </BitBhCalendarCell>
                </BitBhCalendarGrid>
            </BitBhCalendar>
            <p class="m-0 text-sm text-zinc-500">Shifts: <strong class="font-semibold text-zinc-900">@(shifts.Count == 0 ? "none" : string.Join(", ", shifts.Select(d => d.ToString("MMM d", DemoDateCultures.EnUs))))</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="In a form" Code="@_formCode">
    <Description>
        In a <code>BitBhField</code> the calendar is labelled by <code>BitBhLabel</code>, described by
        <code>BitBhDescription</code> and <code>BitBhErrorMessage</code>, and validated by <code>EditForm</code>.
    </Description>
    <LiveContent>
        <EditForm Model="booking" OnValidSubmit="() => submitted = booking.CheckIn">
            <DataAnnotationsValidator />
            <BitBhField>
                <BitBhLabel class="mb-1.5 block text-sm font-semibold text-zinc-900">Check-in</BitBhLabel>
                <BitBhCalendar @bind-Value="booking.CheckIn" Min="today" Name="checkin" Culture="DemoDateCultures.EnUs" class="@Root">
                    <div class="flex items-center gap-2">
                        <BitBhCalendarPrevious class="@Nav">‹</BitBhCalendarPrevious>
                        <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                        <BitBhCalendarNext class="@Nav">›</BitBhCalendarNext>
                    </div>
                    <BitBhCalendarGrid Context="day" class="@Grid">
                        <BitBhCalendarCell Day="day" class="@Cell" />
                    </BitBhCalendarGrid>
                </BitBhCalendar>
                <BitBhDescription class="mt-1.5 text-xs text-zinc-500">Check-in is from 3 pm.</BitBhDescription>
                <BitBhErrorMessage class="mt-1.5 text-xs text-red-700" />
            </BitBhField>
            <button type="submit" class="mt-3 cursor-pointer rounded-lg bg-blue-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-blue-700">Book</button>
            @if (submitted is { } checkIn)
            {
                <p class="m-0 mt-2 text-sm text-zinc-500">Booked from <strong class="text-zinc-900">@checkIn.ToString("D", DemoDateCultures.EnUs)</strong>.</p>
            }
        </EditForm>
    </LiveContent>
</TwDemoBlock>

