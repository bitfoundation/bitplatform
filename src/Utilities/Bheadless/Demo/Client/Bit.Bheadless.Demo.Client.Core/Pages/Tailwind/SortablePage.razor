@page "/tw/sortable"

<PageTitle>Sortable (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Sortable</h1>
    <p class="bb-subtitle">Reorder a list by dragging with a pointer or entirely with the keyboard, with live screen-reader announcements.</p>
</div>

<SectionSwitcher Slug="sortable" />

<TwDemoBlock Title="Reorderable task list" Code="@_tasksCode">
    <Description>
        Bind the list with <code>@@bind-Items</code>; <code>ItemKey</code> keeps each row's identity
        stable and <code>ItemLabel</code> names it in announcements. Drag a grip with a mouse, pen or
        finger — or focus a grip, press <kbd>Space</kbd> / <kbd>Enter</kbd> to pick the task up,
        <kbd>↑</kbd> / <kbd>↓</kbd> to move it, <kbd>Space</kbd> / <kbd>Enter</kbd> to drop it and
        <kbd>Escape</kbd> to cancel. Each step is announced automatically. The moving item and the root
        carry <code>data-dragging</code>, and a handle picked up with the keyboard gets
        <code>aria-pressed="true"</code>. The sortable renders the <code>&lt;li&gt;</code> items itself,
        so they're styled from the list: a <code>.sortable-list &gt; li</code> selector in the CSS
        version, the <code>*:</code> variant in the Tailwind version.
    </Description>
    <LiveContent>
        <div class="grid w-full gap-4">
            <BitBhSortable TItem="TaskItem" @bind-Items="tasks"
                        ItemKey="t => t.Id" ItemLabel="t => t.Title"
                        aria-label="Tasks"
                        class="m-0 flex w-full max-w-md list-none flex-col gap-2 p-0 data-dragging:select-none *:flex *:items-center *:gap-3 *:rounded-lg *:border *:border-zinc-200 *:bg-white *:py-2 *:pr-3 *:pl-2 *:text-sm *:transition *:data-dragging:border-blue-600 *:data-dragging:shadow-lg"
                        Context="s">
                <BitBhSortableHandle TItem="TaskItem" aria-label="@($"Reorder {s.Item.Title}")"
                                  class="inline-grid size-7 shrink-0 cursor-grab touch-none select-none place-items-center rounded-md text-base leading-none text-zinc-400 outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-700 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:cursor-grabbing aria-pressed:bg-blue-600 aria-pressed:text-white">⠿</BitBhSortableHandle>
                <span class="flex-1 text-zinc-900">@s.Item.Title</span>
                <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600">@s.Item.Tag</span>
            </BitBhSortable>
            <p class="m-0 text-sm text-zinc-500">
                Bound order (ids): <strong class="font-semibold text-zinc-900">@string.Join(" · ", tasks.Select(t => t.Id))</strong>
            </p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="OnReorder event log" Code="@_logCode">
    <Description>
        <code>OnReorder</code> fires once per committed move with the item and its old and new
        index — handy for persisting the order or sending a PATCH. Moves cancelled with
        <kbd>Escape</kbd> (or dropped in place) don't fire it.
    </Description>
    <LiveContent>
        <div class="grid w-full grid-cols-[repeat(auto-fit,minmax(15rem,1fr))] items-start gap-6">
            <BitBhSortable TItem="string" @bind-Items="backlog" OnReorder="LogReorder"
                        aria-label="Sprint backlog"
                        class="m-0 flex w-full list-none flex-col gap-2 p-0 data-dragging:select-none *:flex *:items-center *:gap-3 *:rounded-lg *:border *:border-zinc-200 *:bg-white *:py-2 *:pr-3 *:pl-2 *:text-sm *:transition *:data-dragging:border-blue-600 *:data-dragging:shadow-lg"
                        Context="s">
                <BitBhSortableHandle TItem="string" aria-label="@($"Reorder {s.Item}")"
                                  class="inline-grid size-7 shrink-0 cursor-grab touch-none select-none place-items-center rounded-md text-base leading-none text-zinc-400 outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-700 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:cursor-grabbing aria-pressed:bg-blue-600 aria-pressed:text-white">⠿</BitBhSortableHandle>
                <span class="flex-1 text-zinc-900">@s.Item</span>
            </BitBhSortable>

            <ol class="m-0 min-h-full list-none space-y-1.5 rounded-lg border border-dashed border-zinc-300 bg-zinc-50 px-4 py-3 font-mono text-xs text-zinc-700"
                aria-label="Reorder events">
                @if (reorderLog.Count == 0)
                {
                    <li class="text-zinc-500">No moves yet — reorder an item.</li>
                }
                @foreach (var entry in reorderLog)
                {
                    <li>@entry</li>
                }
            </ol>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Horizontal orientation" Code="@_horizontalCode">
    <Description>
        Set <code>Orientation="BitBhOrientation.Horizontal"</code> for a row: pointer drags shift
        siblings sideways and, once picked up, <kbd>←</kbd> / <kbd>→</kbd> move the item. Here the
        whole chip is the <code>BitBhSortableHandle</code>, so its text becomes the accessible name.
    </Description>
    <LiveContent>
        <div class="grid w-full gap-4">
            <BitBhSortable TItem="string" @bind-Items="priorities"
                        Orientation="BitBhOrientation.Horizontal" aria-label="Priorities"
                        class="m-0 flex list-none gap-2 overflow-x-auto p-1 *:rounded-full *:border *:border-zinc-300 *:bg-white *:transition *:data-dragging:border-blue-600 *:data-dragging:bg-blue-50 *:data-dragging:shadow-md"
                        Context="s">
                <BitBhSortableHandle TItem="string"
                                  class="inline-flex cursor-grab touch-none select-none items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-medium text-zinc-700 outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:cursor-grabbing aria-pressed:text-blue-700">
                    <span class="text-zinc-400" aria-hidden="true">⠿</span>@s.Item
                </BitBhSortableHandle>
            </BitBhSortable>
            <p class="m-0 text-sm text-zinc-500">
                Ranking: <strong class="font-semibold text-zinc-900">@string.Join(" › ", priorities)</strong>
            </p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Drag between lists (kanban)" Code="@_boardCode">
    <Description>
        Lists with the same <code>Group</code> exchange items. Drag a card into another column - an empty
        one too - or pick it up with the keyboard and press <kbd>←</kbd> / <kbd>→</kbd> to move it to the
        previous or next column, <kbd>↑</kbd> / <kbd>↓</kbd> to place it, <kbd>Space</kbd> /
        <kbd>Enter</kbd> to drop it and <kbd>Escape</kbd> to put it back where it was; each step names the
        column and the position. Every column binds its own list with <code>@@bind-Items</code>;
        <code>OnTransfer</code>, raised by the column that receives a card, reports the item, both
        columns' <code>ListKey</code> and both indexes - enough to move it in a model the lists aren't
        bound to. "Done" refuses blocked cards (<code>CanAccept</code>; <code>AllowDragOut</code> and
        <code>AllowDropIn</code> make a list accept-only or give-only). While a pointer drags a card the
        columns that take it carry <code>data-drop-target</code> and the one under the pointer
        <code>data-drag-over</code>; an empty column has <code>data-empty</code> - the
        <code>data-drop-target:</code>, <code>data-drag-over:</code> and <code>data-empty:</code> variants.
    </Description>
    <LiveContent>
        <div class="grid w-full gap-4">
            <div class="grid w-full grid-cols-[repeat(auto-fit,minmax(13rem,1fr))] items-start gap-4">
                @foreach (var column in board)
                {
                    <div class="grid gap-2.5 rounded-xl border border-zinc-200 bg-zinc-50 p-3">
                        <h3 class="m-0 flex items-center justify-between text-sm font-semibold text-zinc-900">
                            @column.Name <span class="rounded-full bg-zinc-200 px-2 py-0.5 text-xs font-medium tabular-nums text-zinc-700">@column.Cards.Count</span>
                        </h3>
                        <BitBhSortable TItem="Card" Group="board" @bind-Items="column.Cards"
                                    ListKey="column.Key" CanAccept="column.Accepts" OnTransfer="LogTransfer"
                                    ItemKey="c => c.Id" ItemLabel="c => c.Title" aria-label="@column.Name"
                                    class="m-0 flex min-h-20 w-full list-none flex-col gap-2 rounded-lg p-0 outline-2 outline-offset-4 outline-dashed outline-transparent transition data-dragging:select-none data-drop-target:outline-zinc-300 data-drag-over:bg-blue-50 data-drag-over:outline-blue-600 data-empty:items-center data-empty:justify-center data-empty:border data-empty:border-dashed data-empty:border-zinc-300 data-empty:before:text-[0.8rem] data-empty:before:text-zinc-500 data-empty:before:content-['No_cards'] *:flex *:items-center *:gap-3 *:rounded-lg *:border *:border-zinc-200 *:bg-white *:py-2 *:pr-3 *:pl-2 *:text-sm *:transition *:data-dragging:border-blue-600 *:data-dragging:shadow-lg"
                                    Context="s">
                            <BitBhSortableHandle TItem="Card" aria-label="@($"Move {s.Item.Title}")"
                                              class="inline-grid size-7 shrink-0 cursor-grab touch-none select-none place-items-center rounded-md text-base leading-none text-zinc-400 outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-700 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:cursor-grabbing aria-pressed:bg-blue-600 aria-pressed:text-white">⠿</BitBhSortableHandle>
                            <span class="flex-1 text-zinc-900">@s.Item.Title</span>
                            <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600">@s.Item.Tag</span>
                        </BitBhSortable>
                    </div>
                }
            </div>
            <p class="m-0 text-sm text-zinc-500">
                Last move: <strong class="font-semibold text-zinc-900">@(lastTransfer ?? "none yet")</strong>
            </p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Custom announcements" Code="@_announcementsCode">
    <Description>
        Pass a <code>BitBhSortableAnnouncements</code> to localize or reword what screen readers
        hear: the <code>Instructions</code> every handle is described by, plus the
        <code>PickedUp</code>, <code>Moved</code>, <code>Dropped</code> and <code>Cancelled</code>
        messages. The template's <code>Index</code> is the live (preview) position.
    </Description>
    <LiveContent>
        <BitBhSortable TItem="string" @bind-Items="queue" Announcements="queueAnnouncements"
                    aria-label="Up next"
                    class="m-0 flex w-full max-w-md list-none flex-col gap-2 p-0 data-dragging:select-none *:flex *:items-center *:gap-3 *:rounded-lg *:border *:border-zinc-200 *:bg-white *:py-2 *:pr-3 *:pl-2 *:text-sm *:transition *:data-dragging:border-blue-600 *:data-dragging:shadow-lg"
                    Context="s">
            <BitBhSortableHandle TItem="string" aria-label="@($"Move {s.Item}")"
                              class="inline-grid size-7 shrink-0 cursor-grab touch-none select-none place-items-center rounded-md text-base leading-none text-zinc-400 outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-700 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:cursor-grabbing aria-pressed:bg-blue-600 aria-pressed:text-white">⠿</BitBhSortableHandle>
            <span class="inline-grid size-6 place-items-center rounded-full bg-blue-50 text-xs font-semibold tabular-nums text-blue-700">@(s.Index + 1)</span>
            <span class="flex-1 text-zinc-900">@s.Item</span>
        </BitBhSortable>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabled" Code="@_disabledCode">
    <Description>
        <code>Disabled="true"</code> stops pointer and keyboard reordering. The root and every item get
        <code>data-disabled</code> and the handles <code>aria-disabled="true"</code>: the CSS version
        styles them with <code>[data-disabled]</code> / <code>[aria-disabled="true"]</code> selectors,
        the Tailwind version with the <code>data-disabled:</code> / <code>aria-disabled:</code>
        variants. The lock below is a <code>BitBhToggle</code>.
    </Description>
    <LiveContent>
        <div class="grid w-full gap-4">
            <BitBhToggle @bind-Pressed="locked"
                      class="inline-flex cursor-pointer items-center justify-self-start rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-700 outline-none transition-colors hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 data-[state=on]:border-zinc-900 data-[state=on]:bg-zinc-900 data-[state=on]:text-white data-[state=on]:hover:bg-zinc-800">Lock order</BitBhToggle>
            <BitBhSortable TItem="string" @bind-Items="steps" Disabled="locked"
                        aria-label="Onboarding steps"
                        class="m-0 flex w-full max-w-md list-none flex-col gap-2 p-0 *:flex *:items-center *:gap-3 *:rounded-lg *:border *:border-zinc-200 *:bg-white *:py-2 *:pr-3 *:pl-2 *:text-sm *:transition *:data-dragging:border-blue-600 *:data-dragging:shadow-lg data-disabled:*:bg-zinc-50 data-disabled:*:text-zinc-500"
                        Context="s">
                <BitBhSortableHandle TItem="string" aria-label="@($"Reorder {s.Item}")"
                                  class="inline-grid size-7 shrink-0 cursor-grab touch-none select-none place-items-center rounded-md text-base leading-none text-zinc-400 outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-700 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:cursor-grabbing aria-pressed:bg-blue-600 aria-pressed:text-white aria-disabled:cursor-not-allowed aria-disabled:opacity-50">⠿</BitBhSortableHandle>
                <span class="flex-1">@s.Item</span>
            </BitBhSortable>
        </div>
    </LiveContent>
</TwDemoBlock>

@code {
    public sealed record TaskItem(int Id, string Title, string Tag);

    private IList<TaskItem> tasks =
    [
        new(1, "Write release notes", "Docs"),
        new(2, "Fix flaky login test", "Bug"),
        new(3, "Review pull requests", "Team"),
        new(4, "Update dependencies", "Chore"),
    ];

    private IList<string> backlog = ["Login page", "Password reset", "Audit log", "Dark mode", "CSV export"];
    private readonly List<string> reorderLog = [];

    private IList<string> priorities = ["Speed", "Quality", "Cost", "Scope"];

    public sealed record Card(int Id, string Title, string Tag);

    public sealed class Column(string key, string name, IList<Card> cards, Func<Card, object, bool>? accepts = null)
    {
        public string Key { get; } = key;
        public string Name { get; } = name;
        public IList<Card> Cards { get; set; } = cards;
        public Func<Card, object, bool>? Accepts { get; } = accepts;
    }

    private readonly List<Column> board =
    [
        new("todo", "To do", [new(1, "Write release notes", "Docs"), new(2, "Fix flaky login test", "Blocked"), new(3, "Review pull requests", "Team")]),
        new("doing", "In progress", [new(4, "Update dependencies", "Chore")]),
        new("done", "Done", [], accepts: (card, _) => card.Tag != "Blocked"),
    ];

    private string? lastTransfer;

    private void LogTransfer(BitBhTransferEventArgs<Card> e)
        => lastTransfer = $"“{e.Item.Title}” from {e.SourceList}[{e.OldIndex}] to {e.TargetList}[{e.NewIndex}]";

    private IList<string> queue = ["Blue in Green", "So What", "Naima", "Take Five"];

    private readonly BitBhSortableAnnouncements queueAnnouncements = new()
    {
        Instructions = "Press Space to grab a song. Use the up and down arrows to change its place in the queue, Space to drop it, or Escape to cancel.",
        PickedUp = (song, position, count) => $"Grabbed {song}. It plays as number {position} of {count}.",
        Moved = (song, position, count) => $"{song} now plays as number {position} of {count}.",
        Dropped = (song, position, _) => position == 1 ? $"{song} plays next." : $"{song} plays as number {position}.",
        Cancelled = (song, position) => $"Cancelled. {song} stays at number {position}.",
    };

    private bool locked = true;
    private IList<string> steps = ["Create account", "Verify email", "Invite teammates", "Connect a repository"];

    private void LogReorder(BitBhReorderEventArgs<string> e)
    {
        reorderLog.Insert(0, $"“{e.Item}” moved from index {e.OldIndex} to {e.NewIndex}");
        if (reorderLog.Count > 6) reorderLog.RemoveAt(reorderLog.Count - 1);
    }

    private const string _tasksCode = """
<BitBhSortable TItem="TaskItem" @bind-Items="tasks"
            ItemKey="t => t.Id" ItemLabel="t => t.Title"
            aria-label="Tasks"
            class="m-0 flex w-full max-w-md list-none flex-col gap-2 p-0 data-dragging:select-none *:flex *:items-center *:gap-3 *:rounded-lg *:border *:border-zinc-200 *:bg-white *:py-2 *:pr-3 *:pl-2 *:text-sm *:transition *:data-dragging:border-blue-600 *:data-dragging:shadow-lg"
            Context="s">
    <BitBhSortableHandle TItem="TaskItem" aria-label="@($"Reorder {s.Item.Title}")"
                      class="inline-grid size-7 shrink-0 cursor-grab touch-none select-none place-items-center rounded-md text-base leading-none text-zinc-400 outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-700 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:cursor-grabbing aria-pressed:bg-blue-600 aria-pressed:text-white">⠿</BitBhSortableHandle>
    <span class="flex-1 text-zinc-900">@s.Item.Title</span>
    <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600">@s.Item.Tag</span>
</BitBhSortable>

<p class="m-0 text-sm text-zinc-500">
    Bound order (ids): <strong class="font-semibold text-zinc-900">@string.Join(" · ", tasks.Select(t => t.Id))</strong>
</p>

