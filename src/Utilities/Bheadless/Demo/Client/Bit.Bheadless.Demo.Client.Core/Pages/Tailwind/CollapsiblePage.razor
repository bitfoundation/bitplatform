@page "/tw/collapsible"

<PageTitle>Collapsible (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Collapsible</h1>
    <p class="bb-subtitle">An interactive component which expands and collapses a panel.</p>
</div>

<SectionSwitcher Slug="collapsible" />

<TwDemoBlock Title="Basic Collapsible" Code="@_basicCode">
    <Description>
        A <code>BitBhCollapsibleTrigger</code> toggles a <code>BitBhCollapsibleContent</code> panel.
        <code>aria-expanded</code> and <code>aria-controls</code>
        are wired automatically.
    </Description>
    <LiveContent>
        <BitBhCollapsible class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
            <div class="flex items-center justify-between px-5 py-3.5 font-medium">
                <span>@@peduarte starred 3 repositories</span>
                <BitBhCollapsibleTrigger aria-label="Toggle repositories" class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-zinc-500 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">▾</BitBhCollapsibleTrigger>
            </div>
            <div class="border-t border-zinc-200 px-5 py-3 text-sm text-zinc-500">@@radix-ui/primitives</div>
            <BitBhCollapsibleContent>
                <div class="border-t border-zinc-200 px-5 py-3 text-sm text-zinc-500">@@radix-ui/colors</div>
                <div class="border-t border-zinc-200 px-5 py-3 text-sm text-zinc-500">@@radix-ui/themes</div>
            </BitBhCollapsibleContent>
        </BitBhCollapsible>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Default Open" Code="@_defaultOpenCode">
    <Description>
        Set <code>DefaultOpen="true"</code> to render the panel open initially (uncontrolled).
    </Description>
    <LiveContent>
        <BitBhCollapsible DefaultOpen="true" class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
            <div class="flex items-center justify-between px-5 py-3.5 font-medium">
                <span>Already open</span>
                <BitBhCollapsibleTrigger aria-label="Toggle section" class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-zinc-500 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">▾</BitBhCollapsibleTrigger>
            </div>
            <BitBhCollapsibleContent>
                <div class="border-t border-zinc-200 px-5 py-3 text-sm text-zinc-500">I'm open by default. Click the trigger to close me.</div>
            </BitBhCollapsibleContent>
        </BitBhCollapsible>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Render Context (rotating chevron + Close)" Code="@_renderContextCode">
    <Description>
        <code>BitBhCollapsibleTrigger</code> and <code>BitBhCollapsibleContent</code> expose a
        <code>BitBhCollapsibleRenderContext</code> via <code>Context="c"</code>. Use it to drive UI
        from the open state and to call <code>c.Close()</code> from anywhere inside.
    </Description>
    <LiveContent>
        <BitBhCollapsible class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
            <div class="flex items-center justify-between px-5 py-3.5 font-medium">
                <span>What's inside?</span>
                <BitBhCollapsibleTrigger aria-label="Toggle what's inside" class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-zinc-500 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                    <Template Context="c">
                        <span class="@($"inline-block transition-transform duration-200 {(c.IsOpen ? "rotate-180" : "")}")">▾</span>
                    </Template>
                </BitBhCollapsibleTrigger>
            </div>
            <BitBhCollapsibleContent>
                <Template Context="c">
                    <div class="border-t border-zinc-200 px-5 py-3 text-sm text-zinc-500">
                        <p>You can close me from inside the content:</p>
                        <button class="mt-3 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium hover:bg-zinc-100" @onclick="c.Close">Close panel</button>
                    </div>
                </Template>
            </BitBhCollapsibleContent>
        </BitBhCollapsible>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabled" Code="@_disabledCode">
    <Description>
        Set <code>Disabled="true"</code> on the root to block interaction. The trigger receives
        both the native <code>disabled</code> attribute and a <code>data-disabled</code> hook; the root
        gets <code>data-disabled</code> too, for dimming the whole region. The CSS version styles them
        with <code>[data-disabled]</code> selectors, the Tailwind version with the
        <code>data-disabled:</code> variant.
    </Description>
    <LiveContent>
        <BitBhCollapsible Disabled="true" class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
            <div class="flex items-center justify-between px-5 py-3.5 font-medium">
                <span>Can't toggle me</span>
                <BitBhCollapsibleTrigger aria-label="Toggle section" class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-zinc-500 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">▾</BitBhCollapsibleTrigger>
            </div>
            <BitBhCollapsibleContent>
                <div class="border-t border-zinc-200 px-5 py-3 text-sm text-zinc-500">You'll never see this content.</div>
            </BitBhCollapsibleContent>
        </BitBhCollapsible>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Controlled" Code="@_controlledCode">
    <Description>
        Drive the open state externally with <code>Open</code> + <code>OnOpenChange</code>.
        The button below opens or closes the collapsible programmatically.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-4 w-full">
            <div class="flex flex-wrap items-center gap-3">
                <BitBhButton OnClick="ToggleControlled"
                          class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium hover:bg-zinc-100">
                    Toggle from outside
                </BitBhButton>
                <span class="text-sm text-zinc-500">Open: @controlledOpen.ToString().ToLowerInvariant()</span>
            </div>

            <BitBhCollapsible Open="controlledOpen" OnOpenChange="v => controlledOpen = v"
                           class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
                <div class="flex items-center justify-between px-5 py-3.5 font-medium">
                    <span>Internal trigger</span>
                    <BitBhCollapsibleTrigger aria-label="Toggle section" class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-zinc-500 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">▾</BitBhCollapsibleTrigger>
                </div>
                <BitBhCollapsibleContent>
                    <div class="border-t border-zinc-200 px-5 py-3 text-sm text-zinc-500">Either trigger updates the same state.</div>
                </BitBhCollapsibleContent>
            </BitBhCollapsible>
        </div>
    </LiveContent>
</TwDemoBlock>

