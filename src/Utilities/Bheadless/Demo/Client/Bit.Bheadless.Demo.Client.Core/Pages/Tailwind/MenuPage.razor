@page "/tw/menu"

<PageTitle>Menu (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Menu</h1>
    <p class="bb-subtitle">An accessible dropdown menu with keyboard navigation, typeahead, and zero visual opinion.</p>
</div>

<SectionSwitcher Slug="menu" />

<TwDemoBlock Title="Basic Menu" Code="@_basicCode">
    <Description>
        Click the button or press Space / Enter / arrow keys to open. Use Up / Down to
        navigate, Home / End to jump, Enter / Space to activate, Escape to close.
        Type a letter to jump to the first matching item. ARIA wiring
        (<code>aria-haspopup="menu"</code>, <code>aria-expanded</code>,
        <code>aria-activedescendant</code>) is handled automatically.
    </Description>
    <LiveContent>
        <BitBhMenu class="relative inline-block">
            <BitBhMenuButton class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                <Template Context="b">
                    Options
                    <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                </Template>
            </BitBhMenuButton>
            <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })" class="z-[9999] m-0 min-w-40 list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none">
                <BitBhMenuItem OnClick='@(() => Log("Edit"))'      class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Edit">Edit</BitBhMenuItem>
                <BitBhMenuItem OnClick='@(() => Log("Duplicate"))' class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Duplicate">Duplicate</BitBhMenuItem>
                <BitBhMenuItem OnClick='@(() => Log("Archive"))'   class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Archive">Archive</BitBhMenuItem>
                <BitBhMenuItem OnClick='@(() => Log("Delete"))'    class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Delete">Delete</BitBhMenuItem>
            </BitBhMenuItems>
        </BitBhMenu>
        <span class="text-sm text-zinc-500">Last action: <strong class="text-zinc-900">@(lastAction ?? "(none)")</strong></span>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabled Items" Code="@_disabledCode">
    <Description>
        Set <code>Disabled="true"</code> on individual items. Disabled items receive
        <code>data-disabled</code>, are skipped by arrow-key nav, and are ignored by typeahead.
        The CSS version styles them with a <code>[data-disabled]</code> selector, the Tailwind
        version with the <code>data-disabled:</code> variant.
    </Description>
    <LiveContent>
        <BitBhMenu class="relative inline-block">
            <BitBhMenuButton class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                <Template Context="b">
                    Account
                    <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                </Template>
            </BitBhMenuButton>
            <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })" class="z-[9999] m-0 min-w-40 list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none">
                <BitBhMenuItem OnClick='@(() => Log("Profile"))'  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Profile">Profile</BitBhMenuItem>
                <BitBhMenuItem OnClick='@(() => Log("Settings"))' class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Settings">Settings</BitBhMenuItem>
                <BitBhMenuItem OnClick='@(() => Log("Billing"))'  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Billing" Disabled="true">Billing (unavailable)</BitBhMenuItem>
                <BitBhMenuItem OnClick='@(() => Log("Sign out"))' class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Sign out">Sign out</BitBhMenuItem>
            </BitBhMenuItems>
        </BitBhMenu>
        <span class="text-sm text-zinc-500">Last action: <strong class="text-zinc-900">@(lastAction ?? "(none)")</strong></span>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Rich item content" Code="@_richCode">
    <Description>
        Items can contain any markup. Use the <code>data-active</code> hook to drive
        the highlighted style and provide a <code>Label</code> string so typeahead
        still works when the content is rich.
    </Description>
    <LiveContent>
        <BitBhMenu class="relative inline-block">
            <BitBhMenuButton class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                <Template Context="b">
                    File
                    <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                </Template>
            </BitBhMenuButton>
            <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })" class="z-[9999] m-0 min-w-64 list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none">
                <BitBhMenuItem OnClick='@(() => Log("New file"))' class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="New file">
                    <span class="text-base flex-shrink-0">📄</span>
                    <span class="flex flex-1 flex-col leading-tight">
                        <strong class="text-sm">New file</strong>
                        <span class="text-xs text-zinc-500">Create a blank document</span>
                    </span>
                    <span class="ml-auto text-xs text-zinc-500">⌘N</span>
                </BitBhMenuItem>
                <BitBhMenuItem OnClick='@(() => Log("Open"))' class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Open">
                    <span class="text-base flex-shrink-0">📂</span>
                    <span class="flex flex-1 flex-col leading-tight">
                        <strong class="text-sm">Open…</strong>
                        <span class="text-xs text-zinc-500">Browse for a file</span>
                    </span>
                    <span class="ml-auto text-xs text-zinc-500">⌘O</span>
                </BitBhMenuItem>
                <BitBhMenuItem OnClick='@(() => Log("Save"))' class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Save">
                    <span class="text-base flex-shrink-0">💾</span>
                    <span class="flex flex-1 flex-col leading-tight">
                        <strong class="text-sm">Save</strong>
                        <span class="text-xs text-zinc-500">Save the current document</span>
                    </span>
                    <span class="ml-auto text-xs text-zinc-500">⌘S</span>
                </BitBhMenuItem>
                <BitBhMenuItem OnClick='@(() => Log("Export"))' class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Export" Disabled="true">
                    <span class="text-base flex-shrink-0">📤</span>
                    <span class="flex flex-1 flex-col leading-tight">
                        <strong class="text-sm">Export</strong>
                        <span class="text-xs text-zinc-500">Not available in this plan</span>
                    </span>
                </BitBhMenuItem>
            </BitBhMenuItems>
        </BitBhMenu>
        <span class="text-sm text-zinc-500">Last action: <strong class="text-zinc-900">@(lastAction ?? "(none)")</strong></span>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Sections and dividers" Code="@_sectionsCode">
    <Description>
        Group related items with a plain <code>&lt;div&gt;</code> divider or a
        section heading. These are regular HTML elements — the menu component
        doesn't need to know about them.
    </Description>
    <LiveContent>
        <BitBhMenu class="relative inline-block">
            <BitBhMenuButton class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
