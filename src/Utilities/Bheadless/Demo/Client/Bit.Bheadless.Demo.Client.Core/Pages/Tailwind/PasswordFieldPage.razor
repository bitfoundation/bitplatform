@page "/tw/password-field"

<PageTitle>Password Field (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Password Field</h1>
    <p class="bb-subtitle">A password input with a show / hide toggle that keeps typing and focus where people expect them.</p>
</div>

<SectionSwitcher Slug="password-field" />

<TwDemoBlock Title="Show / hide" Code="@_code">
    <Description>
        The toggle's name follows the state; <code>data-visible</code> is on every part while the password shows.
    </Description>
    <LiveContent>
        <BitBhPasswordField class="inline-flex items-center rounded-lg border border-zinc-300 bg-white focus-within:outline-2 focus-within:outline-offset-1 focus-within:outline-blue-600">
            <BitBhPasswordFieldInput aria-label="Password" class="h-9 bg-transparent px-2 text-sm text-zinc-900 outline-none" />
            <BitBhPasswordFieldToggle class="h-9 cursor-pointer rounded-lg px-3 text-sm text-zinc-700 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-blue-600">
                <Template Context="visible">@(visible ? "Hide" : "Show")</Template>
            </BitBhPasswordFieldToggle>
        </BitBhPasswordField>
    </LiveContent>
</TwDemoBlock>

@code {
    private const string _code = """
<BitBhPasswordField class="inline-flex items-center rounded-lg border border-zinc-300 bg-white focus-within:outline-2">
    <BitBhPasswordFieldInput aria-label="Password" class="h-9 bg-transparent px-2 text-sm outline-none" />
    <BitBhPasswordFieldToggle class="h-9 rounded-lg px-3 text-sm hover:bg-zinc-100">
        <Template Context="visible">@(visible ? "Hide" : "Show")</Template>
    </BitBhPasswordFieldToggle>
</BitBhPasswordField>
""";
}
