<TwDemoBlock Title="Data-driven (recursive)" Code="@_recursiveCode">
    <Description>
        Render the tree from a model with a recursive <code>RenderFragment&lt;Node&gt;</code> helper. Each
        <code>BitBhTreeItem</code> works out its depth from where it is rendered, so the markup is the same at
        every level. Supplying <code>@@bind-ExpandedValues</code> makes expansion controlled, so plain
        buttons can expand or collapse everything.
    </Description>
    <LiveContent>
        <div class="flex w-full flex-col items-start gap-3">
            <div class="flex gap-2">
                <button type="button" @onclick="ExpandAllDocs"
                        class="cursor-pointer rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-900 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">Expand all</button>
                <button type="button" @onclick="CollapseAllDocs"
                        class="cursor-pointer rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-900 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">Collapse all</button>
            </div>

            <BitBhTree TValue="string" aria-label="Documentation"
                    @bind-SelectedValue="selectedDoc"
                    @bind-ExpandedValues="expandedDocs"
                    class="w-full max-w-sm rounded-lg border border-zinc-200 bg-white p-1.5 text-sm text-zinc-900 [&_[role=treeitem]]:outline-none [&_[role=treeitem]:focus-visible>div]:outline-2 [&_[role=treeitem]:focus-visible>div]:-outline-offset-2 [&_[role=treeitem]:focus-visible>div]:outline-blue-600 [&_[aria-selected=true]>div]:bg-blue-50 [&_[aria-selected=true]>div]:font-medium [&_[aria-selected=true]>div]:text-blue-700">
                @foreach (var node in docs)
                {
                    @DocItem(node)
                }
            </BitBhTree>

            <p class="text-sm text-zinc-500">
                Selected: <strong class="font-semibold text-zinc-900">@(selectedDoc ?? "(none)")</strong> ·
                Expanded: <strong class="font-semibold text-zinc-900">@expandedDocs.Count</strong>
            </p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Multiple selection" Code="@_multiCode">
    <Description>
        <code>SelectionMode="BitBhTreeSelectionMode.Multiple"</code> sets <code>aria-multiselectable</code> and
        binds with <code>@@bind-SelectedValues</code>. Click selects one item, Ctrl / ⌘ + click toggles,
        Shift + click selects a range. Keyboard: Space toggles the focused item, Shift + Up / Down extends
        the selection, Ctrl + A selects everything.
    </Description>
    <LiveContent>
        <div class="flex w-full flex-col items-start gap-3">
            <BitBhTree TValue="string" aria-label="Mailboxes"
                    SelectionMode="BitBhTreeSelectionMode.Multiple"
                    @bind-SelectedValues="selectedBoxes"
                    DefaultExpandedValues="@(new[] { "Inbox", "Projects" })"
                    class="w-full max-w-sm rounded-lg border border-zinc-200 bg-white p-1.5 text-sm text-zinc-900 [&_[role=treeitem]]:outline-none [&_[role=treeitem]:focus-visible>div]:outline-2 [&_[role=treeitem]:focus-visible>div]:-outline-offset-2 [&_[role=treeitem]:focus-visible>div]:outline-blue-600 [&_[aria-selected=true]>div]:bg-blue-50 [&_[aria-selected=true]>div]:font-medium [&_[aria-selected=true]>div]:text-blue-700">
                @foreach (var (icon, name, children) in mailboxes)
                {
                    <BitBhTreeItem TValue="string" Value="@name" Label="@name">
                        <div class="flex min-h-8 cursor-pointer select-none items-center gap-1.5 rounded-md py-1 pr-2 pl-[calc((var(--bit-bh-tree-level)_-_1)_*_1.25rem_+_0.375rem)] hover:bg-zinc-100">
                            <BitBhTreeItemToggle TValue="string" class="inline-flex size-5 flex-none items-center justify-center rounded text-xs text-zinc-400 transition-transform duration-150 hover:bg-zinc-200 hover:text-zinc-900 data-state-open:rotate-90 data-[leaf]:invisible">▸</BitBhTreeItemToggle>
                            <span class="w-5 flex-none text-center">@icon</span>
                            <span>@name</span>
                            <span class="ml-auto min-w-5 rounded-full bg-zinc-100 px-1.5 text-center text-[0.7rem] text-zinc-500">@children.Length</span>
                        </div>
                        <BitBhTreeGroup TValue="string">
                            @foreach (var child in children)
                            {
                                <BitBhTreeItem TValue="string" Value="@($"{name}/{child}")" Label="@child">
                                    <div class="flex min-h-8 cursor-pointer select-none items-center gap-1.5 rounded-md py-1 pr-2 pl-[calc((var(--bit-bh-tree-level)_-_1)_*_1.25rem_+_0.375rem)] hover:bg-zinc-100">
                                        <BitBhTreeItemToggle TValue="string" class="inline-flex size-5 flex-none items-center justify-center rounded text-xs text-zinc-400 transition-transform duration-150 hover:bg-zinc-200 hover:text-zinc-900 data-state-open:rotate-90 data-[leaf]:invisible">▸</BitBhTreeItemToggle>
                                        <span class="w-5 flex-none text-center">📁</span>
                                        <span>@child</span>
                                    </div>
                                </BitBhTreeItem>
                            }
                        </BitBhTreeGroup>
                    </BitBhTreeItem>
                }
            </BitBhTree>

            <p class="text-sm text-zinc-500">
                @selectedBoxes.Count selected: <strong class="font-semibold text-zinc-900">@(selectedBoxes.Count == 0 ? "—" : string.Join(", ", selectedBoxes))</strong>
            </p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Hierarchical checkboxes" Code="@_checkboxCode">
    <Description>
        <code>Checkboxes="true"</code> turns the tree into a hierarchical picker: checking a parent checks all
        of its descendants, and a parent whose leaves are only partly checked reports
        <code>aria-checked="mixed"</code>. Click a row or press Space to toggle it. The two versions draw the
        box differently: the CSS version reads the <code>data-checked="true|false|mixed"</code> every item
        emits (<code>.tree-item[data-checked="mixed"] &gt; .tree-row .tree-check</code>), while the Tailwind
        version takes <code>Checked</code> (true / false / null = mixed) from the item's <code>Template</code>,
        mirrors it onto the box's own <code>data-checked</code> and styles it with
        <code>data-[checked=mixed]:</code>.
    </Description>
    <LiveContent>
        <div class="flex w-full flex-col items-start gap-3">
            <BitBhTree TValue="string" aria-label="Features to install"
                    Checkboxes="true"
                    @bind-SelectedValues="checkedFeatures"
                    DefaultExpandedValues="@(new[] { "app", "app-themes" })"
                    class="w-full max-w-sm rounded-lg border border-zinc-200 bg-white p-1.5 text-sm text-zinc-900 [&_[role=treeitem]]:outline-none [&_[role=treeitem]:focus-visible>div]:outline-2 [&_[role=treeitem]:focus-visible>div]:-outline-offset-2 [&_[role=treeitem]:focus-visible>div]:outline-blue-600">
                @foreach (var node in features)
                {
                    @FeatureItem(node)
                }
            </BitBhTree>

            <p class="text-sm text-zinc-500">
                Installing: <strong class="font-semibold text-zinc-900">@(InstalledFeatures.Any() ? string.Join(", ", InstalledFeatures) : "nothing")</strong>
            </p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Lazy loading" Code="@_lazyCode">
    <Description>
        Mark folders whose children are not loaded yet with <code>HasChildren="true"</code> and supply
        <code>LoadChildren</code>. It runs the first time a folder expands; meanwhile the item reports
        <code>aria-busy="true"</code> (and <code>IsLoading</code> in its <code>Template</code>) so you can show
        a spinner. The folder opens once the children are rendered.
    </Description>
    <LiveContent>
        <div class="flex w-full flex-col items-start gap-3">
            <BitBhTree TValue="string" aria-label="Cloud storage"
                    LoadChildren="LoadChildrenAsync"
                    class="w-full max-w-sm rounded-lg border border-zinc-200 bg-white p-1.5 text-sm text-zinc-900 [&_[role=treeitem]]:outline-none [&_[role=treeitem]:focus-visible>div]:outline-2 [&_[role=treeitem]:focus-visible>div]:-outline-offset-2 [&_[role=treeitem]:focus-visible>div]:outline-blue-600 [&_[aria-selected=true]>div]:bg-blue-50 [&_[aria-selected=true]>div]:font-medium [&_[aria-selected=true]>div]:text-blue-700 [&_[aria-busy=true]>div]:cursor-progress [&_[aria-busy=true]>div]:text-zinc-500">
                @foreach (var bucket in buckets)
                {
                    @RemoteItem(bucket)
                }
            </BitBhTree>
        </div>
    </LiveContent>
</TwDemoBlock>

@code {
    // ── File explorer ────────────────────────────────────────────────────────
    private string? selectedFile = "src/components/Tree.razor";
    private string? openedFile;

    // ── Data-driven (recursive) ──────────────────────────────────────────────
    private sealed record Node(string Id, string Name, Node[] Children);

    private readonly Node[] docs =
    [
        new("start", "Getting started",
        [
            new("installation", "Installation", []),
            new("quick-start", "Quick start", []),
        ]),
        new("components", "Components",
        [
            new("overlays", "Overlays",
            [
                new("dialog", "Dialog", []),
                new("popover", "Popover", []),
                new("tooltip", "Tooltip", []),
            ]),
            new("collections", "Collections",
            [
                new("listbox", "Listbox", []),
                new("tree", "Tree View", []),
                new("grid", "Grid", []),
            ]),
        ]),
        new("styling", "Styling",
        [
            new("plain-css", "Plain CSS", []),
            new("tailwind", "Tailwind", []),
        ]),
    ];

    private string? selectedDoc = "tree";
    private IReadOnlyCollection<string> expandedDocs = ["components", "collections"];

    private void ExpandAllDocs() => expandedDocs = Branches(docs).ToArray();

    private void CollapseAllDocs() => expandedDocs = [];

    private static IEnumerable<string> Branches(IEnumerable<Node> nodes) =>
        nodes.Where(n => n.Children.Length > 0).SelectMany(n => Branches(n.Children).Prepend(n.Id));

    private RenderFragment<Node> DocItem => node =>
        @<BitBhTreeItem TValue="string" Value="@node.Id" Label="@node.Name">
            <div class="flex min-h-8 cursor-pointer select-none items-center gap-1.5 rounded-md py-1 pr-2 pl-[calc((var(--bit-bh-tree-level)_-_1)_*_1.25rem_+_0.375rem)] hover:bg-zinc-100">
                <BitBhTreeItemToggle TValue="string" class="inline-flex size-5 flex-none items-center justify-center rounded text-xs text-zinc-400 transition-transform duration-150 hover:bg-zinc-200 hover:text-zinc-900 data-state-open:rotate-90 data-[leaf]:invisible">▸</BitBhTreeItemToggle>
                <span>@node.Name</span>
                @if (node.Children.Length > 0)
                {
                    <span class="ml-auto min-w-5 rounded-full bg-zinc-100 px-1.5 text-center text-[0.7rem] text-zinc-500">@node.Children.Length</span>
                }
            </div>
            @if (node.Children.Length > 0)
            {
                <BitBhTreeGroup TValue="string">
                    @foreach (var child in node.Children)
                    {
                        @DocItem(child)
                    }
                </BitBhTreeGroup>
            }
        </BitBhTreeItem>;

