@page "/tw/menubar"

<PageTitle>Menubar — bit Bheadless · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Menubar</h1>
        <p class="mt-2 text-zinc-500">A desktop-style application menu bar — menus, submenus, checkable items and keyboard shortcuts — with zero visual opinion.</p>
        <TwSectionSwitcher Slug="menubar" />
    </header>

    <TwDemoBlock Title="Application menubar" Code="@_appCode">
        <Description>
            The WAI-ARIA menubar pattern: the bar is a single tab stop, ← / → move between menus (and switch the
            open one), ↓ / Enter / Space open a menu, ↑ / ↓, Home / End and typeahead move inside it, → / ← open
            and close submenus, and Escape closes. Once a menu is open, hovering another trigger switches to it.
            Checkbox (<code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">menuitemcheckbox</code>) and radio (<code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">menuitemradio</code>) items keep the menu
            open and show their state through <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhMenuItemIndicator</code>; <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhMenuLabel</code> names its
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhMenuGroup</code>. The shortcuts are just text.
        </Description>
        <LiveContent>
            <BitBhMenubar class="inline-flex items-center gap-0.5 rounded-lg border border-zinc-200 bg-white p-1 shadow-sm" aria-label="Application">
                <BitBhMenu>
                    <BitBhMenuButton class="cursor-pointer select-none rounded-md px-3 py-1.5 text-sm font-medium text-zinc-800 transition-colors hover:bg-zinc-100 focus-visible:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:cursor-not-allowed data-disabled:opacity-40 data-disabled:hover:bg-transparent">File</BitBhMenuButton>
                    <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 6 })" class="z-50 min-w-56 rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none transition-opacity duration-100 ease-out starting:opacity-0">
                        <BitBhMenuItem OnClick='@(() => Log("New Tab"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            New Tab <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌘T</span>
                        </BitBhMenuItem>
                        <BitBhMenuItem OnClick='@(() => Log("New Window"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            New Window <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌘N</span>
                        </BitBhMenuItem>
                        <BitBhMenuItem Disabled="true" class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">New Incognito Window</BitBhMenuItem>
                        <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                        <BitBhMenuSub>
                            <BitBhMenuSubTrigger class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 data-state-open:bg-zinc-100 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                Share <span class="ml-auto pl-6 text-zinc-400" aria-hidden="true">›</span>
                            </BitBhMenuSubTrigger>
                            <BitBhMenuSubContent class="z-50 min-w-56 rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none transition-opacity duration-100 ease-out starting:opacity-0">
                                <BitBhMenuItem OnClick='@(() => Log("Email Link"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">Email Link</BitBhMenuItem>
                                <BitBhMenuItem OnClick='@(() => Log("Messages"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">Messages</BitBhMenuItem>
                                <BitBhMenuItem OnClick='@(() => Log("Notes"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">Notes</BitBhMenuItem>
                            </BitBhMenuSubContent>
                        </BitBhMenuSub>
                        <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                        <BitBhMenuItem OnClick='@(() => Log("Print"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            Print… <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌘P</span>
                        </BitBhMenuItem>
                    </BitBhMenuItems>
                </BitBhMenu>

                <BitBhMenu>
                    <BitBhMenuButton class="cursor-pointer select-none rounded-md px-3 py-1.5 text-sm font-medium text-zinc-800 transition-colors hover:bg-zinc-100 focus-visible:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:cursor-not-allowed data-disabled:opacity-40 data-disabled:hover:bg-transparent">Edit</BitBhMenuButton>
                    <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 6 })" class="z-50 min-w-56 rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none transition-opacity duration-100 ease-out starting:opacity-0">
                        <BitBhMenuItem OnClick='@(() => Log("Undo"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            Undo <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌘Z</span>
                        </BitBhMenuItem>
                        <BitBhMenuItem OnClick='@(() => Log("Redo"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            Redo <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⇧⌘Z</span>
                        </BitBhMenuItem>
                        <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                        <BitBhMenuSub>
                            <BitBhMenuSubTrigger class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 data-state-open:bg-zinc-100 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                Find <span class="ml-auto pl-6 text-zinc-400" aria-hidden="true">›</span>
                            </BitBhMenuSubTrigger>
                            <BitBhMenuSubContent class="z-50 min-w-56 rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none transition-opacity duration-100 ease-out starting:opacity-0">
                                <BitBhMenuItem OnClick='@(() => Log("Search the Web"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">Search the Web…</BitBhMenuItem>
                                <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                                <BitBhMenuItem OnClick='@(() => Log("Find"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                    Find… <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌘F</span>
                                </BitBhMenuItem>
                                <BitBhMenuItem OnClick='@(() => Log("Find Next"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                    Find Next <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌘G</span>
                                </BitBhMenuItem>
                                <BitBhMenuItem OnClick='@(() => Log("Find Previous"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                    Find Previous <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⇧⌘G</span>
                                </BitBhMenuItem>
                            </BitBhMenuSubContent>
                        </BitBhMenuSub>
                        <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                        <BitBhMenuItem OnClick='@(() => Log("Cut"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            Cut <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌘X</span>
                        </BitBhMenuItem>
                        <BitBhMenuItem OnClick='@(() => Log("Copy"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            Copy <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌘C</span>
                        </BitBhMenuItem>
                        <BitBhMenuItem OnClick='@(() => Log("Paste"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-800 no-underline data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            Paste <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌘V</span>
                        </BitBhMenuItem>
                    </BitBhMenuItems>
                </BitBhMenu>

                <BitBhMenu>
                    <BitBhMenuButton class="cursor-pointer select-none rounded-md px-3 py-1.5 text-sm font-medium text-zinc-800 transition-colors hover:bg-zinc-100 focus-visible:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:cursor-not-allowed data-disabled:opacity-40 data-disabled:hover:bg-transparent">View</BitBhMenuButton>
                    <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 6 })" class="z-50 min-w-56 rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none transition-opacity duration-100 ease-out starting:opacity-0">
                        <BitBhMenuCheckboxItem @bind-Checked="showBookmarks" class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            <BitBhMenuItemIndicator class="absolute left-2 inline-flex w-4 justify-center text-xs text-blue-600">✓</BitBhMenuItemIndicator>
                            Always Show Bookmarks Bar <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⇧⌘B</span>
                        </BitBhMenuCheckboxItem>
                        <BitBhMenuCheckboxItem @bind-Checked="showFullUrls" class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            <BitBhMenuItemIndicator class="absolute left-2 inline-flex w-4 justify-center text-xs text-blue-600">✓</BitBhMenuItemIndicator>
                            Always Show Full URLs
                        </BitBhMenuCheckboxItem>
                        <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                        <BitBhMenuItem OnClick='@(() => Log("Reload"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            Reload <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌘R</span>
                        </BitBhMenuItem>
                        <BitBhMenuItem Disabled="true" class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                            Force Reload <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⇧⌘R</span>
                        </BitBhMenuItem>
                        <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                        <BitBhMenuItem OnClick='@(() => Log("Toggle Fullscreen"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">Toggle Fullscreen</BitBhMenuItem>
                        <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                        <BitBhMenuItem OnClick='@(() => Log("Hide Sidebar"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">Hide Sidebar</BitBhMenuItem>
                    </BitBhMenuItems>
                </BitBhMenu>

                <BitBhMenu>
                    <BitBhMenuButton class="cursor-pointer select-none rounded-md px-3 py-1.5 text-sm font-medium text-zinc-800 transition-colors hover:bg-zinc-100 focus-visible:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:cursor-not-allowed data-disabled:opacity-40 data-disabled:hover:bg-transparent">Profiles</BitBhMenuButton>
                    <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 6 })" class="z-50 min-w-56 rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none transition-opacity duration-100 ease-out starting:opacity-0">
                        <BitBhMenuGroup>
                            <BitBhMenuLabel class="pt-2 pr-2.5 pb-1 pl-7 text-xs font-semibold uppercase tracking-wider text-zinc-500">Switch profile</BitBhMenuLabel>
                            <BitBhMenuRadioGroup @bind-Value="profile">
                                @foreach (var name in profiles)
                                {
                                    <BitBhMenuRadioItem Value="@name" class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                        <BitBhMenuItemIndicator class="absolute left-2 inline-flex w-4 justify-center text-xs text-blue-600"><span class="block size-1.5 rounded-full bg-current"></span></BitBhMenuItemIndicator>
                                        @name
                                    </BitBhMenuRadioItem>
                                }
                            </BitBhMenuRadioGroup>
                        </BitBhMenuGroup>
                        <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                        <BitBhMenuItem OnClick='@(() => Log("Edit profile"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">Edit…</BitBhMenuItem>
                        <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                        <BitBhMenuItem OnClick='@(() => Log("Add Profile"))' class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">Add Profile…</BitBhMenuItem>
                    </BitBhMenuItems>
                </BitBhMenu>
            </BitBhMenubar>

            <span class="text-sm text-zinc-500">
                Last action: <strong class="text-zinc-900">@(lastAction ?? "(none)")</strong> ·
                Bookmarks bar: <strong class="text-zinc-900">@(showBookmarks ? "on" : "off")</strong> ·
                Profile: <strong class="text-zinc-900">@profile</strong>
            </span>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Checkbox and radio items driving the UI" Code="@_editorCode">
        <Description>
            Checkable items are just bound state. <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">@@bind-Checked</code> on <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhMenuCheckboxItem</code> and
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">@@bind-Value</code> on <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhMenuRadioGroup</code> drive the editor below — toggle line numbers, word
            wrap and the status bar, change the zoom or the theme. The menu stays open while you toggle so you can
            see each change; set <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">CloseOnSelect="true"</code> on an item to close it instead.
        </Description>
        <LiveContent>
            <div class="w-full max-w-xl overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm">
                <BitBhMenubar class="flex w-full items-center gap-0.5 border-b border-zinc-200 bg-zinc-50 p-1" aria-label="Editor">
                    <BitBhMenu>
                        <BitBhMenuButton class="cursor-pointer select-none rounded-md px-3 py-1.5 text-sm font-medium text-zinc-800 transition-colors hover:bg-zinc-100 focus-visible:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:cursor-not-allowed data-disabled:opacity-40 data-disabled:hover:bg-transparent">View</BitBhMenuButton>
                        <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 6 })" class="z-50 min-w-56 rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none transition-opacity duration-100 ease-out starting:opacity-0">
                            <BitBhMenuCheckboxItem @bind-Checked="lineNumbers" class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                <BitBhMenuItemIndicator class="absolute left-2 inline-flex w-4 justify-center text-xs text-blue-600">✓</BitBhMenuItemIndicator>
                                Line Numbers
                            </BitBhMenuCheckboxItem>
                            <BitBhMenuCheckboxItem @bind-Checked="wordWrap" class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                <BitBhMenuItemIndicator class="absolute left-2 inline-flex w-4 justify-center text-xs text-blue-600">✓</BitBhMenuItemIndicator>
                                Word Wrap <span class="ml-auto pl-6 text-xs tracking-widest text-zinc-400">⌥Z</span>
                            </BitBhMenuCheckboxItem>
                            <BitBhMenuCheckboxItem @bind-Checked="statusBar" class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                <BitBhMenuItemIndicator class="absolute left-2 inline-flex w-4 justify-center text-xs text-blue-600">✓</BitBhMenuItemIndicator>
                                Status Bar
                            </BitBhMenuCheckboxItem>
                            <BitBhMenuSeparator class="-mx-1 my-1 h-px bg-zinc-200" />
                            <BitBhMenuGroup>
                                <BitBhMenuLabel class="pt-2 pr-2.5 pb-1 pl-7 text-xs font-semibold uppercase tracking-wider text-zinc-500">Zoom</BitBhMenuLabel>
                                <BitBhMenuRadioGroup @bind-Value="zoom">
                                    @foreach (var level in zoomLevels)
                                    {
                                        <BitBhMenuRadioItem Value="@level" class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                            <BitBhMenuItemIndicator class="absolute left-2 inline-flex w-4 justify-center text-xs text-blue-600"><span class="block size-1.5 rounded-full bg-current"></span></BitBhMenuItemIndicator>
                                            @(level)%
                                        </BitBhMenuRadioItem>
                                    }
                                </BitBhMenuRadioGroup>
                            </BitBhMenuGroup>
                        </BitBhMenuItems>
                    </BitBhMenu>
                    <BitBhMenu>
                        <BitBhMenuButton class="cursor-pointer select-none rounded-md px-3 py-1.5 text-sm font-medium text-zinc-800 transition-colors hover:bg-zinc-100 focus-visible:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:cursor-not-allowed data-disabled:opacity-40 data-disabled:hover:bg-transparent">Theme</BitBhMenuButton>
                        <BitBhMenuItems Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 6 })" class="z-50 min-w-56 rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none transition-opacity duration-100 ease-out starting:opacity-0">
                            <BitBhMenuRadioGroup @bind-Value="editorTheme" AriaLabel="Color theme">
                                @foreach (var option in editorThemes)
                                {
                                    <BitBhMenuRadioItem Value="@option" class="relative flex cursor-pointer select-none items-center gap-2 rounded-md py-1.5 pr-2.5 pl-7 text-sm text-zinc-800 data-active:bg-blue-50 data-active:text-blue-700 data-disabled:cursor-not-allowed data-disabled:opacity-40">
                                        <BitBhMenuItemIndicator class="absolute left-2 inline-flex w-4 justify-center text-xs text-blue-600"><span class="block size-1.5 rounded-full bg-current"></span></BitBhMenuItemIndicator>
                                        @option
                                    </BitBhMenuRadioItem>
                                }
                            </BitBhMenuRadioGroup>
                        </BitBhMenuItems>
                    </BitBhMenu>
                </BitBhMenubar>

                <div class="bg-[#fff] text-[0.8rem] text-[#27272a] transition-colors data-[theme=Dark]:bg-[#18181b] data-[theme=Dark]:text-[#e4e4e7] data-[theme=Sepia]:bg-[#f7f0e1] data-[theme=Sepia]:text-[#5b4636]" data-theme="@editorTheme">
                    <div class="overflow-x-auto px-4 py-3 font-mono leading-relaxed outline-none focus-visible:ring-2 focus-visible:ring-blue-600" tabindex="0" role="region" aria-label="Editor preview" style="font-size: @(zoom)%">
                        @for (var i = 0; i < editorLines.Length; i++)
                        {
                            <div class="flex gap-3">
                                @if (lineNumbers)
                                {
                                    <span class="w-5 shrink-0 select-none text-right opacity-40">@(i + 1)</span>
                                }
                                <span class="@(wordWrap ? "whitespace-pre-wrap" : "whitespace-pre")">@editorLines[i]</span>
                            </div>
                        }
                    </div>
                    @if (statusBar)
                    {
                        <div class="flex gap-3 border-t border-current/10 px-4 py-1.5 text-xs opacity-70">
