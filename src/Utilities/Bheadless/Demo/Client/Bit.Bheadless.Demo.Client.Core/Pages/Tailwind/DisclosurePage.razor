@page "/tw/disclosure"

<PageTitle>Disclosure (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Disclosure</h1>
    <p class="bb-subtitle">A single show/hide region toggled by a button — the simplest collapsible primitive.</p>
</div>

<SectionSwitcher Slug="disclosure" />

<TwDemoBlock Title="Basic Disclosure" Code="@_basicCode">
    <Description>
        Renders a button and a panel. Clicking the button toggles the panel.
        <code>aria-expanded</code> and <code>aria-controls</code>
        are wired automatically.
    </Description>
    <LiveContent>
        <BitBhDisclosure class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
            <BitBhDisclosureButton class="flex w-full cursor-pointer items-center justify-between gap-3 border-0 bg-transparent px-5 py-3.5 text-left text-base font-medium hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">
                Show details
            </BitBhDisclosureButton>
            <BitBhDisclosurePanel>
                <div class="border-t border-zinc-200 px-5 py-3.5 text-sm text-zinc-500">
                    Disclosure is the simpler sibling of Accordion: one trigger, one panel, zero coordination.
                </div>
            </BitBhDisclosurePanel>
        </BitBhDisclosure>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Default Open" Code="@_defaultOpenCode">
    <Description>
        Set <code>DefaultOpen="true"</code> to render the panel open initially (uncontrolled).
    </Description>
    <LiveContent>
        <BitBhDisclosure DefaultOpen="true" class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
            <BitBhDisclosureButton class="flex w-full cursor-pointer items-center justify-between gap-3 border-0 bg-transparent px-5 py-3.5 text-left text-base font-medium hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">
                Already open
            </BitBhDisclosureButton>
            <BitBhDisclosurePanel>
                <div class="border-t border-zinc-200 px-5 py-3.5 text-sm text-zinc-500">
                    I'm open by default. Click the button to close me.
                </div>
            </BitBhDisclosurePanel>
        </BitBhDisclosure>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Render Context (rotating chevron + Close)" Code="@_renderContextCode">
    <Description>
        <code>BitBhDisclosure</code>, <code>BitBhDisclosureButton</code>, and <code>BitBhDisclosurePanel</code>
        all expose a <code>BitBhDisclosureRenderContext</code> via <code>Context="d"</code>. Use it
        to drive UI from the open state and to call <code>d.Close()</code> from anywhere inside.
    </Description>
    <LiveContent>
        <BitBhDisclosure class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
            <BitBhDisclosureButton class="flex w-full cursor-pointer items-center justify-between gap-3 border-0 bg-transparent px-5 py-3.5 text-left text-base font-medium hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">
                <Template Context="d">
                    <span>What's inside?</span>
                    <span class="@($"text-zinc-500 transition-transform duration-200 {(d.IsOpen ? "rotate-180" : "")}")" aria-hidden="true">▾</span>
                </Template>
            </BitBhDisclosureButton>
            <BitBhDisclosurePanel>
                <Template Context="d">
                    <div class="border-t border-zinc-200 px-5 py-3.5 text-sm text-zinc-500">
                        <p>You can close me from inside the panel:</p>
                        <button class="mt-3 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium hover:bg-zinc-100" @onclick="d.Close">Close panel</button>
                    </div>
                </Template>
            </BitBhDisclosurePanel>
        </BitBhDisclosure>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabled" Code="@_disabledCode">
    <Description>
        Set <code>Disabled="true"</code> on the root to block interaction. The button receives
        both the native <code>disabled</code> attribute and a <code>data-disabled</code> hook; the root
        gets <code>data-disabled</code> too, for dimming the whole region. The CSS version styles them
        with <code>[data-disabled]</code> selectors, the Tailwind version with the
        <code>data-disabled:</code> variant.
    </Description>
    <LiveContent>
        <BitBhDisclosure Disabled="true" class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
            <BitBhDisclosureButton class="flex w-full cursor-pointer items-center justify-between gap-3 border-0 bg-transparent px-5 py-3.5 text-left text-base font-medium hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">
                Can't toggle me
            </BitBhDisclosureButton>
            <BitBhDisclosurePanel>
                <div class="border-t border-zinc-200 px-5 py-3.5 text-sm text-zinc-500">You'll never see this content.</div>
            </BitBhDisclosurePanel>
        </BitBhDisclosure>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Controlled" Code="@_controlledCode">
    <Description>
        Drive the open state externally with <code>Open</code> + <code>OnOpenChange</code>.
        The button below opens or closes the disclosure programmatically.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-4 w-full">
            <div class="flex flex-wrap items-center gap-3">
                <BitBhButton OnClick="ToggleControlled"
                          class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium hover:bg-zinc-100">
                    Toggle from outside
                </BitBhButton>
                <span class="text-sm text-zinc-500">Open: @controlledOpen.ToString().ToLowerInvariant()</span>
            </div>

            <BitBhDisclosure Open="controlledOpen" OnOpenChange="v => controlledOpen = v"
                          class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
                <BitBhDisclosureButton class="flex w-full cursor-pointer items-center justify-between gap-3 border-0 bg-transparent px-5 py-3.5 text-left text-base font-medium hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">
                    Internal trigger
                </BitBhDisclosureButton>
                <BitBhDisclosurePanel>
                    <div class="border-t border-zinc-200 px-5 py-3.5 text-sm text-zinc-500">Either trigger updates the same state.</div>
                </BitBhDisclosurePanel>
            </BitBhDisclosure>
        </div>
    </LiveContent>
</TwDemoBlock>

