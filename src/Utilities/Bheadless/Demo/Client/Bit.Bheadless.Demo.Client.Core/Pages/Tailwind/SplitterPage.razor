    <BitBhSplitterHandle aria-label="Resize preview" class="group relative z-[1] -mx-3 flex w-6 cursor-col-resize items-center justify-center outline-none">
        <span class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-zinc-200 group-data-hover:bg-blue-600 group-data-dragging:bg-blue-600"></span>
        <span class="relative h-7 w-2 rounded-full border border-zinc-500 bg-white group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-blue-600 group-data-hover:border-blue-600 group-data-hover:bg-blue-600 group-data-dragging:border-blue-600 group-data-dragging:bg-blue-600"></span>
    </BitBhSplitterHandle>
    <BitBhSplitterPanel @ref="preview" Key="preview" MinSize="15" class="bg-zinc-50 px-4 py-3">
        <p class="m-0 text-sm font-semibold">Preview</p>
    </BitBhSplitterPanel>
</BitBhSplitter>

<p class="m-0 text-sm text-zinc-500">Commits: <strong class="font-semibold text-zinc-900">@commits</strong></p>

@code {
    private IReadOnlyList<double> boundSizes = [25, 50, 25];
    private int commits;
    private bool sidebarCollapsed;
    private BitBhSplitterPanel? sidebar;
    private BitBhSplitterPanel? preview;

    // A layout set from here is no collapse the panel reports: the flag follows it.
    private void Reset()
    {
        boundSizes = [25, 50, 25];
        sidebarCollapsed = false;
    }

    private Task ToggleSidebar() => sidebar is null ? Task.CompletedTask
        : sidebarCollapsed ? sidebar.ExpandAsync() : sidebar.CollapseAsync();
}
""";
}
