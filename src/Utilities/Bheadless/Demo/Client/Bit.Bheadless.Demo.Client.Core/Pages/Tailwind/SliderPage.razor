@page "/tw/slider"

<PageTitle>Slider (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Slider</h1>
    <p class="bb-subtitle">Pick a value — or a range with several thumbs — within a minimum and maximum, by pointer or keyboard. Thumbs and the range receive their positioning inline; you size and color the parts.</p>
</div>

<SectionSwitcher Slug="slider" />

<TwDemoBlock Title="Single value" Code="@_singleCode">
    <Description>
        Follows the WAI-ARIA Slider pattern: each <code>BitBhSliderThumb</code> is a
        <code>role="slider"</code> with <code>aria-valuenow</code>/<code>min</code>/<code>max</code>.
        Click or drag anywhere on the track, or focus the thumb and use the arrow keys (±
        <code>Step</code>), <kbd>PageUp</kbd> / <kbd>PageDown</kbd> or <kbd>Shift</kbd>+arrows (±
        <code>LargeStep</code>) and <kbd>Home</kbd> / <kbd>End</kbd>. The root's default layout styles
        only apply when it has no <code>class</code> or <code>style</code>, so a styled root needs
        <code>position: relative</code> itself — the thumbs are positioned against it.
    </Description>
    <LiveContent>
        <div class="grid w-full gap-4">
            <BitBhSlider @bind-Value="volume"
                      class="relative flex h-5 w-full max-w-xs cursor-pointer touch-none select-none items-center">
                <BitBhSliderTrack class="h-1.5 rounded-full bg-zinc-200">
                    <BitBhSliderRange class="inset-0 rounded-full bg-blue-600" />
                </BitBhSliderTrack>
                <BitBhSliderThumb aria-label="Volume"
                               class="top-1/2 -mt-2.5 block size-5 cursor-grab rounded-full border-2 border-blue-600 bg-[#fff] shadow outline-none transition-shadow hover:ring-4 hover:ring-blue-600/15 focus-visible:ring-4 focus-visible:ring-blue-600/35 data-dragging:cursor-grabbing data-dragging:ring-[6px] data-dragging:ring-blue-600/20" />
            </BitBhSlider>
            <p class="m-0 text-sm text-zinc-500">Volume: <strong class="font-semibold tabular-nums text-zinc-900">@volume</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Range with two thumbs" Code="@_rangeCode">
    <Description>
        Bind <code>@@bind-Values</code> and render one thumb per value (Multi-Thumb Slider pattern).
        Thumbs can't cross; <code>MinStepsBetweenThumbs</code> keeps them apart. <code>ValueText</code>
        formats <code>aria-valuetext</code> so screen readers hear "$200" instead of "200".
        <code>BitBhSliderRange</code> fills the span between the thumbs.
    </Description>
    <LiveContent>
        <div class="grid w-full gap-4">
            <BitBhSlider @bind-Values="price" Max="1000" Step="10" MinStepsBetweenThumbs="10"
                      ValueText="@(v => $"${v:N0}")"
                      class="relative flex h-5 w-full max-w-xs cursor-pointer touch-none select-none items-center">
                <BitBhSliderTrack class="h-1.5 rounded-full bg-zinc-200">
                    <BitBhSliderRange class="inset-0 rounded-full bg-blue-600" />
                </BitBhSliderTrack>
                <BitBhSliderThumb aria-label="Minimum price"
                               class="top-1/2 -mt-2.5 block size-5 cursor-grab rounded-full border-2 border-blue-600 bg-[#fff] shadow outline-none transition-shadow hover:ring-4 hover:ring-blue-600/15 focus-visible:ring-4 focus-visible:ring-blue-600/35 data-dragging:cursor-grabbing data-dragging:ring-[6px] data-dragging:ring-blue-600/20" />
                <BitBhSliderThumb aria-label="Maximum price"
                               class="top-1/2 -mt-2.5 block size-5 cursor-grab rounded-full border-2 border-blue-600 bg-[#fff] shadow outline-none transition-shadow hover:ring-4 hover:ring-blue-600/15 focus-visible:ring-4 focus-visible:ring-blue-600/35 data-dragging:cursor-grabbing data-dragging:ring-[6px] data-dragging:ring-blue-600/20" />
            </BitBhSlider>
            <p class="m-0 text-sm text-zinc-500">Price: <strong class="font-semibold tabular-nums text-zinc-900">@($"${price[0]:N0} – ${price[1]:N0}")</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Tick marks" Code="@_marksCode">
    <Description>
        <code>BitBhSliderMarker</code> puts a tick - with an optional label - at a <code>Value</code> along the track,
        positioned like a thumb and hidden from screen readers (the thumb announces the value). It carries
        <code>data-in-range</code> inside the filled range and <code>data-state="under-value"</code>,
        <code>"at-value"</code> or <code>"over-value"</code>.
    </Description>
    <LiveContent>
        <div class="grid w-full gap-4">
            <BitBhSlider @bind-Value="zoom" Step="25" ValueText="@(v => $"{v}%")"
                      class="relative mb-7 flex h-5 w-full max-w-xs cursor-pointer touch-none select-none items-center">
                <BitBhSliderTrack class="h-1.5 rounded-full bg-zinc-200">
                    <BitBhSliderRange class="inset-0 rounded-full bg-blue-600" />
                    @foreach (var mark in marks)
                    {
                        <BitBhSliderMarker Value="mark"
                                        class="top-full mt-2 whitespace-nowrap text-xs text-zinc-600 before:absolute before:bottom-[calc(100%+2px)] before:left-1/2 before:h-1.5 before:w-px before:bg-zinc-400 before:content-[''] data-in-range:text-zinc-900 data-[state=at-value]:font-semibold">@mark%</BitBhSliderMarker>
                    }
                </BitBhSliderTrack>
                <BitBhSliderThumb aria-label="Zoom"
                               class="top-1/2 -mt-2.5 block size-5 cursor-grab rounded-full border-2 border-blue-600 bg-[#fff] shadow outline-none transition-shadow hover:ring-4 hover:ring-blue-600/15 focus-visible:ring-4 focus-visible:ring-blue-600/35 data-dragging:cursor-grabbing data-dragging:ring-[6px] data-dragging:ring-blue-600/20" />
            </BitBhSlider>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Step, LargeStep and a thumb Template" Code="@_stepCode">
    <Description>
        <code>Step="0.5"</code> snaps values to half degrees; <code>LargeStep="5"</code> sets the
        <kbd>PageUp</kbd> / <kbd>PageDown</kbd> / <kbd>Shift</kbd>+arrow jump (default: a tenth of the range).
        <code>BitBhSliderThumb</code>'s <code>Template</code> receives the thumb's value — used here
        for a value bubble.
    </Description>
    <LiveContent>
        <div class="grid w-full gap-4">
            <BitBhSlider @bind-Value="temperature" Min="10" Max="30" Step="0.5" LargeStep="5"
                      ValueText="@(v => $"{v:0.0} °C")"
                      class="relative mt-9 flex h-5 w-full max-w-xs cursor-pointer touch-none select-none items-center">
                <BitBhSliderTrack class="h-1.5 rounded-full bg-zinc-200">
                    <BitBhSliderRange class="inset-0 rounded-full bg-blue-600" />
                </BitBhSliderTrack>
                <BitBhSliderThumb aria-label="Thermostat"
                               class="top-1/2 -mt-2.5 block size-5 cursor-grab rounded-full border-2 border-blue-600 bg-[#fff] shadow outline-none transition-shadow hover:ring-4 hover:ring-blue-600/15 focus-visible:ring-4 focus-visible:ring-blue-600/35 data-dragging:cursor-grabbing data-dragging:ring-[6px] data-dragging:ring-blue-600/20">
                    <Template Context="current">
                        <span class="pointer-events-none absolute bottom-[calc(100%_+_0.5rem)] left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-zinc-900 px-1.5 py-0.5 text-xs font-semibold tabular-nums text-zinc-50">@current.ToString("0.0")°</span>
                    </Template>
                </BitBhSliderThumb>
            </BitBhSlider>
            <p class="m-0 text-sm text-zinc-500">Target: <strong class="font-semibold tabular-nums text-zinc-900">@temperature.ToString("0.0") °C</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Vertical orientation" Code="@_verticalCode">
    <Description>
        <code>Orientation="BitBhOrientation.Vertical"</code> measures the pointer along the height and
        sets <code>aria-orientation</code>; <kbd>↑</kbd> / <kbd>→</kbd> increase, <kbd>↓</kbd> /
        <kbd>←</kbd> decrease. Each band is uncontrolled via <code>DefaultValue</code>, with a negative
        <code>Min</code>. The styles lay the root out as a column and center the thumb across the track:
        the CSS version keys them off <code>[data-orientation="vertical"]</code>, the Tailwind version
        applies <code>flex-col</code> and <code>left-1/2 -ml-2.5</code> directly.
    </Description>
    <LiveContent>
        <div class="flex gap-8 px-3 py-2">
            @foreach (var band in bands)
            {
                <div class="grid justify-items-center gap-3">
                    <BitBhSlider Orientation="BitBhOrientation.Vertical" Min="-12" Max="12"
                              DefaultValue="band.Gain" ValueText="@(v => $"{v:+0;-0;0} dB")"
                              class="relative flex h-40 w-5 cursor-pointer touch-none select-none flex-col items-center">
                        <BitBhSliderTrack class="w-1.5 rounded-full bg-zinc-200">
                            <BitBhSliderRange class="inset-0 rounded-full bg-blue-600" />
                        </BitBhSliderTrack>
                        <BitBhSliderThumb aria-label="@band.Name"
                                       class="left-1/2 -ml-2.5 block size-5 cursor-grab rounded-full border-2 border-blue-600 bg-[#fff] shadow outline-none transition-shadow hover:ring-4 hover:ring-blue-600/15 focus-visible:ring-4 focus-visible:ring-blue-600/35 data-dragging:cursor-grabbing data-dragging:ring-[6px] data-dragging:ring-blue-600/20" />
                    </BitBhSlider>
                    <span class="text-xs font-medium text-zinc-600" aria-hidden="true">@band.Name</span>
                </div>
            }
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="In a field, with OnValueCommit" Code="@_fieldCode">
    <Description>
        Inside a <code>BitBhField</code> the thumb is labelled by <code>BitBhLabel</code>
        (<code>aria-labelledby</code>) and described by <code>BitBhDescription</code>; clicking the
        label focuses the thumb. <code>@@bind-Value</code> updates live while dragging, whereas
        <code>OnValueCommit</code> fires once on pointer up or per key press — the place to save.
    </Description>
    <LiveContent>
        <div class="grid w-full gap-4">
            <BitBhField class="grid w-full max-w-xs gap-2.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900">Brightness</BitBhLabel>
                <BitBhSlider @bind-Value="brightness" OnValueCommit="v => committed = v[0]"
                          ValueText="@(v => $"{v}%")"
                          class="relative flex h-5 w-full cursor-pointer touch-none select-none items-center">
                    <BitBhSliderTrack class="h-1.5 rounded-full bg-zinc-200">
                        <BitBhSliderRange class="inset-0 rounded-full bg-blue-600" />
                    </BitBhSliderTrack>
                    <BitBhSliderThumb class="top-1/2 -mt-2.5 block size-5 cursor-grab rounded-full border-2 border-blue-600 bg-[#fff] shadow outline-none transition-shadow hover:ring-4 hover:ring-blue-600/15 focus-visible:ring-4 focus-visible:ring-blue-600/35 data-dragging:cursor-grabbing data-dragging:ring-[6px] data-dragging:ring-blue-600/20" />
                </BitBhSlider>
                <BitBhDescription class="m-0 text-xs text-zinc-500">Saved when you release the thumb or press a key.</BitBhDescription>
            </BitBhField>
            <p class="m-0 text-sm text-zinc-500">
                Live: <strong class="font-semibold tabular-nums text-zinc-900">@brightness%</strong> · Committed: <strong class="font-semibold tabular-nums text-zinc-900">@committed%</strong>
            </p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabled" Code="@_disabledCode">
    <Description>
        <code>Disabled="true"</code> ignores pointer and keys, takes the thumbs out of the tab order
        (<code>tabindex="-1"</code>, <code>aria-disabled="true"</code>) and adds
        <code>data-disabled</code> to every part: the CSS version styles them with
        <code>[data-disabled]</code> selectors, the Tailwind version with the
        <code>data-disabled:</code> variant. The range below is uncontrolled via
        <code>DefaultValues</code>.
    </Description>
    <LiveContent>
        <div class="grid w-full gap-4">
            <BitBhSlider DefaultValue="40" Disabled="true"
                      class="relative flex h-5 w-full max-w-xs cursor-pointer touch-none select-none items-center data-disabled:cursor-not-allowed data-disabled:opacity-50">
                <BitBhSliderTrack class="h-1.5 rounded-full bg-zinc-200">
                    <BitBhSliderRange class="inset-0 rounded-full bg-blue-600 data-disabled:bg-zinc-400" />
                </BitBhSliderTrack>
                <BitBhSliderThumb aria-label="Locked volume"
                               class="top-1/2 -mt-2.5 block size-5 rounded-full border-2 border-blue-600 bg-[#fff] shadow outline-none data-disabled:cursor-not-allowed data-disabled:border-zinc-400 data-disabled:shadow-none" />
            </BitBhSlider>

            <BitBhSlider DefaultValues="@(new double[] { 20, 70 })" Disabled="true"
                      class="relative flex h-5 w-full max-w-xs cursor-pointer touch-none select-none items-center data-disabled:cursor-not-allowed data-disabled:opacity-50">
                <BitBhSliderTrack class="h-1.5 rounded-full bg-zinc-200">
                    <BitBhSliderRange class="inset-0 rounded-full bg-blue-600 data-disabled:bg-zinc-400" />
                </BitBhSliderTrack>
                <BitBhSliderThumb aria-label="Locked minimum"
                               class="top-1/2 -mt-2.5 block size-5 rounded-full border-2 border-blue-600 bg-[#fff] shadow outline-none data-disabled:cursor-not-allowed data-disabled:border-zinc-400 data-disabled:shadow-none" />
                <BitBhSliderThumb aria-label="Locked maximum"
                               class="top-1/2 -mt-2.5 block size-5 rounded-full border-2 border-blue-600 bg-[#fff] shadow outline-none data-disabled:cursor-not-allowed data-disabled:border-zinc-400 data-disabled:shadow-none" />
            </BitBhSlider>
        </div>
    </LiveContent>
</TwDemoBlock>

