    private bool confirmOpen;
    private bool formOpen;
    private string? confirmResult;
    private string? formResult;
    private string displayName = "Alice";

    private void HandleCancel() { confirmOpen = false; confirmResult = "Cancelled."; }
    private void HandleDelete() { confirmOpen = false; confirmResult = "Account deleted (just kidding)."; }
