@page "/tw/fieldset"

<PageTitle>Fieldset (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Fieldset</h1>
    <p class="bb-subtitle">
        Group a set of form controls together with a fully accessible but
        much easier-to-style version of the native <code>fieldset</code> and
        <code>legend</code> elements.
    </p>
</div>

<SectionSwitcher Slug="fieldset" />

<TwDemoBlock Title="Basic example" Code="@_basicCode">
    <Description>
        Use <code>BitBhFieldset</code> and <code>BitBhLegend</code> to group a set of form controls
        together with a title. They render the native <code>&lt;fieldset&gt;</code> and
        <code>&lt;legend&gt;</code> elements, and the fieldset also points <code>aria-labelledby</code>
        at the legend, so the group stays named even with the legend inside a header next to a hint, as
        here.
    </Description>
    <LiveContent>
        <BitBhFieldset class="flex w-full max-w-md flex-col gap-5 rounded-lg border border-zinc-200 bg-white p-6 m-0 shadow-sm data-disabled:bg-zinc-50 data-disabled:shadow-none">
            <div class="flex flex-col gap-1 border-b border-zinc-100 pb-3">
                <BitBhLegend class="text-base font-semibold text-zinc-900 data-disabled:text-zinc-500">Shipping details</BitBhLegend>
                <p class="m-0 text-sm text-zinc-500">Where should we deliver your order?</p>
            </div>

            <BitBhField class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Street address</BitBhLabel>
                <BitBhInput name="address" placeholder="123 Main St"
                         class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-100 data-disabled:text-zinc-500 data-disabled:cursor-not-allowed" />
            </BitBhField>
            <BitBhField class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Country</BitBhLabel>
                <div class="relative">
                    <BitBhSelect name="country"
                              class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-100 data-disabled:text-zinc-500 data-disabled:cursor-not-allowed w-full appearance-none pr-8">
                        <option>Canada</option>
                        <option>Mexico</option>
                        <option>United States</option>
                    </BitBhSelect>
                    <svg aria-hidden="true" viewBox="0 0 16 16" class="pointer-events-none absolute top-1/2 right-2.5 size-4 -translate-y-1/2 text-zinc-500"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
            </BitBhField>
            <BitBhField class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Delivery notes</BitBhLabel>
                <BitBhTextarea name="notes" rows="3" placeholder="Leave at front door…"
                            class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-100 data-disabled:text-zinc-500 data-disabled:cursor-not-allowed resize-y" />
            </BitBhField>
        </BitBhFieldset>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabling a fieldset" Code="@_disabledCode">
    <Description>
        Set <code>Disabled="true"</code> on the <code>BitBhFieldset</code> to disable every form control
        inside. The native <code>disabled</code> attribute on the fieldset prevents interaction, and the
        fieldset, legend, and all nested fields and controls receive <code>data-disabled</code>: the CSS
        version styles them with <code>[data-disabled]</code> selectors, the Tailwind version with the
        <code>data-disabled:</code> variant.
    </Description>
    <LiveContent>
        <BitBhFieldset Disabled="true" class="flex w-full max-w-md flex-col gap-5 rounded-lg border border-zinc-200 bg-white p-6 m-0 shadow-sm data-disabled:bg-zinc-50 data-disabled:shadow-none">
            <div class="flex flex-col gap-1 border-b border-zinc-100 pb-3">
                <BitBhLegend class="text-base font-semibold text-zinc-900 data-disabled:text-zinc-500">Account (locked)</BitBhLegend>
                <p class="m-0 text-sm text-zinc-500">Verify your email to edit these fields.</p>
            </div>

            <BitBhField class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Username</BitBhLabel>
                <BitBhInput type="text" value="alice"
                         class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-100 data-disabled:text-zinc-500 data-disabled:cursor-not-allowed" />
            </BitBhField>
            <BitBhField class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Email</BitBhLabel>
                <BitBhInput type="email" value="alice@example.com"
                         class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-100 data-disabled:text-zinc-500 data-disabled:cursor-not-allowed" />
            </BitBhField>
        </BitBhFieldset>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Toggling at runtime" Code="@_toggleCode">
    <Description>
        Bind <code>Disabled</code> to a state value to enable or disable the
        entire group dynamically. Every nested input reflects the change
        through both the native <code>disabled</code> attribute and
        <code>data-disabled</code>.
    </Description>
    <LiveContent>
        <div class="flex w-full max-w-md flex-col gap-3">
            <div class="flex items-center justify-between rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2">
                <span class="@($"inline-flex items-center gap-2 text-sm font-medium {(_disabled ? "text-zinc-500" : "text-emerald-700")}")">
                    <span class="@($"h-2 w-2 rounded-full {(_disabled ? "bg-zinc-400" : "bg-emerald-500")}")"></span>
                    @(_disabled ? "Read-only" : "Editing")
                </span>
                <BitBhButton class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium hover:bg-zinc-100"
                          OnClick="@(() => _disabled = !_disabled)">
                    @(_disabled ? "Enable" : "Disable")
                </BitBhButton>
            </div>

            <BitBhFieldset Disabled="_disabled" class="flex w-full max-w-md flex-col gap-5 rounded-lg border border-zinc-200 bg-white p-6 m-0 shadow-sm data-disabled:bg-zinc-50 data-disabled:shadow-none">
                <div class="flex flex-col gap-1 border-b border-zinc-100 pb-3">
                    <BitBhLegend class="text-base font-semibold text-zinc-900 data-disabled:text-zinc-500">Profile</BitBhLegend>
                    <p class="m-0 text-sm text-zinc-500">Shown publicly on your profile page.</p>
                </div>
                <BitBhField class="flex w-full flex-col gap-1.5">
                    <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Display name</BitBhLabel>
                    <BitBhInput type="text" placeholder="Alice Anderson"
                             class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-100 data-disabled:text-zinc-500 data-disabled:cursor-not-allowed" />
                </BitBhField>
                <BitBhField class="flex w-full flex-col gap-1.5">
                    <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Bio</BitBhLabel>
                    <BitBhTextarea rows="2" placeholder="Tell us about yourself…"
                                class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-100 data-disabled:text-zinc-500 data-disabled:cursor-not-allowed resize-y" />
                </BitBhField>
            </BitBhFieldset>
        </div>
    </LiveContent>
</TwDemoBlock>

