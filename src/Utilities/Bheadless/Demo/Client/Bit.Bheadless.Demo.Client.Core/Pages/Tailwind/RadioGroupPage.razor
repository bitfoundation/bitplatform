@page "/tw/radiogroup"

<PageTitle>Radio Group (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Radio Group</h1>
    <p class="bb-subtitle">An accessible single-select group with roving tabindex and full keyboard support.</p>
</div>

<SectionSwitcher Slug="radiogroup" />

<TwDemoBlock Title="Basic Radio Group" Code="@_basicCode">
    <Description>
        Click a radio or use the arrow keys to navigate and select. Disabled radios are
        skipped. <code>aria-checked</code>, <code>role="radiogroup"</code>, and
        <code>role="radio"</code> are wired automatically.
    </Description>
    <LiveContent>
        <BitBhRadioGroup DefaultValue="medium" class="flex flex-col gap-2.5 data-orientation-horizontal:flex-row data-orientation-horizontal:gap-5">
            <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                <BitBhRadio Value="small"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
                <span>Small</span>
            </label>
            <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                <BitBhRadio Value="medium"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
                <span>Medium</span>
            </label>
            <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                <BitBhRadio Value="large"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
                <span>Large</span>
            </label>
        </BitBhRadioGroup>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Horizontal Orientation" Code="@_horizontalCode">
    <Description>
        Set <code>Vertical="false"</code> to lay radios out horizontally. The group then
        emits <code>aria-orientation</code> / <code>data-orientation="horizontal"</code>;
        all four arrow keys navigate in either orientation. The CSS version lays the row out
        with a <code>[data-orientation="horizontal"]</code> selector, the Tailwind version
        with the <code>data-orientation-horizontal:</code> variant.
    </Description>
    <LiveContent>
        <BitBhRadioGroup Vertical="false" DefaultValue="card" class="flex flex-col gap-2.5 data-orientation-horizontal:flex-row data-orientation-horizontal:gap-5">
            <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                <BitBhRadio Value="card"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
                <span>Card</span>
            </label>
            <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                <BitBhRadio Value="bank"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
                <span>Bank</span>
            </label>
            <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                <BitBhRadio Value="paypal"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
                <span>PayPal</span>
            </label>
        </BitBhRadioGroup>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabled Radio" Code="@_disabledCode">
    <Description>
        Set <code>Disabled="true"</code> on individual radios. Arrow-key navigation
        skips disabled options. Set <code>Disabled="true"</code> on the root group to
        disable everything at once.
    </Description>
    <LiveContent>
        <BitBhRadioGroup DefaultValue="standard" class="flex flex-col gap-2.5 data-orientation-horizontal:flex-row data-orientation-horizontal:gap-5">
            <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                <BitBhRadio Value="standard"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
                <span>Standard shipping (3–5 days)</span>
            </label>
            <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                <BitBhRadio Value="express"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
