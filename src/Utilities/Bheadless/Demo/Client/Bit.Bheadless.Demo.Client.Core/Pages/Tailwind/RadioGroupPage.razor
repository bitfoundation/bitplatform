<TwDemoBlock Title="Form Submission" Code="@_formCode">
    <Description>
        Set <code>Name</code> on the group to render a hidden <code>&lt;input&gt;</code>
        carrying the selected value, so plain HTML form posts include the group's selection.
    </Description>
    <LiveContent>
        <form @onsubmit="HandleFormSubmit" @onsubmit:preventDefault="true" class="flex flex-col items-start gap-3">
            <BitBhRadioGroup Name="size" DefaultValue="m" OnValueChange="v => postedSize = v" class="flex flex-col gap-2.5 data-orientation-horizontal:flex-row data-orientation-horizontal:gap-5">
                <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                    <BitBhRadio Value="s"
                             class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                        <Template Context="r">
                            @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                        </Template>
                    </BitBhRadio>
                    <span>Small</span>
                </label>
                <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                    <BitBhRadio Value="m"
                             class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                        <Template Context="r">
                            @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                        </Template>
                    </BitBhRadio>
                    <span>Medium</span>
                </label>
                <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
                    <BitBhRadio Value="l"
                             class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                        <Template Context="r">
                            @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                        </Template>
                    </BitBhRadio>
                    <span>Large</span>
                </label>
            </BitBhRadioGroup>
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-4 py-2 text-sm font-medium text-white cursor-pointer hover:bg-blue-700">Submit</button>
            @if (lastSubmitted is not null)
            {
                <span class="text-sm text-zinc-500">@lastSubmitted</span>
            }
        </form>
    </LiveContent>
</TwDemoBlock>

