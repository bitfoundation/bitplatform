</TwDemoBlock>

<TwDemoBlock Title="Card-style options" Code="@_cardCode">
    <Description>
        Because the radio is the only interactive element, you can place rich content
        (titles, descriptions, prices) inside the <code>&lt;label&gt;</code> wrapper
        and use the radio's <code>data-state="checked"</code> hook to highlight the selected card.
        The CSS version does it with a <code>:has()</code> selector, the Tailwind version with
        the <code>has-[[data-state=checked]]:</code> variant.
    </Description>
    <LiveContent>
        <BitBhRadioGroup DefaultValue="pro" class="flex flex-col gap-2.5 w-full max-w-md">
            <label class="flex items-center gap-3.5 rounded-lg border border-zinc-200 px-4 py-3.5 cursor-pointer transition-colors has-[[data-state=checked]]:border-blue-600 has-[[data-state=checked]]:bg-blue-50">
                <BitBhRadio Value="free"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
                <div class="flex flex-col gap-0.5">
                    <strong class="text-sm text-zinc-900">Free</strong>
                    <span class="text-xs text-zinc-500">Up to 3 projects.</span>
                </div>
            </label>
            <label class="flex items-center gap-3.5 rounded-lg border border-zinc-200 px-4 py-3.5 cursor-pointer transition-colors has-[[data-state=checked]]:border-blue-600 has-[[data-state=checked]]:bg-blue-50">
                <BitBhRadio Value="pro"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
                <div class="flex flex-col gap-0.5">
                    <strong class="text-sm text-zinc-900">Pro — $9 / mo</strong>
                    <span class="text-xs text-zinc-600">Unlimited projects, priority support.</span>
                </div>
            </label>
            <label class="flex items-center gap-3.5 rounded-lg border border-zinc-200 px-4 py-3.5 cursor-pointer transition-colors has-[[data-state=checked]]:border-blue-600 has-[[data-state=checked]]:bg-blue-50">
                <BitBhRadio Value="team"
                         class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded-full border border-zinc-500 bg-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="r">
                        @if (r.IsChecked) { <span class="h-2 w-2 rounded-full bg-blue-600"></span> }
                    </Template>
                </BitBhRadio>
                <div class="flex flex-col gap-0.5">
                    <strong class="text-sm text-zinc-900">Team — $29 / mo</strong>
                    <span class="text-xs text-zinc-500">For groups, with shared workspaces.</span>
                </div>
            </label>
        </BitBhRadioGroup>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Controlled" Code="@_controlledCode">
    <Description>
        Drive selection externally with <code>Value</code> and <code>OnValueChange</code>.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-4 w-full">
            <div class="flex flex-wrap items-center gap-3">
                <BitBhButton OnClick='() => selectedColor = "red"'   class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100">Red</BitBhButton>
                <BitBhButton OnClick='() => selectedColor = "green"' class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100">Green</BitBhButton>
                <BitBhButton OnClick='() => selectedColor = "blue"'  class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100">Blue</BitBhButton>
                <span class="text-sm text-zinc-500">Selected: <strong class="text-zinc-900">@(selectedColor ?? "(none)")</strong></span>
            </div>
            <BitBhRadioGroup Value="@selectedColor" OnValueChange="v => selectedColor = v" class="flex flex-col gap-2.5 data-orientation-horizontal:flex-row data-orientation-horizontal:gap-5">
                <label class="inline-flex items-center gap-2.5 cursor-pointer text-sm select-none">
