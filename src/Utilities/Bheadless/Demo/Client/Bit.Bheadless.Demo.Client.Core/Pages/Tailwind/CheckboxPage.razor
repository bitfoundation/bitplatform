@page "/tw/checkbox"

<PageTitle>Checkbox (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Checkbox</h1>
    <p class="bb-subtitle">An accessible tri-state checkbox primitive with full keyboard support and zero visual opinion.</p>
</div>

<SectionSwitcher Slug="checkbox" />

<TwDemoBlock Title="Basic Checkbox (Uncontrolled)" Code="@_basicCode">
    <Description>
        Renders a native <code>&lt;button&gt;</code> with <code>role="checkbox"</code> and
        <code>aria-checked</code>. Click or press Space to toggle.
        <code>DefaultChecked</code> seeds the initial state.
    </Description>
    <LiveContent>
        <BitBhCheckbox aria-label="Remember me" class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-state-indeterminate:bg-blue-600 data-state-indeterminate:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
            <Template Context="c">
                @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
            </Template>
        </BitBhCheckbox>
        <BitBhCheckbox aria-label="Keep me signed in" DefaultChecked="true"
                    class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-state-indeterminate:bg-blue-600 data-state-indeterminate:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
            <Template Context="c">
                @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
            </Template>
        </BitBhCheckbox>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Controlled" Code="@_controlledCode">
    <Description>
        Drive state externally with <code>Checked</code> + <code>OnCheckedChange</code>. The
        "Toggle from outside" button flips it programmatically.
    </Description>
    <LiveContent>
        <div class="flex items-center gap-4">
            <BitBhCheckbox aria-label="Accept the terms" Checked="@acceptedTerms" OnCheckedChange="v => acceptedTerms = v"
                        class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                <Template Context="c">
                    @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                </Template>
            </BitBhCheckbox>
            <span class="text-sm text-zinc-500">
                Terms accepted: <strong class="text-zinc-900">@(acceptedTerms ? "yes" : "no")</strong>
            </span>
            <BitBhButton OnClick="() => acceptedTerms = !acceptedTerms"
                      class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100">
                Toggle from outside
            </BitBhButton>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabled" Code="@_disabledCode">
    <Description>
        Set <code>Disabled="true"</code> to block interaction. Receives the native
        <code>disabled</code> attribute and a <code>data-disabled</code> hook: the CSS version styles it
        with a <code>[data-disabled]</code> selector, the Tailwind version with the
        <code>data-disabled:</code> variant.
    </Description>
    <LiveContent>
        <BitBhCheckbox aria-label="Unavailable option" Disabled="true"
                    class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
            <Template Context="c">
                @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
            </Template>
        </BitBhCheckbox>
        <BitBhCheckbox aria-label="Locked option" DefaultChecked="true" Disabled="true"
                    class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
            <Template Context="c">
                @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
            </Template>
        </BitBhCheckbox>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Indeterminate (Select All pattern)" Code="@_indeterminateCode">
    <Description>
        Setting <code>Indeterminate="true"</code> emits <code>aria-checked="mixed"</code>
        and <code>data-state="indeterminate"</code>. The classic use-case is a "select all"
        checkbox that reflects partial child selection. Clicking an indeterminate checkbox
        advances it to checked. The CSS version styles the mixed state with a
        <code>[data-state="indeterminate"]</code> selector, the Tailwind version with the
        <code>data-state-indeterminate:</code> variant.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-2">
            <label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
                <BitBhCheckbox Checked="@SelectAllChecked" Indeterminate="@SelectAllIndeterminate" OnCheckedChange="HandleSelectAll"
                            class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-state-indeterminate:bg-blue-600 data-state-indeterminate:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="c">
                        @if (c.IsIndeterminate) { <span class="text-base leading-none font-bold">–</span> }
                        else if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                    </Template>
                </BitBhCheckbox>
                <strong>Select all</strong>
            </label>
            <div class="flex flex-col gap-1.5 ml-6">
                @for (var i = 0; i < items.Length; i++)
                {
                    var captured = i;
                    <label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
                        <BitBhCheckbox Checked="@items[captured]" OnCheckedChange="v => HandleItemChange(captured, v)"
                                    class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                            <Template Context="c">
                                @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                            </Template>
                        </BitBhCheckbox>
                        <span>Item @(captured + 1)</span>
                    </label>
                }
            </div>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="With label" Code="@_labelCode">
    <Description>
        Wrap the checkbox in a <code>&lt;label&gt;</code> so clicking the text toggles the
        checkbox — standard HTML behaviour.
    </Description>
    <LiveContent>
        <label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
            <BitBhCheckbox class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                <Template Context="c">
                    @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                </Template>
            </BitBhCheckbox>
            <span>Send me product updates</span>
        </label>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Form Submission" Code="@_formCode">
    <Description>
        Set <code>Name</code> to render an adjacent <code>&lt;input type="hidden"&gt;</code>
        so the checkbox state participates in plain form posts. The hidden input is only
        present while the checkbox is checked and enabled, mirroring native checkbox behaviour.
    </Description>
    <LiveContent>
        <form @onsubmit="HandleFormSubmit" @onsubmit:preventDefault="true"
              class="flex flex-col items-start gap-2">
            <label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
                <BitBhCheckbox Name="agree" Value="yes" OnCheckedChange="v => agreeChecked = v"
                            class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                    <Template Context="c">
                        @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                    </Template>
                </BitBhCheckbox>
                <span>I agree to the terms</span>
            </label>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-3 py-1.5 text-sm font-medium text-white cursor-pointer hover:bg-blue-700">
                Submit
            </button>
            @if (lastSubmitted is not null)
            {
                <span class="text-sm text-zinc-500">@lastSubmitted</span>
            }
        </form>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Group with select all" Code="@_groupCode">
    <Description>
        <code>BitBhCheckboxGroup</code> binds one collection with <code>@@bind-Values</code> and
        renders <code>role="group"</code>; each <code>BitBhCheckbox</code> with a <code>Value</code>
        toggles that value. <code>SelectAll="true"</code> turns a checkbox into the tri-state
        parent — checked when every value is selected, <code>aria-checked="mixed"</code> /
        <code>data-state="indeterminate"</code> when only some are. <code>BitBhCheckboxIndicator</code>
        renders only while its checkbox is checked or mixed, and mirrors its <code>data-state</code>.
        The CSS version styles the box from the checkbox's <code>[data-state]</code> and draws the
        ✓ / – with <code>::before</code> on the indicator; the Tailwind version marks each checkbox as a
        <code>group</code>, styles the box with <code>group-data-state-checked:</code> /
        <code>group-data-state-indeterminate:</code> and writes the glyph inside the indicator.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-4">
            <BitBhCheckboxGroup @bind-Values="toppings" aria-label="Pizza toppings" class="flex flex-col gap-2">
                <BitBhCheckbox SelectAll="true"
                            class="group inline-flex items-center gap-2 self-start rounded text-sm font-semibold text-zinc-900 cursor-pointer select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                    <span class="inline-flex h-[1.15rem] w-[1.15rem] shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white transition-colors group-hover:border-zinc-600 group-data-state-checked:border-blue-600 group-data-state-checked:bg-blue-600 group-data-state-indeterminate:border-blue-600 group-data-state-indeterminate:bg-blue-600">
                        <BitBhCheckboxIndicator class="text-xs font-bold leading-none">
                            <Template Context="state">@(state.IsIndeterminate ? "–" : "✓")</Template>
                        </BitBhCheckboxIndicator>
                    </span>
                    All toppings
                </BitBhCheckbox>
                <div class="ml-6 flex flex-col gap-1.5">
                    @foreach (var topping in allToppings)
                    {
                        <BitBhCheckbox Value="@topping"
                                    class="group inline-flex items-center gap-2 self-start rounded text-sm text-zinc-900 cursor-pointer select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                            <span class="inline-flex h-[1.15rem] w-[1.15rem] shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white transition-colors group-hover:border-zinc-600 group-data-state-checked:border-blue-600 group-data-state-checked:bg-blue-600">
                                <BitBhCheckboxIndicator class="text-xs font-bold leading-none">✓</BitBhCheckboxIndicator>
                            </span>
                            @topping
                        </BitBhCheckbox>
                    }
                </div>
            </BitBhCheckboxGroup>

            <span class="text-sm text-zinc-500">
                Values: <strong class="text-zinc-900">@(toppings.Count == 0 ? "(none)" : string.Join(", ", toppings))</strong>
            </span>
        </div>
    </LiveContent>
</TwDemoBlock>

@code {
    private bool acceptedTerms;
    private string[] allToppings = new[] { "Cheese", "Mushrooms", "Olives", "Peppers" };
    private IReadOnlyCollection<string> toppings = new[] { "Cheese", "Olives" };
    private bool[] items = new[] { false, false, false };
    private string? lastSubmitted;
    private bool agreeChecked;

    private bool SelectAllChecked => items.All(x => x);
    private bool SelectAllIndeterminate => items.Any(x => x) && !SelectAllChecked;

    private void HandleSelectAll(bool checkAll)
    {
        for (var i = 0; i < items.Length; i++)
            items[i] = checkAll;
    }

    private void HandleItemChange(int index, bool value) => items[index] = value;

    private void HandleFormSubmit() =>
        // The hidden input exists only while the box is checked.
        lastSubmitted = agreeChecked ? "Submitted: the form posts agree=yes" : "Submitted: nothing is posted for agree (unchecked)";

    private const string _groupCode = """
<BitBhCheckboxGroup @bind-Values="toppings" aria-label="Pizza toppings" class="flex flex-col gap-2">
    @* Tri-state parent: checked / mixed / unchecked from the group's values *@
    <BitBhCheckbox SelectAll="true"
                class="group inline-flex items-center gap-2 self-start rounded text-sm font-semibold cursor-pointer select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
        <span class="inline-flex h-[1.15rem] w-[1.15rem] shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white transition-colors group-hover:border-zinc-600 group-data-state-checked:border-blue-600 group-data-state-checked:bg-blue-600 group-data-state-indeterminate:border-blue-600 group-data-state-indeterminate:bg-blue-600">
            <BitBhCheckboxIndicator class="text-xs font-bold leading-none">
                <Template Context="state">@(state.IsIndeterminate ? "–" : "✓")</Template>
            </BitBhCheckboxIndicator>
        </span>
        All toppings
    </BitBhCheckbox>

    <div class="ml-6 flex flex-col gap-1.5">
        @foreach (var topping in allToppings)
        {
            <BitBhCheckbox Value="@topping"
                        class="group inline-flex items-center gap-2 self-start rounded text-sm cursor-pointer select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                <span class="inline-flex h-[1.15rem] w-[1.15rem] shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white transition-colors group-hover:border-zinc-600 group-data-state-checked:border-blue-600 group-data-state-checked:bg-blue-600">
                    <BitBhCheckboxIndicator class="text-xs font-bold leading-none">✓</BitBhCheckboxIndicator>
                </span>
                @topping
            </BitBhCheckbox>
        }
    </div>
</BitBhCheckboxGroup>

<span class="text-sm text-zinc-500">
    Values: <strong class="text-zinc-900">@(toppings.Count == 0 ? "(none)" : string.Join(", ", toppings))</strong>
</span>

@code {
    private string[] allToppings = new[] { "Cheese", "Mushrooms", "Olives", "Peppers" };
    private IReadOnlyCollection<string> toppings = new[] { "Cheese", "Olives" };
}
""";

    private const string _basicCode = """
<BitBhCheckbox aria-label="Remember me" class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-state-indeterminate:bg-blue-600 data-state-indeterminate:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
