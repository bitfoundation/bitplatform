    private const string Trigger = "ms-auto inline-grid size-8 cursor-pointer place-items-center rounded-md text-zinc-700 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-state-open:bg-zinc-100 disabled:cursor-not-allowed";
    private const string Popover = "z-30 rounded-xl shadow-xl outline-none";
    private const string Root = "inline-grid gap-3 rounded-xl border border-zinc-200 bg-white p-3 text-zinc-900";
    private const string Nav = "inline-grid size-8 cursor-pointer place-items-center rounded-lg text-lg text-zinc-700 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-disabled:cursor-not-allowed data-disabled:text-zinc-400 data-disabled:hover:bg-transparent";
    private const string Grid = "border-collapse [&_td]:p-px [&_th]:w-9 [&_th]:pb-1 [&_th]:text-xs [&_th]:font-medium [&_th]:text-zinc-500";
    private const string Cell = "size-9 cursor-pointer select-none rounded-lg text-center text-sm tabular-nums text-zinc-900 outline-none [&[data-hover]:not([data-selected])]:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-today:font-bold data-today:underline data-today:decoration-2 data-today:underline-offset-4 data-selected:bg-blue-600 data-selected:text-white data-unavailable:cursor-not-allowed data-unavailable:text-zinc-500 data-unavailable:line-through data-disabled:cursor-not-allowed data-disabled:text-zinc-500";

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _basicCode = """
<BitBhField>
    <BitBhLabel class="mb-1.5 block text-sm font-semibold text-zinc-900">Departure</BitBhLabel>
    <BitBhDatePicker @bind-Value="departure">
        <BitBhDatePickerGroup class="inline-flex items-center gap-1 rounded-lg border border-zinc-500 bg-white py-1 pe-1 ps-2.5 tabular-nums text-zinc-900 hover:border-zinc-600 data-[focused]:outline-2 data-[focused]:outline-offset-2 data-[focused]:outline-blue-600 data-state-open:outline-2 data-state-open:outline-offset-2 data-state-open:outline-blue-600 data-[invalid]:border-red-600 [&_[data-type]]:rounded [&_[data-type]]:px-0.5 [&_[data-type=literal]]:px-0 [&_[data-type=literal]]:text-zinc-500 [&_[role=spinbutton]]:inline-block [&_[role=spinbutton]]:min-h-6 [&_[role=spinbutton]]:min-w-6 [&_[role=spinbutton]]:text-center [&_[role=spinbutton]]:leading-6 [&_[role=spinbutton]]:outline-none [&_[role=spinbutton]:focus]:bg-blue-600 [&_[role=spinbutton]:focus]:text-white [&_[data-placeholder]]:text-zinc-500">
            <BitBhDateFieldSegments />
