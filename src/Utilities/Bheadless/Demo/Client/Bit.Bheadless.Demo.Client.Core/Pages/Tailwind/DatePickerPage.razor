@page "/tw/date-picker"
@using System.ComponentModel.DataAnnotations
@using System.Globalization

<PageTitle>Date Picker (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Date Picker</h1>
    <p class="bb-subtitle">A segmented date input with a button that opens a calendar in a popover: type the date, or pick it.</p>
</div>

<SectionSwitcher Slug="date-picker" />

<TwDemoBlock Title="Date picker" Code="@_basicCode">
    <Description>
        The segments type and step like a date field; the trigger opens a non-modal dialog anchored under the group, named by
        the field's label, with the focus on the selected date. Picking a date, <kbd>Escape</kbd>, a click outside or tabbing
        away close it and the focus returns to the button. The group gets <code>data-state-open:</code> while it is open.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-end gap-6">
            <BitBhField>
                <BitBhLabel class="mb-1.5 block text-sm font-semibold text-zinc-900">Departure</BitBhLabel>
                <BitBhDatePicker @bind-Value="departure" Culture="DemoDateCultures.EnUs">
                    <BitBhDatePickerGroup class="@Group">
                        <BitBhDateFieldSegments />
                        <BitBhDatePickerTrigger class="@Trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="@Popover">
                        <BitBhCalendar class="@Root">
                            <div class="flex items-center gap-2">
                                <BitBhCalendarPrevious class="@Nav">‹</BitBhCalendarPrevious>
                                <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                                <BitBhCalendarNext class="@Nav">›</BitBhCalendarNext>
                            </div>
                            <BitBhCalendarGrid class="@Grid">
                                <BitBhCalendarCell Day="context" class="@Cell" />
                            </BitBhCalendarGrid>
                        </BitBhCalendar>
                    </BitBhDatePickerContent>
                </BitBhDatePicker>
            </BitBhField>
            <p class="m-0 text-sm text-zinc-500">Value: <strong class="font-semibold text-zinc-900">@(departure?.ToString("D", DemoDateCultures.EnUs) ?? "none")</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Limits and unavailable dates" Code="@_limitsCode">
    <Description>
        <code>Min</code>, <code>Max</code> and <code>IsDateUnavailable</code> reach the calendar; a typed date that breaks them
        marks the picker invalid (<code>data-[invalid]:</code>) — type a Saturday to see it.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-end gap-6">
            <BitBhField>
                <BitBhLabel class="mb-1.5 block text-sm font-semibold text-zinc-900">Delivery</BitBhLabel>
                <BitBhDatePicker @bind-Value="delivery" Min="today" Max="today.AddMonths(3)" IsDateUnavailable="IsWeekend"
                                 Culture="DemoDateCultures.EnUs">
                    <BitBhDatePickerGroup class="@Group">
                        <BitBhDateFieldSegments />
                        <BitBhDatePickerTrigger class="@Trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="@Popover">
                        <BitBhCalendar class="@Root">
                            <div class="flex items-center gap-2">
                                <BitBhCalendarPrevious class="@Nav">‹</BitBhCalendarPrevious>
                                <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                                <BitBhCalendarNext class="@Nav">›</BitBhCalendarNext>
                            </div>
                            <BitBhCalendarGrid class="@Grid">
                                <BitBhCalendarCell Day="context" class="@Cell" />
                            </BitBhCalendarGrid>
                        </BitBhCalendar>
                    </BitBhDatePickerContent>
                </BitBhDatePicker>
                <BitBhDescription class="mt-1.5 text-xs text-zinc-500">Weekdays in the next three months.</BitBhDescription>
            </BitBhField>
            <p class="m-0 text-sm text-zinc-500">Value: <strong class="font-semibold text-zinc-900">@(delivery?.ToString("D", DemoDateCultures.EnUs) ?? "none")</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="In a German form" Code="@_formCode">
    <Description>
        <code>@@bind-Value</code> joins <code>EditForm</code> validation; with a German <code>Culture</code> the segments read
        <code>dd.MM.yyyy</code> and the calendar's weeks start on Monday.
    </Description>
    <LiveContent>
        <EditForm Model="form" OnValidSubmit="() => sent = form.Birthday">
            <DataAnnotationsValidator />
            <BitBhField>
                <BitBhLabel class="mb-1.5 block text-sm font-semibold text-zinc-900">Geburtstag</BitBhLabel>
                <BitBhDatePicker @bind-Value="form.Birthday" Max="today" Name="birthday" Culture="DemoDateCultures.DeDe">
                    <BitBhDatePickerGroup class="@Group">
                        <BitBhDateFieldSegments />
                        <BitBhDatePickerTrigger aria-label="Datum wählen" class="@Trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="@Popover">
                        <BitBhCalendar class="@Root">
                            <div class="flex items-center gap-2">
                                <BitBhCalendarPrevious aria-label="Vorheriger Monat" class="@Nav">‹</BitBhCalendarPrevious>
                                <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                                <BitBhCalendarNext aria-label="Nächster Monat" class="@Nav">›</BitBhCalendarNext>
                            </div>
                            <BitBhCalendarGrid Context="day" class="@Grid">
                                <BitBhCalendarCell Day="day" class="@Cell" />
                            </BitBhCalendarGrid>
                        </BitBhCalendar>
                    </BitBhDatePickerContent>
                </BitBhDatePicker>
                <BitBhErrorMessage class="mt-1.5 text-xs text-red-700" />
            </BitBhField>
            <button type="submit" class="mt-3 cursor-pointer rounded-lg bg-blue-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-blue-700">Senden</button>
            @if (sent is { } birthday)
            {
                <p class="m-0 mt-2 text-sm text-zinc-500">Gesendet: <strong class="text-zinc-900">@birthday.ToString("D", DemoDateCultures.DeDe)</strong></p>
            }
        </EditForm>
    </LiveContent>
</TwDemoBlock>

@code {
    private static readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? departure;
    private DateOnly? delivery;
    private readonly BirthdayForm form = new();
    private DateOnly? sent;

    private static bool IsWeekend(DateOnly d) => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    private sealed class BirthdayForm
    {
        [Required(ErrorMessage = "Bitte ein Datum eingeben.")]
        public DateOnly? Birthday { get; set; }
    }

    private static readonly RenderFragment CalendarIcon =
        @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-[1.1rem]">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
        </svg>;

    // The utilities the live samples share (the Razor tabs show them inline).
