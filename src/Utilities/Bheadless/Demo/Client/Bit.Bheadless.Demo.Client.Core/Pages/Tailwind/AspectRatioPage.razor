@page "/tw/aspect-ratio"

<PageTitle>Aspect Ratio (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Aspect Ratio</h1>
    <p class="bb-subtitle">Displays content within a desired ratio, regardless of the content's intrinsic size.</p>
</div>

<SectionSwitcher Slug="aspect-ratio" />

<TwDemoBlock Title="Basic (16 / 9)" Code="@_basicCode">
    <Description>
        Wrap any content in <code>BitBhAspectRatio</code> and set <code>Ratio</code> to the
        desired <code>width / height</code>. The image fills the box at a constant 16:9
        ratio no matter how wide the column gets. Your <code>class</code> and <code>style</code>
        go on the inner element and merge with the component's positioning styles.
    </Description>
    <LiveContent>
        <div class="w-full max-w-md">
            <BitBhAspectRatio Ratio="16d / 9d" class="overflow-hidden rounded-xl shadow-md">
                <img class="h-full w-full object-cover"
                     src="https://images.unsplash.com/photo-1535025183041-0991a977e25b?w=800&dpr=2&q=80"
                     alt="Landscape photograph" />
            </BitBhAspectRatio>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Square (1 / 1)" Code="@_squareCode">
    <Description>
        The default ratio is <code>1</code> — a perfect square. Useful for avatars and
        thumbnails. You can omit the <code>Ratio</code> parameter entirely.
    </Description>
    <LiveContent>
        <div class="w-48">
            <BitBhAspectRatio class="overflow-hidden rounded-xl shadow-md">
                <img class="h-full w-full object-cover"
                     src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&dpr=2&q=80"
                     alt="Portrait photograph" />
            </BitBhAspectRatio>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Portrait (3 / 4)" Code="@_portraitCode">
    <Description>
        Ratios smaller than <code>1</code> produce taller-than-wide boxes. Here
        <code>3 / 4</code> creates a portrait frame.
    </Description>
    <LiveContent>
        <div class="w-48">
            <BitBhAspectRatio Ratio="3d / 4d" class="overflow-hidden rounded-xl shadow-md">
                <img class="h-full w-full object-cover"
                     src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&dpr=2&q=80"
                     alt="Portrait photograph" />
            </BitBhAspectRatio>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Non-image content" Code="@_contentCode">
    <Description>
        The ratio box isn't limited to images — drop in any content. The inner element
        is absolutely positioned to fill the reserved space, so flex centring works
        directly on the component.
    </Description>
    <LiveContent>
        <div class="w-full max-w-md">
            <BitBhAspectRatio Ratio="2d / 1d"
                           class="flex items-center justify-center rounded-xl bg-linear-to-br from-indigo-500 to-violet-500 text-2xl font-bold tracking-widest text-white">
                <span>2 : 1</span>
            </BitBhAspectRatio>
        </div>
    </LiveContent>
</TwDemoBlock>

@code {
    private const string _basicCode = """
<div class="w-full max-w-md">
    <BitBhAspectRatio Ratio="16d / 9d" class="overflow-hidden rounded-xl shadow-md">
        <img class="h-full w-full object-cover" src="/landscape.jpg" alt="Landscape" />
    </BitBhAspectRatio>
</div>
""";

    private const string _squareCode = """
@* Ratio defaults to 1 (square) — the parameter is optional *@
<div class="w-48">
    <BitBhAspectRatio class="overflow-hidden rounded-xl shadow-md">
        <img class="h-full w-full object-cover" src="/avatar.jpg" alt="Avatar" />
    </BitBhAspectRatio>
</div>
""";

    private const string _portraitCode = """
<div class="w-48">
    <BitBhAspectRatio Ratio="3d / 4d" class="overflow-hidden rounded-xl shadow-md">
        <img class="h-full w-full object-cover" src="/portrait.jpg" alt="Portrait" />
    </BitBhAspectRatio>
</div>
""";

    private const string _contentCode = """
<BitBhAspectRatio Ratio="2d / 1d"
               class="flex items-center justify-center rounded-xl bg-linear-to-br from-indigo-500 to-violet-500 text-2xl font-bold tracking-widest text-white">
    <span>2 : 1</span>
</BitBhAspectRatio>
""";
}
