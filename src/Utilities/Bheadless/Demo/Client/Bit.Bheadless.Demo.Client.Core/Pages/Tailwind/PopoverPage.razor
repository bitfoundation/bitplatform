@page "/tw/popover"

<PageTitle>Popover — bit Bheadless · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Popover</h1>
        <p class="mt-2 text-zinc-500">Non-modal floating panel with focus management and group coordination.</p>
        <TwSectionSwitcher Slug="popover" />
    </header>

    <TwDemoBlock Title="Basic Popover" Code="@_basicCode">
        <Description>Click to open. Escape or outside click closes; focus returns to the button.</Description>
        <LiveContent>
            <BitBhPopover class="relative inline-block">
                <BitBhPopoverButton class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600">
                    <Template Context="b">
                        Learn more
                        <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                    </Template>
                </BitBhPopoverButton>
                <BitBhPopoverPanel class="absolute top-[calc(100%+0.5rem)] left-0 z-30 min-w-64 rounded-lg border border-zinc-200 bg-white p-4 shadow-lg flex flex-col gap-2.5">
                    <h3 class="text-sm font-semibold text-zinc-900 m-0">bit Bheadless</h3>
                    <p class="text-sm text-zinc-500 m-0">A headless component library for Blazor. Zero styles, full accessibility, complete control over your design.</p>
                    <a href="https://github.com/bitfoundation/bitplatform/tree/develop/src/Utilities/Bheadless" target="_blank" class="text-sm text-blue-600 no-underline hover:underline">View on GitHub →</a>
                    <BitBhPopoverButton
                                     class="bg-transparent border-0 p-0 text-xs text-zinc-500 cursor-pointer underline underline-offset-2">
                        <Template Context="closeBtn">
                            Close
                        </Template>
                    </BitBhPopoverButton>
                </BitBhPopoverPanel>
            </BitBhPopover>
        </LiveContent>
    </TwDemoBlock>

