<TwDemoBlock Title="Controlled" Code="@_controlledCode">
    <Description>
        Drive the open state externally with <code>Open</code> and
        <code>OnOpenChange</code>. The button below opens or closes the popover
        programmatically.
        The outside button carries <code>data-bit-bh-dismiss-ignore</code>: without it, pressing it would
        first dismiss the open surface as an outside press, and its click would then open it again.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-4 items-start">
            <div class="flex flex-wrap items-center gap-3">
                <BitBhButton OnClick="ToggleControlled" data-bit-bh-dismiss-ignore
                          class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100">
                    Toggle from outside
                </BitBhButton>
                <span class="text-sm text-zinc-500">Open: <strong class="text-zinc-900">@controlledOpen.ToString().ToLowerInvariant()</strong></span>
            </div>
            <BitBhPopover Open="controlledOpen" OnOpenChange="v => controlledOpen = v" class="relative inline-block">
                <BitBhPopoverButton class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600">
                    <Template Context="b">
                        Internal trigger
                        <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                    </Template>
                </BitBhPopoverButton>
                <BitBhPopoverPanel class="absolute top-[calc(100%+0.5rem)] left-0 z-30 min-w-64 rounded-lg border border-zinc-200 bg-white p-4 shadow-lg flex flex-col gap-2.5">
                    <p class="text-sm text-zinc-500 m-0">Either trigger updates the same state.</p>
                </BitBhPopoverPanel>
            </BitBhPopover>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Anchor Positioning" Code="@_anchorCode">
    <Description>
        Set <code>Anchor</code> on <code>BitBhPopoverPanel</code> to automatically position
        the panel relative to the button. The panel uses <code>position: fixed</code>,
        flips when there's not enough space, shifts to stay within the viewport, and
        auto-updates on scroll/resize. No <code>position: relative</code> on the parent or
        <code>position: absolute</code> on the panel needed.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-start gap-6">
            <BitBhPopover class="inline-block">
                <BitBhPopoverButton class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600">
                    <Template Context="b">
                        Bottom Start
                        <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                    </Template>
                </BitBhPopoverButton>
                <BitBhPopoverPanel Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 8 })"
                                class="z-30 min-w-64 rounded-lg border border-zinc-200 bg-white p-4 shadow-lg">
                    <p class="text-sm text-zinc-500 m-0">Anchored to <strong>bottom start</strong>. Auto-flips when there's not enough space.</p>
                </BitBhPopoverPanel>
            </BitBhPopover>
            <BitBhPopover class="inline-block">
                <BitBhPopoverButton class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600">
                    <Template Context="b">
                        Top End
                        <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                    </Template>
                </BitBhPopoverButton>
                <BitBhPopoverPanel Anchor="@(new BitBhAnchorOptions { To = "top end", Gap = 8 })"
                                class="z-30 min-w-64 rounded-lg border border-zinc-200 bg-white p-4 shadow-lg">
                    <p class="text-sm text-zinc-500 m-0">Anchored to <strong>top end</strong>. Auto-flips when there's not enough space.</p>
                </BitBhPopoverPanel>
            </BitBhPopover>
            <BitBhPopover class="inline-block">
                <BitBhPopoverButton class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600">
                    <Template Context="b">
                        Right
                        <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                    </Template>
                </BitBhPopoverButton>
                <BitBhPopoverPanel Anchor="@(new BitBhAnchorOptions { To = "right", Gap = 8 })"
                                class="z-30 min-w-64 rounded-lg border border-zinc-200 bg-white p-4 shadow-lg">
                    <p class="text-sm text-zinc-500 m-0">Anchored to <strong>right</strong>. Auto-flips when there's not enough space.</p>
                </BitBhPopoverPanel>
            </BitBhPopover>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Rich panel content" Code="@_richCode">
    <Description>
        The panel can contain any content — forms, images, links, nested interactive
        elements. Tab navigates freely inside and out (no focus trap).
    </Description>
    <LiveContent>
        <BitBhPopover class="relative inline-block">
            <BitBhPopoverButton class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600">
                <Template Context="b">
                    Notifications
                    <span class="ml-1 inline-flex items-center justify-center rounded-full bg-blue-600 px-1.5 py-0.5 text-xs font-bold text-white">3</span>
                    <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                </Template>
            </BitBhPopoverButton>
            <BitBhPopoverPanel class="absolute top-[calc(100%+0.5rem)] left-0 z-30 min-w-88 rounded-lg border border-zinc-200 bg-white shadow-lg overflow-hidden">
                <div class="flex items-center justify-between border-b border-zinc-200 px-4 py-3">
                    <h3 class="text-sm font-semibold text-zinc-900 m-0">Notifications</h3>
                    <span class="rounded-full bg-blue-600 px-2 py-0.5 text-xs font-bold text-white">3 new</span>
                </div>
                <ul class="list-none m-0 py-1">
                    <li class="flex items-start gap-2.5 px-4 py-2.5 hover:bg-zinc-50">
                        <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-blue-600"></span>
                        <div class="flex flex-col gap-0.5">
                            <strong class="text-sm text-zinc-900">Alice commented on your post</strong>
                            <span class="text-xs text-zinc-500">2 minutes ago</span>
                        </div>
                    </li>
                    <li class="flex items-start gap-2.5 px-4 py-2.5 hover:bg-zinc-50">
                        <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-blue-600"></span>
                        <div class="flex flex-col gap-0.5">
                            <strong class="text-sm text-zinc-900">Your export is ready</strong>
                            <span class="text-xs text-zinc-500">15 minutes ago</span>
                        </div>
                    </li>
                    <li class="flex items-start gap-2.5 px-4 py-2.5 hover:bg-zinc-50">
                        <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-blue-600"></span>
                        <div class="flex flex-col gap-0.5">
                            <strong class="text-sm text-zinc-900">New team member joined</strong>
                            <span class="text-xs text-zinc-500">1 hour ago</span>
                        </div>
                    </li>
                </ul>
                <a href="#" @onclick:preventDefault class="block border-t border-zinc-200 py-2.5 text-center text-sm text-blue-600 no-underline hover:bg-zinc-50">View all notifications →</a>
            </BitBhPopoverPanel>
        </BitBhPopover>
    </LiveContent>
</TwDemoBlock>

