@page "/tw"

<PageTitle>bit Bheadless · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">bit Bheadless × Tailwind</h1>
        <p class="mt-2 text-zinc-500">
            The same headless components, styled with Tailwind v4 utilities and custom <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-*</code> variants.
        </p>
        <div class="mt-3 inline-flex items-center gap-1 rounded-full border border-zinc-200 bg-white px-1.5 py-1 text-xs">
            <span class="px-2 font-medium text-zinc-500">Implementation:</span>
            <a href="" class="rounded-full px-3 py-1 font-semibold text-zinc-500 hover:bg-zinc-100">CSS</a>
            <a href="tw" class="rounded-full bg-blue-600 px-3 py-1 font-semibold text-white" aria-current="page">Tailwind</a>
        </div>
    </header>

    <section class="mb-10 rounded-lg border border-zinc-200 bg-white p-6">
        <h2 class="text-base font-semibold text-zinc-900">What's different here?</h2>
        <p class="mt-2 text-sm text-zinc-500">
            Every demo page renders the exact same headless components — only the styling layer
            changes. The Tailwind section uses utility classes and custom variants registered in
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs">tailwind/input.css</code>:
        </p>
        <ul class="mt-3 list-disc pl-5 text-sm text-zinc-600 space-y-1">
            <li><code class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs">data-state-open:</code>, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs">data-state-closed:</code>, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs">data-state-checked:</code></li>
            <li><code class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs">data-active:</code>, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs">data-selected:</code>, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs">data-disabled:</code>, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs">data-loading:</code></li>
            <li><code class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs">data-orientation-horizontal:</code>, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs">data-orientation-vertical:</code></li>
        </ul>
    </section>

    <section class="rounded-lg border border-zinc-200 bg-white p-6">
        <h2 class="text-base font-semibold text-zinc-900">Browse components (Tailwind)</h2>
        <p class="mt-1 text-sm text-zinc-500">Pick a component to see live demos and the Razor + Tailwind classes that produced them.</p>

        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            @foreach (var entry in DemoCatalog.Components)
            {
                <li>
                    <a href="@($"tw/{entry.Slug}")"
                       class="block rounded-md px-3 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50">
                        @entry.Label
                    </a>
                </li>
            }
        </ul>
    </section>
</div>
