@page "/tw/progress"
@implements IDisposable

<PageTitle>Progress / Meter — bit Bheadless · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Progress / Meter</h1>
        <p class="mt-2 text-zinc-500">Progress bars and meters sized from <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">--bit-bh-progress</code> / <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">--bit-bh-meter</code> with arbitrary-value utilities.</p>
        <TwSectionSwitcher Slug="progress" />
    </header>

    <TwDemoBlock Title="Determinate progress" Code="@_determinateCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">role="progressbar"</code> with value attributes and a percentage <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">aria-valuetext</code>.
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">--bit-bh-progress</code> is a unitless 0–100 number: <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">w-[calc(var(--bit-bh-progress,0)*1%)]</code> sizes the indicator, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-[state=complete]:</code> recolors it.
        </Description>
        <LiveContent>
            <div class="grid w-full max-w-sm gap-2.5 rounded-xl border border-zinc-200 bg-white p-4">
                <div class="flex items-baseline justify-between gap-4 text-sm">
                    <span class="font-semibold text-zinc-900" id="tw-profile-label">Profile completion</span>
                    <span class="text-xs tabular-nums text-zinc-500">@profile%</span>
                </div>
                <BitBhProgress Value="profile" aria-labelledby="tw-profile-label"
                            class="relative h-2.5 w-full overflow-hidden rounded-full bg-zinc-200">
                    <BitBhProgressIndicator class="h-full w-[calc(var(--bit-bh-progress,0)*1%)] rounded-full bg-blue-600 transition-all duration-300 data-[state=complete]:bg-green-600" />
                </BitBhProgress>
                <div class="flex gap-2">
                    <button type="button" @onclick="() => profile = Math.Max(0, profile - 20)"
                            class="inline-flex cursor-pointer items-center rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-700 outline-none hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2">− 20%</button>
                    <button type="button" @onclick="() => profile = Math.Min(100, profile + 20)"
                            class="inline-flex cursor-pointer items-center rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-700 outline-none hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2">+ 20%</button>
                </div>
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Simulated upload" Code="@_uploadCode">
        <Description>
            A timer drives <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Value</code> in MB against <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Max="8"</code>; <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">ValueText</code> reads "2.4 of 8 MB uploaded".
            It starts indeterminate (<code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Value="null"</code>) while preparing. <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Template</code> receives the percentage for the in-bar label; the page disposes the timer.
        </Description>
        <LiveContent>
            <div class="grid w-full max-w-sm gap-2.5 rounded-xl border border-zinc-200 bg-white p-4">
                <div class="flex items-baseline justify-between gap-4 text-sm">
                    <span class="font-semibold text-zinc-900" id="tw-upload-label">quarterly-report.pdf</span>
                    <span class="text-xs tabular-nums text-zinc-500">@UploadStatus()</span>
                </div>
                <BitBhProgress Value="uploaded" Max="FileSizeMb"
                            ValueText="@((v, max) => $"{v:0.0} of {max:0} MB uploaded")"
                            aria-labelledby="tw-upload-label"
                            class="relative h-5 w-full overflow-hidden rounded-full bg-zinc-200">
                    <Template Context="percent">
                        <BitBhProgressIndicator class="h-full w-[calc(var(--bit-bh-progress,0)*1%)] rounded-full bg-blue-200 transition-all duration-300 data-[state=complete]:bg-green-200 data-[state=indeterminate]:w-full data-[state=indeterminate]:motion-safe:animate-pulse" />
                        <span class="absolute inset-0 flex items-center justify-end px-2.5 text-[0.72rem] font-semibold tabular-nums text-blue-900">@(percent is null ? "" : $"{percent:0}%")</span>
                    </Template>
                </BitBhProgress>
                <div class="flex gap-2">
                    <button type="button" disabled="@uploading" @onclick="StartUpload"
                            class="inline-flex cursor-pointer items-center rounded-md border border-blue-600 bg-blue-600 px-3 py-1.5 text-xs font-medium text-white outline-none hover:bg-blue-700 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">
                        @(uploaded >= FileSizeMb ? "Upload again" : "Start upload")
                    </button>
                    <button type="button" disabled="@(!uploading)" @onclick="CancelUpload"
                            class="inline-flex cursor-pointer items-center rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-700 outline-none hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">Cancel</button>
                </div>
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Indeterminate" Code="@_indeterminateCode">
        <Description>
            Leave <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Value</code> unset: <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">aria-valuenow</code> is omitted and <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-state="indeterminate"</code> is set — style it with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-[state=indeterminate]:</code> (gate the animation with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">motion-safe:</code>).
        </Description>
        <LiveContent>
            <div class="grid w-full max-w-sm gap-2.5 rounded-xl border border-zinc-200 bg-white p-4">
                <div class="flex items-baseline justify-between gap-4 text-sm">
                    <span class="font-semibold text-zinc-900" id="tw-sync-label">Syncing mailbox</span>
                    <span class="text-xs text-zinc-500">Waiting for the server…</span>
                </div>
                <BitBhProgress aria-labelledby="tw-sync-label"
                            class="relative h-2.5 w-full overflow-hidden rounded-full bg-zinc-200">
                    <BitBhProgressIndicator class="h-full w-[calc(var(--bit-bh-progress,0)*1%)] rounded-full bg-blue-600 data-[state=indeterminate]:w-full data-[state=indeterminate]:bg-blue-400 data-[state=indeterminate]:motion-safe:animate-pulse" />
                </BitBhProgress>
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Meter: disk usage" Code="@_meterCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">role="meter"</code> for a measurement in a known range. <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Low</code> / <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">High</code> produce <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-level</code>; mark the meter as a <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">group</code> and color the fill with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">group-data-[level=high]:</code>.
        </Description>
        <LiveContent>
            <ul class="m-0 grid w-full max-w-sm list-none gap-4 p-0">
                @foreach (var drive in drives)
                {
                    <li class="grid gap-1.5">
                        <div class="flex items-baseline justify-between gap-4 text-sm">
                            <span class="font-semibold text-zinc-900" id="@($"tw-drive-{drive.Id}")">@drive.Name</span>
                            <span class="text-xs tabular-nums text-zinc-500">@drive.Used of 256 GB</span>
                        </div>
                        <BitBhMeter Value="drive.Used" Max="256" Low="64" High="200"
                                 ValueText="@(v => $"{v} of 256 GB used")"
                                 aria-labelledby="@($"tw-drive-{drive.Id}")"
                                 class="group relative h-2 w-full overflow-hidden rounded-full bg-zinc-200">
                            <span class="block h-full w-[calc(var(--bit-bh-meter)*1%)] rounded-full bg-blue-600 transition-all duration-300 group-data-[level=low]:bg-green-600 group-data-[level=high]:bg-red-600"></span>
                        </BitBhMeter>
                    </li>
                }
            </ul>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Meter: password strength" Code="@_strengthCode">
        <Description>
            A 0–4 score with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Low="2"</code> and <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">High="3"</code>. The meter's <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Template</code> receives the percentage and fills four segments, colored by level.
        </Description>
        <LiveContent>
            <div class="grid w-full max-w-xs gap-2">
                <label for="tw-pw" class="text-sm font-semibold text-zinc-900">Choose a password</label>
                <input id="tw-pw" type="password" autocomplete="new-password"
                       @bind="password" @bind:event="oninput" aria-describedby="tw-pw-strength"
                       class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-blue-600" />
                <BitBhMeter Value="Score()" Max="4" Low="2" High="3"
                         ValueText="@(v => StrengthLabels[(int)v])"
                         aria-label="Password strength"
                         class="group grid grid-cols-4 gap-1">
                    <Template Context="percent">
                        @for (var i = 1; i <= 4; i++)
                        {
                            <span data-filled="@(percent >= i * 25)"
                                  class="h-1.5 rounded-full bg-zinc-200 transition-colors group-data-[level=low]:data-filled:bg-red-600 group-data-[level=optimum]:data-filled:bg-amber-600 group-data-[level=high]:data-filled:bg-green-600"></span>
                        }
                    </Template>
                </BitBhMeter>
                <span class="text-xs text-zinc-500" id="tw-pw-strength">Strength: <strong class="font-semibold text-zinc-900">@(StrengthLabels[Score()])</strong></span>
            </div>
        </LiveContent>
    </TwDemoBlock>
</div>

@code {
    // Determinate
    private double profile = 60;

    // Simulated upload
    private const double FileSizeMb = 8;
    private double? uploaded = 0;
    private bool uploading;
    private int uploadTicks;
    private System.Threading.Timer? uploadTimer;

    // Meter
    private readonly (string Id, string Name, double Used)[] drives =
        [("system", "System", 231), ("projects", "Projects", 118), ("backup", "Backup", 37)];

    // Password strength
    private string password = "";
    private static readonly string[] StrengthLabels = ["Very weak", "Weak", "Fair", "Good", "Strong"];

    private string UploadStatus()
    {
        if (uploaded is null) return "Preparing…";
        if (uploaded >= FileSizeMb) return "Complete";
        if (!uploading) return "Ready";
        return $"{uploaded:0.0} of {FileSizeMb:0} MB";
    }

    private void StartUpload()
    {
        uploadTimer?.Dispose();
        uploading = true;
        uploaded = null;   // indeterminate while "preparing"
        uploadTicks = 0;
        uploadTimer = new System.Threading.Timer(_ => InvokeAsync(UploadTick), null, 150, 150);
    }

    private void UploadTick()
    {
        if (!uploading) return;
        uploadTicks++;
        if (uploadTicks > 6)   // ~1 s of "preparing" first
        {
            uploaded = Math.Min(FileSizeMb, (uploaded ?? 0) + 0.2);
            if (uploaded >= FileSizeMb) StopTimer();
        }
        StateHasChanged();
    }

    private void CancelUpload()
    {
        StopTimer();
        uploaded = 0;
    }

    private void StopTimer()
    {
        uploading = false;
        uploadTimer?.Dispose();
        uploadTimer = null;
    }

    public void Dispose() => uploadTimer?.Dispose();

    private int Score()
    {
        if (password.Length == 0) return 0;
        var score = 0;
        if (password.Length >= 8) score++;
        if (password.Any(char.IsUpper) && password.Any(char.IsLower)) score++;
        if (password.Any(char.IsDigit)) score++;
        if (password.Any(c => !char.IsLetterOrDigit(c))) score++;
        return score;
    }

    private const string _determinateCode = """
<div class="grid w-full max-w-sm gap-2.5 rounded-xl border border-zinc-200 bg-white p-4">
    <div class="flex items-baseline justify-between gap-4 text-sm">
        <span class="font-semibold text-zinc-900" id="tw-profile-label">Profile completion</span>
        <span class="text-xs tabular-nums text-zinc-500">@profile%</span>
    </div>
    <BitBhProgress Value="profile" aria-labelledby="tw-profile-label"
                class="relative h-2.5 w-full overflow-hidden rounded-full bg-zinc-200">
        <BitBhProgressIndicator class="h-full w-[calc(var(--bit-bh-progress,0)*1%)] rounded-full bg-blue-600 transition-all duration-300 data-[state=complete]:bg-green-600" />
    </BitBhProgress>
    <div class="flex gap-2">
        <button type="button" @onclick="() => profile = Math.Max(0, profile - 20)"
                class="inline-flex cursor-pointer items-center rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-700 outline-none hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2">− 20%</button>
        <button type="button" @onclick="() => profile = Math.Min(100, profile + 20)"
                class="inline-flex cursor-pointer items-center rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-700 outline-none hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2">+ 20%</button>
    </div>
</div>

@code {
    private double profile = 60;
}
""";

