@page "/tw/toggle-group"

<PageTitle>Toggle / Toggle Group (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Toggle / Toggle Group</h1>
    <p class="bb-subtitle">Two-state buttons on their own, or grouped for formatting, alignment and view switchers.</p>
</div>

<SectionSwitcher Slug="toggle-group" />

<TwDemoBlock Title="Toggle button" Code="@_toggleCode">
    <Description>
        <code>BitBhToggle</code> is the APG Button pattern's toggle variant: a native
        <code>&lt;button&gt;</code> with <code>aria-pressed</code> and <code>data-state="on|off"</code>.
        <kbd>Space</kbd> / <kbd>Enter</kbd> or a click flips it. Use <code>@@bind-Pressed</code>,
        <code>DefaultPressed</code> for uncontrolled use, and <code>Disabled</code>. Either attribute
        can drive the pressed look: the CSS version styles it with <code>[data-state="on"]</code> and
        <code>[data-disabled]</code> selectors, the Tailwind version with the <code>aria-pressed:</code>
        and <code>disabled:</code> variants.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-center gap-3">
            <BitBhToggle aria-label="Bold"
                      class="inline-flex h-9 min-w-9 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 text-sm font-medium text-zinc-700 outline-none transition-colors enabled:hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:border-blue-200 aria-pressed:bg-blue-50 aria-pressed:text-blue-700 enabled:aria-pressed:hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-50"><strong>B</strong></BitBhToggle>
            <BitBhToggle @bind-Pressed="muted"
                      class="inline-flex h-9 min-w-9 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 text-sm font-medium text-zinc-700 outline-none transition-colors enabled:hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:border-blue-200 aria-pressed:bg-blue-50 aria-pressed:text-blue-700 enabled:aria-pressed:hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-50">Mute</BitBhToggle>
            <BitBhToggle DefaultPressed="true" Disabled="true"
                      class="inline-flex h-9 min-w-9 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 text-sm font-medium text-zinc-700 outline-none transition-colors enabled:hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:border-blue-200 aria-pressed:bg-blue-50 aria-pressed:text-blue-700 enabled:aria-pressed:hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-50">Pinned</BitBhToggle>
            <p class="m-0 text-sm text-zinc-500">Muted: <strong class="font-semibold text-zinc-900">@(muted ? "yes" : "no")</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="State-aware content with Template" Code="@_templateCode">
    <Description>
        When the content depends on the pressed state, use <code>Template</code> instead of child
        content — its context is the <code>bool</code> pressed state. Keep the label itself constant
        (APG): only the icon swaps here, <code>aria-pressed</code> conveys the state.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-center gap-3">
            <BitBhToggle DefaultPressed="true"
                      class="inline-flex h-9 min-w-9 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 text-sm font-medium text-zinc-700 outline-none transition-colors enabled:hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:border-blue-200 aria-pressed:bg-blue-50 aria-pressed:text-blue-700 enabled:aria-pressed:hover:bg-blue-100">
                <Template Context="pressed">
                    <span class="text-base leading-none" aria-hidden="true">@(pressed ? "★" : "☆")</span>
                    Star
                </Template>
            </BitBhToggle>
            <BitBhToggle class="inline-flex h-9 min-w-9 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 text-sm font-medium text-zinc-700 outline-none transition-colors enabled:hover:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 aria-pressed:border-blue-200 aria-pressed:bg-blue-50 aria-pressed:text-blue-700 enabled:aria-pressed:hover:bg-blue-100">
                <Template Context="pressed">
                    <span class="text-base leading-none" aria-hidden="true">@(pressed ? "✓" : "+")</span>
                    Follow
                </Template>
            </BitBhToggle>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Multiple: text formatting" Code="@_multipleCode">
    <Description>
        <code>Type="BitBhToggleGroupType.Multiple"</code> renders a <code>role="group"</code> of
        <code>aria-pressed</code> buttons bound with <code>@@bind-Values</code>. The group is a single
        tab stop: <kbd>←</kbd> / <kbd>→</kbd> move focus (wrapping), <kbd>Home</kbd> / <kbd>End</kbd>
        jump, <kbd>Space</kbd> / <kbd>Enter</kbd> toggle.
    </Description>
    <LiveContent>
        <div class="grid w-full justify-items-start gap-4">
            <BitBhToggleGroup Type="BitBhToggleGroupType.Multiple" @bind-Values="textStyles"
                           aria-label="Text formatting"
                           class="inline-flex gap-1 rounded-[0.6rem] border border-zinc-200 bg-zinc-100 p-1">
                <BitBhToggleGroupItem Value="bold" aria-label="Bold"
                                   class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center gap-2 rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white"><strong>B</strong></BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="italic" aria-label="Italic"
                                   class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center gap-2 rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white"><em>I</em></BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="underline" aria-label="Underline"
                                   class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center gap-2 rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white"><u>U</u></BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="strike" aria-label="Strikethrough"
                                   class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center gap-2 rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white"><s>S</s></BitBhToggleGroupItem>
            </BitBhToggleGroup>
            <p class="m-0 w-full max-w-md rounded-lg border border-zinc-200 bg-white px-4 py-3 text-[0.95rem] text-zinc-800"
               style="@PreviewStyle()">The quick brown fox jumps over the lazy dog.</p>
            <p class="m-0 text-sm text-zinc-500">
                Values: <strong class="font-semibold text-zinc-900">@(textStyles.Count == 0 ? "none" : string.Join(", ", textStyles))</strong>
            </p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Single: alignment" Code="@_singleCode">
    <Description>
        In the default <code>Type="BitBhToggleGroupType.Single"</code> one item is pressed at a time,
        and clicking the pressed item clears the value. <code>AllowEmpty="false"</code> keeps one
        alignment selected at all times, which makes the group a radio group: a
        <code>role="radiogroup"</code> of <code>role="radio"</code> items with
        <code>aria-checked</code>, where the pressed item is the tab stop.
    </Description>
    <LiveContent>
        <div class="grid w-full justify-items-start gap-4">
            <BitBhToggleGroup @bind-Value="align" AllowEmpty="false" aria-label="Text alignment"
                           class="inline-flex gap-1 rounded-[0.6rem] border border-zinc-200 bg-zinc-100 p-1">
                <BitBhToggleGroupItem Value="left" aria-label="Align left"
                                   class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white">
                    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h12M2 6.5h8M2 10h12M2 13.5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="center" aria-label="Align center"
                                   class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white">
                    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h12M4 6.5h8M2 10h12M4 13.5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="right" aria-label="Align right"
                                   class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white">
                    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h12M6 6.5h8M2 10h12M6 13.5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="justify" aria-label="Justify"
                                   class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white">
                    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h12M2 6.5h12M2 10h12M2 13.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </BitBhToggleGroupItem>
            </BitBhToggleGroup>
            <p class="m-0 w-full max-w-md rounded-lg border border-zinc-200 bg-white px-4 py-3 text-[0.95rem] text-zinc-800"
               style="text-align: @align">
                Headless components ship behavior and accessibility, and leave every pixel of
                the presentation to you — so this paragraph can be aligned however you like.
            </p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Vertical orientation" Code="@_verticalCode">
    <Description>
        <code>Orientation="BitBhRovingOrientation.Vertical"</code> switches navigation to <kbd>↑</kbd> /
        <kbd>↓</kbd> and sets <code>data-orientation="vertical"</code> for styling: the CSS version
        styles it with a <code>[data-orientation="vertical"]</code> selector, the Tailwind version with
        the <code>data-orientation-vertical:</code> variant. This group is uncontrolled
        (<code>DefaultValue</code>) and each item's <code>Template</code> receives its pressed state to
        draw a check mark.
    </Description>
    <LiveContent>
        <BitBhToggleGroup Orientation="BitBhRovingOrientation.Vertical" DefaultValue="week"
                       aria-label="Calendar view"
                       class="inline-flex gap-1 rounded-[0.6rem] border border-zinc-200 bg-zinc-100 p-1 data-orientation-vertical:min-w-36 data-orientation-vertical:flex-col">
            @foreach (var view in views)
            {
                <BitBhToggleGroupItem Value="@view.ToLowerInvariant()"
                                   class="inline-flex h-8 cursor-pointer items-center justify-start gap-2 rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white">
                    <Template Context="isOn">
                        <span class="inline-block w-4 text-blue-600" aria-hidden="true">@(isOn ? "✓" : "")</span>
                        @view
                    </Template>
                </BitBhToggleGroupItem>
            }
        </BitBhToggleGroup>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabled items" Code="@_disabledCode">
    <Description>
        <code>Disabled="true"</code> on an item renders the native <code>disabled</code> attribute and
        <code>data-disabled</code>; arrow keys skip it. On the group it disables every item, and the
        group gets <code>data-disabled</code> too. The CSS version styles them with
        <code>[data-disabled]</code> selectors, the Tailwind version with the
        <code>data-disabled:</code> variant.
    </Description>
    <LiveContent>
        <div class="grid w-full justify-items-start gap-4">
            <BitBhToggleGroup @bind-Value="size" aria-label="Size"
                           class="inline-flex gap-1 rounded-[0.6rem] border border-zinc-200 bg-zinc-100 p-1">
                <BitBhToggleGroupItem Value="s" class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white data-disabled:cursor-not-allowed data-disabled:opacity-40 data-disabled:hover:bg-transparent data-disabled:hover:text-zinc-600">S</BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="m" class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white data-disabled:cursor-not-allowed data-disabled:opacity-40 data-disabled:hover:bg-transparent data-disabled:hover:text-zinc-600">M</BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="l" class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white data-disabled:cursor-not-allowed data-disabled:opacity-40 data-disabled:hover:bg-transparent data-disabled:hover:text-zinc-600">L</BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="xl" Disabled="true" class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none transition hover:bg-zinc-200 hover:text-zinc-900 focus-visible:ring-2 focus-visible:ring-blue-600 data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-[state=on]:hover:bg-white data-disabled:cursor-not-allowed data-disabled:opacity-40 data-disabled:hover:bg-transparent data-disabled:hover:text-zinc-600">XL</BitBhToggleGroupItem>
            </BitBhToggleGroup>

            <BitBhToggleGroup DefaultValue="m" Disabled="true" aria-label="Size (sold out)"
                           class="inline-flex gap-1 rounded-[0.6rem] border border-zinc-200 bg-zinc-100 p-1 data-disabled:opacity-60">
                <BitBhToggleGroupItem Value="s" class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-disabled:cursor-not-allowed">S</BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="m" class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-disabled:cursor-not-allowed">M</BitBhToggleGroupItem>
                <BitBhToggleGroupItem Value="l" class="inline-flex h-8 min-w-9 cursor-pointer items-center justify-center rounded-md px-2.5 text-sm font-medium text-zinc-600 outline-none data-[state=on]:bg-white data-[state=on]:text-blue-600 data-[state=on]:shadow-sm data-disabled:cursor-not-allowed">L</BitBhToggleGroupItem>
            </BitBhToggleGroup>
        </div>
    </LiveContent>
</TwDemoBlock>

