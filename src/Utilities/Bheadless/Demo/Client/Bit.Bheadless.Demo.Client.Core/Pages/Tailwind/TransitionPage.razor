@page "/tw/transition"

<PageTitle>Transition (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Transition</h1>
    <p class="bb-subtitle">Class-based enter/leave animations with automatic lifecycle management — the <code>Enter*</code> / <code>Leave*</code> parameters take your own CSS classes or Tailwind utilities.</p>
</div>

<SectionSwitcher Slug="transition" />

<TwDemoBlock Title="Fade" Code="@_fadeCode">
    <Description>
        Toggle the panel. Each <code>Enter*</code> / <code>Leave*</code> parameter is a string of
        classes. On enter: <code>opacity-0</code> → <code>opacity-100</code>. On leave:
        <code>opacity-100</code> → <code>opacity-0</code>. The element is unmounted after the
        leave animation completes. Both versions use the same class names: the CSS version
        defines them itself, the Tailwind version gets them from Tailwind.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-4 items-start">
            <BitBhButton OnClick="() => showFade = !showFade"
                      class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-4 py-2 text-sm font-medium text-white cursor-pointer hover:bg-blue-700">
                @(showFade ? "Hide" : "Show")
            </BitBhButton>
            <BitBhTransition Show="showFade"
                          Enter="transition-opacity duration-300"
                          EnterFrom="opacity-0"
                          EnterTo="opacity-100"
                          Leave="transition-opacity duration-200"
                          LeaveFrom="opacity-100"
                          LeaveTo="opacity-0"
                          class="rounded-lg border border-zinc-200 bg-white p-4 text-sm text-zinc-900 inline-block">
                <p>I fade in and out.</p>
            </BitBhTransition>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Scale + Fade" Code="@_scaleCode">
    <Description>
        Combine opacity and transform for a more dynamic entrance. The
        <code>Enter</code> / <code>Leave</code> classes set the transition
        properties and duration; <code>From</code> / <code>To</code> set the
        start and end states.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-4 items-start">
            <BitBhButton OnClick="() => showScale = !showScale"
                      class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-4 py-2 text-sm font-medium text-white cursor-pointer hover:bg-blue-700">
                @(showScale ? "Hide" : "Show")
            </BitBhButton>
            <BitBhTransition Show="showScale"
                          Enter="transition-all duration-300 ease-out"
                          EnterFrom="opacity-0 scale-95"
                          EnterTo="opacity-100 scale-100"
                          Leave="transition-all duration-200 ease-in"
                          LeaveFrom="opacity-100 scale-100"
                          LeaveTo="opacity-0 scale-95"
                          class="rounded-lg border border-zinc-200 bg-white p-4 text-sm text-zinc-900 inline-block">
                <p>I scale and fade.</p>
            </BitBhTransition>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Slide Down" Code="@_slideCode">
    <Description>
        A slide-down reveal that animates <code>max-height</code> (0 to 10rem) and opacity
        inside <code>overflow: hidden</code>. Useful for accordion-style content reveals. The CSS
        version uses its own <code>slide-enter</code> / <code>slide-leave</code> classes, the Tailwind
        version the <code>max-h-0</code> / <code>max-h-40</code> utilities.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-4 items-start">
            <BitBhButton OnClick="() => showSlide = !showSlide"
                      class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-4 py-2 text-sm font-medium text-white cursor-pointer hover:bg-blue-700">
                @(showSlide ? "Hide" : "Show")
            </BitBhButton>
            <BitBhTransition Show="showSlide"
                          Enter="transition-all duration-300 ease-out"
                          EnterFrom="max-h-0 opacity-0"
                          EnterTo="max-h-40 opacity-100"
                          Leave="transition-all duration-200 ease-in"
                          LeaveFrom="max-h-40 opacity-100"
                          LeaveTo="max-h-0 opacity-0"
                          class="rounded-lg border border-zinc-200 bg-white p-4 text-sm text-zinc-900 inline-block overflow-hidden">
                <p>I slide down from zero height.</p>
            </BitBhTransition>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="With Appear" Code="@_appearCode">
    <Description>
        Set <code>Appear="true"</code> to run the enter transition on initial mount.
        Without it, elements that start with <code>Show="true"</code> appear instantly.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-4 items-start">
            <BitBhButton OnClick="() => showAppear = !showAppear"
                      class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-4 py-2 text-sm font-medium text-white cursor-pointer hover:bg-blue-700">
                @(showAppear ? "Hide" : "Show")
            </BitBhButton>
            <BitBhTransition Show="showAppear" Appear="true"
                          Enter="transition-all duration-500 ease-out"
                          EnterFrom="opacity-0 translate-y-4"
                          EnterTo="opacity-100 translate-y-0"
                          Leave="transition-all duration-300 ease-in"
                          LeaveFrom="opacity-100 translate-y-0"
                          LeaveTo="opacity-0 translate-y-4"
                          class="rounded-lg border border-zinc-200 bg-white p-4 text-sm text-zinc-900 inline-block">
                <p>I animate on first mount too.</p>
            </BitBhTransition>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Lifecycle Callbacks" Code="@_callbackCode">
    <Description>
        Use <code>BeforeEnter</code>, <code>AfterEnter</code>,
        <code>BeforeLeave</code>, <code>AfterLeave</code> to run logic at
        each phase of the transition. The log below records each call.
    </Description>
    <LiveContent>
        <div class="flex flex-col gap-4 items-start">
            <BitBhButton OnClick="() => showCallbacks = !showCallbacks"
                      class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-4 py-2 text-sm font-medium text-white cursor-pointer hover:bg-blue-700">
                @(showCallbacks ? "Hide" : "Show")
            </BitBhButton>
            <BitBhTransition Show="showCallbacks"
                          Enter="transition-opacity duration-300" EnterFrom="opacity-0" EnterTo="opacity-100"
                          Leave="transition-opacity duration-200" LeaveFrom="opacity-100" LeaveTo="opacity-0"
                          BeforeEnter='@(() => Log("BeforeEnter"))'
                          AfterEnter='@(() => Log("AfterEnter"))'
                          BeforeLeave='@(() => Log("BeforeLeave"))'
                          AfterLeave='@(() => Log("AfterLeave"))'
                          class="rounded-lg border border-zinc-200 bg-white p-4 text-sm text-zinc-900 inline-block">
                <p>Check the log below.</p>
            </BitBhTransition>
            <pre class="text-xs text-zinc-500 whitespace-pre-wrap">@callbackLog</pre>
        </div>
    </LiveContent>
</TwDemoBlock>

@code {
    private bool showFade;
    private bool showScale;
    private bool showSlide;
    private bool showAppear = true;
    private bool showCallbacks;
    private string callbackLog = "";

    private void Log(string msg) => callbackLog += msg + "\n";

