@page "/tw/combobox"

<PageTitle>Combobox — bit Bheadless · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Combobox</h1>
        <p class="mt-2 text-zinc-500">Accessible typeable autocomplete with consumer-driven filtering.</p>
        <TwSectionSwitcher Slug="combobox" />
    </header>

    <TwDemoBlock Title="Basic Combobox" Code="@_basicCode">
        <Description>Type to filter; you handle the filtering and pass matching options.</Description>
        <LiveContent>
            <BitBhCombobox TValue="string"
                        Value="@selectedFruit"
                        OnValueChange="v => selectedFruit = v"
                        OnQueryChange="HandleFruitQuery"
                        DisplayValue="v => v ?? string.Empty"
                        class="relative inline-block min-w-72">
                <div class="relative flex items-center rounded-lg border border-zinc-300 bg-white transition-colors focus-within:border-blue-600">
                    <BitBhComboboxInput TValue="string" Placeholder="Pick a fruit…"
                                     class="flex-1 border-0 bg-transparent px-3.5 py-2 text-sm text-zinc-900 outline-none" />
                    <BitBhComboboxButton TValue="string"
                                      class="inline-flex items-center justify-center px-2.5 cursor-pointer text-zinc-500 bg-transparent border-0">
                        <Template Context="b">
                            <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                        </Template>
                    </BitBhComboboxButton>
                </div>
                <BitBhComboboxOptions TValue="string"
                                   class="absolute top-[calc(100%+0.25rem)] left-0 right-0 z-30 m-0 max-h-64 overflow-y-auto list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                    @if (filteredFruits.Count == 0)
                    {
                        <li class="px-2.5 py-2.5 text-sm text-zinc-500 italic list-none">No matches.</li>
                    }
                    else
                    {
                        @foreach (var fruit in filteredFruits)
                        {
                            <BitBhComboboxOption TValue="string" Value="@fruit"
                                              class="flex items-center justify-between gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">
                                <Template Context="o">
                                    <span>@fruit</span>
                                    @if (o.IsSelected) { <span class="text-blue-600 font-bold">✓</span> }
                                </Template>
                            </BitBhComboboxOption>
                        }
                    }
                </BitBhComboboxOptions>
            </BitBhCombobox>
            <span class="text-sm text-zinc-500">Selected: <strong class="text-zinc-900">@(selectedFruit ?? "(none)")</strong></span>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Multi-select with chips" Code="@_multiCode">
        <Description>Selected values render as chips above the input.</Description>
        <LiveContent>
            <BitBhCombobox TValue="string" Multiple="true"
                        Values="@pickedTags"
                        OnValuesChange="v => pickedTags = v"
                        OnQueryChange="HandleTagQuery"
                        class="relative inline-block min-w-72">
                <div class="relative flex flex-wrap items-center rounded-lg border border-zinc-300 bg-white transition-colors focus-within:border-blue-600 p-1 gap-1">
                    @foreach (var tag in pickedTags)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-700">
                            @tag
                            <button type="button"
                                    class="cursor-pointer rounded-full px-1 text-base leading-tight hover:bg-blue-100"
                                    @onclick="() => RemoveTag(tag)"
                                    aria-label="@($"Remove {tag}")">×</button>
                        </span>
                    }
                    <BitBhComboboxInput TValue="string"
                                     Placeholder="@(pickedTags.Count == 0 ? "Pick tags…" : "")"
                                     class="flex-1 border-0 bg-transparent text-sm text-zinc-900 outline-none w-auto min-w-24 px-1 py-1" />
                    <BitBhComboboxButton TValue="string"
                                      class="inline-flex items-center justify-center px-2.5 cursor-pointer text-zinc-500 bg-transparent border-0">
                        <Template Context="b">
                            <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                        </Template>
                    </BitBhComboboxButton>
                </div>
                <BitBhComboboxOptions TValue="string"
                                   class="absolute top-[calc(100%+0.25rem)] left-0 right-0 z-30 m-0 max-h-64 overflow-y-auto list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                    @if (filteredTags.Count == 0)
                    {
                        <li class="px-2.5 py-2.5 text-sm text-zinc-500 italic list-none">No matches.</li>
                    }
                    else
                    {
                        @foreach (var tag in filteredTags)
                        {
                            <BitBhComboboxOption TValue="string" Value="@tag"
                                              class="flex items-center justify-between gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">
                                <Template Context="o">
                                    <span class="inline-block w-4 text-blue-600 font-bold">@(o.IsSelected ? "✓" : "")</span>
                                    <span>@tag</span>
                                </Template>
                            </BitBhComboboxOption>
                        }
                    }
                </BitBhComboboxOptions>
            </BitBhCombobox>
            <span class="text-sm text-zinc-500">Picked: <strong class="text-zinc-900">@(pickedTags.Count == 0 ? "(none)" : string.Join(", ", pickedTags))</strong></span>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Object values with rich content" Code="@_objectCode">
        <Description>Bind to objects; provide <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">DisplayValue</code>.</Description>
        <LiveContent>
            <BitBhCombobox TValue="Person"
                        Value="@selectedPerson"
                        OnValueChange="v => selectedPerson = v"
                        OnQueryChange="HandlePersonQuery"
                        DisplayValue="p => p?.Name ?? string.Empty"
                        class="relative inline-block min-w-72">
                <div class="relative flex items-center rounded-lg border border-zinc-300 bg-white transition-colors focus-within:border-blue-600">
                    <BitBhComboboxInput TValue="Person" Placeholder="Search people…"
                                     class="flex-1 border-0 bg-transparent px-3.5 py-2 text-sm text-zinc-900 outline-none" />
                    <BitBhComboboxButton TValue="Person"
                                      class="inline-flex items-center justify-center px-2.5 cursor-pointer text-zinc-500 bg-transparent border-0">
                        <Template Context="b">
                            <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                        </Template>
                    </BitBhComboboxButton>
                </div>
                <BitBhComboboxOptions TValue="Person"
                                   class="absolute top-[calc(100%+0.25rem)] left-0 right-0 z-30 m-0 max-h-64 overflow-y-auto list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                    @if (filteredPeople.Count == 0)
                    {
                        <li class="px-2.5 py-2.5 text-sm text-zinc-500 italic list-none">No matches.</li>
                    }
                    else
                    {
                        @foreach (var person in filteredPeople)
                        {
                            <BitBhComboboxOption TValue="Person" Value="@person"
                                              class="flex items-center justify-between gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">
                                <Template Context="o">
                                    <div class="flex w-full items-center gap-2.5">
                                        <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-indigo-100 text-xs font-bold text-blue-700">@person.Initials</span>
                                        <div class="flex flex-1 flex-col leading-tight">
                                            <strong class="text-sm text-zinc-900">@person.Name</strong>
                                            <span class="text-xs text-zinc-500">@person.Email</span>
                                        </div>
                                        @if (o.IsSelected) { <span class="text-blue-600 font-bold">✓</span> }
                                    </div>
                                </Template>
                            </BitBhComboboxOption>
                        }
                    }
                </BitBhComboboxOptions>
            </BitBhCombobox>
            <span class="text-sm text-zinc-500">Selected: <strong class="text-zinc-900">@(selectedPerson?.Name ?? "(none)")</strong></span>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Anchor Positioning" Code="@_anchorCode">
        <Description><code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Anchor</code> auto-positions and flips.</Description>
        <LiveContent>
            <div class="flex flex-wrap items-end gap-8">
                <div>
                    <p class="text-xs text-zinc-500 mb-2">Bottom Start</p>
                    <BitBhCombobox TValue="string" Value="@anchorFruit" OnValueChange="v => anchorFruit = v"
                                OnQueryChange="HandleAnchorFruitQuery" DisplayValue="v => v ?? string.Empty" class="inline-block min-w-72">
                        <div class="relative flex items-center rounded-lg border border-zinc-300 bg-white transition-colors focus-within:border-blue-600">
                            <BitBhComboboxInput TValue="string" Placeholder="Pick a fruit…"
                                             class="flex-1 border-0 bg-transparent px-3.5 py-2 text-sm text-zinc-900 outline-none" />
                            <BitBhComboboxButton TValue="string"
                                              class="inline-flex items-center justify-center px-2.5 cursor-pointer text-zinc-500 bg-transparent border-0">
                                <Template Context="b">
                                    <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                                </Template>
                            </BitBhComboboxButton>
                        </div>
                        <BitBhComboboxOptions TValue="string" Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })"
                                           class="z-[9999] m-0 min-w-72 max-h-64 overflow-y-auto list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                            @if (anchorFilteredFruits.Count == 0)
                            {
                                <li class="px-2.5 py-2.5 text-sm text-zinc-500 italic list-none">No matches.</li>
                            }
                            else
                            {
                                @foreach (var fruit in anchorFilteredFruits)
                                {
                                    <BitBhComboboxOption TValue="string" Value="@fruit"
                                                      class="flex items-center justify-between gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">
                                        <Template Context="o">
                                            <span>@fruit</span>
                                            @if (o.IsSelected) { <span class="text-blue-600 font-bold">✓</span> }
                                        </Template>
                                    </BitBhComboboxOption>
                                }
                            }
                        </BitBhComboboxOptions>
                    </BitBhCombobox>
                </div>

                <div>
                    <p class="text-xs text-zinc-500 mb-2">Top Start</p>
                    <BitBhCombobox TValue="string" Value="@anchorFruit2" OnValueChange="v => anchorFruit2 = v"
                                OnQueryChange="HandleAnchorFruitQuery2" DisplayValue="v => v ?? string.Empty" class="inline-block min-w-72">
                        <div class="relative flex items-center rounded-lg border border-zinc-300 bg-white transition-colors focus-within:border-blue-600">
                            <BitBhComboboxInput TValue="string" Placeholder="Pick a fruit…"
                                             class="flex-1 border-0 bg-transparent px-3.5 py-2 text-sm text-zinc-900 outline-none" />
                            <BitBhComboboxButton TValue="string"
                                              class="inline-flex items-center justify-center px-2.5 cursor-pointer text-zinc-500 bg-transparent border-0">
                                <Template Context="b">
                                    <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                                </Template>
                            </BitBhComboboxButton>
                        </div>
                        <BitBhComboboxOptions TValue="string" Anchor="@(new BitBhAnchorOptions { To = "top start", Gap = 4 })"
                                           class="z-[9999] m-0 min-w-72 max-h-64 overflow-y-auto list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                            @if (anchorFilteredFruits2.Count == 0)
                            {
                                <li class="px-2.5 py-2.5 text-sm text-zinc-500 italic list-none">No matches.</li>
                            }
                            else
                            {
                                @foreach (var fruit in anchorFilteredFruits2)
                                {
                                    <BitBhComboboxOption TValue="string" Value="@fruit"
                                                      class="flex items-center justify-between gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">
                                        <Template Context="o">
                                            <span>@fruit</span>
                                            @if (o.IsSelected) { <span class="text-blue-600 font-bold">✓</span> }
                                        </Template>
                                    </BitBhComboboxOption>
                                }
                            }
                        </BitBhComboboxOptions>
                    </BitBhCombobox>
                </div>
            </div>
            <span class="text-sm text-zinc-500 mt-3">Selected: <strong class="text-zinc-900">@(anchorFruit ?? anchorFruit2 ?? "(none)")</strong></span>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Large lists (virtualized)" Code="@_virtualCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Items</code> + <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">ItemTemplate</code> + <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Virtualize="true"</code> render only the visible options (each <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">h-9</code> = <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">ItemSize</code> 36px).
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">OnQueryChange</code> filters 10,000 items with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhFilter.Contains</code> (case- and accent-insensitive); <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhComboboxEmpty</code> covers no matches.
        </Description>
        <LiveContent>
            <BitBhCombobox TValue="string"
                        @bind-Value="virtualPick"
                        OnQueryChange="HandleVirtualQuery"
                        DisplayValue="v => v ?? string.Empty"
                        class="inline-block min-w-72">
                <div class="flex items-center rounded-lg border border-zinc-300 bg-white transition-colors focus-within:border-blue-600">
                    <BitBhComboboxInput TValue="string" Placeholder="Search 10,000 animals…"
                                     class="min-w-0 flex-1 border-0 bg-transparent px-3.5 py-2 text-sm text-zinc-900 outline-none" />
                    <BitBhComboboxButton TValue="string"
                                      class="inline-flex items-center justify-center border-0 bg-transparent px-2.5 text-zinc-500 cursor-pointer">
                        <Template Context="b">
                            <span class="@($"transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                        </Template>
                    </BitBhComboboxButton>
                </div>
                <BitBhComboboxOptions TValue="string"
                                   Items="@virtualMatches"
                                   Virtualize="true"
                                   ItemSize="36"
                                   Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })"
                                   class="z-9999 m-0 max-h-64 w-72 list-none overflow-y-auto rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                    <ItemTemplate Context="o">
                        <span class="@($"flex h-9 cursor-pointer items-center justify-between gap-2 whitespace-nowrap rounded-md px-2.5 text-sm {(o.IsActive ? "bg-blue-50 text-blue-900" : "text-zinc-900")} {(o.IsSelected ? "font-semibold" : "")}")">
                            @o.Value
                            @if (o.IsSelected) { <span class="font-bold text-blue-600">✓</span> }
                        </span>
                    </ItemTemplate>
                    <ChildContent>
                        <BitBhComboboxEmpty TValue="string" class="px-2.5 py-2.5 text-sm italic text-zinc-500">No animals match.</BitBhComboboxEmpty>
                    </ChildContent>
                </BitBhComboboxOptions>
            </BitBhCombobox>
            <span class="text-sm text-zinc-500">
                @virtualMatches.Count.ToString("N0") matches · Selected: <strong class="text-zinc-900">@(virtualPick ?? "(none)")</strong>
            </span>
        </LiveContent>
    </TwDemoBlock>
</div>

@code {
    // ── Large lists (virtualized) ───────────────────────────────────────────

    // 10 adjectives × 10 animals × 100 = 10,000 items.
    private static readonly string[] VirtualItems = BuildVirtualItems();
    private IReadOnlyList<string> virtualMatches = VirtualItems;
    private string? virtualPick;

    private static string[] BuildVirtualItems()
    {
        string[] adjectives = ["Amber", "Brave", "Calm", "Dusty", "Eager", "Fuzzy", "Gentle", "Hazy", "Icy", "Jolly"];
        string[] animals = ["Badger", "Crane", "Dingo", "Falcon", "Gecko", "Heron", "Ibis", "Jaguar", "Koala", "Lynx"];
        return Enumerable.Range(0, 10_000)
            .Select(i => $"{adjectives[i / 1000]} {animals[i / 100 % 10]} {i % 100 + 1}")
            .ToArray();
    }

    private void HandleVirtualQuery(string query) =>
        virtualMatches = VirtualItems.Where(item => BitBhFilter.Contains(item, query)).ToArray();

    private const string _virtualCode = """
<BitBhCombobox TValue="string"
            @bind-Value="virtualPick"
            OnQueryChange="HandleVirtualQuery"
