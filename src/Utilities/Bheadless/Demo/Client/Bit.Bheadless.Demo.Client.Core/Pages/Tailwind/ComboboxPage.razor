@code {
    // 10 adjectives × 10 animals × 100 = 10,000 items.
    private static readonly string[] VirtualItems = BuildVirtualItems();
    private IReadOnlyList<string> virtualMatches = VirtualItems;
    private string? virtualPick;

    private static string[] BuildVirtualItems()
    {
        string[] adjectives = ["Amber", "Brave", "Calm", "Dusty", "Eager", "Fuzzy", "Gentle", "Hazy", "Icy", "Jolly"];
        string[] animals = ["Badger", "Crane", "Dingo", "Falcon", "Gecko", "Heron", "Ibis", "Jaguar", "Koala", "Lynx"];
        return Enumerable.Range(0, 10_000)
            .Select(i => $"{adjectives[i / 1000]} {animals[i / 100 % 10]} {i % 100 + 1}")
            .ToArray();
    }

    // Case- and accent-insensitive "contains" match.
    private void HandleVirtualQuery(string query) =>
        virtualMatches = VirtualItems.Where(item => BitBhFilter.Contains(item, query)).ToArray();
}
""";

    private string? selectedFruit;
    private readonly string[] allFruits =
    {
        "Apple", "Apricot", "Banana", "Blueberry", "Cherry", "Coconut", "Cranberry",
        "Grape", "Kiwi", "Lemon", "Lime", "Mango", "Orange", "Papaya",
        "Peach", "Pear", "Pineapple", "Plum", "Raspberry", "Strawberry",
    };
    private List<string> filteredFruits = new();
    private void HandleFruitQuery(string q) =>
        filteredFruits = string.IsNullOrWhiteSpace(q) ? allFruits.ToList()
            : allFruits.Where(f => f.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();

    private string? anchorFruit;
    private string? anchorFruit2;
    private List<string> anchorFilteredFruits = new();
    private List<string> anchorFilteredFruits2 = new();
    private void HandleAnchorFruitQuery(string q) =>
        anchorFilteredFruits = string.IsNullOrWhiteSpace(q) ? allFruits.ToList()
            : allFruits.Where(f => f.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    private void HandleAnchorFruitQuery2(string q) =>
        anchorFilteredFruits2 = string.IsNullOrWhiteSpace(q) ? allFruits.ToList()
            : allFruits.Where(f => f.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();

    private IReadOnlyCollection<string> pickedTags = Array.Empty<string>();
    private BitBhCombobox<string> tagCombobox = default!;
    private readonly string[] allTags =
    {
        "design", "engineering", "marketing", "sales", "support",
        "research", "product", "operations", "finance", "legal",
    };
    private List<string> filteredTags = new();
    private void HandleTagQuery(string q) =>
        filteredTags = string.IsNullOrWhiteSpace(q) ? allTags.ToList()
            : allTags.Where(t => t.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    // The chip's remove button leaves with the chip: give the focus back to the input.
    private async Task RemoveTag(string tag)
    {
        pickedTags = pickedTags.Where(t => t != tag).ToList();
        await tagCombobox.FocusAsync();
    }

    public sealed record Person(string Name, string Email)
    {
        public string Initials =>
            string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
    }

    private Person? selectedPerson;
    private readonly Person[] allPeople =
    {
        new("Alice Anderson",  "alice@example.com"),
        new("Benjamin Brown",  "ben@example.com"),
        new("Caterina Costa",  "cat@example.com"),
        new("Daniel Davis",    "dan@example.com"),
        new("Eleanor Evans",   "ellie@example.com"),
        new("Felix Foster",    "felix@example.com"),
        new("Genevieve Gomez", "gen@example.com"),
        new("Henry Hughes",    "henry@example.com"),
    };
    private List<Person> filteredPeople = new();
    private void HandlePersonQuery(string q) =>
        filteredPeople = string.IsNullOrWhiteSpace(q) ? allPeople.ToList()
            : allPeople.Where(p =>
                p.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                p.Email.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override void OnInitialized()
    {
        filteredFruits = allFruits.ToList();
        filteredTags   = allTags.ToList();
        filteredPeople = allPeople.ToList();
        anchorFilteredFruits = allFruits.ToList();
        anchorFilteredFruits2 = allFruits.ToList();
    }

    private const string _basicCode = """
<BitBhCombobox TValue="string"
            Value="@selectedFruit"
            OnValueChange="v => selectedFruit = v"
            OnQueryChange="HandleFruitQuery"
            DisplayValue="v => v ?? string.Empty"
            class="relative inline-block min-w-72">
    <div class="relative flex items-center rounded-lg border border-zinc-300 bg-white transition-colors focus-within:border-blue-600">
        <BitBhComboboxInput TValue="string" Placeholder="Pick a fruit…"
