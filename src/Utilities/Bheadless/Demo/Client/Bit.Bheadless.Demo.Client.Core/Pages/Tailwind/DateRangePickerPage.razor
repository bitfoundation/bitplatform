@page "/tw/date-range-picker"
@using System.ComponentModel.DataAnnotations
@using System.Globalization

<PageTitle>Date Range Picker (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Date Range Picker</h1>
    <p class="bb-subtitle">A start and an end date, each typed into its own segments, with a button that opens a range calendar in a popover.</p>
</div>

<SectionSwitcher Slug="date-range-picker" />

<TwDemoBlock Title="Date range picker" Code="@_basicCode">
    <Description>
        Two <code>BitBhDateRangePickerInput</code>s — the start and the end, each a date field named "Start date" / "End date"
        and the field's label — the trigger and a range calendar in the popover. The focus runs on from the start's year into
        the end's month, so a whole range types in one go. The group gets <code>data-[focused]:</code> while either date has
        the focus and <code>data-state-open:</code> while the calendar is open; the calendar's cells take
        <code>data-selection-start:</code>, <code>data-selection-end:</code> and <code>data-range-middle:</code>.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-end gap-6">
            <BitBhField>
                <BitBhLabel class="mb-1.5 block text-sm font-semibold text-zinc-900">Stay</BitBhLabel>
                <BitBhDateRangePicker @bind-Value="stay" Culture="DemoDateCultures.EnUs">
                    <BitBhDatePickerGroup class="@Group">
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.Start" class="inline-flex items-center" />
                        <span class="px-1 text-zinc-500" aria-hidden="true">–</span>
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.End" class="inline-flex items-center" />
                        <BitBhDatePickerTrigger class="@Trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="@Popover">
                        @RangeCalendar
                    </BitBhDatePickerContent>
                </BitBhDateRangePicker>
            </BitBhField>
            <p class="m-0 text-sm text-zinc-500">Stay: <strong class="font-semibold text-zinc-900">@Describe(stay)</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Limits and unavailable dates" Code="@_limitsCode">
    <Description>
        <code>Min</code>, <code>Max</code> and <code>IsDateUnavailable</code> reach the calendar, and a range can't span a booked
        night; a typed range that breaks them, or an end before its start, marks the picker invalid
        (<code>data-[invalid]:</code>).
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-end gap-6">
            <BitBhField>
                <BitBhLabel class="mb-1.5 block text-sm font-semibold text-zinc-900">Booking</BitBhLabel>
                <BitBhDateRangePicker @bind-Value="booking" Min="today" Max="today.AddMonths(6)" IsDateUnavailable="IsBooked"
                                      Culture="DemoDateCultures.EnUs">
                    <BitBhDatePickerGroup class="@Group">
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.Start" class="inline-flex items-center" />
                        <span class="px-1 text-zinc-500" aria-hidden="true">–</span>
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.End" class="inline-flex items-center" />
                        <BitBhDatePickerTrigger class="@Trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="@Popover">
                        @RangeCalendar
                    </BitBhDatePickerContent>
                </BitBhDateRangePicker>
                <BitBhDescription class="mt-1.5 text-xs text-zinc-500">The next six months; struck-through nights are booked.</BitBhDescription>
            </BitBhField>
            <p class="m-0 text-sm text-zinc-500">Booking: <strong class="font-semibold text-zinc-900">@Describe(booking)</strong></p>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="In a German form" Code="@_formCode">
    <Description>
        <code>@@bind-Value</code> joins <code>EditForm</code> validation, <code>Name</code> posts an ISO interval, and the inputs
        and the button take German names; with a German <code>Culture</code> the segments read <code>dd.MM.yyyy</code>.
    </Description>
    <LiveContent>
        <EditForm Model="form" OnValidSubmit="() => sent = form.Holiday">
            <DataAnnotationsValidator />
            <BitBhField>
                <BitBhLabel class="mb-1.5 block text-sm font-semibold text-zinc-900">Urlaub</BitBhLabel>
                <BitBhDateRangePicker @bind-Value="form.Holiday" Name="holiday" Culture="DemoDateCultures.DeDe">
                    <BitBhDatePickerGroup class="@Group">
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.Start" aria-label="Erster Tag" class="inline-flex items-center" />
                        <span class="px-1 text-zinc-500" aria-hidden="true">–</span>
                        <BitBhDateRangePickerInput Part="BitBhDateRangePart.End" aria-label="Letzter Tag" class="inline-flex items-center" />
                        <BitBhDatePickerTrigger aria-label="Zeitraum wählen" class="@Trigger">@CalendarIcon</BitBhDatePickerTrigger>
                    </BitBhDatePickerGroup>
                    <BitBhDatePickerContent class="@Popover">
                        @RangeCalendar
                    </BitBhDatePickerContent>
                </BitBhDateRangePicker>
                <BitBhErrorMessage class="mt-1.5 text-xs text-red-700" />
            </BitBhField>
            <button type="submit" class="mt-3 cursor-pointer rounded-lg bg-blue-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-blue-700">Senden</button>
            @if (sent is { } holiday)
            {
                <p class="m-0 mt-2 text-sm text-zinc-500">Gesendet: <strong class="text-zinc-900">@holiday.Start.ToString("d", DemoDateCultures.DeDe) – @holiday.End.ToString("d", DemoDateCultures.DeDe)</strong></p>
            }
        </EditForm>
    </LiveContent>
</TwDemoBlock>

@code {
    private static readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private BitBhDateRange? stay;
    private BitBhDateRange? booking;
    private readonly HolidayForm form = new();
    private BitBhDateRange? sent;

    private static bool IsBooked(DateOnly d) => d.DayNumber % 9 is 4 or 5;

    private static string Describe(BitBhDateRange? range) => range is null
        ? "none"
        : $"{range.Start.ToString("MMM d", DemoDateCultures.EnUs)} – {range.End.ToString("MMM d, yyyy", DemoDateCultures.EnUs)} ({range.Days - 1} nights)";

    private sealed class HolidayForm
    {
        [Required(ErrorMessage = "Bitte einen Zeitraum wählen.")]
        public BitBhDateRange? Holiday { get; set; }
    }

    private static readonly RenderFragment CalendarIcon =
        @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-[1.1rem]">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
        </svg>;

    private static readonly RenderFragment RangeCalendar =
        @<BitBhCalendar VisibleMonths="2" class="@Root">
            <div class="flex items-center gap-2">
                <BitBhCalendarPrevious class="@Nav">‹</BitBhCalendarPrevious>
                <BitBhCalendarHeading As="h3" class="m-0 flex-1 text-center text-[0.95rem] font-semibold" />
                <BitBhCalendarNext class="@Nav">›</BitBhCalendarNext>
            </div>
            <div class="flex flex-wrap gap-5">
                @for (var i = 0; i < 2; i++)
                {
                    var offset = i;
                    <div>
                        <BitBhCalendarHeading Offset="offset" As="h4" class="m-0 mb-1 text-center text-sm font-semibold" aria-hidden="true" />
                        <BitBhCalendarGrid Offset="offset" Context="day" class="@Grid">
                            <BitBhCalendarCell Day="day" class="@Cell" />
                        </BitBhCalendarGrid>
                    </div>
                }
            </div>
        </BitBhCalendar>;

    // The utilities the live samples share (the Razor tabs show them inline).
    private const string Group = "inline-flex flex-wrap items-center gap-1 rounded-lg border border-zinc-500 bg-white py-1 pe-1 ps-2.5 tabular-nums text-zinc-900 hover:border-zinc-600 data-[focused]:outline-2 data-[focused]:outline-offset-2 data-[focused]:outline-blue-600 data-state-open:outline-2 data-state-open:outline-offset-2 data-state-open:outline-blue-600 data-[invalid]:border-red-600 [&_[data-type]]:rounded [&_[data-type]]:px-0.5 [&_[data-type=literal]]:px-0 [&_[data-type=literal]]:text-zinc-500 [&_[role=spinbutton]]:inline-block [&_[role=spinbutton]]:min-h-6 [&_[role=spinbutton]]:min-w-6 [&_[role=spinbutton]]:text-center [&_[role=spinbutton]]:leading-6 [&_[role=spinbutton]]:outline-none [&_[role=spinbutton]:focus]:bg-blue-600 [&_[role=spinbutton]:focus]:text-white [&_[data-placeholder]]:text-zinc-500";
    private const string Trigger = "ms-auto inline-grid size-8 cursor-pointer place-items-center rounded-md text-zinc-700 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-state-open:bg-zinc-100 disabled:cursor-not-allowed";
    private const string Popover = "z-30 max-w-[calc(100vw-1rem)] rounded-xl shadow-xl outline-none";
    private const string Root = "inline-grid gap-3 rounded-xl border border-zinc-200 bg-white p-3 text-zinc-900";
    private const string Nav = "inline-grid size-8 cursor-pointer place-items-center rounded-lg text-lg text-zinc-700 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-disabled:cursor-not-allowed data-disabled:text-zinc-400 data-disabled:hover:bg-transparent";
    private const string Grid = "border-collapse [&_td]:p-px [&_th]:w-9 [&_th]:pb-1 [&_th]:text-xs [&_th]:font-medium [&_th]:text-zinc-500";
    private const string Cell = "size-9 cursor-pointer select-none rounded-lg text-center text-sm tabular-nums text-zinc-900 outline-none [&[data-hover]:not([data-selected])]:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-today:font-bold data-today:underline data-today:decoration-2 data-today:underline-offset-4 data-selection-start:bg-blue-600 data-selection-start:text-white data-selection-end:bg-blue-600 data-selection-end:text-white data-range-middle:rounded-none data-range-middle:bg-blue-100 data-range-middle:text-blue-800 data-unavailable:cursor-not-allowed data-unavailable:text-zinc-500 data-unavailable:line-through data-disabled:cursor-not-allowed data-disabled:text-zinc-500";

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _basicCode = """
<BitBhField>
    <BitBhLabel class="mb-1.5 block text-sm font-semibold text-zinc-900">Stay</BitBhLabel>
    <BitBhDateRangePicker @bind-Value="stay">
        <BitBhDatePickerGroup class="inline-flex flex-wrap items-center gap-1 rounded-lg border border-zinc-500 bg-white py-1 pe-1 ps-2.5 tabular-nums text-zinc-900 hover:border-zinc-600 data-[focused]:outline-2 data-[focused]:outline-offset-2 data-[focused]:outline-blue-600 data-state-open:outline-2 data-state-open:outline-offset-2 data-state-open:outline-blue-600 data-[invalid]:border-red-600 [&_[data-type]]:rounded [&_[data-type]]:px-0.5 [&_[data-type=literal]]:px-0 [&_[data-type=literal]]:text-zinc-500 [&_[role=spinbutton]]:inline-block [&_[role=spinbutton]]:min-h-6 [&_[role=spinbutton]]:min-w-6 [&_[role=spinbutton]]:text-center [&_[role=spinbutton]]:leading-6 [&_[role=spinbutton]]:outline-none [&_[role=spinbutton]:focus]:bg-blue-600 [&_[role=spinbutton]:focus]:text-white [&_[data-placeholder]]:text-zinc-500">
            <BitBhDateRangePickerInput Part="BitBhDateRangePart.Start" class="inline-flex items-center" />
            <span class="px-1 text-zinc-500" aria-hidden="true">–</span>
            <BitBhDateRangePickerInput Part="BitBhDateRangePart.End" class="inline-flex items-center" />
            <BitBhDatePickerTrigger class="ms-auto inline-grid size-8 cursor-pointer place-items-center rounded-md text-zinc-700 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-state-open:bg-zinc-100 disabled:cursor-not-allowed">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false" class="size-[1.1rem]">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
            </BitBhDatePickerTrigger>
        </BitBhDatePickerGroup>
        <BitBhDatePickerContent class="z-30 max-w-[calc(100vw-1rem)] rounded-xl shadow-xl outline-none">
            <BitBhCalendar VisibleMonths="2" class="inline-grid gap-3 rounded-xl border border-zinc-200 bg-white p-3 text-zinc-900">
                @* the header, and a heading and a grid per month, as on the Calendar page's range sample *@
            </BitBhCalendar>
        </BitBhDatePickerContent>
    </BitBhDateRangePicker>
</BitBhField>

@code {
    private BitBhDateRange? stay;
}
""";

    private const string _limitsCode = """
<BitBhDateRangePicker @bind-Value="booking" Min="today" Max="today.AddMonths(6)" IsDateUnavailable="IsBooked">
    @* the group, the inputs, the trigger and the popover as above *@
</BitBhDateRangePicker>

@code {
    private static readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private BitBhDateRange? booking;

    private static bool IsBooked(DateOnly d) => d.DayNumber % 9 is 4 or 5;
}
""";

    private const string _formCode = """
<EditForm Model="form" OnValidSubmit="() => sent = form.Holiday">
    <DataAnnotationsValidator />
    <BitBhField>
        <BitBhLabel class="mb-1.5 block text-sm font-semibold text-zinc-900">Urlaub</BitBhLabel>
        <BitBhDateRangePicker @bind-Value="form.Holiday" Name="holiday" Culture="@(CultureInfo.GetCultureInfo("de-DE"))">
            @* the group, the inputs (aria-label="Erster Tag" / "Letzter Tag"),
               the trigger (aria-label="Zeitraum wählen") and the popover as above *@
        </BitBhDateRangePicker>
        <BitBhErrorMessage class="mt-1.5 text-xs text-red-700" />
    </BitBhField>
    <button type="submit" class="mt-3 cursor-pointer rounded-lg bg-blue-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-blue-700">Senden</button>
</EditForm>

@code {
    private readonly HolidayForm form = new();
    private BitBhDateRange? sent;

    private sealed class HolidayForm
    {
        [Required(ErrorMessage = "Bitte einen Zeitraum wählen.")]
        public BitBhDateRange? Holiday { get; set; }
    }
}
""";
}
