@page "/tw/listbox"

<PageTitle>Listbox (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Listbox</h1>
    <p class="bb-subtitle">An accessible custom select with single/multi-select, full keyboard navigation, and typeahead.</p>
</div>

<SectionSwitcher Slug="listbox" />

<TwDemoBlock Title="Basic Listbox" Code="@_basicCode">
    <Description>
        Click the button or press Space / Enter / arrow keys to open. Use Up / Down to navigate,
        Home / End to jump, Enter / Space to select, Escape to close, or simply type to jump
        to an option. ARIA wiring (<code>combobox</code>, <code>listbox</code>,
        <code>aria-activedescendant</code>) is handled for you.
    </Description>
    <LiveContent>
        <BitBhListbox TValue="string" Value="@favPerson" OnValueChange="v => favPerson = v" class="relative inline-block min-w-56">
            <BitBhListboxButton aria-label="Person" TValue="string"
                             class="flex w-full items-center justify-between rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                <Template Context="b">
                    <span>@(string.IsNullOrEmpty(b.Value) ? "Select a person…" : b.Value)</span>
                    <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                </Template>
            </BitBhListboxButton>
            <BitBhListboxOptions TValue="string"
                              class="absolute top-[calc(100%+0.25rem)] left-0 right-0 z-30 m-0 max-h-56 overflow-y-auto list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                <BitBhListboxOption TValue="string" Value="@("Alice")"     class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Alice</BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Benjamin")"  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Benjamin</BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Caterina")"  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Caterina</BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Daniel")"    class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Daniel</BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Eleanor")"   class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Eleanor</BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Felix")"     class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Felix</BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Genevieve")" class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Genevieve</BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Henry")"     class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Henry</BitBhListboxOption>
            </BitBhListboxOptions>
        </BitBhListbox>
        <span class="text-sm text-zinc-500">Selected: <strong class="text-zinc-900">@(favPerson ?? "(none)")</strong></span>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Multi-select" Code="@_multiCode">
    <Description>
        Set <code>Multiple="true"</code> to allow selecting many values. The panel stays
        open after each selection. The button label here renders the joined names, and each
        option draws its check mark from its render context's <code>IsSelected</code>.
    </Description>
    <LiveContent>
        <BitBhListbox TValue="string" Multiple="true" Values="@favColors" OnValuesChange="v => favColors = v" class="relative inline-block min-w-56">
            <BitBhListboxButton aria-label="Colours" TValue="string"
                             class="flex w-full items-center justify-between rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                <Template Context="b">
                    <span>@(b.Values.Count == 0 ? "Pick colours…" : string.Join(", ", b.Values))</span>
                    <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                </Template>
            </BitBhListboxButton>
            <BitBhListboxOptions TValue="string"
                              class="absolute top-[calc(100%+0.25rem)] left-0 right-0 z-30 m-0 max-h-56 overflow-y-auto list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                <BitBhListboxOption TValue="string" Value="@("Red")"    class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">
                    <Template Context="o">
                        <span class="inline-block w-4 text-blue-600 font-bold">@(o.IsSelected ? "✓" : "")</span>
                        <span>Red</span>
                    </Template>
                </BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Green")"  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">
                    <Template Context="o">
                        <span class="inline-block w-4 text-blue-600 font-bold">@(o.IsSelected ? "✓" : "")</span>
                        <span>Green</span>
                    </Template>
                </BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Blue")"   class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">
                    <Template Context="o">
                        <span class="inline-block w-4 text-blue-600 font-bold">@(o.IsSelected ? "✓" : "")</span>
                        <span>Blue</span>
                    </Template>
                </BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Yellow")" class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">
                    <Template Context="o">
                        <span class="inline-block w-4 text-blue-600 font-bold">@(o.IsSelected ? "✓" : "")</span>
                        <span>Yellow</span>
                    </Template>
                </BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Purple")" class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">
                    <Template Context="o">
                        <span class="inline-block w-4 text-blue-600 font-bold">@(o.IsSelected ? "✓" : "")</span>
                        <span>Purple</span>
                    </Template>
                </BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("Orange")" class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">
                    <Template Context="o">
                        <span class="inline-block w-4 text-blue-600 font-bold">@(o.IsSelected ? "✓" : "")</span>
                        <span>Orange</span>
                    </Template>
                </BitBhListboxOption>
            </BitBhListboxOptions>
        </BitBhListbox>
        <span class="text-sm text-zinc-500">Selected: <strong class="text-zinc-900">@string.Join(", ", favColors)</strong></span>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabled Options" Code="@_disabledCode">
    <Description>
        Mark individual options with <code>Disabled="true"</code>. They render with
        <code>data-disabled</code>, are skipped by arrow-key nav, and ignore typeahead matches.
        The CSS version styles them with a <code>[data-disabled]</code> selector, the Tailwind
        version with the <code>data-disabled:</code> variant.
    </Description>
    <LiveContent>
        <BitBhListbox TValue="string" DefaultValue='@("standard")' class="relative inline-block min-w-56">
            <BitBhListboxButton aria-label="Plan" TValue="string"
                             class="flex w-full items-center justify-between rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed">
                <Template Context="b">
                    <span>@(b.Text ?? "Pick a plan")</span>
                    <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                </Template>
            </BitBhListboxButton>
            <BitBhListboxOptions TValue="string"
                              class="absolute top-[calc(100%+0.25rem)] left-0 right-0 z-30 m-0 max-h-56 overflow-y-auto list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                <BitBhListboxOption TValue="string" Value="@("standard")"   class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Standard</BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("pro")"        class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Pro</BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("enterprise")" Disabled="true"
                                 class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold data-disabled:opacity-40 data-disabled:cursor-not-allowed">Enterprise (coming soon)</BitBhListboxOption>
            </BitBhListboxOptions>
        </BitBhListbox>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Custom Option Content" Code="@_customCode">
    <Description>
        Options can render any markup. Use the <code>data-active</code> and
        <code>data-selected</code> hooks to drive the highlighted and selected styles.
        Provide a <code>Label</code> string when your content is rich so typeahead
        still matches sensibly.
    </Description>
    <LiveContent>
        <BitBhListbox TValue="string" Value="@country" OnValueChange="v => country = v" class="relative inline-block min-w-56">
            <BitBhListboxButton aria-label="Country" TValue="string"
                             class="flex w-full items-center justify-between rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600">
                <Template Context="b">
                    <span>@(LookupCountry(b.Value)?.Name ?? "Pick a country")</span>
                    <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                </Template>
            </BitBhListboxButton>
            <BitBhListboxOptions TValue="string"
                              class="absolute top-[calc(100%+0.25rem)] left-0 right-0 z-30 m-0 max-h-56 overflow-y-auto list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                <BitBhListboxOption TValue="string" Value="@("us")" Label="United States"  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">
                    <span class="text-base">🇺🇸</span>
                    <span class="flex-1">United States</span>
                    <span class="text-xs text-zinc-500 uppercase tracking-wide">us</span>
                </BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("gb")" Label="United Kingdom" class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">
