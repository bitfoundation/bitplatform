<TwDemoBlock Title="Large lists (virtualized)" Code="@_virtualCode">
    <Description>
        For thousands of options, pass the data through <code>Items</code> and render each option
        with an <code>ItemTemplate</code>. <code>Virtualize="true"</code> renders only the options in
        view — give the panel a fixed height with <code>overflow-y: auto</code> and make every option
        exactly <code>ItemSize</code> pixels tall (36px here). Options still get <code>aria-setsize</code> /
        <code>aria-posinset</code>, and arrow keys, Home / End and typeahead reach all 10,000. With no
        content, <code>BitBhListboxButton</code> shows the selected option's text or its
        <code>Placeholder</code> (and emits <code>data-placeholder</code>). The generated options carry
        no class: the CSS version targets them by role with <code>[data-active]</code> /
        <code>[data-selected]</code>, the Tailwind version styles a full-height inner element from the
        template's <code>IsActive</code> / <code>IsSelected</code>.
    </Description>
    <LiveContent>
        <BitBhListbox TValue="string" @bind-Value="virtualPick" class="relative inline-block min-w-64">
            <BitBhListboxButton aria-label="Item" TValue="string" Placeholder="Choose one of 10,000…"
                             class="flex w-full items-center rounded-lg border border-zinc-300 bg-white py-2 pl-3.5 pr-9 text-left text-sm text-zinc-900 cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600 data-placeholder:text-zinc-500" />
            <span aria-hidden="true" class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-500">▾</span>
            <BitBhListboxOptions TValue="string"
                              Items="@VirtualItems"
                              Virtualize="true"
                              ItemSize="36"
                              Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })"
                              class="z-9999 m-0 h-64 w-(--button-width) list-none overflow-y-auto rounded-lg border border-zinc-200 bg-white p-1 shadow-lg">
                <ItemTemplate Context="o">
                    <span class="@($"flex h-9 cursor-pointer items-center gap-2 whitespace-nowrap rounded-md px-2.5 text-sm {(o.IsActive ? "bg-blue-50 text-blue-900" : "text-zinc-900")} {(o.IsSelected ? "font-semibold" : "")}")">
                        <span class="w-4 font-bold text-blue-600">@(o.IsSelected ? "✓" : "")</span>
                        @o.Value
                    </span>
                </ItemTemplate>
            </BitBhListboxOptions>
        </BitBhListbox>
        <span class="text-sm text-zinc-500">Selected: <strong class="text-zinc-900">@(virtualPick ?? "(none)")</strong></span>
    </LiveContent>
</TwDemoBlock>

