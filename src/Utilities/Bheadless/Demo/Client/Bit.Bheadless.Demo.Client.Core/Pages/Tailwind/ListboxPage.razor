                <BitBhListboxOption TValue="string" Value="@("fr")" Label="France"  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">
                    <span class="text-base">🇫🇷</span>
                    <span class="flex-1">France</span>
                    <span class="text-xs text-zinc-500 uppercase tracking-wide">fr</span>
                </BitBhListboxOption>
                <BitBhListboxOption TValue="string" Value="@("de")" Label="Germany" class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">
                    <span class="text-base">🇩🇪</span>
                    <span class="flex-1">Germany</span>
                    <span class="text-xs text-zinc-500 uppercase tracking-wide">de</span>
