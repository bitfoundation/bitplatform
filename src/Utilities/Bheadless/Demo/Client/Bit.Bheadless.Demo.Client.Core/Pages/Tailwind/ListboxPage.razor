<TwDemoBlock Title="Anchor Positioning" Code="@_anchorCode">
    <Description>
        Set <code>Anchor</code> on <code>BitBhListboxOptions</code> to automatically position
        the dropdown relative to the button using <code>position: fixed</code>. The panel
        flips to the opposite side when there's not enough space, shifts to stay within
        the viewport, and auto-updates on scroll/resize. The CSS variable
        <code>--button-width</code> is exposed so you can match the dropdown width to the trigger.
        No <code>position: relative</code> on the parent is needed.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-end gap-8">
            <div>
                <p class="text-xs text-zinc-500 mb-2">Bottom Start (width matched)</p>
                <BitBhListbox TValue="string" Value="@anchorPerson" OnValueChange="v => anchorPerson = v" class="inline-block min-w-56">
                    <BitBhListboxButton aria-label="Person" TValue="string"
                                     class="flex w-full items-center justify-between rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600">
                        <Template Context="b">
                            <span>@(string.IsNullOrEmpty(b.Value) ? "Select a person…" : b.Value)</span>
                            <span class="@($"text-zinc-500 transition-transform duration-200 {(b.IsOpen ? "rotate-180" : "")}")">▾</span>
                        </Template>
                    </BitBhListboxButton>
                    <BitBhListboxOptions TValue="string" Anchor="@(new BitBhAnchorOptions { To = "bottom start", Gap = 4 })"
                                      class="z-[9999] m-0 max-h-56 overflow-y-auto list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg w-[var(--button-width)]">
                        <BitBhListboxOption TValue="string" Value="@("Alice")"     class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">Alice</BitBhListboxOption>
                        <BitBhListboxOption TValue="string" Value="@("Benjamin")"  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">Benjamin</BitBhListboxOption>
                        <BitBhListboxOption TValue="string" Value="@("Caterina")"  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">Caterina</BitBhListboxOption>
                        <BitBhListboxOption TValue="string" Value="@("Daniel")"    class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">Daniel</BitBhListboxOption>
                        <BitBhListboxOption TValue="string" Value="@("Eleanor")"   class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">Eleanor</BitBhListboxOption>
                        <BitBhListboxOption TValue="string" Value="@("Felix")"     class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">Felix</BitBhListboxOption>
                        <BitBhListboxOption TValue="string" Value="@("Genevieve")" class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">Genevieve</BitBhListboxOption>
                        <BitBhListboxOption TValue="string" Value="@("Henry")"     class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-selected:font-semibold">Henry</BitBhListboxOption>
                    </BitBhListboxOptions>
                </BitBhListbox>
            </div>

            <div>
                <p class="text-xs text-zinc-500 mb-2">Top Start (flips down if no space)</p>
                <BitBhListbox TValue="string" Value="@anchorPerson2" OnValueChange="v => anchorPerson2 = v" class="inline-block min-w-56">
                    <BitBhListboxButton aria-label="Person" TValue="string"
                                     class="flex w-full items-center justify-between rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm cursor-pointer transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-open:border-blue-600">
                        <Template Context="b">
                            <span>@(string.IsNullOrEmpty(b.Value) ? "Select a person…" : b.Value)</span>
