@page "/tw/grid"

<PageTitle>Grid / TreeGrid — bit Bheadless · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Grid / TreeGrid</h1>
        <p class="mt-2 text-zinc-500">An interactive two-dimensional widget with roving cell focus, row selection, sorting and expandable rows.</p>
        <TwSectionSwitcher Slug="grid" />
    </header>

    <TwDemoBlock Title="Sortable data grid" Code="@_sortCode">
        <Description>
            WAI-ARIA Data Grid on a real <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">&lt;table&gt;</code> via
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">As</code>. One tab stop; arrows move between cells, Home / End,
            Ctrl + Home / End, PageUp / PageDown. Click a header or press Enter on it: <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">OnActivate</code>
            toggles the sort, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Sort</code> emits <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">aria-sort</code>,
            styled with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">group-aria-[sort=descending]:rotate-180</code>.
        </Description>
        <LiveContent>
            <div class="w-full overflow-x-auto rounded-lg border border-zinc-200 bg-white">
                <BitBhGrid As="table" aria-label="Planets" class="w-full border-collapse text-sm text-zinc-900">
                    <BitBhGridRowGroup As="thead">
                        <BitBhGridRow As="tr" IsHeaderRow="true">
                            <BitBhGridCell As="th" Header="true" Sort="@(SortOf("name"))" OnActivate="@(() => SortBy("name"))"
                                        class="group cursor-pointer select-none border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none hover:text-zinc-900 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600 aria-[sort=ascending]:text-zinc-900 aria-[sort=descending]:text-zinc-900">
                                Planet<span aria-hidden="true" class="ml-1 inline-block text-blue-600 opacity-0 transition group-hover:opacity-40 group-aria-[sort=ascending]:opacity-100 group-aria-[sort=descending]:rotate-180 group-aria-[sort=descending]:opacity-100">▲</span>
                            </BitBhGridCell>
                            <BitBhGridCell As="th" Header="true" Sort="@(SortOf("type"))" OnActivate="@(() => SortBy("type"))"
                                        class="group cursor-pointer select-none border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none hover:text-zinc-900 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600 aria-[sort=ascending]:text-zinc-900 aria-[sort=descending]:text-zinc-900">
                                Type<span aria-hidden="true" class="ml-1 inline-block text-blue-600 opacity-0 transition group-hover:opacity-40 group-aria-[sort=ascending]:opacity-100 group-aria-[sort=descending]:rotate-180 group-aria-[sort=descending]:opacity-100">▲</span>
                            </BitBhGridCell>
                            <BitBhGridCell As="th" Header="true" Sort="@(SortOf("diameter"))" OnActivate="@(() => SortBy("diameter"))"
                                        class="group cursor-pointer select-none border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-end text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none hover:text-zinc-900 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600 aria-[sort=ascending]:text-zinc-900 aria-[sort=descending]:text-zinc-900">
                                Diameter<span aria-hidden="true" class="ml-1 inline-block text-blue-600 opacity-0 transition group-hover:opacity-40 group-aria-[sort=ascending]:opacity-100 group-aria-[sort=descending]:rotate-180 group-aria-[sort=descending]:opacity-100">▲</span>
                            </BitBhGridCell>
                            <BitBhGridCell As="th" Header="true" Sort="@(SortOf("moons"))" OnActivate="@(() => SortBy("moons"))"
                                        class="group cursor-pointer select-none border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-end text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none hover:text-zinc-900 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600 aria-[sort=ascending]:text-zinc-900 aria-[sort=descending]:text-zinc-900">
                                Moons<span aria-hidden="true" class="ml-1 inline-block text-blue-600 opacity-0 transition group-hover:opacity-40 group-aria-[sort=ascending]:opacity-100 group-aria-[sort=descending]:rotate-180 group-aria-[sort=descending]:opacity-100">▲</span>
                            </BitBhGridCell>
                        </BitBhGridRow>
                    </BitBhGridRowGroup>
                    <BitBhGridRowGroup As="tbody" class="[&>tr:last-child>*]:border-b-0">
                        @foreach (var planet in SortedPlanets)
                        {
                            <BitBhGridRow As="tr" @key="planet.Name" Key="@planet.Name">
                                <BitBhGridCell As="th" RowHeader="true" class="border-b border-zinc-100 px-3 py-2 text-start font-semibold whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@planet.Name</BitBhGridCell>
                                <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@planet.Type</BitBhGridCell>
                                <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 text-end tabular-nums whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@planet.DiameterKm.ToString("N0") km</BitBhGridCell>
                                <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 text-end tabular-nums whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@planet.Moons</BitBhGridCell>
                            </BitBhGridRow>
                        }
                    </BitBhGridRowGroup>
                </BitBhGrid>
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Multi-row selection" Code="@_selectionCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">SelectionMode="BitBhGridSelectionMode.Multiple"</code> +
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">@@bind-SelectedKeys</code>. Click / Shift + click, Space,
            Shift + Space or Shift + Up / Down, Ctrl + A. Rows emit <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">aria-selected</code>:
            the boxes use <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">group-aria-selected:</code>; the header box toggles everything via
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">OnActivate</code>.
        </Description>
        <LiveContent>
            <div class="flex w-full flex-col gap-3">
                <div class="flex min-h-8 items-center justify-between gap-3 text-sm text-zinc-500">
                    <span><strong class="font-semibold text-zinc-900">@selectedInvoices.Count</strong> selected · total <strong class="font-semibold text-zinc-900">@FormatMoney(SelectedTotal)</strong></span>
                    <button type="button" disabled="@(selectedInvoices.Count == 0)" @onclick="ClearInvoices"
                            class="cursor-pointer rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-900 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:cursor-not-allowed disabled:opacity-50">Clear selection</button>
                </div>

                <div class="w-full overflow-x-auto rounded-lg border border-zinc-200 bg-white">
                    <BitBhGrid As="table" aria-label="Invoices" class="w-full border-collapse text-sm text-zinc-900"
                            SelectionMode="BitBhGridSelectionMode.Multiple"
                            @bind-SelectedKeys="selectedInvoices">
                        <BitBhGridRowGroup As="thead">
                            <BitBhGridRow As="tr" IsHeaderRow="true">
                                <BitBhGridCell As="th" Header="true" OnActivate="ToggleAllInvoices"
                                            class="w-10 cursor-pointer border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">
                                    <BitBhVisuallyHidden>Select all</BitBhVisuallyHidden>
                                    <span data-checked="@AllInvoicesState" aria-hidden="true"
                                          class="inline-flex size-4 items-center justify-center rounded border-[1.5px] border-zinc-400 bg-white align-middle text-[0.7rem] font-bold leading-none text-transparent data-[checked=true]:border-blue-600 data-[checked=true]:bg-blue-600 data-[checked=true]:text-white data-[checked=mixed]:border-blue-600 data-[checked=mixed]:bg-blue-600 data-[checked=mixed]:text-white">@(AllInvoicesState == "mixed" ? "–" : "✓")</span>
                                </BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Invoice</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Customer</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Status</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-end text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Amount</BitBhGridCell>
                            </BitBhGridRow>
                        </BitBhGridRowGroup>
                        <BitBhGridRowGroup As="tbody" class="[&>tr:last-child>*]:border-b-0">
                            @foreach (var invoice in invoices)
                            {
                                <BitBhGridRow As="tr" @key="invoice.Id" Key="@invoice.Id"
                                           class="group cursor-pointer select-none hover:bg-zinc-50 aria-selected:bg-blue-50 aria-selected:hover:bg-blue-100">
                                    <BitBhGridCell As="td" class="w-10 border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">
                                        <span aria-hidden="true"
                                              class="inline-flex size-4 items-center justify-center rounded border-[1.5px] border-zinc-400 bg-white align-middle text-[0.7rem] font-bold leading-none text-transparent group-aria-selected:border-blue-600 group-aria-selected:bg-blue-600 group-aria-selected:text-white">✓</span>
                                    </BitBhGridCell>
                                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@invoice.Id</BitBhGridCell>
                                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@invoice.Customer</BitBhGridCell>
                                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">
                                        <span data-status="@invoice.Status.ToLowerInvariant()"
                                              class="inline-block rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 data-[status=paid]:bg-green-100 data-[status=paid]:text-green-800 data-[status=pending]:bg-yellow-100 data-[status=pending]:text-yellow-800 data-[status=overdue]:bg-red-100 data-[status=overdue]:text-red-800">@invoice.Status</span>
                                    </BitBhGridCell>
                                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 text-end tabular-nums whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@FormatMoney(invoice.Amount)</BitBhGridCell>
                                </BitBhGridRow>
                            }
                        </BitBhGridRowGroup>
                    </BitBhGrid>
                </div>
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Row activation" Code="@_activationCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">OnRowActivate</code> fires with the row's
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Key</code> on Enter or double click — open a message, navigate to a
            record. Unread rows are styled with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-[unread]:font-semibold</code>.
        </Description>
        <LiveContent>
            <div class="flex w-full flex-col gap-3">
                <div class="w-full overflow-x-auto rounded-lg border border-zinc-200 bg-white">
                    <BitBhGrid As="table" aria-label="Inbox" class="w-full border-collapse text-sm text-zinc-900"
                            SelectionMode="BitBhGridSelectionMode.Single"
                            @bind-SelectedKeys="selectedMessage"
                            OnRowActivate="OpenMessage">
                        <BitBhGridRowGroup As="thead">
                            <BitBhGridRow As="tr" IsHeaderRow="true">
                                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">From</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Subject</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-end text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Received</BitBhGridCell>
                            </BitBhGridRow>
                        </BitBhGridRowGroup>
                        <BitBhGridRowGroup As="tbody" class="[&>tr:last-child>*]:border-b-0">
                            @foreach (var message in messages)
                            {
                                <BitBhGridRow As="tr" @key="message.Id" Key="@message.Id"
                                           data-unread="@(!readMessages.Contains(message.Id))"
                                           class="group cursor-pointer select-none hover:bg-zinc-50 aria-selected:bg-blue-50 aria-selected:hover:bg-blue-100 data-[unread]:font-semibold">
                                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600"><span aria-hidden="true" class="invisible mr-2 inline-block size-2 rounded-full bg-blue-600 align-middle group-data-[unread]:visible"></span>@message.From</BitBhGridCell>
                                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@message.Subject</BitBhGridCell>
                                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 text-end tabular-nums whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@message.Received</BitBhGridCell>
                                </BitBhGridRow>
                            }
                        </BitBhGridRowGroup>
                    </BitBhGrid>
                </div>

                @if (OpenedMessage is { } opened)
                {
                    <div class="rounded-lg border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm text-zinc-600">
                        <strong class="mb-1 block text-zinc-900">@opened.Subject</strong>
                        From @opened.From — @opened.Body
                    </div>
                }
                else
                {
                    <p class="text-sm text-zinc-500">Press Enter on a row, or double-click it, to open the message.</p>
                }
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="TreeGrid" Code="@_treeGridCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">TreeGrid="true"</code> + per-row
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Level</code> / <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">HasChildren</code> /
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">ParentKey</code>: collapsed descendants are <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">hidden</code>.
            Right / Left on the first cell expand / collapse; the chevron edits <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">@@bind-ExpandedKeys</code>
            and rotates with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">group-data-[state=open]:rotate-90</code>.
        </Description>
        <LiveContent>
            <div class="flex w-full flex-col gap-3">
                <div class="w-full overflow-x-auto rounded-lg border border-zinc-200 bg-white">
                    <BitBhGrid As="table" TreeGrid="true" aria-label="Project files" class="w-full border-collapse text-sm text-zinc-900"
                            SelectionMode="BitBhGridSelectionMode.Single"
                            @bind-SelectedKeys="selectedEntry"
                            @bind-ExpandedKeys="expandedFolders">
                        <BitBhGridRowGroup As="thead">
                            <BitBhGridRow As="tr" IsHeaderRow="true">
                                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Name</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Kind</BitBhGridCell>
                                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-end text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Size</BitBhGridCell>
                            </BitBhGridRow>
                        </BitBhGridRowGroup>
                        <BitBhGridRowGroup As="tbody" class="[&>tr:last-child>*]:border-b-0">
                            @foreach (var entry in fileSystem)
                            {
                                <BitBhGridRow As="tr" @key="entry.Path" Key="@entry.Path"
                                           Level="entry.Level" ParentKey="@entry.Parent" HasChildren="entry.IsFolder"
                                           class="group cursor-pointer select-none hover:bg-zinc-50 aria-selected:bg-blue-50 aria-selected:hover:bg-blue-100">
                                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">
                                        <span class="flex items-center gap-1.5 pl-[calc((var(--bit-bh-grid-level,1)_-_1)_*_1.25rem)]">
                                            @if (entry.IsFolder)
                                            {
                                                <BitBhGridRowToggle class="inline-flex size-5 flex-none cursor-pointer items-center justify-center rounded text-xs text-zinc-400 transition-transform duration-150 hover:bg-zinc-200 hover:text-zinc-900 group-data-[state=open]:rotate-90">▸</BitBhGridRowToggle>
                                                <span>@(expandedFolders.Contains(entry.Path) ? "📂" : "📁")</span>
                                            }
                                            else
                                            {
                                                <span class="w-5 flex-none"></span>
                                                <span>📄</span>
                                            }
                                            @entry.Name
                                        </span>
                                    </BitBhGridCell>
                                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@entry.Kind</BitBhGridCell>
                                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 text-end tabular-nums whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@FormatSize(SizeOf(entry))</BitBhGridCell>
                                </BitBhGridRow>
                            }
                        </BitBhGridRowGroup>
                    </BitBhGrid>
                </div>

                <p class="text-sm text-zinc-500">Selected: <strong class="font-semibold text-zinc-900">@(selectedEntry.FirstOrDefault() ?? "(none)")</strong></p>
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Div-based grid (calendar)" Code="@_calendarCode">
        <Description>
            Without <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">As</code> the grid renders
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">&lt;div role="grid"&gt;</code>, rows and cells — lay them out
            with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">grid-cols-[repeat(7,2.25rem)]</code>. Arrows move by day / week;
            Enter or click calls the cell's <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">OnActivate</code>.
        </Description>
        <LiveContent>
            <div class="flex w-full flex-col gap-3">
                <div class="inline-flex flex-col gap-2 self-start rounded-lg border border-zinc-200 bg-white p-3 text-sm text-zinc-900">
                    <div id="tw-grid-calendar-title" class="font-semibold">@MonthStart.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
                    <BitBhGrid aria-labelledby="tw-grid-calendar-title" class="flex flex-col gap-1">
                        <BitBhGridRowGroup>
                            <BitBhGridRow IsHeaderRow="true" class="grid grid-cols-[repeat(7,2.25rem)] gap-1">
                                @foreach (var (shortName, longName) in weekdays)
                                {
                                    <BitBhGridCell Header="true"
                                                class="flex h-8 items-center justify-center rounded-md text-xs font-semibold text-zinc-500 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                                        <abbr title="@longName" class="no-underline">@shortName</abbr>
                                    </BitBhGridCell>
                                }
                            </BitBhGridRow>
                        </BitBhGridRowGroup>
                        <BitBhGridRowGroup class="flex flex-col gap-1">
                            @foreach (var week in Weeks)
                            {
                                <BitBhGridRow class="grid grid-cols-[repeat(7,2.25rem)] gap-1">
                                    @foreach (var day in week)
                                    {
                                        <BitBhGridCell aria-selected="@(day == pickedDate ? "true" : null)"
                                                    aria-current="@(day == today ? "date" : null)"
                                                    aria-disabled="@(day.Month != MonthStart.Month ? "true" : null)"
                                                    OnActivate="() => PickDate(day)"
