        new("m2", "Grace Hopper", "Found a bug (an actual moth)", "08:51", "Taped it into the logbook for posterity."),
        new("m3", "Alan Turing", "Can machines think?", "Yesterday", "Let us play the imitation game this Friday."),
        new("m4", "Margaret Hamilton", "Priority displays", "Mon", "The guidance computer recovered beautifully."),
    ];

    private IReadOnlyCollection<string> selectedMessage = [];
    private readonly HashSet<string> readMessages = ["m3"];
    private string? openedMessageId;

    private Message? OpenedMessage => messages.FirstOrDefault(m => m.Id == openedMessageId);

    // Enter on any cell of the row, or a double click, passes the row's Key.
    private void OpenMessage(string id)
    {
        openedMessageId = id;
        readMessages.Add(id);
    }
}
""";

    private const string _treeGridCode = """
<div class="w-full overflow-x-auto rounded-lg border border-zinc-200 bg-white">
    <BitBhGrid As="table" TreeGrid="true" aria-label="Project files" class="w-full border-collapse text-sm text-zinc-900"
            SelectionMode="BitBhGridSelectionMode.Single"
            @bind-SelectedKeys="selectedEntry"
            @bind-ExpandedKeys="expandedFolders">
        <BitBhGridRowGroup As="thead">
            <BitBhGridRow As="tr" IsHeaderRow="true">
                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Name</BitBhGridCell>
                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-start text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Kind</BitBhGridCell>
                <BitBhGridCell As="th" Header="true" class="border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-end text-xs font-semibold uppercase tracking-wide whitespace-nowrap text-zinc-500 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">Size</BitBhGridCell>
            </BitBhGridRow>
        </BitBhGridRowGroup>
        <BitBhGridRowGroup As="tbody" class="[&>tr:last-child>*]:border-b-0">
            @foreach (var entry in fileSystem)
            {
                <BitBhGridRow As="tr" @key="entry.Path" Key="@entry.Path"
                           Level="entry.Level" ParentKey="@entry.Parent" HasChildren="entry.IsFolder"
                           class="group cursor-pointer select-none hover:bg-zinc-50 aria-selected:bg-blue-50 aria-selected:hover:bg-blue-100">
                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">
                        <span class="flex items-center gap-1.5 pl-[calc((var(--bit-bh-grid-level,1)_-_1)_*_1.25rem)]">
                            @if (entry.IsFolder)
                            {
                                <BitBhGridRowToggle class="inline-flex size-5 flex-none cursor-pointer items-center justify-center rounded text-xs text-zinc-400 transition-transform duration-150 hover:bg-zinc-200 hover:text-zinc-900 group-data-[state=open]:rotate-90">▸</BitBhGridRowToggle>
                                <span>@(expandedFolders.Contains(entry.Path) ? "📂" : "📁")</span>
                            }
                            else
                            {
                                <span class="w-5 flex-none"></span>
                                <span>📄</span>
                            }
                            @entry.Name
                        </span>
                    </BitBhGridCell>
                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@entry.Kind</BitBhGridCell>
                    <BitBhGridCell As="td" class="border-b border-zinc-100 px-3 py-2 text-end tabular-nums whitespace-nowrap outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">@FormatSize(SizeOf(entry))</BitBhGridCell>
                </BitBhGridRow>
            }
        </BitBhGridRowGroup>
    </BitBhGrid>
</div>

<p class="text-sm text-zinc-500">Selected: <strong class="font-semibold text-zinc-900">@(selectedEntry.FirstOrDefault() ?? "(none)")</strong></p>

@code {
    private sealed record FsEntry(string Path, string Name, string Kind, long Bytes, int Level, string? Parent, bool IsFolder);

    // Flattened in document (depth-first) order.
    private readonly FsEntry[] fileSystem =
    [
        new("project", "project", "Folder", 0, 1, null, true),
        new("project/src", "src", "Folder", 0, 2, "project", true),
        new("project/src/app.ts", "app.ts", "TypeScript", 14_236, 3, "project/src", false),
        new("project/src/router.ts", "router.ts", "TypeScript", 6_812, 3, "project/src", false),
        new("project/src/styles.css", "styles.css", "Stylesheet", 3_154, 3, "project/src", false),
        new("project/assets", "assets", "Folder", 0, 2, "project", true),
        new("project/assets/logo.svg", "logo.svg", "SVG image", 2_048, 3, "project/assets", false),
        new("project/assets/hero.png", "hero.png", "PNG image", 482_113, 3, "project/assets", false),
        new("project/package.json", "package.json", "JSON", 1_240, 2, "project", false),
        new("project/README.md", "README.md", "Markdown", 4_502, 2, "project", false),
        new("notes.txt", "notes.txt", "Text", 1_024, 1, null, false),
    ];

    private IReadOnlyCollection<string> selectedEntry = [];
    private IReadOnlyCollection<string> expandedFolders = ["project", "project/src"];


    private long SizeOf(FsEntry entry) =>
        entry.IsFolder ? fileSystem.Where(e => e.Parent == entry.Path).Sum(e => SizeOf(e)) : entry.Bytes;

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB",
    };
}
""";

    private const string _calendarCode = """
<div class="inline-flex flex-col gap-2 self-start rounded-lg border border-zinc-200 bg-white p-3 text-sm text-zinc-900">
    <div id="tw-grid-calendar-title" class="font-semibold">@MonthStart.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
    <BitBhGrid aria-labelledby="tw-grid-calendar-title" class="flex flex-col gap-1">
        <BitBhGridRowGroup>
            <BitBhGridRow IsHeaderRow="true" class="grid grid-cols-[repeat(7,2.25rem)] gap-1">
                @foreach (var (shortName, longName) in weekdays)
                {
                    <BitBhGridCell Header="true"
                                class="flex h-8 items-center justify-center rounded-md text-xs font-semibold text-zinc-500 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                        <abbr title="@longName" class="no-underline">@shortName</abbr>
                    </BitBhGridCell>
                }
            </BitBhGridRow>
        </BitBhGridRowGroup>
        <BitBhGridRowGroup class="flex flex-col gap-1">
            @foreach (var week in Weeks)
            {
                <BitBhGridRow class="grid grid-cols-[repeat(7,2.25rem)] gap-1">
                    @foreach (var day in week)
                    {
                        <BitBhGridCell aria-selected="@(day == pickedDate ? "true" : null)"
                                    aria-current="@(day == today ? "date" : null)"
                                    aria-disabled="@(day.Month != MonthStart.Month ? "true" : null)"
                                    OnActivate="() => PickDate(day)"
                                    class="flex h-9 cursor-pointer select-none items-center justify-center rounded-md outline-none hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 aria-[current=date]:font-bold aria-[current=date]:ring-1 aria-[current=date]:ring-inset aria-[current=date]:ring-blue-300 aria-selected:bg-blue-600 aria-selected:text-white aria-disabled:cursor-default aria-disabled:text-zinc-300 aria-disabled:hover:bg-transparent">@day.Day</BitBhGridCell>
                    }
                </BitBhGridRow>
            }
        </BitBhGridRowGroup>
    </BitBhGrid>
</div>

<p class="text-sm text-zinc-500">
    Picked: <strong class="font-semibold text-zinc-900">@(pickedDate?.ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture) ?? "(none)")</strong>
</p>

@code {
    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? pickedDate;

    private readonly (string Short, string Long)[] weekdays =
    [
        ("Su", "Sunday"), ("Mo", "Monday"), ("Tu", "Tuesday"), ("We", "Wednesday"),
        ("Th", "Thursday"), ("Fr", "Friday"), ("Sa", "Saturday"),
    ];

    private DateOnly MonthStart => new(today.Year, today.Month, 1);

    // Whole weeks (Sunday → Saturday) covering the current month.
    private IEnumerable<DateOnly[]> Weeks
    {
        get
        {
            var monthEnd = MonthStart.AddMonths(1).AddDays(-1);
            for (var start = MonthStart.AddDays(-(int)MonthStart.DayOfWeek); start <= monthEnd; start = start.AddDays(7))
            {
                var weekStart = start;
                yield return Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToArray();
            }
        }
    }

    // Days of the neighbouring months are aria-disabled and can't be picked.
    private void PickDate(DateOnly day)
    {
        if (day.Month == MonthStart.Month) pickedDate = day;
    }
}
""";
