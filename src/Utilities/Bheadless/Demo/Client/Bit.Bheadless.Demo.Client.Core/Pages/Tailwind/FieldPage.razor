@page "/tw/field"
@using System.ComponentModel.DataAnnotations

<PageTitle>Field / Input (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Field / Input</h1>
    <p class="bb-subtitle">Form primitives with auto-wired ARIA labels, descriptions, and validation state.</p>
</div>

<SectionSwitcher Slug="field" />

<TwDemoBlock Title="Basic Field" Code="@_basicCode">
    <Description>
        Wrap a label, input, and description in a <code>BitBhField</code>. The label's
        <code>for</code>, the input's <code>id</code>, and the description's
        <code>aria-describedby</code> are all wired automatically — no manual id management.
    </Description>
    <LiveContent>
        <BitBhField class="flex w-full max-w-sm flex-col gap-1.5">
            <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Email</BitBhLabel>
            <BitBhInput type="email" placeholder="you@example.com"
                     class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-50 data-disabled:opacity-50 data-disabled:cursor-not-allowed aria-invalid:border-red-600 aria-invalid:focus-visible:outline-red-600" />
            <BitBhDescription class="m-0 text-xs text-zinc-500">We'll never share your email.</BitBhDescription>
        </BitBhField>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Textarea" Code="@_textareaCode">
    <Description>
        <code>BitBhTextarea</code> works identically to <code>BitBhInput</code> — same ARIA
        wiring, same data attributes. Standard HTML attributes like <code>rows</code>
        pass through.
    </Description>
    <LiveContent>
        <BitBhField class="flex w-full max-w-sm flex-col gap-1.5">
            <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Bio</BitBhLabel>
            <BitBhTextarea rows="3" maxlength="280" placeholder="Tell us about yourself…"
                        class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-50 data-disabled:opacity-50 data-disabled:cursor-not-allowed aria-invalid:border-red-600 aria-invalid:focus-visible:outline-red-600 resize-y min-h-16" />
            <BitBhDescription class="m-0 text-xs text-zinc-500">Max 280 characters.</BitBhDescription>
        </BitBhField>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Select" Code="@_selectCode">
    <Description>
        <code>BitBhSelect</code> renders a native <code>&lt;select&gt;</code> with the same
        auto-wired ARIA. Place <code>&lt;option&gt;</code> elements inside.
    </Description>
    <LiveContent>
        <BitBhField class="flex w-full max-w-sm flex-col gap-1.5">
            <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Country</BitBhLabel>
            <div class="relative">
                <BitBhSelect class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-50 data-disabled:opacity-50 data-disabled:cursor-not-allowed w-full appearance-none pr-8">
                    <option value="">Choose…</option>
                    <option value="us">United States</option>
                    <option value="gb">United Kingdom</option>
                    <option value="fr">France</option>
                    <option value="de">Germany</option>
                </BitBhSelect>
                <svg aria-hidden="true" viewBox="0 0 16 16" class="pointer-events-none absolute top-1/2 right-2.5 size-4 -translate-y-1/2 text-zinc-500"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <BitBhDescription class="m-0 text-xs text-zinc-500">Where you're based.</BitBhDescription>
        </BitBhField>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Disabled Field" Code="@_disabledCode">
    <Description>
        Set <code>Disabled="true"</code> on the <code>BitBhField</code> to disable all
        children at once. The field, label, and input all receive <code>data-disabled</code>:
        the CSS version styles them with <code>[data-disabled]</code> selectors, the Tailwind
        version with the <code>data-disabled:</code> variant.
    </Description>
    <LiveContent>
        <BitBhField Disabled="true" class="flex w-full max-w-sm flex-col gap-1.5">
            <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Username</BitBhLabel>
            <BitBhInput type="text" value="alice"
                     class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 data-disabled:bg-zinc-50 data-disabled:opacity-50 data-disabled:cursor-not-allowed" />
            <BitBhDescription class="m-0 text-xs text-zinc-500">Cannot be changed.</BitBhDescription>
        </BitBhField>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Invalid Field" Code="@_invalidCode">
    <Description>
        Set <code>Invalid="true"</code> on the <code>BitBhField</code> to mark the input
        as invalid. The input receives <code>aria-invalid="true"</code> and
        <code>data-invalid</code>. Use the description to show an error message. The CSS version
        styles the input with a <code>[data-invalid]</code> selector, the Tailwind version with
        Tailwind's built-in <code>aria-invalid:</code> variant.
    </Description>
    <LiveContent>
        <BitBhField Invalid="true" class="flex w-full max-w-sm flex-col gap-1.5">
            <BitBhLabel class="text-sm font-semibold text-zinc-900 data-disabled:opacity-50">Password</BitBhLabel>
            <BitBhInput type="password" value="123"
                     class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 aria-invalid:border-red-600 aria-invalid:focus-visible:outline-red-600" />
            <BitBhDescription class="m-0 text-xs text-red-600">
                Password must be at least 8 characters.
            </BitBhDescription>
        </BitBhField>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Multiple Fields (form layout)" Code="@_formCode">
    <Description>
        Compose multiple <code>BitBhField</code> components into a form. Each field
        manages its own id namespace — no collisions.
    </Description>
    <LiveContent>
        <form class="flex w-full max-w-sm flex-col gap-4" @onsubmit:preventDefault>
            <BitBhField class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900">First name</BitBhLabel>
                <BitBhInput type="text" placeholder="Alice"
                         class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600" />
            </BitBhField>
            <BitBhField class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900">Last name</BitBhLabel>
                <BitBhInput type="text" placeholder="Anderson"
                         class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600" />
            </BitBhField>
            <BitBhField class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900">Email</BitBhLabel>
                <BitBhInput type="email" placeholder="alice@example.com"
                         class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600" />
                <BitBhDescription class="m-0 text-xs text-zinc-500">Your work email.</BitBhDescription>
            </BitBhField>
            <BitBhButton Type="submit"
                      class="inline-flex items-center justify-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-4 py-2 text-sm font-medium text-white cursor-pointer hover:bg-blue-700 self-start">
                Submit
            </BitBhButton>
        </form>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="EditForm validation" Code="@_editFormCode">
    <Description>
        Inside an <code>EditForm</code> with <code>DataAnnotationsValidator</code>, every control bound
        with <code>@@bind-Value</code> / <code>@@bind-Checked</code> reports its validation state to its
        <code>BitBhField</code>: the control gets <code>aria-invalid="true"</code> and
        <code>data-invalid</code>, and <code>BitBhErrorMessage</code> appears with the messages and is
        added to the control's <code>aria-describedby</code> — no ids to wire. Non-native controls work
        too: the radio group is named by its <code>BitBhLabel</code> via <code>aria-labelledby</code>, and
        clicking the label focuses the group. Because these components take plain child content, they
        nest inside <code>EditForm</code> without <code>Context</code> clashes. Submit empty to see it.
        The CSS version styles the invalid state with <code>[data-invalid]</code> /
        <code>[aria-invalid]</code> selectors, the Tailwind version with the <code>data-invalid:</code> /
        <code>aria-invalid:</code> variants.
    </Description>
    <LiveContent>
        <EditForm Model="signup" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="() => signupResult = null"
                  novalidate="@true" class="flex w-full max-w-sm flex-col gap-4">
            <DataAnnotationsValidator />

            <BitBhField Required="true" class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900 data-invalid:text-red-700 data-required:after:ml-0.5 data-required:after:text-red-600 data-required:after:content-['*']">Full name</BitBhLabel>
                <BitBhInput @bind-Value="signup.Name" autocomplete="name"
                         class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 aria-invalid:border-red-600 aria-invalid:focus-visible:outline-red-600" />
                <BitBhErrorMessage class="m-0 flex items-center gap-1.5 text-xs font-medium text-red-600 before:inline-flex before:size-3.5 before:items-center before:justify-center before:rounded-full before:bg-red-600 before:text-[0.6rem] before:font-bold before:text-white before:content-['!']" />
            </BitBhField>

            <BitBhField Required="true" class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900 data-invalid:text-red-700 data-required:after:ml-0.5 data-required:after:text-red-600 data-required:after:content-['*']">Email</BitBhLabel>
                <BitBhDescription class="m-0 text-xs text-zinc-500">We'll send the receipt here.</BitBhDescription>
                <BitBhInput type="email" @bind-Value="signup.Email" autocomplete="email"
                         class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600 aria-invalid:border-red-600 aria-invalid:focus-visible:outline-red-600" />
                <BitBhErrorMessage class="m-0 flex items-center gap-1.5 text-xs font-medium text-red-600 before:inline-flex before:size-3.5 before:items-center before:justify-center before:rounded-full before:bg-red-600 before:text-[0.6rem] before:font-bold before:text-white before:content-['!']" />
            </BitBhField>

            <BitBhField Required="true" class="flex w-full flex-col gap-1.5">
                <BitBhLabel class="text-sm font-semibold text-zinc-900 data-invalid:text-red-700 data-required:after:ml-0.5 data-required:after:text-red-600 data-required:after:content-['*']">Plan</BitBhLabel>
                <BitBhRadioGroup @bind-Value="signup.Plan" Vertical="false" class="group/radios flex flex-wrap gap-2">
                    <BitBhRadio Value="Free" class="group inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-1.5 text-sm text-zinc-900 cursor-pointer group-aria-invalid/radios:border-red-300 data-state-checked:border-blue-600 data-state-checked:bg-blue-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                        <span aria-hidden="true" class="size-3.5 rounded-full border border-zinc-400 bg-white group-data-state-checked:border-4 group-data-state-checked:border-blue-600"></span>Free
                    </BitBhRadio>
                    <BitBhRadio Value="Pro" class="group inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-1.5 text-sm text-zinc-900 cursor-pointer group-aria-invalid/radios:border-red-300 data-state-checked:border-blue-600 data-state-checked:bg-blue-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                        <span aria-hidden="true" class="size-3.5 rounded-full border border-zinc-400 bg-white group-data-state-checked:border-4 group-data-state-checked:border-blue-600"></span>Pro
                    </BitBhRadio>
                    <BitBhRadio Value="Team" class="group inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-1.5 text-sm text-zinc-900 cursor-pointer group-aria-invalid/radios:border-red-300 data-state-checked:border-blue-600 data-state-checked:bg-blue-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                        <span aria-hidden="true" class="size-3.5 rounded-full border border-zinc-400 bg-white group-data-state-checked:border-4 group-data-state-checked:border-blue-600"></span>Team
                    </BitBhRadio>
                </BitBhRadioGroup>
                <BitBhErrorMessage class="m-0 flex items-center gap-1.5 text-xs font-medium text-red-600 before:inline-flex before:size-3.5 before:items-center before:justify-center before:rounded-full before:bg-red-600 before:text-[0.6rem] before:font-bold before:text-white before:content-['!']" />
            </BitBhField>

            <BitBhField class="flex w-full flex-col gap-1.5">
                <div class="flex items-center gap-2">
                    <BitBhCheckbox @bind-Checked="signup.AcceptTerms"
                                class="inline-flex h-[1.15rem] w-[1.15rem] shrink-0 items-center justify-center rounded border border-zinc-500 bg-white text-white cursor-pointer transition-colors hover:border-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:border-blue-600 data-state-checked:bg-blue-600 aria-invalid:border-red-600">
                        <BitBhCheckboxIndicator class="text-sm leading-none">✓</BitBhCheckboxIndicator>
                    </BitBhCheckbox>
                    <BitBhLabel class="text-sm text-zinc-900 cursor-pointer">I accept the terms of service</BitBhLabel>
                </div>
                <BitBhErrorMessage class="m-0 flex items-center gap-1.5 text-xs font-medium text-red-600 before:inline-flex before:size-3.5 before:items-center before:justify-center before:rounded-full before:bg-red-600 before:text-[0.6rem] before:font-bold before:text-white before:content-['!']" />
            </BitBhField>

            <div class="flex gap-2">
                <button type="submit"
                        class="inline-flex items-center justify-center rounded-lg border border-blue-600 bg-blue-600 px-4 py-2 text-sm font-medium text-white cursor-pointer hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                    Create account
                </button>
                <button type="button" @onclick="ResetSignup"
                        class="inline-flex items-center justify-center rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                    Reset
                </button>
            </div>

            <BitBhLiveRegion class="text-sm text-green-800 not-empty:rounded-lg not-empty:border not-empty:border-green-200 not-empty:bg-green-50 not-empty:px-3.5 not-empty:py-2.5">@signupResult</BitBhLiveRegion>
        </EditForm>
    </LiveContent>
</TwDemoBlock>

@code {
    // ── EditForm validation ───────────────────────────────────────────────────

    private sealed class SignupModel
    {
        [Required(ErrorMessage = "Please enter your name.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Please enter your email.")]
        [EmailAddress(ErrorMessage = "That doesn't look like an email address.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Pick a plan.")]
        public string? Plan { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the terms.")]
        public bool AcceptTerms { get; set; }
    }

    private SignupModel signup = new();
    private string? signupResult;

    private void HandleValidSubmit() =>
        signupResult = $"Welcome aboard, {signup.Name}! You're on the {signup.Plan} plan.";

    private void ResetSignup()
    {
        signup = new();
        signupResult = null;
    }

    private const string _editFormCode = """
@using System.ComponentModel.DataAnnotations

@* novalidate: let DataAnnotations (not the browser) report errors *@
<EditForm Model="signup" OnValidSubmit="HandleValidSubmit" novalidate="@true" class="flex w-full max-w-sm flex-col gap-4">
    <DataAnnotationsValidator />

    <BitBhField Required="true" class="flex w-full flex-col gap-1.5">
        <BitBhLabel class="text-sm font-semibold text-zinc-900 data-invalid:text-red-700 data-required:after:ml-0.5 data-required:after:text-red-600 data-required:after:content-['*']">Full name</BitBhLabel>
        <BitBhInput @bind-Value="signup.Name" autocomplete="name"
                 class="rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-blue-600 aria-invalid:border-red-600 aria-invalid:focus-visible:outline-red-600" />
        @* Only rendered while invalid; referenced by the input's aria-describedby *@
        <BitBhErrorMessage class="m-0 flex items-center gap-1.5 text-xs font-medium text-red-600 before:inline-flex before:size-3.5 before:items-center before:justify-center before:rounded-full before:bg-red-600 before:text-[0.6rem] before:font-bold before:text-white before:content-['!']" />
    </BitBhField>

    <BitBhField Required="true" class="flex w-full flex-col gap-1.5">
        <BitBhLabel class="...">Email</BitBhLabel>
        <BitBhDescription class="m-0 text-xs text-zinc-500">We'll send the receipt here.</BitBhDescription>
        <BitBhInput type="email" @bind-Value="signup.Email" autocomplete="email" class="..." />
        <BitBhErrorMessage class="..." />
    </BitBhField>

    @* Non-native control: labelled via aria-labelledby, focused by a label click *@
    <BitBhField Required="true" class="flex w-full flex-col gap-1.5">
        <BitBhLabel class="...">Plan</BitBhLabel>
        <BitBhRadioGroup @bind-Value="signup.Plan" Vertical="false" class="group/radios flex flex-wrap gap-2">
            <BitBhRadio Value="Free"
                     class="group inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-1.5 text-sm group-aria-invalid/radios:border-red-300 data-state-checked:border-blue-600 data-state-checked:bg-blue-50">
                <span aria-hidden="true" class="size-3.5 rounded-full border border-zinc-400 bg-white group-data-state-checked:border-4 group-data-state-checked:border-blue-600"></span>Free
            </BitBhRadio>
            <BitBhRadio Value="Pro" class="...">…Pro</BitBhRadio>
            <BitBhRadio Value="Team" class="...">…Team</BitBhRadio>
        </BitBhRadioGroup>
        <BitBhErrorMessage class="..." />
    </BitBhField>

    <BitBhField class="flex w-full flex-col gap-1.5">
        <div class="flex items-center gap-2">
            <BitBhCheckbox @bind-Checked="signup.AcceptTerms"
                        class="inline-flex h-[1.15rem] w-[1.15rem] items-center justify-center rounded border border-zinc-500 bg-white text-white data-state-checked:border-blue-600 data-state-checked:bg-blue-600 aria-invalid:border-red-600">
                <BitBhCheckboxIndicator class="text-sm leading-none">✓</BitBhCheckboxIndicator>
            </BitBhCheckbox>
            <BitBhLabel class="text-sm cursor-pointer">I accept the terms of service</BitBhLabel>
        </div>
        <BitBhErrorMessage class="..." />
    </BitBhField>

    <button type="submit" class="...">Create account</button>

    <BitBhLiveRegion class="text-sm text-green-800 not-empty:rounded-lg not-empty:border not-empty:border-green-200 not-empty:bg-green-50 not-empty:px-3.5 not-empty:py-2.5">@signupResult</BitBhLiveRegion>
</EditForm>

@code {
