@page "/tw/toast"
@implements IDisposable
@inject BitBhToaster Toaster

<PageTitle>Toast (Tailwind) · Bheadless</PageTitle>

<div class="bb-intro">
    <h1>Toast</h1>
    <p class="bb-subtitle">Short, non-blocking notifications — queued from anywhere, announced to screen readers, dismissed automatically.</p>
</div>

<SectionSwitcher Slug="toast" />

<TwDemoBlock Title="Simple toast" Code="@_simpleCode">
    <Description>
        Inject <code>BitBhToaster</code> (registered by <code>AddBitBheadlessServices()</code>) and call
        <code>Show</code>. Toasts appear in a <code>BitBhToastViewport</code> — a
        <code>role="region"</code> landmark labelled "Notifications (F8)"; press <code>F8</code>
        to jump to it. Every toast is announced through the shared live region, auto-dismisses
        after the viewport's <code>Duration</code> (paused while hovered or focused) and closes
        with <code>Escape</code> or a <code>BitBhToastClose</code>. Toasts emit
        <code>data-state="open|closed"</code> and the exit animation is awaited before removal: the CSS
        version animates them with keyframes on <code>[data-state]</code>, the Tailwind version with
        <code>starting:</code> and <code>data-state-closed:</code> transitions.
    </Description>
    <LiveContent>
        <BitBhButton OnClick="ShowSimple"
                  class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
            Show toast
        </BitBhButton>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="With a description" Code="@_descriptionCode">
    <Description>
        Pass a description and render it with <code>BitBhToastDescription</code>. Title and
        description are announced together ("Changes saved. Your profile is now visible…").
        <code>Data</code> carries anything your template needs — here a variant that picks the icon
        and is set as <code>data-variant</code> on the toast.
    </Description>
    <LiveContent>
        <BitBhButton OnClick="ShowWithDescription"
                  class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-3 py-1.5 text-sm font-medium text-white cursor-pointer hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
            Save profile
        </BitBhButton>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="With an action" Code="@_actionCode">
    <Description>
        Set <code>ActionLabel</code> and <code>OnAction</code>; <code>BitBhToastAction</code> renders
        the button, runs the callback and dismisses the toast. Toasts disappear, so keep the action
        reachable elsewhere too — here "Restore all" stays on the page.
    </Description>
    <LiveContent>
        <div class="flex w-full flex-col gap-3">
            @if (inbox.Count == 0)
            {
                <p class="text-sm italic text-zinc-500">Inbox zero. 🎉</p>
            }
            else
            {
                <ul class="m-0 flex w-full max-w-sm list-none flex-col gap-1.5 p-0">
                    @foreach (var message in inbox)
                    {
                        <li class="flex items-center justify-between gap-3 rounded-lg border border-zinc-200 bg-white py-2 pl-3.5 pr-2 text-sm text-zinc-900" @key="message">
                            <span>@message</span>
                            <BitBhButton OnClick="() => Archive(message)"
                                      class="inline-flex items-center rounded-md border border-zinc-200 bg-white px-2.5 py-1 text-xs font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                                Archive
                            </BitBhButton>
                        </li>
                    }
                </ul>
            }
            @if (inbox.Count < AllMessages.Length)
            {
                <div>
                    <BitBhButton OnClick="RestoreAll"
                              class="rounded-md px-1 text-sm font-medium text-blue-600 underline underline-offset-2 cursor-pointer hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                        Restore all
                    </BitBhButton>
                </div>
            }
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Foreground (assertive) error" Code="@_errorCode">
    <Description>
        Toasts are background (<code>role="status"</code>, announced politely) by default. Set
        <code>Foreground = true</code> for the direct result of a user action that needs attention:
        it is announced assertively (<code>role="alert"</code>) and the toast gets
        <code>data-type="foreground"</code>.
    </Description>
    <LiveContent>
        <BitBhButton OnClick="ShowError"
                  class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
            Pay $49.00
        </BitBhButton>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Custom duration and persistent toasts" Code="@_durationCode">
    <Description>
        <code>Duration</code> (ms) on a toast overrides the viewport's default (5000 ms).
        <code>Duration = 0</code> keeps the toast until it is dismissed. <code>Clear()</code>
        dismisses every toast.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-center gap-2">
            <BitBhButton OnClick="() => ShowTimed(2000)"
                      class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                2 seconds
            </BitBhButton>
            <BitBhButton OnClick="() => ShowTimed(10000)"
                      class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                10 seconds
            </BitBhButton>
            <BitBhButton OnClick="ShowPersistent"
                      class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                Persistent
            </BitBhButton>
            <BitBhButton OnClick="() => Toaster.Clear()"
                      class="rounded-md px-2 py-1.5 text-sm font-medium text-blue-600 underline underline-offset-2 cursor-pointer hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                Dismiss all
            </BitBhButton>
        </div>
    </LiveContent>
</TwDemoBlock>

<TwDemoBlock Title="Stacking with Limit" Code="@_stackCode">
    <Description>
        <code>BitBhToaster.Limit</code> (default 5) caps how many toasts are kept — the oldest is
        dropped when a new one arrives. This demo creates its own toaster with
        <code>Limit = 3</code> and renders it in a second viewport (passed through
        <code>Toaster</code>, bottom-left, <code>Shift+F8</code>) styled as a stack: the toasts overlap
        in one grid cell and fan out on hover or keyboard focus. The CSS version offsets the older
        toasts with <code>:nth-last-child</code>; the Tailwind version picks per-depth utilities from
        each toast's position in <code>Toasts</code>.
    </Description>
    <LiveContent>
        <div class="flex flex-wrap items-center gap-3">
            <BitBhButton OnClick="AddStacked"
                      class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                Add notification
            </BitBhButton>
            <span class="text-sm text-zinc-500">Shown: <strong class="text-zinc-900">@stackToaster.Toasts.Count</strong> of max @stackToaster.Limit</span>
        </div>
    </LiveContent>
</TwDemoBlock>

@* One viewport renders every toast shown through the injected BitBhToaster.
   In a real app it lives in MainLayout.razor. *@
<BitBhToastViewport Context="t" Duration="5000"
                 class="fixed bottom-4 right-4 z-100 m-0 flex w-[min(22rem,calc(100vw-2rem))] list-none flex-col gap-2 p-0 focus-visible:rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600">
    <BitBhToast Item="t" data-variant="@(t.Data ?? "info")"
             class="group flex items-start gap-3 rounded-xl border border-zinc-200 bg-white py-3.5 pl-4 pr-3 text-sm text-zinc-900 shadow-lg transition duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 starting:translate-y-3 starting:opacity-0 data-state-closed:translate-x-[calc(100%+1rem)] data-state-closed:opacity-0 data-state-closed:duration-150 data-state-closed:ease-in data-[variant=error]:border-red-200 data-[variant=error]:bg-red-50 motion-reduce:transition-none">
        @if (t.Data is "success" or "error")
        {
            <span aria-hidden="true"
                  class="mt-px inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-green-600 text-[0.7rem] font-bold text-white group-data-[variant=error]:bg-red-600">
                @(t.Data is "error" ? "!" : "✓")
            </span>
        }
        <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <BitBhToastTitle class="font-semibold group-data-[variant=error]:text-red-800">@t.Title</BitBhToastTitle>
            @if (t.Description is not null)
            {
                <BitBhToastDescription class="text-zinc-600">@t.Description</BitBhToastDescription>
            }
        </div>
        @if (t.Options.ActionLabel is not null)
        {
            <BitBhToastAction class="shrink-0 self-center rounded-md border border-zinc-300 bg-white px-2.5 py-1 text-xs font-semibold text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" />
        }
        <BitBhToastClose aria-label="Dismiss notification"
                      class="inline-flex size-6 shrink-0 items-center justify-center rounded-md text-lg leading-none text-zinc-500 cursor-pointer hover:bg-zinc-100 hover:text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600">
            ×
        </BitBhToastClose>
    </BitBhToast>
</BitBhToastViewport>

@* A second, independent toaster for the stacking demo. *@
<BitBhToastViewport Toaster="stackToaster" Label="Stacked notifications" Hotkey="shift+F8"
                 Context="t" Duration="8000"
                 class="group/stack fixed bottom-4 left-4 max-md:top-4 max-md:bottom-auto z-100 m-0 grid w-[min(20rem,calc(100vw-2rem))] list-none p-0 hover:flex hover:flex-col hover:gap-2 focus-within:flex focus-within:flex-col focus-within:gap-2 focus-visible:rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600">
    <BitBhToast Item="t"
             class="@($"col-start-1 row-start-1 relative flex origin-bottom items-start gap-3 self-end group-hover/stack:self-stretch group-focus-within/stack:self-stretch rounded-xl border border-zinc-200 bg-white py-3.5 pl-4 pr-3 text-sm text-zinc-900 shadow-lg transition duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 starting:translate-y-3 starting:opacity-0 data-state-closed:translate-x-[calc(100%+1rem)] data-state-closed:opacity-0 motion-reduce:transition-none {StackClass(StackDepth(t))}")">
        <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <BitBhToastTitle class="font-semibold">@t.Title</BitBhToastTitle>
            <BitBhToastDescription class="text-zinc-600">@t.Description</BitBhToastDescription>
        </div>
        <BitBhToastClose aria-label="Dismiss notification"
                      class="inline-flex size-6 shrink-0 items-center justify-center rounded-md text-lg leading-none text-zinc-500 cursor-pointer hover:bg-zinc-100 hover:text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600">
            ×
        </BitBhToastClose>
    </BitBhToast>
</BitBhToastViewport>

@code {
    private static readonly string[] AllMessages = ["Quarterly report", "Team offsite plan", "Invoice #1042"];
    private readonly List<string> inbox = new(AllMessages);

    private readonly BitBhToaster stackToaster = new() { Limit = 3 };
    private int stackCount;

    // Keep the "Shown: n" readout in sync when stacked toasts auto-dismiss.
    protected override void OnInitialized() => stackToaster.Changed += OnStackChanged;
    private void OnStackChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => stackToaster.Changed -= OnStackChanged;

    private void ShowSimple() => Toaster.Show("Event created");

    private void ShowWithDescription() => Toaster.Show(new BitBhToastOptions
    {
        Title = "Changes saved",
        Description = "Your profile is now visible to your team.",
        Data = "success",
    });

    private void Archive(string message)
    {
        var index = inbox.IndexOf(message);
        inbox.RemoveAt(index);
        Toaster.Show(new BitBhToastOptions
        {
            Title = "Conversation archived",
            Description = message,
            ActionLabel = "Undo",
            OnAction = () =>
            {
                if (!inbox.Contains(message)) inbox.Insert(Math.Min(index, inbox.Count), message);
                return InvokeAsync(StateHasChanged);
            },
        });
    }

    private void RestoreAll()
    {
        inbox.Clear();
        inbox.AddRange(AllMessages);
    }

    private void ShowError() => Toaster.Show(new BitBhToastOptions
    {
        Title = "Payment failed",
        Description = "Your card was declined. Try another payment method.",
        Foreground = true,
        Data = "error",
    });

    private void ShowTimed(int milliseconds) => Toaster.Show(new BitBhToastOptions
    {
        Title = $"Closes in {milliseconds / 1000} seconds",
        Description = "Hover or focus it to pause the timer.",
        Duration = milliseconds,
    });

    private void ShowPersistent() => Toaster.Show(new BitBhToastOptions
    {
        Title = "Update available",
        Description = "This toast stays until you dismiss it.",
        Duration = 0,
    });

    private void AddStacked()
    {
        stackCount++;
        stackToaster.Show(new BitBhToastOptions
        {
            Title = $"Notification {stackCount}",
            Description = $"Received at {DateTime.Now:HH:mm:ss}.",
        });
    }

    // 0 = newest (front of the stack).
    private int StackDepth(BitBhToastItem toast)
    {
        var toasts = stackToaster.Toasts;
        for (var i = 0; i < toasts.Count; i++)
        {
            if (ReferenceEquals(toasts[i], toast)) return toasts.Count - 1 - i;
        }
        return 0;
    }

    private static string StackClass(int depth) => depth switch
    {
        0 => "",
        1 => "-translate-y-3 scale-95 opacity-90 group-hover/stack:translate-y-0 group-hover/stack:scale-100 group-hover/stack:opacity-100 group-focus-within/stack:translate-y-0 group-focus-within/stack:scale-100 group-focus-within/stack:opacity-100",
        _ => "-translate-y-6 scale-90 opacity-75 group-hover/stack:translate-y-0 group-hover/stack:scale-100 group-hover/stack:opacity-100 group-focus-within/stack:translate-y-0 group-focus-within/stack:scale-100 group-focus-within/stack:opacity-100",
    };

    private const string _simpleCode = """
@inject BitBhToaster Toaster

<BitBhButton OnClick="ShowSimple" class="... rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium">
    Show toast
</BitBhButton>

@* Place ONE viewport in your layout (e.g. MainLayout.razor). *@
<BitBhToastViewport Context="t" Duration="5000"
