    <BitBhToast Item="t" data-variant="@(t.Data ?? "info")"
             class="group flex items-start gap-3 rounded-xl border border-zinc-200 bg-white py-3.5 pl-4 pr-3 text-sm text-zinc-900 shadow-lg
                    transition duration-200 ease-out
                    starting:translate-y-3 starting:opacity-0
                    data-state-closed:translate-x-[calc(100%+1rem)] data-state-closed:opacity-0 data-state-closed:duration-150 data-state-closed:ease-in
                    data-[variant=error]:border-red-200 data-[variant=error]:bg-red-50
                    focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 motion-reduce:transition-none">
        @if (t.Data is "success" or "error")
        {
            <span aria-hidden="true" class="mt-px inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-green-600 text-[0.7rem] font-bold text-white group-data-[variant=error]:bg-red-600">
                @(t.Data is "error" ? "!" : "✓")
            </span>
        }
        <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <BitBhToastTitle class="font-semibold group-data-[variant=error]:text-red-800">@t.Title</BitBhToastTitle>
            @if (t.Description is not null)
            {
                <BitBhToastDescription class="text-zinc-600">@t.Description</BitBhToastDescription>
            }
        </div>
        @if (t.Options.ActionLabel is not null)
        {
            <BitBhToastAction class="shrink-0 self-center rounded-md border border-zinc-300 bg-white px-2.5 py-1 text-xs font-semibold hover:bg-zinc-100" />
        }
        <BitBhToastClose aria-label="Dismiss notification"
                      class="inline-flex size-6 shrink-0 items-center justify-center rounded-md text-lg leading-none text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900">
            ×
        </BitBhToastClose>
    </BitBhToast>
</BitBhToastViewport>

@code {
