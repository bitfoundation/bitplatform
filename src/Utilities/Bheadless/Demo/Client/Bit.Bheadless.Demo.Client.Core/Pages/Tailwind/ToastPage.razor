@page "/tw/toast"
@implements IDisposable
@inject BitBhToaster Toaster

<PageTitle>Toast — bit Bheadless · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Toast</h1>
        <p class="mt-2 text-zinc-500">Short, non-blocking notifications — queued from anywhere, announced to screen readers, dismissed automatically.</p>
        <TwSectionSwitcher Slug="toast" />
    </header>

    <TwDemoBlock Title="Simple toast" Code="@_simpleCode">
        <Description>
            Inject <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhToaster</code> and call <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Show</code>.
            The <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhToastViewport</code> is a "Notifications (F8)" landmark — press <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">F8</code> to reach it.
            Toasts are announced automatically, pause while hovered or focused, and enter / exit with
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">starting:</code> and <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-state-closed:</code> transitions (the exit is awaited).
        </Description>
        <LiveContent>
            <BitBhButton OnClick="ShowSimple"
                      class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                Show toast
            </BitBhButton>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="With a description" Code="@_descriptionCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhToastDescription</code> renders the description; title and description are announced together.
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Data</code> carries a variant for the template (<code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-[variant=success]:</code>).
        </Description>
        <LiveContent>
            <BitBhButton OnClick="ShowWithDescription"
                      class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-3 py-1.5 text-sm font-medium text-white cursor-pointer hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                Save profile
            </BitBhButton>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="With an action" Code="@_actionCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">ActionLabel</code> + <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">OnAction</code> power <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BitBhToastAction</code>, which runs the callback and dismisses the toast.
            Keep the action reachable elsewhere too ("Restore all").
        </Description>
        <LiveContent>
            <div class="flex w-full flex-col gap-3">
                @if (inbox.Count == 0)
                {
                    <p class="text-sm italic text-zinc-500">Inbox zero. 🎉</p>
                }
                else
                {
                    <ul class="m-0 flex w-full max-w-sm list-none flex-col gap-1.5 p-0">
                        @foreach (var message in inbox)
                        {
                            <li class="flex items-center justify-between gap-3 rounded-lg border border-zinc-200 bg-white py-2 pl-3.5 pr-2 text-sm text-zinc-900" @key="message">
                                <span>@message</span>
                                <BitBhButton OnClick="() => Archive(message)"
                                          class="inline-flex items-center rounded-md border border-zinc-200 bg-white px-2.5 py-1 text-xs font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                                    Archive
                                </BitBhButton>
                            </li>
                        }
                    </ul>
                }
                @if (inbox.Count < AllMessages.Length)
                {
                    <div>
                        <BitBhButton OnClick="RestoreAll"
                                  class="rounded-md px-1 text-sm font-medium text-blue-600 underline underline-offset-2 cursor-pointer hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                            Restore all
                        </BitBhButton>
                    </div>
                }
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Foreground (assertive) error" Code="@_errorCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Foreground = true</code> announces assertively (<code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">role="alert"</code>) and sets <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-type="foreground"</code>.
            Use it for the direct result of a user action that needs attention.
        </Description>
        <LiveContent>
            <BitBhButton OnClick="ShowError"
                      class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                Pay $49.00
            </BitBhButton>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Custom duration and persistent toasts" Code="@_durationCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Duration</code> (ms) overrides the viewport default; <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Duration = 0</code> keeps the toast until dismissed.
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Clear()</code> dismisses everything.
        </Description>
        <LiveContent>
            <div class="flex flex-wrap items-center gap-2">
                <BitBhButton OnClick="() => ShowTimed(2000)"
                          class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                    2 seconds
                </BitBhButton>
                <BitBhButton OnClick="() => ShowTimed(10000)"
                          class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                    10 seconds
                </BitBhButton>
                <BitBhButton OnClick="ShowPersistent"
                          class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                    Persistent
                </BitBhButton>
                <BitBhButton OnClick="() => Toaster.Clear()"
                          class="rounded-md px-2 py-1.5 text-sm font-medium text-blue-600 underline underline-offset-2 cursor-pointer hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                    Dismiss all
                </BitBhButton>
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Stacking with Limit" Code="@_stackCode">
        <Description>
            A page-owned toaster with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Limit = 3</code> (the oldest is dropped beyond that) feeds a second viewport via
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Toaster</code> (bottom-left, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Shift+F8</code>). Toasts overlap in one grid cell and fan out on hover or focus.
        </Description>
        <LiveContent>
            <div class="flex flex-wrap items-center gap-3">
                <BitBhButton OnClick="AddStacked"
                          class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
                    Add notification
                </BitBhButton>
                <span class="text-sm text-zinc-500">Shown: <strong class="text-zinc-900">@stackToaster.Toasts.Count</strong> of max @stackToaster.Limit</span>
            </div>
        </LiveContent>
    </TwDemoBlock>

    @* One viewport renders every toast shown through the injected BitBhToaster.
       In a real app it lives in MainLayout.razor. *@
    <BitBhToastViewport Context="t" Duration="5000"
                     class="fixed bottom-4 right-4 z-100 m-0 flex w-[min(22rem,calc(100vw-2rem))] list-none flex-col gap-2 p-0 outline-none focus-visible:rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600">
        <BitBhToast Item="t" data-variant="@(t.Data ?? "info")"
                 class="group flex items-start gap-3 rounded-xl border border-zinc-200 bg-white py-3.5 pl-4 pr-3 text-sm text-zinc-900 shadow-lg outline-none transition duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 starting:translate-y-3 starting:opacity-0 data-state-closed:translate-x-[calc(100%+1rem)] data-state-closed:opacity-0 data-state-closed:duration-150 data-state-closed:ease-in data-[variant=error]:border-red-200 data-[variant=error]:bg-red-50 motion-reduce:transition-none">
            @if (t.Data is "success" or "error")
            {
                <span aria-hidden="true"
                      class="mt-px inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-green-600 text-[0.7rem] font-bold text-white group-data-[variant=error]:bg-red-600">
                    @(t.Data is "error" ? "!" : "✓")
                </span>
            }
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                <BitBhToastTitle class="font-semibold group-data-[variant=error]:text-red-800">@t.Title</BitBhToastTitle>
                @if (t.Description is not null)
                {
                    <BitBhToastDescription class="text-zinc-600">@t.Description</BitBhToastDescription>
                }
            </div>
            @if (t.Options.ActionLabel is not null)
            {
                <BitBhToastAction class="shrink-0 self-center rounded-md border border-zinc-300 bg-white px-2.5 py-1 text-xs font-semibold text-zinc-900 cursor-pointer hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" />
            }
            <BitBhToastClose aria-label="Dismiss notification"
                          class="inline-flex size-6 shrink-0 items-center justify-center rounded-md text-lg leading-none text-zinc-500 cursor-pointer hover:bg-zinc-100 hover:text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600">
                ×
            </BitBhToastClose>
        </BitBhToast>
    </BitBhToastViewport>

    @* A second, independent toaster for the stacking demo. *@
    <BitBhToastViewport Toaster="stackToaster" Label="Stacked notifications" Hotkey="shift+F8"
                     Context="t" Duration="8000"
                     class="group/stack fixed bottom-4 left-4 z-100 m-0 grid w-[min(20rem,calc(100vw-2rem))] list-none p-0 outline-none hover:flex hover:flex-col hover:gap-2 focus-within:flex focus-within:flex-col focus-within:gap-2 focus-visible:rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600">
        <BitBhToast Item="t"
                 class="@($"col-start-1 row-start-1 flex origin-bottom items-start gap-3 self-end rounded-xl border border-zinc-200 bg-white py-3.5 pl-4 pr-3 text-sm text-zinc-900 shadow-lg outline-none transition duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 starting:translate-y-3 starting:opacity-0 data-state-closed:translate-x-[calc(100%+1rem)] data-state-closed:opacity-0 motion-reduce:transition-none {StackClass(StackDepth(t))}")">
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                <BitBhToastTitle class="font-semibold">@t.Title</BitBhToastTitle>
                <BitBhToastDescription class="text-zinc-600">@t.Description</BitBhToastDescription>
            </div>
            <BitBhToastClose aria-label="Dismiss notification"
                          class="inline-flex size-6 shrink-0 items-center justify-center rounded-md text-lg leading-none text-zinc-500 cursor-pointer hover:bg-zinc-100 hover:text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-600">
                ×
            </BitBhToastClose>
        </BitBhToast>
    </BitBhToastViewport>
</div>

@code {
    private static readonly string[] AllMessages = ["Quarterly report", "Team offsite plan", "Invoice #1042"];
    private readonly List<string> inbox = new(AllMessages);

    private readonly BitBhToaster stackToaster = new() { Limit = 3 };
    private int stackCount;

    // Keep the "Shown: n" readout in sync when stacked toasts auto-dismiss.
    protected override void OnInitialized() => stackToaster.Changed += OnStackChanged;
    private void OnStackChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => stackToaster.Changed -= OnStackChanged;

    private void ShowSimple() => Toaster.Show("Event created");

    private void ShowWithDescription() => Toaster.Show(new BitBhToastOptions
    {
        Title = "Changes saved",
        Description = "Your profile is now visible to your team.",
        Data = "success",
    });

    private void Archive(string message)
    {
        var index = inbox.IndexOf(message);
        inbox.RemoveAt(index);
        Toaster.Show(new BitBhToastOptions
        {
            Title = "Conversation archived",
            Description = message,
            ActionLabel = "Undo",
            OnAction = () =>
            {
                if (!inbox.Contains(message)) inbox.Insert(Math.Min(index, inbox.Count), message);
                return InvokeAsync(StateHasChanged);
            },
        });
    }

    private void RestoreAll()
    {
        inbox.Clear();
        inbox.AddRange(AllMessages);
    }

    private void ShowError() => Toaster.Show(new BitBhToastOptions
    {
        Title = "Payment failed",
        Description = "Your card was declined. Try another payment method.",
        Foreground = true,
        Data = "error",
    });

    private void ShowTimed(int milliseconds) => Toaster.Show(new BitBhToastOptions
    {
        Title = $"Closes in {milliseconds / 1000} seconds",
        Description = "Hover or focus it to pause the timer.",
        Duration = milliseconds,
    });

    private void ShowPersistent() => Toaster.Show(new BitBhToastOptions
    {
        Title = "Update available",
        Description = "This toast stays until you dismiss it.",
        Duration = 0,
    });

    private void AddStacked()
    {
        stackCount++;
        stackToaster.Show(new BitBhToastOptions
        {
            Title = $"Notification {stackCount}",
            Description = $"Received at {DateTime.Now:HH:mm:ss}.",
        });
    }

    // 0 = newest (front of the stack).
    private int StackDepth(BitBhToastItem toast)
    {
        var toasts = stackToaster.Toasts;
        for (var i = 0; i < toasts.Count; i++)
        {
            if (ReferenceEquals(toasts[i], toast)) return toasts.Count - 1 - i;
        }
        return 0;
    }

    private static string StackClass(int depth) => depth switch
    {
        0 => "",
        1 => "-translate-y-3 scale-95 opacity-90 group-hover/stack:translate-y-0 group-hover/stack:scale-100 group-hover/stack:opacity-100 group-focus-within/stack:translate-y-0 group-focus-within/stack:scale-100 group-focus-within/stack:opacity-100",
        _ => "-translate-y-6 scale-90 opacity-75 group-hover/stack:translate-y-0 group-hover/stack:scale-100 group-hover/stack:opacity-100 group-focus-within/stack:translate-y-0 group-focus-within/stack:scale-100 group-focus-within/stack:opacity-100",
    };

    private const string _simpleCode = """
@inject BitBhToaster Toaster

<BitBhButton OnClick="ShowSimple" class="... rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium">
    Show toast
</BitBhButton>

@* Place ONE viewport in your layout (e.g. MainLayout.razor). *@
<BitBhToastViewport Context="t" Duration="5000"
                 class="fixed bottom-4 right-4 z-100 m-0 flex w-[min(22rem,calc(100vw-2rem))] list-none flex-col gap-2 p-0 outline-none focus-visible:outline-2 focus-visible:outline-blue-600">
    <BitBhToast Item="t" data-variant="@(t.Data ?? "info")"
             class="group flex items-start gap-3 rounded-xl border border-zinc-200 bg-white py-3.5 pl-4 pr-3 text-sm text-zinc-900 shadow-lg outline-none
                    transition duration-200 ease-out
                    starting:translate-y-3 starting:opacity-0
                    data-state-closed:translate-x-[calc(100%+1rem)] data-state-closed:opacity-0 data-state-closed:duration-150 data-state-closed:ease-in
                    data-[variant=error]:border-red-200 data-[variant=error]:bg-red-50
                    focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 motion-reduce:transition-none">
        @if (t.Data is "success" or "error")
        {
            <span aria-hidden="true" class="mt-px inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-green-600 text-[0.7rem] font-bold text-white group-data-[variant=error]:bg-red-600">
                @(t.Data is "error" ? "!" : "✓")
            </span>
        }
        <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <BitBhToastTitle class="font-semibold group-data-[variant=error]:text-red-800">@t.Title</BitBhToastTitle>
            @if (t.Description is not null)
            {
                <BitBhToastDescription class="text-zinc-600">@t.Description</BitBhToastDescription>
            }
        </div>
        @if (t.Options.ActionLabel is not null)
        {
            <BitBhToastAction class="shrink-0 self-center rounded-md border border-zinc-300 bg-white px-2.5 py-1 text-xs font-semibold hover:bg-zinc-100" />
        }
        <BitBhToastClose aria-label="Dismiss notification"
                      class="inline-flex size-6 shrink-0 items-center justify-center rounded-md text-lg leading-none text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900">
            ×
        </BitBhToastClose>
    </BitBhToast>
</BitBhToastViewport>

@code {
    private void ShowSimple() => Toaster.Show("Event created");
}
""";

    private const string _descriptionCode = """
<BitBhButton OnClick="ShowWithDescription"
          class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700">
    Save profile
</BitBhButton>

@* Rendered by the BitBhToastViewport from the "Simple toast" demo. *@

