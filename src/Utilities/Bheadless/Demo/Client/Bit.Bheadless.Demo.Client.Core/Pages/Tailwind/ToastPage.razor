    private const string _durationCode = """
<BitBhButton OnClick="() => ShowTimed(2000)" class="...">2 seconds</BitBhButton>
<BitBhButton OnClick="() => ShowTimed(10000)" class="...">10 seconds</BitBhButton>
<BitBhButton OnClick="ShowPersistent" class="...">Persistent</BitBhButton>
