    });
}
""";

    private const string _actionCode = """
<ul class="m-0 flex w-full max-w-sm list-none flex-col gap-1.5 p-0">
    @foreach (var message in inbox)
    {
        <li class="flex items-center justify-between gap-3 rounded-lg border border-zinc-200 bg-white py-2 pl-3.5 pr-2 text-sm" @key="message">
            <span>@message</span>
            <BitBhButton OnClick="() => Archive(message)"
