@code {
    private void ShowTimed(int milliseconds) => Toaster.Show(new BitBhToastOptions
    {
        Title = $"Closes in {milliseconds / 1000} seconds",
        Description = "Hover or focus it to pause the timer.",
        Duration = milliseconds,            // overrides <BitBhToastViewport Duration="5000">
    });

    private void ShowPersistent() => Toaster.Show(new BitBhToastOptions
    {
        Title = "Update available",
        Description = "This toast stays until you dismiss it.",
        Duration = 0,                       // 0 or less: never auto-dismiss
    });
}
""";

    private const string _stackCode = """
<BitBhButton OnClick="AddStacked" class="...">Add notification</BitBhButton>

@* A second viewport bound to its own toaster; children overlap in one grid cell
   and the list switches to a flex column on hover / focus-within. *@
<BitBhToastViewport Toaster="stackToaster" Label="Stacked notifications" Hotkey="shift+F8"
                 Context="t" Duration="8000"
                 class="group/stack fixed bottom-4 left-4 z-100 m-0 grid w-80 list-none p-0
                        hover:flex hover:flex-col hover:gap-2 focus-within:flex focus-within:flex-col focus-within:gap-2">
    <BitBhToast Item="t"
             class="@($"col-start-1 row-start-1 self-end origin-bottom flex items-start gap-3 rounded-xl border border-zinc-200 bg-white py-3.5 pl-4 pr-3 text-sm shadow-lg transition duration-200 starting:translate-y-3 starting:opacity-0 data-state-closed:translate-x-[calc(100%+1rem)] data-state-closed:opacity-0 {StackClass(StackDepth(t))}")">
        <div class="flex min-w-0 flex-1 flex-col gap-0.5">
