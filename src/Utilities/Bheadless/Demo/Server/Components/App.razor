@{
    var noPrerender = HttpContext.Request.Query["no-prerender"].Count > 0;
    // AppRenderMode already knows whether the WASM client is part of the build (Program.cs turns WebAssembly off
    // when it is not), so this page and the layout's static-page island agree on one mode.
    IComponentRenderMode? renderMode = noPrerender
        ? (AppRenderMode.WasmEnabled ? AppRenderMode.NoPrerenderBlazorWebAssembly : AppRenderMode.NoPrerenderBlazorServer)
        : AppRenderMode.Current;
    // A page excluded from interactive routing (the error page) is rendered statically, so the HttpContext
    // of the request that failed is there for it to read.
    if (HttpContext.AcceptsInteractiveRouting() is false) renderMode = null;
}

