    <ImportMap />
    @* Same render mode as Routes, so <PageTitle> keeps updating once the app is interactive. *@
    <HeadOutlet @rendermode="renderMode" />
    @* Keeps a title in the document while the app boots. The client activates <HeadOutlet> as a root
       component of its own, before <Routes>: at that first render no <PageTitle> has registered yet
       (they all live inside Routes), so the diff against the prerendered markup deletes the <title>
       until Routes renders - the whole of hydration under WebAssembly - and the tab shows the URL.
       This parks a copy of the last title in <head> while the real one is missing and drops it as
       soon as Blazor puts one back (Blazor's sits earlier in <head>, so document.title reads it). *@
    <script>
        (function () {
            var head = document.head;
            var lastTitle = document.title || 'bit Bheadless';
            var placeholder = null;

            function findRealTitle() {
                var titles = head.getElementsByTagName('title');
                for (var i = 0; i < titles.length; i++) {
                    if (titles[i] !== placeholder) return titles[i];
                }
                return null;
            }

            function sync() {
                var real = findRealTitle();
                if (real) {
                    if (real.textContent) lastTitle = real.textContent;
                    if (placeholder) {
                        placeholder.remove();
                        placeholder = null;
                    }
                } else if (placeholder === null) {
                    placeholder = document.createElement('title');
                    placeholder.textContent = lastTitle;
                    head.appendChild(placeholder);
                }
            }

            sync();
            new MutationObserver(sync).observe(head, { childList: true, subtree: true, characterData: true });
        })();
    </script>
</head>

@* data-enhance-nav="false": a link followed before the WebAssembly runtime has started is a plain
   page load rather than an enhanced one. Enhanced navigation fetches and merges the next page while
   the runtime is still starting, and the router the runtime then attaches can render the address
   it read before the merge - the URL says /getting-started and the page is the landing page. Once the
   app is interactive its router handles every link itself and this attribute is not consulted. *@
<body data-enhance-nav="false">
    <Routes @rendermode="renderMode" />
    @if (renderMode is InteractiveServerRenderMode)
    {
        @* The reconnect UI only means something while a circuit is alive: Blazor Server mode. *@
        <ReconnectModal />
    }
    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">&#128473;</span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["site.js"]"></script>
</body>

