@inherits LayoutComponentBase

@* Every page shares this layout, so it renders before the database's assemblies are downloaded and may not use
   Bsqlite's or EF Core's types. data-interactive turns true once the page runs in the browser; the end-to-end tests
   wait for it. *@
<div class="page" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    <nav class="topbar">
        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink href="products">Products</NavLink>
    </nav>

    <main>
        @Body
    </main>
</div>
