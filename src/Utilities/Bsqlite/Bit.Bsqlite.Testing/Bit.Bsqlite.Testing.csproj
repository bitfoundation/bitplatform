<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>Bit.Bsqlite</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Description>Test support for bit Bsqlite: an in-process IBsqliteTransport backed by Microsoft.Data.Sqlite - the native transport Blazor Hybrid apps run on, recording what it executes - so the stack can be unit-tested on desktop .NET without a browser, and the MSTest conformance kit every storage provider must pass - inherit its test classes in your provider's test project and hand them your provider.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>Bit;Bsqlite;SQLite;EF Core;Testing;MSTest;Conformance</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Bsqlite\Bit.Bsqlite.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- No SQLite package of its own: the in-process transport is Bit.Bsqlite's native transport, and the native
             engine it runs on (SQLitePCLRaw.bundle_e_sqlite3) comes with Bit.Bsqlite, the way it does in a Blazor
             Hybrid app. -->

        <!-- The conformance kit is a library of tests other projects inherit, not a runnable test project, so
             it takes the framework rather than the runner. -->
        <PackageReference Include="MSTest.TestFramework" Version="[4.5.1,5.0.0)" />
    </ItemGroup>

</Project>
