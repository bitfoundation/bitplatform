<Project Sdk="Microsoft.NET.Sdk">

  <!-- The entities of the demo's workshop catalog, shared by the server (stock UseSqlite) and the browser
       (UseBitBsqlite) without either side knowing about the other. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bit.Bsqlite.Demo.Domain</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
