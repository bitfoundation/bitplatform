@page "/catalog"
@inject BrowserDatabase Database

<SessionLifecycle OnReady="LoadAsync" OnTearDown="UnloadAsync" />

<PageHeader Kicker="Data · CRUD" Title="Catalog">
    Products and categories, read and written entirely on the client. SKU is unique, price is a
    <code>decimal</code>, lead time is a <code>TimeSpan</code>, and discontinued-on is a nullable
    <code>DateOnly</code> - the types a browser database is usually worst at. Every button below
    is a normal EF Core call; the snippet under each panel is the code it runs.
</PageHeader>

<StorageSwitcher />

@if (_error is not null)
{
    <div class="bb-note bb-note-danger" role="alert">@_error</div>
}

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Products</h3>
    <p class="bb-card-desc">
        The whole catalog, read with one query that includes each product's category. Click a row to edit it;
        the editor and the categories sit under the table.
    </p>
    <div class="bb-note bq-try">
        <strong>Try</strong>
        Edit a row and save, then reload the tab - the row is still there, because the write went to the
        storage backend named in the bar above.
    </div>

    @* Wide: a six- or seven-column grid with its editor under it does not fit beside the "On this page"
       rail, so this page gives the rail up. *@
    <div class="bb-demo bb-page-wide">
        <div class="bb-demo-bar">
            <span class="bb-demo-label">Live</span>
            <input type="search" placeholder="Filter name, SKU, tags" aria-label="Filter products" @bind="_filter" @bind:event="oninput" />
            <button type="button" class="btn btn-primary" @onclick="NewProduct" disabled="@(_busy || _context is null)">New product</button>
        </div>

        <div class="bb-scroll">
            <table class="bb-table bq-grid" data-rows="products">
                <thead>
                <tr>
                    <th>SKU</th><th>Name</th><th>Category</th><th>Price</th><th>Lead</th><th>Status</th><th><span class="bq-sr">Actions</span></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var product in VisibleProducts)
                {
                    <tr class="bq-clickable @(product.Id == _editProduct?.Id ? "bq-selected" : null)" @onclick="() => EditProduct(product)">
                        <td class="bq-nowrap">@product.Sku</td>
                        <td class="bq-name">@product.Name</td>
                        <td class="bq-nowrap">
                            <span class="bq-swatch" style="background:@product.Category?.Color"></span>
                            @product.Category?.Name
                        </td>
                        <td class="bq-num">@SampleFormat.Money(product.Price)</td>
                        <td class="bq-nowrap">@SampleFormat.Lead(product.LeadTime)</td>
                        <td>
                            @if (!product.IsActive)
                            {
                                <span class="bb-badge bq-badge-neutral">discontinued @SampleFormat.Day(product.DiscontinuedOn)</span>
                            }
                            else
                            {
                                <span class="bb-badge bb-badge-success">active</span>
                            }
                        </td>
                        <td class="bb-table-action">
                            <button type="button" class="btn bq-btn-danger bq-btn-sm" @onclick="() => DeleteProductAsync(product)" @onclick:stopPropagation="true">Delete</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="bb-split">
            <div class="bb-stage">
                <p class="bq-panel-title">@(_editProduct?.Id == 0 ? "New product" : "Edit product")</p>
                @if (_editProduct is null)
                {
                    <p class="bb-muted">Select a row, or create one.</p>
                }
                else
                {
                    <form class="bq-form" @onsubmit="SaveProductAsync" @onsubmit:preventDefault="true">
                        <label class="bb-field">SKU <input @bind="_editProduct.Sku" required /></label>
                        <label class="bb-field">Name <input @bind="_editProduct.Name" required /></label>
                        <label class="bb-field">Category
                            <select @bind="_editProduct.CategoryId">
                                @foreach (var category in _categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </label>
                        <label class="bb-field">Price <input type="number" step="0.01" @bind="_editProduct.Price" /></label>
                        <label class="bb-field">Weight (kg) <input type="number" step="0.01" @bind="_editProduct.WeightKg" /></label>
                        <label class="bb-field">Lead time (days) <input type="number" step="1" @bind="_leadDays" /></label>
                        <label class="bb-field">Tags <input @bind="_editProduct.Tags" placeholder="comma separated" /></label>
                        <label class="bb-check"><input type="checkbox" @bind="_editProduct.IsActive" /> Active</label>
                        <label class="bb-field">Discontinued on <input type="date" @bind="_editProduct.DiscontinuedOn" /></label>
                        <p class="bb-mono bb-soft bq-small">PublicId @_editProduct.PublicId</p>
                        <div class="bb-toolbar">
                            <button type="submit" class="btn btn-primary" disabled="@_busy">Save</button>
                            <button type="button" class="btn btn-secondary" @onclick="() => _editProduct = null">Cancel</button>
                        </div>
                    </form>
                }
            </div>

            <div class="bb-stage">
                <p class="bq-panel-title">Categories</p>
                <p class="bb-muted bq-small">A category cascades to its products; a product on an order does not delete at all.</p>
                <form class="bq-form" @onsubmit="SaveCategoryAsync" @onsubmit:preventDefault="true">
                    <label class="bb-field">Name <input @bind="_categoryName" required /></label>
                    <label class="bb-field">Color <input type="color" @bind="_categoryColor" /></label>
                    <div class="bb-toolbar">
                        <button type="submit" class="btn btn-primary" disabled="@_busy">Add category</button>
                    </div>
                </form>
                <table class="bb-table bq-grid bq-grid-prose">
                    <thead><tr><th>Name</th><th>Items</th></tr></thead>
                    <tbody>
                    @foreach (var category in _categories)
                    {
                        <tr>
                            <td><span class="bq-swatch" style="background:@category.Color"></span>@category.Name</td>
                            <td class="bq-num">@_products.Count(p => p.CategoryId == category.Id)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <CodeBlock Title="Loading this table" Language="csharp" Code="@Snippets.Catalog.Read" />
</section>

<DemoCard Title="Inserting and updating"
          CodeTitle="Saving the form"
          Code="@Snippets.Catalog.Write">
    <Description>
        One code path for both: EF decides insert or update from the key. The write goes
        through the worker and lands in the storage backend named in the bar above, so it
        is still there after a reload.
    </Description>
</DemoCard>

<DemoCard Title="Foreign keys are enforced, not simulated"
          CodeTitle="Deleting a product"
          Code="@Snippets.Catalog.Delete">
    <Description>
        The engine in the worker is real SQLite with foreign keys on. Nothing in the browser
        re-implements referential integrity, so a constraint failure comes back as the
        <code>DbUpdateException</code> you would get on a server.
    </Description>
    <Try>
        Delete a product that appears on an <a href="orders">order</a>. The message above
        the table is SQLite's, surfaced through EF.
    </Try>
</DemoCard>

<DemoCard Title="The model that shapes these tables"
          CodeTitle="ProductConfiguration.cs"
          Code="@Snippets.Catalog.Configuration"
          CodeOpen="false">
    <Description>
        Ordinary <code>IEntityTypeConfiguration</code>. The same class compiles against the
        server's <code>UseSqlite</code>, and the same migration creates both databases -
        nothing here is browser-specific.
    </Description>
</DemoCard>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> CLR types stored in SQLite</h3>
    <p class="bb-card-desc">
        SQLite has four storage classes. The ADO.NET binder decides which one each CLR value takes, so the worker
        never guesses and values round-trip as the type you wrote.
    </p>
    <div class="bb-scroll">
        <table class="bb-table bq-grid">
            <thead><tr><th>CLR</th><th>SQLite</th><th>Where in this demo</th></tr></thead>
            <tbody>
            <tr><td>decimal</td><td>TEXT + <code>ef_*</code></td><td>Price, credit limit</td></tr>
            <tr><td>DateTime</td><td>TEXT ISO</td><td>CreatedUtc</td></tr>
            <tr><td>DateTimeOffset</td><td>TEXT + offset</td><td>OrderedAt</td></tr>
            <tr><td>DateOnly</td><td>TEXT date</td><td>Date of birth, ship-by</td></tr>
            <tr><td>TimeSpan</td><td>TEXT <code>c</code></td><td>Lead time</td></tr>
            <tr><td>Guid</td><td>TEXT</td><td>PublicId</td></tr>
            <tr><td>bool</td><td>INTEGER 0/1</td><td>IsActive, IsVip</td></tr>
            <tr><td>enum</td><td>TEXT</td><td>Order status</td></tr>
            <tr><td>double</td><td>REAL</td><td>Weight</td></tr>
            </tbody>
        </table>
    </div>
    <CodeBlock Title="Product.cs" Language="csharp" Code="@Snippets.Catalog.Entity" Open="false" />
</section>

@code {
    private AppDbContext? _context;
    private List<Product> _products = [];
    private List<Category> _categories = [];
    private Product? _editProduct;
    private string _filter = string.Empty;
    private string _categoryName = string.Empty;
    private string _categoryColor = "#0f766e";
    private int _leadDays = 2;
    private bool _busy;
    private string? _error;

    private IEnumerable<Product> VisibleProducts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filter))
            {
                return _products;
            }

            var term = _filter.Trim();
            return _products.Where(p =>
                p.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || p.Sku.Contains(term, StringComparison.OrdinalIgnoreCase)
                || p.Tags.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task LoadAsync(CancellationToken cancellationToken)
    {
        _error = null;
        try
        {
            var context = await Database.OpenContextAsync();
            if (cancellationToken.IsCancellationRequested)
            {
                // Torn down while the context opened, so the teardown had nothing to dispose yet.
                await context.DisposeAsync();
                return;
            }

            _context = context;
            await RefreshAsync();
        }
        catch (Exception) when (cancellationToken.IsCancellationRequested)
        {
            // Torn down while it loaded - the reader left, or the session is closing - which disposed what
            // the load was running on. There is no page left to show that on.
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = SampleFormat.Error(ex);
        }
    }

    private async Task UnloadAsync()
    {
        _editProduct = null;
        if (_context is not null)
        {
            await _context.DisposeAsync();
            _context = null;
        }
    }

    private async Task RefreshAsync()
    {
        if (_context is null)
        {
            return;
        }

        _categories = await _context.Categories.AsNoTracking().OrderBy(c => c.Name).ToListAsync();
        _products = await _context.Products
            .AsNoTracking()
            .Include(p => p.Category)
            .OrderBy(p => p.Sku)
            .ToListAsync();
    }

    private void NewProduct()
    {
        var categoryId = _categories.FirstOrDefault()?.Id ?? 0;
        _editProduct = new Product
        {
            Sku = "SKU-" + Guid.NewGuid().ToString("N")[..6].ToUpperInvariant(),
            Name = string.Empty,
            CategoryId = categoryId,
            Price = 0,
            LeadTime = TimeSpan.FromDays(2),
            IsActive = true,
        };
        _leadDays = 2;
    }

    private void EditProduct(Product product)
    {
        _editProduct = new Product
        {
            Id = product.Id,
            PublicId = product.PublicId,
            Sku = product.Sku,
            Name = product.Name,
            Price = product.Price,
            WeightKg = product.WeightKg,
            IsActive = product.IsActive,
            CreatedUtc = product.CreatedUtc,
            DiscontinuedOn = product.DiscontinuedOn,
            LeadTime = product.LeadTime,
            Tags = product.Tags,
            CategoryId = product.CategoryId,
        };
        _leadDays = Math.Max(0, (int)Math.Round(product.LeadTime.TotalDays));
    }

    private async Task SaveProductAsync()
    {
        if (_context is null || _editProduct is null || string.IsNullOrWhiteSpace(_editProduct.Name))
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _editProduct.LeadTime = TimeSpan.FromDays(_leadDays);
            if (!_editProduct.IsActive && _editProduct.DiscontinuedOn is null)
            {
                _editProduct.DiscontinuedOn = DateOnly.FromDateTime(DateTime.UtcNow);
            }

            if (_editProduct.Id == 0)
            {
                _context.Products.Add(_editProduct);
            }
            else
            {
                _context.Products.Update(_editProduct);
            }

            await _context.SaveChangesAsync();
            _context.ChangeTracker.Clear();
            _editProduct = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = SampleFormat.Error(ex);
            _context.ChangeTracker.Clear();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteProductAsync(Product product)
    {
        if (_context is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var tracked = await _context.Products.FirstAsync(p => p.Id == product.Id);
            _context.Products.Remove(tracked);
            await _context.SaveChangesAsync();
            _context.ChangeTracker.Clear();
            if (_editProduct?.Id == product.Id)
            {
                _editProduct = null;
            }

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = SampleFormat.Error(ex);
            _context.ChangeTracker.Clear();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveCategoryAsync()
    {
        if (_context is null || string.IsNullOrWhiteSpace(_categoryName))
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _context.Categories.Add(new Category { Name = _categoryName.Trim(), Color = _categoryColor });
            await _context.SaveChangesAsync();
            _context.ChangeTracker.Clear();
            _categoryName = string.Empty;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = SampleFormat.Error(ex);
            _context.ChangeTracker.Clear();
        }
        finally
        {
            _busy = false;
        }
    }
}
