@page "/orders"
@inject BrowserDatabase Database

<SessionLifecycle OnReady="LoadAsync" OnTearDown="UnloadAsync" />

<PageHeader Kicker="Data · Relationships" Title="Orders">
    A master-detail graph loaded in one query: header, customer, lines, and each line's product.
    Status is an enum stored as TEXT, <code>OrderedAt</code> is a <code>DateTimeOffset</code>, and
    both foreign keys are <code>Restrict</code> - so the engine, not the UI, decides what may be
    deleted.
</PageHeader>

<StorageSwitcher />

@if (_error is not null)
{
    <div class="bb-note bb-note-danger" role="alert">@_error</div>
}

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Orders</h3>
    <p class="bb-card-desc">
        Every order with its customer and its lines, newest first. Click a row to open its header and its lines
        in the panel under the table.
    </p>
    <div class="bb-note bq-try">
        <strong>Try</strong>
        Move an order to <em>Shipped</em>. The <a href="queries">SQL</a> page holds a live
        query over this table - open it in a second tab and watch it re-run.
    </div>

    @* Wide: a six- or seven-column grid with its editor under it does not fit beside the "On this page"
       rail, so this page gives the rail up. *@
    <div class="bb-demo bb-page-wide">
        <div class="bb-demo-bar">
            <span class="bb-demo-label">Live</span>
            <input type="search" placeholder="Filter number or customer" aria-label="Filter orders" @bind="_filter" @bind:event="oninput" />
            <button type="button" class="btn btn-primary" @onclick="NewOrder" disabled="@(_busy || _context is null)">New order</button>
        </div>

        <div class="bb-scroll">
            <table class="bb-table bq-grid" data-rows="orders">
                <thead>
                <tr><th>Number</th><th>Customer</th><th>Status</th><th>Ordered</th><th>Ship by</th><th>Total</th></tr>
                </thead>
                <tbody>
                @foreach (var order in Visible)
                {
                    <tr class="bq-clickable @(order.Id == _selected?.Id ? "bq-selected" : null)" @onclick="() => Select(order)">
                        <td class="bq-nowrap">@order.Number</td>
                        <td class="bq-name">@order.Customer?.DisplayName</td>
                        <td><span class="@StatusClass(order.Status)">@order.Status</span></td>
                        <td>@SampleFormat.When(order.OrderedAt)</td>
                        <td class="bq-nowrap">@SampleFormat.Day(order.ShipBy)</td>
                        <td class="bq-num">@SampleFormat.Money(order.Lines.Sum(l => l.UnitPrice * l.Quantity))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="bb-stage">
            @if (_selected is null)
            {
                <p class="bq-panel-title">Detail</p>
                <p class="bb-muted">Select an order, or create one.</p>
            }
            else
            {
                <p class="bq-panel-title">@_selected.Number</p>
                <div class="bb-split">
                    <form class="bq-form" @onsubmit="SaveHeaderAsync" @onsubmit:preventDefault="true">
                        <label class="bb-field">Customer
                            <select @bind="_selected.CustomerId">
                                @foreach (var customer in _customers)
                                {
                                    <option value="@customer.Id">@customer.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label class="bb-field">Status
                            <select @bind="_status">
                                @foreach (var status in Enum.GetValues<OrderStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </label>
                        <label class="bb-field">Ship by <input type="date" @bind="_selected.ShipBy" /></label>
                        <label class="bb-field">Notes <textarea @bind="_selected.Notes"></textarea></label>
                        <div class="bb-toolbar">
                            <button type="submit" class="btn btn-primary" disabled="@_busy">Save header</button>
                            <button type="button" class="btn bq-btn-danger" @onclick="DeleteOrderAsync" disabled="@_busy">Delete order</button>
                        </div>
                    </form>

                    <div>
                        <p class="bq-panel-title">Lines</p>
                        <table class="bb-table bq-grid bq-grid-prose">
                            <thead><tr><th>Product</th><th>Qty</th><th>Unit</th><th><span class="bq-sr">Actions</span></th></tr></thead>
                            <tbody>
                            @foreach (var line in _selected.Lines)
                            {
                                <tr>
                                    <td>@(line.Product?.Name ?? $"#{line.ProductId}")</td>
                                    <td class="bq-num">@line.Quantity</td>
                                    <td class="bq-num">@SampleFormat.Money(line.UnitPrice)</td>
                                    <td class="bb-table-action">
                                        <button type="button" class="btn bq-btn-danger bq-btn-sm" @onclick="() => RemoveLineAsync(line)">Remove</button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <form class="bq-form" @onsubmit="AddLineAsync" @onsubmit:preventDefault="true">
                            <label class="bb-field">Add product
                                <select @bind="_newProductId">
                                    @foreach (var product in _products)
                                    {
                                        <option value="@product.Id">@product.Sku - @product.Name</option>
                                    }
                                </select>
                            </label>
                            <label class="bb-field">Quantity <input type="number" min="1" @bind="_newQty" /></label>
                            <div class="bb-toolbar">
                                <button type="submit" class="btn btn-primary" disabled="@(_busy || _selected.Id == 0)">Add line</button>
                            </div>
                        </form>
                        @if (_selected.Id == 0)
                        {
                            <p class="bb-muted bq-small">Save the header before adding lines.</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <CodeBlock Title="Loading the graph" Language="csharp" Code="@Snippets.Orders.Read" />
</section>

<DemoCard Title="Saving a header, then its lines"
          CodeTitle="Adding a line"
          Code="@Snippets.Orders.Graph">
    <Description>
        The header is saved first because the lines need its generated key, and the unit
        price is copied onto the line so later price changes do not rewrite history. Both
        saves go through the same connection in the same worker.
    </Description>
</DemoCard>

<DemoCard Title="Why the grid sorts by Id"
          CodeTitle="Sorting a DateTimeOffset column"
          Code="@Snippets.Orders.Offset">
    <Description>
        A <code>DateTimeOffset</code> round-trips correctly, but SQLite has no type that
        can order one, so the stock SQLite provider refuses <code>ORDER BY</code> on it -
        on a server exactly as here. Bsqlite does not paper over that: same provider,
        same rules.
    </Description>
</DemoCard>

<DemoCard Title="The relationships behind this page"
          CodeTitle="SalesOrderConfiguration.cs"
          Code="@Snippets.Orders.Configuration"
          CodeOpen="false">
    <Description>
        Status is stored as TEXT so an exported <code>.db</code> stays readable and
        reordering the enum cannot silently change history. Deleting a customer who has
        orders, or a product on a line, is refused by <code>Restrict</code>.
    </Description>
</DemoCard>

@code {
    private AppDbContext? _context;
    private List<SalesOrder> _orders = [];
    private List<Customer> _customers = [];
    private List<Product> _products = [];
    private SalesOrder? _selected;
    private OrderStatus _status;
    private string _filter = string.Empty;
    private int _newProductId;
    private int _newQty = 1;
    private bool _busy;
    private string? _error;

    private IEnumerable<SalesOrder> Visible
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filter))
            {
                return _orders;
            }

            var term = _filter.Trim();
            return _orders.Where(o =>
                o.Number.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (o.Customer?.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private static string StatusClass(OrderStatus status) => status switch
    {
        OrderStatus.Shipped => "bb-badge bb-badge-success",
        OrderStatus.Cancelled => "bb-badge bb-badge-danger",
        OrderStatus.Draft => "bb-badge bq-badge-neutral",
        OrderStatus.Packed => "bb-badge bb-badge-warn",
        _ => "bb-badge",
    };

    private async Task LoadAsync(CancellationToken cancellationToken)
    {
        _error = null;
        try
        {
            var context = await Database.OpenContextAsync();
            if (cancellationToken.IsCancellationRequested)
            {
                // Torn down while the context opened, so the teardown had nothing to dispose yet.
                await context.DisposeAsync();
                return;
            }

            _context = context;
            await RefreshAsync();
        }
        catch (Exception) when (cancellationToken.IsCancellationRequested)
        {
            // Torn down while it loaded - the reader left, or the session is closing - which disposed what
            // the load was running on. There is no page left to show that on.
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = SampleFormat.Error(ex);
        }
    }

    private async Task UnloadAsync()
    {
        _selected = null;
        if (_context is not null)
        {
            await _context.DisposeAsync();
            _context = null;
        }
    }

    private async Task RefreshAsync(int? keepId = null)
    {
        if (_context is null)
        {
            return;
        }

        _customers = await _context.Customers.AsNoTracking().OrderBy(c => c.DisplayName).ToListAsync();
        _products = await _context.Products.AsNoTracking().OrderBy(p => p.Sku).ToListAsync();
        _orders = await _context.Orders
            .AsNoTracking()
            .Include(o => o.Customer)
            .Include(o => o.Lines)
            .ThenInclude(l => l.Product)
            .OrderByDescending(o => o.Id)
            .ToListAsync();
        _newProductId = _products.FirstOrDefault()?.Id ?? 0;
        var id = keepId ?? _selected?.Id;
        _selected = null;
        if (id is int found && _orders.FirstOrDefault(o => o.Id == found) is { } order)
        {
            Select(order);
        }
    }

    private void NewOrder()
    {
        var customerId = _customers.FirstOrDefault()?.Id ?? 0;
        _selected = new SalesOrder
        {
            Number = "SO-" + DateTime.UtcNow.ToString("HHmmss"),
            CustomerId = customerId,
            Status = OrderStatus.Draft,
            OrderedAt = DateTimeOffset.Now,
            ShipBy = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(7)),
        };
        _status = OrderStatus.Draft;
    }

    /// <summary>
    /// The editor works on a copy, as Catalog's and Customers' do: bound to the row itself, an edit would
    /// show in the grid before it was saved, and stay there when the reader moved on without saving.
    /// The lines are shared - they are changed through their own buttons, never through the form.
    /// </summary>
    private void Select(SalesOrder order)
    {
        _selected = new SalesOrder
        {
            Id = order.Id,
            Number = order.Number,
            CustomerId = order.CustomerId,
            Customer = order.Customer,
            Status = order.Status,
            OrderedAt = order.OrderedAt,
            ShipBy = order.ShipBy,
            Notes = order.Notes,
            Lines = order.Lines,
        };
        _status = order.Status;
    }

    private async Task SaveHeaderAsync()
    {
        if (_context is null || _selected is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _selected.Status = _status;
            if (_selected.Id == 0)
            {
                _context.Orders.Add(_selected);
            }
            else
            {
                var tracked = await _context.Orders.FirstAsync(o => o.Id == _selected.Id);
                tracked.CustomerId = _selected.CustomerId;
                tracked.Status = _selected.Status;
                tracked.ShipBy = _selected.ShipBy;
                tracked.Notes = _selected.Notes ?? string.Empty;
            }

            await _context.SaveChangesAsync();
            var id = _selected.Id;
            _context.ChangeTracker.Clear();
            await RefreshAsync(id);
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = SampleFormat.Error(ex);
            _context.ChangeTracker.Clear();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddLineAsync()
    {
        if (_context is null || _selected is null || _selected.Id == 0)
        {
            return;
        }

        var product = _products.FirstOrDefault(p => p.Id == _newProductId);
        if (product is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _context.OrderLines.Add(new OrderLine
            {
                OrderId = _selected.Id,
                ProductId = product.Id,
                Quantity = Math.Max(1, _newQty),
                UnitPrice = product.Price,
            });
            await _context.SaveChangesAsync();
            _context.ChangeTracker.Clear();
            await RefreshAsync(_selected.Id);
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = SampleFormat.Error(ex);
            _context.ChangeTracker.Clear();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveLineAsync(OrderLine line)
    {
        if (_context is null || _selected is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var tracked = await _context.OrderLines.FirstAsync(l => l.Id == line.Id);
            _context.OrderLines.Remove(tracked);
            await _context.SaveChangesAsync();
            _context.ChangeTracker.Clear();
            await RefreshAsync(_selected.Id);
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = SampleFormat.Error(ex);
            _context.ChangeTracker.Clear();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteOrderAsync()
    {
        if (_context is null || _selected is null || _selected.Id == 0)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var tracked = await _context.Orders.FirstAsync(o => o.Id == _selected.Id);
            _context.Orders.Remove(tracked);
            await _context.SaveChangesAsync();
            _context.ChangeTracker.Clear();
            _selected = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = SampleFormat.Error(ex);
            _context.ChangeTracker.Clear();
        }
        finally
        {
            _busy = false;
        }
    }
}
