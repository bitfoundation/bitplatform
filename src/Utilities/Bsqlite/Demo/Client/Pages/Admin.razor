@page "/admin"
@inject BrowserDatabase Database
@inject IJSRuntime Js

<SessionLifecycle OnReady="LoadAsync" OnTearDown="NoopAsync" />

<PageHeader Kicker="Platform · Files" Title="The database as a file">
    <code>IBsqliteStorageAdmin</code> treats a database as an artifact rather than a
    connection: what exists, read the bytes out, write bytes back, delete. Cross-provider
    migration and the diagnostics on <a href="storage">Storage</a> are built from this same
    surface, and none of it goes through EF.
</PageHeader>

<StorageSwitcher />

@if (_error is not null)
{
    <div class="bb-note bb-note-danger" role="alert">@_error</div>
}
@if (_info is not null)
{
    <div class="bb-note" role="status">@_info</div>
}

<DemoCard Step="List"
          Title="What each backend holds"
          CodeTitle="Listing databases"
          Code="@Snippets.Admin.List">
    <Description>
        Names come from the provider, so a backend that has never been used reports empty
        rather than failing, and one this browser cannot use says why. Related
        <code>-journal</code> files are not databases and do not appear.
    </Description>
    <ChildContent>
        <div class="bb-toolbar">
            <button type="button" class="btn btn-secondary" @onclick="ListAllAsync" disabled="@_busy">Refresh lists</button>
        </div>
        <dl class="bb-params">
            @foreach (var group in _lists)
            {
                <dt>@group.Name</dt>
                <dd>
                    @if (group.UnavailableReason is not null)
                    {
                        <span class="bb-soft">unavailable here: @group.UnavailableReason</span>
                    }
                    else if (group.Names.Count == 0)
                    {
                        <span class="bb-soft">empty</span>
                    }
                    else
                    {
                        @string.Join(", ", group.Names)
                    }
                </dd>
            }
        </dl>
    </ChildContent>
</DemoCard>

<DemoCard Step="Export"
          Title="Download a real .db"
          CodeTitle="Exporting"
          Code="@Snippets.Admin.Export">
    <Description>
        Snapshots <code>@BrowserDatabase.DatabaseName</code> while it stays open, as of its last
        committed write - a transaction another context has open is waited for, not captured
        half done. On OPFS the image is the file byte for byte; on IndexedDB and Cache Storage it
        is a compacted copy made with <code>VACUUM INTO</code>. Either way it is an ordinary
        SQLite file, and a backup <code>RestoreAsync</code> takes back.
    </Description>
    <Try>Download it and open it in any desktop SQLite tool - the rows you edited are there.</Try>
    <ChildContent>
        <div class="bb-toolbar">
            <button type="button" class="btn btn-primary" @onclick="ExportAsync" disabled="@_busy">Download app.db</button>
        </div>
    </ChildContent>
</DemoCard>

<DemoCard Step="Restore"
          Title="Restore from a file"
          CodeTitle="Restoring"
          Code="@Snippets.Admin.Restore">
    <Description>
        Replaces <code>@BrowserDatabase.DatabaseName</code> with the file, on the backend that
        holds it now. The file is checked before anything is touched - one that is not a SQLite
        database, or is cut short, is refused and the database stays as it was - and a file a
        server or desktop left in WAL mode is accepted. The database closes around the import,
        is read back to check every byte landed, and reopens; the context factory then applies
        the migrations an older backup is missing.
    </Description>
    <Try>
        Export above, change some rows, then restore the file: the rows come back as they were.
        This is also how you ship a pre-built database with an app.
    </Try>
    <ChildContent>
        <div class="bb-fields">
            <label class="bb-field">
                SQLite file
                <InputFile OnChange="OnFile" accept=".db,.sqlite,application/octet-stream" />
            </label>
            <button type="button" class="btn btn-primary" @onclick="RestoreAsync" disabled="@(_busy || _importBytes is null)">Restore and reopen</button>
        </div>
    </ChildContent>
</DemoCard>

<DemoCard Step="Delete"
          Title="Start over"
          CodeTitle="Deleting"
          Code="@Snippets.Admin.Delete">
    <Description>
        Removes <code>@BrowserDatabase.DatabaseName</code> from every backend that holds a copy
        and forgets the binding, so the next open is free to pick the preferred provider again,
        run the migrations, and reseed. Every backend, not only the current one: a copy left
        elsewhere would be found again on the next open - what signing out of an offline app
        must not allow.
    </Description>
    <ChildContent>
        <div class="bb-toolbar">
            <button type="button" class="btn bq-btn-danger" @onclick="DeleteAsync" disabled="@_busy">
                Delete app.db and reopen empty
            </button>
        </div>
    </ChildContent>
</DemoCard>

@code {
    private readonly List<(string Name, IReadOnlyList<string> Names, string? UnavailableReason)> _lists = [];
    private string? _error;
    private string? _info;
    private bool _busy;
    private byte[]? _importBytes;

    private static Task NoopAsync() => Task.CompletedTask;

    private async Task LoadAsync()
    {
        string? failure = null;
        try
        {
            await Database.EnsureSessionAsync();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            failure = ex.Message;
        }

        // Listed whether or not the database opened: one that does not open is the one to find here.
        await ListAllAsync();
        if (failure is not null)
        {
            _error = failure;
        }
    }

    private async Task ListAllAsync()
    {
        _busy = true;
        _error = null;
        _lists.Clear();
        try
        {
            foreach (var provider in Database.Providers)
            {
                // A backend this browser cannot use (OPFS without navigator.storage.getDirectory,
                // say) has no files to list. Its probe says why, as a result; asking it to list
                // would throw instead, and the backends after it would not be listed at all.
                var probe = await provider.ProbeAsync();
                if (!probe.IsAvailable)
                {
                    _lists.Add((provider.Name, [], probe.UnavailableReason));
                    continue;
                }

                var names = await provider.Admin.ListAsync();
                _lists.Add((provider.Name, names, null));
            }
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        _busy = true;
        _error = null;
        _info = null;
        try
        {
            var bytes = await Database.Database.ExportAsync();
            await Js.InvokeVoidAsync("bsqliteDemo.download", "app.db", bytes);
            _info = $"Exported {SampleFormat.Bytes(bytes.LongLength)} from {Database.Resolution?.Provider.Name}.";
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnFile(InputFileChangeEventArgs args)
    {
        _error = null;
        try
        {
            await using var stream = args.File.OpenReadStream(maxAllowedSize: 32 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var bytes = memory.ToArray();

            // Refused as soon as it is picked, for the reader's sake: RestoreAsync checks the file again,
            // and more thoroughly, before it touches the database.
            if (bytes.Length > 0 && !bytes.AsSpan().StartsWith("SQLite format 3\0"u8))
            {
                _importBytes = null;
                _info = null;
                _error = $"{args.File.Name} is not a SQLite database: it does not start with the 'SQLite format 3' header.";
                return;
            }

            _importBytes = bytes;
            _info = $"Ready to import {args.File.Name} ({SampleFormat.Bytes(_importBytes.LongLength)}).";
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = ex.Message;
        }
    }

    private async Task RestoreAsync()
    {
        if (_importBytes is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _info = null;
        try
        {
            await Database.Database.RestoreAsync(_importBytes);

            // A context runs the migrations an older backup is missing before the pages come back for it.
            await using (await Database.OpenContextAsync())
            {
            }
            _info = $"Restored onto {Database.Resolution?.Provider.Name} and reopened. Catalog and orders will refresh.";
            await ListAllAsync();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            await ListAllAsync();
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        _error = null;
        _info = null;
        try
        {
            // Closed first, and never opened to find where it lives: a database that no longer opens - a
            // file that is not a database, say - is the one most in need of deleting.
            await Database.Database.DeleteAsync();

            await using (await Database.OpenContextAsync())
            {
            }
            _info = "Deleted and reopened. Migrations ran again; the workshop catalog was reseeded if empty.";
            await ListAllAsync();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            await ListAllAsync();
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
