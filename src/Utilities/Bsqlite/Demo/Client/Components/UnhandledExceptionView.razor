@* What the error boundary in Routes.razor shows in place of a page that threw while rendering: the
   exception's type and message - the site kit's error page - with the whole exception graph written
   to the browser console. *@

@if (Exception is not null)
{
    <div class="bb-error bq-crash" role="alert">
        <h1>This page failed</h1>
        <p><code>@Exception.GetType().FullName</code>: @Exception.Message</p>
        <p>The full exception, including inner exceptions and stack traces, is in the browser console.</p>
        <div class="bb-try bb-error-actions">
            <a href="" class="btn btn-primary">Go to the home page</a>
            <a href="getting-started" class="btn btn-secondary">Browse the docs</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public Exception? Exception { get; set; }

    protected override void OnParametersSet()
    {
        if (Exception is not null)
        {
            SampleLog.Exception(Exception);
        }
    }
}
