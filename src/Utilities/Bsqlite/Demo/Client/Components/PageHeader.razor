@* Every demo page opens the same way: what part of the library it exercises, its title, and one
   paragraph of what to look for. It also owns the document title, so a bookmarked demo page is
   named after the demo rather than after the site. *@
<PageTitle>@Title · Bsqlite</PageTitle>

<header class="page-head">
    <p class="eyebrow">@Kicker</p>
    <h1>@Title</h1>
    <p class="lead">@ChildContent</p>
</header>

@code {
    [Parameter, EditorRequired]
    public string Kicker { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
