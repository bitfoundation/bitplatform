<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The host owns the launch profile: this project is never started on its own. -->
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <!-- Publishes this project's static web assets at the app root (not under _content/), the
         way a Blazor Web App's client project is expected to contribute them. -->
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library, with every first-party storage backend: the demo moves its database between all four. -->
    <ProjectReference Include="..\..\Bit.Bsqlite\Bit.Bsqlite.csproj" />

    <!-- The one AppDbContext and migration set the server runs too. -->
    <ProjectReference Include="..\Data\Bit.Bsqlite.Demo.Data.csproj" />
  </ItemGroup>

  <!-- What the Bit.Bsqlite package imports into every app that references it, and a project reference does not:
       it keeps the native SQLite the package brings for Blazor Hybrid apps out of this WebAssembly build. -->
  <Import Project="..\..\Bit.Bsqlite\buildTransitive\Bit.Bsqlite.targets" />

</Project>
