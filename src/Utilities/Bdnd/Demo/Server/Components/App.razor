<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="bit Bdnd (Bit.Bdnd) - a declarative drag-and-drop library for Blazor inspired by React DnD, with typed items, drop targets, custom drag layers, drag handles, sortable lists and native file drops." />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* Bit.Bdnd ships no stylesheet: its script module is imported by the components on demand. *@
    <link rel="stylesheet" href="@Assets["Bit.Bdnd.Demo.Server.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    @* InteractiveWebAssembly rather than Auto or Server: dragover fires continuously during a drag,
       and on WebAssembly none of its handlers waits on a network round trip. The pages are still
       prerendered, so the first response carries them. *@
    <Routes @rendermode="InteractiveWebAssembly" />
    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">&#128473;</span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
