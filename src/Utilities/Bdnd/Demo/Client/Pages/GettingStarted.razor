@code {
    // The snippets the page shows, coloured by CodeBlock.

    private const string RegisterCode = """
        // Program.cs - in every project that renders the components
        builder.Services.AddBitBdndServices();
        """;

    private const string ImportsCode = "@using Bit.Bdnd";

    // The live sample's own source, read at build time, so the code under the sample is the code that runs it.
    private static readonly string FirstDropCode = DemoSources.Components["FirstDrop.razor"];
}
