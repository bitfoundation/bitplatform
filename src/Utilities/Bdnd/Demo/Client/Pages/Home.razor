</div>

@code {
    private sealed record Card(string Title);

    private static readonly Card[] Board = [new("Write the docs"), new("Review the PR"), new("Ship the release")];

    private readonly List<Card> _cards = [.. Board];
    private int _archived;

    private void Archive(BdndDropEventArgs<Card> e)
    {
        if (e.Item is not null && _cards.Remove(e.Item)) _archived++;
    }

    private void Reset()
    {
        _cards.Clear();
        _cards.AddRange(Board);
        _archived = 0;
    }
}
