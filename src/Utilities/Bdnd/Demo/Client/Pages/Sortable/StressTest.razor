@page "/sortable/stress-test"

<PageTitle>Sortable - Stress Test · Bdnd</PageTitle>

<div class="bb-intro">
    <h1>Sortable - Stress Test</h1>
    <p class="bb-subtitle">
        A long sortable list (@_cards.Count items) in a scrolling tray. Reordering still runs the per-item midpoint
        hit-test on every hover, yet a hover re-renders only the cards whose state changed, not the hundred. Hold a
        card near the tray's top or bottom edge and the tray scrolls. Handy for spotting performance
        regressions.
    </p>
</div>

<div class="bb-demo">
    <BdndProvider>
        @* the list accepts cards too, so the gaps between cards are not "no-drop" zones *@
        <BdndDropTarget TItem="SortableCard.DragItem" Accept="@ItemTypes.Card"
                        class="sortable-scroll" style="max-width:24rem;">
            @foreach (var (card, index) in _cards.Select((c, i) => (c, i)))
            {
                <SortableCard Card="card" Index="index" OnMove="Move" @key="card.Id" />
            }
        </BdndDropTarget>
    </BdndProvider>
</div>

<DemoCode />

@code {
    private readonly List<SortableCard.CardModel> _cards =
        Enumerable.Range(1, 100).Select(i => new SortableCard.CardModel(i, $"Item #{i}")).ToList();

    private void Move((int From, int To) move)
    {
        var (from, to) = move;
        if (from < 0 || from >= _cards.Count || to < 0 || to >= _cards.Count) return;
        var card = _cards[from];
        _cards.RemoveAt(from);
        _cards.Insert(to, card);
    }
}
