@page "/sortable/grid"

<PageTitle>Sortable - Grid · Bdnd</PageTitle>

<div class="bb-intro">
    <h1>Sortable - Grid</h1>
    <p class="bb-subtitle">
        Tiles in a wrapping grid, each in a drop target with <code>Edges="BdndEdges.Horizontal"</code>: a tile dragged
        over another lands on the side the pointer is closest to, and <code>BdndList.InsertionIndex</code> and
        <code>BdndList.Move</code> place it. With the keyboard, Left and Right step through the gaps between the tiles,
        and Up and Down go a row up or down - to the gap closest across - rather than one tile on.
    </p>
</div>

<DemoCode />

<div class="bb-demo">
    <BdndProvider>
        <div class="sortable-grid">
            @for (var i = 0; i < _tiles.Count; i++)
            {
                var index = i;
                var tile = _tiles[i];
                <BdndDropTarget TItem="string" Accept="tile" Edges="BdndEdges.Horizontal" Label="@tile" class="grid-slot"
                                OnDrop="@(e => Drop(e, index))" @key="tile" Context="slot">
                    <BdndDraggable TItem="string" Type="tile" Item="tile" Label="@tile" class="grid-tile" Context="drag">
                        @tile
                    </BdndDraggable>
                </BdndDropTarget>
            }
        </div>
    </BdndProvider>

    <p class="demo-caption grid-order">Order: @string.Join(", ", _tiles)</p>
</div>

@code {
    private readonly List<string> _tiles =
        ["Amber", "Blue", "Coral", "Denim", "Emerald", "Fuchsia", "Gold", "Hazel", "Indigo", "Jade", "Khaki", "Lilac"];

    // Dropped on a tile: before or after it, as the edge says.
    private void Drop(BdndDropEventArgs<string> e, int index)
    {
        if (e.Item is not { } tile) return;
        BdndList.Move(_tiles, _tiles.IndexOf(tile), _tiles, BdndList.InsertionIndex(index, e.ClosestEdge));
    }
}
