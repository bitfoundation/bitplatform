@page "/other/native-html"

<PageTitle>Other - Native HTML, Text &amp; URLs · Bdnd</PageTitle>

<div class="bb-intro">
    <h1>Other - Native HTML, Text &amp; URLs</h1>
    <p class="bb-subtitle">
        The target below accepts <code>BdndNativeTypes.Html</code>, <code>BdndNativeTypes.Text</code> and
        <code>BdndNativeTypes.Url</code>. Select some text on another page (or in the box on the right)
        and drag it here, or drag a link / image - the dropped HTML, plain text and any URLs
        are read from the native <code>DataTransfer</code>. The HTML is shown as text: dropped markup is untrusted
        input, to be sanitized before it is ever rendered. The box below the target goes the other way: its
        <code>NativeData</code> is what it carries out of the page.
    </p>
</div>

<div class="bb-demo">
    <BdndProvider>
        <div class="row-wrap" style="align-items:flex-start;">
            <BdndDropTarget TItem="object" Context="t" style="display:contents"
                            AcceptTypes="_accepted" OnNativeDrop="HandleNativeDrop">
                <div class="dustbin"
                     style="@($"width:24rem;height:10rem;background:{(t.IsOver ? "#6a1b9a" : "#333")};")">
                    @(t.IsOver ? $"Release ({t.ItemType})" : "Drag selected text / a link here")
                </div>
            </BdndDropTarget>

            <div class="native-source">
                <p>Try selecting and dragging <b>this rich text</b> with a
                    <a href="https://react-dnd.github.io/react-dnd" target="_blank" rel="noopener">link inside</a>.</p>
            </div>
        </div>

        @* NativeData: what this in-app drag carries for destinations outside the page. Dropped on the target above
           it is still the in-app drag it is - the target takes native drags only - but a text field, another
           application or the address bar of another tab read the text and the link. *@
        <BdndDraggable TItem="string" Type="@ItemTypes.Card" Item="@("out")" NativeData="_outData" DropEffect="copy"
                       class="box native-out" Context="drag">
            Drag me into a text editor, or onto another tab's address bar
        </BdndDraggable>

        @* Text only, with a field inside: a text drag over the field is left to the browser, and only a drop around it
           reaches OnNativeDrop. *@
        <BdndDropTarget TItem="object" Accept="@BdndNativeTypes.Text" OnNativeDrop="@(e => _note = e.Text)"
                        class="native-zone native-notes" Context="notes">
            <span>@(notes.IsOver ? "Release on the field, or around it" : "Text only")</span>
            <textarea class="native-notes__field" aria-label="Notes" rows="3"
                      placeholder="Drop text on this field: it lands in the field"></textarea>
            <span class="native-notes__last">@(_note is null ? "Dropped around the field: nothing yet" : $"Dropped around the field: {_note}")</span>
        </BdndDropTarget>
    </BdndProvider>

    @if (_last is not null)
    {
        <div class="native-drop-result">
            <h4>Last native drop - <code>@_last.ItemType</code></h4>
            @if (string.IsNullOrEmpty(_last.Text) is false)
            {
                <p><b>Text:</b> @_last.Text</p>
            }
            @if (_last.Urls.Count > 0)
            {
                <p><b>URLs:</b> @string.Join(", ", _last.Urls)</p>
            }
            <p class="native-drop-data">
                <b>Data:</b> @string.Join(", ", _last.Data.Select(pair => $"{pair.Key} ({pair.Value.Length} characters)"))
            </p>
            @if (string.IsNullOrEmpty(_last.Html) is false)
            {
                <div>
                    <b>HTML (raw):</b>
                    <pre class="bb-code native-drop-html">@_last.Html</pre>
                </div>
            }
        </div>
    }
</div>

<DemoCode />

<div class="bb-note">
    The payload is read during the drop, the only moment the browser allows it. While a drag hovers,
    <code>ItemType</code> tells which of the accepted types matched first, in the order the target lists them;
    <code>Data</code> holds the string of every accepted type the drag carried, and <code>Text</code>,
    <code>Html</code>, <code>Url</code> and <code>Urls</code> are shortcuts into it. A target reads only the types it
    accepts: the last one takes <code>BdndNativeTypes.Text</code>, so a drag's HTML is never read there. Its text
    field shows how a target treats an editable field inside it: a text drag over the field is left to the browser, so
    dropped on the field the text goes into the field as it would anywhere; dropped on the rest of the target, it reaches
    <code>OnNativeDrop</code>. Inside the page, the "drag me" box's drag stays the in-app drag it is - neither target takes
    it for native text - but a text editor, another application or another tab's address bar read its
    <code>NativeData</code>.
</div>

@code {
    private readonly string[] _accepted =
        [BdndNativeTypes.Html, BdndNativeTypes.Text, BdndNativeTypes.Url];

    private readonly Dictionary<string, string> _outData = new()
    {
        ["text/plain"] = "Bdnd drags carry text for other applications.",
        ["text/uri-list"] = "https://bdnd.bitplatform.dev/",
    };

    private BdndNativeDropEventArgs? _last;
    private string? _note;

    private void HandleNativeDrop(BdndNativeDropEventArgs e) => _last = e;
}
