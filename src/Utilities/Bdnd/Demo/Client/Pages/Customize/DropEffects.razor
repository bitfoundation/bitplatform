@page "/customize/drop-effects"

<PageTitle>Customize - Drop Effects · Bdnd</PageTitle>

<div class="bb-intro">
    <h1>Customize - Drop Effects</h1>
    <p class="bb-subtitle">
        A drag source can advertise a drop effect through <code>DropEffect</code>, which sets the
        native <code>dataTransfer.effectAllowed</code>. Drag the two boxes below and watch the
        cursor: the <em>copy</em> box shows a “+” badge, the <em>move</em> box does not.
    </p>
</div>

<DemoCode />

<div class="bb-demo">
    <BdndProvider>
        <div class="row-wrap">
            <BdndDraggable TItem="string" Type="@ItemTypes.Box" Item="@("copy")"
                           DropEffect="copy" Context="d">
                <div class="box" style="width:11rem;opacity:@(d.IsDragging ? "0.4" : "1")">
                    Copy me (effect = copy)
                </div>
            </BdndDraggable>

            <BdndDraggable TItem="string" Type="@ItemTypes.Box" Item="@("move")"
                           DropEffect="move" Context="d">
                <div class="box" style="width:11rem;opacity:@(d.IsDragging ? "0.4" : "1")">
                    Move me (effect = move)
                </div>
            </BdndDraggable>
        </div>

        <BdndDropTarget TItem="string" Accept="@ItemTypes.Box" Context="t"
                        style="display:contents" OnDrop="HandleDrop">
            <div class="dustbin" style="@($"margin-top:1.5rem;width:18rem;background:{(t.IsOver ? "darkgreen" : "#333")};")">
                @(string.IsNullOrEmpty(_last) ? "Drop here" : $"Last drop used: {_last}")
            </div>
        </BdndDropTarget>
    </BdndProvider>
</div>

<div class="bb-note">
    The browser only offers the effects a source allows. With <code>DropEffect="copyMove"</code>
    the user can switch to copying by holding <kbd>Ctrl</kbd> (<kbd>⌥</kbd> on macOS) during the drag;
    the boxes above allow a single effect each, so modifier keys do not change them.
</div>

@code {
    private string? _last;

    private void HandleDrop(BdndDropEventArgs<string> e) => _last = e.Item;
}
