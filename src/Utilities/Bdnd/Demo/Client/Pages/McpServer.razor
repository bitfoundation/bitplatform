@page "/mcp-server"

@* Describes the MCP server this demo's host maps at /mcp. Its route differs from the endpoint's on
   purpose: two literal endpoints on /mcp would make a GET of it ambiguous. *@

<PageTitle>MCP server · Bdnd</PageTitle>

<div class="bb-intro">
    <h1>MCP server</h1>
    <p class="bb-subtitle">
        This site hosts a Model Context Protocol server at <code>/mcp</code>, so an AI agent writing drag-and-drop
        code with Bit.Bdnd reads the library itself - its compiled API documentation, its guide, the components and
        these demo pages - instead of guessing at an API it half remembers, or borrowing one from React DnD. Every
        tool is read-only.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Connect a client</h3>

    <p>
        The endpoint is plain Streamable HTTP, so any MCP client connects with a URL and nothing else. The same tools
        are also served, version by version, through the bit platform's own server at
        <code>https://bitplatform.dev/mcp</code>, next to the other bit libraries.
    </p>

    <pre class="bb-code">@ClientConfig</pre>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Tools</h3>

    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Tool</th><th>What it answers</th></tr>
            </thead>
            <tbody>
                @foreach (var tool in Tools)
                {
                    <tr>
                        <td class="bb-table-key"><code>@tool.Name</code></td>
                        <td>@((MarkupString)tool.Description)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p>
        The guide, the API, a sample scenario and the sources are also exposed as <code>bdnd://</code>
        resources, and three prompts - <code>add-bdnd-to-app</code>, <code>implement-bdnd-feature</code> and
        <code>debug-bdnd-drag</code> - walk an agent through the common jobs in the right order.
    </p>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> The same tools over plain HTTP</h3>

    <p>
        Every tool is also a <code>GET</code> under <code>/api/mcp/...</code>: open one in a browser tab to read
        exactly what an agent is handed.
    </p>

    <ul class="bb-detail-list">
        @foreach (var (href, text) in HttpExamples)
        {
            <li><a href="@href" target="_blank" rel="noopener">@text</a></li>
        }
    </ul>
</section>

@code {
    private const string ClientConfig = """
        // .mcp.json (Claude Code, VS Code, and anything else reading this shape)
        {
          "mcpServers": {
            "bdnd": {
              "type": "http",
              "url": "https://bdnd.bitplatform.dev/mcp"
            }
          }
        }
        """;

    // The server's tools, in the order an agent usually needs them. The one place to change when a tool is
    // added, renamed or retired; the description is markup.
    private static readonly (string Name, string Description)[] Tools =
    [
        ("SearchBdnd",
            "Everything at once - the guide, every public member, the setup guides and the demo's pages - each hit with the exact follow-up call."),
        ("GetBdndSetupGuide",
            "The complete wiring for one render mode: server, wasm, auto, standalone-wasm or hybrid - the service registration and the provider included."),
        ("GetBdndGuideSection",
            "One section of the reference guide, or the index of sections."),
        ("GetBdndApi",
            "One public type with every parameter, property and method, its real default and its documentation - or the index of types."),
        ("InspectBdndDrop",
            "Runs a drag through the real components - a draggable and a tree of drop targets - and reports which targets can drop, which are hovered (deep and shallow), the order <code>OnDrop</code> runs in and what <code>OnEnd</code> receives - or a sample scenario, to see the format."),
        ("GetBdndSourceFile",
            "One demo or library file verbatim - every page here is a working example - or the index of files."),
    ];

    private static readonly (string Href, string Text)[] HttpExamples =
    [
        ("/api/mcp/SearchBdnd?query=sortable%20list", "/api/mcp/SearchBdnd?query=sortable list"),
        ("/api/mcp/GetBdndApi?typeName=BdndDraggable", "/api/mcp/GetBdndApi?typeName=BdndDraggable"),
        ("/api/mcp/InspectBdndDrop", "/api/mcp/InspectBdndDrop (runs the sample scenario)"),
        ("/api/mcp/GetBdndSourceFile?path=Demo/Client/Pages/Sortable/SortableCard.razor", "/api/mcp/GetBdndSourceFile?path=Demo/Client/Pages/Sortable/SortableCard.razor"),
    ];
}
