@namespace Bit.Bdnd.Demo.Client.Examples
@inject NavigationManager Nav

@* A collapsible "View code" panel under a demo's sample: the .razor source of the current page, then of
   the components beside it that the page renders (a sortable card, a tree node), each under its file
   name. The sources are resolved from the build-generated DemoSources lookup, keyed by route, and
   coloured by SyntaxHighlighter (its token colours are in demo.css); every block is the site kit's
   pre.bb-code, which site.js gives a copy button. *@

<div class="bb-source demo-code">
    <button type="button"
            class="btn btn-secondary demo-code__toggle"
            aria-expanded="@_open.ToString().ToLowerInvariant()"
            @onclick="Toggle">
        <span class="demo-code__caret">@(_open ? "▾" : "▸")</span>
        <span class="demo-code__glyph">&lt;/&gt;</span>
        @(_open ? "Hide code" : "View code")
    </button>

    @if (_open)
    {
        @if (_files is null)
        {
            <div class="bb-empty demo-code__empty">Source for this page is not available.</div>
        }
        else
        {
            @foreach (var file in _files)
            {
                <p class="bb-source-file demo-code__file">@file.Name</p>
                <pre class="bb-code demo-code__pre"><code class="demo-code__code">@file.Html</code></pre>
            }
        }
    }
</div>

@code {
    private bool _open;
    private (string Name, MarkupString Html)[]? _files;
    private bool _resolved;

    private void Toggle()
    {
        _open = !_open;
        if (_open && !_resolved)
        {
            _files = Resolve()?.Select(f => (f.Name, (MarkupString)SyntaxHighlighter.Highlight(f.Code))).ToArray();
            _resolved = true;
        }
    }

    private (string Name, string Code)[]? Resolve()
    {
        var key = Nav.ToBaseRelativePath(Nav.Uri);

        // Drop any query string or fragment so the key matches the @page route. The lookup
        // itself ignores case, as the router does.
        var cut = key.IndexOfAny(['?', '#']);
        if (cut >= 0) key = key[..cut];

        return DemoSources.ByRoute.TryGetValue(key.TrimEnd('/'), out var sources) ? sources : null;
    }
}
