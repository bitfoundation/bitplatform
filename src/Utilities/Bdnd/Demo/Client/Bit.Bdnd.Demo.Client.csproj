<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- The host owns the launch profile: this project is never started on its own. -->
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <!-- Publishes this project's static web assets at the app root (not under _content/), the
             way a Blazor Web App's client project is expected to contribute them. -->
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Bit.Minifier" Version="11.0.0-pre-14" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Bdnd\Bit.Bdnd.csproj" />
    </ItemGroup>

    <!--
        Generates a compiled lookup (DemoSources.g.cs) that maps each routable demo page's
        @page route to the .razor sources its "View code" snippet shows: the page itself, then
        every non-routable component under Pages that the page renders (a sortable card, a tree
        node), so the demo can render complete snippets at runtime without any per-page wiring.
        Those components' sources are also listed on their own, by their path under Pages, for a
        page that shows one inline (Getting started's first drag and drop).
    -->
    <UsingTask TaskName="GenerateDemoSources"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <SourceDir ParameterType="System.String" Required="true" />
            <OutputFile ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.Collections.Generic" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Using Namespace="System.Text" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs">
<![CDATA[
var files = Directory.GetFiles(SourceDir, "*.razor", SearchOption.AllDirectories)
    .OrderBy(f => f, StringComparer.Ordinal)
    .ToArray();
// Each file is read once, for the @page test, the snippet and the companion lookup alike.
var texts = files.ToDictionary(f => f, f => File.ReadAllText(f), StringComparer.Ordinal);

// The components a page can render that live beside the pages - the .razor files with no @page -
// keyed by their component name. Two folders can each have a component of the same name.
var companions = new Dictionary<string, List<string>>(StringComparer.Ordinal);
foreach (var file in files)
{
    if (Regex.IsMatch(texts[file], @"(?m)^[ \t]*@page\b")) continue;
    var name = Path.GetFileNameWithoutExtension(file);
    if (!companions.TryGetValue(name, out var paths)) companions[name] = paths = new List<string>();
    paths.Add(file);
}

// The companion a tag in the file at `owner` names: the one in the same folder, which the compiler
// resolves without a @using, or else the only one of that name. A name several other folders share
// is reported rather than guessed.
Func<string, string, string> resolve = (component, owner) =>
{
    List<string> candidates;
    if (!companions.TryGetValue(component, out candidates)) return null;
    var local = candidates.FirstOrDefault(p => Path.GetDirectoryName(p) == Path.GetDirectoryName(owner));
    if (local != null) return local;
    if (candidates.Count == 1) return candidates[0];
    Log.LogWarning("{0} renders <{1}>, which {2} components under Pages are named: its snippet leaves them out.",
        Path.GetFileName(owner), component, candidates.Count);
    return null;
};

// The components a source renders, in the order it first uses them: the tags named for a component,
// outside comments - neither `@* <SortableCard /> *@` nor a type argument, `List<TreeNodeView>`, renders one.
Func<string, IEnumerable<string>> rendered = source =>
    Regex.Matches(
            Regex.Replace(source, @"@\*.*?\*@|<!--.*?-->|/\*.*?\*/|^[ \t]*//[^\n]*", "", RegexOptions.Singleline | RegexOptions.Multiline),
            @"(?<![\w.])<([A-Z]\w*)[\s/>]")
        .Cast<Match>()
        .Select(m => m.Groups[1].Value);

// Collapses any runs of blank lines left by the removals, and drops the blank lines left at
// either end.
Func<string, string> tidy = source => Regex.Replace(source, @"(\r?\n){3,}", "\n\n").Trim('\r', '\n', ' ', '\t');

var sb = new StringBuilder();
sb.AppendLine("// <auto-generated />");
sb.AppendLine("namespace Bit.Bdnd.Demo.Client.Examples;");
sb.AppendLine("public static class DemoSources");
sb.AppendLine("{");
// Case-insensitive, like the router: /Sortable/Simple renders the same page as /sortable/simple.
sb.AppendLine("    public static readonly System.Collections.Generic.Dictionary<string, (string Name, string Code)[]> ByRoute = new(System.StringComparer.OrdinalIgnoreCase)");
sb.AppendLine("    {");
foreach (var file in files)
{
    var content = texts[file];
    var match = Regex.Match(content, "@page\\s+\"([^\"]+)\"");
    if (!match.Success) continue;
    var route = match.Groups[1].Value.TrimStart('/');

    // Strip demo-app chrome so the snippet shows only the example itself.
    // 1. The @page routing directive.
    content = Regex.Replace(content, @"(?m)^[ \t]*@page[ \t]+""[^""]*""[ \t]*\r?\n", "");
    // 2. The <PageTitle> that sets the browser tab title.
    content = Regex.Replace(content, @"(?s)[ \t]*<PageTitle>.*?</PageTitle>[ \t]*\r?\n", "");
    // 3. The bb-intro title block on the hand-written demo pages. Its end is found by
    //    balancing <div> tags rather than with a lazy match, which would stop at the first
    //    </div> nested inside the header and leave the rest of it behind.
    var header = Regex.Match(content, @"[ \t]*<div class=""bb-intro"">");
    if (header.Success)
    {
        var depth = 0;
        var end = -1;
        for (var tag = Regex.Match(content.Substring(header.Index), @"<div\b|</div\s*>"); tag.Success; tag = tag.NextMatch())
        {
            depth += tag.Value.StartsWith("</", StringComparison.Ordinal) ? -1 : 1;
            if (depth == 0)
            {
                end = header.Index + tag.Index + tag.Length;
                break;
            }
        }
        if (end >= 0)
        {
            // Take the rest of the closing tag's line with it.
            var rest = Regex.Match(content.Substring(end), @"^[ \t]*\r?\n");
            if (rest.Success) end += rest.Length;
            content = content.Remove(header.Index, end - header.Index);
        }
    }
    // 4. The <DemoCode /> toggle element (it powers this snippet, it isn't part of the demo).
    content = Regex.Replace(content, @"(?s)[ \t]*<DemoCode[ \t]*/>[ \t]*\r?\n", "");

    // The page first, then the companion components it renders - and the ones those render - in
    // the order they are first used.
    var sources = new List<KeyValuePair<string, string>> { new KeyValuePair<string, string>(file, content) };
    var seen = new HashSet<string>(StringComparer.Ordinal) { file };
    for (var k = 0; k < sources.Count; k++)
    {
        foreach (var name in rendered(sources[k].Value))
        {
            var path = resolve(name, sources[k].Key);
            if (path != null && seen.Add(path))
                sources.Add(new KeyValuePair<string, string>(path, texts[path]));
        }
    }

    sb.Append("        [@\"").Append(route.Replace("\"", "\"\"")).Append("\"] = [");
    for (var k = 0; k < sources.Count; k++)
    {
        if (k > 0) sb.Append(", ");
        sb.Append("(@\"").Append(Path.GetFileName(sources[k].Key).Replace("\"", "\"\""))
          .Append("\", @\"").Append(tidy(sources[k].Value).Replace("\"", "\"\"")).Append("\")");
    }
    sb.AppendLine("],");
}
sb.AppendLine("    };");
sb.AppendLine();
// The components themselves, by their path under Pages: "Sortable/SortableCard.razor".
sb.AppendLine("    public static readonly System.Collections.Generic.Dictionary<string, string> Components = new(System.StringComparer.Ordinal)");
sb.AppendLine("    {");
foreach (var paths in companions.Values)
{
    foreach (var path in paths)
    {
        var relative = path.Substring(SourceDir.Length).TrimStart('\\', '/').Replace('\\', '/');
        sb.Append("        [@\"").Append(relative.Replace("\"", "\"\"")).Append("\"] = @\"")
          .Append(tidy(texts[path]).Replace("\"", "\"\"")).AppendLine("\",");
    }
}
sb.AppendLine("    };");
sb.AppendLine("}");

// Only touch the file when its content changed: rewriting it on every build would bump its
// timestamp and force a full recompile of the demo even when no page was edited.
var text = sb.ToString();
if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
{
    Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
    File.WriteAllText(OutputFile, text, new UTF8Encoding(false));
}
]]>
            </Code>
        </Task>
    </UsingTask>

    <Target Name="GenerateDemoSources" BeforeTargets="BeforeCompile;CoreCompile">
        <PropertyGroup>
            <DemoSourcesFile>$(IntermediateOutputPath)DemoSources.g.cs</DemoSourcesFile>
        </PropertyGroup>
        <GenerateDemoSources SourceDir="$(MSBuildProjectDirectory)\Pages" OutputFile="$(DemoSourcesFile)" />
        <!-- Unconditional: the file has to be compiled whether or not this build rewrote it.
             FileWrites lets Clean delete it. -->
        <ItemGroup>
            <Compile Include="$(DemoSourcesFile)" />
            <FileWrites Include="$(DemoSourcesFile)" />
        </ItemGroup>
    </Target>

</Project>
