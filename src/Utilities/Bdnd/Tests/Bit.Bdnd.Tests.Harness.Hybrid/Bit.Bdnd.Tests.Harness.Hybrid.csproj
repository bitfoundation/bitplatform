<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The Blazor Hybrid host the E2E suite drags in. WinForms rather than MAUI: both sit on the same
         Microsoft.AspNetCore.Components.WebView core (the WebViewManager that serves _content/ assets, runs the
         renderer out of the browser's process and bridges JS interop), and on Windows both render through WebView2,
         which Playwright drives over the Chrome DevTools Protocol. WinForms gets there without the MAUI workload. -->

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net11.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- Lets Bit.Bdnd.slnx build on the Linux CI runner; running it still needs Windows. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="11.0.0-rc.2.26505.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Bdnd\Bit.Bdnd.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
