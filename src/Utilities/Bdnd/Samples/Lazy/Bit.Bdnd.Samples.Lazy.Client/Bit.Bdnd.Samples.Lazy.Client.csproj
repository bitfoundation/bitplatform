<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!-- The browser half of the lazy loading sample: it downloads Bit.Bdnd.wasm only when a page that drags opens. It
         does everything the README's "Lazy loading on WebAssembly" section asks of such a project, and the end-to-end
         suite (Tests/Bit.Bdnd.Tests.E2E, LazyLoadingTests) publishes it and checks it in a browser. -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
        <ProjectReference Include="..\..\..\Bit.Bdnd\Bit.Bdnd.csproj" />
    </ItemGroup>

    <!-- AOT builds load Bit.Bdnd with the rest of the app. -->
    <ItemGroup Condition=" '$(RunAOTCompilation)' != 'true' ">
        <BlazorWebAssemblyLazyLoad Include="Bit.Bdnd.wasm" />
        <RuntimeHostConfigurationOption Include="Bit.Bdnd.Samples.Lazy.LazyLoadsBdnd" Value="true" Trim="true" />
    </ItemGroup>

</Project>
