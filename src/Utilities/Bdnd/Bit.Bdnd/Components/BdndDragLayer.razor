@namespace Bit.Bdnd
@typeparam TItem
@implements IDisposable

@if (ChildContent is not null)
{
    @ChildContent(BuildState())
}

@code {
    [CascadingParameter] private BdndDragDropManager? Manager { get; set; }

    /// <summary>The preview to render; it receives the live drag state, offsets included.</summary>
    [Parameter] public RenderFragment<BdndDragLayerState<TItem>>? ChildContent { get; set; }

    /// <summary>
    /// The item type this layer draws. With <c>Accept</c> or <c>AcceptTypes</c> set, a drag of another type is no
    /// drag to the layer - and its pointer moves are not sent to .NET for it, which on Blazor Server spares a message
    /// over the circuit per move. Without either, the layer follows every drag.
    /// </summary>
    [Parameter] public string? Accept { get; set; }

    /// <summary>More item types this layer draws (combined with <c>Accept</c>).</summary>
    [Parameter] public IEnumerable<string>? AcceptTypes { get; set; }

    private IDisposable? _following;
    private string[]? _types; // null: every drag

    protected override void OnInitialized()
    {
        if (Manager is null)
            throw new InvalidOperationException(
                $"{nameof(BdndDragLayer<TItem>)} must be placed inside a {nameof(BdndProvider)}.");
        Manager.StateChanged += OnChanged;
    }

    protected override void OnParametersSet()
    {
        var types = new List<string>();
        if (string.IsNullOrEmpty(Accept) is false) types.Add(Accept);
        if (AcceptTypes is not null) types.AddRange(AcceptTypes.Where(t => string.IsNullOrEmpty(t) is false));
        var accepted = types.Count == 0 ? null : types.Distinct(StringComparer.Ordinal).ToArray();
        if (_following is not null && (accepted ?? []).SequenceEqual(_types ?? [])) return;
        _following?.Dispose();
        _types = accepted;
        _following = Manager!.FollowOffsets(accepted, OnChanged);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private BdndDragLayerState<TItem> BuildState()
    {
        var m = Manager!.Monitor;
        // a drag of a type the layer does not draw is no drag to it
        if (_types is not null && (m.GetItemType() is not { } type || _types.Contains(type) is false))
        {
            return new BdndDragLayerState<TItem> { Monitor = m };
        }
        return new BdndDragLayerState<TItem>
        {
            Monitor = m,
            IsDragging = m.IsDragging(),
            ItemType = m.GetItemType(),
            Item = m.GetItem() is TItem t ? t : default,
            InitialClientOffset = m.GetInitialClientOffset(),
            InitialSourceClientOffset = m.GetInitialSourceClientOffset(),
            ClientOffset = m.GetClientOffset(),
            DifferenceFromInitialOffset = m.GetDifferenceFromInitialOffset(),
            SourceClientOffset = m.GetSourceClientOffset(),
        };
    }

    public void Dispose()
    {
        if (Manager is null) return;
        Manager.StateChanged -= OnChanged;
        _following?.Dispose();
    }
}
