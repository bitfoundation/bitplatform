<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../Bit.Build.props" />

    <!-- Hangfire spans for Bit.Belemetry: a job filter that carries the trace context of the enqueue into the job's
         parameters and starts an Activity around each execution, on the Bit.Belemetry.Hangfire source the core
         collects by default. A separate package because Hangfire is a server-only dependency. -->

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Any 1.8 or later 1.x release: job filters and Job.Queue have been stable since 1.8. -->
        <PackageReference Include="Hangfire.Core" Version="[1.8.0,2.0.0)" />
        <!-- Every Hangfire.Core 1.8.x declares Newtonsoft.Json >= 11.0.1, so this project's own restore - which takes
             the floor of every range - compiles against a version with a known advisory. Nothing here uses
             Newtonsoft.Json, nothing of it ships in the package, and the consuming app's restore picks the real
             version; a direct reference just to lift the floor would make it a dependency of this package. -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5crp-9r3c-p9vr" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Belemetry\Bit.Belemetry.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.Belemetry.Tests.Hangfire" PublicKey="" />
    </ItemGroup>

</Project>
