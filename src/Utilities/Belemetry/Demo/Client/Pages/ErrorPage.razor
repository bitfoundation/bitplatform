@page "/Error"
@layout MainLayout

@* Target of app.UseExceptionHandler("/Error") in the host's Program.cs. It lives in the client
   project on purpose: Routes.razor binds the router to this assembly only, so a page placed in
   the host project would never be matched and the re-executed request would end in a 404. *@

<PageTitle>Error · Belemetry</PageTitle>

<div class="bb-error">
    <h1>500</h1>
    <p role="alert">
        An error occurred while processing your request. Reloading usually clears it; if it does not, the
        repository is the place to tell us about it.
    </p>
    <div class="bb-try bb-error-actions">
        <a href="" class="btn btn-primary">Go to the home page</a>
        <a href="https://github.com/bitfoundation/bitplatform/issues" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">Report an issue ↗</a>
    </div>
</div>
