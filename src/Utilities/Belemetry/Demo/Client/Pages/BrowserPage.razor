@page "/browser"
@using System.Text.Json
@inject IJSRuntime JS
@inject IBelemetry Belemetry

<PageTitle>Browser instrumentation · Belemetry</PageTitle>

<div class="bb-intro">
    <h1>Browser instrumentation</h1>
    <p class="bb-subtitle">
        The browser half of Belemetry is one dependency-free ES module, <code>bit-belemetry.js</code>. It starts from
        the configuration <code>&lt;BelemetryScript /&gt;</code> writes into the page, before Blazor boots, so it sees
        the initial load, the web vitals and the earliest errors - on interactive and static SSR pages alike. Every
        section below has a live trigger and, under it, the records it produced, read back from this site's own OTLP
        receiver.
    </p>
</div>

<div class="bb-note">
    Nothing is recorded until you grant it. Each instrumentation belongs to one consent feature (named in its
    section); if a feed below says nothing is granted, accept the banner or pick features on the
    <a href="/consent">consent page</a>. Records of a feature you have not decided on yet are held in memory and
    sent once you grant it.
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Page views</h3>
    <p>
        Feature <code>PageViews</code>. The script records the initial load and every client-side navigation -
        <code>history.pushState</code>, <code>replaceState</code>, <code>popstate</code> and Blazor's enhanced
        navigation - as a log record with the event name <code>browser.page_view</code>, carrying
        <code>url.full</code>, <code>url.path</code>, <code>page.title</code>, <code>page.referrer</code> and
        <code>browser.navigation.type</code>:
    </p>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead><tr><th scope="col">Type</th><th scope="col">When</th></tr></thead>
            <tbody>
                <tr><td><code>initial</code></td><td>The document load</td></tr>
                <tr><td><code>push</code> / <code>replace</code></td><td><code>history.pushState</code> / <code>replaceState</code> - a Blazor link click, <code>NavigationManager.NavigateTo</code>, an enhanced navigation</td></tr>
                <tr><td><code>pop</code></td><td>The browser's back and forward buttons within the app (<code>popstate</code>)</td></tr>
                <tr><td><code>hash</code></td><td>A change of the fragment alone - recorded only with <code>TrackHashChanges</code> (off by default)</td></tr>
                <tr><td><code>manual</code></td><td><code>TrackPageView</code> from C# or JavaScript</td></tr>
                <tr><td><code>restore</code></td><td>The page came back from the back/forward cache (a <code>pageshow</code> with <code>persisted</code>): no navigation event fires, but to the user it is a new visit</td></tr>
            </tbody>
        </table>
    </div>
    <p>
        With <code>TrackPageVisitTime</code> (off by default) the time spent on each page is recorded too, as a
        <code>browser.page_visit_time</code> event carrying <code>page.visit.duration</code> (milliseconds) - emitted
        for the previous page when the next page view starts, and for the current one when it is hidden. The next
        visit starts when the page is shown again, so time in a background tab or in the back/forward cache is
        counted nowhere and nothing is counted twice. Application Insights shows it as the
        <code>PageVisitTime</code> event, the shape its own JavaScript SDK uses.
    </p>
    <p>
        For views the URL does not show - a dialog, a wizard step, a tab - call <code>IBelemetry.TrackPageView</code>.
        In this demo the .NET side runs in WebAssembly, so that record goes through the .NET pipeline and shows up
        with the source <code>wasm</code>.
    </p>
    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live<span class="demo-sample-title">PageViews</span></span></div>
        <div class="bb-toolbar">
            <a class="btn btn-secondary" href="/dotnet">Go to the .NET page (then come back)</a>
            <button type="button" class="btn btn-primary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="TrackVirtualPageView">
                TrackPageView("Checkout - payment step")
            </button>
        </div>
        <TelemetryFeedView Compact="true" Match="@IsPageView"
                           EmptyText="No page views yet - navigate away and back, or press the button." />
    </div>
    <CodeSnippet Code="@PageViewCode" Language="Razor" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Interactions</h3>
    <p>
        Feature <code>Interactions</code>. A capture-phase listener records every <code>click</code> (or the events in
        <code>InteractionEvents</code>) on a link, a button, a submit input or any element carrying
        <code>data-bit-belemetry-name</code>, as a <code>browser.user_interaction</code> event with
        <code>target.element</code>, <code>target.id</code>, <code>target.name</code> and <code>target.xpath</code>.
        The name comes from <code>data-bit-belemetry-name</code>, then <code>aria-label</code>, then <code>name</code>.
        The element's text is recorded only with <code>CaptureInteractionText</code>, because text can be personal
        data, and input values are never read. Anything under <code>data-bit-belemetry-ignore</code> is skipped.
        Three clicks on one element within a second also record one <code>browser.rage_click</code> event
        (<code>TrackRageClicks</code>, on by default) - the frustration signal of a user who expected something to
        happen; press Pay three times quickly.
    </p>
    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live<span class="demo-sample-title">Interactions</span></span></div>
        <p class="bb-overline demo-sublabel">Recorded</p>
        <div class="bb-toolbar">
            <button type="button" class="btn btn-primary" data-bit-belemetry-name="demo.checkout.pay">Pay (data-bit-belemetry-name)</button>
            <button type="button" class="btn btn-secondary" aria-label="Add to wishlist">Wishlist (aria-label)</button>
        </div>
        <p class="bb-overline demo-sublabel">Not recorded</p>
        <div class="bb-toolbar" data-bit-belemetry-ignore>
            <button type="button" class="btn btn-secondary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="() => _ignoredClicks++">
                Inside data-bit-belemetry-ignore (@_ignoredClicks)
            </button>
        </div>
        <TelemetryFeedView Compact="true" Match="@IsInteraction"
                           EmptyText="No interactions yet - press the buttons above. Every other button on this page is recorded too." />
    </div>
    <CodeSnippet Code="@InteractionCode" Language="Razor" />
    <CodeSnippet Code="@InteractionOptionsCode" Language="C#" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Web vitals</h3>
    <p>
        Feature <code>Performance</code>. The five Core Web Vitals and their companions are measured from the
        Performance Timeline and recorded as <code>browser.web_vital</code> events with <code>web_vital.name</code>,
        <code>web_vital.value</code>, <code>web_vital.delta</code>, <code>web_vital.rating</code>
        (<code>good</code>, <code>needs-improvement</code> or <code>poor</code>, on the official thresholds),
        <code>web_vital.id</code> and <code>web_vital.navigation_type</code>:
    </p>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead><tr><th scope="col">Vital</th><th scope="col">Measures</th><th scope="col">Reported</th></tr></thead>
            <tbody>
                <tr><td><code>TTFB</code></td><td>Time to first byte of the document</td><td>At start, once the response has begun</td></tr>
                <tr><td><code>FCP</code></td><td>First contentful paint</td><td>When it happens</td></tr>
                <tr><td><code>LCP</code></td><td>Largest contentful paint</td><td>At the first click or key press, or when the page is hidden</td></tr>
                <tr><td><code>CLS</code></td><td>Cumulative layout shift (largest session window)</td><td>When the page is hidden</td></tr>
                <tr><td><code>INP</code></td><td>Interaction to next paint</td><td>When the page is hidden</td></tr>
            </tbody>
        </table>
    </div>
    <p>
        CLS and INP keep changing for as long as the page is open, so they are reported when it is hidden - switch to
        another tab and back after pressing the button. A shift that follows your input within 500 ms does not count
        (the spec's <code>hadRecentInput</code>), so the spacer this button inserts is excluded; the shift when it is
        removed 1.5 s later is the one CLS records.
    </p>
    <p>
        A page restored from the back/forward cache is a new visit to the user, but the browser keeps its old
        timeline. So, as Google's <code>web-vitals</code> library does, a restore starts a new generation of vitals
        under new ids: FCP and LCP measured from the restore to the next painted frame, CLS and INP counted from zero,
        and <code>web_vital.navigation_type = back-forward-cache</code> (otherwise it is the navigation's own type:
        <code>navigate</code>, <code>reload</code>, <code>back-forward</code> or <code>prerender</code>). To try it, go
        to another site in this tab and press Back: when the browser restores this page from its cache, the page view
        feed above shows a view of type <code>restore</code>, and new vitals follow.
    </p>
    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live<span class="demo-sample-title">Performance - web vitals</span></span></div>
        <div class="bb-toolbar">
            <button type="button" class="btn btn-primary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="ShiftLayout">Cause a layout shift</button>
        </div>
        @if (MissingVitals is { Length: > 0 } missing)
        {
            <p class="demo-status">
                This browser does not report @string.Join(", ", missing): it lacks the Performance API
                @(missing.Length == 1 ? "that vital is" : "those vitals are") measured with, and the script skips what it
                cannot measure. A Chromium-based browser reports all five.
            </p>
        }
        <div id="bl-shift-target">
            <p>This paragraph moves down while a spacer is inserted above it, then jumps back.</p>
        </div>
        <TelemetryFeedView Compact="true" Match="@IsWebVital"
                           EmptyText="No web vitals yet - TTFB and FCP arrive first; switch tabs and come back for CLS and INP." />
    </div>
    <CodeSnippet Code="@WebVitalsCode" Language="C#" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Document load, resources and long tasks</h3>
    <p>
        Also feature <code>Performance</code>. <code>DocumentLoad</code> (on by default) records the initial load as
        an internal <code>documentLoad</code> span with the navigation-timing milestones as events
        (<code>domInteractive</code>, <code>domContentLoadedEventEnd</code>, <code>loadEventEnd</code>, ...).
        <code>ResourceTiming</code> (off by default) adds a <code>resourceFetch</code> span per script, stylesheet and
        image with <code>url.full</code>, <code>http.response.body.size</code> and <code>network.protocol.name</code> -
        a lot of records, so turn it on deliberately. <code>LongTasks</code> (off by default, on in this demo) records
        every main-thread task over 50 ms as a <code>longtask</code> span.
    </p>
    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live<span class="demo-sample-title">Performance - spans</span></span></div>
        <div class="bb-toolbar">
            <button type="button" class="btn btn-primary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="BlockMainThread">Block the main thread for 200 ms</button>
        </div>
        @if (_entryTypes is not null && _entryTypes.Contains("longtask") is false)
        {
            <p class="demo-status">
                This browser has no Long Tasks API, so the button records nothing here; a Chromium-based browser records
                a <code>longtask</code> span.
            </p>
        }
        <TelemetryFeedView Compact="true" Match="@IsPerformanceSpan"
                           EmptyText="No documentLoad or longtask spans yet - press the button, or reload the page." />
    </div>
    <CodeSnippet Code="@PerformanceCode" Language="C#" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> fetch and XHR with trace context</h3>
    <p>
        Feature <code>Dependencies</code>. Every <code>fetch</code> and <code>XMLHttpRequest</code> becomes a client
        span named after its method, with <code>http.request.method</code>, <code>url.full</code>,
        <code>server.address</code>, <code>server.port</code>, <code>http.response.status_code</code> and, for a
        failure or a 4xx/5xx answer, <code>error.type</code> and an error status. For targets matched by
        <code>PropagateTraceContextTo</code> (same-origin by default) the script adds a W3C <code>traceparent</code>
        header, so the browser span and the server's request span join one trace.
    </p>
    <ul class="bb-detail-list">
        <li>
            <strong>Failures.</strong> A 4xx or 5xx answer sets <code>error.type</code> to the status code; a request
            that never got an answer sets it to the error's name - <code>TypeError</code> for a network failure of
            <code>fetch</code>, <code>NetworkError</code> or <code>TimeoutError</code> for an XHR - and all of them get an
            error status.
        </li>
        <li>
            <strong>Aborted requests are not failures.</strong> A request the app cancelled itself - a superseded
            search, a navigation away - keeps <code>error.type = AbortError</code> but no error status, so it does not
            count against the dependency's success rate.
        </li>
        <li>
            <strong>Unknown methods.</strong> A method outside the HTTP conventions' list (a typo, a custom verb) is
            recorded as <code>http.request.method = _OTHER</code> with the original in
            <code>http.request.method_original</code>, and the span is named <code>HTTP</code> - so a stray method cannot
            multiply the span names a backend groups by.
        </li>
    </ul>
    <p>
        The echo endpoint below answers with the <code>traceparent</code> it received: its trace id is the trace id
        of the browser span in the feed. URLs in <code>IgnoreUrls</code> (the Blazor framework routes by default, plus
        the exporters' own endpoints) are never recorded, and neither is a request that already carries a
        <code>traceparent</code> - in WebAssembly that is .NET's <code>HttpClient</code> when it traces itself, which
        takes the <code>HttpActivityPropagationSupport</code> switch the WebAssembly SDK turns off by default (this demo
        turns it on; see <a href="/dotnet">.NET instrumentation</a>).
    </p>
    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live<span class="demo-sample-title">Dependencies</span></span></div>
        <div class="bb-toolbar">
            <button type="button" class="btn btn-primary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="@(() => CallAsync("fetch", "/api/demo/echo"))">fetch /api/demo/echo</button>
            <button type="button" class="btn btn-secondary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="@(() => CallAsync("xhr", "/api/demo/echo"))">XHR /api/demo/echo</button>
            <button type="button" class="btn demo-btn-danger" disabled="@(RendererInfo.IsInteractive is false)" @onclick="@(() => CallAsync("fetch", "/api/demo/fail"))">fetch /api/demo/fail (500)</button>
            <button type="button" class="btn btn-secondary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="AbortAsync">fetch, aborted after 300 ms (AbortError)</button>
        </div>
        @if (_call is not null)
        {
            <dl class="bb-params">
                <dt>Request</dt>
                <dd><code>@_call.Label</code></dd>
                <dt>Status</dt>
                <dd>@_call.Status in @_call.Ms ms</dd>
                <dt>traceparent the server saw</dt>
                <dd><code>@(_call.Traceparent ?? "(none)")</code></dd>
                @if (_call.TraceId is not null)
                {
                    <dt>Trace id</dt>
                    <dd><code>@_call.TraceId</code> - the same id as the browser span below</dd>
                }
            </dl>
        }
        <TelemetryFeedView Compact="true" Match="@IsDependency"
                           EmptyText="No dependency spans yet - press one of the buttons above." />
    </div>
    <CodeSnippet Code="@DependenciesCode" Language="C#" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Errors</h3>
    <p>
        Feature <code>Errors</code>. Uncaught errors (<code>window.onerror</code>) and unhandled promise rejections
        become log records with severity ERROR, the event name <code>exception</code>, and
        <code>exception.type</code>, <code>exception.message</code> and <code>exception.stacktrace</code> - scrubbed by
        the <a href="/privacy">privacy rules</a> first. Messages matching <code>IgnoreErrorMessages</code> are dropped;
        the default list has the harmless <code>ResizeObserver loop</code> warning every browser raises and the
        empty <code>Script error.</code> of a cross-origin script (no message, no stack, nothing to act on).
        Handled .NET exceptions go through <code>IBelemetry.TrackException</code>.
    </p>
    <p>
        An error thrown in a loop - a timer, a render loop, a retry - would fill the queue, evict every other record
        and cost the backend one record per occurrence from every client. So an error identical to one just recorded
        (same scope, type, message and first stack lines) is suppressed for <code>Errors.DuplicateWindow</code> (5 s),
        and at most <code>Errors.MaxPerMinute</code> (100) errors a minute leave the page, with a burst of as many;
        what is held back is counted as <code>error_limit</code> by <code>getStats()</code>. The .NET pipeline of a
        WebAssembly or Hybrid app applies the same two rules to its own error logs and <code>TrackException</code>
        calls; the server pipeline serves every user at once and is not capped. Zero switches a rule off. Very long
        messages and stack traces are cut at <code>MaxValueLength</code> - see <a href="/privacy">Privacy</a>.
    </p>
    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live<span class="demo-sample-title">Errors</span></span></div>
        <div class="bb-toolbar">
            <button type="button" class="btn demo-btn-danger" disabled="@(RendererInfo.IsInteractive is false)" @onclick="ThrowError">Throw a TypeError</button>
            <button type="button" class="btn demo-btn-danger" disabled="@(RendererInfo.IsInteractive is false)" @onclick="RejectPromise">Reject a promise</button>
            <button type="button" class="btn btn-secondary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="ThrowIgnored">Throw "ResizeObserver loop ..." (ignored)</button>
            <button type="button" class="btn demo-btn-danger" disabled="@(RendererInfo.IsInteractive is false)" @onclick="ThrowErrorLoop">Throw the same error 20 times (recorded once)</button>
            <button type="button" class="btn btn-primary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="TrackHandledException">IBelemetry.TrackException</button>
        </div>
        <TelemetryFeedView Compact="true" Match="@IsError"
                           EmptyText="No errors yet - press one of the buttons above." />
    </div>
    <CodeSnippet Code="@ErrorsCode" Language="C#" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Console capture</h3>
    <p>
        With <code>CaptureConsole</code> (off by default, on in this demo) the script wraps the console methods named
        in <code>ConsoleLevels</code> (<code>error</code> and <code>warn</code> by default) and records each call as a
        log record. <code>console.error</code> belongs to the <code>Errors</code> feature, the other levels to
        <code>Logs</code>. The original method always runs first, so the developer tools look the same as before.
    </p>
    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live<span class="demo-sample-title">Console capture</span></span></div>
        <div class="bb-toolbar">
            <button type="button" class="btn btn-primary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="@(() => ConsoleAsync("warn"))">console.warn</button>
            <button type="button" class="btn demo-btn-danger" disabled="@(RendererInfo.IsInteractive is false)" @onclick="@(() => ConsoleAsync("error"))">console.error</button>
            <button type="button" class="btn btn-secondary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="@(() => ConsoleAsync("info"))">console.info (not in ConsoleLevels)</button>
        </div>
        <TelemetryFeedView Compact="true" Match="@IsConsole"
                           EmptyText="No console records yet - press one of the buttons above." />
    </div>
    <CodeSnippet Code="@ConsoleCode" Language="C#" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Custom events</h3>
    <p>
        Feature <code>Events</code>. A custom event is a log record whose event name is the name you give it, with
        your attributes. From C# call <code>IBelemetry.TrackEvent</code>; from JavaScript call
        <code>BitBelemetry.trackEvent</code> on the global the module sets. Both carry <code>session.id</code> (and the
        user ids with <code>UserTracking</code>), so a backend can join them with everything else the session did.
    </p>
    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live<span class="demo-sample-title">Events</span></span></div>
        <div class="bb-toolbar">
            <button type="button" class="btn btn-primary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="TrackCSharpEvent">IBelemetry.TrackEvent (C#)</button>
            <button type="button" class="btn btn-secondary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="TrackJsEvent">BitBelemetry.trackEvent (JS)</button>
        </div>
        <TelemetryFeedView Compact="true" Match="@IsCustomEvent"
                           EmptyText="No custom events yet - press one of the buttons above." />
    </div>
    <CodeSnippet Code="@EventsCode" Language="Razor" />
    <CodeSnippet Code="@EventsJsCode" Language="JavaScript" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Diagnostics</h3>
    <p>
        <code>BitBelemetry.getStats()</code> says what the script dropped since the page loaded and why
        (<code>not_consented</code>, <code>error_limit</code>, <code>queue_full</code>, <code>sampled_out</code>, ...)
        and what became of its requests (<code>delivered</code>, <code>rejected</code>, <code>kept</code> for a later
        retry, <code>dropped</code>) - the first thing to look at when telemetry does not arrive. <code>queued</code> is
        what waits for the next export, and <code>pending</code> what is held until a consent decision. On the .NET
        side the same counts are metrics on the <code>Bit.Belemetry</code> meter, once it is added to
        <code>Metrics.Meters</code> (this demo does - see <a href="/dotnet">.NET instrumentation</a>).
    </p>
    <p>
        The script exports in batches: every <code>Browser.FlushInterval</code> (5 s; 2 s in this demo), as soon as
        <code>MaxBatchSize</code> (100) records are queued, and whenever the page is hidden. At most
        <code>MaxQueueSize</code> (1024) records wait; past it the oldest go first (<code>queue_full</code>).
        <code>Browser.Debug</code> writes the script's own diagnostics to <code>console.debug</code>. The
        <a href="/troubleshooting">Troubleshooting</a> page puts all of this together.
    </p>
    <div class="bb-demo">
        <div class="bb-demo-bar"><span class="bb-demo-label">Live<span class="demo-sample-title">getStats()</span></span></div>
        <div class="bb-toolbar">
            <button type="button" class="btn btn-primary" disabled="@(RendererInfo.IsInteractive is false)" @onclick="ReadStatsAsync">Read BitBelemetry.getStats()</button>
        </div>
        @if (_stats is not null)
        {
            <pre class="demo-json" aria-live="polite">@_stats</pre>
        }
    </div>
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> The JavaScript API</h3>
    <p>
        <code>_content/Bit.Belemetry/bit-belemetry.js</code> is an ES module, and it also sets
        <code>window.BitBelemetry</code>, so plain scripts, static SSR pages and pages without Blazor can use it. In a
        Blazor app the .NET API covers the same ground; these are for everything else. Every call is safe before
        <code>start</code> and never throws into the page.
    </p>
    <div class="bb-scroll">
        <table class="bb-table">
            <thead><tr><th scope="col">Export</th><th scope="col">What it does</th></tr></thead>
            <tbody>
                <tr><td><code>start(config)</code></td><td>Starts the script with a browser configuration (shape on the <a href="/semantic-conventions">Semantic conventions</a> page). Idempotent: a second call only updates the consent defaults and the transport. <code>&lt;BelemetryScript /&gt;</code> and <code>&lt;BelemetryInitializer /&gt;</code> call it for you</td></tr>
                <tr><td><code>setConsent(features)</code></td><td>Records the decision, a bit mask of <code>BitBelemetry.Features</code>: persists it, purges what was revoked, installs or removes instrumentations</td></tr>
                <tr><td><code>getConsent()</code> / <code>isConsentDecided()</code></td><td>The effective grant (narrowed to the configured features and by Global Privacy Control), and whether the user has decided</td></tr>
                <tr><td><code>setUser(id)</code></td><td>The authenticated <code>user.id</code>, or <code>null</code> to clear it; kept only with <code>UserTracking</code></td></tr>
                <tr><td><code>trackEvent(name, attributes?)</code></td><td>A custom event (feature <code>Events</code>)</td></tr>
                <tr><td><code>trackPageView(name?, url?, attributes?)</code></td><td>A manual page view, of type <code>manual</code></td></tr>
                <tr><td><code>trackException(type, message, stack?, attributes?)</code></td><td>A handled error (feature <code>Errors</code>)</td></tr>
                <tr><td><code>addProcessor(fn)</code></td><td>Runs <code>fn(record)</code> on every record as it is exported; change it in place, or return <code>false</code> to drop it. Returns the function that removes it - see <a href="/processors">Processors</a></td></tr>
                <tr><td><code>setAttributes(attributes)</code></td><td>Attributes added to every record from now on; a <code>null</code> value removes one key, <code>setAttributes(null)</code> all of them</td></tr>
                <tr><td><code>flush()</code></td><td>A promise that resolves when everything queued has been handed to the transport</td></tr>
                <tr><td><code>getContext()</code></td><td><code>{ consent, decided, sessionId, pseudoId, userId }</code></td></tr>
                <tr><td><code>getStats()</code></td><td>What was dropped and why, what became of the requests, and what is queued and pending - the Diagnostics card above</td></tr>
                <tr><td><code>Features</code></td><td>The feature bits and groups, the same numbers as <code>BelemetryFeatures</code></td></tr>
            </tbody>
        </table>
    </div>
    <CodeSnippet Code="@JsApiCode" Language="JavaScript" />
</div>

<div class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> API</h3>
    <p>Every option of the script lives on <code>options.Browser</code>:</p>
    <ApiTable TypeName="BelemetryBrowserOptions" />
    <p>The error limits, on <code>options.Errors</code> - applied by the script, and by the .NET pipeline of WebAssembly and Hybrid apps:</p>
    <ApiTable TypeName="BelemetryErrorOptions" />
    <p>Manual telemetry from C#:</p>
    <ApiTable TypeName="IBelemetry" />
</div>

@code {
    private string? _stats;
    private int _ignoredClicks;
    private int _events;
    private CallResult? _call;
    private string[]? _entryTypes;

    // The Performance Timeline entry type each vital is measured from. TTFB comes from the navigation timing every
    // browser has.
    private static readonly (string Vital, string EntryType)[] _vitalEntryTypes =
    [
        ("FCP", "paint"), ("LCP", "largest-contentful-paint"), ("CLS", "layout-shift"), ("INP", "event"),
    ];

    private string[]? MissingVitals => _entryTypes is null
        ? null
        : [.. _vitalEntryTypes.Where(v => _entryTypes.Contains(v.EntryType) is false).Select(v => v.Vital)];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender is false || RendererInfo.IsInteractive is false) return;

        try
        {
            var types = await JS.InvokeAsync<JsonElement>("blDemo.entryTypes");
            if (types.ValueKind != JsonValueKind.Array) return;
            _entryTypes = [.. types.EnumerateArray().Select(t => t.GetString()).OfType<string>()];
            StateHasChanged();
        }
        catch
        {
            // Without the answer the page simply makes no claim about this browser.
        }
    }

    private sealed record JsFetchResult(int Status, string? Body, int Ms);

    private sealed record CallResult(string Label, int Status, int Ms, string? Traceparent, string? TraceId);

    private static bool IsPageView(TelemetryRecord r) => r.Name.StartsWith("browser.page_view", StringComparison.Ordinal);

    private static bool IsInteraction(TelemetryRecord r) => r.Name.StartsWith("browser.user_interaction", StringComparison.Ordinal) || r.Name.StartsWith("browser.rage_click", StringComparison.Ordinal);

    private static bool IsWebVital(TelemetryRecord r) => r.Name.StartsWith("browser.web_vital", StringComparison.Ordinal);

    private static bool IsPerformanceSpan(TelemetryRecord r)
        => r.Source == "browser" && r.Signal == "span" && r.Name is "documentLoad" or "longtask" or "resourceFetch";

    // Correlated records are the server's request spans that joined a browser span's trace through traceparent.
    private static bool IsDependency(TelemetryRecord r)
        => (r.Source == "browser" && r.Scope == "bit.belemetry.http") || r.Correlated;

    private static bool IsError(TelemetryRecord r) => r.Kind == "Error" && r.Scope != "bit.belemetry.console";

    private static bool IsConsole(TelemetryRecord r) => r.Scope == "bit.belemetry.console";

    private static bool IsCustomEvent(TelemetryRecord r) => r.Kind == "Event" && r.Name.StartsWith("demo.", StringComparison.Ordinal);

    private void TrackVirtualPageView()
    {
        try
        {
            Belemetry.TrackPageView("Checkout - payment step", attributes: new Dictionary<string, object?> { ["checkout.step"] = 2 });
        }
        catch
        {
            // Telemetry must never take the page down.
        }
    }

    private async Task ShiftLayout()
    {
        try { await JS.InvokeVoidAsync("blDemo.shift", "bl-shift-target"); } catch { }
    }

    private async Task BlockMainThread()
    {
        try { await JS.InvokeVoidAsync("blDemo.longTask", 200); } catch { }
    }

    private async Task CallAsync(string api, string url)
    {
        try
        {
            var result = await JS.InvokeAsync<JsFetchResult>($"blDemo.{api}", url);
            var traceparent = ReadTraceparent(result.Body);

            // traceparent is "00-<trace id>-<parent span id>-<flags>".
            var parts = traceparent?.Split('-');
            var traceId = parts is { Length: 4 } ? parts[1] : null;

            _call = new($"{(api == "xhr" ? "XHR" : "fetch")} GET {url}", result.Status, result.Ms, traceparent, traceId);
        }
        catch
        {
            _call = null;
        }
    }

    private async Task AbortAsync()
    {
        // The echo answers after 2 s; the page gives up after 300 ms, as a superseded search would.
        const string url = "/api/demo/echo?delay=2000";

        try
        {
            var result = await JS.InvokeAsync<JsFetchResult>("blDemo.fetchAbort", url, 300);
            _call = new($"fetch GET {url}, aborted by the page ({result.Body})", result.Status, result.Ms, null, null);
        }
        catch
        {
            _call = null;
        }
    }

    private static string? ReadTraceparent(string? body)
    {
        if (string.IsNullOrEmpty(body)) return null;

        try
        {
            using var document = JsonDocument.Parse(body);
            return document.RootElement.ValueKind == JsonValueKind.Object
                && document.RootElement.TryGetProperty("traceparent", out var value)
                && value.ValueKind == JsonValueKind.String
                ? value.GetString()
                : null;
        }
        catch (JsonException)
        {
            // The 500 answers with a problem document, not the echo.
            return null;
        }
    }

    private async Task ThrowError()
    {
        try { await JS.InvokeVoidAsync("blDemo.throwError", "Cannot read properties of undefined (reading 'total')"); } catch { }
    }

    private async Task RejectPromise()
    {
        try { await JS.InvokeVoidAsync("blDemo.rejectPromise", "The payment provider did not answer"); } catch { }
    }

    private async Task ThrowIgnored()
    {
        try { await JS.InvokeVoidAsync("blDemo.throwError", "ResizeObserver loop completed with undelivered notifications."); } catch { }
    }

    private async Task ThrowErrorLoop()
    {
        try { await JS.InvokeVoidAsync("blDemo.throwErrorLoop", "Cannot read properties of null (reading 'tick')", 20); } catch { }
    }

    private async Task ReadStatsAsync()
    {
        try
        {
            var stats = await JS.InvokeAsync<System.Text.Json.JsonElement>("blDemo.stats");
            if (stats.ValueKind != System.Text.Json.JsonValueKind.Object)
            {
                _stats = "The script has not started.";
                return;
            }

            // Written by hand rather than with JsonSerializer, which needs reflection a trimmed client does not have.
            using var buffer = new MemoryStream();
            using (var writer = new System.Text.Json.Utf8JsonWriter(buffer, new System.Text.Json.JsonWriterOptions { Indented = true }))
            {
                stats.WriteTo(writer);
            }
            _stats = System.Text.Encoding.UTF8.GetString(buffer.ToArray());
        }
        catch
        {
            _stats = "The script is not available.";
        }
    }

    private void TrackHandledException()
    {
        try
        {
            throw new InvalidOperationException("The coupon has expired.");
        }
        catch (InvalidOperationException ex)
        {
            try { Belemetry.TrackException(ex, new Dictionary<string, object?> { ["coupon.code"] = "SPRING" }); } catch { }
        }
    }

    private async Task ConsoleAsync(string level)
    {
        try { await JS.InvokeVoidAsync("blDemo.console", level, $"A console.{level} from the browser instrumentation page"); } catch { }
    }

    private void TrackCSharpEvent()
    {
        try
        {
            _events++;
            Belemetry.TrackEvent("demo.cart.checkout", new Dictionary<string, object?> { ["cart.items"] = _events, ["cart.total"] = 19.9 * _events });
        }
        catch { }
    }

    private async Task TrackJsEvent()
    {
        try
        {
            await JS.InvokeVoidAsync("BitBelemetry.trackEvent", "demo.video.played", new Dictionary<string, object?> { ["video.id"] = "intro", ["video.position_s"] = 12 });
        }
        catch { }
    }

    private const string PageViewCode = """
        @inject IBelemetry Belemetry

        @* Navigation is tracked automatically. TrackPageView is for views the URL does not show. *@
        <button @onclick="OpenPayment">Continue to payment</button>

        @code {
            private void OpenPayment()
            {
                _step = 2;
                Belemetry.TrackPageView("Checkout - payment step",
                    attributes: new Dictionary<string, object?> { ["checkout.step"] = 2 });
            }

            private int _step = 1;
        }
        """;

    private const string InteractionCode = """
        @* A stable name survives redesigns and translations; the text would not. *@
        <button data-bit-belemetry-name="checkout.pay">Pay</button>

        @* Nothing in here is recorded, whatever it contains. *@
        <section data-bit-belemetry-ignore>
            <button>Show my card number</button>
        </section>
        """;

    private const string InteractionOptionsCode = """
        builder.Services.AddBitBelemetryServices(options =>
        {
            options.Browser.InteractionEvents.Add("submit");     // click is in the list already
            options.Browser.CaptureInteractionText = true;       // off by default: text may be personal data
            options.Browser.MaxInteractionTextLength = 32;
        });
        """;

    private const string WebVitalsCode = """
        builder.Services.AddBitBelemetryServices(options =>
        {
            options.Browser.WebVitals = true;      // the default: LCP, INP, CLS, FCP, TTFB
        });

        // In a component: web vitals, the document load, resources and long tasks are all
        // the Performance feature, granted on top of whatever the user granted before.
        await Consent.GrantAsync(BelemetryFeatures.Performance);    // @inject IBelemetryConsent Consent
        """;

    private const string PerformanceCode = """
        builder.Services.AddBitBelemetryServices(options =>
        {
            options.Browser.DocumentLoad = true;      // default: the documentLoad span
            options.Browser.ResourceTiming = true;    // off by default: one span per fetched resource
            options.Browser.LongTasks = true;         // off by default: main-thread tasks over 50 ms
        });
        """;

    private const string DependenciesCode = """
        builder.Services.AddBitBelemetryServices(options =>
        {
            options.Browser.Fetch = true;   // the defaults
            options.Browser.Xhr = true;

            // Same-origin by default. A cross-origin API must allow the header:
            // Access-Control-Allow-Headers: traceparent
            options.Browser.PropagateTraceContextTo.Add(@"^https://api\.example\.com/");

            // Regular expressions of URLs never recorded (the Blazor framework routes are in the list already).
            options.Browser.IgnoreUrls.Add("/health");
        });
        """;

    private const string ErrorsCode = """
        builder.Services.AddBitBelemetryServices(options =>
        {
            // Regular expressions of messages never recorded ("ResizeObserver loop" and
            // "^Script error\.?$" are in the list already).
            options.Browser.IgnoreErrorMessages.Add("^Extension context invalidated");

            // Error floods: one record per identical error per window, and a rate limit.
            options.Errors.DuplicateWindow = TimeSpan.FromSeconds(10);   // default 5 s; TimeSpan.Zero records every one
            options.Errors.MaxPerMinute = 50;                            // default 100; 0 is unlimited
        });

        // A handled .NET exception:
        try
