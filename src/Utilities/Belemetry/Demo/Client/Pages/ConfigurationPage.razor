@code {
    private const string BindCode = """
        // Program.cs - the binder's source generator (EnableConfigurationBindingGenerator) makes this trim- and AOT-safe.
        builder.Services.AddBitBelemetryServices(options =>
        {
            builder.Configuration.GetSection("Belemetry").Bind(options);
            options.AddExporter(new MyExporter());   // what only code can add: custom exporters, processors, token providers
        });
        """;

    private const string AppsettingsCode = """
        {
          "Belemetry": {
            "ServiceName": "MyApp",
            "Environment": "Production",
            "Consent": { "Default": "Errors" },
            "Browser": { "TrackPageVisitTime": true },
            "Traces": { "Sources": [ "MyApp.*" ], "IgnoredActivityNames": [ "Microsoft.AspNetCore.Components.HandleEvent" ] },
            "Server": { "CollectDotnetTelemetry": true, "IgnoredRequestPaths": [ "/health", "/alive" ] },
            "OtlpExporters": [ { "Endpoint": "https://otel.example.com", "Protocol": "HttpProtobuf", "Headers": { "x-api-key": "..." } } ],
            "AzureMonitorExporters": [ { "ConnectionString": "InstrumentationKey=...", "MinimumLogLevel": "Warning" } ]
          }
        }
        """;

    private const string FullCode = """
        using Bit.Belemetry;
        using Microsoft.Extensions.Logging;

        builder.Services.AddBitBelemetryServices(options =>
        {
            // The resource: who is sending. service.name is what every backend groups by.
            options.ServiceName = "MyShop";
            options.ServiceNamespace = "contoso";
            options.Environment = builder.Environment.EnvironmentName;
            options.ResourceAttributes["deployment.region"] = "westeurope";

            // What may be collected at all. A feature is sent only when it is here AND the user granted it.
            options.Features = BelemetryFeatures.All & ~BelemetryFeatures.Interactions;

            // Consent: opt-in, so nothing is sent before the user decides - except error reports,
            // which this app covers by legitimate interest.
            options.Consent.Default = BelemetryFeatures.Errors;
            options.Consent.Persist = true;
            options.Consent.HonorGlobalPrivacyControl = true;

            // Privacy rules, applied on both sides before anything is queued.
            options.Privacy.RedactQueryParameters.Add("voucher");
            options.Privacy.RedactedAttributes.Add("iban");
            options.Privacy.BlockedAttributes.Add("user_agent.original");
            options.MaxValueLength = 16384;                                    // cut longer strings (default 32768)

            // Error floods: one record per identical error per window, at most so many a minute.
            options.Errors.DuplicateWindow = TimeSpan.FromSeconds(10);
            options.Errors.MaxPerMinute = 60;

            // The browser script.
            options.Browser.Transport = BelemetryBrowserTransport.Auto;      // Relay in Hybrid, Direct elsewhere
            options.Browser.ResourceTiming = true;
            options.Browser.PropagateTraceContextTo.Add(@"^https://api\.contoso\.com/");
            options.Browser.IgnoreUrls.Add("/health");
            options.Browser.SessionSampleRatio = 0.5;
            options.Browser.TrackPageVisitTime = true;

            // The .NET collectors.
            options.Logs.MinimumLevel = LogLevel.Information;
            options.Traces.Sources.Add("MyShop*");
            options.Traces.SamplingRatio = 0.25;
            options.Metrics.Meters.Add("MyShop*");
            options.Metrics.Meters.Add("Bit.Belemetry");                      // Belemetry's own health
            options.Metrics.ExportInterval = TimeSpan.FromSeconds(30);

            // Delivery.
            options.Batch.FlushInterval = TimeSpan.FromSeconds(5);
            options.Persistence.MaxAge = TimeSpan.FromHours(24);

            // The server's own telemetry (ASP.NET Core hosts only), governed by Server.Features.
            options.Server.CollectDotnetTelemetry = true;

            // Exporters: any number, combined.
            options.AddOtlpExporter("http://otel-collector:4318", otlp =>
            {
                otlp.Protocol = BelemetryOtlpProtocol.HttpProtobuf;
                otlp.BrowserEndpoint = new Uri("https://otel.contoso.com");  // public, CORS-enabled
                otlp.BrowserHeaders["x-ingest-key"] = "public-key";         // the page's key; Headers stay on the server
                otlp.Compression = BelemetryCompression.Gzip;
            });

            options.AddAzureMonitorExporter(builder.Configuration["ApplicationInsights:ConnectionString"]!, azure =>
            {
                azure.Signals = BelemetrySignals.Traces | BelemetrySignals.Logs;
            });

            if (builder.Environment.IsDevelopment())
            {
                options.AddConsoleExporter();
                options.Debug = true;
                options.Browser.Debug = true;
            }
        });
        """;

    private const string LoggingCode = """
        {
          "Logging": {
            "Belemetry": {
              "LogLevel": {
                "Default": "Information",
                "Microsoft.AspNetCore": "Warning",
                "MyShop.Polling": "Warning"
              }
            }
          }
        }
        """;
}
