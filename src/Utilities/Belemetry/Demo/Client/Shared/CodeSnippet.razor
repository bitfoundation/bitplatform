@* A code sample: SyntaxHighlighter's tokens inside the site kit's pre.bb-code, which is what gives it the
   site's code surface - and the copy button site.js adds to every pre.bb-code, so the snippet can be taken
   whether or not it was opened. The token colours are in demo.css.

   A setup snippet is the content of its page and is shown as it is (Expanded). Every other one is a
   complete, copy/paste-runnable version of the sample above it, so it waits behind the kit's quiet
   "show the source" disclosure rather than doubling the length of the page. *@

@if (Expanded)
{
    <pre class="bb-code"><code>@_html</code></pre>
}
else
{
    <div class="bb-source demo-snippet">
        <button type="button" class="btn btn-secondary" @onclick="() => _show = !_show"
                aria-expanded="@(_show ? "true" : "false")" aria-controls="@_bodyId">
            <span class="demo-snippet-caret" aria-hidden="true">@(_show ? "▾" : "▸")</span>
            @(_show ? "Hide code" : "Show code")
            <span class="demo-snippet-lang">@Language</span>
        </button>

        @if (_show)
        {
            <pre class="bb-code" id="@_bodyId"><code>@_html</code></pre>
        }
    </div>
}

@code {
    /// <summary>The full, copy/paste-runnable source snippet to display for the sample.</summary>
    [Parameter, EditorRequired] public string Code { get; set; } = "";

    /// <summary>The language, which also picks the highlighter: "Razor" and "C#" are tokenised, anything else
    /// (JSON, YAML, Shell, HTML) is shown as plain text. Collapsed snippets print it on their toggle.</summary>
    [Parameter] public string Language { get; set; } = "Razor";

    /// <summary>Whether the code is shown as it is rather than behind a toggle. Setup snippets are the content of
    /// their page, not an extra.</summary>
    [Parameter] public bool Expanded { get; set; }

    // The toggle points at the block it opens, so a screen reader following aria-controls lands on
    // the code rather than on the next thing in the document. Generated per instance because a
    // page carries a dozen of these.
    private readonly string _bodyId = $"code-{Guid.NewGuid():N}";

    private bool _show;
    private string? _rendered;
    private MarkupString _html;

    protected override void OnParametersSet()
    {
        // Highlighting is a full lexer pass; a snippet whose source did not change keeps the markup it has.
        var key = Language + "\u0000" + Code;
        if (key == _rendered) return;

        _rendered = key;
        _html = (MarkupString)SyntaxHighlighter.Highlight(Code.ReplaceLineEndings("\n").Trim('\n'), Language);
    }
}
