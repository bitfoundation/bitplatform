<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!-- The WebAssembly half of the harness web host: what runs in the browser in the wasm and auto modes. It only
         registers Belemetry the way the server does (the .NET pipeline runs here, in the page) - the pages are in
         Bit.Belemetry.Tests.Harness. -->

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Belemetry.Tests.Harness\Bit.Belemetry.Tests.Harness.csproj" />
    </ItemGroup>

    <!-- What a PackageReference to Bit.Belemetry imports on its own, and a ProjectReference does not: the build
         defaults that turn System.Diagnostics.Metrics back on in WebAssembly. The suites test the shipped file. -->
    <Import Project="..\..\Bit.Belemetry\buildTransitive\Bit.Belemetry.props" />

</Project>
