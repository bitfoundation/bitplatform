<Project Sdk="Microsoft.NET.Sdk">

    <!-- In-process HTTP tests: the real harness host (and the real hosting samples) booted with WebApplicationFactory,
         asserting what only a server can show - the browser configuration each render mode prerenders, the script
         being served, and what the server pipeline exports (or, by default, does not). No browser, so this runs on
         every target framework in the regular CI job. -->

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.5.2" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.3.26522.148" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Belemetry.Tests.Harness.Web\Bit.Belemetry.Tests.Harness.Web.csproj" />
    </ItemGroup>

    <!-- The hosting samples only target net11.0. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <ProjectReference Include="..\..\Samples\Server\Bit.Belemetry.Samples.Server.csproj" />
        <ProjectReference Include="..\..\Samples\Wasm\Bit.Belemetry.Samples.Wasm\Bit.Belemetry.Samples.Wasm.csproj" />
        <ProjectReference Include="..\..\Samples\Auto\Bit.Belemetry.Samples.Auto\Bit.Belemetry.Samples.Auto.csproj" />
    </ItemGroup>

</Project>
