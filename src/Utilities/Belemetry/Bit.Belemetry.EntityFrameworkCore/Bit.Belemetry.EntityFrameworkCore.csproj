<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../Bit.Build.props" />

    <!-- Entity Framework Core spans for Bit.Belemetry: a DbCommandInterceptor that starts an Activity around every
         command, on the Bit.Belemetry.EntityFrameworkCore source the core collects by default. A separate package
         because EF Core is a dependency most Blazor apps (every WebAssembly one) do not want in their telemetry SDK. -->

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The same floating low-bound ranges as Bit.Belemetry: any patch of the EF Core major that matches the TFM.
             The 8.0 floor is the first release whose Microsoft.Extensions.Caching.Memory dependency is not the
             vulnerable 8.0.0 (GHSA-qj66-m88j-hmgj), so this project's own restore passes the NuGet audit. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.EntityFrameworkCore.Relational" Version="[8.0.11,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.EntityFrameworkCore.Relational" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.0,11.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Belemetry\Bit.Belemetry.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.Belemetry.Tests.EntityFrameworkCore" PublicKey="" />
    </ItemGroup>

</Project>
