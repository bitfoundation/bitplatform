@page "/scroll"
@inject BmotionScrollTracker Scroll
@inject BmotionScrollTracker TargetScroll
@inject BmotionScrollTracker RailScroll
@inject BmotionAnimateService Motion
@implements IAsyncDisposable

<PageTitle>Scroll animations · Bmotion</PageTitle>

<div class="bb-intro">
    <h1>Scroll animations</h1>
    <p class="bb-subtitle">
        There are two ways to tie motion to a scrollbar, and they answer different questions.
        <strong>Scroll-linked</strong> motion asks <em>"how far along are we?"</em> and maps that
        progress continuously onto a property - the reader scrubs the animation.
        <strong>Scroll-triggered</strong> motion asks <em>"is this on screen yet?"</em> and plays a
        normal animation once the answer changes. For the first there is a fast path -
        <code>Timeline</code>, which hands the scrubbing to the browser outright - and a general one,
        <code>BmotionScrollTracker</code>, for when you need the number itself.
        <code>WhileInView</code> covers the second.
    </p>
</div>

@* Offset by the site header's own height so the readout parks under it rather than behind it. *@
<div class="scroll-progress">
    <div class="demo-label progress-caption">Window scroll progress</div>
    <div class="scroll-track">
        <div class="scroll-fill" style="@($"width:{Percent(_progressY)}%")"></div>
    </div>
    <div class="demo-label progress-caption">
        Y: @Percent(_progressY)% &nbsp;|&nbsp; X: @Percent(_progressX)%
    </div>
    <div class="demo-label progress-caption">The "whileInView" strip's journey &middot; ViewOf(".inview-strip")</div>
    <div class="scroll-track">
        <Bmotion Timeline='BmScrollTimeline.ViewOf(".inview-strip")' Animate="Bm.To(scaleX: [0, 1])">
            <div class="scroll-fill full-width" />
        </Bmotion>
    </div>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Scroll timelines: let the browser do it</h3>
    <p>
        A scroll handler that calls back into .NET on every scroll event is the expensive way to
        scrub an animation, and it is the one thing you cannot make fast from the outside.
        <strong>Timeline</strong> hands the whole thing to the browser instead: the keyframes are
        pre-sampled in C# once, and progress comes from the browser's own
        <code>ScrollTimeline</code> / <code>ViewTimeline</code>. After the handoff there is no
        scroll handler, no frame loop and no interop at all - the animation runs on the compositor.
        Where those APIs are missing, the bridge scrubs the same Web Animation from one passive
        listener, so the values are still interpolated by the browser rather than round-tripped
        through .NET.
    </p>
    <p>
        <code>BmScrollTimeline.Page()</code> is the whole document's progress;
        <code>Container(selector)</code> is one scroller's; <code>View()</code> is the animated
        element's own journey through the viewport, and <code>ViewOf(selector)</code> is some other
        element's. Only transforms and <code>opacity</code> can be handed over this way - they are
        what the browser can interpolate for us - and while a timeline is attached it owns those
        properties, so <code>Transition</code> does not apply: scroll position <em>is</em> the
        progress.
    </p>

    <div class="timeline-bar-wrap">
        <span class="demo-label">BmScrollTimeline.Page() &middot; scroll the page</span>
        <div class="scroll-track">
            <Bmotion Timeline="BmScrollTimeline.Page()" Animate="Bm.To(scaleX: [0, 1])">
                <div class="scroll-fill full-width" />
            </Bmotion>
        </div>
        <span class="demo-label">BmScrollTimeline.Page().Smoothed() &middot; the same, through a spring</span>
        <div class="scroll-track">
            <Bmotion Timeline="BmScrollTimeline.Page().Smoothed()" Animate="Bm.To(scaleX: [0, 1])">
                <div class="scroll-fill full-width" />
            </Bmotion>
        </div>
    </div>

    <p>
        <code>.Smoothed()</code> makes the animation follow the scroll through a spring instead of exactly -
        motion.dev's <code>useSpring(scrollYProgress)</code> - so a flick of the wheel glides rather than jumps.
        Pass your own <code>Bm.Spring(...)</code> for a different feel. A native timeline can't be smoothed, so a
        smoothed one is scrubbed by the bridge with the spring stepped in the browser: still no interop per frame,
        on WebAssembly and Blazor Server alike.
    </p>

    <p>
        <code>View()</code> runs across the element's whole journey, from the moment it starts to enter to the
        moment it has left. A <code>range</code>, in CSS <code>animation-range</code> terms, narrows that: the
        right-hand box below uses <code>"entry 0% cover 50%"</code>, so it has fully arrived by the time it is
        halfway up the screen, while the left one fades in, holds and fades out again over the full journey.
        (Ranges need the native API; the fallback always covers the full journey.)
    </p>

    <div class="demo-row">
        <div class="demo-card stack">
            <span class="demo-label">View() &middot; the whole journey</span>
            <Bmotion Timeline="BmScrollTimeline.View()"
                     Animate="Bm.To(opacity: [0, 1, 1, 0], scale: [0.6, 1, 1, 0.6], rotate: [-12, 0, 0, 12])">
                <div class="box" />
            </Bmotion>
        </div>
        <div class="demo-card stack">
            <span class="demo-label">View(range: "entry 0% cover 50%") &middot; arrives by mid-screen</span>
            <Bmotion Timeline='BmScrollTimeline.View(range: "entry 0% cover 50%")'
                     Animate="Bm.To(opacity: [0, 1], scale: [0.6, 1], rotate: [-12, 0])">
                <div class="box" />
            </Bmotion>
        </div>
    </div>

    <p>
        <code>Container(selector)</code> reads one scroll container instead of the page, on either axis -
        <code>BmScrollAxis.X</code> for a rail that scrolls sideways. And <code>ViewOf(selector)</code> lets some
        <em>other</em> element's journey drive this one: the second bar in the readout pinned at the top of the
        page follows the "whileInView" strip at the bottom of it, filling as that strip crosses the screen.
    </p>

    <div class="demo-row">
        <div class="demo-card stack">
            <span class="demo-label">Container(".h-rail", BmScrollAxis.X) &middot; scroll the rail sideways</span>
            <div class="scroll-track">
                <Bmotion Timeline='BmScrollTimeline.Container(".h-rail", BmScrollAxis.X)' Animate="Bm.To(scaleX: [0, 1])">
                    <div class="scroll-fill full-width" />
                </Bmotion>
            </div>
            <div class="h-rail" id="h-rail" tabindex="0" role="region" aria-label="A rail that scrolls sideways">
                @for (int i = 1; i <= 8; i++)
                {
                    <div class="h-rail-card">@i</div>
                }
            </div>
            <span class="demo-label">BmotionScrollTracker on the same rail: @Pixels(_railX) px across, @Percent(_railProgress)%</span>
        </div>
    </div>

    <CodeSnippet Code="@_timelineCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Tracking the scroll position</h3>
    <p>
        Inject <strong>BmotionScrollTracker</strong> and call <code>ObserveAsync</code> to receive a
        <code>BmScrollInfo</code> on every scroll: absolute offsets and normalised
        <code>0..1</code> progress on both axes. The tracker is <em>transient</em> and owned by the
        component that injected it, which is why the page below implements
        <code>IAsyncDisposable</code> - the browser-side listener goes away with the component
        rather than outliving it.
    </p>

    <CodeSnippet Code="@_scrollTrackCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Scroll-linked motion values</h3>
    <p>
        A callback that calls <code>StateHasChanged</code> on every scroll event is a diff per
        frame. Motion values skip that entirely: bind them with the <code>Values</code> parameter
        and their changes are flushed straight to the DOM each frame
        <em>without re-rendering the component</em>. <code>Transform</code> derives new values from
        them - here the same progress drives a <code>scaleX</code> bar directly and, mapped through
        <code>0..1 → 0..360</code>, a full rotation over the length of the page.
    </p>

    <div class="demo-row">
        <div class="demo-card stack">
            <div class="scroll-track">
                <Bmotion Values="_barValues">
                    <div class="scroll-fill full-width" />
                </Bmotion>
            </div>
            <Bmotion Values="_boxValues">
                <div class="box box-sm" />
            </Bmotion>
        </div>
    </div>

    <CodeSnippet Code="@_valuesCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Speed, not position</h3>
    <p>
        Some effects follow how fast the page is moving rather than where it is: a list that leans into a fast
        scroll, a blur that only shows at speed. <strong>Bm.Velocity</strong> derives a motion value that carries
        another one's velocity, in units per second - here the window tracker's <code>ScrollYValue</code>, in
        pixels - and <code>Transform</code> maps that speed onto a skew, clamped at &plusmn;12&deg;. The velocity
        comes back to 0 a moment after the scroll stops (once the source has gone a few of its own update
        intervals without changing), and <code>Motion.Spring</code> follows it, so the lean eases back upright
        instead of snapping there - motion.dev's <code>useSpring(useVelocity(scrollY))</code>. The tracker also
        exposes <code>ScrollXValue</code> and the two progress values the same way. Scroll quickly, up and down.
    </p>

    <div class="demo-row">
        <div class="demo-card stack">
            <Bmotion Values="_skewValues">
                <div class="velocity-stack">
                    <div class="inview-band from-left">Fast</div>
                    <div class="inview-band from-right">scrolling</div>
                    <div class="inview-band from-left">leans</div>
                </div>
            </Bmotion>
            <span class="demo-label">skewY = Motion.Spring(Bm.Velocity(Scroll.ScrollYValue)).Transform([-3000, 0, 3000], [-12, 0, 12])</span>
        </div>
    </div>

    <CodeSnippet Code="@_velocityCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Motion templates</h3>
    <p>
        Some properties are not a number - they are a sentence made of numbers.
        <strong>Bm.Template</strong> composes motion values into a CSS string and
        <code>StringValues</code> binds the result to any property, so a
        <code>filter</code> built from two independently derived values updates as one. The blur
        below peaks at the middle of the page (<code>[0, 0.5, 1] → [0, 4, 0]</code>) while the hue
        rotates straight through.
    </p>

    <div class="demo-row">
        <div class="demo-card">
            <Bmotion StringValues="_filterValue">
                <div class="box" />
            </Bmotion>
        </div>
    </div>

    <CodeSnippet Code="@_templateCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> An element's own progress</h3>
    <p>
        Window progress is the wrong measure for anything that is not the whole page. Pass
        <strong>BmScrollOptions</strong> a <code>TargetId</code> and a pair of
        <code>Offset</code> alignments instead, and progress is measured over <em>that element's</em>
        journey through the viewport. Each offset reads
        <code>"&lt;target edge&gt; &lt;container edge&gt;"</code>, so the default
        <code>["start end", "end start"]</code> means <em>0 when its top reaches the bottom of the
        viewport, 1 when its bottom passes the top</em>. Scroll the striped panel past and watch
        the bar under it fill.
    </p>

    <div class="demo-row">
        <div class="demo-card stack" id="scroll-target">
            <span class="demo-label">This card is the tracked target</span>
            <div class="target-panel"></div>
            <div class="scroll-track">
                <Bmotion Values="_targetValues">
                    <div class="scroll-fill full-width" />
                </Bmotion>
            </div>
            <span class="demo-label">Target progress: @Percent(_targetProgress)%</span>
        </div>
    </div>

    <CodeSnippet Code="@_targetCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> whileInView</h3>
    <p>
        <strong>WhileInView</strong> is the trigger half: an ordinary gesture state, activated by an
        <code>IntersectionObserver</code> rather than a pointer. <code>Once="true"</code> keeps it
        from replaying every time the element crosses the fold - the right default for entrance
        animations, since a section that re-animates on the way back up reads as a glitch. For
        finer control, <code>Viewport</code> takes a <code>Margin</code>, an <code>Amount</code>
        (<code>"some"</code>, <code>"all"</code>, or a <code>0..1</code> threshold) and a <code>Root</code> to
        measure against a scrolling container instead of the window - the <a href="gestures">Gestures</a> page
        shows those live, with <code>OnViewportEnter</code> and <code>OnViewportLeave</code>.
    </p>

    @* Each band waits 60 pixels off its place, so on a narrow screen the ones that come in from
       the right start outside the viewport - and a page that scrolls sideways because something
       has not arrived yet is a bug, not an entrance. overflow-x: clip rather than hidden: hidden
       would make this a scroll container and break position: sticky for anything inside it. *@
    <div class="inview-strip">
        @for (int i = 0; i < 12; i++)
        {
            var idx = i;
            <Bmotion Initial="@(Bm.To(opacity: 0, x: idx % 2 == 0 ? -60 : 60))"
                    WhileInView="Bm.To(opacity: 1, x: 0)"
                    Transition="Bm.Tween(0.5, BmEase.BackOut)"
                    Once="true">
                <div class="inview-band @(idx % 2 == 0 ? "from-left" : "from-right")">
                    Section @(idx + 1)
                </div>
            </Bmotion>
        }
    </div>

    <CodeSnippet Code="@_inViewCode" />
</section>

@code {
    private double _progressX;
    private double _progressY;
    private double _targetProgress;
    private double _railX;
    private double _railProgress;

    // Created once (not inline in the markup) so re-renders don't re-subscribe the bindings.
    private Dictionary<string, BmValue<double>> _barValues = default!;
    private Dictionary<string, BmValue<double>> _boxValues = default!;
    private Dictionary<string, BmValue<double>> _skewValues = default!;
    private BmValue<double>? _scrollSpeed;
    private BmValue<double>? _leanSpring;
    private Dictionary<string, BmValue<double>> _targetValues = default!;
    private Dictionary<string, BmValue<string>> _filterValue = default!;

    private static string Percent(double progress)
        => (progress * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private static string Pixels(double value)
        => value.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        _barValues = new() { ["scaleX"] = Scroll.ProgressYValue };
        _boxValues = new() { ["rotate"] = Scroll.ProgressYValue.Transform([0, 1], [0, 360]) };

        // How fast the page scrolls, in px/s, mapped onto a lean - clamped, so a fling tops out at 12deg - and
        // followed through a spring, so the lean eases back once the scroll stops and the velocity returns to 0.
        _scrollSpeed = Bm.Velocity(Scroll.ScrollYValue);
        _leanSpring = Motion.Spring(_scrollSpeed, Bm.Spring(stiffness: 400, damping: 50));
        _skewValues = new() { ["skewY"] = _leanSpring.Transform([-3000, 0, 3000], [-12, 0, 12]) };

        // A second tracker, because this one measures one element's journey rather than the
        // window's - the two subscriptions are independent and each owns its own listener.
        _targetValues = new() { ["scaleX"] = TargetScroll.TargetProgressValue };

        // Compose two derived values into one CSS string (useMotionTemplate).
        var hue = Scroll.ProgressYValue.Transform([0, 1], [0, 270]);
        var blur = Scroll.ProgressYValue.Transform([0, 0.5, 1], [0, 4, 0]);
        _filterValue = new()
        {
            ["filter"] = Bm.Template(
                () => $"hue-rotate({hue.Value:F0}deg) blur({blur.Value:F1}px)", hue, blur),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender is false) return;

        await Scroll.ObserveAsync(info =>
        {
            _progressX = info.ProgressX;
            _progressY = info.ProgressY;
            return InvokeAsync(StateHasChanged);
        });

        await TargetScroll.ObserveAsync(
            new BmScrollOptions
            {
                TargetId = "scroll-target",
                Offset = ["start end", "end start"],
            },
            info =>
            {
                _targetProgress = info.TargetProgress ?? 0;
                return InvokeAsync(StateHasChanged);
            });

        // A third, for one container rather than the window: the rail, by its element id.
        await RailScroll.ObserveAsync("h-rail", info =>
        {
            _railX = info.ScrollX;
            _railProgress = info.ProgressX;
            return InvokeAsync(StateHasChanged);
        });
    }

    public async ValueTask DisposeAsync()
    {
        _leanSpring?.Dispose();
        _scrollSpeed?.Dispose();
        await Scroll.DisposeAsync();
        await TargetScroll.DisposeAsync();
        await RailScroll.DisposeAsync();
    }

    private const string _valuesCode = """
        @using Bit.Bmotion
        @inject BmotionScrollTracker Scroll
        @implements IAsyncDisposable

        @* Values bindings flush to the DOM every frame WITHOUT re-rendering the component -
           no diff, no StateHasChanged, no per-frame render tree. *@
        <div class="scroll-track">
            <Bmotion Values="_barValues">
                <div style="height:100%;width:100%;transform-origin:0 50%" />
            </Bmotion>
        </div>

        <Bmotion Values="_boxValues">
            <div class="box" />
        </Bmotion>

        @code {
            private Dictionary<string, BmValue<double>> _barValues = default!;
            private Dictionary<string, BmValue<double>> _boxValues = default!;

            // Built once, not inline in the markup: a fresh dictionary each render would
            // re-subscribe the bindings every time.
            protected override void OnInitialized()
            {
                _barValues = new() { ["scaleX"] = Scroll.ProgressYValue };
                _boxValues = new() { ["rotate"] = Scroll.ProgressYValue.Transform([0, 1], [0, 360]) };
            }

            protected override async Task OnAfterRenderAsync(bool firstRender)
            {
                if (firstRender) await Scroll.ObserveAsync(_ => Task.CompletedTask);
            }

            // The tracker is transient and this component's: its browser listener goes with it.
            public ValueTask DisposeAsync() => Scroll.DisposeAsync();
        }
        """;

    private const string _velocityCode = """
        @using Bit.Bmotion
        @inject BmotionScrollTracker Scroll
        @inject BmotionAnimateService Motion
        @implements IAsyncDisposable

        <Bmotion Values="_skewValues">
            <div class="stack-of-bands">…</div>
        </Bmotion>

        @code {
            private Dictionary<string, BmValue<double>> _skewValues = default!;
            private BmValue<double>? _speed;
            private BmValue<double>? _lean;

            protected override void OnInitialized()
            {
                // Bm.Velocity derives the speed of another motion value, in its units per second -
                // here pixels of window scroll - and comes back to 0 shortly after the scroll stops.
                // The spring follower eases that return; Transform clamps it onto ±12 degrees of skew.
                _speed = Bm.Velocity(Scroll.ScrollYValue);
                _lean = Motion.Spring(_speed, Bm.Spring(stiffness: 400, damping: 50));
                _skewValues = new() { ["skewY"] = _lean.Transform([-3000, 0, 3000], [-12, 0, 12]) };
            }

            // The motion values only move while the tracker is observing.
            protected override async Task OnAfterRenderAsync(bool firstRender)
            {
                if (firstRender) await Scroll.ObserveAsync(_ => Task.CompletedTask);
            }

            public async ValueTask DisposeAsync()
            {
                // Each derived value listens to the one it comes from until disposed: the follower
                // to the speed (a spring still moving finishes on its own), the speed to the scroll.
                _lean?.Dispose();
                _speed?.Dispose();
                await Scroll.DisposeAsync();
            }
        }
        """;

    private const string _templateCode = """
        @using Bit.Bmotion
        @inject BmotionScrollTracker Scroll
        @implements IAsyncDisposable

        <Bmotion StringValues="_filterValue">
            <div class="box" />
        </Bmotion>

        @code {
            private Dictionary<string, BmValue<string>> _filterValue = default!;

            protected override void OnInitialized()
            {
                // Two independently derived values composed into one CSS string.
                // Transform's three-stop range peaks the blur in the middle of the page.
                var hue  = Scroll.ProgressYValue.Transform([0, 1], [0, 270]);
                var blur = Scroll.ProgressYValue.Transform([0, 0.5, 1], [0, 4, 0]);
                _filterValue = new()
                {
                    ["filter"] = Bm.Template(
                        () => $"hue-rotate({hue.Value:F0}deg) blur({blur.Value:F1}px)", hue, blur),
                };
            }

            protected override async Task OnAfterRenderAsync(bool firstRender)
            {
                if (firstRender) await Scroll.ObserveAsync(_ => Task.CompletedTask);
            }

            public ValueTask DisposeAsync() => Scroll.DisposeAsync();
        }
        """;

    private const string _targetCode = """
        @using Bit.Bmotion
        @inject BmotionScrollTracker TargetScroll
        @implements IAsyncDisposable

        <div id="scroll-target">…</div>

        <Bmotion Values="_targetValues">
            <div class="bar" style="transform-origin:0 50%" />
        </Bmotion>
        <span>Target progress: @((_progress * 100).ToString("F1"))%</span>

        @code {
            private Dictionary<string, BmValue<double>> _targetValues = default!;
            private double _progress;

            protected override void OnInitialized()
                => _targetValues = new() { ["scaleX"] = TargetScroll.TargetProgressValue };

            protected override async Task OnAfterRenderAsync(bool firstRender)
            {
                if (firstRender is false) return;

                await TargetScroll.ObserveAsync(new BmScrollOptions
                {
                    TargetId = "scroll-target",
                    // "<target edge> <container edge>": 0 when the target's top reaches the
                    // bottom of the viewport, 1 when its bottom passes the top.
                    // Edges are start / center / end, or any 0-1 number.
                    Offset = ["start end", "end start"],
                }, info => { _progress = info.TargetProgress ?? 0; return InvokeAsync(StateHasChanged); });
            }

            public ValueTask DisposeAsync() => TargetScroll.DisposeAsync();
        }
        """;

    private const string _timelineCode = """
        @using Bit.Bmotion

        <style>
            :root { --bm-track: #EBEBEB; --bm-primary: #1276C6; --bm-secondary: #FD7F36; }
            .scroll-track { background: var(--bm-track); border-radius: 6px; height: 8px; overflow: hidden; width: 100%; }
            /* Scaled, not resized: the bar starts full width and the browser drives scaleX
               from its left edge. */
            .scroll-fill { width: 100%; height: 100%; border-radius: 6px; transform-origin: 0 50%;
                background: linear-gradient(90deg, var(--bm-primary), var(--bm-secondary)); }
            .box { width: 80px; height: 80px; border-radius: 10px;
                background: linear-gradient(135deg, var(--bm-primary), var(--bm-secondary)); }
        </style>

        @* A reading-progress bar. No scroll handler, no OnInitialized, no IAsyncDisposable:
           the browser's own ScrollTimeline drives it on the compositor. *@
        <div class="scroll-track">
            <Bmotion Timeline="BmScrollTimeline.Page()" Animate="Bm.To(scaleX: [0, 1])">
                <div class="scroll-fill" />
            </Bmotion>
        </div>

        @* The same bar following the scroll through a spring: a flick glides instead of jumping. *@
        <div class="scroll-track">
            <Bmotion Timeline="BmScrollTimeline.Page().Smoothed()" Animate="Bm.To(scaleX: [0, 1])">
                <div class="scroll-fill" />
            </Bmotion>
        </div>

        @* View(): the element's own journey through the viewport, 0 as it enters and 1 as it
           leaves. Four keyframes, so it fades in, holds, then fades out again. *@
        <Bmotion Timeline="BmScrollTimeline.View()"
                 Animate="Bm.To(opacity: [0, 1, 1, 0], scale: [0.6, 1, 1, 0.6], rotate: [-12, 0, 0, 12])">
            <div class="box" />
        </Bmotion>

        @* A native range (CSS animation-range) narrows the journey: arrived by mid-screen. *@
        <Bmotion Timeline='BmScrollTimeline.View(range: "entry 0% cover 50%")'
                 Animate="Bm.To(opacity: [0, 1], scale: [0.6, 1], rotate: [-12, 0])">
            <div class="box" />
        </Bmotion>

        @* One scroll container instead of the page, read along the inline (horizontal) axis. *@
        <div class="scroll-track">
            <Bmotion Timeline='BmScrollTimeline.Container(".h-rail", BmScrollAxis.X)' Animate="Bm.To(scaleX: [0, 1])">
                <div class="scroll-fill" />
            </Bmotion>
        </div>
        <div class="h-rail" style="display:flex;gap:.75rem;overflow-x:auto">…</div>

        @* Another element's journey driving this one - a pinned bar following a strip further down. *@
        <Bmotion Timeline='BmScrollTimeline.ViewOf(".inview-strip")' Animate="Bm.To(scaleX: [0, 1])">
            <div class="scroll-fill" />
        </Bmotion>

        @* The same container, read as numbers: a BmotionScrollTracker observing it by element id.
           await RailScroll.ObserveAsync("h-rail", info => { _x = info.ScrollX; _p = info.ProgressX; ... }); *@
        """;

    private const string _scrollTrackCode = """
        @using Bit.Bmotion
        @inject BmotionScrollTracker Scroll
        @implements IAsyncDisposable

        <style>
            :root { --bm-card: #F5F5F5; --bm-muted: #525252; --bm-track: #EBEBEB; --bm-primary: #1276C6; --bm-secondary: #FD7F36; }
            .scroll-progress {
                position: sticky; top: 0; z-index: 50; background: var(--bm-card);
                border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem;
                box-shadow: 0 4px 20px rgba(0,0,0,.15);
            }
            .scroll-track { background: var(--bm-track); border-radius: 6px; height: 8px; overflow: hidden; width: 100%; }
            .scroll-fill { height: 100%; border-radius: 6px; transition: width .05s;
                background: linear-gradient(90deg, var(--bm-primary), var(--bm-secondary)); }
        </style>

        <div class="scroll-progress">
            <div class="scroll-track">
                <div class="scroll-fill" style="@($"width:{Percent(_progressY)}%")"></div>
            </div>
            <div>Y: @Percent(_progressY)% | X: @Percent(_progressX)%</div>
        </div>

        @code {
            private double _progressX;
            private double _progressY;

            private static string Percent(double progress)
                => (progress * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

            protected override async Task OnAfterRenderAsync(bool firstRender)
            {
                if (firstRender)
                {
                    await Scroll.ObserveAsync(info =>
                    {
                        _progressX = info.ProgressX;
                        _progressY = info.ProgressY;
                        return InvokeAsync(StateHasChanged);
                    });
                }
            }

            // The tracker is transient and owned by this component - dispose it or the
            // browser-side listener outlives the page.
            public async ValueTask DisposeAsync() => await Scroll.DisposeAsync();
        }
        """;

    private const string _inViewCode = """
        @using Bit.Bmotion

        @* An ordinary gesture state, triggered by an IntersectionObserver instead of a pointer.
           Once="true" stops it replaying every time the element crosses the fold. *@
        @for (int i = 0; i < 12; i++)
        {
            var idx = i;
            <Bmotion Initial="@(Bm.To(opacity: 0, x: idx % 2 == 0 ? -60 : 60))"
                     WhileInView="Bm.To(opacity: 1, x: 0)"
                     Transition="Bm.Tween(0.5, BmEase.BackOut)"
                     Once="true">
                <div class="band">Section @(idx + 1)</div>
            </Bmotion>
        }

        @* For finer control, swap Once for the full viewport options: *@
        <Bmotion WhileInView="Bm.To(opacity: 1)"
                 Viewport='new BmViewport { Once = true, Amount = "all", Margin = "0px 0px -80px 0px" }'>
            <div class="band" />
        </Bmotion>
        """;
}
