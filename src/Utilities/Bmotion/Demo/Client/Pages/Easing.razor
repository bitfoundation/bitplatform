@page "/easing"

<PageTitle>Easing · Bmotion</PageTitle>

<div class="bb-intro">
    <h1>Easing</h1>
    <p class="bb-subtitle">
        An easing curve is what turns a duration into a feel. <strong>Bm.Tween</strong> takes one as its
        second argument and covers the full easings.net family - the cubic default
        (<code>In</code> / <code>Out</code> / <code>InOut</code>) plus Sine, Quad, Quart, Quint, Expo and
        Circ, the overshooting <em>Back</em> and <em>Anticipate</em>, and the oscillating
        <em>Elastic</em> and <em>Bounce</em> - along with <code>steps()</code> staircases and arbitrary
        cubic-béziers. Curves the browser can express are sampled to <code>linear()</code> and handed to
        the compositor; the rest run on the C# frame loop.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Named presets</h3>
    <p>
        Each row below plays the same 240&nbsp;px move over the same 0.9&nbsp;s, so the only thing
        that differs is the curve. Almost every family comes in three directions, and the direction is the
        part to choose first: <code>In</code> starts slow and arrives fast - right for something leaving -
        <code>Out</code> starts fast and settles, which is what an entrance wants, and <code>InOut</code> is slow at
        both ends, for a move between two resting places. Within a direction the families differ in how hard they
        lean: <code>Sine</code> barely, <code>Quad</code> through <code>Quint</code> and <code>Expo</code> more and
        more, <code>Circ</code> abruptly. <code>Back</code> pulls back past its start or overshoots its end,
        <code>Anticipate</code> pulls back before it sets off, and <code>Elastic</code> and <code>Bounce</code> keep
        moving after they arrive. Switch direction to see all 32.
    </p>
    <p>
        <code>Bm.Tween()</code> with no arguments is a 0.3&nbsp;s <code>BmEase.Out</code> - the plain
        <code>In</code> / <code>Out</code> / <code>InOut</code> rows are the cubic curve, the default.
    </p>

    <div class="bb-toolbar">
        <div class="bb-segmented" role="group" aria-label="Easing direction">
            @foreach (var direction in _directions)
            {
                <button type="button" aria-pressed="@(_direction == direction ? "true" : "false")"
                        @onclick="@(() => _direction = direction)">@direction</button>
            }
        </div>
    </div>

    <div class="ease-list">
        @foreach (var e in EasesFor(_direction))
        {
            <div class="ease-row">
                <span class="demo-label ease-name">@e</span>
                <div class="ease-track">
                    <Bmotion Animate="@(_on ? Bm.To(x: 240) : Bm.To(x: 0))"
                             Transition="Bm.Tween(0.9, e)">
                        <div class="box box-sm ease-dot" />
                    </Bmotion>
                </div>
            </div>
        }
    </div>

    <div class="bb-toolbar">
        <button class="btn btn-primary" @onclick="@(() => _on = !_on)">@(_on ? "Send back" : "Animate")</button>
    </div>

    <p>
        A keyframe sequence can take a different curve for every leg instead of one for the whole run - that is
        <code>eases</code>, shown on the <a href="keyframes">Keyframes</a> page.
    </p>

    <CodeSnippet Code="@_easeCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Custom cubic-bézier</h3>
    <p>
        When no preset is the curve you want, hand <strong>Bm.Tween</strong> the four control
        numbers directly with <code>bezier: [x1, y1, x2, y2]</code> - the same values CSS
        <code>cubic-bezier()</code> takes, and the same values a design tool exports. A
        <code>y</code> outside <code>0..1</code> is what produces anticipation and overshoot.
    </p>

    <div class="demo-row">
        @foreach (var b in _beziers)
        {
            <div class="demo-card stack">
                <span class="demo-label">@b.Label</span>
                <div class="ease-track">
                    <Bmotion Animate="@(_bezier ? Bm.To(x: 160) : Bm.To(x: 0))"
                             Transition="Bm.Tween(0.9, bezier: b.Points)">
                        <div class="box box-sm ease-dot" />
                    </Bmotion>
                </div>
            </div>
        }
    </div>

    <div class="bb-toolbar">
        <button class="btn btn-primary" @onclick="@(() => _bezier = !_bezier)">@(_bezier ? "Send back" : "Animate")</button>
    </div>

    <CodeSnippet Code="@_bezierCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Stepped easing</h3>
    <p>
        <strong>Bm.Tween(steps: n, stepJump: …)</strong> maps to CSS <code>steps()</code>: instead of
        a continuous curve the progress advances in <em>n</em> discrete jumps - the sprite-sheet and
        ticking-counter look. <code>stepJump</code> decides where those jumps fall:
        <code>End</code> holds the first frame and jumps on the way out, <code>Start</code> jumps
        immediately, <code>None</code> keeps both endpoints, and <code>Both</code> skips both.
    </p>

    <div class="demo-row">
        @foreach (var s in _steps)
        {
            <div class="demo-card stack">
                <span class="demo-label">steps(6, @s.ToString().ToLowerInvariant())</span>
                <div class="ease-track">
                    <Bmotion Animate="@(_stepped ? Bm.To(x: 160) : Bm.To(x: 0))"
                             Transition="Bm.Tween(1.2, steps: 6, stepJump: s)">
                        <div class="box box-sm ease-dot" />
                    </Bmotion>
                </div>
            </div>
        }
    </div>

    <div class="bb-toolbar">
        <button class="btn btn-primary" @onclick="@(() => _stepped = !_stepped)">@(_stepped ? "Send back" : "Step")</button>
    </div>

    <CodeSnippet Code="@_stepsCode" />
</section>

@code {
    private bool _on;
    private bool _bezier;
    private bool _stepped;

    private static readonly string[] _directions = ["In", "Out", "InOut"];
    private string _direction = "Out";

    // The families that come in three directions, gentlest first. The cubic one is the bare
    // In / Out / InOut, so its prefix is empty.
    private static readonly string[] _families = ["Sine", "Quad", "", "Quart", "Quint", "Expo", "Circ", "Back", "Elastic", "Bounce"];

    // Every BmEase in one direction: Linear and Anticipate have none, so they lead and close each list.
    private static IEnumerable<BmEase> EasesFor(string direction)
    {
        yield return BmEase.Linear;
        foreach (var family in _families)
            yield return Enum.Parse<BmEase>(family + direction);
        yield return BmEase.Anticipate;
    }

    /// <summary>A hand-authored curve: its four control numbers and what they read as.</summary>
    private record BezierDemo(string Label, double[] Points);

    private readonly BezierDemo[] _beziers =
    [
        new("0.4, 0, 0.2, 1 · material standard", [0.4, 0, 0.2, 1]),
        new("0.68, -0.6, 0.32, 1.6 · anticipate then overshoot", [0.68, -0.6, 0.32, 1.6]),
        new("0.9, 0, 1, 0.2 · slow start, hard stop", [0.9, 0, 1, 0.2]),
    ];

    private readonly BmStepJump[] _steps =
    [
        BmStepJump.End, BmStepJump.Start, BmStepJump.None, BmStepJump.Both,
    ];

    private const string _easeCode = """
        @using Bit.Bmotion

        @* The same move and the same duration for every row - only the curve changes. *@
        @foreach (var e in _eases)
        {
            <Bmotion Animate="@(_on ? Bm.To(x: 240) : Bm.To(x: 0))"
                     Transition="Bm.Tween(0.9, e)">
                <div class="box-sm" />
            </Bmotion>
        }

        <button @onclick="@(() => _on = !_on)">@(_on ? "Send back" : "Animate")</button>

        @code {
            private bool _on;

            // All 32: Linear, Anticipate, and ten families in three directions each.
            // Bm.Tween() with no arguments is Bm.Tween(0.3, BmEase.Out).
            private readonly BmEase[] _eases =
            [
                BmEase.Linear,
                BmEase.SineIn,    BmEase.SineOut,    BmEase.SineInOut,
                BmEase.QuadIn,    BmEase.QuadOut,    BmEase.QuadInOut,
                BmEase.In,        BmEase.Out,        BmEase.InOut,        // cubic
                BmEase.QuartIn,   BmEase.QuartOut,   BmEase.QuartInOut,
                BmEase.QuintIn,   BmEase.QuintOut,   BmEase.QuintInOut,
                BmEase.ExpoIn,    BmEase.ExpoOut,    BmEase.ExpoInOut,
                BmEase.CircIn,    BmEase.CircOut,    BmEase.CircInOut,
                BmEase.BackIn,    BmEase.BackOut,    BmEase.BackInOut,
                BmEase.ElasticIn, BmEase.ElasticOut, BmEase.ElasticInOut,
                BmEase.BounceIn,  BmEase.BounceOut,  BmEase.BounceInOut,
                BmEase.Anticipate,
            ];
        }
        """;

    private const string _bezierCode = """
        @using Bit.Bmotion

        @* Four control numbers, exactly as CSS cubic-bezier() takes them. A y outside 0..1
           is what gives you anticipation (negative) and overshoot (above 1). *@
        <Bmotion Animate="@(_on ? Bm.To(x: 160) : Bm.To(x: 0))"
                 Transition="Bm.Tween(0.9, bezier: [0.68, -0.6, 0.32, 1.6])">
            <div class="box-sm" />
        </Bmotion>

        <button @onclick="@(() => _on = !_on)">@(_on ? "Send back" : "Animate")</button>

        @code {
            private bool _on;
        }
        """;

    private const string _stepsCode = """
        @using Bit.Bmotion

        @* steps() advances progress in n discrete jumps instead of a continuous curve.
           stepJump decides where the jumps fall: End (default), Start, None or Both. *@
        <Bmotion Animate="@(_on ? Bm.To(x: 160) : Bm.To(x: 0))"
                 Transition="Bm.Tween(1.2, steps: 6, stepJump: BmStepJump.End)">
            <div class="box-sm" />
        </Bmotion>

        <button @onclick="@(() => _on = !_on)">@(_on ? "Send back" : "Step")</button>

        @code {
            private bool _on;
        }
        """;
}
