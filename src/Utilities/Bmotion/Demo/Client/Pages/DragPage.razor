@page "/drag"

<PageTitle>Drag · Bmotion</PageTitle>

<div class="bb-intro">
    <h1>Drag</h1>
    <p class="bb-subtitle">
        <strong>Drag="true"</strong> is the entire opt-in. Everything after that is a refinement of the
        same gesture: which axes it may use, how far it may go, how it behaves at the edges, what
        happens to the momentum when you let go, and which part of the element is allowed to start it.
        On <strong>Blazor WebAssembly</strong> the drag runs in-process, in the same frame as the
        pointer. On Blazor Server the browser keeps the element under the pointer while .NET catches
        up a round trip later, and the throw's momentum plays in the browser.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Axes and constraints</h3>
    <p>
        <code>Drag="BmDrag.X"</code> or <code>BmDrag.Y</code> locks the gesture to one axis, and
        <strong>DragConstraints</strong> bounds how far it may travel, in pixels from where the element rests:
        <code>Horizontal(left, right)</code> for x, <code>Vertical(top, bottom)</code> for y,
        <code>Box(left, right, top, bottom)</code> for both, or the <code>Left</code> / <code>Right</code> /
        <code>Top</code> / <code>Bottom</code> properties for any mix, leaving the rest unbounded.
        <strong>DragElastic</strong> is what happens past that bound: <code>0</code> is a hard wall,
        <code>1</code> is no resistance at all, and the values in between let the element overshoot
        against increasing resistance and spring back on release.
    </p>

    <div class="demo-row">
        <div class="demo-card drag-stage">
            <span class="stage-note">Free drag &middot; elastic 0.5</span>
            <Bmotion Animate="Bm.To(scale: 1)"
                    WhileDrag='Bm.To(scale: 1.1, boxShadow: "0 15px 35px rgba(0,0,0,.35)")'
                    WhileHover="Bm.To(scale: 1.05)"
                    Drag="true"
                    DragElastic="0.5"
                    Transition="Bm.Spring(stiffness: 200, damping: 20)">
                <div class="box drag-centred" />
            </Bmotion>
        </div>

        <div class="demo-card drag-stage">
            <span class="stage-note">X only &middot; constrained to &plusmn;120 px</span>
            <Bmotion Drag="BmDrag.X"
                    DragConstraints="BmDragConstraints.Horizontal(-120, 120)"
                    DragElastic="0.3"
                    WhileDrag="Bm.To(scale: 1.15)">
                <div class="box box-sm drag-centred-sm" />
            </Bmotion>
        </div>

        <div class="demo-card drag-stage">
            <span class="stage-note">Y only &middot; Vertical(-45, 45)</span>
            <Bmotion Drag="BmDrag.Y"
                    DragConstraints="BmDragConstraints.Vertical(-45, 45)"
                    DragElastic="0.3"
                    WhileDrag="Bm.To(scale: 1.15)">
                <div class="box box-sm drag-centred-sm" />
            </Bmotion>
        </div>

        <div class="demo-card drag-stage">
            <span class="stage-note">Box(-90, 90, -45, 45) &middot; both axes</span>
            <Bmotion Drag="true"
                    DragConstraints="BmDragConstraints.Box(-90, 90, -45, 45)"
                    DragElastic="0.3"
                    WhileDrag="Bm.To(scale: 1.15)">
                <div class="box box-sm drag-centred-sm" />
            </Bmotion>
        </div>
    </div>

    <CodeSnippet Code="@_dragCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Constrain to an element</h3>
    <p>
        Numeric bounds mean re-deriving them every time the layout changes. Element bounds do not:
        <strong>BmDragConstraints.Parent()</strong> keeps the element inside its parent and
        <code>BmDragConstraints.Within(".selector")</code> inside any element you name - here the dashed zone,
        which is not the box's parent. Either is measured at each drag start - and re-measured live if the
        container resizes mid-drag - so a responsive layout needs no extra work.
    </p>

    <div class="demo-row">
        <div class="demo-card drag-stage tall">
            <span class="stage-note">Parent() &middot; the whole stage</span>
            <Bmotion Drag="true"
                    DragConstraints="BmDragConstraints.Parent()"
                    DragElastic="0.2"
                    WhileDrag="Bm.To(scale: 1.1)">
                <div class="box box-sm grabbable" />
            </Bmotion>
        </div>

        <div class="demo-card drag-stage tall">
            <span class="stage-note">Within(".drag-zone") &middot; the dashed zone</span>
            <div class="drag-zone" aria-hidden="true"></div>
            <Bmotion Drag="true"
                    DragConstraints='BmDragConstraints.Within(".drag-zone")'
                    DragElastic="0.2"
                    WhileDrag="Bm.To(scale: 1.1)">
                <div class="box box-sm drag-centred-sm" />
            </Bmotion>
        </div>
    </div>

    <CodeSnippet Code="@_dragParentCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Momentum and fling</h3>
    <p>
        A drag that stops dead where your finger lifted feels like a bug. <strong>DragMomentum</strong>
        (on by default) carries the release velocity into an inertia animation that decelerates on
        its own; <strong>DragTransition</strong> replaces the spring it settles with.
        <strong>DragSnapToOrigin</strong> ignores the momentum entirely and springs the element home,
        which is the right answer for a card you swipe to dismiss.
        <strong>DragDirectionLock</strong> commits to whichever axis the gesture starts on and
        ignores the other for the rest of it - the behaviour a scrollable list wants from a
        two-axis drag.
    </p>

    <div class="demo-row">
        <div class="demo-card drag-stage tall">
            <span class="stage-note">Fling it &middot; momentum on</span>
            <Bmotion Drag="true"
                    DragConstraints="BmDragConstraints.Parent()"
                    DragMomentum="true"
                    DragTransition="Bm.Inertia(timeConstant: 500, power: 0.9)"
                    WhileDrag="Bm.To(scale: 1.1)">
                <div class="box box-sm grabbable" />
            </Bmotion>
        </div>

        <div class="demo-card drag-stage tall">
            <span class="stage-note">Snaps back to origin</span>
            <Bmotion Drag="true"
                    DragSnapToOrigin="true"
                    DragElastic="0.6"
                    DragTransition="Bm.Spring(stiffness: 400, damping: 28)"
                    WhileDrag="Bm.To(scale: 1.1)">
                <div class="box box-sm grabbable" />
            </Bmotion>
        </div>

        <div class="demo-card drag-stage tall">
            <span class="stage-note">Direction lock &middot; first move wins</span>
            <Bmotion Drag="true"
                    DragDirectionLock="true"
                    DragConstraints="BmDragConstraints.Parent()"
                    OnDirectionLock="@(axis => _lockedAxis = axis.ToString())"
                    WhileDrag="Bm.To(scale: 1.1)">
                <div class="box box-sm grabbable" />
            </Bmotion>
            <span class="stage-note bottom">locked axis: @_lockedAxis</span>
        </div>
    </div>

    <CodeSnippet Code="@_momentumCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Snapping on release</h3>
    <p>
        Momentum answers <em>how fast</em> the element stops; <strong>modifyTarget</strong> answers
        <em>where</em>. A <code>DragTransition</code> written as an inertia hands the projected
        resting position to your function and uses whatever comes back, which is the whole of
        carousel paging and grid snapping. <strong>Bm.SnapTo(step)</strong> rounds to a grid,
        <strong>Bm.SnapTo([&hellip;])</strong> picks the nearest of a fixed set of stops. With one
        set, even a slow release still travels to the nearest stop - and the snap is applied before
        the constraints, so it can never land outside them.
    </p>

    <div class="demo-row">
        <div class="demo-card drag-stage">
            <span class="stage-note">Grid &middot; settles every 60 px</span>
            <div class="snap-grid" aria-hidden="true"></div>
            <Bmotion Drag="BmDrag.X"
                    DragConstraints="BmDragConstraints.Horizontal(-120, 120)"
                    DragElastic="BmDragElastic.None"
                    DragTransition="Bm.Inertia(modifyTarget: Bm.SnapTo(60))"
                    WhileDrag="Bm.To(scale: 1.15)">
                <div class="box box-sm drag-centred-sm" />
            </Bmotion>
        </div>

        <div class="demo-card drag-stage">
            <span class="stage-note">Pages &middot; snaps to 1 of 3</span>
            <div class="snap-window">
                <Bmotion Drag="BmDrag.X"
                        DragConstraints="BmDragConstraints.Horizontal(-200, 0)"
                        DragElastic="0.15"
                        DragTransition="Bm.Inertia(modifyTarget: Bm.SnapTo([0, -100, -200]))"
                        WhileDrag="Bm.To(scale: 1.05)">
                    <div class="snap-pages">
                        <span>1</span><span>2</span><span>3</span>
                    </div>
                </Bmotion>
            </div>
        </div>
    </div>

    <CodeSnippet Code="@_snapCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Handles and drag controls</h3>
    <p>
        Making a whole row draggable costs you every click and text selection inside it.
        <strong>DragHandle</strong> restricts the gesture to a grip within the element and leaves
        the rest alone. <strong>BmDragControls</strong> inverts the relationship: some
        <em>other</em> element starts the drag - pair it with <code>DragListener="false"</code> so
        the controls are the only trigger, and pressing anywhere on a track grabs its thumb.
        <strong>BmDragElastic.Edges</strong> tunes the give per edge, so a panel can be rigid where
        it docks and springy where it does not.
    </p>

    <div class="demo-row">
        <div class="demo-card drag-stage">
            <Bmotion Drag="true"
                    DragHandle=".grip"
                    DragConstraints="BmDragConstraints.Parent()"
                    WhileDrag="Bm.To(scale: 1.05)">
                <div class="handle-row">
                    <span class="grip">⠿</span>
                    <span>Drag me by the grip only</span>
                </div>
            </Bmotion>
        </div>

        <div class="demo-card drag-stage">
            <div class="thumb-track" @onpointerdown="@(e => _thumbControls.StartAsync(e))">
                <Bmotion Drag="BmDrag.X"
                        DragControls="_thumbControls"
                        DragListener="false"
                        DragConstraints="BmDragConstraints.Parent()"
                        DragElastic="BmDragElastic.None"
                        WhileDrag="Bm.To(scale: 1.2)">
                    <div class="thumb" />
                </Bmotion>
            </div>
        </div>

        <div class="demo-card drag-stage">
            <span class="stage-note">Rigid left/top &middot; elastic right/bottom</span>
            <Bmotion Drag="true"
                    DragConstraints="BmDragConstraints.Parent()"
                    DragElastic="BmDragElastic.Edges(right: 0.9, bottom: 0.9)">
                <div class="box box-sm grabbable" />
            </Bmotion>
        </div>
    </div>

    <CodeSnippet Code="@_handleControlsCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Drag events</h3>
    <p>
        <code>OnDragStart</code> and <code>OnDragEnd</code> bracket the gesture, and
        <code>OnDrag</code> fires as it moves - on WebAssembly once per pointer move, on Blazor Server at most
        once a frame - enough to persist a position, mark a form dirty, or light up a drop target. For the
        pointer's actual coordinates and velocity, use the pan callbacks on the <a href="gestures">Gestures</a>
        page.
    </p>
    <div class="demo-row">
        <div class="demo-card drag-stage tall">
            <span class="stage-note">OnDrag calls this drag: @_dragMoves</span>
            <Bmotion Drag="true"
                    OnDragStart='@(() => { _dragInfo = "OnDragStart · dragging…"; _dragMoves = 0; })'
                    OnDrag="@(() => _dragMoves++)"
                    OnDragEnd='@(() => _dragInfo = "OnDragEnd · released")'>
                <div class="box box-sm grabbable" />
            </Bmotion>
            <span class="stage-note bottom">@_dragInfo</span>
        </div>
    </div>

    <CodeSnippet Code="@_dragEventsCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Dragging past the edge</h3>
    <p>
        A drag that has to reach something out of view needs the view to move with it.
        <strong>DragAutoScroll="true"</strong> scrolls the nearest scrollable container - or the page - while the
        pointer is held near its edge, faster the closer it gets, and carries the element along so it stays under
        the pointer. It is off by default; <a href="reorder">BmotionReorderGroup</a> turns it on for its items.
        Drag the box down to the bottom of the window and hold it there.
    </p>

    <div class="demo-row">
        <div class="demo-card stack">
            <div class="autoscroll-window" tabindex="0" role="region" aria-label="Scrolling track">
                <div class="autoscroll-track">
                    <Bmotion Drag="BmDrag.Y"
                             DragAutoScroll="true"
                             DragConstraints="BmDragConstraints.Parent()"
                             DragMomentum="false"
                             WhileDrag="Bm.To(scale: 1.1)">
                        <div class="box box-sm grabbable" />
                    </Bmotion>
                </div>
            </div>
        </div>
    </div>

    <CodeSnippet Code="@_autoScrollCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Nested drag and propagation</h3>
    <p>
        A draggable inside a draggable is ambiguous, so Bmotion resolves it the way motion.dev
        does: the child <strong>stops propagation</strong> and only the child moves. Set
        <strong>DragPropagation="true"</strong> on the child when you want the gesture to reach the
        parent as well and both to travel together.
    </p>

    <div class="demo-row">
        <div class="demo-card drag-stage taller">
            <span class="stage-note">child isolates (default)</span>
            <Bmotion Drag="true" DragConstraints="BmDragConstraints.Parent()" DragElastic="0.2">
                <div class="drag-parent">
                    <Bmotion Drag="true" DragConstraints="BmDragConstraints.Parent()">
                        <div class="drag-child" />
                    </Bmotion>
                </div>
            </Bmotion>
        </div>

        <div class="demo-card drag-stage taller">
            <span class="stage-note">child propagates</span>
            <Bmotion Drag="true" DragConstraints="BmDragConstraints.Parent()" DragElastic="0.2">
                <div class="drag-parent">
                    <Bmotion Drag="true" DragPropagation="true" DragConstraints="BmDragConstraints.Parent()">
                        <div class="drag-child" />
                    </Bmotion>
                </div>
            </Bmotion>
        </div>
    </div>

    <CodeSnippet Code="@_nestedCode" />
</section>

@code {
    private string _dragInfo = "Drag the box";
    private int _dragMoves;
    private string _lockedAxis = "none yet";
    private readonly BmDragControls _thumbControls = new();

    private const string _dragCode = """
        @using Bit.Bmotion

        <style>
            :root { --bm-primary: #1276C6; --bm-secondary: #FD7F36; --bm-card: #F5F5F5; --bm-border: #E0E0E0; }
            .demo-card {
                background: var(--bm-card); border: 1px solid var(--bm-border);
                border-radius: 12px; padding: 2rem; height: 200px; flex: 1; min-width: 220px;
                display: flex; align-items: center; justify-content: center;
                position: relative; overflow: hidden;
            }
            .box { width: 80px; height: 80px; border-radius: 10px; cursor: grab;
                background: linear-gradient(135deg, var(--bm-primary), var(--bm-secondary)); }
        </style>

        @* Free drag. DragElastic is what happens past the bounds: 0 is a hard wall,
           1 is no resistance, in between overshoots and springs back. *@
        <div class="demo-card">
            <Bmotion Animate="Bm.To(scale: 1)"
                     WhileDrag='Bm.To(scale: 1.1, boxShadow: "0 15px 35px rgba(0,0,0,.35)")'
                     WhileHover="Bm.To(scale: 1.05)"
                     Drag="true"
                     DragElastic="0.5"
                     Transition="Bm.Spring(stiffness: 200, damping: 20)">
                <div class="box" />
            </Bmotion>
        </div>

        @* One axis, bounded in pixels from where the element rests. *@
        <div class="demo-card">
            <Bmotion Drag="BmDrag.X"
                     DragConstraints="BmDragConstraints.Horizontal(-120, 120)"
                     DragElastic="0.3"
                     WhileDrag="Bm.To(scale: 1.15)">
                <div class="box" />
            </Bmotion>
        </div>

        @* The other axis, and both at once: Box(left, right, top, bottom). *@
        <Bmotion Drag="BmDrag.Y" DragConstraints="BmDragConstraints.Vertical(-45, 45)">...</Bmotion>
        <Bmotion Drag="true" DragConstraints="BmDragConstraints.Box(-90, 90, -45, 45)">...</Bmotion>

        @* Any mix of edges, the rest unbounded - here only the left and the top: *@
        <Bmotion Drag="true" DragConstraints="new BmDragConstraints { Left = -40, Top = 0 }">...</Bmotion>
        """;

    private const string _dragParentCode = """
        @using Bit.Bmotion

        @* Element bounds instead of numbers: measured at each drag start (and re-measured if
           the container resizes mid-drag), so a responsive layout needs no extra work. *@
        <div class="demo-card">
            <Bmotion Drag="true"
                     DragConstraints="BmDragConstraints.Parent()"
                     DragElastic="0.2"
                     WhileDrag="Bm.To(scale: 1.1)">
                <div class="box" />
            </Bmotion>
        </div>

        @* Any element works, not just the parent: the box is the zone's sibling here.
           The selector is looked up in the document, so give it a class or id that is unique. *@
        <div class="demo-card" style="position:relative">
            <div class="drag-zone" style="position:absolute;inset:2.5rem 25%;border:2px dashed #1276C6"></div>
            <Bmotion Drag="true"
                     DragConstraints='BmDragConstraints.Within(".drag-zone")'
                     DragElastic="0.2">
                <div class="box" />
            </Bmotion>
        </div>
        """;

    private const string _momentumCode = """
        @using Bit.Bmotion

        @* 1 - Momentum (on by default): the release velocity feeds an inertia animation
           that decelerates on its own. DragTransition replaces the settle. *@
        <Bmotion Drag="true"
                 DragConstraints="BmDragConstraints.Parent()"
                 DragMomentum="true"
                 DragTransition="Bm.Inertia(timeConstant: 500, power: 0.9)">
            <div class="box" />
        </Bmotion>

        @* 2 - Snap to origin: ignore the momentum and spring home on release. The
           swipe-to-dismiss / return-to-deck idiom. *@
        <Bmotion Drag="true"
                 DragSnapToOrigin="true"
                 DragElastic="0.6"
                 DragTransition="Bm.Spring(stiffness: 400, damping: 28)">
            <div class="box" />
        </Bmotion>

        @* 3 - Direction lock: whichever axis the gesture starts on wins for the rest of it.
           OnDirectionLock reports that decision the moment it is made. *@
        <Bmotion Drag="true"
                 DragDirectionLock="true"
                 DragConstraints="BmDragConstraints.Parent()"
                 OnDirectionLock="@(axis => _lockedAxis = axis.ToString())">
            <div class="box" />
        </Bmotion>

        @code {
            private string _lockedAxis = "none yet";
        }
        """;

    private const string _snapCode = """
        @using Bit.Bmotion

        @* A DragTransition written as an inertia configures the momentum itself - including
           modifyTarget, which decides WHERE the coast comes to rest. *@

        @* 1 - Grid: round the projected resting position to the nearest 60px. *@
        <Bmotion Drag="BmDrag.X"
                 DragConstraints="BmDragConstraints.Horizontal(-120, 120)"
                 DragElastic="BmDragElastic.None"
                 DragTransition="Bm.Inertia(modifyTarget: Bm.SnapTo(60))">
            <div class="box" />
        </Bmotion>

        @* 2 - Pages: snap to whichever of the fixed stops the fling was heading for. The pages sit
           100px apart, inside a window one page wide (overflow: hidden). *@
        <div class="window">
            <Bmotion Drag="BmDrag.X"
                     DragConstraints="BmDragConstraints.Horizontal(-200, 0)"
                     DragElastic="0.15"
                     DragTransition="Bm.Inertia(modifyTarget: Bm.SnapTo([0, -100, -200]))">
                <div class="pages">
                    <span>1</span><span>2</span><span>3</span>
                </div>
            </Bmotion>
        </div>

        @* modifyTarget takes any function - Bm.SnapTo is just the common shape:
           DragTransition="Bm.Inertia(modifyTarget: v => v < -100 ? -200 : 0)" *@
        """;

    private const string _handleControlsCode = """
        @using Bit.Bmotion

        @* 1 - Drag handle: only the grip starts the drag, so the rest of the row keeps
           its clicks and text selection. *@
        <Bmotion Drag="true" DragHandle=".grip" DragConstraints="BmDragConstraints.Parent()">
            <div class="row">
                <span class="grip">⠿</span>
                <span>Drag me by the grip only</span>
            </div>
        </Bmotion>

        @* 2 - Drag controls: another element starts the gesture. DragListener="false"
           makes the controls the ONLY trigger, so the thumb itself is inert. *@
        <div class="track" @onpointerdown="@(e => _thumbControls.StartAsync(e))">
            <Bmotion Drag="BmDrag.X"
                     DragControls="_thumbControls"
                     DragListener="false"
                     DragConstraints="BmDragConstraints.Parent()"
                     DragElastic="BmDragElastic.None">
                <div class="thumb" />
            </Bmotion>
        </div>

        @* 3 - Per-edge elasticity: rigid left/top, springy right/bottom.
           Unspecified edges are rigid. *@
        <Bmotion Drag="true"
                 DragConstraints="BmDragConstraints.Parent()"
                 DragElastic="BmDragElastic.Edges(right: 0.9, bottom: 0.9)">
            <div class="box" />
        </Bmotion>

        @code {
            private readonly BmDragControls _thumbControls = new();
        }
        """;

    private const string _dragEventsCode = """
        @using Bit.Bmotion

        @* OnDragStart / OnDragEnd bracket the gesture and OnDrag fires as it moves. For the
           pointer's actual coordinates and velocity, use OnPan and its BmPanInfo instead. *@
        <Bmotion Drag="true"
                 OnDragStart='@(() => { _dragInfo = "Dragging…"; _moves = 0; })'
                 OnDrag="@(() => _moves++)"
                 OnDragEnd='@(() => _dragInfo = "Released")'>
            <div class="box" />
        </Bmotion>

        <p>@_dragInfo · OnDrag calls: @_moves</p>

        @code {
            private string _dragInfo = "Drag the box";
            private int _moves;
        }
        """;

    private const string _autoScrollCode = """
        @using Bit.Bmotion

        <style>
            .window { height: 12rem; overflow-y: auto; }
            .track  { position: relative; height: 36rem; }   /* taller than its window */
        </style>

        @* Held near the window's edge, the window scrolls - faster the closer the pointer is -
           and the box travels with it. Parent() keeps it inside the whole track, scrolled or not. *@
        <div class="window">
            <div class="track">
                <Bmotion Drag="BmDrag.Y"
                         DragAutoScroll="true"
                         DragConstraints="BmDragConstraints.Parent()"
                         DragMomentum="false">
                    <div class="box" />
                </Bmotion>
            </div>
        </div>
        """;

    private const string _nestedCode = """
        @using Bit.Bmotion

        @* Default: the child's drag stops propagation - only the child moves. *@
        <Bmotion Drag="true" DragConstraints="BmDragConstraints.Parent()">
            <div class="drag-parent">
                <Bmotion Drag="true" DragConstraints="BmDragConstraints.Parent()">
                    <div class="drag-child" />
                </Bmotion>
            </div>
        </Bmotion>

        @* Opt in with DragPropagation="true" - dragging the child moves both. *@
        <Bmotion Drag="true" DragConstraints="BmDragConstraints.Parent()">
            <div class="drag-parent">
                <Bmotion Drag="true" DragPropagation="true" DragConstraints="BmDragConstraints.Parent()">
                    <div class="drag-child" />
                </Bmotion>
            </div>
        </Bmotion>
        """;
}
