@page "/reorder"

<PageTitle>Reorder · Bmotion</PageTitle>

<div class="bb-intro">
    <h1>Reorder</h1>
    <p class="bb-subtitle">
        Drag-to-reorder is the one interaction where the naive implementation is always wrong: re-render
        the list on every pointer move and you drop frames, lose focus and reset component state.
        <strong>BmotionReorderGroup</strong> previews the new order with transforms only - the list
        itself re-renders <em>once</em>, on release - so the drag stays smooth and the bound list is the
        single source of truth throughout.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Drag to reorder</h3>
    <p>
        Bind a list, give the items a stable key, and every row becomes draggable along the list
        axis while its siblings spring out of the way. <code>HandleSelector</code> restricts the
        gesture to a grip inside each row so the rest of it stays clickable and selectable, and
        <code>OnReorder</code> fires once the new order has been committed.
    </p>

    <div class="demo-row">
        <div class="demo-card list-stage">
            <BmotionReorderGroup @bind-Items="_tracks" ItemKey="@(t => t.Id)"
                                 HandleSelector=".grip" Context="track"
                                 OnReorder="@(() => _reorders++)">
                <div class="track-row">
                    <span class="grip">⠿</span>
                    <span class="track-title">@track.Title</span>
                    <span class="track-time">@track.Duration</span>
                    <button type="button" class="track-move" aria-label="Move @track.Title up"
                            disabled="@(_tracks.IndexOf(track) is 0)"
                            @onclick="() => MoveTrack(track, -1)">▲</button>
                    <button type="button" class="track-move" aria-label="Move @track.Title down"
                            disabled="@(_tracks.IndexOf(track) == _tracks.Count - 1)"
                            @onclick="() => MoveTrack(track, 1)">▼</button>
                </div>
            </BmotionReorderGroup>
        </div>
    </div>

    <p class="reorder-readout">
        Current order: @string.Join(" → ", _tracks.Select(t => t.Title))
        <br />
        Committed reorders: @_reorders
    </p>

    <CodeSnippet Code="@_reorderCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Horizontal lists</h3>
    <p>
        <code>Axis="BmDragAxis.X"</code> runs the same machinery sideways for a row of tabs, a
        toolbar or a card rail. Only the axis changes - the displacement, the commit and the binding
        all behave identically. Wrapping grids are not supported: the group needs a single line to
        reason about order along.
    </p>

    <div class="demo-row">
        <div class="demo-card">
            <div class="chip-rail">
                <BmotionReorderGroup @bind-Items="_stages" Axis="BmDragAxis.X" Context="stage">
                    <div class="rail-chip">@stage</div>
                </BmotionReorderGroup>
            </div>
        </div>
    </div>

    <p class="reorder-readout">Current order: @string.Join(" → ", _stages)</p>

    <CodeSnippet Code="@_horizontalCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Keyboard access</h3>
    <p>
        Every list here is keyboard-reorderable out of the box. Tab to a row and press <kbd>Space</kbd> to
        pick it up. The arrow keys move it while the others make way, <kbd>Space</kbd> drops it, and
        <kbd>Escape</kbd> puts it back. Each step is announced to screen readers, and <code>Announce</code>
        lets you word those announcements or translate them.
    </p>
    <p>
        The group also follows any change to the bound list, so plain move-up / move-down buttons that
        reorder <code>Items</code> directly (the ▲▼ controls in the first sample) animate exactly like a
        drag. The same goes for any other source of order: a sort, a server push, an undo.
    </p>

    <CodeSnippet Code="@_keyboardCode" />
</section>

@code {
    private sealed record Track(int Id, string Title, string Duration);

    private int _reorders;

    private List<Track> _tracks =
    [
        new(1, "One More Time", "5:20"),
        new(2, "Digital Love", "4:58"),
        new(3, "Harder Better Faster", "3:45"),
        new(4, "Something About Us", "3:51"),
        new(5, "Voyager", "3:47"),
    ];

    private List<string> _stages = ["Draft", "Review", "Approved", "Shipped"];

    // Another source of order next to the drag and the built-in keyboard reordering: the group observes external
    // Items mutations, so moving an item in the bound list reorders the rendered rows.
    private void MoveTrack(Track track, int delta)
    {
        var index = _tracks.IndexOf(track);
        var target = index + delta;
        if (index < 0 || target < 0 || target >= _tracks.Count) return;
        _tracks.RemoveAt(index);
        _tracks.Insert(target, track);
    }

    private const string _reorderCode = """
        @using Bit.Bmotion

        <style>
            :root { --bm-muted: #525252; --bm-accent-soft: rgba(18,118,198,.12); --bm-accent-line: rgba(18,118,198,.35); }
            .list { display: flex; flex-direction: column; gap: .6rem; }
            .row {
                display: flex; align-items: center; gap: .7rem;
                background: var(--bm-accent-soft); border: 1px solid var(--bm-accent-line);
                border-radius: 8px; padding: .7rem 1rem;
            }
            .grip { cursor: grab; color: var(--bm-muted); user-select: none; }
        </style>

        <div class="list">
            @* The preview is transform-based: this list re-renders once, on release. *@
            <BmotionReorderGroup @bind-Items="_tracks" ItemKey="@(t => t.Id)"
                                 HandleSelector=".grip" Context="track"
                                 OnReorder="@(() => _reorders++)">
                <div class="row">
                    <span class="grip">⠿</span>
                    <span style="flex:1">@track.Title</span>
                    <span>@track.Duration</span>
                </div>
            </BmotionReorderGroup>
        </div>

        @code {
            private int _reorders;

            private sealed record Track(int Id, string Title, string Duration);

            private List<Track> _tracks =
            [
                new(1, "One More Time", "5:20"),
                new(2, "Digital Love", "4:58"),
                new(3, "Harder Better Faster", "3:45"),
            ];
        }
        """;

    private const string _horizontalCode = """
        @using Bit.Bmotion

        @* Same machinery, sideways. A single line only - wrapping grids are not supported. *@
        <div style="display:flex;gap:.5rem;flex-wrap:nowrap">
            <BmotionReorderGroup @bind-Items="_stages" Axis="BmDragAxis.X" Context="stage">
                <div class="chip">@stage</div>
            </BmotionReorderGroup>
        </div>

        @code {
            // No ItemKey needed here: the strings are their own identity, and they are unique.
            private List<string> _stages = ["Draft", "Review", "Approved", "Shipped"];
        }
        """;

    private const string _keyboardCode = """
        @* Keyboard reordering is built in (Space, the arrow keys, Space; Escape cancels) - Announce words it: *@
        <BmotionReorderGroup @bind-Items="_tracks" Context="track"
                             Announce='a => $"{a.Item.Title}, {a.Event}: {a.Position} of {a.Count}"'>
            …
        </BmotionReorderGroup>

        @* And the group observes external mutations of the bound list, so anything that reorders
           Items animates exactly like a drag: move buttons, a sort, a server push, an undo. *@
        <button aria-label="Move @track.Title up"
                disabled="@(_tracks.IndexOf(track) is 0)"
                @onclick="() => MoveTrack(track, -1)">▲</button>

        @code {
            private void MoveTrack(Track track, int delta)
            {
                var index = _tracks.IndexOf(track);
                var target = index + delta;
                if (index < 0 || target < 0 || target >= _tracks.Count) return;
                _tracks.RemoveAt(index);
                _tracks.Insert(target, track);
            }
        }
        """;
}
