@page "/programmatic"
@inject BmotionAnimateService Motion
@implements IDisposable

<PageTitle>Programmatic API · Bmotion</PageTitle>

<div class="bb-intro">
    <h1>Programmatic API</h1>
    <p class="bb-subtitle">
        Declarative animation covers the common case: describe the state, let the change drive the
        motion. Some things do not fit that shape - a timeline whose steps overlap, a value that is not
        a DOM property, an animation you need to pause halfway. <strong>BmotionAnimateService</strong>
        is the imperative half of the library: animate by CSS selector or <code>ElementReference</code>,
        with no <code>&lt;Bmotion&gt;</code> wrapper anywhere in sight, and get back playback controls
        you can hold on to.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Animating by selector</h3>
    <p>
        <code>AnimateAsync(selector, target, transition, stagger)</code> resolves every matching
        element and animates them together, with the optional <strong>stagger</strong> spreading
        their start times. The call returns <strong>BmAnimationControls</strong>: awaitable for
        completion, and holding <code>Pause</code>, <code>Play</code>, <code>SetSpeed</code>,
        <code>Stop</code> (freeze where it is) and <code>Complete</code> (jump to the end). It also knows where
        it is - <code>Duration</code>, <code>Time</code>, <code>Progress</code> and <code>State</code> - and
        <code>Seek</code> moves it: the slider below scrubs the run. Start the slow run and then interfere with it.
    </p>

    <div class="demo-row">
        <div class="demo-card">
            <div class="dot-row">
                @for (var i = 0; i < 8; i++)
                {
                    <div class="prog-dot"></div>
                }
            </div>
        </div>
    </div>

    <div class="bb-toolbar">
        <button class="btn btn-primary" @onclick="RunAsync">Run</button>
        <button class="btn btn-secondary" @onclick="@(() => _controls?.Pause())">Pause</button>
        <button class="btn btn-secondary" @onclick="@(() => _controls?.Play())">Play</button>
        <button class="btn btn-secondary" @onclick="@(() => _controls?.SetSpeed(3))">3&times; speed</button>
        <button class="btn btn-secondary" @onclick="@(() => _controls?.Complete())">Complete</button>
        <button class="btn btn-secondary" @onclick="ResetDotsAsync">Reset</button>
        <span class="demo-label">@_runState</span>
    </div>

    <div class="bb-toolbar">
        <label class="demo-label" for="prog-scrub">Scrub</label>
        <input id="prog-scrub" type="range" min="0" max="1000" value="@_scrub" disabled="@(_controls is null)"
               @oninput="Scrub" />
        <span class="demo-label">@_scrubLabel</span>
    </div>

    <CodeSnippet Code="@_selectorCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> One element, by id or by reference</h3>
    <p>
        A selector can name one element as easily as many. Give a <code>&lt;Bmotion&gt;</code> a stable
        <strong>Id</strong> and <code>"#id"</code> reaches it from anywhere - from code, from your own CSS, from a
        test - instead of the generated id it otherwise gets. An element with no Bmotion around it at all is
        reached through an <strong>ElementReference</strong>: capture it with <code>@@ref</code> and hand it to
        <code>AnimateAsync</code>, which registers it with the engine on first use. Both return the same
        controls a selector does.
    </p>

    <div class="demo-row">
        <div class="demo-card stack">
            <span class="demo-label">&lt;Bmotion Id="promo-card"&gt;</span>
            <Bmotion Id="promo-card" Animate="Bm.To(scale: 1)">
                <div class="box box-sm" />
            </Bmotion>
        </div>
        <div class="demo-card stack">
            <span class="demo-label">a plain &lt;div @@ref&gt;</span>
            <div class="box box-sm" @ref="_plainBox"></div>
        </div>
    </div>

    <div class="bb-toolbar">
        <button class="btn btn-primary" @onclick="NudgeByIdAsync">Animate "#promo-card"</button>
        <button class="btn btn-secondary" @onclick="SpinReferenceAsync">Animate the reference</button>
    </div>

    <CodeSnippet Code="@_targetingCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Animating a number</h3>
    <p>
        Nothing about the engine requires a DOM element. <code>AnimateAsync(from, to, onUpdate,
        transition)</code> interpolates a bare <code>double</code> and hands you every value on the
        way - which is how you get a counter that eases rather than ticks, and equally how you
        would drive a canvas, an audio gain or anything else outside the render tree.
    </p>

    <div class="demo-row">
        <div class="demo-card stack">
            <span class="counter">@_count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
            <span class="demo-label">interpolated, not incremented</span>
        </div>
    </div>

    <div class="bb-toolbar">
        <button class="btn btn-primary" @onclick="@(() => CountToAsync(2_450))">Count up</button>
        <button class="btn btn-secondary" @onclick="@(() => CountToAsync(0))">Count down</button>
    </div>

    <CodeSnippet Code="@_countCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Sequences</h3>
    <p>
        A <strong>BmSequence</strong> is a timeline: each step names its own target, and
        <code>at</code> places it relative to what came before. <code>"+0.2"</code> and
        <code>"-0.1"</code> are offsets from the previous step's <em>end</em> (so a negative value
        overlaps it), <code>"&lt;"</code> aligns with the previous step's <em>start</em>, a bare
        number is absolute, and <code>Label</code> marks a position several later steps can share.
        That is what lets a sequence overlap without you hand-computing a single delay.
    </p>
    <p>
        The whole timeline runs on <strong>one playhead</strong>, driven by the animation clock
        rather than by wall-clock timers. So the controls it returns govern the gaps between the
        steps as well as the steps themselves: pause it mid-run and the sequence genuinely holds
        instead of quietly starting its later steps on time, and <code>SetSpeed(3)</code> compresses
        the silences by the same factor it compresses the movement.
    </p>

    <div class="demo-row">
        <div class="demo-card seq-stage">
            <div id="seq-box" class="box seq-box"></div>
            <div class="seq-dots">
                @for (var i = 0; i < 5; i++)
                {
                    <div class="seq-dot"></div>
                }
            </div>
        </div>
    </div>

    <div class="bb-toolbar">
        <button class="btn btn-primary" @onclick="RunSequenceAsync">Play sequence</button>
        <button class="btn btn-secondary" @onclick="@(() => _sequenceControls?.Pause())">Pause</button>
        <button class="btn btn-secondary" @onclick="@(() => _sequenceControls?.Play())">Resume</button>
        <button class="btn btn-secondary" @onclick="@(() => _sequenceControls?.SetSpeed(3))">3&times; speed</button>
        <button class="btn btn-secondary" @onclick="ResetSequenceAsync">Reset</button>
    </div>

    <CodeSnippet Code="@_sequenceCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Motion values</h3>
    <p>
        A <strong>motion value</strong> is a number that other things can watch. Bind one with the
        <code>Values</code> parameter and it writes to the DOM every frame without re-rendering the
        component; derive from it with <code>Transform</code> and the derived value updates in
        lockstep; wrap it in <code>Motion.Spring</code> and you get a follower that lags behind with
        physics rather than tracking exactly. The slider below sets one value - everything else on
        the row is downstream of it.
    </p>

    <div class="demo-row">
        <div class="demo-card stack">
            <input type="range" min="0" max="100" step="1" class="value-slider"
                   value="@_slider" @oninput="OnSliderInput" aria-label="Drive the motion value" />

            <div class="value-row">
                <div class="value-cell">
                    <Bmotion Values="_directValues">
                        <div class="box box-sm" />
                    </Bmotion>
                    <span class="demo-label">bound directly</span>
                </div>

                <div class="value-cell">
                    <Bmotion Values="_springValues">
                        <div class="box box-sm" />
                    </Bmotion>
                    <span class="demo-label">spring follower</span>
                </div>

                <div class="value-cell">
                    <Bmotion Values="_rotateValues">
                        <div class="box box-sm" />
                    </Bmotion>
                    <span class="demo-label">Transform → 0-360&deg;</span>
                </div>
            </div>

            <div class="readout">
                <div>Value @Fmt(_driver.Value) &middot; MapRange(0..100 → 0..1) @Fmt(Bm.MapRange(_driver.Value, [0, 100], [0, 1]), "0.00")</div>
                <div>Clamp(25, 75) @Fmt(Bm.Clamp(25, 75, _driver.Value)) &middot; Wrap(0, 40) @Fmt(Bm.Wrap(0, 40, _driver.Value)) &middot; Mix(-60, 60, v/100) @Fmt(Bm.Mix(-60, 60, _driver.Value / 100))</div>
            </div>
        </div>
    </div>

    <div class="bb-toolbar">
        <button class="btn btn-primary" @onclick="@(() => SpringDriverAsync(100))">AnimateAsync(value, 100)</button>
        <button class="btn btn-secondary" @onclick="@(() => SpringDriverAsync(0))">AnimateAsync(value, 0)</button>
        <button class="btn btn-secondary" @onclick="@(() => JumpDriver(50))">Jump(50)</button>
    </div>

    <p>
        Read a value back with <code>Value</code>, or <code>Subscribe</code> to every change - the readout above
        does, throttled to ten renders a second, and the returned handle unsubscribes when disposed.
        <code>Motion.AnimateAsync(value, to, transition)</code> animates the value itself, and every binding
        downstream follows; a spring picks up the value's current velocity. <code>Jump</code> teleports it
        instead, with no velocity for a spring to carry on. The <code>Bm</code> helpers are the small maths
        motion values are made of: <code>MapRange</code> maps a number from one range onto another - what
        <code>Transform</code> does continuously - <code>Clamp</code> bounds it, <code>Wrap</code> loops it round
        a range, which is the infinite-carousel helper, and <code>Mix</code> interpolates between two numbers.
    </p>

    <CodeSnippet Code="@_valuesCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> Driving one element by reference</h3>
    <p>
        When the element <em>is</em> a <code>&lt;Bmotion&gt;</code>, a <code>@@ref</code> gives you
        the same controls without a selector. <code>AnimateAsync</code> plays a one-off target over whatever
        is running, <code>Set</code> applies one instantly with no animation (<code>SetAsync</code> also writes
        it to the element before returning), <code>Pause</code> / <code>Resume</code> /
        <code>SetPlaybackRate</code> control whatever is currently running, and <code>Stop</code> freezes it
        where it stands - all of it, or only the properties you name. Every async call here and on the service
        takes a <code>CancellationToken</code>, which stops the animation when cancelled.
    </p>

    <div class="demo-row">
        <div class="demo-card">
            <Bmotion @ref="_box"
                     Animate="Bm.To(rotate: 360)"
                     Transition="Bm.Tween(4, BmEase.Linear, repeat: BmRepeat.Forever)">
                <div class="box" />
            </Bmotion>
        </div>
    </div>

    <div class="bb-toolbar">
        <button class="btn btn-primary" @onclick="@(() => _box.Pause())">Pause</button>
        <button class="btn btn-secondary" @onclick="@(() => _box.Resume())">Resume</button>
        <button class="btn btn-secondary" @onclick="@(() => _box.SetPlaybackRate(4))">4&times; rate</button>
        <button class="btn btn-secondary" @onclick="PulseAsync">Pulse</button>
        <button class="btn btn-secondary" @onclick="ToggleScale">Set scale</button>
        <button class="btn btn-secondary" @onclick="@(() => _box.Stop("rotate"))">Stop("rotate")</button>
    </div>

    <CodeSnippet Code="@_refCode" />
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Global defaults</h3>
    <p>
        <strong>BmotionConfig</strong> cascades defaults to everything beneath it, which is the
        cheapest way to change the feel of a whole surface at once. <code>Transition</code> is the default
        for every element under it that doesn't set its own - the right-hand box below has none, so it plays
        the config's spring. <code>TransitionSpeed</code> is a playback multiplier - <code>0.25</code> is the
        slow-motion switch every animation developer wants while tuning, and <code>0</code> makes every
        transition instant. It also carries <code>ColorSpace</code> (see <a href="color">Color</a>) and
        <code>ReduceMotion</code>, the <em>prefers-reduced-motion</em> policy for its subtree &mdash; covered in
        full on the <a href="accessibility">Accessibility</a> page.
    </p>

    <BmotionConfig Transition="Bm.Spring(bounce: 0.6, duration: 0.8)" TransitionSpeed="_speed">
        <div class="demo-row">
            <div class="demo-card stack">
                <span class="demo-label">All three inherit the speed below; the last inherits the config's spring too</span>
                <div class="value-row">
                    <Bmotion Animate="@(_configOn ? Bm.To(x: 40, rotate: 180) : Bm.To(x: -40, rotate: 0))"
                             Transition="Bm.Spring(stiffness: 180, damping: 16)">
                        <div class="box box-sm" />
                    </Bmotion>
                    <Bmotion Animate="@(_configOn ? Bm.To(y: 30, scale: 1.3) : Bm.To(y: -30, scale: 1))"
                             Transition="Bm.Tween(0.8, BmEase.InOut)">
                        <div class="box box-sm" />
                    </Bmotion>
                    <Bmotion Animate="@(_configOn ? Bm.To(y: -30, rotate: -90) : Bm.To(y: 30, rotate: 0))">
                        <div class="box box-sm" />
                    </Bmotion>
                </div>
            </div>
        </div>
    </BmotionConfig>

    <div class="bb-toolbar">
        <button class="btn btn-primary" @onclick="@(() => _configOn = !_configOn)">Animate</button>
        <div class="bb-segmented" role="group" aria-label="TransitionSpeed">
            @foreach (var speed in _speeds)
            {
                <button type="button" aria-pressed="@(Math.Abs(_speed - speed) < 0.001 ? "true" : "false")"
                        @onclick="@(() => _speed = speed)">@speed&times;</button>
            }
        </div>
    </div>

    <CodeSnippet Code="@_configCode" />
</section>

@code {
    private Bmotion _box = default!;
    private BmAnimationControls? _controls;
    private BmAnimationControls? _sequenceControls;
    private string _runState = "idle";
    private int _scrub;
    private string _scrubLabel = "";

    private double _count;

    private int _slider = 20;
    private readonly BmValue<double> _driver = Bm.Value(20.0);
    private BmValue<double>? _follower;
    private Dictionary<string, BmValue<double>> _directValues = default!;
    private Dictionary<string, BmValue<double>> _springValues = default!;
    private Dictionary<string, BmValue<double>> _rotateValues = default!;

    private bool _configOn;
    private double _speed = 1;
    private readonly double[] _speeds = [0.25, 1, 2];

    private bool _boxBig;
    private ElementReference _plainBox;
    private bool _promoNudged;
    private int _plainTurns;

    private IDisposable? _readoutSubscription;
    private long _lastReadout;

    protected override void OnInitialized()
    {
        // Built once: a dictionary rebuilt per render would re-subscribe the bindings each time.
        _directValues = new() { ["x"] = _driver.Transform([0, 100], [-60, 60]) };

        // A spring follower (motion.dev's useSpring) lags the source with physics instead of
        // tracking it exactly - the source is dragged, the follower catches up.
        _follower = Motion.Spring(_driver, Bm.Spring(stiffness: 120, damping: 14));
        _springValues = new() { ["x"] = _follower.Transform([0, 100], [-60, 60]) };

        _rotateValues = new() { ["rotate"] = _driver.Transform([0, 100], [0, 360]) };

        // The readout re-renders on the value's own changes - including the ones AnimateAsync makes,
        // which no event handler of this page sees - at most ten times a second.
        _readoutSubscription = _driver.Subscribe(v =>
        {
            _slider = (int)Math.Round(v);
            var now = Environment.TickCount64;
            if (now - _lastReadout < 100) return;
            _lastReadout = now;
            _ = InvokeAsync(StateHasChanged);
        });
    }

    private static string Fmt(double value, string format = "0")
        => value.ToString(format, System.Globalization.CultureInfo.InvariantCulture);

    private void OnSliderInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value) is false) return;
        _slider = value;
        _driver.SetSync(value);
    }

    private async Task SpringDriverAsync(double to)
    {
        await Motion.AnimateAsync(_driver, to, Bm.Spring(stiffness: 90, damping: 12));
        _slider = (int)Math.Round(_driver.Value);
    }

    private void JumpDriver(double to)
    {
        _driver.Jump(to);
        _slider = (int)to;
    }

    private Task NudgeByIdAsync()
    {
        _promoNudged = !_promoNudged;
        return Motion.AnimateAsync("#promo-card", Bm.To(x: _promoNudged ? 50 : 0, scale: _promoNudged ? 1.2 : 1),
            Bm.Spring(stiffness: 260, damping: 18)).AsTask();
    }

    private Task SpinReferenceAsync()
        => Motion.AnimateAsync(_plainBox, Bm.To(rotate: ++_plainTurns * 180), Bm.Spring(bounce: 0.3, duration: 0.7)).AsTask();

    private void ToggleScale()
    {
        _boxBig = !_boxBig;
        _box.Set(Bm.To(scale: _boxBig ? 1.4 : 1));
    }

    private async Task RunAsync()
    {
        _runState = "running…";
        _scrub = 0;
        _scrubLabel = "";
        var controls = await Motion.AnimateAsync(
            ".prog-dot",
            Bm.To(y: [0, -60, 0], scale: [1, 1.25, 1]),
            Bm.Tween(2.4, BmEase.InOut),
            stagger: Bm.Stagger(0.12));

        _controls = controls;
        await controls;

        // A Reset (or a second Run) while this one was still playing has already moved the
        // state on; only the run that is still current gets to report its own ending.
        if (ReferenceEquals(_controls, controls) is false) return;

        _runState = "finished";
        StateHasChanged();
    }

    // The slider holds the run where it is put: paused on the first touch, Play carries on from there.
    private void Scrub(ChangeEventArgs e)
    {
        if (_controls is null || int.TryParse(e.Value?.ToString(), out var value) is false) return;
        _scrub = value;
        if (_controls.State is BmPlaybackState.Running) _controls.Pause();
        _controls.Seek(value / 1000.0 * _controls.Duration);
        _scrubLabel = $"{_controls.Time:0.00} s of {_controls.Duration:0.00} s · {_controls.State}";
        _runState = "scrubbing";
    }

    private async Task ResetDotsAsync()
    {
        _scrub = 0;
        _scrubLabel = "";
        _controls?.Stop();
        _controls = null;
        _runState = "idle";
        await Motion.AnimateAsync(".prog-dot", Bm.To(y: 0, scale: 1), Bm.Tween(0.2));
    }

    private Task CountToAsync(double target)
        => Motion.AnimateAsync(_count, target, value =>
        {
            _count = value;
            StateHasChanged();
        }, Bm.Tween(1.4, BmEase.InOut));

    private async Task RunSequenceAsync()
    {
        var sequence = new BmSequence()
            .Add("#seq-box", Bm.To(x: 90), Bm.Tween(0.5, BmEase.InOut))
            .Add("#seq-box", Bm.To(rotate: 180), Bm.Tween(0.4), at: "-0.2")   // overlap the previous step
            .Label("burst")
            .Add(".seq-dot", Bm.To(scale: [1, 1.8, 1]), Bm.Spring(stiffness: 400, damping: 16), at: "burst")
            .Add("#seq-box", Bm.To(x: 0, rotate: 0), Bm.Spring(stiffness: 200, damping: 18), at: "+0.1");

        // Stop whatever a previous press left running so the two runs can't fight over the box.
        _sequenceControls?.Stop();
        _sequenceControls = await Motion.RunAsync(sequence);
        await _sequenceControls;
    }

    private async Task ResetSequenceAsync()
    {
        _sequenceControls?.Stop();
        _sequenceControls = null;
        await Motion.AnimateAsync("#seq-box", Bm.To(x: 0, rotate: 0), Bm.Tween(0.2));
        await Motion.AnimateAsync(".seq-dot", Bm.To(scale: 1), Bm.Tween(0.2));
    }

    private Task PulseAsync()
        => _box.AnimateAsync(Bm.To(scale: [1, 1.35, 1]), Bm.Spring(bounce: 0.5, duration: 0.6)).AsTask();

    public void Dispose()
    {
        _controls?.Stop();
        _sequenceControls?.Stop();
        _readoutSubscription?.Dispose();
        _follower?.Dispose();
    }

    private const string _selectorCode = """
        @inject BmotionAnimateService Motion

        <div class="dot-row">
            @for (var i = 0; i < 8; i++) { <div class="prog-dot"></div> }
        </div>

        @code {
            private BmAnimationControls? _controls;

            async Task RunAsync()
            {
                // Every match animates together; the stagger spreads their start times.
                _controls = await Motion.AnimateAsync(
                    ".prog-dot",
                    Bm.To(y: [0, -60, 0], scale: [1, 1.25, 1]),
                    Bm.Tween(2.4, BmEase.InOut),
                    stagger: Bm.Stagger(0.12));

                await _controls;   // the controls are directly awaitable
            }

            // …and hold the controls to interfere while it plays:
            void Pause()    => _controls?.Pause();
            void Faster()   => _controls?.SetSpeed(3);
            void JumpToEnd()=> _controls?.Complete();   // Stop() freezes it where it is instead

            // A scrubber: <input type="range" min="0" max="1000" @oninput="Scrub" />
            void Scrub(ChangeEventArgs e)
            {
                if (_controls is null) return;
                _controls.Pause();
                _controls.Seek(int.Parse(e.Value!.ToString()!) / 1000.0 * _controls.Duration);
            }
        }
        """;

    private const string _countCode = """
        @inject BmotionAnimateService Motion

        <span class="counter">@_count.ToString("N0")</span>

        @code {
            private double _count;

            // No DOM involved: the engine interpolates a bare double and hands you every
            // value on the way. The same call drives a canvas, an audio gain, anything.
            Task CountToAsync(double target)
                => Motion.AnimateAsync(_count, target, value =>
                {
                    _count = value;
                    StateHasChanged();
                }, Bm.Tween(1.4, BmEase.InOut));
        }
        """;

    private const string _sequenceCode = """
        @inject BmotionAnimateService Motion

        <div id="seq-box" class="box"></div>
        @for (var i = 0; i < 5; i++) { <div class="seq-dot"></div> }

        @code {
            async Task RunSequenceAsync()
            {
                var sequence = new BmSequence()
                    .Add("#seq-box", Bm.To(x: 90), Bm.Tween(0.5, BmEase.InOut))

                    // "-0.2" starts 0.2s BEFORE the previous step ends, so the two overlap.
                    // "+0.2" would leave a gap; "<" aligns with the previous step's start.
                    .Add("#seq-box", Bm.To(rotate: 180), Bm.Tween(0.4), at: "-0.2")

                    // A label marks a position any number of later steps can share.
                    .Label("burst")
                    .Add(".seq-dot", Bm.To(scale: [1, 1.8, 1]),
                         Bm.Spring(stiffness: 400, damping: 16), at: "burst")

                    .Add("#seq-box", Bm.To(x: 0, rotate: 0),
                         Bm.Spring(stiffness: 200, damping: 18), at: "+0.1");

                // RunAsync returns the same controls a single animation does - and because the
                // whole timeline runs on one playhead, they govern the gaps between the steps
                // as well as the steps themselves.
                _controls = await Motion.RunAsync(sequence);
                await _controls;
            }

            void Hold()   => _controls?.Pause();       // the timeline genuinely stops here
            void Resume() => _controls?.Play();
            void Faster() => _controls?.SetSpeed(3);   // steps AND gaps compress by 3x

            private BmAnimationControls? _controls;
        }
        """;

    private const string _valuesCode = """
        @using Bit.Bmotion
        @inject BmotionAnimateService Motion
        @implements IDisposable

        <input type="range" min="0" max="100" @bind:get="_slider" @bind:set="OnSlider" @bind:event="oninput" />

        <Bmotion Values="_directValues"><div class="box" /></Bmotion>
        <Bmotion Values="_springValues"><div class="box" /></Bmotion>
        <Bmotion Values="_rotateValues"><div class="box" /></Bmotion>

        @code {
            // One source of truth; everything else is derived from it.
            private readonly BmValue<double> _driver = Bm.Value(20.0);
            private BmValue<double>? _follower;
            private int _slider = 20;

            private Dictionary<string, BmValue<double>> _directValues = default!;
            private Dictionary<string, BmValue<double>> _springValues = default!;
            private Dictionary<string, BmValue<double>> _rotateValues = default!;

            protected override void OnInitialized()
            {
                // Transform maps one range onto another, and updates in lockstep.
                _directValues = new() { ["x"] = _driver.Transform([0, 100], [-60, 60]) };

                // A spring follower lags the source with physics rather than tracking it.
                _follower = Motion.Spring(_driver, Bm.Spring(stiffness: 120, damping: 14));
                _springValues = new() { ["x"] = _follower.Transform([0, 100], [-60, 60]) };

                _rotateValues = new() { ["rotate"] = _driver.Transform([0, 100], [0, 360]) };
            }

            // Setting the source flushes every dependent binding to the DOM next frame -
            // with no re-render of this component at all.
            void OnSlider(int value)
            {
                _slider = value;
                _driver.SetSync(value);
            }

            // Or animate the value itself - every binding follows, and a spring starts from the
            // value's own velocity. Jump teleports it with no velocity at all.
            Task SpringTo(double to) => Motion.AnimateAsync(_driver, to, Bm.Spring(stiffness: 90, damping: 12));
            void JumpTo(double to) => _driver.Jump(to);

            // Subscribe to read it back; the handle unsubscribes when disposed.
            //   IDisposable sub = _driver.Subscribe(v => Console.WriteLine(v));
            //
            // And the plain maths behind it all, for one-off numbers:
            //   Bm.MapRange(v, [0, 100], [0, 1])   Bm.Clamp(25, 75, v)
            //   Bm.Wrap(0, 40, v)                  Bm.Mix(-60, 60, 0.5)

            // The follower runs its spring until it is disposed.
            public void Dispose() => _follower?.Dispose();
        }
        """;

    private const string _targetingCode = """
        @using Bit.Bmotion
        @inject BmotionAnimateService Motion

        @* A stable Id replaces the generated one, so "#promo-card" reaches it - from code or CSS. *@
        <Bmotion Id="promo-card" Animate="Bm.To(scale: 1)">
            <div class="box" />
        </Bmotion>

        @* No Bmotion at all: a plain element, captured with @ref. *@
        <div class="box" @ref="_plain"></div>

        <button @onclick="NudgeAsync">Animate "#promo-card"</button>
        <button @onclick="SpinAsync">Animate the reference</button>

        @code {
            private ElementReference _plain;
            private int _turns;

            // Both return BmAnimationControls, like a selector that matches many.
            Task NudgeAsync() => Motion.AnimateAsync("#promo-card", Bm.To(x: 50, scale: 1.2),
                                                     Bm.Spring(stiffness: 260, damping: 18)).AsTask();

            Task SpinAsync() => Motion.AnimateAsync(_plain, Bm.To(rotate: ++_turns * 180),
                                                    Bm.Spring(bounce: 0.3, duration: 0.7)).AsTask();
        }
        """;

    private const string _refCode = """
        @using Bit.Bmotion

        <Bmotion @ref="_box"
                 Animate="Bm.To(rotate: 360)"
                 Transition="Bm.Tween(4, BmEase.Linear, repeat: BmRepeat.Forever)">
            <div class="box" />
        </Bmotion>

        @code {
            private Bmotion _box = default!;

            void Pause()  => _box.Pause();                 // playback rate 0
            void Resume() => _box.Resume();
            void Faster() => _box.SetPlaybackRate(4);
            void Freeze() => _box.Stop();                  // everything it is animating
            void Halt()   => _box.Stop("rotate");          // only the properties named
            void Jump()   => _box.Set(Bm.To(scale: 1.4));  // apply instantly, no animation
            Task JumpNow() => _box.SetAsync(Bm.To(scale: 1.4)).AsTask();   // ...and written before it returns

            // A one-off target that plays over whatever is already running.
            Task PulseAsync()
                => _box.AnimateAsync(Bm.To(scale: [1, 1.35, 1]),
                                     Bm.Spring(bounce: 0.5, duration: 0.6)).AsTask();
        }
        """;

    private const string _configCode = """
        @using Bit.Bmotion

        @* Cascades to every Bmotion beneath it. TransitionSpeed is a playback multiplier:
           0.25 is the slow-motion switch for tuning, 0 makes everything instant. *@
        <BmotionConfig Transition="Bm.Spring(stiffness: 180, damping: 16)"
                       TransitionSpeed="0.25"
                       ColorSpace="BmColorSpace.Oklab"
                       ReduceMotion="null">
            ...
        </BmotionConfig>

        @* ReduceMotion: null follows the OS prefers-reduced-motion setting, true always
           reduces, false always animates. Honouring the preference is scoped to this
           component on purpose - an element with no BmotionConfig above it always animates,
           so the library never silently disables motion an app did not opt into.

           For an app-wide policy, set it at registration instead:
           builder.Services.AddBitBmotionServices(o => o.ReducedMotion = BmReducedMotionMode.User); *@
        """;
}
