<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- One Blazor Web App that serves the harness pages (which live in the .Client project) in any render
         mode, chosen at startup with BmotionHarness:Mode (see HarnessRenderModes), with the library's global
         options chosen by BmotionHarness:Prerender / :ReducedMotion / :CssSafeMode (see HarnessOptions). A
         single host for every mode keeps the Program.cs and App.razor under test identical across modes, so a
         failure that shows up in one mode belongs to the mode and not to a difference between two hosts.
         Multi-targeted because the library is: the suite can run the harness on every runtime Bit.Bmotion
         ships for. -->

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(BmotionHarnessFramework)' != ''">$(BmotionHarnessFramework)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <RootNamespace>BmotionTests.Harness.Web</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.32" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.21" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Bmotion.Tests.Harness.Web.Client\Bit.Bmotion.Tests.Harness.Web.Client.csproj" />
    </ItemGroup>

</Project>
