@page "/reorder"

@* BmotionReorderGroup: a vertical list, a horizontal one, and one that only drags by its grip. The committed
   order of each is published to a readout. *@

<HarnessHeader Title="Reorder" Ready="Ready" OnLog="BindLog" />

<div class="list" id="vertical">
    <BmotionReorderGroup @bind-Items="_vertical" Context="item" OnReorder='() => Committed(_vertical, _verticalOrder, "vertical")'>
        <div class="item" data-item="@item">@item</div>
    </BmotionReorderGroup>
</div>
<Readout @ref="_verticalOrder" Id="vertical-order" Initial="A,B,C,D" />

<div class="hlist" id="horizontal">
    <BmotionReorderGroup @bind-Items="_horizontal" Axis="BmDragAxis.X" Context="item" OnReorder='() => Committed(_horizontal, _horizontalOrder, "horizontal")'>
        <div class="item" data-item="@item">@item</div>
    </BmotionReorderGroup>
</div>
<Readout @ref="_horizontalOrder" Id="horizontal-order" Initial="1,2,3" />

<div class="list" id="handled">
    <BmotionReorderGroup @bind-Items="_handled" HandleSelector=".grip" Context="item" OnReorder='() => Committed(_handled, _handledOrder, "handled")'>
        <div class="item" data-item="@item"><span class="grip"></span>&nbsp;@item</div>
    </BmotionReorderGroup>
</div>
<Readout @ref="_handledOrder" Id="handled-order" Initial="X,Y,Z" />

@* A wrapping grid: 3 columns of 60x40 cells, 4px apart. *@
<div class="reorder-grid" id="grid">
    <BmotionReorderGroup @bind-Items="_grid" Axis="BmDragAxis.Both" Context="item" OnReorder='() => Committed(_grid, _gridOrder, "grid")'>
        <div class="cell" data-item="@item">@item</div>
    </BmotionReorderGroup>
</div>
<Readout @ref="_gridOrder" Id="grid-order" Initial="1,2,3,4,5,6" />

@* A list longer than its scroller: ten 40px rows, 4px apart, in a box 150px tall. *@
<div class="scroll-list" id="scrolling">
    <BmotionReorderGroup @bind-Items="_scrolling" Context="item" OnReorder='() => Committed(_scrolling, _scrollingOrder, "scrolling")'>
        <div class="item" data-item="@item">@item</div>
    </BmotionReorderGroup>
</div>
<Readout @ref="_scrollingOrder" Id="scrolling-order" Initial="R0,R1,R2,R3,R4,R5,R6,R7,R8,R9" />

@* A new order for the vertical list from outside its group, the way move-up / move-down buttons make one: the
   bound list mutated in place. Last on the page, so it moves none of the lists above. *@
<button id="vertical-rotate" @onclick="() => Change(RotateVertical)">last to first</button>

@code {
    private List<string> _grid = ["1", "2", "3", "4", "5", "6"];
    private Readout _gridOrder = default!;
    private List<string> _scrolling = [.. Enumerable.Range(0, 10).Select(i => $"R{i}")];
    private Readout _scrollingOrder = default!;
    private List<string> _vertical = ["A", "B", "C", "D"];
    private List<string> _horizontal = ["1", "2", "3"];
    private List<string> _handled = ["X", "Y", "Z"];
    private Readout _verticalOrder = default!;
    private Readout _horizontalOrder = default!;
    private Readout _handledOrder = default!;

    private void RotateVertical()
    {
        var last = _vertical[^1];
        _vertical.RemoveAt(_vertical.Count - 1);
        _vertical.Insert(0, last);
        _verticalOrder.Set(string.Join(",", _vertical));
    }

    private void Committed(List<string> items, Readout readout, string name)
    {
        readout.Set(string.Join(",", items));
        Log($"{name}:reordered");
        // As an app would: the bound list changed, so the page renders it.
        StateHasChanged();
    }
}
