<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF" />
    <base href="/" />
    <ResourcePreloader />
    @* The library's stylesheet plays the enter animations prerendered with BmPrerenderMode.Animate (see
       AddCoreServices) from the served HTML, before the runtime has started; without it those elements are served at
       rest. app.css comes after it, so the samples' own rules win. *@
    <link rel="stylesheet" href="@Assets["_content/Bit.Bmotion/bit-bmotion.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Bit.Bmotion.Samples.Core/app.css"]" />
    <link rel="icon" type="image/svg+xml" href="_content/Bit.Bmotion.Samples.Core/favicon.svg" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
    @* No tag for bit-bmotion.js: the library imports it itself the first time an animation runs. *@
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Interactive everywhere except the error page, which renders statically.
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveAuto : null;
}
