@page "/programmatic"
@inject BmotionAnimateService Motion
@inject BmotionCapabilities Capabilities
@implements IDisposable

<PageTitle>Programmatic · Bmotion samples</PageTitle>

<h1>Programmatic</h1>

<p>
    Not every animation is a state to describe. <code>BmotionAnimateService</code> animates elements by CSS selector or
    <code>ElementReference</code>, with no <code>&lt;Bmotion&gt;</code> around them, and hands back controls to hold on to:
    awaitable, and able to pause, speed up, finish and seek what is playing.
</p>

<section>
    <h2>By selector, with controls</h2>
    <p>
        One call animates every element <code>.prog-dot</code> matches, a stagger apart. Interfere with it while it
        plays; the slider seeks it, holding it wherever it is put until Play.
    </p>

    <div class="stage dots">
        @for (var i = 0; i < 8; i++)
        {
            <span class="prog-dot"></span>
        }
    </div>

    <div class="toolbar">
        <button type="button" id="run" @onclick="RunAsync">Run</button>
        <button type="button" disabled="@(_controls is null)" @onclick="() => _controls?.Pause()">Pause</button>
        <button type="button" disabled="@(_controls is null)" @onclick="() => _controls?.Play()">Play</button>
        <button type="button" disabled="@(_controls is null)" @onclick="() => _controls?.SetSpeed(3)">3× speed</button>
        <button type="button" disabled="@(_controls is null)" @onclick="() => _controls?.Complete()">Complete</button>
        <span class="muted" id="run-state">@_runState</span>
    </div>

    <div class="toolbar">
        <label for="scrub">Seek</label>
        <input id="scrub" type="range" min="0" max="1000" value="@_scrub" disabled="@(_controls is null)" @oninput="Seek" />
        <span class="muted">@_seekLabel</span>
    </div>
</section>

<section>
    <h2>A sequence</h2>
    <p>
        A <code>BmSequence</code> is a timeline: each step names its own target, and <code>at</code> places it -
        <code>"-0.2"</code> overlaps the step before, and a label lets several later steps start together. The whole
        timeline has one playhead, so Pause holds the gaps between steps as well as the steps. @SequenceNote
    </p>

    <div class="stage seq-stage">
        <div id="seq-box" class="seq-box"></div>
        <div class="seq-dots">
            @for (var i = 0; i < 5; i++)
            {
                <span class="seq-dot"></span>
            }
        </div>
    </div>

    <div class="toolbar">
        <button type="button" id="play-sequence" @onclick="PlaySequenceAsync">Play</button>
        <button type="button" disabled="@(_sequence is null)" @onclick="() => _sequence?.Pause()">Pause</button>
        <button type="button" disabled="@(_sequence is null)" @onclick="() => _sequence?.Play()">Resume</button>
    </div>
</section>

<section>
    <h2>What needs the per-frame loop</h2>
    <p>
        Two things the browser cannot play on the engine's behalf: a number that lives in C#, animated by
        <code>AnimateAsync(from, to, onUpdate)</code>, and an SVG path whose <code>d</code> morphs into another. Both are
        stepped in C# once a frame, so where there is no frame loop they land on their target at once. @LoopNote
    </p>

    <div class="loop-row">
        <div class="stage stack">
            <span class="counter" id="counter">@_count.ToString("N0", CultureInfo.InvariantCulture)</span>
            <button type="button" id="count" @onclick="CountAsync">Count @(_counted ? "down" : "up")</button>
        </div>

        <div class="stage stack">
            <svg viewBox="0 0 200 200" width="140" height="140" aria-hidden="true">
                <Bmotion Animate="@(_morphed ? BlobB : BlobA)" Transition="Bm.Spring(bounce: 0.35, duration: 0.8)">
                    <path class="blob" d="@BlobAPath" />
                </Bmotion>
            </svg>
            <button type="button" id="morph" @onclick="() => _morphed = !_morphed">Morph</button>
        </div>
    </div>
</section>

@code {
    // Two shapes with the same commands - a move and four cubic curves - so every point has one to travel to.
    private const string BlobAPath = "M100 30 C140 30 170 60 170 100 C170 140 140 170 100 170 C60 170 30 140 30 100 C30 60 60 30 100 30";
    private const string BlobBPath = "M100 50 C130 20 180 70 150 100 C180 130 130 180 100 150 C70 180 20 130 50 100 C20 70 70 20 100 50";
    private static readonly BmProps BlobA = Bm.To(d: BlobAPath);
    private static readonly BmProps BlobB = Bm.To(d: BlobBPath);

    private BmAnimationControls? _controls;
    private string _runState = "idle";
    private int _scrub;
    private string _seekLabel = "";

    private BmAnimationControls? _sequence;

    private double _count;
    private bool _counted;
    private bool _morphed;

    private bool HasNoFrameLoop => Capabilities.IsPrerendering is false && Capabilities.SupportsFrameLoop is false;

    private string SequenceNote => HasNoFrameLoop
        ? "On this host there is no frame loop, so the gaps run on wall-clock timers instead and keep going while it is paused."
        : "";

    private string LoopNote => Capabilities.IsPrerendering
        ? ""
        : Capabilities.SupportsFrameLoop
            ? "This host has one: both animate."
            : "This host has none: both land at once, while every other animation on these pages still plays.";

    private async Task RunAsync()
    {
        _controls?.Stop();
        _runState = "running";
        _scrub = 0;
        _seekLabel = "";

        var controls = await Motion.AnimateAsync(
            ".prog-dot",
            Bm.To(y: [0, -48, 0], scale: [1, 1.3, 1]),
            Bm.Tween(2.4, BmEase.InOut),
            stagger: Bm.Stagger(0.12));

        _controls = controls;
        await controls;

        // A second Run while this one was playing has replaced it; only the current run reports its ending.
        if (ReferenceEquals(_controls, controls) is false) return;

        _runState = controls.State.ToString().ToLowerInvariant();
    }

    private void Seek(ChangeEventArgs e)
    {
        if (_controls is null || int.TryParse(e.Value?.ToString(), out var value) is false) return;

        _scrub = value;
        if (_controls.State is BmPlaybackState.Running) _controls.Pause();
        _controls.Seek(value / 1000.0 * _controls.Duration);
        _runState = "seeking";
        _seekLabel = $"{_controls.Time.ToString("0.00", CultureInfo.InvariantCulture)} s of {_controls.Duration.ToString("0.00", CultureInfo.InvariantCulture)} s";
    }

    private async Task PlaySequenceAsync()
    {
        var sequence = new BmSequence()
            .Add("#seq-box", Bm.To(x: 120), Bm.Tween(0.5, BmEase.InOut))
            .Add("#seq-box", Bm.To(rotate: 180), Bm.Tween(0.4), at: "-0.2")
            .Label("burst")
            .Add(".seq-dot", Bm.To(scale: [1, 1.8, 1]), Bm.Spring(stiffness: 400, damping: 16), at: "burst")
            .Add("#seq-box", Bm.To(x: 0, rotate: 0), Bm.Spring(stiffness: 200, damping: 18), at: "+0.2");

        // Stop what a previous press left playing, so the two runs don't fight over the box.
        _sequence?.Stop();
        _sequence = await Motion.RunAsync(sequence);
    }

    private Task CountAsync()
    {
        _counted = _counted is false;

        return Motion.AnimateAsync(_count, _counted ? 2_450 : 0, value =>
        {
            _count = value;
            StateHasChanged();
        }, Bm.Tween(1.4, BmEase.InOut));
    }

    public void Dispose()
    {
        _controls?.Stop();
        _sequence?.Stop();
    }
}
