@inject BmotionScrollTracker Scroll
@implements IAsyncDisposable

@* The scroll position as a number in C#, for when it is needed there rather than on an element. Every scroll event
   crosses to .NET - over the circuit on Server - and the count says how many have. A component of its own, so each
   one re-renders this readout, not the page around it. *@
<div class="scroll-readout" aria-live="off">
    <span>BmotionScrollTracker: <strong id="scroll-progress">@_progress.ToString("P0", CultureInfo.InvariantCulture)</strong> scrolled</span>
    <span class="muted"><span id="scroll-callbacks">@_callbacks</span> callbacks</span>
</div>

@code {
    private double _progress;
    private int _callbacks;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender is false) return;

        await Scroll.ObserveAsync(info =>
        {
            _progress = info.ProgressY;
            _callbacks++;
            return InvokeAsync(StateHasChanged);
        });
    }

    // The tracker is transient: this component owns it, and stops observing by disposing it.
    public ValueTask DisposeAsync() => Scroll.DisposeAsync();
}
