<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>Bit.Borm</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- UseFluentValidation() resolves IValidator<T> for a model type only known at run time. -->
        <IsAotCompatible>false</IsAotCompatible>
        <Description>FluentValidation integration for Bit.Borm. UseFluentValidation() runs a model's FluentValidation validator alongside the schema's own rules and puts every failure on the field its property path names.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>Bit;Blazor;Forms;Validation;FluentValidation</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Borm\Bit.Borm.csproj" />
    </ItemGroup>

</Project>
