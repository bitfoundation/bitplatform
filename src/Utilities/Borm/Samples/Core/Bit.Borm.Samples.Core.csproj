<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The pages every hosting sample (Server, WebAssembly, Auto, MAUI) renders. Nothing in here knows which host it
         runs in, so running the same pages in each one shows Borm's forms in every hosting model. -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
        <ProjectReference Include="..\..\Bit.Borm\Bit.Borm.csproj" />
    </ItemGroup>

</Project>
