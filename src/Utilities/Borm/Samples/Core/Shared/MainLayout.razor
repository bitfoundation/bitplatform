@inherits LayoutComponentBase

<nav class="topbar">
    <NavLink href="" Match="NavLinkMatch.All" class="brand">Borm samples</NavLink>
    <NavLink href="generated">From a type</NavLink>
    <NavLink href="builder">Builder</NavLink>
    <NavLink href="wizard">Wizard</NavLink>
    <NavLink href="json-schema">JSON Schema</NavLink>
    @* Not in the MAUI app: its router only runs interactive, so it has no route to a page excluded from that. *@
    @if (RendererInfo.Name is not "WebView")
    {
        <NavLink href="static-form">Static form</NavLink>
    }
    @* Which renderer produced this markup: Static while prerendering, then Server, WebAssembly or WebView. A page with
       no render mode - the static form and the error page - stays Static, and is not prerendered: it never becomes
       interactive. *@
    <span class="renderer" data-renderer="@RendererInfo.Name" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
        @RendererInfo.Name@(RendererInfo.IsInteractive || AssignedRenderMode is null ? null : " (prerendered)")
    </span>
</nav>

<main>
    @Body
</main>
