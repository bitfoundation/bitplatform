@namespace Bit.Borm
@implements IDisposable

@* disabled only when the repeater is disabled, never because it is read-only. A disabled fieldset
   disables every control inside it, so a read-only repeater — a review screen, a ReadOnlyWhen on a sent
   invoice — took every row's fields out of the tab order and out of the screen reader's reach, which
   is precisely what read-only exists not to do. Its row and add buttons are locked one by one instead.
   The id is what an error-summary link to a message about the list as a whole lands on. *@
@* tabindex="-1" so a message about the list as a whole — "add at least one line" — has somewhere for
   the error summary's link, and focus-the-first-error, to put focus: on the group, where the legend and
   the message are read out together. *@
<fieldset class="bit-borm-array" id="@ElementId" disabled="@State.IsDisabled(Field, Path)" aria-describedby="@DescribedBy"
          tabindex="-1" @ref="_fieldset">
    <legend class="bit-borm-array__header">
        <span class="bit-borm-array__title">@Title</span>
        @if (State.IsRequired(Field, Path))
        {
            <span class="bit-borm-required" aria-hidden="true">*</span>
        }
        @if (Count > 0)
        {
            <span class="bit-borm-array__count">@Count</span>
        }
    </legend>

    @if (State.HelpOf(Field, Path) is { Length: > 0 } help)
    {
        <p class="bit-borm-help" id="@HelpId">@help</p>
    }

    @if (Count == 0)
    {
        <p class="bit-borm-array__empty">@EmptyText</p>
    }

    @* One live region for the whole repeater, announcing the count after an add or a remove, where the
       moved row landed after a reorder, and that the list is empty once the last row goes. Without it a
       screen-reader user presses "Add" and hears nothing at all. *@
    <p class="bit-borm-sr-only" aria-live="polite">@Announcement</p>

    @{ var first = First; var keys = BuildKeys(first, End); }
    @for (var index = first; index < first + keys.Length; index++)
    {
        var i = index;
        var itemPath = BormPath.Combine(Path, i);
        @* Keyed by the item instance where possible so reordering moves the DOM node with its data
           instead of rewriting every row's contents. *@
        @* A named group, not a bare div. Every row repeats the same labels, so without one a screen
           reader announces "Product, edit" five times over with nothing to say which line is which —
           and the visible row number beside it is decorative. *@
        @* The row's id is what an error-summary link to a message about the row lands on. Only a row of
           an object has one: a row of a single value is that value's control, which already carries it. *@
        <div class="bit-borm-array__item" @key="keys[i - first]" id="@(Template.Type == BormFieldType.Object ? $"{ElementId}_{i}" : null)" role="group" aria-label="@State.Text(BormMessageKeys.ArrayItemGroup, ItemNoun, i + 1)"
             aria-describedby="@RowDescribedBy(itemPath, i)">
            <div class="bit-borm-array__item-body">
                <span class="bit-borm-array__item-index" aria-hidden="true">@(i + 1)</span>
                @if (Template.Type == BormFieldType.Object)
                {
                    <BormFieldList State="State" Items="RowItems(itemPath)" />
                    @* A message about the row as a whole — "this line duplicates line 2" — belongs to none
                       of its fields. It used to be recorded and never drawn. A row of a single value
                       needs nothing here: that value's own field shows it. *@
                    <BormValidationMessages Messages="State.MessagesFor(itemPath)" Show="RowShowsMessages(itemPath)" Id="@RowErrorId(i)" Language="@State.Language" />
                }
                else
                {
                    <BormFieldView State="State" Field="Template" Path="@itemPath" />
                }
            </div>
            @* Posted with no interactivity, a row cannot be added, moved or removed: the rows are shown as they stand. *@
            @if (!State.RendersStatically)
            {
            <div class="bit-borm-array__item-actions">
                @{
                    var moveUp = State.Text(BormMessageKeys.ArrayMoveUp, ItemNoun, i + 1);
                    var moveDown = State.Text(BormMessageKeys.ArrayMoveDown, ItemNoun, i + 1);
                    var duplicate = State.Text(BormMessageKeys.ArrayDuplicate, ItemNoun, i + 1);
                    var remove = State.Text(BormMessageKeys.ArrayRemove, ItemNoun, i + 1);
                }
                @if (Reorderable)
                {
                    @* aria-disabled, not disabled, at the ends. A `disabled` button leaves the tab order,
                       so moving a row to the top would take the focus of the very button that moved it
                       there and drop it on the page body — mid-reorder, which is exactly when a keyboard
                       user can least afford to lose their place. The click is guarded instead. A locked
                       repeater is different: nothing is moving, so the buttons are plainly disabled. *@
                    <button type="button" class="bit-borm-btn bit-borm-btn--icon" title="@moveUp" aria-label="@moveUp" disabled="@Locked"
                            aria-disabled="@(i == 0 ? "true" : null)" @onclick="@(() => Move(i, i - 1))">↑</button>
                    <button type="button" class="bit-borm-btn bit-borm-btn--icon" title="@moveDown" aria-label="@moveDown" disabled="@Locked"
                            aria-disabled="@(i == Count - 1 ? "true" : null)" @onclick="@(() => Move(i, i + 1))">↓</button>
                }
                @if (Duplicable)
                {
                    <button type="button" class="bit-borm-btn bit-borm-btn--icon" title="@duplicate" aria-label="@duplicate"
                            disabled="@(!CanAdd)" @onclick="@(() => Duplicate(i))">⧉</button>
                }
                @* Short visible text, full accessible name: a screen reader needs to know *which* row
                   the button removes, a sighted user can see it. *@
                <button type="button" class="bit-borm-btn bit-borm-btn--danger" title="@remove" aria-label="@remove"
                        disabled="@(!CanRemove)" @onclick="@(() => Remove(i))">@RemoveText</button>
            </div>
            }
        </div>
    }

    @if (Paged)
    {
        @* A page is always whole, so every row on it is reachable; the rows on other pages are reached through
           the pager, and through anything that focuses one of them - the error summary's links, focus-the-first-
           error - which turns to the row's page first. Rows on other pages that need attention are counted
           here, with a way to the first of them, so a problem is never out of sight and out of mind. *@
        <nav class="bit-borm-array__pager" aria-label="@State.Text(BormMessageKeys.ArrayPages, Title)">
            @* aria-disabled rather than disabled at the ends, as the move buttons are: a disabled button drops the focus
               of the user who pressed it to the page body, and TurnTo already ignores a page past either end. *@
            <button type="button" class="bit-borm-btn bit-borm-btn--sm" aria-disabled="@(_page == 0 ? "true" : null)" @onclick="() => TurnTo(_page - 1)">
                @State.Text(BormMessageKeys.ArrayPreviousPage)
            </button>
            <label class="bit-borm-array__page">
                <span class="bit-borm-sr-only">@State.Text(BormMessageKeys.ArrayPage, _page + 1, PageCount)</span>
                @* The value, not only each option's selected attribute: once the user has picked a page a browser no longer
                   follows the attribute, and the box went on showing that page while the buttons turned others. *@
                <select class="bit-borm-input" value="@_page" @onchange="OnPagePicked">
                    @for (var p = 0; p < PageCount; p++)
                    {
                        var number = p;
                        <option value="@number" selected="@(number == _page)">@(number + 1)</option>
                    }
                </select>
            </label>
            <button type="button" class="bit-borm-btn bit-borm-btn--sm" aria-disabled="@(_page >= PageCount - 1 ? "true" : null)" @onclick="() => TurnTo(_page + 1)">
                @State.Text(BormMessageKeys.ArrayNextPage)
            </button>
            <span class="bit-borm-array__range" aria-live="polite">@State.Text(BormMessageKeys.ArrayRange, First + 1, End, Count)</span>
            @if (RowsElsewhereNeedingAttention() is { Count: > 0 } elsewhere)
            {
                <span class="bit-borm-array__elsewhere">
                    @State.Text(BormMessageKeys.ArrayElsewhere, elsewhere.Count, ItemNoun)
                    <button type="button" class="bit-borm-btn bit-borm-btn--ghost bit-borm-btn--sm" @onclick="() => ShowRow(elsewhere[0])">
                        @State.Text(BormMessageKeys.ArrayShowElsewhere)
                    </button>
                </span>
            }
        </nav>
    }

    @if (!State.RendersStatically)
    {
    <button type="button" class="bit-borm-btn bit-borm-btn--add" @ref="_addButton" disabled="@(!CanAdd)" @onclick="Add">
        @State.Text(BormMessageKeys.ArrayAdd, ItemNoun)
    </button>
    }

    <BormValidationMessages Messages="State.MessagesFor(Path)" Show="ShowMessages" Id="@ErrorId" Language="@State.Language" />
</fieldset>

@code {
    [Parameter, EditorRequired] public BormState State { get; set; } = default!;
    [Parameter, EditorRequired] public BormFieldDefinition Field { get; set; } = default!;
    [Parameter, EditorRequired] public string Path { get; set; } = default!;

    private BormFieldDefinition Template => Field.ItemTemplate
        ?? throw new InvalidOperationException(
            $"Array field '{Field.Name}' has no item template. Set {nameof(BormFieldDefinition.ItemTemplate)} " +
            "or build the field with the fluent builder's Array(...) overload, which creates one for you.");

    private int Count => State.ArrayCount(Path);

    private string Title => State.LabelOf(Field, Path) ?? Field.Name;

    private string ItemNoun => Field.Attributes.TryGetValue("itemNoun", out var n) && n is string s && s.Length > 0
        ? s
        : State.Text(BormMessageKeys.ArrayItem);

    private string EmptyText => Field.Attributes.TryGetValue("emptyText", out var t) && t is string s && s.Length > 0
        ? s
        : State.Text(BormMessageKeys.ArrayEmpty, ItemNoun);

    private string RemoveText => State.Text(BormMessageKeys.ArrayRemoveShort);

    /// <summary>Whether the up/down buttons are offered — <c>Attr("reorderable", false)</c> hides them.</summary>
    private bool Reorderable => Field.Attributes.TryGetValue("reorderable", out var r) ? r is not false : true;

    /// <summary>Whether a "duplicate this row" button is offered — <c>Attr("duplicable", true)</c>.</summary>
    private bool Duplicable => Field.Attributes.TryGetValue("duplicable", out var d) && d is true;

    /// <summary>
    /// What the live region says. It changes with the count, which is what makes the region announce;
    /// an identical string would be ignored by every screen reader. A reorder leaves the count where it
    /// was, and emptying the list leaves nothing to count, so those two say something of their own —
    /// for as long as the count they were said at still stands.
    /// </summary>
    private string Announcement
    {
        get
        {
            if (_said is not null && _saidAtCount == Count) return _said;
            return Count == 0 ? "" : State.Text(BormMessageKeys.ArrayCount, Count, ItemNoun);
        }
    }

    private string? _said;
    private int _saidAtCount = -1;

    private const char NonBreakingSpace = (char)0xA0;

    /// <summary>
    /// Puts <paramref name="text"/> in the live region. A repeat of what is already there is made to
    /// differ by a trailing non-breaking space, because moving a second row into the same place is news
    /// too, and an unchanged region is never read out.
    /// </summary>
    private void Say(string text)
    {
        var current = Announcement;
        _said = string.Equals(text, current, StringComparison.Ordinal) ? text + NonBreakingSpace : text;
        _saidAtCount = Count;
    }

    /// <summary>Whether messages about one row as a whole are showing yet.</summary>
    private bool RowShowsMessages(string itemPath) => State.IsTouched(itemPath) || State.IsSubmitted;

    /// <summary>Id of a row's own message list — the id a field context for the row's path would give it.</summary>
    private string RowErrorId(int index) => $"{ElementId}_{index}_error";

    /// <summary>The row group's description: its own messages, when it has any showing.</summary>
    private string? RowDescribedBy(string itemPath, int index)
        => Template.Type == BormFieldType.Object && RowShowsMessages(itemPath) && State.MessagesFor(itemPath).Count > 0
            ? RowErrorId(index)
            : null;

    /// <summary>
    /// Read-only or conditionally-disabled arrays cannot be added to, removed from or reordered. Only a
    /// disabled one disables its fields as well; a read-only one leaves them to be read.
    /// </summary>
    private bool Locked => State.IsDisabled(Field, Path) || _context.IsReadOnly;

    private bool CanAdd => !Locked && State.CanAddArrayItem(Field, Path);

    private bool CanRemove => !Locked && State.CanRemoveArrayItem(Field, Path);

    private bool ShowMessages => State.IsTouched(Path) || State.IsSubmitted;

    private string HelpId => ElementId + "_help";
    private string ErrorId => ElementId + "_error";

    // Derived once per (field, path) rather than per access: it is read several times each render.
    private BormFieldContext _context = default!;
    private string ElementId => _context.ElementId;

    protected override void OnParametersSet()
    {
        if (_context is null || !ReferenceEquals(_context.Field, Field) || _context.Path != Path
            || !ReferenceEquals(_context.State, State)
            || _context.IdPrefix != BormFieldContext.SafePrefix(State.IdPrefix))
            _context = new BormFieldContext(State, Field, Path);

        // The list's own path has no control of its own; the group stands in for it (see the fieldset).
        if (_focusRegistration is null || _registeredPath != Path || !ReferenceEquals(_registeredState, State))
        {
            _focusRegistration?.Dispose();
            _registeredPath = Path;
            _registeredState = State;
            _focusRegistration = State.RegisterFocusTarget(Path, FocusGroupAsync);
            _revealRegistration?.Dispose();
            _revealRegistration = State.RegisterRowRevealer(Path, RevealRowAsync);
        }

        // Rows taken away under the page the user was on - removed, or the list emptied by an undo - leave the
        // last page showing rather than one past the end.
        _page = Math.Clamp(_page, 0, PageCount - 1);
    }

    private ElementReference _fieldset;
    private IDisposable? _focusRegistration;
    private string? _registeredPath;
    private BormState? _registeredState;

    private async ValueTask<bool> FocusGroupAsync()
    {
        try
        {
            await _fieldset.FocusAsync();
            return true;
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException or ObjectDisposedException)
        {
            return false;
        }
    }

    public void Dispose()
    {
        _focusRegistration?.Dispose();
        _focusRegistration = null;
        _revealRegistration?.Dispose();
        _revealRegistration = null;
        _rendered?.TrySetResult();
    }

    private string? DescribedBy
    {
        get
        {
            var hasHelp = !string.IsNullOrEmpty(State.HelpOf(Field, Path));
            var hasErrors = ShowMessages && State.MessagesFor(Path).Count > 0;
            return (hasHelp, hasErrors) switch
            {
                (true, true) => $"{HelpId} {ErrorId}",
                (true, false) => HelpId,
                (false, true) => ErrorId,
                _ => null
            };
        }
    }

    /// <summary>The fields of one row, each with the path it binds to.</summary>
    private IEnumerable<(BormFieldDefinition Field, string Path)> RowItems(string itemPath)
        => Template.Children.OrderBy(c => c.Order).Select(c => (c, BormPath.Combine(itemPath, c.Name)));

    /// <summary>
    /// The render key of every row, computed once per render.
    /// </summary>
    /// <remarks>
    /// The item's own identity is preferred, so reordering moves the DOM node with its data instead of
    /// rewriting every row. Value types, strings and nulls fall back to the index — Blazor cannot tell
    /// two equal ones apart — and so does any instance already used: a list may legitimately hold the
    /// same object twice, and a duplicate <c>@key</c> is an exception, not a rendering quirk.
    /// </remarks>
    private object[] BuildKeys(int first, int end)
    {
        var keys = new object[Math.Max(0, end - first)];
        var seen = new HashSet<object>(ReferenceEqualityComparer.Instance);

        for (var i = first; i < end; i++)
        {
            var item = State.GetValue(BormPath.Combine(Path, i));
            keys[i - first] = item is null || item is string || item.GetType().IsValueType || !seen.Add(item)
                ? i
                : item;
        }
        return keys;
    }

    // ------------------------------------------------------------------ pages

    private int _page;

    private int? PageSize => Field.PageSize is > 0 and var size ? size : null;

    /// <summary>Whether the list is longer than a page.</summary>
    // Posted with no interactivity, every row is on the page: a row on a page not showing would not be posted, and lost.
    private bool Paged => !State.RendersStatically && PageSize is { } size && Count > size;

    private int PageCount => Paged ? (Count + PageSize!.Value - 1) / PageSize.Value : 1;

    private int First => Paged ? Math.Clamp(_page, 0, PageCount - 1) * PageSize!.Value : 0;

    private int End => Paged ? Math.Min(Count, First + PageSize!.Value) : Count;

    private int PageOf(int row) => PageSize is { } size ? row / size : 0;

    private void TurnTo(int page) => _page = Math.Clamp(page, 0, PageCount - 1);

    private void OnPagePicked(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var page)) TurnTo(page);
    }

    /// <summary>The rows on other pages with an error the user has been shown, in order.</summary>
    private List<int> RowsElsewhereNeedingAttention()
    {
        var rows = new SortedSet<int>();
        var prefix = Path + "[";
        foreach (var message in State.AllMessages)
        {
            if (message.Severity != BormValidationSeverity.Error
                || !message.FieldPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) continue;
            var close = message.FieldPath.IndexOf(']', prefix.Length);
            if (close < 0 || !int.TryParse(message.FieldPath.AsSpan(prefix.Length, close - prefix.Length), out var row)) continue;
            if (row >= First && row < End) continue;
            if (State.IsSubmitted || State.IsTouched(message.FieldPath)) rows.Add(row);
        }
        return [.. rows];
    }

    /// <summary>Turns to the row's page and puts the focus in it.</summary>
    private void ShowRow(int row)
    {
        _focusRow = row;
        TurnTo(PageOf(row));
    }

    private TaskCompletionSource? _rendered;
    private IDisposable? _revealRegistration;

    /// <summary>
    /// What the state asks before it focuses a field in one of this list's rows: the row's page is shown, and
    /// the answer waits until it has rendered, so the row's controls are there to take the focus.
    /// </summary>
    private async Task<bool> RevealRowAsync(int row)
    {
        if (!Paged || PageOf(row) == Math.Clamp(_page, 0, PageCount - 1)) return false;

        var rendered = _rendered = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        TurnTo(PageOf(row));
        await InvokeAsync(StateHasChanged);
        // Bounded: a list taken away before it rendered must not leave the caller waiting for ever.
        await Task.WhenAny(rendered.Task, Task.Delay(2000));
        return true;
    }

    // ------------------------------------------------------------------ focus
    //
    // Pressing a button that removes the element containing it leaves focus nowhere: the browser drops
    // it on <body>, so a keyboard user is silently returned to the top of the page and a screen-reader
    // user loses their place entirely. Every row operation therefore says where focus should land, and
    // the next render puts it there.

    private ElementReference _addButton;
    private int? _focusRow;
    private bool _focusAdd;

    private async Task Add()
    {
        var index = State.AddArrayItem(Field, Path);
        if (index >= 0) ShowRow(index);
        _said = null;
        await Dependents();
    }

    /// <summary>
    /// Revalidates whatever declared a dependency on this list. Adding a row changes the value the
    /// field binds to as surely as typing does, so a rule elsewhere that counts the rows — "at least
    /// one line per delivery" — has to be judged again; the input controls do this through the field
    /// context, and a repeater has no context to go through.
    /// </summary>
    private ValueTask Dependents() => State.ValidateDependentsAsync(Path);

    /// <summary>
    /// Moves a row, ignoring a request that would take it past either end. The buttons at the ends are
    /// only <c>aria-disabled</c>, so they can still be pressed; this is where that is made harmless.
    /// The DOM node moves with the row (it is keyed by the item), so focus follows it without help.
    /// </summary>
    private async Task Move(int from, int to)
    {
        if (Locked || to < 0 || to >= Count) return;
        State.MoveArrayItem(Path, from, to);
        // Past the edge of the page: the page follows the row, so the button that moved it is still under the hand.
        // Only the page - the row's keyed element, and the focus in it, come along by themselves. ShowRow sent the
        // focus into the row's first box, where the Enter that pressed the button again submitted the form.
        if (Paged && PageOf(to) != _page) TurnTo(PageOf(to));
        // The count has not changed, so on its own the region would say nothing: say where the row
        // landed instead — the one thing a user who cannot see the list moving needs to know.
        Say(State.Text(BormMessageKeys.ArrayItemGroup, ItemNoun, to + 1));
        await Dependents();
    }

    private async Task Duplicate(int index)
    {
        var target = State.DuplicateArrayItem(Field, Path, index);
        if (target >= 0) ShowRow(target);
        _said = null;
        await Dependents();
    }

    private async Task Remove(int index)
    {
        State.RemoveArrayItem(Path, index);

        // The row that moved up into the gap is where the user was looking; when the list empties, the
        // only thing left to aim at is the button that refills it — and the region, which has no count
        // left to give, says that the list is now empty rather than falling silent.
        if (Count == 0)
        {
            _focusAdd = true;
            Say(EmptyText);
        }
        else
        {
            ShowRow(Math.Min(index, Count - 1));
            _said = null;
        }

        await Dependents();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A page turned for a focus request has rendered: its rows' controls are registered now.
        _rendered?.TrySetResult();
        _rendered = null;

        if (_focusRow is { } row)
        {
            _focusRow = null;
            foreach (var path in RowFocusOrder(row))
                if (await State.FocusAsync(path)) return;

            // Nothing in the row would take focus — every field hidden, or all custom renderers with
            // no focusable element. Better the add button than nowhere at all.
            _focusAdd = true;
        }

        if (!_focusAdd) return;
        _focusAdd = false;
        try
        {
            await _addButton.FocusAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException or ObjectDisposedException)
        {
            // Static prerender, or the repeater went away between the click and the render.
        }
    }

    /// <summary>The paths to try when focusing a row, best first.</summary>
    private IEnumerable<string> RowFocusOrder(int row)
    {
        var itemPath = BormPath.Combine(Path, row);
        if (Template.Type != BormFieldType.Object)
        {
            yield return itemPath;
            yield break;
        }

        foreach (var child in Template.Children.OrderBy(c => c.Order))
            yield return BormPath.Combine(itemPath, child.Name);
    }
}
