@namespace Bit.Borm
@inherits BormInputBase

@* Splat first: Blazor lets the last duplicate attribute win, so everything below overrides the
   schema's extras and the id/aria wiring can never be replaced by accident. *@
<input @attributes="ExtraAttributes"
       id="@Context.ElementId"
       name="@Context.InputName"
       @ref="Element"
       class="@CssClass"
       type="@(ShowsAsText ? "text" : HtmlType)"
       value="@(ShowsAsText ? ReadOnlyText : Context.StringValue)"
       disabled="@Disabled"
       readonly="@ReadOnly"
       min="@Bound(Field.Min)"
       max="@Bound(Field.Max)"
       step="@Step"
       autocomplete="@Field.Autocomplete"
       aria-required="@AriaRequired"
       aria-invalid="@AriaInvalid"
       aria-label="@AriaLabel"
       aria-describedby="@DescribedBy"
       @onchange="OnChange"
       @oninput="InputHandler"
       @onblur="OnBlur" />

@code {
    // Month and week are capitalised on purpose. Firefox and desktop Safari have no such pickers and give the
    // element a type of "text"; blazor.web.js decides an input or change event comes from a date-like picker by
    // the type *attribute* and then throws "Invalid element type 'text'" when the element's type is not one -
    // so not a keystroke typed into the text box would ever reach the field. The browser reads the attribute
    // case-insensitively (a month picker wherever there is one), Blazor reads it as written and takes the
    // value as it stands, which for a month or a week is exactly what its picker path would have returned.
    private string HtmlType => Field.Type switch
    {
        BormFieldType.Date => "date",
        BormFieldType.Time => "time",
        BormFieldType.Month => "Month",
        BormFieldType.Week => "Week",
        _ => "datetime-local"
    };

    /// <summary>
    /// A read-only answer is shown in a read-only text box. Firefox gives a read-only date or time picker no focus at
    /// all, so a locked arrival date dropped out of the tab order and could not be reached to be read or copied there,
    /// while every other locked answer could; as text it can, in every browser.
    /// </summary>
    private bool ShowsAsText => ReadOnly && !Disabled;

    /// <summary>The value as the picker writes it, which reads the same everywhere - a date and a time with a space between.</summary>
    private string ReadOnlyText => Context.StringValue.Replace('T', ' ');

    /// <summary>
    /// The <c>step</c> attribute, in seconds for time-bearing inputs. Omitted unless the schema asks
    /// for one — a bare time input steps by a minute, which is what a form almost always wants, and
    /// declaring "60" explicitly would only differ by making seconds unreachable in some browsers.
    /// </summary>
    private string? Step => BormNumber.ToAttribute(Field.NumericStep);

    // Date bounds arrive as OLE automation dates when they come from [Range(typeof(DateTime), …)].
    // Anything that does not convert cleanly is omitted rather than emitted as a value the browser
    // cannot parse.
    private string? Bound(double? value)
    {
        if (value is not { } d) return null;
        try
        {
            return BormValueConverter.ToInputString(DateTime.FromOADate(d), Field.Type);
        }
        catch (ArgumentException)
        {
            return null;
        }
    }
}
