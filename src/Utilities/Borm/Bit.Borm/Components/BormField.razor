@namespace Bit.Borm
@implements IDisposable

@if (_field is not null)
{
    <BormFieldView State="State" Field="_field" Path="@Name" />
}

@code {
    /// <summary>
    /// Renders one field of a form wherever you put it, so a page can lay the form out itself —
    /// interleaving fields with its own markup, putting two of them side by side, wrapping one in a
    /// card — while the field keeps the schema's label, validation, conditions and accessibility wiring.
    /// </summary>
    /// <remarks>
    /// Pair it with <c>ShowSubmitButton="false"</c> on a <see cref="BormView"/>, or drive a
    /// <see cref="BormState"/> directly and supply your own <c>&lt;form&gt;</c>. The field follows
    /// the state by itself — a message, a condition, a list of options arriving — so the page does not
    /// have to subscribe to <see cref="BormState.StateChanged"/> just to keep it current.
    /// </remarks>

    /// <summary>The form the field belongs to.</summary>
    [Parameter, EditorRequired] public BormState State { get; set; } = default!;

    /// <summary>
    /// The field's path — a top-level name (<c>Email</c>), a nested one (<c>Address.City</c>) or an
    /// element of a repeater (<c>Lines[0].Product</c>).
    /// </summary>
    [Parameter, EditorRequired] public string Name { get; set; } = default!;

    /// <summary>
    /// Whether an unknown path throws. Off by default, so a page that renders a field the current
    /// schema does not have simply shows nothing — the right behaviour when the schema is chosen at
    /// runtime. Turn it on to catch a typo in a fixed layout.
    /// </summary>
    [Parameter] public bool ThrowIfMissing { get; set; }

    private BormFieldDefinition? _field;
    private BormState? _subscribed;

    protected override void OnParametersSet()
    {
        // Subscribed for itself. Typing into the control re-renders only the control, so without this
        // the message under it, the red border and the label never moved: the input said
        // aria-invalid="true" and pointed aria-describedby at a message list that was never drawn,
        // a condition the answer satisfied never showed its field, and a select whose options had
        // finished loading went on saying "Loading…". Inside a page that re-renders on the same event
        // this costs nothing extra — a component already queued to render is not queued twice.
        if (!ReferenceEquals(_subscribed, State))
        {
            Unsubscribe();
            _subscribed = State;
            _subscribed.StateChanged += OnStateChanged;
        }

        _field = State.Definition.FindByPath(Name);

        if (_field is null && ThrowIfMissing)
            throw new InvalidOperationException(
                $"{nameof(BormField)}: no field named '{Name}' exists in this form's schema.");
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void Unsubscribe()
    {
        if (_subscribed is null) return;
        _subscribed.StateChanged -= OnStateChanged;
        _subscribed = null;
    }

    public void Dispose() => Unsubscribe();
}
