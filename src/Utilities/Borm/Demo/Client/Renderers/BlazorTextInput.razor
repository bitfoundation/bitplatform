@inherits BormInputBase

@* A custom renderer made of Blazor's own InputText, registered as "blazor-text". InputText needs an EditContext
   to exist at all: the view provides one (ProvideEditContext), mirroring the form's validation, so the input's
   "invalid" class and aria-invalid follow the field's errors. The value is written through the field context,
   never through the EditContext, so conditions and dirty tracking stay the form's. *@
<InputText id="@Context.ElementId"
           class="@CssClass"
           Value="@Context.StringValue"
           ValueChanged="@((string? value) => Context.SetFromStringAsync(value))"
           ValueExpression="@(Context.ValueExpression<string?>())"
           disabled="@Disabled"
           aria-required="@AriaRequired"
           aria-describedby="@DescribedBy"
           autocomplete="@Field.Autocomplete" />
