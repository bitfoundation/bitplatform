@inherits BormInputBase

@* A custom renderer: a row of star buttons, registered under the key "rating" (AddBorm in
   Extensions/IServiceCollectionExtensions.cs) and asked for with CustomRenderer("rating"). It paints
   itself with the form's own --bit-borm-* tokens, so it follows the form's theme - light, dark, or an
   app's override - the way the built-in controls do. *@
<div class="star-rating" role="radiogroup" aria-label="@Field.Label">
    @for (var n = 1; n <= Max; n++)
    {
        var star = n;
        <button type="button"
                class="star @(star <= Current ? "star--on" : "")"
                disabled="@Disabled"
                @onclick="@(() => Context.SetValueAsync(star))">★</button>
    }
    <span class="star-rating__value">@Current / @Max</span>
</div>

<style>
    .star-rating { display: inline-flex; align-items: center; gap: .15rem; }
    .star { background: none; border: none; cursor: pointer; font-size: 1.6rem; line-height: 1; color: var(--bit-borm-border); padding: 0 .05rem; }
    .star--on { color: #f59e0b; }
    .star:disabled { cursor: not-allowed; }
    .star-rating__value { margin-left: .6rem; color: var(--bit-borm-muted); font-size: .85rem; }
</style>

@code {
    private int Max => Field.Attributes.TryGetValue("max", out var m) && m is int i ? i : 5;
    private int Current => Context.Value is int v ? v : int.TryParse(Context.StringValue, out var p) ? p : 0;
}
