@inherits LayoutComponentBase

@* data-interactive turns true once the page runs in the browser. Prerendered markup is on screen
   long before its event handlers are, which is what the E2E suite waits out with it. *@
<div class="app-shell" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    <aside class="app-nav">
        <NavMenu />
    </aside>
    <main class="app-main">
        <header class="app-top">
            <a href="https://github.com/bitfoundation/bitplatform/tree/develop/src/Utilities/Borm" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.nuget.org/packages/Bit.Borm" target="_blank" rel="noopener">NuGet</a>
            <a href="https://bitplatform.dev" target="_blank" rel="noopener">bitplatform.dev</a>
        </header>
        @Body
    </main>
</div>
