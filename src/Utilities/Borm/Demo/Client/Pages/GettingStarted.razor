        <li><a href="saving">Saving &amp; server errors</a> - how a submit ends, and a server's errors put on their fields.</li>
        <li><a href="theming">Theming &amp; accessibility</a> - the <code>--bit-borm-*</code> tokens, dark mode, and what the library does for every user.</li>
        <li><a href="api-reference">API at a glance</a> - every <code>BormView</code> parameter and <code>BormState</code> member on one page.</li>
        <li><a href="mcp-server">MCP server</a> - point an AI agent at this site and it reads the library instead of guessing.</li>
    </ul>
</div>

@code {
    private readonly BormDefinition _definition = BormSchemaGenerator.Generate<Contact>();
    private readonly Contact _model = new();
    private string? _submitted;

    private Task HandleValidSubmit(BormState state)
    {
        _submitted = $"Name: {_model.Name}{Environment.NewLine}Email: {_model.Email}{Environment.NewLine}Age: {_model.Age}";
        return Task.CompletedTask;
    }

    /// <summary>The model of the guide's first form, exactly as the README writes it.</summary>
    public sealed class Contact
    {
        [Required, MaxLength(80)]
        public string Name { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Range(18, 120)]
        public int Age { get; set; }
    }
}
