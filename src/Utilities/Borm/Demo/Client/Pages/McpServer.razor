@page "/mcp-server"

@* Describes the MCP server this demo's host maps at /mcp. Its route differs from the endpoint's on
   purpose: two literal endpoints on /mcp would make a GET of it ambiguous. *@

<PageTitle>MCP server · Borm</PageTitle>

<div class="bb-intro">
    <h1>MCP server</h1>
    <p class="bb-subtitle">
        This site hosts a Model Context Protocol server at <code>/mcp</code>, so an AI agent writing form code with
        Bit.Borm reads the library itself - its compiled API documentation, its guide, its stylesheet, its own JSON
        Schema importer and these demo pages - instead of guessing at an API it half remembers. Every tool is read-only.
    </p>
</div>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-success"></span> Connect a client</h3>

    <p>
        The endpoint is plain Streamable HTTP, so any MCP client connects with a URL and nothing else. The same tools
        are also served, version by version, through the bit platform's own server at
        <code>https://bitplatform.dev/mcp</code>, next to the other bit libraries.
    </p>

    <pre class="bb-code">@ClientConfig</pre>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-primary"></span> Tools</h3>

    <div class="bb-scroll">
        <table class="bb-table">
            <thead>
                <tr><th>Tool</th><th>What it answers</th></tr>
            </thead>
            <tbody>
                @foreach (var tool in Tools)
                {
                    <tr>
                        <td class="bb-table-key"><code>@tool.Name</code></td>
                        <td>@((MarkupString)tool.Description)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p>
        The guide, the API, the theme, a sample schema and the sources are also exposed as <code>borm://</code>
        resources, and three prompts - <code>add-borm-to-app</code>, <code>implement-borm-form</code> and
        <code>debug-borm-form</code> - walk an agent through the common jobs in the right order.
    </p>
</section>

<section class="bb-card">
    <h3 class="bb-card-title"><span class="bb-dot bb-dot-warning"></span> The same tools over plain HTTP</h3>

    <p>
        Every tool is also a <code>GET</code> under <code>/api/mcp/...</code>: open one in a browser tab to read
        exactly what an agent is handed.
    </p>

    <ul class="bb-detail-list">
        @foreach (var (href, text) in HttpExamples)
        {
            <li><a href="@href" target="_blank" rel="noopener">@text</a></li>
        }
    </ul>
</section>

@code {
    private const string ClientConfig = """
        // .mcp.json (Claude Code, VS Code, and anything else reading this shape)
        {
          "mcpServers": {
            "borm": {
              "type": "http",
              "url": "https://borm.bitplatform.dev/mcp"
            }
          }
        }
        """;

    // The server's tools, in the order an agent usually needs them. The one place to change when a tool is
    // added, renamed or retired; the description is markup.
    private static readonly (string Name, string Description)[] Tools =
    [
        ("SearchBorm",
            "Everything at once - the guide, every public member, the setup guides, the theme, the stylesheet and the demo's working forms - each hit with the exact follow-up call that returns its full text."),
        ("GetBormSetupGuide",
            "The complete wiring for one hosting model: web-app, webassembly, server or hybrid - <code>AddBorm()</code> in every container that renders a form, and the stylesheet link."),
        ("GetBormGuideSection",
            "One section of the reference guide, or the index of sections."),
        ("GetBormApi",
            "One public type with every parameter, property and method, its real default and its documentation - or the index of types."),
        ("GetBormTheme",
            "The <code>--bit-borm-*</code> custom properties with their light and dark values and what each one is for - or one of them in full, with the override to write in every colour mode."),
        ("InspectBormSchema",
            "What the library makes of a JSON Schema document - the form it becomes, field by field, what <code>Validate()</code> reports, what the importer drops without a word, and the document it exports back - or a sample schema, to see the format."),
        ("GetBormSourceFile",
            "One demo or library file verbatim - every page here is a working form - or the index of files."),
    ];

    private static readonly (string Href, string Text)[] HttpExamples =
    [
        ("/api/mcp/SearchBorm?query=cascading%20options", "/api/mcp/SearchBorm?query=cascading options"),
        ("/api/mcp/GetBormApi?typeName=BormState", "/api/mcp/GetBormApi?typeName=BormState"),
        ("/api/mcp/GetBormTheme", "/api/mcp/GetBormTheme"),
        ("/api/mcp/InspectBormSchema", "/api/mcp/InspectBormSchema"),
        ("/api/mcp/GetBormSourceFile?path=Demo/Client/Pages/WizardDemo.razor", "/api/mcp/GetBormSourceFile?path=Demo/Client/Pages/WizardDemo.razor"),
    ];
}
