<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>Bit.Bsqlite</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Static assets only; no Razor components, so no need to scan for them. -->
        <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
        <Description>bit Bsqlite: SQLite in the browser for Blazor, with EF Core on top. The ADO.NET surface with live queries, the worker transport (storage selection, engine-build negotiation, binary framing, batching, lifecycle), the storage provider contract, the in-memory backend, the EF Core integration (UseBitBsqlite() on the stock SQLite provider), and the browser half - worker host, wa-sqlite engine builds and the JavaScript API storage providers' VFSes extend.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>Bit;Bsqlite;Blazor;WebAssembly;SQLite;EF Core;Entity Framework Core;ADO.NET;Offline;Live query</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <Import Project="engine\wa-sqlite.lock.props" />
    <Import Project="engine\FetchEngine.targets" />

    <ItemGroup>
        <!-- Floating low-bound version ranges so consumers can pin to any patch release on their TFM;
             the upper bound keeps a major-version package that targets a newer TFM out.

             Sqlite.Core rather than the full Sqlite package: WebAssembly must not pull in a native
             e_sqlite3. Desktop tests get a real engine through Bit.Bsqlite.Testing's Microsoft.Data.Sqlite.

             The net8.0 floor is 8.0.11 rather than 8.0.0: EF Core 8.0.0 brings Microsoft.Extensions.Caching.Memory
             8.0.0, which has a known high severity vulnerability (GHSA-qj66-m88j-hmgj) that NuGet audit reports
             on every restore; 8.0.11 is the first EF Core 8 that depends on the patched 8.0.1. -->

        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="[8.0.11,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.JSInterop" Version="[8.0.0,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.Extensions.Logging.Abstractions" Version="[8.0.0,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.0,9.0.0)" />

        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.JSInterop" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.Extensions.Logging.Abstractions" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[9.0.0,10.0.0)" />

        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.JSInterop" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.0.0,11.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.0,11.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <!-- EntityFrameworkCore/BsqlitePclProvider implements SQLitePCLRaw's ISQLite3Provider, whose member list grows
             within 2.x. A provider compiled against an older core fails to load
             once a newer one is resolved, so every target framework compiles against the newest 2.x the EF Core
             providers accept, rather than the 2.1.6/2.1.10/2.1.11 each EF Core band would pick on its own. -->
        <PackageReference Include="SQLitePCLRaw.core" Version="[2.1.13,3.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.Bsqlite.Tests" PublicKey="" />
    </ItemGroup>

    <!-- Keep the build inputs (tsconfig + package manifests) out of the published static web
         assets while still showing them in the project. -->
    <ItemGroup>
        <Content Remove="package*.json;tsconfig.json" />
        <None Include="package*.json;tsconfig.json" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="Scripts\**\*.ts" Exclude="Scripts\**\*.d.ts" />
        <TypeScriptDeclarationFiles Include="Scripts\**\*.d.ts" />
    </ItemGroup>

    <!-- Restores npm packages then compiles the TypeScript modules. Both sub-targets are incremental
         via their Inputs/Outputs, so this is a no-op when nothing changed. -->
    <Target Name="BuildBsqliteJavaScript" DependsOnTargets="InstallNodejsDependencies;BuildJavaScript" />

    <!-- The modules (wwwroot/bit-bsqlite-*.js) are generated, git-ignored files. On a clean build they do
         not exist when the default "wwwroot/**" Content glob is evaluated, so static web asset discovery
         would miss them and consumers would get a 404 for _content/Bit.Bsqlite/bit-bsqlite-host.js.
         Hooking BeforeTargets="ResolveProjectStaticWebAssets" generates them first and then adds them to
         @(Content) explicitly; the Remove-before-Include keeps each to a single Content entry when the glob
         already captured it. The wildcard is expanded here, when the target runs, so it sees the files the
         compile just wrote. -->
    <Target Name="IncludeBsqliteJavaScriptAsStaticWebAsset"
            BeforeTargets="ResolveProjectStaticWebAssets"
            DependsOnTargets="BuildBsqliteJavaScriptOnce">
        <ItemGroup>
            <_BsqliteGeneratedJavaScript Include="wwwroot\bit-bsqlite-*.js" />
            <Content Remove="@(_BsqliteGeneratedJavaScript)" />
            <Content Include="@(_BsqliteGeneratedJavaScript)" />
        </ItemGroup>
    </Target>

    <!-- Runs BuildBsqliteJavaScript through the MSBuild task with TargetFramework removed, so every per-TFM
         build asks for the same project configuration: MSBuild keeps one result per project and global
         properties, so the first request runs npm/tsc/esbuild and concurrent ones wait for it. A
         ProjectReference (each storage package references this project once per target framework, in
         parallel) builds the inner builds directly without the outer build, so calling the compile from
         each of them would race on node_modules and the wwwroot output. -->
    <Target Name="BuildBsqliteJavaScriptOnce">
        <MSBuild Projects="$(MSBuildProjectFullPath)"
                 Targets="BuildBsqliteJavaScript"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
    </Target>

    <!-- In a multi-targeted build, produce the modules exactly once in the outer (cross-targeting) build,
         before the per-TFM inner builds are dispatched, so several inner builds never run tsc/esbuild
         concurrently against the same shared wwwroot output files. -->
    <Target Name="BuildBsqliteJavaScriptOnCrossTargeting"
            BeforeTargets="DispatchToInnerBuilds"
            Condition="'$(IsCrossTargetingBuild)' == 'true'"
            DependsOnTargets="BuildBsqliteJavaScript" />

    <!-- `npm ci` against the checked-in package-lock.json keeps the installed tree reproducible and fails
         fast when package.json and the lockfile drift. -->
    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm ci" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <!-- The output differs per configuration (Release is minified) but lands in the same files, so the
         sources alone cannot drive the up-to-date check: a per-configuration stamp in obj/ makes switching
         configurations invalidate it, and the stale stamp of the other configuration is deleted so
         switching back rebuilds too. -->
    <Target Name="BuildJavaScript"
            Inputs="@(TypeScriptFiles);@(TypeScriptDeclarationFiles);tsconfig.json"
            Outputs="@(TypeScriptFiles->'wwwroot\%(Filename).js');$(BaseIntermediateOutputPath)bit-bsqlite.$(Configuration).stamp">
        <ItemGroup>
            <_BsqliteStaleStamps Include="$(BaseIntermediateOutputPath)bit-bsqlite.*.stamp" />
        </ItemGroup>
        <Delete Files="@(_BsqliteStaleStamps)" />
        <Exec Command="node_modules/.bin/tsc" StandardOutputImportance="high" StandardErrorImportance="high" />
        <!-- Minify each module to a temp file and move it into place, so an interrupted minify never leaves a
             half-written module that the Outputs check above would then treat as up-to-date. format=esm keeps
             the named exports the interop and the worker resolve through dynamic import(), and the target
             matches tsconfig so the minifier does not raise the syntax level. -->
        <Exec Condition=" '$(Configuration)' == 'Release' " Command="node_modules/.bin/esbuild wwwroot/%(TypeScriptFiles.Filename).js --minify --format=esm --target=es2022 --outfile=wwwroot/%(TypeScriptFiles.Filename).min.js" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Move Condition=" '$(Configuration)' == 'Release' " SourceFiles="@(TypeScriptFiles->'wwwroot\%(Filename).min.js')" DestinationFiles="@(TypeScriptFiles->'wwwroot\%(Filename).js')" OverwriteReadOnlyFiles="true" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)" />
        <Touch Files="$(BaseIntermediateOutputPath)bit-bsqlite.$(Configuration).stamp" AlwaysCreate="true" />
    </Target>

</Project>
