@inject BrowserDatabase Database
@implements IAsyncDisposable

@* The session bar: which storage backend this tab's database actually landed on, and the two
   operations that move it somewhere else. It sits above every demo page because every demo runs
   against whatever it says. *@

<section class="session-bar" aria-label="Client database session" data-session="@(Database.Resolution?.Provider.Name ?? "closed")">
    <div class="session-id">
        <span class="storage-dot" data-name="@CurrentName"></span>
        <div>
            <p class="session-label">Client database</p>
            <p class="session-name">@SampleStorage.Title(CurrentName)</p>
        </div>
    </div>

    <p class="session-blurb">@SampleStorage.Blurb(CurrentName)</p>

    <div class="session-controls">
        <label>
            <span>Backend</span>
            <select @bind="_target" disabled="@_busy">
                @foreach (var provider in Database.Providers)
                {
                    <option value="@provider.Name">@SampleStorage.Title(provider.Name)</option>
                }
            </select>
        </label>
        <button type="button" class="secondary" disabled="@(_busy || SameTarget)"
                @onclick="() => SwitchAsync(StorageSwitchMode.Migrate)">
            <Icon Name="sync" />
            Move data
        </button>
        <button type="button" class="secondary" disabled="@(_busy || SameTarget)"
                @onclick="() => SwitchAsync(StorageSwitchMode.Fresh)">
            Start empty
        </button>
    </div>

    @if (_message is not null)
    {
        <p class="session-status @(_failed ? "failed" : "ok")" role="status">@_message</p>
    }
</section>

@code {
    private string _target = "opfs";
    private bool _busy;
    private bool _failed;
    private string? _message;

    private string CurrentName => Database.Resolution?.Provider.Name ?? _target;

    private bool SameTarget =>
        string.Equals(CurrentName, _target, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        // Prerendered on the server too, where there is no session to describe: the bar shows the
        // preferred backend until the page runs in the browser and opens the real one.
        if (RendererInfo.IsInteractive is false)
        {
            return;
        }

        Database.AfterSessionReset += OnResetAsync;
        try
        {
            await Database.EnsureSessionAsync();
            _target = CurrentName;
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _failed = true;
            _message = ex.Message;
        }
    }

    private async Task OnResetAsync()
    {
        try
        {
            await Database.EnsureSessionAsync();
            _target = CurrentName;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
        }
    }

    private async Task SwitchAsync(StorageSwitchMode mode)
    {
        _busy = true;
        _failed = false;
        _message = null;
        try
        {
            await Database.SwitchStorageAsync(_target, mode);
            await Database.EnsureSessionAsync();
            var verb = mode is StorageSwitchMode.Migrate ? "Moved onto" : "Opened empty on";
            _message = $"{verb} {SampleStorage.Title(CurrentName)}.";
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _failed = true;
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Database.AfterSessionReset -= OnResetAsync;
        await Task.CompletedTask;
    }
}
