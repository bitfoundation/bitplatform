@*+:cnd:noEmit*@
@* [mirror] host page head tags, stylesheet and script list - keep in sync with: *@
@* - src/Server/Boilerplate.Server.Web/Components/App.razor *@
@* - src/Client/Boilerplate.Client.Web/wwwroot/index.html *@
@* - src/Client/Boilerplate.Client.Maui/wwwroot/index.html *@
@using Microsoft.AspNetCore.Http

@* A /preview page takes its theme, safe-area insets and look from the scenario in its query string and never saves the theme; the shell keeps the theme the user picked. *@
@{
    var isPreview = HttpContext.Request.Path.StartsWithSegments("/preview");
    var scenario = isPreview ? WorkbenchScenario.Parse(HttpContext.Request.QueryString.Value) : null;
    var themePreference = scenario is not null
        ? scenario.Theme.ToString().ToLowerInvariant()
        : HttpContext.Request.Cookies[BitThemeCookie.PreferenceCookieName];
    var themeOptions = new BitThemeSsrOptions
    {
        Persist = isPreview is false,
        PersistCookie = isPreview is false,
        ViewTransition = isPreview is false,
        ThemeColorMeta = isPreview is false,
        LightTheme = AppThemePresets.Light,
        DarkTheme = AppThemePresets.Dark,
        PersistedThemePair = isPreview ? null : HttpContext.Request.Cookies[BitThemeCookie.PairCookieName]
    };
    var (insetTop, insetBottom) = scenario?.DevicePreset.GetSafeArea(scenario.Rotated) ?? (0, 0);
    var insetStyle = scenario is null ? null : FormattableString.Invariant($"--bit-env-inset-top:{insetTop}px;--bit-env-inset-bottom:{insetBottom}px;--bit-env-inset-left:0px;--bit-env-inset-right:0px;{WorkbenchPreviewLook.GetRootStyle(scenario)}");
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name"
      dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : null)"
      style="@insetStyle"
      data-wb-motion="@(scenario?.ReducedMotion is true ? "reduce" : null)"
      data-wb-vision="@scenario?.Vision?.ToString().ToLowerInvariant()"
      @attributes="BitThemeSsr.BuildRootThemeAttributeMap(themePreference, themeOptions)">

<head>
    <base href="/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <BitThemeHead PersistedPreference="@themePreference" Options="@themeOptions" />
    <link rel="icon" href="_content/Boilerplate.Client.Core/images/bit-logo.svg" type="image/svg+xml" />
    <HeadOutlet @rendermode="RenderMode" />
</head>

<body class="@BitCss.Class.Color.Background.Primary.Main @BitCss.Class.Color.Foreground.Primary.Main @(isPreview ? "wb-preview-body" : "wb-body") @(scenario is { Backdrop: null } && scenario.DevicePreset.IsHandheld ? "bit-blazor-hybrid wb-touch" : null)">
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI/styles/bit.blazorui.css" />
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.Icons/styles/bit.blazorui.icons.css" />
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.Assets/styles/bit.blazorui.assets.css" />
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.Extras/styles/bit.blazorui.extras.css" />
    @*#if (theme == "Cupertino")*@
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.Extras/styles/bit.blazorui.cupertino.css" />
    @*#endif*@
    @*#if (theme == "Material")*@
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.Extras/styles/bit.blazorui.material.css" />
    @*#endif*@
    @*#if (theme == "Fluent2")*@
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.Extras/styles/bit.blazorui.fluent2.css" />
    @*#endif*@
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.AI/styles/bit.blazorui.ai.css" />
    <Link rel="stylesheet" Href="_content/Boilerplate.Client.Core/styles/app.css" />
    <Link rel="stylesheet" Href="_content/Bit.Bortable/bit-bortable.css" />
    <Link rel="stylesheet" Href="_content/Bit.Blow/bit-blow.css" />
    <Link rel="stylesheet" Href="_content/Bit.Bonboarding/bit-bonboarding.css" />
    <Link rel="stylesheet" Href="styles/workbench.css" />
    <Link rel="stylesheet" Href="Boilerplate.Workbench.styles.css" />

    <Routes @rendermode="RenderMode" />

    @* Blazor shows this when the circuit fails, so a broken page says so instead of looking like it is still loading. *@
    <div id="blazor-error-ui" role="alert" style="display:none;position:fixed;inset-inline:0;bottom:0;z-index:1000000;padding:0.75rem 1rem;color:var(--bit-clr-err-text);background-color:var(--bit-clr-err)">
        @AppLocalizer[nameof(AppStrings.SomethingWentWrong)]
        <a href="" class="reload" style="color:inherit;font-weight:600;margin-inline-start:0.5rem">@AppLocalizer[nameof(AppStrings.Refresh)]</a>
    </div>

    @* The color blindness filters the data-wb-vision attribute applies to the page. *@
    @if (scenario?.Vision is not null)
    {
        <svg class="wb-vision-filters" aria-hidden="true" focusable="false">
            <filter id="wb-vision-protanopia"><feColorMatrix type="matrix" values="0.567 0.433 0 0 0 0.558 0.442 0 0 0 0 0.242 0.758 0 0 0 0 0 1 0" /></filter>
            <filter id="wb-vision-deuteranopia"><feColorMatrix type="matrix" values="0.625 0.375 0 0 0 0.7 0.3 0 0 0 0 0.3 0.7 0 0 0 0 0 1 0" /></filter>
            <filter id="wb-vision-tritanopia"><feColorMatrix type="matrix" values="0.95 0.05 0 0 0 0 0.433 0.567 0 0 0 0.475 0.525 0 0 0 0 0 1 0" /></filter>
            <filter id="wb-vision-achromatopsia"><feColorMatrix type="matrix" values="0.299 0.587 0.114 0 0 0.299 0.587 0.114 0 0 0.299 0.587 0.114 0 0 0 0 0 1 0" /></filter>
        </svg>
    }

    @* Blazor is started by workbench.js, which hands a preview's culture to its circuit. *@
    <Script Src="_framework/blazor.web.js" autostart="false"></Script>
    <Script Src="_content/Bit.Butil/bit-butil.js"></Script>
    <Script Src="_content/Bit.BlazorUI/scripts/bit.blazorui.js"></Script>
    <Script Src="_content/Bit.BlazorUI.Extras/scripts/bit.blazorui.extras.js"></Script>
    <Script Src="_content/Bit.BlazorUI.AI/scripts/bit.blazorui.ai.js"></Script>
    <Script Src="scripts/workbench.js"></Script>
</body>

</html>
