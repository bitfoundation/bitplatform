@inherits WorkbenchComponentBase

@* The Density switch puts the library's density overlay around the page; with no overlay the provider adds nothing. *@
<BitThemeProvider Theme="densityTheme">
    <div class="theme" id="@ScopeId">
        <header class="theme-header">
            <BitText Typography="BitTypography.H5" Element="@PageHeadingElement" Class="title">@Localizer[nameof(WorkbenchStrings.ThemeHeading)]</BitText>
            <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer[nameof(WorkbenchStrings.ThemeSubtitle)]</BitText>
            <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer[nameof(WorkbenchStrings.ThemeStatesNote)]</BitText>
        </header>

        @* The components' own texts are translated only where this page needed them; every one of them can be. *@
        <BitMessage Color="BitColor.Info" Variant="BitVariant.Outline" Tinted Multiline>@Localizer[nameof(WorkbenchStrings.ThemeLocalizationNote)]</BitMessage>

        @* One section at a time: only the selected tab is rendered, and the Section switch picks the tab the page opens on. *@
        <BitPivot @bind-SelectedKey="selectedSection"
                  @bind-SelectedKey:after="ReportSection"
                  OverflowBehavior="BitPivotOverflowBehavior.Scroll"
                  AriaLabel="@Localizer[nameof(WorkbenchStrings.ThemeSectionsOfThisPage)]">
            <BitPivotItem Key="colors" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeColors)]"><ColorsSection Values="values" /></BitPivotItem>
            <BitPivotItem Key="typography" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeTypography)]"><TypographySection Values="values" /></BitPivotItem>
            <BitPivotItem Key="shape" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeShape)]"><ShapeSection Values="values" /></BitPivotItem>
            <BitPivotItem Key="shadows" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeShadows)]"><ShadowsSection Values="values" /></BitPivotItem>
            <BitPivotItem Key="sizes" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeSizes)]"><SizesSection Values="values" /></BitPivotItem>
            <BitPivotItem Key="motion" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeMotion)]"><MotionSection Values="values" /></BitPivotItem>
            <BitPivotItem Key="layers" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeLayers)]"><LayersSection Values="values" /></BitPivotItem>

            <BitPivotItem Key="overlays" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeOverlays)]">
                <OverlaysSection Overlay="@Overlay"
                                 OnDialog="() => isDialogOpen = true"
                                 OnModal="() => isModalOpen = true"
                                 OnPanel="() => isPanelOpen = true"
                                 OnSnackBars="ShowSnackBars" />
            </BitPivotItem>

            <BitPivotItem Key="buttons" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeButtons)]"><ButtonsSection /></BitPivotItem>
            <BitPivotItem Key="inputs" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeInputs)]"><InputsSection /></BitPivotItem>
            <BitPivotItem Key="pickers" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemePickers)]"><PickersSection /></BitPivotItem>
            <BitPivotItem Key="layouts" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeLayouts)]"><LayoutsSection /></BitPivotItem>
            <BitPivotItem Key="lists" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeLists)]"><ListsSection /></BitPivotItem>
            <BitPivotItem Key="navs" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeNavigation)]"><NavsSection /></BitPivotItem>
            <BitPivotItem Key="notifications" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeNotifications)]"><NotificationsSection /></BitPivotItem>
            <BitPivotItem Key="progress" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeProgressSection)]"><ProgressSection /></BitPivotItem>
            <BitPivotItem Key="surfaces" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeSurfaces)]"><SurfacesSection /></BitPivotItem>
            <BitPivotItem Key="utilities" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeUtilities)]"><UtilitiesSection /></BitPivotItem>
            <BitPivotItem Key="extras" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeExtras)]"><ExtrasSection /></BitPivotItem>
            <BitPivotItem Key="ai" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeAi)]"><AiSection /></BitPivotItem>
        </BitPivot>
    </div>

    @* The dialog, the modal and the panel that the Overlays buttons and the overlay switch open, on any tab. *@
    <BitDialog @bind-IsOpen="isDialogOpen"
               Title="@Localizer[nameof(WorkbenchStrings.ThemeDialogTitle)]"
               Message="@Localizer[nameof(WorkbenchStrings.ThemeDialogMessage)]"
               OkText="@AppLocalizer[nameof(AppStrings.Delete)]"
               CancelText="@AppLocalizer[nameof(AppStrings.Cancel)]" />

    <BitModal @bind-IsOpen="isModalOpen" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeRenameTheShop)]" ShowCloseButton>
        <Body>
            <div class="overlay-body">
                <BitText Typography="BitTypography.Body2">@Localizer[nameof(WorkbenchStrings.ThemeTheNewNameShowsOn)]</BitText>
                <BitTextField Label="@NameLabel" Value="@("Bit Bakery")" />
            </div>
        </Body>
        <Footer>
            <div class="overlay-footer">
                <BitButton Variant="BitVariant.Outline" OnClick="() => isModalOpen = false">@AppLocalizer[nameof(AppStrings.Cancel)]</BitButton>
                <BitButton OnClick="() => isModalOpen = false">@AppLocalizer[nameof(AppStrings.Save)]</BitButton>
            </div>
        </Footer>
    </BitModal>

    <BitPanel @bind-IsOpen="isPanelOpen" HeaderText="@Localizer[nameof(WorkbenchStrings.ThemeOverlayPanel)]" ShowCloseButton>
        <div class="overlay-body">
            <BitText Typography="BitTypography.Body2">@SampleText</BitText>
            <BitTextField Label="@NameLabel" Placeholder="@NamePlaceholder" />
        </div>
    </BitPanel>
</BitThemeProvider>
