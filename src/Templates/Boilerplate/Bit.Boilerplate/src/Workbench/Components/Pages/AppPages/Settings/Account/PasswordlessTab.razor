@inherits WorkbenchComponentBase

<section>
    <BitStack FillContent HorizontalAlign="BitAlignment.Center" Class="max-width">
        <BitText Typography="BitTypography.H6" Element="h3" Align="BitTextAlign.Center">
            @AppLocalizer[nameof(AppStrings.PasswordlessTitle)]
        </BitText>

        <br />

        @if (store.IsPasswordlessEnabled)
        {
            <BitButton AutoLoading OnClick="DisablePasswordless" Variant="BitVariant.Outline" Color="BitColor.Warning">
                @AppLocalizer[nameof(AppStrings.DisablePasswordless)]
            </BitButton>
        }
        else
        {
            <BitButton AutoLoading OnClick="EnablePasswordless" IconName="@BitIconName.Fingerprint">
                @AppLocalizer[nameof(AppStrings.EnablePasswordless)]
            </BitButton>
        }

        <br />
    </BitStack>
</section>
