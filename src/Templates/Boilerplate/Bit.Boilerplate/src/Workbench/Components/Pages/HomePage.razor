@page "/"
@inherits WorkbenchComponentBase

<PageTitle>@Localizer[nameof(WorkbenchStrings.HomePageTitle)]</PageTitle>

<div id="top" class="home @(areRevealsLive ? "reveals-live" : null)">
    <ShellHeader />

    <section class="hero">
        <div class="hero-text">
            <Bmotion Initial="Bm.To(opacity: 0, y: 16)" Animate="Bm.To(opacity: 1, y: 0)" Transition="Enter(0)">
                <span class="eyebrow"><BitIcon IconName="@BitIconName.Design" Size="BitSize.Small" /> @Localizer[nameof(WorkbenchStrings.HomeEyebrow)]</span>
            </Bmotion>
            <Bmotion Initial="Bm.To(opacity: 0, y: 16)" Animate="Bm.To(opacity: 1, y: 0)" Transition="Enter(1)">
                <h1 class="headline">@Localizer[nameof(WorkbenchStrings.HomeHeadline)]</h1>
            </Bmotion>
            <Bmotion Initial="Bm.To(opacity: 0, y: 16)" Animate="Bm.To(opacity: 1, y: 0)" Transition="Enter(2)">
                <p class="lead">@Localizer[nameof(WorkbenchStrings.HomeLead)]</p>
            </Bmotion>
            <Bmotion Initial="Bm.To(opacity: 0, y: 16)" Animate="Bm.To(opacity: 1, y: 0)" Transition="Enter(3)">
                <div class="hero-actions">
                    @* Opens the first page with the tour of the Workbench over it. *@
                    @if (HeroPage is { } heroPage)
                    {
                        <BitButton Size="BitSize.Large" IconName="@BitIconName.Rocket" Href="@WorkbenchUrls.Tour(heroPage.Key)">
                            @Localizer[nameof(WorkbenchStrings.HomeStartHere)]
                        </BitButton>
                    }
                </div>
            </Bmotion>
            <Bmotion Initial="Bm.To(opacity: 0)" Animate="Bm.To(opacity: 1)" Transition="Enter(4)">
                <ul class="facts">
                    <li><BitIcon IconName="@BitIconName.CheckMark" Size="BitSize.Small" Color="BitColor.Success" />@Localizer[nameof(WorkbenchStrings.HomeFactAgent)]</li>
                    <li><BitIcon IconName="@BitIconName.CheckMark" Size="BitSize.Small" Color="BitColor.Success" />@Localizer[nameof(WorkbenchStrings.HomeFactNoServer)]</li>
                    <li><BitIcon IconName="@BitIconName.CheckMark" Size="BitSize.Small" Color="BitColor.Success" />@Localizer[nameof(WorkbenchStrings.HomeFactThemes)]</li>
                    <li><BitIcon IconName="@BitIconName.CheckMark" Size="BitSize.Small" Color="BitColor.Success" />@Localizer[nameof(WorkbenchStrings.HomeFactStores)]</li>
                </ul>
            </Bmotion>
        </div>

        @* Live thumbnails of two showcase pages; both themes load, and the styles show the one that matches the shell's. *@
        <div class="hero-visual" aria-hidden="true">
            <Bmotion Initial="Bm.To(opacity: 0, y: 40)" Animate="Bm.To(opacity: 1, y: 0)" Transition="Bm.Spring(stiffness: 90, damping: 18).WithDelay(0.15)">
                <div class="laptop-holder">
                    <DeviceFrame Device="@DevicePresets.Find("laptop-hidpi")">
                        @if (HeroPage is { } laptopPage)
                        {
                            <img class="light-only" data-thumbnail="@($"api/thumbnails/{laptopPage.Key}")" alt="" />
                            <img class="dark-only" data-thumbnail="@($"api/thumbnails/{laptopPage.Key}?theme=Dark")" alt="" />
                        }
                    </DeviceFrame>
                </div>
            </Bmotion>
            <Bmotion Initial="Bm.To(opacity: 0, y: 60, x: 30)" Animate="Bm.To(opacity: 1, y: 0, x: 0)" Transition="Bm.Spring(stiffness: 90, damping: 16).WithDelay(0.35)">
                <div class="phone-holder">
                    <DeviceFrame Device="DevicePresets.Default">
                        @if (PhonePage is { } phonePage)
                        {
                            <img class="light-only" data-thumbnail="@($"api/thumbnails/{phonePage.Key}?phone=true")" alt="" />
                            <img class="dark-only" data-thumbnail="@($"api/thumbnails/{phonePage.Key}?phone=true&theme=Dark")" alt="" />
                        }
                    </DeviceFrame>
                </div>
            </Bmotion>
            @for (var i = 0; i < chips.Length; i++)
            {
                var chip = chips[i];
                var chipIndex = i;
                <Bmotion Initial="Bm.To(opacity: 0, scale: 0.8)" Animate="Bm.To(opacity: 1, scale: 1)" Transition="Bm.Spring(stiffness: 160, damping: 14).WithDelay(0.7 + chipIndex * 0.12)">
                    <span class="chip chip-@chipIndex">
                        <BitIcon IconName="@chip.IconName" Size="BitSize.Small" />
                        @Localizer[chip.TextKey]
                    </span>
                </Bmotion>
            }
        </div>
    </section>

    @* The agents' long tasks as the Progress page lists them, or its samples until one starts. *@
    <section id="progress" class="section agents">
        <div class="agents-grid">
            <div class="agents-text">
                <h2>@Localizer[nameof(WorkbenchStrings.ProgressTitle)]</h2>
                <p>@Localizer[nameof(WorkbenchStrings.HomeProgressSubtitle)]</p>
                <ul class="agents-points">
                    <li><span class="point-icon"><BitIcon IconName="@BitIconName.TaskList" Size="BitSize.Small" /></span>@Localizer[nameof(WorkbenchStrings.HomeProgressPointSteps)]</li>
                    <li><span class="point-icon"><BitIcon IconName="@BitIconName.Microphone" Size="BitSize.Small" /></span>@Localizer[nameof(WorkbenchStrings.HomeProgressPointAnswer)]</li>
                    <li><span class="point-icon"><BitIcon IconName="@BitIconName.Ringer" Size="BitSize.Small" /></span>@Localizer[nameof(WorkbenchStrings.HomeProgressPointSound)]</li>
                    <li><span class="point-icon"><BitIcon IconName="@BitIconName.Lock" Size="BitSize.Small" /></span>@Localizer[nameof(WorkbenchStrings.HomeProgressPointSecrets)]</li>
                </ul>
                <div class="agents-actions">
                    <BitButton IconName="@BitIconName.TaskList" Href="@WorkbenchUrls.Progress">@Localizer[nameof(WorkbenchStrings.HomeProgressOpen)]</BitButton>
                    @if (reviewSession.NeedsYouCount is > 0 and var waiting)
                    {
                        <span class="waiting"><BitIcon IconName="@BitIconName.Ringer" Size="BitSize.Small" Color="BitColor.Warning" /> @Localizer[nameof(WorkbenchStrings.ProgressNeedsYouCount), waiting]</span>
                    }
                </div>
            </div>
            @* Who may see the real tasks waits for them, so the samples never flash by first. *@
            <div class="agents-tasks">
                @if (reviewSession.IsOpen is false && reviewSession.CanSeeTasks && isOpenFailed)
                {
                    <span class="open-failed" role="alert">@Localizer[nameof(WorkbenchStrings.LoadFailed)]</span>
                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IconName="@BitIconName.Refresh" OnClick="Reload" Class="open-failed-reload">@Localizer[nameof(WorkbenchStrings.ReloadPage)]</BitButton>
                }
                else if (reviewSession.IsOpen is false && reviewSession.CanSeeTasks)
                {
                    <BitRingLoading />
                }
                else if (reviewSession.ShowsSampleTasks)
                {
                    <span class="samples-badge"><BitIcon IconName="@BitIconName.Lightbulb" Size="BitSize.Small" /> @Localizer[nameof(WorkbenchStrings.ProgressSamplesTitle)]</span>
                }
                @foreach (var task in reviewSession.IsOpen || reviewSession.CanSeeTasks is false ? reviewSession.ShownTasks.OrderByDescending(t => t.NeedsYouCount > 0).ThenBy(t => t.IsFinished).ThenByDescending(t => t.UpdatedAt).Take(3) : [])
                {
                    <Bmotion @key="task.Id" Preset="BmPresets.Reveal(distance: 24)">
                        <div class="agents-card"><ProgressTaskCard ProgressTask="task" /></div>
                    </Bmotion>
                }
            </div>
        </div>
    </section>

    <section id="why" class="section">
        <div class="section-head">
            <h2>@Localizer[nameof(WorkbenchStrings.HomeWhyTitle)]</h2>
            <p>@Localizer[nameof(WorkbenchStrings.HomeWhySubtitle)]</p>
        </div>
        <div class="reasons">
            @foreach (var reason in reasons)
            {
                <Bmotion Preset="BmPresets.Reveal(distance: 24)" WhileHover="Bm.To(y: -4)">
                    <article class="reason">
                        <span class="reason-icon"><BitIcon IconName="@reason.IconName" /></span>
                        <h3>@Localizer[reason.TitleKey]</h3>
                        <p>@Localizer[reason.TextKey]</p>
                    </article>
                </Bmotion>
            }
        </div>
    </section>

    <section class="section how">
        <div class="section-head">
            <h2>@Localizer[nameof(WorkbenchStrings.HomeHowTitle)]</h2>
        </div>
        <ol class="steps">
            @for (var i = 0; i < steps.Length; i++)
            {
                var step = steps[i];
                var stepNumber = i + 1;
                <Bmotion Preset="BmPresets.Reveal(distance: 24)">
                    <li class="step">
                        <span class="step-number">@stepNumber.ToString(CultureInfo.CurrentCulture)</span>
                        <h3>@Localizer[step.TitleKey]</h3>
                        <p>@Localizer[step.TextKey]</p>
                    </li>
                </Bmotion>
            }
        </ol>
    </section>

    <section id="pages" class="section">
        <div class="section-head">
            <h2>@Localizer[nameof(WorkbenchStrings.HomePagesTitle)]</h2>
            <p>@Localizer[nameof(WorkbenchStrings.HomePagesSubtitle)]</p>
        </div>
        @* The catalog's pages under their categories, as the Pages pane lists them; one card per page, with its review status and open comments once the review document is open. *@
        <div class="catalog">
            @foreach (var group in PageGroups)
            {
                <div class="catalog-group @SpanClass(group.Count())">
                    <h3 class="catalog-group-title">@Localizer[group.Key]</h3>
                    @foreach (var entry in group)
                    {
                        <Bmotion Preset="BmPresets.Reveal(distance: 24)" WhileHover="Bm.To(y: -6)">
                            <a class="page-card" href="@WorkbenchUrls.Workbench(entry.Key)">
                                <span class="thumbnail">
                                    <img class="light-only" data-thumbnail="@($"api/thumbnails/{entry.Key}")" alt="" />
                                    <img class="dark-only" data-thumbnail="@($"api/thumbnails/{entry.Key}?theme=Dark")" alt="" />
                                </span>
                                <span class="page-body">
                                    <span class="page-title"><BitIcon IconName="@entry.IconName" Color="BitColor.Primary" /> @Localizer[entry.TitleKey]</span>
                                    <span class="page-description">@Localizer[entry.DescriptionKey]</span>
                                    <span class="page-tags">
                                        @foreach (var tag in entry.Showcases)
                                        {
                                            <span class="tag">@tag</span>
                                        }
                                    </span>
                                    @if (reviewSession.PageOf(entry.Key) is { } pageReview || OpenCount(entry.Key) > 0)
                                    {
                                        <span class="page-review">
                                            @if (reviewSession.PageOf(entry.Key) is { } status)
                                            {
                                                <span class="review-status status-@status.Status.ToString().ToLowerInvariant()">@Localizer[$"PageStatus{status.Status}"]</span>
                                            }
                                            @if (OpenCount(entry.Key) is > 0 and var open)
                                            {
                                                <span class="review-count"><BitIcon IconName="@BitIconName.Comment" Size="BitSize.Small" /> @Localizer[nameof(WorkbenchStrings.OpenCommentsCount), open]</span>
                                            }
                                        </span>
                                    }
                                </span>
                            </a>
                        </Bmotion>
                    }
                </div>
            }
        </div>
    </section>

    <section id="flows" class="section">
        <div class="section-head">
            <h2>@Localizer[nameof(WorkbenchStrings.Flows)]</h2>
            <p>@Localizer[nameof(WorkbenchStrings.FlowsHint)]</p>
        </div>
        <div class="flow-cards">
            @foreach (var flow in reviewSession.AllFlows)
            {
                <a class="flow-card" href="@WorkbenchUrls.Flow(flow.Id)">
                    <span class="flow-card-name" dir="auto"><BitIcon IconName="@BitIconName.Flow" Size="BitSize.Small" /> @flow.Name</span>
                    <span class="flow-card-meta">@Localizer[nameof(WorkbenchStrings.ScreenCount), flow.Screens.Length]@(flow.IsSample ? $" · {Localizer[nameof(WorkbenchStrings.FlowSample)]}" : null)</span>
                </a>
            }
            <a class="flow-card all-flows" href="@WorkbenchUrls.Flows">
                <span class="flow-card-name">@Localizer[nameof(WorkbenchStrings.AllFlows)]</span>
                <span class="flow-card-meta">@Localizer[reviewSession.AllFlows.Count > 0 ? nameof(WorkbenchStrings.AllFlowsHint) : reviewSession.CanWrite ? nameof(WorkbenchStrings.FlowsEmpty) : nameof(WorkbenchStrings.NoFlowsYet)]</span>
            </a>
        </div>
    </section>

    <section class="section">
        <Bmotion Preset="BmPresets.Reveal(distance: 24)">
            <div class="cta">
                <div class="cta-text">
                    <h2>@Localizer[nameof(WorkbenchStrings.HomeCtaTitle)]</h2>
                    <p>@Localizer[nameof(WorkbenchStrings.HomeCtaText)]</p>
                    @if (WorkbenchPageCatalog.Pages.FirstOrDefault() is { } firstPage)
                    {
                        <div class="cta-actions">
                            <BitButton Size="BitSize.Large" IconName="@BitIconName.Design" Href="@WorkbenchUrls.Workbench(firstPage.Key)">
                                @Localizer[nameof(WorkbenchStrings.HomeCtaOpen)]
                            </BitButton>
                        </div>
                    }
                </div>
                <figure class="prompt">
                    <figcaption class="prompt-label"><BitIcon IconName="@BitIconName.Robot" Size="BitSize.Small" /> @Localizer[nameof(WorkbenchStrings.HomeCtaPromptLabel)]</figcaption>
                    <blockquote class="prompt-text">@Localizer[nameof(WorkbenchStrings.HomeCtaPrompt)]</blockquote>
                    <BitButton Size="BitSize.Small" Variant="BitVariant.Outline"
                               IconName="@(isPromptCopied ? BitIconName.CheckMark : BitIconName.Copy)"
                               OnClick="CopyPrompt">
                        @Localizer[isPromptCopied ? nameof(WorkbenchStrings.HomeCtaCopied) : nameof(WorkbenchStrings.HomeCtaCopy)]
                    </BitButton>
                </figure>
            </div>
        </Bmotion>
    </section>

    <footer class="home-footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <a class="footer-logo" href="/#top">
                    <img src="_content/Boilerplate.Client.Core/images/bit-logo.svg" alt="" width="26" height="26" />
                    <span>@Localizer[nameof(WorkbenchStrings.WorkbenchTitle)]</span>
                </a>
                <p>@Localizer[nameof(WorkbenchStrings.HomeFooter)]</p>
            </div>
            <nav class="footer-links" aria-label="@Localizer[nameof(WorkbenchStrings.HomeFooterExplore)]">
                <h3>@Localizer[nameof(WorkbenchStrings.HomeFooterExplore)]</h3>
                @foreach (var entry in WorkbenchPageCatalog.Pages)
                {
                    <a href="@WorkbenchUrls.Workbench(entry.Key)">@Localizer[entry.TitleKey]</a>
                }
                <a href="@WorkbenchUrls.Progress">@Localizer[nameof(WorkbenchStrings.Progress)]</a>
                <a href="@WorkbenchUrls.Flows">@Localizer[nameof(WorkbenchStrings.Flows)]</a>
            </nav>
            <nav class="footer-links" aria-label="@Localizer[nameof(WorkbenchStrings.HomeFooterLearn)]">
                <h3>@Localizer[nameof(WorkbenchStrings.HomeFooterLearn)]</h3>
                <a href="https://bitplatform.dev/templates" target="_blank" rel="noopener">@Localizer[nameof(WorkbenchStrings.HomeFooterDocs)]</a>
                <a href="https://blazorui.bitplatform.dev" target="_blank" rel="noopener">@Localizer[nameof(WorkbenchStrings.HomeFooterComponents)]</a>
                <a href="https://github.com/bitfoundation/bitplatform" target="_blank" rel="noopener">@Localizer[nameof(WorkbenchStrings.HomeFooterSource)]</a>
            </nav>
        </div>
    </footer>

    <ChromeSnackBar />
</div>
