@inherits WorkbenchComponentBase

@switch (Kind)
{
    case AssistantCardKind.SalesTrend:
        <div class="card">
            <div class="card-head">
                <span class="card-title">@Localizer[nameof(WorkbenchStrings.AssistantSalesCardTitle)]</span>
                <span class="card-value">@PosFormat.Money(weekTotal, 0)</span>
                <span class="card-change">
                    <BitIcon IconName="@BitIconName.SortUp" Size="BitSize.Small" Color="BitColor.Success" />
                    @PosFormat.SignedPercent(weekChange)
                </span>
            </div>
            <div class="chart">
                <BitChart Type="BitChartType.Bar" Data="salesData" Options="salesOptions" Description="@Localizer[nameof(WorkbenchStrings.AssistantSalesCardTitle)]" Style="height:100%" />
            </div>
        </div>
        break;

    case AssistantCardKind.LowStock:
        <div class="card">
            @foreach (var (nameKey, left) in stockItems)
            {
                var isOrdered = orderedItems.Contains(nameKey);
                <div class="stock-row">
                    <span class="stock-name">@Localizer[nameKey]</span>
                    <BitTag Text="@Localizer[nameof(WorkbenchStrings.AssistantUnitsLeft), left]"
                            Variant="BitVariant.Outline"
                            Color="@(left <= 2 ? BitColor.Error : BitColor.Warning)"
                            Size="BitSize.Small" />
                    <BitButton Size="BitSize.Small"
                               Variant="@(isOrdered ? BitVariant.Text : BitVariant.Outline)"
                               IconName="@(isOrdered ? BitIconName.Accept : BitIconName.ShoppingCart)"
                               IsEnabled="isOrdered is false"
                               OnClick="() => orderedItems.Add(nameKey)">
                        @Localizer[isOrdered ? nameof(WorkbenchStrings.AssistantOrdered) : nameof(WorkbenchStrings.AssistantReorder)]
                    </BitButton>
                </div>
            }
        </div>
        break;

    case AssistantCardKind.PromoDraft:
        <div class="card promo">
            <BitIcon IconName="@BitIconName.Megaphone" Color="BitColor.Primary" />
            <p class="promo-text">@Localizer[nameof(WorkbenchStrings.AssistantPromoDraft)]</p>
            <BitButton Size="BitSize.Small"
                       Variant="BitVariant.Outline"
                       IconName="@(isCopied ? BitIconName.Accept : BitIconName.Copy)"
                       OnClick="CopyPromo">
                @Localizer[isCopied ? nameof(WorkbenchStrings.AssistantCopied) : nameof(WorkbenchStrings.AssistantCopy)]
            </BitButton>
        </div>
        break;
}
