@inherits WorkbenchComponentBase

<BitButton FullWidth IconName="@BitIconName.Add" OnClick="OnNewChat">@Localizer[nameof(WorkbenchStrings.AssistantNewChat)]</BitButton>
<BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary" Class="history-title">@Localizer[nameof(WorkbenchStrings.AssistantRecent)]</BitText>

@if (IsLoading)
{
    @for (var i = 0; i < 4; i++)
    {
        <BitShimmer Height="2.75rem" />
    }
}
else if (Conversations.Count is 0)
{
    <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer[nameof(WorkbenchStrings.AssistantNoHistory)]</BitText>
}
else
{
    @foreach (var conversation in Conversations)
    {
        <button type="button" class="history-item @(conversation == Current ? "active" : null)" @onclick="() => OnSelect.InvokeAsync(conversation)">
            <span class="history-item-title">@conversation.Title</span>
            <span class="history-item-date">@FormatDate(conversation.UpdatedAt)</span>
        </button>
    }
}
