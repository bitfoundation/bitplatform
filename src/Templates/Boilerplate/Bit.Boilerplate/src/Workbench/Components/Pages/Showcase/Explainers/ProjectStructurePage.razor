@inherits WorkbenchComponentBase

<BitMediaQuery ScreenQuery="BitScreenQuery.LtMd" OnChange="OnNarrowChanged" />

<div class="structure">
    <div class="intro">
        <BitText Typography="BitTypography.H5" Class="title">@Localizer[nameof(WorkbenchStrings.StructureHeading)]</BitText>
        <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer[nameof(WorkbenchStrings.StructureIntro)]</BitText>
    </div>

    <div class="legend">
        @foreach (var kind in Enum.GetValues<ProjectKind>())
        {
            <span class="legend-item kind-@kind.ToString().ToLowerInvariant()">
                <span class="legend-swatch"></span>
                @Localizer[$"StructureKind{kind}"]
            </span>
        }
    </div>

    <div class="canvas-box">
        @if (isLoading)
        {
            <BitShimmer Height="100%" Width="100%" />
        }
        else if (isFailed)
        {
            <div class="notice">
                <BitIcon IconName="@BitIconName.Error" Size="BitSize.Large" Color="BitColor.Warning" />
                <BitText Typography="BitTypography.Subtitle1">@Localizer[nameof(WorkbenchStrings.StructureLoadFailed)]</BitText>
                <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="Load">@Localizer[nameof(WorkbenchStrings.AssistantRetry)]</BitButton>
            </div>
        }
        else if (nodes.Count is 0)
        {
            <div class="notice">
                <BitIcon IconName="@BitIconName.Org" Size="BitSize.Large" Color="BitColor.Primary" />
                <BitText Typography="BitTypography.Subtitle1">@Localizer[nameof(WorkbenchStrings.StructureEmpty)]</BitText>
            </div>
        }
        else
        {
            <BlowCanvas @ref="canvas"
                        Nodes="nodes"
                        Edges="edges"
                        FitViewOnInit
                        NodesDraggable="false"
                        NodesConnectable="false"
                        ZoomOnScroll="false"
                        PreventScrolling="false"
                        OnNodeClick="Select"
                        Class="themed-flow">
                <NodeTemplate Context="node">
                    @if (node.Data is ProjectInfo project)
                    {
                        <BlowHandle Type="BlowHandleType.Target" Position="node.TargetPosition" IsConnectable="false" />
                        <div class="project kind-@project.Kind.ToString().ToLowerInvariant()">
                            <span class="project-icon"><BitIcon IconName="@project.IconName" /></span>
                            <span class="project-text">
                                <span class="project-name">@project.Name</span>
                                <span class="project-role">@Localizer[project.RoleKey]</span>
                            </span>
                        </div>
                        <BlowHandle Type="BlowHandleType.Source" Position="node.SourcePosition" IsConnectable="false" />
                    }
                </NodeTemplate>
                <ChildContent>
                    <BlowBackground />
                    <BlowControls />
                </ChildContent>
            </BlowCanvas>
        }
    </div>

    <div class="details">
        @if (selected is null)
        {
            <BitIcon IconName="@BitIconName.Info" Color="BitColor.Primary" />
            <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer[nameof(WorkbenchStrings.StructureSelectHint)]</BitText>
        }
        else
        {
            <span class="details-icon kind-@selected.Kind.ToString().ToLowerInvariant()"><BitIcon IconName="@selected.IconName" /></span>
            <div class="details-text">
                <BitText Typography="BitTypography.Subtitle1" Class="details-title">@selected.Name</BitText>
                <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer[selected.DescriptionKey]</BitText>
                @if (selected.References.Length > 0)
                {
                    <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary">
                        @Localizer[nameof(WorkbenchStrings.StructureReferences), string.Join(", ", selected.References.Select(key => ProjectStructureService.Projects.First(p => p.Key == key).Name))]
                    </BitText>
                }
            </div>
        }
    </div>
</div>
