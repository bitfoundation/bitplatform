@inherits LayoutComponentBase

<CascadingValue Value="currentDir">
    @* The app's BitParams, so the page's bit components get the same defaults as in the app *@
    <Boilerplate.Client.Core.Components.AppBitParams>
        @* A page that throws shows an error instead, which still tells the shell the view is ready *@
        <PageErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <LayoutError MarkReady />
            </ErrorContent>
        </PageErrorBoundary>
        @* Inside the BitParams, as the app's (MainLayout, within Routes' AppBitParams), so a modal the app opens, such as its
           code prompt with six boxes, gets the app's defaults and its modal class too. *@
        <BitModalContainer ModalParameters="modalParameters" />
    </Boilerplate.Client.Core.Components.AppBitParams>
</CascadingValue>
