@inherits WorkbenchComponentBase

<div class="pane @(IsSelected ? "selected" : null)" @onclick="Select">
    <div class="pane-header">
        <BitIcon IconName="@GetDeviceIconName(device)" Size="BitSize.Small" Color="BitColor.SecondaryForeground" />
        <BitText Typography="BitTypography.Body2" Class="pane-device" NoWrap>@device.Name</BitText>
        <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary" Class="pane-size" NoWrap>@SizeText</BitText>
        @foreach (var chip in GetChips())
        {
            <span class="pane-chip">@chip</span>
        }
        <BitSpacer />
        <BitButton IconOnly Size="BitSize.Small" Variant="BitVariant.Text"
                   IconName="@BitIconName.Rotate"
                   Title="@Localizer[nameof(WorkbenchStrings.Rotate)]"
                   AriaLabel="@Localizer[nameof(WorkbenchStrings.Rotate)]"
                   OnClick="() => OnRotate.InvokeAsync(Pane)" />
        <BitButton IconOnly Size="BitSize.Small" Variant="BitVariant.Text"
                   IconName="@BitIconName.Camera"
                   Title="@Localizer[nameof(WorkbenchStrings.ScreenshotThisView)]"
                   AriaLabel="@Localizer[nameof(WorkbenchStrings.ScreenshotThisView)]"
                   OnClick="DownloadScreenshot" />
        <BitButton IconOnly Size="BitSize.Small" Variant="BitVariant.Text"
                   IconName="@BitIconName.OpenInNewTab"
                   Href="@previewUrl" Target="_blank"
                   Title="@Localizer[nameof(WorkbenchStrings.OpenInNewTab)]"
                   AriaLabel="@Localizer[nameof(WorkbenchStrings.OpenInNewTab)]" />
        @if (CanRemove)
        {
            <BitButton IconOnly Size="BitSize.Small" Variant="BitVariant.Text"
                       IconName="@BitIconName.Cancel"
                       Title="@Localizer[nameof(WorkbenchStrings.RemoveView)]"
                       AriaLabel="@Localizer[nameof(WorkbenchStrings.RemoveView)]"
                       OnClick="() => OnRemove.InvokeAsync(Pane)" />
        }
    </div>

    <div class="pane-stage"
         style="@StageStyle"
         data-frame-width="@frameWidth"
         data-frame-height="@frameHeight"
         data-zoom="@Zoom"
         data-fit-width="@(FitWidth ? "true" : "false")">
        <div class="pane-scaler">
            <DeviceFrame Device="device"
                         Landscape="Pane.Scenario.Landscape"
                         ShowFrame="Pane.Scenario.Frame"
                         OnDarkContent="Pane.Scenario.Theme is WorkbenchThemeMode.Dark"
                         Address="@AddressText">
                <iframe @key="previewUrl" src="@previewUrl" title="@Localizer[Page.TitleKey]"></iframe>
            </DeviceFrame>
        </div>
        <div class="pane-loading">
            <BitRingLoading Size="BitSize.Small" />
        </div>
    </div>
</div>
