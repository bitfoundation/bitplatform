<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <CoreCompileDependsOn>PrepareResources;$(CompileDependsOn)</CoreCompileDependsOn>
    </PropertyGroup>

    <ItemGroup>
        <Content Remove="appsettings*.json" />
        <EmbeddedResource Include="appsettings*.json" />
        <EmbeddedResource Include="Components\Pages\Showcases\Buildings\Data\netherlands.geojson" />

        <PackageReference Include="Bit.BlazorUI.AI" />
        <PackageReference Include="Bit.Bmotion" />
        <PackageReference Include="Bit.Blex" />
        <PackageReference Include="Bit.Bcrdt" />
        <PackageReference Include="Bit.Bcrdt.Server" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <PackageReference Include="Bit.Bortable" />
        <PackageReference Include="Bit.Blow" />
        <PackageReference Include="Microsoft.Playwright" />

        <Using Include="System.Reflection" />
        <Using Include="System.Collections.Concurrent" />
        <Using Include="Microsoft.JSInterop" />
        <Using Include="Microsoft.Extensions.Logging" />
        <Using Include="Microsoft.AspNetCore.Components" />
        <Using Include="Bit.Butil" />
        <Using Include="Bit.BlazorUI" />
        <Using Include="Bit.Bmotion" />
        <Using Include="Bit.Blex" />
        <Using Include="Bit.Blex.Blazor" />
        <Using Include="Boilerplate.Shared" />
        <Using Include="Boilerplate.Shared.Resources" />
        <Using Include="Boilerplate.Shared.Infrastructure.Services" />
        <Using Include="Boilerplate.Client.Core.Infrastructure.Services" />
        <Using Include="Boilerplate.Client.Core.Infrastructure.Services.Contracts" />
        <Using Include="Boilerplate.Workbench.Resources" />
        <Using Include="Boilerplate.Workbench.Components" />
        <Using Include="Boilerplate.Workbench.Components.Layout" />
        <Using Include="Boilerplate.Workbench.Components.Shell" />
        <Using Include="Boilerplate.Workbench.Components.Chrome" />
        <Using Include="Boilerplate.Workbench.Components.Preview" />
        <Using Include="Boilerplate.Workbench.Components.Pages.AppPages.Settings" />
        <Using Include="Boilerplate.Workbench.Components.Pages.Showcases.Assistant" />
        <Using Include="Boilerplate.Workbench.Components.Pages.Showcases.Assistant.Data" />
        <Using Include="Boilerplate.Workbench.Components.Pages.Showcases.Buildings" />
        <Using Include="Boilerplate.Workbench.Components.Pages.Showcases.Buildings.Data" />
        <Using Include="Boilerplate.Workbench.Components.Pages.Showcases.Shifts" />
        <Using Include="Boilerplate.Workbench.Components.Pages.Showcases.Shifts.Data" />
        <Using Include="Boilerplate.Workbench.Components.Pages.Showcases.PosDashboard" />
        <Using Include="Boilerplate.Workbench.Components.Pages.Showcases.PosDashboard.Data" />
        <Using Include="Boilerplate.Workbench.Components.Pages.Showcases.PosDashboard.Widgets" />
        <Using Include="Boilerplate.Workbench.Components.Pages.Showcases.Theme" />
        <Using Include="Boilerplate.Workbench.Infrastructure.Models" />
        <Using Include="Boilerplate.Workbench.Infrastructure.Services" />
        <Using Include="Boilerplate.Workbench.Infrastructure.Extensions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Client\Boilerplate.Client.Core\Boilerplate.Client.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(Environment)' == 'Development'">
        <Compile Include="..\Server\Boilerplate.Server.Web\Infrastructure\Services\FileWatcherService.cs" Link="Infrastructure\Services\FileWatcherService.cs" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\WorkbenchStrings.resx">
            <Generator>MSBuild:Compile</Generator>
            <LastGenOutput>Resources\WorkbenchStrings.Designer.cs</LastGenOutput>
            <StronglyTypedFileName>$(IntermediateOutputPath)\WorkbenchStrings.Designer.cs</StronglyTypedFileName>
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
            <StronglyTypedNamespace>Boilerplate.Workbench.Resources</StronglyTypedNamespace>
            <StronglyTypedClassName>WorkbenchStrings</StronglyTypedClassName>
            <PublicClass>true</PublicClass>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\WorkbenchStrings.*.resx">
            <DependentUpon>Resources\WorkbenchStrings.resx</DependentUpon>
        </EmbeddedResource>
        <Content Include="..\..\Bit.ResxTranslator.json" Link="Resources\Bit.ResxTranslator.json" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="**\*.ts" Exclude="node_modules\**\*.ts" />
    </ItemGroup>

    <Target Name="BeforeBuildTasks" BeforeTargets="ResolveProjectStaticWebAssets;ResolveScopedCssInputs" Condition=" '$(DesignTimeBuild)' != 'true' ">
        <CallTarget Targets="InstallNodejsDependencies" />
        <CallTarget Targets="BuildJavaScript" />
        <CallTarget Targets="CopyAccessibilityChecker" />
        <CallTarget Targets="BuildCssFiles" />
        <ItemGroup>
            <Content Include="**\*.razor.css;wwwroot\scripts\workbench.js;wwwroot\scripts\axe.min.js;wwwroot\styles\workbench.css" Exclude="@(Content);@(None);node_modules\**;bin\**;obj\**" />
        </ItemGroup>
    </Target>

    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm install" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <Target Name="BuildJavaScript" Inputs="@(TypeScriptFiles);tsconfig.json;package.json;package-lock.json" Outputs="wwwroot\scripts\workbench.js">
        <Exec Command="node_modules/.bin/tsc" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Exec Command="node_modules/.bin/esbuild Scripts/index.ts --bundle --target=safari15,firefox100,chrome95 --outfile=wwwroot/scripts/workbench.js --minify --sourcemap" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <Target Name="CopyAccessibilityChecker" Inputs="node_modules\axe-core\axe.min.js" Outputs="wwwroot\scripts\axe.min.js">
        <Copy SourceFiles="node_modules\axe-core\axe.min.js" DestinationFolder="wwwroot\scripts" />
    </Target>

    <Target Name="BuildCssFiles">
        <Exec Command="node_modules/.bin/sass Components:Components Styles/workbench.scss:wwwroot/styles/workbench.css --style compressed --silence-deprecation=import --update --color" StandardOutputImportance="high" StandardErrorImportance="high" LogStandardErrorAsError="true" />
    </Target>

    <ItemGroup>
        <Content Remove="package*.json" />
        <Content Remove="tsconfig.json" />
        <None Include="package*json" />
        <None Include="tsconfig.json" />
    </ItemGroup>

</Project>
