@using Microsoft.AspNetCore.Components.Sections

<PageTitle>@(PageTitle ?? Title)</PageTitle>

@* Not a HeadContent of its own: only the last one rendered into the document's single HeadOutlet survives. *@
<SectionContent SectionName="@HeadSectionName">
    <meta name="description" content="@(Description ?? localizer[nameof(AppStrings.DescriptionMetaTagValue)])" />
    <link rel="canonical" href="@CanonicalUrl" />
    @Head
</SectionContent>
