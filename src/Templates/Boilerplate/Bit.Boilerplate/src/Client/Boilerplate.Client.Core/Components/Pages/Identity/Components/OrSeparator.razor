@inherits AppComponentBase

@if (IsInModal)
{
    <BitSeparator Border="BitColorKind.Secondary" Background="BitColorKind.Primary">@Localizer[nameof(AppStrings.Or)]</BitSeparator>
}
else
{
    <BitSeparator Border="BitColorKind.Tertiary" Background="BitColorKind.Secondary" Class="lg-sep">@Localizer[nameof(AppStrings.Or)]</BitSeparator>
    <BitSeparator Border="BitColorKind.Secondary" Background="BitColorKind.Primary" Class="sm-sep">@Localizer[nameof(AppStrings.Or)]</BitSeparator>
}