@inherits AppComponentBase

<section>
    <BitCard FullSize MinHeight="333px" Border="BitColorKind.Transparent">
        <BitStack Alignment="BitAlignment.Center" Gap="2rem">
            <BitStack Gap="0">
                <BitText Typography="BitTypography.H6">@Localizer[nameof(AppStrings.ProductsCountPerCategoryChart)]</BitText>
                <BitText Typography="BitTypography.Body2">
                    @Localizer[nameof(AppStrings.ProductsCountPerCategoryChartText)]
                </BitText>
            </BitStack>

            @if (isLoading && hasLoadedOnce is false)
            {
                <BitGridLoading Style="padding:2rem" />
            }
            else
            {
                <BitChart Config="config"
                          AriaLabel="@Localizer[nameof(AppStrings.ProductsCountPerCategoryChart)]"
                          Description="@Localizer[nameof(AppStrings.ProductsCountPerCategoryChartText)]" />
            }
        </BitStack>
    </BitCard>
</section>


