@inherits AppComponentBase

@* Shown by the ElevatedAccessService to collect the proof that AuthPolicies.ELEVATED_ACCESS asks for. *@

<section class="elevated-access">
    <BitStack Gap="0">
        <BitStack Horizontal Gap="0.75rem" AutoHeight VerticalAlign="BitAlignment.Center" Class="header-stack">
            <div class="badge header-badge">
                <BitIcon IconName="@BitIconName.Shield" FontSize="1.125rem" Color="BitColor.SecondaryForeground" />
            </div>

            <BitStack Gap="0.125rem" Grows Shrinkable>
                <BitText Id="elevated-access-title" Typography="BitTypography.Subtitle1" Weight="BitFontWeight.Semibold">
                    @Localizer[nameof(AppStrings.ElevatedAccessTitle)]
                </BitText>
                <BitText Typography="BitTypography.Caption1" Color="BitColor.SecondaryForeground">
                    @Localizer[nameof(AppStrings.ElevatedAccessSubtitle)]
                </BitText>
            </BitStack>

            <BitButton IconOnly
                       Variant="BitVariant.Text"
                       Color="BitColor.Tertiary"
                       IconName="@BitIconName.ChromeClose"
                       OnClick="WrapHandled(() => Complete(false))"
                       Title="@Localizer[nameof(AppStrings.Cancel)]"
                       AriaLabel="@Localizer[nameof(AppStrings.Cancel)]" />
        </BitStack>

        <BitStack Gap="1.25rem" Padding="1.25rem 1rem">
            @if (passkeyAvailable)
            {
                <BitCard Border="BitColorKind.Secondary" FullWidth Class="passkey-card">
                    <BitStack Horizontal Gap="0.75rem" VerticalAlign="BitAlignment.Center">
                        <div class="badge passkey-badge">
                            <BitIcon IconName="@BitIconName.Fingerprint" FontSize="1.125rem" />
                        </div>

                        <BitStack Gap="0.125rem" Grows Shrinkable>
                            <BitText Typography="BitTypography.Body1">@Localizer[nameof(AppStrings.ElevatedAccessPasskeyTitle)]</BitText>
                            <BitText Typography="BitTypography.Caption1" Color="BitColor.SecondaryForeground">
                                @Localizer[nameof(AppStrings.ElevatedAccessPasskeySubtitle)]
                            </BitText>
                        </BitStack>

                        <BitButton IsLoading="isPasskeyRunning"
                                   Disabled="IsBusy"
                                   ButtonType="BitButtonType.Button"
                                   OnClick="WrapHandled(ElevateWithPasskey)">
                            @Localizer[nameof(AppStrings.Verify)]
                        </BitButton>
                    </BitStack>
                </BitCard>

                <BitSeparator Border="BitColorKind.Secondary" Decorative>
                    <BitText Typography="BitTypography.Caption1" Color="BitColor.SecondaryForeground">
                        @Localizer[nameof(AppStrings.Or)]
                    </BitText>
                </BitSeparator>
            }

            <BitStack HorizontalAlign="BitAlignment.Center">
                <BitOtpInput @bind-Value="code"
                             AutoFocus
                             NoValidate
                             Sequential
                             Invalid="isCodeInvalid"
                             IsLoading="isVerifying"
                             Disabled="isPasskeyRunning"
                             Separator="-"
                             SeparatorInterval="3"
                             Label="@CodeLabel"
                             Description="@CodeDescription"
                             OnChange="@(_ => isCodeInvalid = false)"
                             OnFill="WrapHandled(async (string? _) => await Verify())" />
            </BitStack>

            <BitStack Horizontal Wrap Gap="0.5rem" AutoHeight VerticalAlign="BitAlignment.Center" Class="actions-stack">
                <BitButton Variant="BitVariant.Text"
                           Color="BitColor.Tertiary"
                           IsLoading="isSending"
                           Disabled="@(IsBusy || resendAvailableIn is not null)"
                           ButtonType="BitButtonType.Button"
                           OnClick="WrapHandled(SendCode)">
                    @SendButtonText
                </BitButton>

                <BitSpacer />

                <BitButton IsLoading="isVerifying"
                           Disabled="CanVerify is false"
                           ButtonType="BitButtonType.Button"
                           OnClick="WrapHandled(Verify)">
                    @Localizer[nameof(AppStrings.Confirm)]
                </BitButton>
            </BitStack>
        </BitStack>
    </BitStack>
</section>
