@using Bit.Bmage.Editor.Components
@using Bit.Bmage.Editor.Tools
@inherits AppComponentBase

<link rel="stylesheet" href="_content/Bit.Bmage/bit-bmage-editor.css" />

<section class="image-editor">
    <BitStack Gap="0">
        <BitStack Horizontal Gap="0.75rem" AutoHeight VerticalAlign="BitAlignment.Center" Class="header-stack">
            <BitText Id="image-editor-title" Typography="BitTypography.Subtitle1" Weight="BitFontWeight.Semibold" Class="title">
                @Localizer[nameof(AppStrings.EditImage)]
            </BitText>

            <BitButton IconOnly
                       Variant="BitVariant.Text"
                       Color="BitColor.Tertiary"
                       IconName="@BitIconName.ChromeClose"
                       OnClick="Cancel"
                       Title="@Localizer[nameof(AppStrings.Cancel)]"
                       AriaLabel="@Localizer[nameof(AppStrings.Cancel)]" />
        </BitStack>

        @if (couldNotOpenImage)
        {
            <BitStack Gap="1.25rem" Padding="1.25rem 1rem">
                <BitText Typography="BitTypography.Body1">@Localizer[nameof(AppStrings.ImageEditorCouldNotOpenImage)]</BitText>

                <BitStack Horizontal Wrap Gap="0.5rem" AutoHeight HorizontalAlign="BitAlignment.End">
                    <BitButton Variant="BitVariant.Text" ButtonType="BitButtonType.Button" OnClick="Cancel">
                        @Localizer[nameof(AppStrings.Cancel)]
                    </BitButton>
                    <BitButton ButtonType="BitButtonType.Button" OnClick="KeepOriginal">
                        @Localizer[nameof(AppStrings.UploadImageAsIs)]
                    </BitButton>
                </BitStack>
            </BitStack>
        }
        else
        {
            <div class="editor-host">
                <BmageEditor @ref="editor"
                             ShowPanel="false"
                             MaxProxyDimension="1024"
                             Direction="@(CurrentDir is BitDir.Rtl ? "rtl" : "ltr")"
                             AriaLabel="@Localizer[nameof(AppStrings.EditImage)]"
                             OnError="HandleEditorError">
                    <Toolbar Context="context">
                        <BitStack Horizontal Wrap Gap="0.25rem" AutoHeight VerticalAlign="BitAlignment.Center" Class="toolbar">
                            <BitButton IconOnly
                                       ButtonType="BitButtonType.Button"
                                       IconName="@BitIconName.Crop"
                                       Disabled="@(context.HasImage is false || context.IsBusy)"
                                       Variant="@(context.Tool is EditorToolKind.Crop ? BitVariant.Fill : BitVariant.Text)"
                                       OnClick="() => StartCrop(context)"
                                       Title="@Localizer[nameof(AppStrings.Crop)]"
                                       AriaLabel="@Localizer[nameof(AppStrings.Crop)]" />
                            <BitButton IconOnly
                                       Variant="BitVariant.Text"
                                       ButtonType="BitButtonType.Button"
                                       IconName="@BitIconName.Rotate90CounterClockwise"
                                       Disabled="@(context.HasImage is false || context.IsBusy)"
                                       OnClick="() => context.RotateAsync(-90)"
                                       Title="@Localizer[nameof(AppStrings.RotateLeft)]"
                                       AriaLabel="@Localizer[nameof(AppStrings.RotateLeft)]" />
                            <BitButton IconOnly
                                       Variant="BitVariant.Text"
                                       ButtonType="BitButtonType.Button"
                                       IconName="@BitIconName.Rotate90Clockwise"
                                       Disabled="@(context.HasImage is false || context.IsBusy)"
                                       OnClick="() => context.RotateAsync(90)"
                                       Title="@Localizer[nameof(AppStrings.RotateRight)]"
                                       AriaLabel="@Localizer[nameof(AppStrings.RotateRight)]" />
                            <BitButton IconOnly
                                       Variant="BitVariant.Text"
                                       ButtonType="BitButtonType.Button"
                                       IconName="@BitIconName.Undo"
                                       Disabled="@(context.CanUndo is false)"
                                       OnClick="context.Undo"
                                       Title="@Localizer[nameof(AppStrings.Undo)]"
                                       AriaLabel="@Localizer[nameof(AppStrings.Undo)]" />
                            <BitButton IconOnly
                                       Variant="BitVariant.Text"
                                       ButtonType="BitButtonType.Button"
                                       IconName="@BitIconName.Redo"
                                       Disabled="@(context.CanRedo is false)"
                                       OnClick="context.Redo"
                                       Title="@Localizer[nameof(AppStrings.Redo)]"
                                       AriaLabel="@Localizer[nameof(AppStrings.Redo)]" />

                            @if (context.Tool is EditorToolKind.Crop)
                            {
                                <BitButton Size="BitSize.Small"
                                           Variant="BitVariant.Outline"
                                           ButtonType="BitButtonType.Button"
                                           Disabled="@context.IsBusy"
                                           OnClick="context.ApplyCropAsync"
                                           Class="apply-crop">
                                    @Localizer[nameof(AppStrings.ApplyCrop)]
                                </BitButton>
                            }
                        </BitStack>
                    </Toolbar>
                </BmageEditor>
            </div>

            <BitStack Gap="0.75rem" Padding="0.75rem 1rem 1rem">
                @if (errorMessage is not null)
                {
                    <BitText Typography="BitTypography.Body2" Color="BitColor.Error" role="alert">@errorMessage</BitText>
                }
                else if (editor?.Tool is EditorToolKind.Crop)
                {
                    <BitText Typography="BitTypography.Body2" Color="BitColor.SecondaryForeground">@Localizer[nameof(AppStrings.ImageEditorCropHint)]</BitText>
                }

                <BitText Typography="BitTypography.Body2">
                    <BitLink Href="https://bmage.bitplatform.dev/editor" Target="_blank">@Localizer[nameof(AppStrings.ImageEditorMoreFeatures)]</BitLink>
                </BitText>

                <BitStack Horizontal Wrap Gap="0.5rem" AutoHeight HorizontalAlign="BitAlignment.End">
                    <BitButton Variant="BitVariant.Text" ButtonType="BitButtonType.Button" OnClick="Cancel">
                        @Localizer[nameof(AppStrings.Cancel)]
                    </BitButton>
                    <BitButton IsLoading="isSaving"
                               ButtonType="BitButtonType.Button"
                               Disabled="@(editor?.Session is null)"
                               OnClick="WrapHandled(Save)">
                        @Localizer[nameof(AppStrings.Save)]
                    </BitButton>
                </BitStack>
            </BitStack>
        }
    </BitStack>
</section>
