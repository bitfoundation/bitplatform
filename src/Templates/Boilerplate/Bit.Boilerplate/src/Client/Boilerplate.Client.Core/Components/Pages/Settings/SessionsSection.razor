@*+:cnd:noEmit*@
@inherits AppComponentBase

<section>
    <BitStack Padding="1px">
        @if (isLoading)
        {
            <BitStack Horizontal VerticalAlign="BitAlignment.Center">
                <BitShimmer Height="5rem" Circle Background="BitColor.PrimaryBackground" />
                <BitStack Gap="0.5rem">
                    <BitShimmer Height="1rem" Width="13rem" Background="BitColor.PrimaryBackground" />
                    <BitShimmer Height="1rem" Width="13rem" Background="BitColor.PrimaryBackground" />
                    <BitShimmer Height="1rem" Width="13rem" Background="BitColor.PrimaryBackground" />
                </BitStack>
            </BitStack>
        }
        @if (currentSession is not null)
        {
            @if (hasUnlimitedPrivilegedSessions is false)
            {
                <BitText Element="pre" ForceBreak PreserveWhitespace Typography="BitTypography.Body1">@Localizer[nameof(AppStrings.PrivilegedDeviceLimitMessage), maxPrivilegedSessionsCount.ToString("N0"), currentPrivilegedSessionsCount.ToString("N0")]</BitText>
            }
            <BitText>@Localizer[nameof(AppStrings.CurrentSession)]</BitText>
            <BitCard FullWidth>
                <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0">
                    <BitPersona PrimaryText="@currentSession.DisplayAddress"
                                SecondaryText="@currentSession.GetLastSeenOn(TimeProvider.GetUtcNow(), Localizer, TimeZoneService)"
                                TertiaryText="@currentSession.DeviceInfo"
                                Class="session-persona"
                                Size="BitPersonaSize.Size72"
                                ImageUrl="@currentSession.ImageUrl"
                                Styles="@(new() { Image = "width:50%;height:50%" })"
                                ImageInitials="@(currentSession.Privileged ? "✓" : "✘")"
                                CoinVariant="@(currentSession.Privileged ? BitVariant.Fill : BitVariant.Outline)"
                                Presence="@(IsOnline is null ? BitPersonaPresence.None : IsOnline is true ? BitPersonaPresence.Online : BitPersonaPresence.Offline)">
                        <PrimaryTextTemplate>
                            <div class="session-address">@currentSession.DisplayAddress</div>
                            @if (currentSession.DisplayIP is not null)
                            {
                                <div class="session-ip" title="@currentSession.DisplayIP">@currentSession.DisplayIP</div>
                            }
                        </PrimaryTextTemplate>
                    </BitPersona>
                    <BitSpacer />
                    @*#if (signalR == true || notification == true)*@
                    <BitIcon Title="@currentSession.GetNotificationStatusTitle(Localizer)"
                             IconName="@(currentSession.NotificationStatus is UserSessionNotificationStatus.Allowed ? BitIconName.Ringer : BitIconName.RingerOff)"
                             Color="@(currentSession.NotificationStatus is UserSessionNotificationStatus.Allowed ? BitColor.Success : BitColor.TertiaryForeground)" />
                    @*#endif*@
                </BitStack>
            </BitCard>
        }

        @if (otherSessions is not null && otherSessions.Any())
        {
            <br />
            <BitPullToRefresh OnRefresh="WrapHandled(async () => await LoadSessions(false))" ScrollerSelector=".sessions-list" FullWidth>
                <BitText>@Localizer[nameof(AppStrings.OtherSessions)]</BitText>
                <BitBasicList Items="otherSessions" Virtualize ItemSize="135" FullWidth Class="sessions-list" AriaLabel="@Localizer[nameof(AppStrings.OtherSessions)]">
                    <RowTemplate Context="session">
                        <BitCard role="listitem" FullWidth Style="margin-bottom:1rem">
                            <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0">
                                <BitPersona PrimaryText="@session.DisplayAddress"
                                            SecondaryText="@session.GetLastSeenOn(TimeProvider.GetUtcNow(), Localizer, TimeZoneService)"
                                            TertiaryText="@session.DeviceInfo"
                                            Size="BitPersonaSize.Size72"
                                            ImageUrl="@session.ImageUrl"
                                            Class="other-session-persona"
                                            Styles="@(new() { Image = "width:50%;height:50%" })"
                                            ImageInitials="@(session.Privileged ? "✓" : "✘")"
                                            Presence="@session.GetPresence(TimeProvider.GetUtcNow())"
                                            CoinVariant="@(session.Privileged ? BitVariant.Fill : BitVariant.Outline)">
                                    <PrimaryTextTemplate>
                                        <div class="session-address">@session.DisplayAddress</div>
                                        @if (session.DisplayIP is not null)
                                        {
                                            <div class="session-ip" title="@session.DisplayIP">@session.DisplayIP</div>
                                        }
                                    </PrimaryTextTemplate>
                                </BitPersona>
                                <BitSpacer />
                                @*#if (signalR == true || notification == true)*@
                                <BitIcon Title="@session.GetNotificationStatusTitle(Localizer)"
                                         IconName="@(session.NotificationStatus is UserSessionNotificationStatus.Allowed ? BitIconName.Ringer : BitIconName.RingerOff)"
                                         Color="@(session.NotificationStatus is UserSessionNotificationStatus.Allowed ? BitColor.Success : BitColor.TertiaryForeground)" />
                                @*#endif*@
                                <BitButton IconOnly
                                           Color="BitColor.Error"
                                           Variant="BitVariant.Text"
                                           IconName="@BitIconName.Delete"
                                           Loading="@revokingSessionIds.Contains(session.Id)"
                                           Title="@Localizer[nameof(AppStrings.RevokeSessionTitle)]"
                                           AriaLabel="@Localizer[nameof(AppStrings.RevokeSessionTitle)]"
                                           OnClick="WrapHandled(() => RevokeSession(session))" />
                            </BitStack>
                        </BitCard>
                    </RowTemplate>
                </BitBasicList>
            </BitPullToRefresh>
        }

        @if (applicationSessions.Any())
        {
            <br />
            <BitText>@Localizer[nameof(AppStrings.OAuthSessionsTitle)]</BitText>
            <BitText Typography="BitTypography.Caption1" Color="BitColor.SecondaryForeground">@Localizer[nameof(AppStrings.OAuthSessionsHint)]</BitText>
            <BitStack role="list" aria-label="@Localizer[nameof(AppStrings.OAuthSessionsTitle)]" Padding="2px" Gap="1rem">
                @foreach (var session in applicationSessions)
                {
                    <BitCard role="listitem" FullWidth>
                        <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0">
                            <BitPersona PrimaryText="@session.ApplicationName"
                                        SecondaryText="@session.GetLastSeenOn(TimeProvider.GetUtcNow(), Localizer, TimeZoneService)"
                                        TertiaryText="@session.DisplayAddress"
                                        Size="BitPersonaSize.Size72"
                                        ImageUrl="@session.ImageUrl"
                                        Class="other-session-persona"
                                        Styles="@(new() { Image = "width:50%;height:50%" })"
                                        Presence="@session.GetPresence(TimeProvider.GetUtcNow())">
                                <PrimaryTextTemplate>
                                    <div class="session-address">@session.ApplicationName</div>
                                    <div class="session-client-id" title="@session.OAuthClientId">@session.OAuthClientId</div>
                                </PrimaryTextTemplate>
                            </BitPersona>
                            <BitSpacer />
                            <BitButton IconOnly
                                       Color="BitColor.Error"
                                       Variant="BitVariant.Text"
                                       IconName="@BitIconName.PlugDisconnected"
                                       Loading="@revokingSessionIds.Contains(session.Id)"
                                       Title="@Localizer[nameof(AppStrings.OAuthClientRevokeAccess)]"
                                       AriaLabel="@Localizer[nameof(AppStrings.OAuthClientRevokeAccess)]"
                                       OnClick="WrapHandled(() => AskToRevokeApplication(session))" />
                        </BitStack>
                        @foreach (var description in session.ScopeDescriptions(Localizer))
                        {
                            <BitText Typography="BitTypography.Caption1" Color="BitColor.SecondaryForeground">@description</BitText>
                        }
                    </BitCard>
                }
            </BitStack>
        }
    </BitStack>
</section>

<BitDialog OnOk="WrapHandled(RevokeApplication)"
           @bind-IsOpen="isRevokeApplicationDialogOpen"
           OkText="@Localizer[nameof(AppStrings.OAuthClientRevokeAccess)]"
           CancelText="@Localizer[nameof(AppStrings.Cancel)]"
           Title="@Localizer[nameof(AppStrings.OAuthClientRevokeAccess)]"
           Message="@Localizer[nameof(AppStrings.OAuthSessionRevokeConfirmMessage), applicationToRevoke?.ApplicationName ?? ""]" />
