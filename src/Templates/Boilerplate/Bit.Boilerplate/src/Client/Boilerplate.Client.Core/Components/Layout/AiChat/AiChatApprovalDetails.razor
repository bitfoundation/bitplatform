@inherits AppComponentBase

@* Human in the loop: a tool whose effect the user can't take back, such as ClearAppFiles, runs only once the user approves
   it on screen. The model can only ask, and an approval left unanswered or cancelled counts as a no (See
   AppChatbot.ChatbotUi.AskApproval). This lists what the call will do, under the question it asks. Its words are the
   app's, fixed per tool, never the model's. A plain root element, so the scoped ::deep styles apply. *@
@if (consequences.Length > 0)
{
    <div class="approval-details">
        <BitText Typography="BitTypography.Body2" Color="BitColor.SecondaryForeground">@description</BitText>
        <BitStack Element="ul" Gap="0.5rem" Class="approval-consequences" AriaLabel="@Localizer[nameof(AppStrings.AiChatApprovalWhatHappens)]">
            @foreach (var (iconName, text) in consequences)
            {
                <BitStack @key="iconName" Element="li" Horizontal Gap="0.625rem" VerticalAlign="BitAlignment.Center">
                    <BitIcon IconName="@iconName" Color="BitColor.SecondaryForeground" />
                    <BitText Typography="BitTypography.Body2">@text</BitText>
                </BitStack>
            }
        </BitStack>
    </div>
}
