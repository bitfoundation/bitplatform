@using Boilerplate.Client.Core.Components.Layout.AiChat
@inherits AppComponentBase

<BitMediaQuery ScreenQuery="BitScreenQuery.LtSm" OnChange="isMatched => isSmallScreen = isMatched" />

@* A plain root element, so the scoped ::deep styles apply. The chat starts downloading the moment the pointer, a finger or the
   focus is on its button (See Prepare), so it's mostly there by the click. *@
<section @onpointerenter="Prepare" @onfocusin="Prepare" @ontouchstart="Prepare">
    <BitButton Float
               Rounded
               Draggable
               FloatOffset="2rem"
               OnClick="WrapHandled(Open)"
               FloatPosition="BitPosition.BottomEnd"
               Color="@(status.IsInVoiceCall ? BitColor.Error : BitColor.Primary)"
               IconName="@(status.IsInVoiceCall ? BitIconName.Phone : BitIconName.ChatBot)"
               Class="@($"open-panel-button{(status.IsInVoiceCall ? " in-call" : null)}{(status.NeedsAnswer ? " needs-answer" : null)}")"
               Title="@(status.IsInVoiceCall ? Localizer[nameof(AppStrings.AiChatPanelBackToVoiceCall)] : Localizer[nameof(AppStrings.AiChatPanelTitle)])"
               AriaLabel="@(status.IsInVoiceCall ? Localizer[nameof(AppStrings.AiChatPanelBackToVoiceCall)] : Localizer[nameof(AppStrings.AiChatPanelTitle)])" />

    @* Kept mounted, so what is typed survives closing the panel, and a voice call and an answer go on behind it. *@
    <BitPanel @bind-IsOpen="isOpen"
              KeepMounted
              TitleAriaId="ai-chat-panel-title"
              ShowCloseButton
              ModeFull="isSmallScreen is true"
              Modeless="isSmallScreen is false"
              OnDismiss="WrapHandled(HandleOnDismissPanel)"
              Classes="@(new() { Container = $"panel-cnt{(isMaximized ? " maximized" : null)}", Body = "panel-body" })">
        <Header>
            <BitStack Horizontal Alignment="BitAlignment.Center">
                <BitText Id="ai-chat-panel-title" Typography="BitTypography.H5">@Localizer[nameof(AppStrings.AiChatPanelTitle)]</BitText>
                @if (isLoading)
                {
                    <BitRollingSquareLoading Size="BitSize.Small" />
                }
                <BitSpacer />
                <BitButton IconOnly
                           FixedColor
                           Variant="BitVariant.Text"
                           IconName="@BitIconName.Delete"
                           OnClick="WrapHandled(ClearChat)"
                           Color="BitColor.SecondaryBackground"
                           Disabled="chat is null"
                           Title="@Localizer[nameof(AppStrings.Clear)]"
                           AriaLabel="@Localizer[nameof(AppStrings.Clear)]" />

                <BitButton IconOnly
                           FixedColor
                           Variant="BitVariant.Text"
                           Color="BitColor.SecondaryBackground"
                           OnClick="() => isMaximized = !isMaximized"
                           IconName="@(isMaximized ? BitIconName.BackToWindow : BitIconName.FullScreen)"
                           Title="@(isMaximized ? Localizer[nameof(AppStrings.AiChatPanelRestore)] : Localizer[nameof(AppStrings.AiChatPanelMaximize)])"
                           AriaLabel="@(isMaximized ? Localizer[nameof(AppStrings.AiChatPanelRestore)] : Localizer[nameof(AppStrings.AiChatPanelMaximize)])" />
            </BitStack>
        </Header>
        <Body>
            <div class="body" onpointerdown="event.stopPropagation()">
                @* Built on Bit.BlazorUI.AI, so it renders only once EnsureLoaded has loaded that. *@
                @if (isLoaded)
                {
                    <AppAiChat @ref="chat" InitialPrompt="@initialPrompt" OnStatusChanged="HandleOnStatusChanged" EnsureSignedIn="EnsureSignedIn" />
                }
                else if (hasFailed)
                {
                    <BitStack Alignment="BitAlignment.Center" Class="load-failed">
                        <BitText Color="BitColor.SecondaryForeground">@Localizer[nameof(AppStrings.AiChatPanelVoiceCallAssistantFailed)]</BitText>
                        <BitButton Variant="BitVariant.Outline" OnClick="WrapHandled(EnsureLoaded)">@Localizer[nameof(AppStrings.AiChatRetry)]</BitButton>
                    </BitStack>
                }
            </div>
        </Body>
    </BitPanel>
</section>
