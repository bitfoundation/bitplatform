@*+:cnd:noEmit*@
@inherits AppComponentBase;

<section @ref="sectionRef">
    <BitNavBar FullWidth TItem="BitNavBarOption">

        <BitNavBarOption Text="@Localizer[nameof(AppStrings.Home)]" IconName="@BitIconName.Home" Url="@PageUrls.Home" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.Home)" />

        @*#if (offlineDb == true)*@
        <AuthorizeView Policy="@AppFeatures.Todo.Todo_Manage_Self">
            <BitNavBarOption Text="@Localizer[nameof(AppStrings.OfflineTodoTitle)]" IconName="@BitIconName.ToDoLogoOutline" Url="@PageUrls.OfflineTodo" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.OfflineTodo)" />
        </AuthorizeView>
        @*#elseif (sample == true)*@
        <AuthorizeView Policy="@AppFeatures.Todo.Todo_Manage_Self">
            <BitNavBarOption Text="@Localizer[nameof(AppStrings.Todo)]" IconName="@BitIconName.ToDoLogoInverse" Url="@PageUrls.Todo" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.Todo)" />
        </AuthorizeView>
        @*#endif*@

        @*#if (module == "Admin" && multitenant == true)*@
        <AuthorizeView Policy="@AppFeatures.AdminPanel.Dashboard_View">
            <AuthorizeView Policy="@AuthPolicies.TENANT_SELECTED" Context="_">
                <BitNavBarOption Text="@Localizer[nameof(AppStrings.Dashboard)]" IconName="@BitIconName.BarChartVerticalFill" Url="@PageUrls.Dashboard" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.Dashboard)" />
            </AuthorizeView>
        </AuthorizeView>
        <AuthorizeView Policy="@AppFeatures.AdminPanel.ProductCatalog_Manage">
            <AuthorizeView Policy="@AuthPolicies.TENANT_SELECTED" Context="_">
                <BitNavBarOption Text="@Localizer[nameof(AppStrings.Categories)]" IconName="@BitIconName.BuildQueue" Url="@PageUrls.Categories" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.Categories)" />
                <BitNavBarOption Text="@Localizer[nameof(AppStrings.Products)]" IconName="@BitIconName.Product" Url="@PageUrls.Products" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.Products)" />
            </AuthorizeView>
        </AuthorizeView>
        @*#elseif (module == "Admin")*@
        <AuthorizeView Policy="@AppFeatures.AdminPanel.Dashboard_View">
            <BitNavBarOption Text="@Localizer[nameof(AppStrings.Dashboard)]" IconName="@BitIconName.BarChartVerticalFill" Url="@PageUrls.Dashboard" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.Dashboard)" />
        </AuthorizeView>
        <AuthorizeView Policy="@AppFeatures.AdminPanel.ProductCatalog_Manage">
            <BitNavBarOption Text="@Localizer[nameof(AppStrings.Categories)]" IconName="@BitIconName.BuildQueue" Url="@PageUrls.Categories" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.Categories)" />
            <BitNavBarOption Text="@Localizer[nameof(AppStrings.Products)]" IconName="@BitIconName.Product" Url="@PageUrls.Products" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.Products)" />
        </AuthorizeView>
        @*#endif*@

        <BitNavBarOption Text="@Localizer[nameof(AppStrings.Terms)]" IconName="@BitIconName.EntityExtraction" Url="@PageUrls.Terms" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.Terms)" />

        @*#if (module != "Admin" && (sample != true && offlineDb != true))*@
        <BitNavBarOption Text="@Localizer[nameof(AppStrings.About)]" IconName="@BitIconName.Info" Url="@PageUrls.About" AdditionalUrls="@CultureInfoManager.GetCultureUrls(PageUrls.About)" />
        @*#endif*@

    </BitNavBar>
</section>