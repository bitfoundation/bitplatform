@*+:cnd:noEmit*@
@* [mirror] app chrome - nav panel, header, account menu and bottom bar - keep in sync with: *@
@* - src/Workbench/Components/Chrome/ChromeShell.razor *@
@inherits AppComponentBase;

<section>
    <BitNavBar FullWidth TItem="BitNavBarOption">

        <BitNavBarOption Text="@Localizer[nameof(AppStrings.Home)]" IconName="@BitIconName.Home" Url="@UrlOf(PageUrls.Home)" AdditionalUrls="@AddressesOf(PageUrls.Home)" />

        @*#if (offlineDb == true)*@
        <AuthorizeView Policy="@AppFeatures.Todo.Todo_Manage_Self">
            <BitNavBarOption Text="@Localizer[nameof(AppStrings.OfflineTodoTitle)]" IconName="@BitIconName.ToDoLogoOutline" Url="@UrlOf(PageUrls.OfflineTodo)" AdditionalUrls="@AddressesOf(PageUrls.OfflineTodo)" />
        </AuthorizeView>
        @*#elseif (sample == true)*@
        <AuthorizeView Policy="@AppFeatures.Todo.Todo_Manage_Self">
            <BitNavBarOption Text="@Localizer[nameof(AppStrings.Todo)]" IconName="@BitIconName.ToDoLogoInverse" Url="@UrlOf(PageUrls.Todo)" AdditionalUrls="@AddressesOf(PageUrls.Todo)" />
        </AuthorizeView>
        @*#endif*@

        @*#if (module == "Admin" && multitenant == true)*@
        <AuthorizeView Policy="@AppFeatures.AdminPanel.Dashboard_View">
            <AuthorizeView Policy="@AuthPolicies.TENANT_SELECTED" Context="_">
                <BitNavBarOption Text="@Localizer[nameof(AppStrings.Dashboard)]" IconName="@BitIconName.BarChartVerticalFill" Url="@UrlOf(PageUrls.Dashboard)" AdditionalUrls="@AddressesOf(PageUrls.Dashboard)" />
            </AuthorizeView>
        </AuthorizeView>
        <AuthorizeView Policy="@AppFeatures.AdminPanel.ProductCatalog_Manage">
            <AuthorizeView Policy="@AuthPolicies.TENANT_SELECTED" Context="_">
                <BitNavBarOption Text="@Localizer[nameof(AppStrings.Categories)]" IconName="@BitIconName.BuildQueue" Url="@UrlOf(PageUrls.Categories)" AdditionalUrls="@AddressesOf(PageUrls.Categories)" />
                <BitNavBarOption Text="@Localizer[nameof(AppStrings.Products)]" IconName="@BitIconName.Product" Url="@UrlOf(PageUrls.Products)" AdditionalUrls="@AddressesOf(PageUrls.Products)" />
            </AuthorizeView>
        </AuthorizeView>
        @*#elseif (module == "Admin")*@
        <AuthorizeView Policy="@AppFeatures.AdminPanel.Dashboard_View">
            <BitNavBarOption Text="@Localizer[nameof(AppStrings.Dashboard)]" IconName="@BitIconName.BarChartVerticalFill" Url="@UrlOf(PageUrls.Dashboard)" AdditionalUrls="@AddressesOf(PageUrls.Dashboard)" />
        </AuthorizeView>
        <AuthorizeView Policy="@AppFeatures.AdminPanel.ProductCatalog_Manage">
            <BitNavBarOption Text="@Localizer[nameof(AppStrings.Categories)]" IconName="@BitIconName.BuildQueue" Url="@UrlOf(PageUrls.Categories)" AdditionalUrls="@AddressesOf(PageUrls.Categories)" />
            <BitNavBarOption Text="@Localizer[nameof(AppStrings.Products)]" IconName="@BitIconName.Product" Url="@UrlOf(PageUrls.Products)" AdditionalUrls="@AddressesOf(PageUrls.Products)" />
        </AuthorizeView>
        @*#endif*@

        <BitNavBarOption Text="@Localizer[nameof(AppStrings.Terms)]" IconName="@BitIconName.EntityExtraction" Url="@UrlOf(PageUrls.Terms)" AdditionalUrls="@AddressesOf(PageUrls.Terms)" />

        @*#if (module != "Admin" && (sample != true && offlineDb != true))*@
        <BitNavBarOption Text="@Localizer[nameof(AppStrings.About)]" IconName="@BitIconName.Info" Url="@UrlOf(PageUrls.About)" AdditionalUrls="@AddressesOf(PageUrls.About)" />
        @*#endif*@

    </BitNavBar>
</section>