@inherits AppComponentBase

<section>
    <BitStack HorizontalAlign="BitAlignment.Center" Class="max-width">
        <BitText Typography="BitTypography.Body1" Align="BitTextAlign.Center">
            @Localizer[nameof(AppStrings.PinDescription)]
        </BitText>

        @if (hasPin && isEditing is false)
        {
            <BitText Typography="BitTypography.Body1" Weight="BitFontWeight.Semibold" Align="BitTextAlign.Center">
                @Localizer[nameof(AppStrings.PinIsSet)]
            </BitText>

            <BitStack Horizontal Wrap AutoHeight HorizontalAlign="BitAlignment.Center">
                <BitButton IsLoading="isWaiting" OnClick="WrapHandled(StartChange)">
                    @Localizer[nameof(AppStrings.ChangePin)]
                </BitButton>
                <BitButton Color="BitColor.Error" Variant="BitVariant.Outline" Disabled="isWaiting" OnClick="WrapHandled(RemovePin)">
                    @Localizer[nameof(AppStrings.RemovePin)]
                </BitButton>
            </BitStack>
        }
        else
        {
            <PinInput @ref="pinInput"
                      @bind-Value="pin"
                      AutoFocus="isEditing"
                      IsLoading="isWaiting"
                      Invalid="isMismatch"
                      Label="@Localizer[firstPin is null ? nameof(AppStrings.NewPin) : nameof(AppStrings.RepeatPin)]"
                      Description="@(isMismatch ? Localizer[nameof(AppStrings.PinsDoNotMatch)] : null)"
                      OnFill="WrapHandled(async (string? value) => await OnPinFill(value))" />

            @if (isEditing)
            {
                <BitButton Variant="BitVariant.Text" Disabled="isWaiting" OnClick="CancelChange">
                    @Localizer[nameof(AppStrings.Cancel)]
                </BitButton>
            }
        }
        <br />
    </BitStack>
</section>
