@*+:cnd:noEmit*@
@inherits LayoutComponentBase

@*#if (multitenant == true)*@
<CascadingValue Value="currentTenant">
    @*#endif*@
    <CascadingValue Value="currentDir">
        <CascadingValue Value="currentUser">
            <CascadingValue Value="currentTheme">
                <CascadingValue Value="currentRouteData">
                    <CascadingValue Name="@Parameters.IsOnline" Value="IsOnline">

                        <AppHeadCoordinator />

                        @* Only @Body goes inside: AppShell skips the renders whose parameters didn't change (See AppShell.GetParametersRenderKey). *@
                        <AppShell NavPanelItems="navPanelItems" IsIdentityPage="isIdentityPage">
                            @Body
                        </AppShell>

                        <ForceUpdateSnackBar />
                        <AppSnackBar />
                        <AppDiagnosticModal />
                        <JobProgress />
                        <BitModalContainer ModalParameters="ModalParameters" />
                        <AppJsBridge />
                        <AppFileSaveAnchor />
                        <AppConsentBanner />

                        @*#if (signalR == true)*@
                        <AppAiChatPanel />
                        @*#endif*@

                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
    @*#if (multitenant == true)*@
</CascadingValue>
@*#endif*@
