@using Bit.Belemetry

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")" @attributes="BitThemeSsr.BuildRootThemeAttributeMap(null, themeOptions)">

<head>
    <meta charset="utf-8" />
    <base href="/" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <BitThemeHead Options="@themeOptions" />
    @if (OmitScripts is false)
    {
        <BelemetryScript />
        <script>
            @* iOS Safari zooms in when a field under 16px gets the focus *@
            (/iPad|iPhone|iPod/.test(navigator.userAgent)) &&
                (document.querySelector('meta[name="viewport"]').content = 'width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover');
        </script>
    }

    @if (string.IsNullOrWhiteSpace(settings.Site.GoogleSiteVerification) is false)
    {
        <meta name="google-site-verification" content="@settings.Site.GoogleSiteVerification" />
    }
    @if (string.IsNullOrWhiteSpace(settings.Site.BingSiteVerification) is false)
    {
        <meta name="msvalidate.01" content="@settings.Site.BingSiteVerification" />
    }

    <Link rel="stylesheet" Href="_content/Bit.BlazorUI/styles/bit.blazorui.css" />
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.Icons/styles/bit.blazorui.icons.css" />
    <Link rel="stylesheet" Href="_content/Bit.BlazorUI.Extras/styles/bit.blazorui.extras.css" />
    <Link rel="stylesheet" Href="styles/landing.css" />
    <Link rel="stylesheet" Href="Boilerplate.LandingPage.Server.styles.css" />

    <HeadOutlet @rendermode="settings.WebAppRender.RenderMode" />
</head>

<body>
    <Routes @rendermode="settings.WebAppRender.RenderMode" />

    @if (OmitScripts is false)
    {
        <Script Src="_framework/bit.blazor.web.es2019.js" autostart="false"></Script>
        <script>
            (() => {
                @* Bswup calls Blazor.start itself, so the culture the page was rendered in is added to its options, and the OTLP endpoint to the runtime's variables *@
                const start = Blazor.start;
                Blazor.start = options => start({ ...options, webAssembly: { ...options?.webAssembly, applicationCulture: '@CultureInfo.CurrentUICulture.Name', configureRuntime: runtime => { options?.webAssembly?.configureRuntime?.(runtime); runtime.withEnvironmentVariables(@((MarkupString)WebAssemblyEnvironmentVariables)); } } });

                @* A first install and an update both start at once: the browser keeps the scroll position, and these pages have little to lose *@
                window.bitBswupHandler = (message, data) => {
                    if ((message === 'DOWNLOAD_FINISHED' && data?.firstInstall) || message === 'UPDATE_READY') {
                        data.reload();
                    }
                };
            })();
        </script>
        <Script Src="_content/Bit.Bswup/bit-bswup.js" sw="service-worker.js" blazorScript="_framework/bit.blazor.web.es2019.js" updateInterval="600" updateOnVisibility="true"></Script>
        <Script Src="_content/Bit.Butil/bit-butil.js"></Script>
        <Script Src="_content/Bit.BlazorUI/scripts/bit.blazorui.js"></Script>
        <Script Src="_content/Bit.BlazorUI.Extras/scripts/bit.blazorui.extras.js"></Script>
        <Script Src="scripts/landing.js"></Script>
    }
</body>

</html>
