<EmailLayout SiteName="@SiteName" AccentColor="@AccentColor" UnsubscribeUrl="@UnsubscribeUrl" Preview="@L[nameof(LandingStrings.LaunchEmailPreview), SiteName]">
    <h1 style="margin:0 0 12px;font-size:24px;line-height:1.3;font-weight:700;color:#17171A">@L[nameof(LandingStrings.LaunchEmailTitle), SiteName]</h1>
    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:#3F3F46">@L[nameof(LandingStrings.LaunchEmailBody)]</p>
    <table role="presentation" cellpadding="0" cellspacing="0">
        @foreach (var link in Links)
        {
            <tr>
                <td style="padding:0 0 10px">
                    <a href="@link.Url" style="display:inline-block;min-width:200px;padding:12px 20px;border-radius:10px;background:@AccentColor;color:#FFFFFF;font-size:15px;font-weight:600;text-decoration:none">@link.Label</a>
                </td>
            </tr>
        }
    </table>
</EmailLayout>

