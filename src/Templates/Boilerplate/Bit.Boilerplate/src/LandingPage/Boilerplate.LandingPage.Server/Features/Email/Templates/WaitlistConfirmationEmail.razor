<EmailLayout SiteName="@SiteName" AccentColor="@AccentColor" UnsubscribeUrl="@UnsubscribeUrl" Preview="@L[nameof(LandingStrings.WaitlistEmailPreview), SiteName]">
    <h1 style="margin:0 0 12px;font-size:24px;line-height:1.3;font-weight:700;color:#17171A">@L[nameof(LandingStrings.WaitlistEmailTitle)]</h1>
    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:#3F3F46">@L[nameof(LandingStrings.WaitlistEmailBody), SiteName]</p>
    <a href="@ConfirmUrl" style="display:inline-block;padding:14px 24px;border-radius:10px;background:@AccentColor;color:#FFFFFF;font-size:16px;font-weight:600;text-decoration:none">@L[nameof(LandingStrings.WaitlistEmailButton)]</a>
    @if (Position > 0)
    {
        <p style="margin:24px 0 0;font-size:14px;line-height:1.6;color:#52525B">@L[nameof(LandingStrings.WaitlistEmailPosition), Position]</p>
    }
    <p style="margin:24px 0 0;font-size:13px;line-height:1.6;color:#71717A">@L[nameof(LandingStrings.WaitlistEmailIgnore)]</p>
</EmailLayout>

