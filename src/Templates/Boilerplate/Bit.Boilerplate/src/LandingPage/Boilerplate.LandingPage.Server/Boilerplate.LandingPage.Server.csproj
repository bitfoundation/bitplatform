<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <UserSecretsId>AC87AA5B-4B37-4E52-8468-2D5DF24AF256</UserSecretsId>
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
        <NoWarn>$(NoWarn);SYSLIB1100;SYSLIB1101</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Environment)' != 'Development' And '$(SelfContained)' == 'true'">
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bit.BlazorES2019" />
        <PackageReference Include="Bit.BlazorUI.Assets" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
        <PackageReference Include="Microsoft.Extensions.AI" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
        <PackageReference Include="FluentEmail.Smtp" />
        <PackageReference Include="QRCoder" />
        <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Boilerplate.LandingPage.Client\Boilerplate.LandingPage.Client.csproj" />

        <Using Include="System.Net" />
        <Using Include="Microsoft.AspNetCore.Components" />
        <Using Include="Bit.BlazorUI" />
        <Using Include="Boilerplate.LandingPage.Client" />
        <Using Include="Boilerplate.LandingPage.Client.Resources" />
        <Using Include="Boilerplate.LandingPage.Client.Infrastructure" />
        <Using Include="Boilerplate.LandingPage.Client.Infrastructure.Models" />
        <Using Include="Boilerplate.LandingPage.Client.Infrastructure.Services" />
        <Using Include="Boilerplate.LandingPage.Server" />
        <Using Include="Boilerplate.LandingPage.Server.Infrastructure" />
        <Using Include="Boilerplate.LandingPage.Server.Infrastructure.Services" />
    </ItemGroup>

    <ItemGroup Condition="'$(Environment)' == 'Development'">
        <Compile Include="..\..\Server\Boilerplate.Server.Web\Infrastructure\Services\FileWatcherService.cs" Link="Infrastructure\Services\FileWatcherService.cs" />
    </ItemGroup>

    <PropertyGroup>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <EnableSdkContainerDebugging Condition="'$(Environment)' == 'Development'">True</EnableSdkContainerDebugging>
    </PropertyGroup>

</Project>
