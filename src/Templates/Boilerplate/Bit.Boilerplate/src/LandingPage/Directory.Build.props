<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup Condition=" '$(InvariantGlobalization)' == 'true' ">
        <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    </PropertyGroup>

    <PropertyGroup>
        <!-- The bit BlazorUI scripts as modules, each downloaded the first time a component on the page calls into it, rather
             than as bundles every page loads: App.razor has no <script> of theirs, and the chat's arrive with the chat. -->
        <BitBlazorUILazyScripts>true</BitBlazorUILazyScripts>
    </PropertyGroup>

    <ItemGroup>
        <Using Remove="Boilerplate.Shared" />
        <Using Remove="Boilerplate.Shared.Resources" />
        <Using Remove="Boilerplate.Shared.Infrastructure.Dtos" />
        <Using Remove="Boilerplate.Shared.Infrastructure.Services" />
        <Using Remove="Boilerplate.Shared.Infrastructure.Exceptions" />
        <Using Remove="Boilerplate.Shared.Infrastructure.Attributes" />
        <Using Remove="Boilerplate.Shared.Infrastructure.Services.Contracts" />
        <Using Remove="Microsoft.Extensions.Caching.Memory" />
    </ItemGroup>
</Project>
