@inherits LandingComponentBase

<a class="gallery-card crm-card" href="@LocalUrl(CrmSite.Path)">
    <div class="crm-card-preview" aria-hidden="true">
        <div class="crm-card-bar">
            <span class="crm-card-brand"><CrmLogo /> Brightlane</span>
            <span class="crm-card-forecast">€79,430</span>
        </div>
        <div class="crm-card-lanes">
            <div><i></i><b></b><b></b></div>
            <div><i></i><b></b><b class="is-moving"></b></div>
            <div><i></i><b></b></div>
            <div class="is-won"><i></i><b></b></div>
        </div>
    </div>
    <div class="gallery-card-body">
        <p class="gallery-card-industry">@R[nameof(CrmStrings.CardIndustry)]</p>
        <h2>Brightlane</h2>
        <p>@R[nameof(CrmStrings.CardSummary)]</p>
        <ul class="gallery-card-tags">
            <li class="is-mode">@L[nameof(LandingStrings.GalleryModeLaunched)]</li>
            <li>@R[nameof(CrmStrings.CardTag1)]</li>
            <li>@R[nameof(CrmStrings.CardTag2)]</li>
            <li>@R[nameof(CrmStrings.CardTag3)]</li>
        </ul>
    </div>
</a>
