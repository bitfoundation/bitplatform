@attribute [Route(LandingRoutes.NotFound)]
@layout EmptyLayout
@inherits LandingComponentBase

<PageTitle>@Localizer[nameof(LandingStrings.NotFoundTitle)]</PageTitle>

<LayoutView Layout="@(site?.Layout ?? typeof(SiteLayout))">
    @if (site is not null)
    {
        <DynamicComponent Type="site.NotFound" />
    }
    else
    {
        <section class="lp-container lp-section not-found">
            <h1 class="lp-title">@Localizer[nameof(LandingStrings.NotFoundTitle)]</h1>
            <p class="lp-lede">@Localizer[nameof(LandingStrings.NotFoundBody)]</p>
            <BitButton Href="@LocalUrl(LandingRoutes.Home)">@Localizer[nameof(LandingStrings.BackToHome)]</BitButton>
        </section>
    }
</LayoutView>
