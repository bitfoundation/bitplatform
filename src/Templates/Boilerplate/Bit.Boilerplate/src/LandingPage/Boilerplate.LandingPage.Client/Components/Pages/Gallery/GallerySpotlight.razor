@inherits LandingComponentBase

<div class="gallery-spotlight">
    <BitPivot @bind-SelectedKey="selected"
              Placement="BitPlacement.Start"
              SelectOnFocus
              MountAll
              AriaLabel="@Localizer[nameof(LandingStrings.GalleryEyebrow)]"
              Class="gallery-spotlight-pivot">
        @foreach (var sample in Samples)
        {
            <BitPivotItem @key="sample.Key" Key="@sample.Key" Class="@($"gallery-spot-tab gallery-brand-{sample.Key}")">
                <Header>
                    <span class="gallery-logo gallery-spot-logo"><DynamicComponent Type="sample.Site.Logo" /></span>
                    <span class="gallery-spot-label">
                        <span class="gallery-spot-name">@sample.Site.Name</span>
                        <span class="gallery-spot-industry">@sample.CardIndustry</span>
                    </span>
                </Header>
                <Body>
                    <article class="gallery-stage gallery-brand-@sample.Key">
                        <a class="gallery-stage-shot" href="@sample.Url" tabindex="-1" aria-hidden="true">
                            <img loading="lazy" decoding="async" class="is-light" src="@sample.Shot("light")" width="800" height="500" alt="" />
                            <img loading="lazy" decoding="async" class="is-dark" src="@sample.Shot("dark")" width="800" height="500" alt="" />
                        </a>
                        <div class="gallery-stage-text">
                            <p class="gallery-stage-meta">
                                <span>@sample.CardIndustry</span>
                                <span class="gallery-stage-mode">@sample.Mode</span>
                            </p>
                            <h2>@sample.Site.Name</h2>
                            <p class="gallery-stage-summary">@sample.CardSummary</p>
                            <div class="gallery-stage-foot">
                                <ul class="gallery-card-tags">
                                    @foreach (var tag in sample.Tags)
                                    {
                                        <li>@tag</li>
                                    }
                                </ul>
                                <BitButton Href="@sample.Url"
                                           IconName="@(IsRtl ? BitIconName.Back : BitIconName.Forward)"
                                           IconPlacement="BitPlacement.End"
                                           Class="gallery-stage-open">@Localizer[nameof(LandingStrings.GalleryOpenSample), sample.Site.Name]</BitButton>
                            </div>
                        </div>
                    </article>
                </Body>
            </BitPivotItem>
        }
    </BitPivot>
</div>
