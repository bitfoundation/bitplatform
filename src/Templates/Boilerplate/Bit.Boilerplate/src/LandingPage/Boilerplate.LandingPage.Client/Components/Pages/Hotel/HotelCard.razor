@inherits LandingComponentBase

<a class="gallery-card hotel-card" href="@LocalUrl(HotelSite.Path)">
    <div class="hotel-card-preview" aria-hidden="true">
        <HotelScene Kind="HotelSceneKind.Panorama" Class="hotel-card-scene" />
        <span class="hotel-card-brand"><HotelLogo /> Alder &amp; Salt</span>
        <span class="hotel-card-rate">@H[nameof(HotelStrings.DemoFrom), H[nameof(HotelStrings.Money), 165.ToString("N0", CurrentCulture)]]</span>
    </div>
    <div class="gallery-card-body">
        <p class="gallery-card-industry">@H[nameof(HotelStrings.CardIndustry)]</p>
        <h2>Alder &amp; Salt</h2>
        <p>@H[nameof(HotelStrings.CardSummary)]</p>
        <ul class="gallery-card-tags">
            <li class="is-mode">@L[nameof(LandingStrings.GalleryModeLaunched)]</li>
            <li>@H[nameof(HotelStrings.CardTag1)]</li>
            <li>@H[nameof(HotelStrings.CardTag2)]</li>
            <li>@H[nameof(HotelStrings.CardTag3)]</li>
        </ul>
    </div>
</a>
