@inherits LandingComponentBase

<a class="gallery-card restaurant-card" href="@LocalUrl(RestaurantSite.Path)">
    <div class="restaurant-card-preview" aria-hidden="true">
        <span class="restaurant-card-top">
            <span class="restaurant-card-brand"><RestaurantLogo /> Little Copper</span>
            <span class="restaurant-card-date">@C[nameof(RestaurantStrings.CardDate), RestaurantSite.LaunchDate.ToString("d MMM yyyy", CurrentCulture)]</span>
        </span>
        <RestaurantCup Class="restaurant-card-cup" />
    </div>
    <div class="gallery-card-body">
        <p class="gallery-card-industry">@C[nameof(RestaurantStrings.CardIndustry)]</p>
        <h2>Little Copper</h2>
        <p>@C[nameof(RestaurantStrings.CardSummary)]</p>
        <ul class="gallery-card-tags">
            <li class="is-mode">@L[nameof(LandingStrings.GalleryModePreLaunch)]</li>
            <li>@C[nameof(RestaurantStrings.CardTag1)]</li>
            <li>@C[nameof(RestaurantStrings.CardTag2)]</li>
            <li>@C[nameof(RestaurantStrings.CardTag3)]</li>
        </ul>
    </div>
</a>
