@attribute [Route(PeriodTrackerSite.Path)]
@attribute [Route("/{culture}" + PeriodTrackerSite.Path)]
@layout PeriodTrackerLayout
@inherits LandingPageBase

<LandingHead Title="@P[nameof(PeriodTrackerStrings.HomeTitle)]"
             Description="@P[nameof(PeriodTrackerStrings.HomeDescription)]"
             Path="@PeriodTrackerSite.Path"
             Site="PeriodTrackerSite.Info"
             Image="images/period-tracker/og.png"
             StructuredData="structuredData" />

<section class="tracker-hero" aria-labelledby="tracker-hero-title">
    <div class="lp-container tracker-hero-grid">
        <div class="tracker-hero-text">
            <p class="tracker-pill"><span class="tracker-pill-dot" aria-hidden="true"></span>@P[nameof(PeriodTrackerStrings.HeroEyebrow)]</p>
            <h1 id="tracker-hero-title">@P[nameof(PeriodTrackerStrings.HeroTitleStart)] <em>@P[nameof(PeriodTrackerStrings.HeroTitleEm)]</em></h1>
            <p class="lp-lede">@P[nameof(PeriodTrackerStrings.HeroLede)]</p>
            <div class="tracker-hero-cta">
                <PeriodTrackerBeta Campaign="hero" />
                <BitButton Href="@Link("#download")" Variant="BitVariant.Outline" Color="BitColor.PrimaryForeground" IconName="@BitIconName.Ringer">@P[nameof(PeriodTrackerStrings.HeroAndroidCta)]</BitButton>
            </div>
            <p class="tracker-hero-note">@P[nameof(PeriodTrackerStrings.HeroBetaNote)]</p>
            <ul class="tracker-hero-facts">
                <li><BitIcon IconName="@BitIconName.BlockContact" Class="tracker-fact-icon" /> @P[nameof(PeriodTrackerStrings.HeroFact1)]</li>
                <li><BitIcon IconName="@BitIconName.Blocked2" Class="tracker-fact-icon" /> @P[nameof(PeriodTrackerStrings.HeroFact2)]</li>
                <li><BitIcon IconName="@BitIconName.OfflineStorage" Class="tracker-fact-icon" /> @P[nameof(PeriodTrackerStrings.HeroFact3)]</li>
            </ul>
        </div>
        <div class="tracker-hero-visual">
            <svg class="tracker-orbits" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
                <circle cx="300" cy="300" r="292" class="tracker-orbit is-dashed" />
                <circle cx="300" cy="300" r="232" class="tracker-orbit" />
                <circle cx="300" cy="300" r="172" class="tracker-orbit" />
                <circle cx="47" cy="154" r="11" fill="var(--rose)" />
                <circle cx="478" cy="151" r="14" fill="var(--peach)" />
                <circle cx="485" cy="440" r="7" fill="var(--plum)" />
                <circle cx="165" cy="406" r="6" fill="var(--rose-light)" />
                <circle cx="592" cy="300" r="5" fill="var(--rose)" />
            </svg>
            <DeviceFrame Kind="LandingDeviceKind.Phone" Class="tracker-phone">
                <PeriodTrackerCycle />
            </DeviceFrame>
            <p class="tracker-hero-caption">@P[nameof(PeriodTrackerStrings.DemoCaption)]</p>
        </div>
    </div>
</section>

<section id="promise" class="lp-section tracker-promise" aria-labelledby="tracker-promise-title">
    <div class="lp-container">
        <header class="tracker-head">
            <p class="tracker-kicker">@P[nameof(PeriodTrackerStrings.PromiseKicker)]</p>
            <h2 id="tracker-promise-title">@P[nameof(PeriodTrackerStrings.PromiseTitle)]</h2>
            <p class="lp-lede">@P[nameof(PeriodTrackerStrings.PromiseLede)]</p>
        </header>

        <ul class="tracker-route">
            <li class="tracker-route-node is-phone">
                <span class="tracker-route-icon" aria-hidden="true"><BitIcon IconName="@BitIconName.CellPhone" /></span>
                <h3>@P[nameof(PeriodTrackerStrings.RoutePhoneTitle)]</h3>
                <p>@P[nameof(PeriodTrackerStrings.RoutePhoneBody)]</p>
            </li>
            <li class="tracker-route-node is-backup">
                <span class="tracker-route-tag">@P[nameof(PeriodTrackerStrings.RouteOptional)]</span>
                <span class="tracker-route-icon" aria-hidden="true"><BitIcon IconName="@BitIconName.Encryption" /></span>
                <h3>@P[nameof(PeriodTrackerStrings.RouteBackupTitle)]</h3>
                <p>@P[nameof(PeriodTrackerStrings.RouteBackupBody)]</p>
            </li>
            <li class="tracker-route-node is-server">
                <span class="tracker-route-icon" aria-hidden="true"><BitIcon IconName="@BitIconName.Server" /></span>
                <h3>@P[nameof(PeriodTrackerStrings.RouteServerTitle)]</h3>
                <p>@P[nameof(PeriodTrackerStrings.RouteServerBody)]</p>
            </li>
            <li class="tracker-route-node is-never">
                <span class="tracker-route-tag">@P[nameof(PeriodTrackerStrings.RouteNever)]</span>
                <span class="tracker-route-icon" aria-hidden="true"><BitIcon IconName="@BitIconName.Blocked2" /></span>
                <h3>@P[nameof(PeriodTrackerStrings.RouteNeverTitle)]</h3>
                <p>@P[nameof(PeriodTrackerStrings.RouteNeverBody)]</p>
            </li>
        </ul>

        <ul class="tracker-promises">
            @foreach (var (icon, title, body) in promises)
            {
                <li>
                    <BitIcon IconName="@icon" Class="tracker-promise-icon" />
                    <h3>@P[title]</h3>
                    <p>@P[body]</p>
                </li>
            }
        </ul>

        <p class="tracker-promise-note"><BitIcon IconName="@BitIconName.Info" Class="tracker-note-icon" /> @P[nameof(PeriodTrackerStrings.PromiseNote)]</p>
    </div>
</section>

<section id="how" class="lp-section tracker-how" aria-labelledby="tracker-how-title">
    <div class="lp-container tracker-how-grid">
        <header class="tracker-head">
            <p class="tracker-kicker">@P[nameof(PeriodTrackerStrings.HowKicker)]</p>
            <h2 id="tracker-how-title">@P[nameof(PeriodTrackerStrings.HowTitle)]</h2>
            <p class="lp-lede">@P[nameof(PeriodTrackerStrings.HowLede)]</p>
        </header>
        <div class="tracker-windows">
            @foreach (var (label, note, spread) in windows)
            {
                <div class="tracker-window">
                    <p class="tracker-window-label">@P[label]</p>
                    <div class="tracker-window-track" aria-hidden="true">
                        @for (var offset = -4; offset <= 4; offset++)
                        {
                            <span class="@(offset == 0 ? "is-expected" : Math.Abs(offset) <= spread ? "is-in" : null)"></span>
                        }
                    </div>
                    <p class="tracker-window-note">@P[note]</p>
                </div>
            }
            <p class="tracker-how-change">@P[nameof(PeriodTrackerStrings.HowChange)]</p>
        </div>
    </div>
    <div class="lp-container">
        <p class="tracker-disclaimer"><BitIcon IconName="@BitIconName.Health" Class="tracker-note-icon" /> @P[nameof(PeriodTrackerStrings.HowDisclaimer)]</p>
    </div>
</section>

<section id="download" class="lp-section tracker-early" aria-labelledby="tracker-early-title">
    <div class="lp-container">
        <header class="tracker-head">
            <p class="tracker-kicker">@P[nameof(PeriodTrackerStrings.BetaKicker)]</p>
            <h2 id="tracker-early-title">@P[nameof(PeriodTrackerStrings.BetaTitle)]</h2>
        </header>

        <div class="tracker-early-grid">
            <article class="tracker-early-card is-ios" aria-labelledby="tracker-ios-title">
                <div class="tracker-early-card-head">
                    <h3 id="tracker-ios-title">@P[nameof(PeriodTrackerStrings.BetaIosTitle)]</h3>
                    <span class="tracker-tag">@P[nameof(PeriodTrackerStrings.BetaIosTag)]</span>
                </div>
                <p>@P[nameof(PeriodTrackerStrings.BetaIosBody)]</p>
                <p class="tracker-early-needs"><BitIcon IconName="@BitIconName.CellPhone" Class="tracker-needs-icon" /> @P[nameof(PeriodTrackerStrings.BetaIosNeeds)]</p>
                <div class="tracker-early-actions">
                    <PeriodTrackerBeta Campaign="beta" />
                    <DownloadQr Site="PeriodTrackerSite.Info" Class="tracker-qr" />
                </div>
            </article>
            <article class="tracker-early-card is-android" aria-labelledby="tracker-android-title">
                <div class="tracker-early-card-head">
                    <h3 id="tracker-android-title">@P[nameof(PeriodTrackerStrings.BetaAndroidTitle)]</h3>
                    <span class="tracker-tag is-soon">@P[nameof(PeriodTrackerStrings.BetaAndroidTag)]</span>
                </div>
                <p>@P[nameof(PeriodTrackerStrings.BetaAndroidBody)]</p>
                <WaitlistForm Site="PeriodTrackerSite.Info" Platforms="waitlistPlatforms" SubmitText="@P[nameof(PeriodTrackerStrings.BetaSubmit)]" Class="tracker-form" />
            </article>
        </div>

        <div class="tracker-roadmap">
            <div>
                <h3>@P[nameof(PeriodTrackerStrings.BetaNowTitle)]</h3>
                <ul>
                    @foreach (var item in betaNow)
                    {
                        <li><BitIcon IconName="@BitIconName.CheckMark" Class="tracker-roadmap-icon is-now" /> @P[item]</li>
                    }
                </ul>
            </div>
            <div>
                <h3>@P[nameof(PeriodTrackerStrings.BetaNextTitle)]</h3>
                <ul>
                    @foreach (var item in betaNext)
                    {
                        <li><BitIcon IconName="@BitIconName.Clock" Class="tracker-roadmap-icon" /> @P[item]</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="lp-section tracker-stories" aria-labelledby="tracker-stories-title">
    <div class="lp-container">
        <header class="tracker-head">
            <p class="tracker-kicker">@P[nameof(PeriodTrackerStrings.StoriesKicker)]</p>
            <h2 id="tracker-stories-title">@P[nameof(PeriodTrackerStrings.StoriesTitle)]</h2>
        </header>
        <ul class="tracker-story-list">
            @foreach (var (quote, name, meta) in stories)
            {
                <li>
                    <figure>
                        <span class="tracker-quote-mark" aria-hidden="true">@(IsRtl ? "«" : "“")</span>
                        <blockquote><p>@P[quote]</p></blockquote>
                        <figcaption><strong>@P[name]</strong><span>@P[meta]</span></figcaption>
                    </figure>
                </li>
            }
        </ul>
    </div>
</section>

<section id="faq" class="lp-section tracker-faq" aria-labelledby="tracker-faq-title">
    <div class="lp-container tracker-faq-grid">
        <div class="tracker-faq-main">
            <header class="tracker-head">
                <p class="tracker-kicker">@P[nameof(PeriodTrackerStrings.FaqKicker)]</p>
                <h2 id="tracker-faq-title">@P[nameof(PeriodTrackerStrings.FaqTitle)]</h2>
            </header>
            <FaqList Items="faq" />
        </div>
        <aside class="tracker-ask" aria-labelledby="tracker-ask-title">
            <h3 id="tracker-ask-title">@P[nameof(PeriodTrackerStrings.AskTitle)]</h3>
            <p>@P[nameof(PeriodTrackerStrings.AskBody)]</p>
            <LandingChat Site="PeriodTrackerSite.Info"
                         Variant="LandingChatVariant.Inline"
                         Suggestions="suggestions"
                         Placeholder="@P[nameof(PeriodTrackerStrings.AskPlaceholder)]"
                         Class="tracker-chat" />
        </aside>
    </div>
</section>
