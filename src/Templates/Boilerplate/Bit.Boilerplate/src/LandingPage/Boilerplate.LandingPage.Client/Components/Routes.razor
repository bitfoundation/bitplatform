<ErrorBoundary>
    <ChildContent>
        <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFoundPage)" OnNavigateAsync="OnNavigateAsync">
            <Found Context="routeData">
                <RouteView RouteData="routeData" DefaultLayout="typeof(SiteLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
        </Router>

        @* Outside the router, so a running tour survives the move from one sample's layout to another's *@
        <LandingTour />
    </ChildContent>
    <ErrorContent Context="exception">
        <LandingErrorPanel Exception="exception" />
    </ErrorContent>
</ErrorBoundary>
