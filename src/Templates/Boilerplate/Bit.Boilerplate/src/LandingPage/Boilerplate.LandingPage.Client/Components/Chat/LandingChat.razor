@inherits LandingComponentBase

@switch (Variant)
{
    case LandingChatVariant.Inline:
        <div class="lp-chat-inline @Class">
            @* LandingChatSurface is built on Bit.BlazorUI.AI, so it renders only once EnsureLoaded has loaded that *@
            @if (isLoaded && question is not null)
            {
                <div class="lp-chat-inline-conversation">
                    <LandingChatSurface Site="Site" Suggestions="Suggestions" InitialQuestion="@question" />
                </div>
            }
            else
            {
                <div class="lp-chat-ask" @onfocusin="Prepare" @onpointerenter="Prepare">
                    <BitTextField @bind-Value="draft"
                                  Label="@(Placeholder ?? Localizer[nameof(LandingStrings.ChatPlaceholder)])"
                                  Classes="@(new() { Label = "lp-visually-hidden" })"
                                  Placeholder="@(Placeholder ?? Localizer[nameof(LandingStrings.ChatPlaceholder)])"
                                  AriaDescription="@Localizer[nameof(LandingStrings.ChatAiNotice)]"
                                  IconName="@BitIconName.ChatBot"
                                  OnEnter="() => Ask(draft)"
                                  Disabled="isLoading"
                                  Class="lp-chat-ask-field" />
                    <BitButton OnClick="() => Ask(draft)" IsLoading="isLoading" LoadingLabel="@Localizer[nameof(LandingStrings.ChatLoading)]">@Localizer[nameof(LandingStrings.ChatSend)]</BitButton>
                </div>
                @if (Suggestions is { Count: > 0 })
                {
                    <div class="lp-chat-suggestions" @onpointerenter="Prepare">
                        @foreach (var suggestion in Suggestions)
                        {
                            <BitButton Variant="BitVariant.Outline" Color="BitColor.PrimaryForeground" Size="BitSize.Small" Disabled="isLoading" OnClick="() => Ask(suggestion)">@suggestion</BitButton>
                        }
                    </div>
                }
                <p class="lp-chat-inline-notice">
                    @(hasFailed ? Localizer[nameof(LandingStrings.ChatFailed)] : Localizer[nameof(LandingStrings.ChatAiNotice)])
                    @if (HandoffUrl is not null)
                    {
                        @(" ")<a class="lp-chat-handoff" href="@HandoffUrl">@Localizer[nameof(LandingStrings.ChatHandoff)]</a>
                    }
                </p>
            }
        </div>
        break;

    case LandingChatVariant.Concierge:
        @* A plain wrapper (display: contents), so the scoped ::deep styles reach the tab. aria-expanded is a string, since
           Blazor drops a false bool attribute and a closed chat must still say aria-expanded="false". *@
        <div class="lp-chat-concierge">
            <BitButton IconName="@BitIconName.ChatBot"
                       OnClick="Open"
                       Class="@($"lp-chat-concierge-tab {Class}")"
                       Classes="@(new() { Icon = "lp-chat-trigger-icon" })"
                       aria-haspopup="dialog"
                       aria-expanded="@(isOpen ? "true" : "false")"
                       @onpointerenter="Prepare"
                       @onfocus="Prepare"
                       @ontouchstart="Prepare">@(Label ?? Localizer[nameof(LandingStrings.ChatOpen)])</BitButton>
        </div>
        <BitPanel @bind-IsOpen="isOpen"
                  Placement="@(IsRtl ? BitPlacement.Left : BitPlacement.Right)"
                  Styles="@(new() { Root = "--bit-Panel-size: min(440px, 100vw)" })"
                  ShowCloseButton
                  CloseButtonTitle="@Localizer[nameof(LandingStrings.ChatClose)]"
                  HeaderText="@ChatTitle">
            <div class="lp-chat-panel-body">
                @if (HandoffUrl is not null)
                {
                    <a class="lp-chat-handoff" href="@HandoffUrl">@Localizer[nameof(LandingStrings.ChatHandoff)]</a>
                }
                @if (isLoaded)
                {
                    <LandingChatSurface Site="Site" Suggestions="Suggestions" />
                }
                else
                {
                    <p class="lp-chat-status">@(hasFailed ? Localizer[nameof(LandingStrings.ChatFailed)] : Localizer[nameof(LandingStrings.ChatLoading)])</p>
                }
            </div>
        </BitPanel>
        break;

    default:
        <div class="lp-chat-bubble-root @Class">
            @if (isOpen)
            {
                <section class="lp-chat-card" role="dialog" aria-label="@ChatTitle">
                    <header class="lp-chat-card-header">
                        <div>
                            <h2>@ChatTitle</h2>
                            @if (HandoffUrl is not null)
                            {
                                <a href="@HandoffUrl">@Localizer[nameof(LandingStrings.ChatHandoff)]</a>
                            }
                        </div>
                        <BitButton Variant="BitVariant.Text" Color="BitColor.PrimaryForeground" IconName="@BitIconName.Cancel" Title="@Localizer[nameof(LandingStrings.ChatClose)]" OnClick="() => isOpen = false" />
                    </header>
                    <div class="lp-chat-card-body">
                        @if (isLoaded)
                        {
                            <LandingChatSurface Site="Site" Suggestions="Suggestions" />
                        }
                        else
                        {
                            <p class="lp-chat-status">@(hasFailed ? Localizer[nameof(LandingStrings.ChatFailed)] : Localizer[nameof(LandingStrings.ChatLoading)])</p>
                        }
                    </div>
                    @if (Footer is not null)
                    {
                        <footer class="lp-chat-card-footer">@Footer</footer>
                    }
                </section>
            }
            @* On a phone only the icon shows, and the title names the button. *@
            <BitButton IconName="@(isOpen ? BitIconName.Cancel : BitIconName.ChatBot)"
                       OnClick="Toggle"
                       Title="@(Label ?? Localizer[nameof(LandingStrings.ChatOpen)])"
                       Class="lp-chat-bubble"
                       Classes="@(new() { Icon = "lp-chat-trigger-icon", Container = "lp-chat-bubble-label" })"
                       aria-haspopup="dialog"
                       aria-expanded="@(isOpen ? "true" : "false")"
                       @onpointerenter="Prepare"
                       @onfocus="Prepare"
                       @ontouchstart="Prepare">@(Label ?? Localizer[nameof(LandingStrings.ChatOpen)])</BitButton>
        </div>
        break;
}
