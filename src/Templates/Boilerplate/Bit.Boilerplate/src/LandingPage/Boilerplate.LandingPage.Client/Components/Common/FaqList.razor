@inherits LandingComponentBase

<HeadContent>
    <script type="application/ld+json">@((MarkupString)structuredData)</script>
</HeadContent>

<div class="lp-faq @Class">
    @foreach (var item in Items)
    {
        <BitAccordion Title="@item.Question" HeadingLevel="3">
            <p>@item.Answer</p>
        </BitAccordion>
    }
</div>
