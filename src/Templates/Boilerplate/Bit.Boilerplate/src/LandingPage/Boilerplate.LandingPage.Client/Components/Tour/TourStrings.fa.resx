    <data name="WaitingAnnouncement" xml:space="preserve">
        <value>منتظر بخش بعدی صفحه.</value>
    </data>
    <data name="ProgressLabel" xml:space="preserve">
        <value>پیشرفت تور</value>
    </data>
    <data name="IntroTitle" xml:space="preserve">
        <value>گشتی در نمونه‌ها</value>
    </data>
    <data name="IntroBody" xml:space="preserve">
        <value>{0} سایت نمونه و هر چیزی که از اول در آن‌هاست، قدم به قدم. هر قدر خواستید تند «بعدی» را بزنید، یا با Esc بیرون بروید.</value>
    </data>
    <data name="ModesTitle" xml:space="preserve">
        <value>منتشرشده، یا هنوز نه</value>
    </data>
    <data name="ModesBody" xml:space="preserve">
        <value>نمونه‌ای که یکی از اپ‌هایش منتشر شده باشد به فروشگاه‌های اپ پیوند می‌دهد. تا پیش از آن، فهرست انتظار جمع می‌کند.</value>
    </data>
    <data name="ShopOfferTitle" xml:space="preserve">
        <value>{0}، فروشگاهی که منتشر شده</value>
    </data>
    <data name="ShopOfferBody" xml:space="preserve">
        <value>با یک نوار اعلان برای کد تخفیف داخل اپ شروع می‌شود. اگر ببندیدش، بسته می‌ماند.</value>
    </data>
    <data name="DemoTitle" xml:space="preserve">
        <value>اپ را همین‌جا امتحان کنید</value>
    </data>
    <data name="DemoBody" xml:space="preserve">
        <value>در hero یک صفحه‌ی محصول از خود اپ کار می‌کند: گلدان و اندازه را انتخاب کنید و به سبد اضافه کنید. هر نمونه تکه‌ای از اپش را همین‌طور دارد.</value>
    </data>
    <data name="StoresTitle" xml:space="preserve">
        <value>یک پیوند برای هر دستگاه</value>
    </data>
    <data name="StoresBody" xml:space="preserve">
        <value>نشان‌ها فقط فروشگاه‌هایی را نشان می‌دهند که اپ در آن‌هاست و دستگاه خود بازدیدکننده را علامت می‌زنند. QR فروشگاه درست را روی گوشی‌ای که آن را اسکن می‌کند باز می‌کند.</value>
    </data>
    <data name="RatingTitle" xml:space="preserve">
        <value>امتیاز از App Store</value>
    </data>
    <data name="RatingBody" xml:space="preserve">
        <value>امتیاز App Store آن مستقیم از اپل خوانده و مدتی روی سرور نگه داشته می‌شود.</value>
    </data>
    <data name="FaqTitle" xml:space="preserve">
        <value>جواب‌هایی که موتورهای جست‌وجو می‌خوانند</value>
    </data>
    <data name="FaqBody" xml:space="preserve">
        <value>پرسش‌ها یکی‌یکی باز می‌شوند و طوری علامت‌گذاری شده‌اند که جواب‌ها در نتایج جست‌وجو هم دیده شوند.</value>
    </data>
    <data name="ChatTitle" xml:space="preserve">
        <value>دستیاری که کسب‌وکار را می‌شناسد</value>
    </data>
    <data name="ChatBody" xml:space="preserve">
        <value>تور آن را برایتان باز کرد. از روی اطلاعات خود {0}، به زبان بازدیدکننده و با یک مدل هوش مصنوعی واقعی جواب می‌دهد، و کدش فقط وقتی دانلود می‌شود که کسی بازش کند.</value>
    </data>
    <data name="WaitlistTitle" xml:space="preserve">
        <value>فهرست انتظاری که تمیز می‌ماند</value>
    </data>
    <data name="WaitlistBody" xml:space="preserve">
        <value>بازدیدکننده پلتفرم‌هایی را که می‌خواهد انتخاب می‌کند. هر ثبت‌نام با ایمیل تأیید می‌شود و ربات‌ها بی‌سروصدا کنار گذاشته می‌شوند. بعد از عضویت دکمه‌های اشتراک‌گذاری می‌آیند و هر ایمیل پیوندی برای خروج از فهرست دارد.</value>
    </data>
    <data name="PagesTitle" xml:space="preserve">
        <value>بیش از یک صفحه</value>
    </data>
    <data name="PagesBody" xml:space="preserve">
        <value>هر نمونه صفحه‌هایی را دارد که کسب‌وکارش لازم دارد، مثل فروشگاه‌های {0} روی نقشه با ساعت کار و این‌که الان باز هستند یا نه. هر صفحه عنوان، توضیح و تصویر پیش‌نمایش خودش را دارد.</value>
    </data>
    <data name="ConciergeTitle" xml:space="preserve">
        <value>چت به شکل زبانه‌ی کناری</value>
    </data>
    <data name="ConciergeBody" xml:space="preserve">
        <value>همان دستیار، این بار به شکل زبانه‌ای در لبه‌ی صفحه: یک کلیک آن را در یک پنل کناری باز می‌کند.</value>
    </data>
    <data name="LanguagesTitle" xml:space="preserve">
        <value>دو زبان، هر دو جهت</value>
    </data>
    <data name="LanguagesBody" xml:space="preserve">
        <value>هر صفحه به انگلیسی و فارسی هست، با راست‌به‌چپ کامل و هر کدام با نشانی خودش، و به بازدیدکننده‌ای که مرورگرش زبان دیگر را ترجیح می‌دهد یک بار پیشنهاد می‌شود. با خاموش کردن localization، سایت فقط انگلیسی می‌شود.</value>
    </data>
    <data name="ThemeTitle" xml:space="preserve">
        <value>روشن و تیره</value>
    </data>
    <data name="ThemeBody" xml:space="preserve">
        <value>هر نمونه ظاهر روشن و تیره دارد. تا بازدیدکننده یکی را انتخاب نکرده از دستگاه پیروی می‌کند و بعد آن را به خاطر می‌سپارد.</value>
    </data>
    <data name="SearchTitle" xml:space="preserve">
        <value>آماده برای موتورهای جست‌وجو</value>
    </data>
    <data name="SearchBody" xml:space="preserve">
        <value>همه‌ی صفحه‌ها prerender می‌شوند، پس موتورهای جست‌وجو و بازدیدکننده‌ها متن صفحه را پیش از اجرای هر کدی می‌گیرند، همراه با پیوند canonical، داده‌ی ساخت‌یافته و جایی در sitemap.</value>
    </data>
    <data name="InvoiceTitle" xml:space="preserve">
        <value>{0}، فاکتوری برای فرستادن</value>
    </data>
    <data name="InvoiceBody" xml:space="preserve">
        <value>ساعت، نرخ یا مالیات را عوض کنید تا فاکتور خودش جمع بخورد و آماده‌ی فرستادن شود.</value>
    </data>
    <data name="VatTitle" xml:space="preserve">
        <value>با یا بدون مالیات، به ارز بازدیدکننده</value>
    </data>
    <data name="VatBody" xml:space="preserve">
        <value>قیمت‌ها به ارز کشور بازدیدکننده نشان داده می‌شوند که از زبان مرورگرش حدس زده می‌شود و راحت عوض می‌شود، و یک کلید آن‌ها را با یا بدون مالیات بر ارزش افزوده‌ی همان کشور نشان می‌دهد.</value>
    </data>
    <data name="DeskTitle" xml:space="preserve">
        <value>{0}، میز پذیرشی که کار می‌کند</value>
    </data>
    <data name="DeskBody" xml:space="preserve">
        <value>این پیش‌نمایش‌ها عکس نیستند؛ تکه‌هایی از خود اپ‌اند که کار می‌کنند و نشان می‌دهند اپ چه می‌کند. ببینید دو مهمان پذیرش می‌شوند، بعد خودتان اتاقی را تمیز علامت بزنید.</value>
    </data>
    <data name="PressTitle" xml:space="preserve">
        <value>کیت رسانه‌ای</value>
    </data>
    <data name="PressBody" xml:space="preserve">
        <value>لوگو و تصویر برای دانلود خبرنگارها، همراه با اطلاعات و آدم‌هایی که می‌شود از آن‌ها نقل کرد.</value>
    </data>
    <data name="RouteTitle" xml:space="preserve">
        <value>داده کجا می‌رود</value>
    </data>
    <data name="RouteBody" xml:space="preserve">
        <value>وعده‌ی حریم خصوصی به شکل یک مسیر: گوشی، پشتیبان اختیاری، سرور، و کسانی که هیچ‌وقت چیزی نمی‌گیرند.</value>
    </data>
    <data name="PrivacyTitle" xml:space="preserve">
        <value>انتخاب‌های حریم خصوصی</value>
    </data>
    <data name="PrivacyBody" xml:space="preserve">
        <value>خطاها از لحظه‌ی اول گزارش می‌شوند؛ سرعت و آمار استفاده فقط با رضایت و بدون کوکی. بازدیدکننده هر وقت بخواهد انتخابش را این‌جا عوض می‌کند.</value>
    </data>
    <data name="LegalTitle" xml:space="preserve">
        <value>صفحه‌های حقوقی، پرشده</value>
    </data>
    <data name="LegalBody" xml:space="preserve">
        <value>حریم خصوصی، شرایط استفاده، کوکی‌ها، مشخصات حقوقی و دسترس‌پذیری، نوشته‌شده برای شرکت هر نمونه. نمونه‌اند: مال خودتان را به وکیل نشان دهید.</value>
    </data>
    <data name="MissingTitle" xml:space="preserve">
        <value>حتی صفحه‌ی 404</value>
    </data>
    <data name="MissingBody" xml:space="preserve">
        <value>نشانی‌ای که وجود ندارد یک 404 واقعی به سبک و زبان همان نمونه می‌گیرد، با راهی برای برگشت.</value>
    </data>
    <data name="OfflineTitle" xml:space="preserve">
        <value>نصب می‌شود و سریع باز می‌شود</value>
    </data>
    <data name="OfflineBody" xml:space="preserve">
        <value>هر نمونه مثل یک اپ جدا نصب می‌شود و فایل‌هایش برای بازدید بعدی نگه داشته می‌شوند، ولی هر صفحه همچنان تازه از سرور می‌آید.</value>
    </data>
    <data name="LightTitle" xml:space="preserve">
        <value>فقط آن‌چه لازم است، همان وقت</value>
    </data>
    <data name="LightBody" xml:space="preserve">
        <value>فونت‌ها، چت و همین تور فقط در صفحه‌ها و لحظه‌هایی دانلود می‌شوند که لازم‌اند.</value>
    </data>
    <data name="YoursTitle" xml:space="preserve">
        <value>مال خودتان کنید</value>
    </data>
    <data name="YoursBody" xml:space="preserve">
        <value>bit new پروژه‌ای با هر {0} نمونه می‌سازد. به agentتان بگویید از آن‌ها چه بردارد، همراه با اطلاعات و برند محصولتان، تا لندینگ‌پیجتان را سر هم کند.</value>
    </data>
