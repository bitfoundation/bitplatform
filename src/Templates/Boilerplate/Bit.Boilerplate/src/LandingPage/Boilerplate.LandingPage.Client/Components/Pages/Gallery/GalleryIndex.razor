@inherits LandingComponentBase

<ul class="gallery-index" role="list">
    @for (var i = 0; i < Samples.Length; i++)
    {
        var sample = Samples[i];
        <li @key="sample.Key" class="gallery-row gallery-brand-@sample.Key">
            <span class="gallery-row-number" aria-hidden="true">@((i + 1).ToString("00", CurrentCulture))</span>
            <span class="gallery-logo gallery-row-logo"><DynamicComponent Type="sample.Site.Logo" /></span>
            <div class="gallery-row-title">
                <h2><a href="@sample.Url">@sample.Site.Name</a></h2>
                <p>@sample.CardIndustry</p>
            </div>
            <div class="gallery-row-text">
                <p>@sample.CardSummary</p>
                <ul class="gallery-row-tags">
                    @foreach (var tag in sample.Tags)
                    {
                        <li>@tag</li>
                    }
                </ul>
            </div>
            <span class="gallery-row-mode @sample.ModeClass">@sample.Mode</span>
            <BitIcon IconName="@(IsRtl ? BitIconName.ChevronLeft : BitIconName.ChevronRight)" Class="gallery-row-go" />
        </li>
    }
</ul>
