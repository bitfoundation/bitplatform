@inherits LandingComponentBase

<div class="lp-chat-surface @Class">
    <CascadingValue Value="renderers" IsFixed="true">
        <CascadingValue Value="uiOptions" IsFixed="true">
            <BitAiChat Session="session"
                       Suggestions="Suggestions"
                       EmptyTitle="@Localizer[nameof(LandingStrings.ChatEmptyTitle)]"
                       EmptyBody="@Localizer[nameof(LandingStrings.ChatEmptyBody), Site.Name]"
                       Placeholder="@Localizer[nameof(LandingStrings.ChatPlaceholder)]"
                       AllowAttachments="false"
                       AllowDictation="false"
                       UiOptions="uiOptions"
                       Dir="@(IsRtl ? BitDir.Rtl : BitDir.Ltr)">
                <FooterTemplate>
                    <p class="lp-chat-notice">@Localizer[nameof(LandingStrings.ChatAiNotice)]</p>
                </FooterTemplate>
            </BitAiChat>
        </CascadingValue>
    </CascadingValue>
</div>
