@inherits LandingComponentBase

<NotFoundPanel HomePath="@HotelSoftwareSite.Path" Title="@H[nameof(HotelSoftwareStrings.NotFoundTitle)]" Body="@H[nameof(HotelSoftwareStrings.NotFoundBody)]">
    <Art>
        <svg viewBox="0 0 320 260" role="presentation">
            <rect x="20" y="20" width="280" height="200" rx="8" fill="var(--hs-board)" />
            <rect x="20" y="20" width="280" height="200" rx="8" fill="none" stroke="var(--hs-brass)" stroke-width="2" />
            <path d="M44 62h232" stroke="var(--hs-board-line)" stroke-width="2" />
            <g fill="none" stroke="var(--hs-board-muted)" stroke-width="2" stroke-linecap="round">
                <path d="M68 60v24" />
                <path d="M128 60v24" />
                <path d="M188 60v24" />
                <path d="M248 60v24" />
            </g>
            <path d="M58 84h20a4 4 0 0 1 4 4v28l-14 9-14-9V88a4 4 0 0 1 4-4z" fill="var(--hs-brass)" />
            <path d="M118 84h20a4 4 0 0 1 4 4v28l-14 9-14-9V88a4 4 0 0 1 4-4z" fill="var(--hs-brass)" />
            <path d="M178 84h20a4 4 0 0 1 4 4v28l-14 9-14-9V88a4 4 0 0 1 4-4z" fill="none" stroke="var(--hs-board-line-strong)" stroke-width="1.5" stroke-dasharray="4 3" />
            <path d="M238 84h20a4 4 0 0 1 4 4v28l-14 9-14-9V88a4 4 0 0 1 4-4z" fill="var(--hs-brass)" />
            <text x="188" y="168" text-anchor="middle" font-size="40" font-weight="700" fill="var(--hs-brass)" style="font-family: var(--lp-stack-display); font-stretch: 62%">404</text>
            <text x="188" y="192" text-anchor="middle" font-size="12" fill="var(--hs-board-muted)" style="font-family: var(--lp-stack-body)">@H[nameof(HotelSoftwareStrings.NotFoundKey)]</text>
        </svg>
    </Art>
    <Actions>
        <BitButton Variant="BitVariant.Outline" Color="BitColor.PrimaryForeground" Href="@LocalUrl($"{HotelSoftwareSite.Path}/pricing")">@H[nameof(HotelSoftwareStrings.NotFoundPricing)]</BitButton>
    </Actions>
</NotFoundPanel>
