    case HotelSceneKind.Dining:
        <svg class="hs @Class" viewBox="0 0 480 320" preserveAspectRatio="xMidYMid slice" role="@Role" aria-label="@Label" aria-hidden="@Hidden" focusable="false">
            <rect width="480" height="320" class="hs-wall" />
            <rect y="250" width="480" height="70" class="hs-floor" />
            @for (var i = 0; i < 3; i++)
            {
                var x = 40 + i * 140;

                <rect x="@x" y="40" width="120" height="166" class="hs-wood" />
                <rect x="@(x + 6)" y="46" width="108" height="160" class="hs-sky" />
                <rect x="@(x + 6)" y="140" width="108" height="66" class="hs-sea" />
                <path d="@FormattableString.Invariant($"M{x + 6} 170C{x + 40} 156 {x + 80} 162 {x + 114} 172V206H{x + 6}Z")" class="hs-sand" />
            }
            <circle cx="330" cy="92" r="16" class="hs-sun" />
            <path d="M120 0V56M240 0V72M360 0V56" class="hs-edge" />
            <path d="M104 56h32l10 22h-52ZM224 72h32l10 22h-52ZM344 56h32l10 22h-52Z" class="hs-lamp" />
            <rect x="56" y="214" width="368" height="12" rx="3" class="hs-wood-deep" />
            <path d="M76 226V276M404 226V276" class="hs-leg" />
            @for (var i = 0; i < 5; i++)
            {
                <ellipse cx="@(96 + i * 72)" cy="212" rx="18" ry="4" class="hs-plate" />
            }
            <path d="M226 212q14-16 28 0Z" class="hs-bread" />
            <rect x="300" y="190" width="10" height="22" rx="4" class="hs-glass" />
            <rect x="152" y="192" width="9" height="20" rx="4" class="hs-glass" />
            <rect x="60" y="236" width="140" height="10" rx="3" class="hs-wood" />
            <rect x="280" y="236" width="140" height="10" rx="3" class="hs-wood" />
        </svg>
        break;

    case HotelSceneKind.Sauna:
        <svg class="hs @Class" viewBox="0 0 480 320" preserveAspectRatio="xMidYMid slice" role="@Role" aria-label="@Label" aria-hidden="@Hidden" focusable="false">
