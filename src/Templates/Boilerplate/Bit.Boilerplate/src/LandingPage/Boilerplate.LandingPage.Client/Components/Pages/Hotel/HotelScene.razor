            <rect y="140" width="480" height="20" class="hs-haze-3" />
            <circle cx="96" cy="76" r="24" class="hs-sun" />
            <path d="M300 60q6-6 12 0q6-6 12 0" class="hs-bird" />
            <rect y="160" width="480" height="56" class="hs-sea" />
            <path d="M0 160H480" class="hs-horizon" />
            <path d="M0 214C80 204 160 210 240 206C320 202 400 210 480 204V320H0Z" class="hs-foam" />
            <path d="M0 222C90 214 170 220 250 216C330 212 410 218 480 212V320H0Z" class="hs-sand" />
            <path d="M0 226C90 218 170 224 250 220C330 216 410 222 480 216" class="hs-tide" />
            @foreach (var (x, y, flip) in chairs)
            {
                <g transform="@FormattableString.Invariant($"translate({x} {y}) scale({(flip ? -1 : 1)} 1)")">
                    <path d="M-4 0Q32 -30 68 0V8H-4Z" class="hs-canvas" />
                    <path d="M14 -16Q16 -6 16 8M32 -22V8M50 -16Q48 -6 48 8" class="hs-canvas-stripe" />
