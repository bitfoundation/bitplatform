            <rect x="52" y="150" width="220" height="96" class="hs-sea" />
            <path d="M52 150H272" class="hs-horizon" />
            <path d="M66 172q10-4 20 0t20 0M158 186q10-4 20 0t20 0M96 204q10-4 20 0t20 0M200 214q10-4 20 0t20 0" class="hs-wave" />
            <rect x="232" y="118" width="8" height="32" class="hs-tower" />
            <rect x="232" y="124" width="8" height="5" class="hs-red" />
            <rect x="232" y="136" width="8" height="5" class="hs-red" />
            <rect x="231" y="112" width="10" height="6" class="hs-lamp" />
            <path d="M162 38V246" class="hs-mullion" />
