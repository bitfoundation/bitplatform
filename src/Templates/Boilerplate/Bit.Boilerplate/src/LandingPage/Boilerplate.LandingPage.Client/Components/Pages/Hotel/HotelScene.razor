            <path d="M0 320V126L240 18L480 126V320Z" class="hs-wall" />
            <path d="M0 126L240 18L480 126" class="hs-beam-line" />
            <path d="M118 72L184 42L194 70L128 100Z" class="hs-sky" />
            <circle cx="160" cy="66" r="1.6" class="hs-star" />
            <circle cx="174" cy="58" r="1.2" class="hs-star" />
