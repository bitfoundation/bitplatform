            <path d="M166 138V216M182 138V216M198 138V216M214 138V216M230 138V216M246 138V216M262 138V216" class="hs-plank" />
            <rect x="164" y="160" width="30" height="56" class="hs-wood-deep" />
            <rect x="214" y="156" width="40" height="24" class="hs-win" />
            <rect x="140" y="216" width="160" height="8" class="hs-wood-deep" />
            <path d="M150 224V250M290 224V250" class="hs-leg" />
            <path d="M300 214h24M300 214V196M324 214V196M300 200h24" class="hs-rail" />
            <path d="M306 200h10v16h-10Z" class="hs-throw" />
