            <ellipse cx="330" cy="282" rx="124" ry="16" class="hs-rug" />
            <rect x="308" y="40" width="64" height="46" class="hs-frame" />
            <rect x="314" y="46" width="52" height="34" class="hs-window" />
            <path d="M314 68H366M330 68l6-10l6 10" class="hs-edge" />
        </svg>
