            <path d="M190 320L236 320L208 224L196 224Z" class="hs-wood" />
            <path d="M60 272q-4-18-10-26M60 272q0-20 2-32M60 272q6-16 13-22M404 280q-4-16-10-22M404 280q2-18 4-26M404 280q6-12 12-16M450 276q-3-14-8-20M450 276q2-16 5-22" class="hs-grass" />
