            <rect x="48" y="244" width="160" height="30" rx="8" class="hs-throw-deep" />
            <rect x="58" y="272" width="8" height="20" class="hs-wood-deep" />
            <rect x="190" y="272" width="8" height="20" class="hs-wood-deep" />
            <rect x="64" y="226" width="40" height="22" rx="9" class="hs-linen" />
            <path d="M228 292V200M228 200l-12 -10h24Z" class="hs-edge" />
