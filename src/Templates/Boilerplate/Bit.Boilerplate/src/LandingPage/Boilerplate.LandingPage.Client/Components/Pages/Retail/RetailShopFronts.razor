@inherits LandingComponentBase

<ol class="retail-fronts @Class">
    @for (var i = 0; i < RetailShops.All.Length; i++)
    {
        var shop = RetailShops.All[i];
        var (wall, awning, goods) = looks[i];

        <li style="--wall: @wall; --awning: @awning; --goods: @goods">
            <svg viewBox="0 0 120 112" aria-hidden="true" focusable="false">
                <rect x="6" y="10" width="108" height="98" class="retail-front-wall" />
                <rect x="6" y="6" width="108" height="8" class="retail-front-roof" />
                <rect x="14" y="20" width="92" height="16" rx="2" class="retail-front-sign" />
                <path d="M22 28h76" class="retail-front-sign-text" />
                <path d="M10 40h100l-4 12H14Z" class="retail-front-awning" />
                <path d="@AwningStripes" class="retail-front-stripes" />
                <path d="@AwningScallops" class="retail-front-awning" />
                <rect x="16" y="60" width="52" height="38" class="retail-front-window" />
                <path d="M16 86h52" class="retail-front-shelf" />
                @for (var g = 0; g < 5; g++)
                {
                    <circle cx="@(22 + g * 10)" cy="81" r="4" class="retail-front-goods" style="opacity: @((g % 2 is 0 ? 1 : .7).ToString(CultureInfo.InvariantCulture))" />
                }
                <rect x="21" y="90" width="10" height="7" class="retail-front-crate" />
                <rect x="36" y="90" width="10" height="7" class="retail-front-crate" />
                <rect x="51" y="90" width="10" height="7" class="retail-front-crate" />
                <rect x="78" y="60" width="26" height="48" class="retail-front-door" />
                <circle cx="99" cy="85" r="1.6" class="retail-front-handle" />
                <rect x="2" y="106" width="116" height="6" class="retail-front-step" />
            </svg>
            <span class="retail-front-year">@shop.Opened.ToString(CultureInfo.InvariantCulture)</span>
            <span class="retail-front-name">@R[shop.NameKey]</span>
        </li>
    }
</ol>
