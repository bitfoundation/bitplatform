    </data>
    <data name="RouteServerTitle" xml:space="preserve">
        <value>Our server in Stockholm</value>
    </data>
    <data name="RouteServerBody" xml:space="preserve">
        <value>Keeps the encrypted file. We can see its size and date, nothing else.</value>
    </data>
    <data name="RouteNeverTitle" xml:space="preserve">
