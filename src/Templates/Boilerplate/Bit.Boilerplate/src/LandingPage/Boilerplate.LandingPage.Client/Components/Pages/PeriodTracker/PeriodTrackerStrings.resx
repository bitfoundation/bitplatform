        <value>No account</value>
    </data>
    <data name="Promise1Body" xml:space="preserve">
        <value>You don't sign up. There's no email, password or name to give us.</value>
    </data>
    <data name="Promise2Title" xml:space="preserve">
        <value>Stored on the phone</value>
    </data>
    <data name="Promise2Body" xml:space="preserve">
        <value>Your entries stay in the app's own storage, which iOS keeps encrypted while the phone is locked.</value>
    </data>
    <data name="Promise3Title" xml:space="preserve">
        <value>A backup only you can open</value>
    </data>
    <data name="Promise3Body" xml:space="preserve">
        <value>Turning backup on gives you a 12-word recovery phrase. Without it nobody can open the backup, us included.</value>
    </data>
    <data name="Promise4Title" xml:space="preserve">
        <value>No ads, no analytics</value>
    </data>
    <data name="Promise4Body" xml:space="preserve">
        <value>The app has no advertising or analytics code in it. A crash report is sent only if you tap Send.</value>
    </data>
    <data name="Promise5Title" xml:space="preserve">
        <value>Delete means deleted</value>
    </data>
    <data name="Promise5Body" xml:space="preserve">
        <value>One button in Settings erases everything on the phone and your backup on our server.</value>
    </data>
    <data name="PromiseNote" xml:space="preserve">
        <value>An independent security firm will review the app before version 1.0, and we'll publish its report in full. Until then, these are our commitments, not a certification.</value>
    </data>
