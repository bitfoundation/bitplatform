    <data name="PromiseTitle" xml:space="preserve">
        <value>What you log stays on your phone.</value>
    </data>
    <data name="PromiseLede" xml:space="preserve">
        <value>We built Liora so that we couldn't read your data even if we wanted to. This is where it goes, and where it never goes.</value>
