@inherits LandingComponentBase

<NotFoundPanel HomePath="@PeriodTrackerSite.Path" Title="@P[nameof(PeriodTrackerStrings.NotFoundTitle)]" Body="@P[nameof(PeriodTrackerStrings.NotFoundBody)]">
    <Art>
        <svg viewBox="0 0 300 300" role="presentation" class="tracker-404">
            <circle cx="150" cy="150" r="138" fill="var(--rose-soft)" />
            <circle cx="150" cy="150" r="112" fill="none" stroke="var(--orbit)" stroke-width="2" />
            @foreach (var dot in dots)
            {
                <circle cx="@dot.X" cy="@dot.Y" r="8" class="@dot.Class" />
            }
            <circle cx="@gap.X" cy="@gap.Y" r="11" fill="none" stroke="var(--plum)" stroke-width="2.5" stroke-dasharray="4 4" class="tracker-404-gap" />
            <text x="150" y="172" text-anchor="middle" class="tracker-404-text">404</text>
        </svg>
    </Art>
    <Actions>
        <BitButton Variant="BitVariant.Outline" Color="BitColor.PrimaryForeground" Href="@($"{LocalUrl(PeriodTrackerSite.Path)}#promise")">@P[nameof(PeriodTrackerStrings.NotFoundPromise)]</BitButton>
    </Actions>
</NotFoundPanel>
