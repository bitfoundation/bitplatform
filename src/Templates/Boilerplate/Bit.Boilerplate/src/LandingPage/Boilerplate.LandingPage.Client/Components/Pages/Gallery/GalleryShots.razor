@inherits LandingComponentBase

<ul class="gallery-shots" role="list">
    @foreach (var sample in Samples)
    {
        <li @key="sample.Key" class="gallery-card gallery-shot gallery-brand-@sample.Key">
            <span class="gallery-shot-frame">
                <img loading="lazy" decoding="async" class="is-light" src="@sample.Shot("light")" width="800" height="500" alt="" />
                <img loading="lazy" decoding="async" class="is-dark" src="@sample.Shot("dark")" width="800" height="500" alt="" />
            </span>
            <div class="gallery-card-body">
                <p class="gallery-card-industry">@sample.CardIndustry</p>
                <h2>
                    <a href="@sample.Url">
                        <span class="gallery-logo"><DynamicComponent Type="sample.Site.Logo" /></span>
                        @sample.Site.Name
                    </a>
                </h2>
                <p>@sample.CardSummary</p>
                <ul class="gallery-card-tags">
                    <li class="is-mode">@sample.Mode</li>
                    @foreach (var tag in sample.Tags)
                    {
                        <li>@tag</li>
                    }
                </ul>
            </div>
        </li>
    }
</ul>
