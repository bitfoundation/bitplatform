    </data>
    <data name="LegalTerms5Title" xml:space="preserve">
        <value>Changes and law</value>
    </data>
    <data name="LegalTerms5Body" xml:space="preserve">
        <value>We may update these terms, and the date at the top says when. The law of the country in {2} applies.</value>
