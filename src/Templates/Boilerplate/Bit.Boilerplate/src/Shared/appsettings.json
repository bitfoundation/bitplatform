{
    //#if (appInsights == true || sentry == true)
    "Belemetry": {
        //#if (appInsights == true)
        "AzureMonitorConnectionString": null,
        //#endif
        //#if (sentry == true)
        "SentryDsn": null,
        //#endif
        "Comment": "Telemetry exporters for all projects; OTLP is configured by the OTEL_EXPORTER_OTLP_* settings below"
    },
    //#endif
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Boilerplate.Client.Core.Infrastructure.Services.AuthManager": "Information",
            "Microsoft.EntityFrameworkCore.Database.Command": "Information",
            "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
        },
        "Belemetry": {
            "Comment": "Belemetry (OTLP, Azure Application Insights and Sentry) for all projects",
            "LogLevel": {
                "Default": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Boilerplate.Client.Core.Infrastructure.Services.AuthManager": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Information",
                "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
            }
        },
        "Console": {
            "Comment": "Console logging for Server.Web, Server.Api and Client.Maui (Device loggers for Android and iOS)",
            "LogLevel": {
                "Default": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Boilerplate.Client.Core.Infrastructure.Services.AuthManager": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Information",
                "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
            }
        },
        "Microsoft.AspNetCore.Components.WebAssembly.Services.WebAssemblyConsoleLoggerProvider": {
            "Comment": "Console logging for Client.Web (Blazor WebAssembly). The key has to be the provider's FULL type name: unlike ConsoleLoggerProvider it carries no [ProviderAlias], so a short key matches nothing and the whole section is ignored.",
            "LogLevel": {
                "Default": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Boilerplate.Client.Core.Infrastructure.Services.AuthManager": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Information"
            }
        },
        "EventLog": {
            "Comment": "Event log for Server.Web, Server.Api and Client.Maui (Windows) and Client.Windows",
            "LogLevel": {
                "Default": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Boilerplate.Client.Core.Infrastructure.Services.AuthManager": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Information",
                "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
            }
        },
        "EventSource": {
            "Comment": "Event source for Server.Web, Server.Api and Client.Maui and Client.Windows",
            "LogLevel": {
                "Default": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Boilerplate.Client.Core.Infrastructure.Services.AuthManager": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Information",
                "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
            }
        },
        "BevTools": {
            "Comment": "Logs panel of the in-app dev tools for all projects",
            "LogLevel": {
                "Default": "Information",
                "Polly": "Warning",
                "Microsoft.AspNetCore*": "Warning",
                "StackExchange.Redis.ConnectionMultiplexer": "Warning",
                "ZiggyCreatures.Caching.Fusion.FusionCache": "Warning",
                "System.Net.Http.HttpClient.*.LogicalHandler": "Warning",
                "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
            }
        },
        "DiagnosticLogger": {
            "Comment": "Diagnostic logger for all projects",
            "LogLevel": {
                "Default": "Information",
                "Polly": "Warning",
                "Microsoft.AspNetCore*": "Warning",
                "StackExchange.Redis.ConnectionMultiplexer": "Warning",
                "ZiggyCreatures.Caching.Fusion.FusionCache": "Warning",
                "System.Net.Http.HttpClient.*.LogicalHandler": "Warning",
                "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
            }
        },
        "Debug": {
            "Comment": "Debug logger for all projects",
            "LogLevel": {
                "Default": "None"
            }
        }
    },

    "OTEL_EXPORTER_OTLP_ENDPOINT": null,
    "OTEL_EXPORTER_OTLP_ENDPOINT__Comment": "Open Telemetry endpoint if /logs, /traces and /metrics urls have the same base URL",
    "OTEL_EXPORTER_OTLP_HEADERS": null,

    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_PROTOCOL__Comment": "grpc, http/protobuf or http/json",

    "MemoryCache": {
        "SizeLimit": 268435456,
        "SizeLimit__Comment": "Total capacity of the L1 cache, in bytes (256 MB)."
    },
    "$schema": "https://json.schemastore.org/appsettings.json"
}
