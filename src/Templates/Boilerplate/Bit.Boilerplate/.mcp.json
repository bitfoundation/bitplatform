{
    "mcpServers": {
        "MicrosoftLearn": {
            "type": "http",
            "url": "https://learn.microsoft.com/api/mcp"
        },
        "DeepWiki": {
            "type": "http",
            "url": "https://mcp.deepwiki.com/mcp"
        },
        "bitBlazorUI": {
            "type": "http",
            "url": "https://blazorui.bitplatform.dev/mcp"
        },
        //#if (aspire == true)
        "aspire": {
            "type": "stdio",
            "command": "aspire",
            "args": [
                "agent",
                "mcp"
            ]
        },
        //#endif
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest",
                "--output-dir",
                ".playwright-mcp",
                "--output-max-size",
                "52428800"
            ]
        }
    }
}
