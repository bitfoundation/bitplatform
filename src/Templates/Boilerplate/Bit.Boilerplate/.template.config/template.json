{
    "$schema": "http://json.schemastore.org/template",
    "author": "bit platform",
    "classifications": [
        "ASP.NET Core",
        "Blazor",
        "MAUI"
    ],
    "tags": {
        "language": "C#",
        "type": "solution"
    },
    "identity": "Bit.Boilerplate",
    "name": "bit Boilerplate",
    "shortName": "bit-bp",
    "sourceName": "Boilerplate",
    "preferNameDirectory": true,
    "symbols": {
        "helpUrl": {
            "displayName": "More info at",
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "https://bitplatform.dev/templates/create-project",
            "description": "Open the following url in order to get more information about the following parameters."
        },
        //Guid generator for App Id
        "ApplicationIdGuid": {
            "type": "generated",
            "generator": "guid",
            "replaces": "AC87AA5B-4B37-4E52-8468-2D5DF24AF256",
            "parameters": {
                "defaultFormat": "D" //Guid format
            }
        },
        "SeedDataProductCreatedOn": {
            "type": "generated",
            "generator": "now",
            "replaces": "2022-07-12",
            "parameters": {
                "format": "yyyy-MM-dd"
            }
        },
        "database": {
            "displayName": "Backend database",
            "type": "parameter",
            "datatype": "choice",
            "defaultValue": "Sqlite",
            "choices": [
                {
                    "choice": "SqlServer",
                    "description": "Sql Server"
                },
                {
                    "choice": "Sqlite",
                    "description": "Sqlite"
                },
                {
                    "choice": "PostgreSQL",
                    "description": "PostgreSQL"
                },
                {
                    "choice": "MySql",
                    "description": "MySql - MariaDB"
                },
                {
                    "choice": "Other",
                    "description": "You can install and configure any database supported by ef core (https://learn.microsoft.com/en-us/ef/core/providers)"
                }
            ],
            "description": "Boilerplate's API uses EF Core. You can use SQL Server, SQLite, or any other EF Core provider."
        },
        "filesStorage": {
            "displayName": "Files storage",
            "type": "parameter",
            "datatype": "choice",
            "defaultValue": "Local",
            "choices": [
                {
                    "choice": "Local",
                    "description": "Use either the local App_Data folder or the /container_volume for Docker containers."
                },
                {
                    "choice": "S3",
                    "description": "S3"
                },
                {
                    "choice": "AzureBlobStorage",
                    "description": "Azure blob storage"
                },
                {
                    "choice": "Other",
                    "description": "You can install and configure any storage supported by fluent storage (https://github.com/robinrodricks/FluentStorage/wiki/Blob-Storage)"
                }
            ],
            "description": "Boilerplate's API uses Fluent Storage. You can use any other fluent storage provider (https://github.com/robinrodricks/FluentStorage/wiki/Blob-Storage)"
        },
        "api": {
            "displayName": "API deployment configuration",
            "type": "parameter",
            "datatype": "choice",
            "defaultValue": "Integrated",
            "choices": [
                {
                    "choice": "Integrated",
                    "description": "A single-deployment configuration that serves API controllers and Blazor web server together"
                },
                {
                    "choice": "Standalone",
                    "description": "A multi-server deployment configuration in which the API controllers are separate from the Blazor server"
                }
            ]
        },
        "pipeline": {
            "displayName": "CI-CD pipeline",
            "type": "parameter",
            "datatype": "choice",
            "defaultValue": "GitHub",
            "choices": [
                {
                    "choice": "GitHub",
                    "description": "GitHub actions"
                },
                {
                    "choice": "Azure",
                    "description": "Azure DevOps pipelines"
                },
                {
                    "choice": "None",
                    "description": "None"
                }
            ]
        },
        "module": {
            "displayName": "Module",
            "type": "parameter",
            "datatype": "choice",
            "defaultValue": "None",
            "choices": [
                {
                    "choice": "Admin",
                    "description": "Admin Panel module"
                },
                {
                    "choice": "Sales",
                    "description": "Sales (E-Commerce module)"
                },
                {
                    "choice": "None",
                    "description": "None"
                }
            ]
        },
        "multitenant": {
            "displayName": "Multi-Tenant",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "true",
            "description": "Adds multi-tenant support"
        },
        "captcha": {
            "displayName": "Captcha",
            "type": "parameter",
            "datatype": "choice",
            "defaultValue": "None",
            "choices": [
                {
                    "choice": "reCaptcha",
                    "description": "Google reCaptcha"
                },
                {
                    "choice": "None",
                    "description": "None"
                }
            ]
        },
        "aspire": {
            "displayName": "Add aspire?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "true",
            "description": "Adds aspire"
        },
        "redis": {
            "displayName": "Add redis?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Adds redis"
        },
        "notification": {
            "displayName": "Add push notification?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "true",
            "description": "Adds push notification."
        },
        "sample": {
            "displayName": "Sample",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Adds todo page sample."
        },
        "sentry": {
            "displayName": "Add Sentry logging to project?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false"
        },
        "appInsights": {
            "displayName": "Add Azure application insights to project?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false"
        },
        "signalR": {
            "displayName": "Add SignalR?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Adds SignalR sample."
        },
        "offlineDb": {
            "displayName": "Add Offline db?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Adds support for EF Core DbContext on the client side. If your app doesn't need offline data storage, we recommend not enabling this feature."
        },
        "cloudflare": {
            "displayName": "Add cloudflare CDN integration?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "true",
            "description": "Adds cloudflare CDN integration."
        },
        "ads": {
            "displayName": "Add Ads?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Adds GoogleAds integration."
        },
        "brouter": {
            "displayName": "Use bit Brouter?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Replaces the built-in Blazor Router with bit Brouter, bringing advanced routing features - nested routes, route guards, data loaders, keep-alive pages and view transitions - inspired by the routers of Vue.js, React and Angular."
        },
        "theme": {
            "displayName": "Theme",
            "type": "parameter",
            "datatype": "choice",
            "defaultValue": "Fluent2",
            "choices": [
                {
                    "choice": "Fluent2",
                    "description": "Fluent 2 design system"
                },
                {
                    "choice": "Fluent",
                    "description": "Fluent design system"
                },
                {
                    "choice": "Cupertino",
                    "description": "Cupertino design system (experimental)"
                },
                {
                    "choice": "Material",
                    "description": "Material design system (experimental)"
                }
            ],
            "description": "The design system the app's UI ships with, powered by bit BlazorUI theming."
        },
        // The host pages pin the chosen design system twice: as bit-theme-light / bit-theme-dark preset names in the
        // index.html files and as BitThemePresets / BitExtraThemePresets constants in App.razor. Both spellings are
        // rewritten here, so the host pages need no conditional directives around those attributes.
        "themeLightName": {
            "type": "generated",
            "generator": "switch",
            "replaces": "fluent2-light",
            "parameters": {
                "evaluator": "C++",
                "datatype": "string",
                "cases": [
                    {
                        "condition": "(theme == 'Fluent')",
                        "value": "fluent-light"
                    },
                    {
                        "condition": "(theme == 'Cupertino')",
                        "value": "cupertino-light"
                    },
                    {
                        "condition": "(theme == 'Material')",
                        "value": "material-light"
                    },
                    {
                        "condition": "",
                        "value": "fluent2-light"
                    }
                ]
            }
        },
        "themeDarkName": {
            "type": "generated",
            "generator": "switch",
            "replaces": "fluent2-dark",
            "parameters": {
                "evaluator": "C++",
                "datatype": "string",
                "cases": [
                    {
                        "condition": "(theme == 'Fluent')",
                        "value": "fluent-dark"
                    },
                    {
                        "condition": "(theme == 'Cupertino')",
                        "value": "cupertino-dark"
                    },
                    {
                        "condition": "(theme == 'Material')",
                        "value": "material-dark"
                    },
                    {
                        "condition": "",
                        "value": "fluent2-dark"
                    }
                ]
            }
        },
        "themeLightConstant": {
            "type": "generated",
            "generator": "switch",
            "replaces": "BitExtraThemePresets.Fluent2Light",
            "parameters": {
                "evaluator": "C++",
                "datatype": "string",
                "cases": [
                    {
                        "condition": "(theme == 'Fluent')",
                        "value": "BitThemePresets.FluentLight"
                    },
                    {
                        "condition": "(theme == 'Cupertino')",
                        "value": "BitExtraThemePresets.CupertinoLight"
                    },
                    {
                        "condition": "(theme == 'Material')",
                        "value": "BitExtraThemePresets.MaterialLight"
                    },
                    {
                        "condition": "",
                        "value": "BitExtraThemePresets.Fluent2Light"
                    }
                ]
            }
        },
        "themeDarkConstant": {
            "type": "generated",
            "generator": "switch",
            "replaces": "BitExtraThemePresets.Fluent2Dark",
            "parameters": {
                "evaluator": "C++",
                "datatype": "string",
                "cases": [
                    {
                        "condition": "(theme == 'Fluent')",
                        "value": "BitThemePresets.FluentDark"
                    },
                    {
                        "condition": "(theme == 'Cupertino')",
                        "value": "BitExtraThemePresets.CupertinoDark"
                    },
                    {
                        "condition": "(theme == 'Material')",
                        "value": "BitExtraThemePresets.MaterialDark"
                    },
                    {
                        "condition": "",
                        "value": "BitExtraThemePresets.Fluent2Dark"
                    }
                ]
            }
        },
        "nameToLower": {
            "type": "generated",
            "generator": "casing",
            "parameters": {
                "source": "name",
                "toLower": true
            },
            "replaces": "boilerplate"
        },
        "nameToAppId": {
            "type": "generated",
            "generator": "regex",
            "dataType": "string",
            "parameters": {
                "source": "nameToLower",
                "steps": [
                    {
                        "regex": "[^a-z0-9_\\.]",
                        "replacement": ""
                    }
                ]
            }
        },
        "defaultAppId": {
            "type": "generated",
            "generator": "join",
            "parameters": {
                "symbols": [
                    {
                        "type": "const",
                        "value": "com.companyname."
                    },
                    {
                        "type": "ref",
                        "value": "nameToAppId"
                    }
                ]
            },
            "replaces": "com.bitplatform.template"
        },
        "serverWebPortGenerated": {
            "type": "generated",
            "generator": "port",
            "parameters": {
                "low": 5000,
                "high": 5000,
                "fallback": 5030
            },
            "replaces": "5030"
        },
        "aspirePortGenerated_1": {
            "type": "generated",
            "generator": "port",
            "parameters": {
                "low": 2001,
                "high": 2300,
                "fallback": 2030
            },
            "replaces": "2030"
        },
        "aspirePortGenerated_2": {
            "type": "generated",
            "generator": "port",
            "parameters": {
                "low": 2001,
                "high": 2300,
                "fallback": 2031
            },
            "replaces": "2031"
        },
        "aspirePortGenerated_3": {
            "type": "generated",
            "generator": "port",
            "parameters": {
                "low": 2001,
                "high": 2300,
                "fallback": 2032
            },
            "replaces": "2032"
        },
        "serveApiPortGenerated": {
            "type": "generated",
            "generator": "port",
            "parameters": {
                "low": 5001,
                "high": 5300,
                "fallback": 5031
            },
            "replaces": "5031"
        },
        "clientWebPortGenerated": {
            "type": "generated",
            "generator": "port",
            "parameters": {
                "low": 4000,
                "high": 4300,
                "fallback": 4030
            },
            "replaces": "4030"
        },
        "apiServerUrl": {
            "displayName": "Server url",
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "use-your-api-server-url-here.com",
            "description": "The backend api server url. You can change its value later if needed."
        },
        "normalizedServerUrl": {
            "type": "generated",
            "generator": "regex",
            "dataType": "string",
            "parameters": {
                "source": "apiServerUrl",
                "steps": [
                    {
                        "regex": "^(https|http):\/\/",
                        "replacement": ""
                    },
                    // A pasted url carries a trailing slash, and this value lands in bare-host positions
                    // (iOS/MacCatalyst `applinks:` entitlements, Android `DataHosts`) where `host/` never matches.
                    // Only the trailing slash is stripped - a base path is legitimate in ServerAddress.
                    {
                        "regex": "\/+$",
                        "replacement": ""
                    }
                ]
            },
            "replaces": "use-your-api-server-url-here.com"
        },
        "webAppUrl": {
            "displayName": "web app url",
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "use-your-web-app-url-here.com",
            "description": "The web app url. You can change its value later if needed."
        },
        "normalizedWebAppUrl": {
            "type": "generated",
            "generator": "regex",
            "dataType": "string",
            "parameters": {
                "source": "webAppUrl",
                "steps": [
                    {
                        "regex": "^(https|http):\/\/",
                        "replacement": ""
                    },
                    // See normalizedServerUrl: a trailing slash breaks the bare-host call sites.
                    {
                        "regex": "\/+$",
                        "replacement": ""
                    }
                ]
            },
            "replaces": "use-your-web-app-url-here.com"
        },
        "advancedTests": {
            "displayName": "Include advanced automated tests?",
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Includes advanced automated tests (e.g. the Blazor WebAssembly offline sync test) that add extra infrastructure not needed by a typical project."
        }
    },
    "postActions": [
        {
            "description": "restore project dependencies",
            "manualInstructions": [
                {
                    "text": "Run 'dotnet restore'"
                }
            ],
            "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
            "args": {
                "files": [
                    "Boilerplate.Web.slnf"
                ]
            },
            "continueOnError": true
        },
        {
            "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
            "description": "Opens README.md in the editor",
            "manualInstructions": [],
            "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
            "args": {
                "files": "0" // "README.md"
            },
            "continueOnError": true
        }
    ],
    "primaryOutputs": [
        {
            "path": "README.md"
        },
        {
            "path": "Boilerplate.sln"
        }
    ],
    "sources": [
        {
            "modifiers": [
                {
                    "copyOnly": [
                        "**/*.svg",
                        "**/*.png",
                        "**/*.sh"
                    ],
                    "exclude": [
                        ".vs/**",
                        "**/[Bb]in/**",
                        "**/[Oo]bj/**",
                        // Build / tooling output that a local `dotnet pack` would otherwise carry into the
                        // nupkg (node_modules alone is ~50MB) and from there into every generated project.
                        "**/node_modules/**",
                        "**/[Tt]est[Rr]esults/**",
                        ".playwright-mcp/**",
                        ".template.config/**",
                        "**/*.filelist",
                        "**/*.user",
                        "**/*.lock.json",
                        "**/.git/**",
                        "**/*.nuspec",
                        "src/Server/**/Data/Migrations/**",
                        "src/**/App_Data/**",
                        // E2E tests against the deployed demo apps (adminpanel/todo/sales.bitplatform.dev and friends),
                        // which only exist for this repository - a generated project has no such deployments.
                        "src/Internal/**",
                        // Needs ProductController (Admin module) and ProductViewController + the product page (Sales
                        // module) at once, and "module" is a single choice, so it can only ever run against the
                        // template's own source tree.
                        "src/Tests/Features/Caching/ProductResponseCacheTests.cs",
                        // Only that test uses it.
                        "src/Tests/Features/Caching/ReplayCountingOutputCacheStore.cs"
                    ]
                },
                {
                    "condition": "(pipeline != GitHub)",
                    "exclude": [
                        ".github/workflows**"
                    ]
                },
                {
                    "condition": "(pipeline != Azure)",
                    "exclude": [
                        ".azure-devops/**"
                    ]
                },
                {
                    "condition": "(module != Admin)",
                    "exclude": [
                        "src/Shared/Features/Dashboard/**",
                        "src/Server/Boilerplate.Server.Api/Features/Dashboard/**",
                        "src/Server/Boilerplate.Server.Api/Features/Categories/CategoryController.cs",
                        "src/Server/Boilerplate.Server.Api/Features/Products/ProductController.cs",
                        "src/Shared/Features/Categories/ICategoryController.cs",
                        "src/Shared/Features/Products/IProductController.cs",
                        "src/Client/Boilerplate.Client.Core/Components/Pages/Dashboard/**",
                        "src/Client/Boilerplate.Client.Core/Components/Pages/Categories/**",
                        "src/Client/Boilerplate.Client.Core/Components/Pages/Products/**",
                        // Drive ProductController / CategoryController, which this same rule removes.
                        "src/Tests/Features/Products/ProductImageLifecycleTests.cs",
                        "src/Tests/Features/Categories/CategoryDeleteGuardTests.cs",
                        "src/Tests/Features/Products/AddOrEditProductPageTests.cs"
                    ]
                },
                {
                    "condition": "(module != Sales)",
                    "exclude": [
                        "src/Server/Boilerplate.Server.Api/Features/Products/ProductViewController.cs",
                        "src/Shared/Features/Products/IProductViewController.cs",
                        "src/Client/Boilerplate.Client.Core/Components/Pages/Home/ProductsCarousel.*",
                        "src/Client/Boilerplate.Client.Core/Components/Pages/Home/ProductsSection.*",
                        "src/Client/Boilerplate.Client.Core/Components/Pages/ProductPage.*"
                    ]
                },
                {
                    "condition": "(module != Admin && module != Sales)",
                    "exclude": [
                        "src/Shared/Features/Categories/**",
                        "src/Shared/Features/Products/**",
                        "src/Server/Boilerplate.Server.Api/Features/Categories/**",
                        "src/Server/Boilerplate.Server.Api/Features/Products/**",
                        "src/Client/Boilerplate.Client.Core/wwwroot/images/car_placeholder*",
                        // Covers ProductConfiguration's seed and ProductDto.FormattedPrice, both of which this rule removes.
                        "src/Tests/Features/Products/ProductCultureSafetyTests.cs"
                    ]
                },  
                {
                    "condition": "(sample != true && offlineDb != true)",
                    "exclude": [
                        "src/Shared/Features/Todo/**",
                        "src/Server/Boilerplate.Server.Api/Features/Todo/**",
                        "src/Client/Boilerplate.Client.Core/Components/Pages/TodoPage.*",
                        "src/Client/Boilerplate.Client.Core/wwwroot/images/backgrounds/empty-todo-list-bg.svg"
                    ]
                },
                {
                    "condition": "(offlineDb == true)",
                    "exclude": [
                        "src/Client/Boilerplate.Client.Core/Components/Pages/TodoPage.*"
                    ]
                },
                {
                    "condition": "(offlineDb != true)",
                    "exclude": [
                        "src/Server/Boilerplate.Server.Web/.config/**",
                        "src/Server/Boilerplate.Server.Api/Features/Todo/TodoItemTableController.cs",
                        "src/Client/Boilerplate.Client.Core/Infrastructure/Data/**",
                        "src/Client/Boilerplate.Client.Core/Infrastructure/Services/SyncService.cs",
                        "src/Client/Boilerplate.Client.Core/Components/Pages/OfflineTodoPage*",
                        "src/Shared/Infrastructure/Dtos/BaseDtoTableData.cs",
                        "src/Tests/Features/Todo/OfflineTodoTests.cs"
                    ]
                },
                {
                    "condition": "(advancedTests != true)",
                    "exclude": [
                        "src/Tests/Features/ServerWeb/**",
                        "src/Tests/Features/DevMcp/**",
                        "src/Tests/Features/Identity/AuthManagerRefreshCoordinationTests.cs",
                        "src/Tests/Features/Identity/AuthManagerTokenPersistenceTests.cs",
                        "src/Tests/Features/Identity/AccessTokenParsingTests.cs",
                        "src/Tests/Features/Identity/IStorageServiceContractTests.cs",
                        "src/Tests/Infrastructure/Components/BitOtpInputUtils.cs",
                        "src/Tests/Infrastructure/Components/BitSnackBarUtils.cs",
                        "src/Tests/Features/Todo/OfflineTodoTests.cs",
                        "src/Tests/Features/Urls/ODataQueryFilterTests.cs",
                        "src/Tests/Features/Diagnostics/TelemetryScopeTests.cs",
                        "src/Tests/Features/Diagnostics/LoggingConfigurationTests.cs",
                        "src/Tests/Features/Diagnostics/AppInsightsReadinessTests.cs",
                        "src/Tests/Features/Diagnostics/DiagnosticModalVirtualizationTests.cs",
                        "src/Tests/Features/TemplateConfig/SourceNameLeakTests.cs",
                        "src/Tests/Features/TemplateConfig/HybridHostHardeningTests.cs",
                        "src/Tests/Features/TemplateConfig/VelopackPackagingContractTests.cs",
                        "src/Tests/Features/TemplateConfig/PwaManifestShortcutTests.cs",
                        "src/Tests/Features/Culture/CultureCookieParsingTests.cs",
                        "src/Tests/Features/Culture/CultureUrlRedirectionTests.cs",
                        "src/Tests/Features/Culture/ResxParityTests.cs",
                        "src/Tests/Features/TemplateConfig/BitComponentParameterTests.cs",
                        "src/Tests/Features/Products/AddOrEditProductPageTests.cs",
                        "src/Tests/Features/Ads/AdsServiceTests.cs",
                        "src/Tests/Features/Configuration/ClientSettingsValidationTests.cs",
                        "src/Tests/Features/Identity/TrustedOriginsTests.cs",
                        "src/Tests/Features/Identity/MagicLinkSignInTests.cs",
                        "src/Tests/Features/Identity/MagicLinkSignInUtils.cs",
                        "src/Tests/Features/Identity/MagicLinkReplayTests.cs",
                        "src/Tests/Features/Identity/TwoFactorAuthTests.cs",
                        "src/Tests/Features/Identity/TwoFactorAmrClaimTests.cs",
                        "src/Tests/Features/Identity/PrivilegedSessionTests.cs",
                        "src/Tests/Features/Identity/PrivilegedSessionTenantSwitchTests.cs",
                        "src/Tests/Features/Identity/UserManagementTenantScopingTests.cs",
                        "src/Tests/Features/Identity/RefreshTokenRotationTests.cs",
                        "src/Tests/Features/Identity/ReturnUrlHardeningTests.cs",
                        "src/Tests/Features/Identity/OneTimeTokenTests.cs",
                        "src/Tests/Features/Identity/AccountSelfServiceSecurityTests.cs",
                        "src/Tests/Features/Identity/IdentityEmailDeliveryTests.cs",
                        "src/Tests/Features/Identity/EmailUniquenessIndexTests.cs",
                        "src/Tests/Features/Identity/TestAccountUtils.cs",
                        "src/Tests/Features/Identity/AccountErasureTests.cs",
                        "src/Tests/Features/Identity/PersonalDataExportTests.cs",
                        "src/Tests/Features/Identity/UnconfirmedUsersRetentionTests.cs",
                        "src/Tests/Features/Attachments/AttachmentMetadataStrippingTests.cs",
                        "src/Tests/Features/Identity/RoleAdministrationGuardTests.cs",
                        "src/Tests/Features/Identity/ConfirmPageTwoFactorTests.cs",
                        "src/Tests/Features/Identity/SignInPanelCredentialStateTests.cs",
                        "src/Tests/Features/Identity/WebAuthnEnrolmentElevationTests.cs",
                        "src/Tests/Features/Identity/TwoFactorSharedKeyExposureTests.cs",
                        "src/Tests/Features/Identity/AccountSectionDeepLinkTests.cs",
                        "src/Tests/Features/Identity/UserGroupFeatureManagementUITests.cs",
                        "src/Tests/Features/Seo/**",
                        "src/Tests/Features/Tenants/TenantInvitationUITests.cs",
                        "src/Tests/Features/Tenants/TenantInvitationIsolationTests.cs",
                        "src/Tests/Features/Tenants/TenantInvitationEmailCultureTests.cs",
                        "src/Tests/Features/MinimalApiSample/IntegrationTests.cs",
