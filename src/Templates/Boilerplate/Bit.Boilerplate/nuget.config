<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Npgsql's EF 11 provider pins Microsoft.EntityFrameworkCore(.Relational) to exactly
             11.0.0-rc.1.26431.118, and that build is on .NET's own feed rather than nuget.org, which
             stops at 11.0.0-rc.1.26425.128. Without this source the project cannot restore.

             This is here for as long as .NET 11 is a release candidate. Once EF and Npgsql agree on a
             version nuget.org carries, delete this file. -->
        <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <!-- Central package management warns (NU1507) when more than one source is open to every
             package. EF 11's build pulls a set of Microsoft.* packages that only the .NET feed
             carries, so that family is served by both sources and everything else by nuget.org. -->
        <packageSource key="nuget.org">
            <package pattern="*" />
            <package pattern="Microsoft.*" />
        </packageSource>
        <packageSource key="dotnet11">
            <package pattern="Microsoft.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
