<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <IsTrimmable>true</IsTrimmable>
        <PackageTags>$(PackageTags);Blazor;MAUI;State management;Redux;Flux;DevTools</PackageTags>
        <Description>Lightweight, source-generator-powered reactive state management for Blazor and .NET MAUI, with computed state, effects, middleware, persistence, undo/redo and Redux DevTools time-travel. Add Bit.Blex.Generators next to it for the source generator.</Description>
        <PackageDescription>$(Description)</PackageDescription>
    </PropertyGroup>

    <ItemGroup>
        <!-- Floating low-bound ranges so consumers can pin to any servicing release of their TFM's band;
             the upper bound keeps a newer major (which targets a newer TFM) from being pulled in. -->
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.0,9.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[9.0.0,10.0.0)" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.0,11.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System" />
        <Using Include="System.Linq" />
        <Using Include="System.Threading" />
        <Using Include="System.Threading.Tasks" />
        <Using Include="System.Collections.Generic" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.Blex.Blazor" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Blex.Blazor" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Blex.Maui" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Blex.Maui" PublicKey="" />
        <InternalsVisibleTo Include="Bit.Blex.Tests" PublicKey="" />
    </ItemGroup>

</Project>
