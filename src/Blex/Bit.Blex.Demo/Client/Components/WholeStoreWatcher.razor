@inherits BlexComponentBase
@inject CounterStore Counter

@*
    Subscribe(store): re-renders on ANY change to the store, including fields this component
    never displays.
*@
<div class="card">
    <p class="card__title">
        <span class="card__num">Subscribe(Store)</span>
    </p>
    <p class="card__body">Renders on any change to the store.</p>
    <div class="readout" style="margin-top:0.6rem">
        <div class="readout__item">
            <span class="readout__label">Count (displayed)</span>
            <span class="readout__value">@Counter.Count</span>
        </div>
        <div class="readout__item">
            <span class="readout__label">Renders</span>
            <span class="readout__value readout__value--accent">@_renders</span>
        </div>
    </div>
</div>

@code {
    private int _renders;

    protected override void OnInitialized() => Subscribe(Counter);

    protected override void OnAfterRender(bool firstRender) => _renders++;
}
