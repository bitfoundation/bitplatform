    private const string AttributeSummary = """
        [BlexStore(Name = "cart", Persist = true)]
        public partial class CartStore
        {
            [BlexState]    private IReadOnlyList<CartLine> _lines = [];

            [BlexComputed] private decimal ComputeTotal() => Lines.Sum(l => l.Total);

            [BlexAction]   private void OnAdd(CartLine line) => Lines = [.. Lines, line];

            [BlexEffect(Concurrency = BlexEffectConcurrency.Drop)]
            private async Task OnCheckout(CancellationToken ct) => await _api.CheckoutAsync(Lines, ct);
        }
        """;

