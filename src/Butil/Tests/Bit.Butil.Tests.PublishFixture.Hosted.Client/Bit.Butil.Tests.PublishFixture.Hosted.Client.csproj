<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!--
    The WebAssembly client of Bit.Butil.Tests.PublishFixture.Hosted, and on its own a standalone PWA - see
    ScriptPublishing.cs in Bit.Butil.Tests.Manual, which publishes it both ways.

    It owns the service worker, so it is the project that writes service-worker-assets.js, and it writes it during
    its own publish, from its own copy of Bit.Butil's JavaScript. Its one Bit.Butil class (Clipboard) is one fewer
    than the server's, so the server's trimmed bundle is never the bundle this project listed: that difference is
    the case under test, not an accident of the fixture.

    Not in the solution, and not a test project, for the same reasons as Bit.Butil.Tests.PublishFixture.
    -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <!-- One framework per publish, picked with a property the server shares: -f does not reach a project
             reference, and the client has to be published for the framework the server is. -->
        <TargetFramework Condition="'$(FixtureFramework)' != ''">$(FixtureFramework)</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <RootNamespace>ButilTests.PublishFixture.Hosted.Client</RootNamespace>
        <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    </PropertyGroup>

    <ItemGroup>
        <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.33" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
        <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.2.26504.105" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.Butil\Bit.Butil.csproj" />
    </ItemGroup>

    <!-- The same hand-import as the other fixtures. BitButilTrimScripts is left to its WebAssembly default (on)
         unless a scenario turns it off here alone, through FixtureClientTrimScripts: a client that does not trim
         lists every module file, which is the manifest a lazy-scripts server has to drop most of. -->
    <PropertyGroup>
        <BitButilChunksDirectory>$(MSBuildThisFileDirectory)..\..\Bit.Butil\obj\butil-js\chunks\</BitButilChunksDirectory>
        <BitButilBuildTasksAssembly>$(MSBuildThisFileDirectory)..\..\Bit.Butil.Build\bin\$(Configuration)\netstandard2.0\Bit.Butil.Build.dll</BitButilBuildTasksAssembly>
        <BitButilTrimScripts Condition="'$(FixtureClientTrimScripts)' != ''">$(FixtureClientTrimScripts)</BitButilTrimScripts>
    </PropertyGroup>

    <Import Project="..\..\Bit.Butil\buildTransitive\Bit.Butil.targets" />

</Project>
