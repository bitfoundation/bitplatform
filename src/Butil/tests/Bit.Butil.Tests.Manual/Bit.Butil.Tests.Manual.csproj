<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- The project's own name minus the Bit.Butil prefix, deliberately: a namespace nested under
         Bit.Butil would make the library's own Bit.Butil.Console type shadow System.Console
         throughout this project. -->
    <RootNamespace>ButilTests.Manual</RootNamespace>
  </PropertyGroup>

  <!-- Trimming harness. `dotnet run` executes the app untrimmed (every Butil service registers);
       `dotnet publish` produces a trimmed, self-contained app where only the Butil classes this
       project actually references should survive. The program reports which ones did and fails with
       a non-zero exit code when the outcome does not match the expectation, so the same executable
       serves both as the report and as the check.

       TrimMode=full matches what Blazor WebAssembly uses, so the result here reflects what a real
       consumer app gets. TrimmerSingleWarn=false surfaces every trim warning individually instead of
       collapsing them into one per assembly - the whole point of this project is to read them. -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == '' ">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!-- How the program knows which of the two runs it is. CopyToPublishDirectory puts the marker next to
       the published executable only - the build output `dotnet run` executes never gets it - and the
       condition keeps an untrimmed `dotnet publish -p:PublishTrimmed=false` honest. Reading the mode off
       the build beats inferring it from which service names happen to be missing from the assembly, which
       cannot distinguish a trimmed build from a name left stale by a rename. -->
  <ItemGroup>
    <None Update="trimmed-publish.marker"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="PreserveNewest"
          Condition=" '$(PublishTrimmed)' == 'true' " />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Bit.Butil/Bit.Butil.csproj" />
  </ItemGroup>

</Project>
