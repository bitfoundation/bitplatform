<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>

    <!-- The repo's global.json mandates the Microsoft.Testing.Platform runner. EnableMSTestRunner
         builds that test host into the assembly itself, and it only generates the entry point for
         an executable project - as a library the runner never runs. -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>

    <!-- Assert.Scope, which collects several assertion failures into one report, is still marked
         experimental by MSTest. It is what the multi-assertion blocks in this suite are written
         against - a fixture that checks four properties of one page should say which of them broke,
         not just the first. -->
    <NoWarn>$(NoWarn);MSTESTEXP</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- For WebSocketEchoFixture: the WebSocket tests need a real socket endpoint, and the sample
         app under test is a standalone WebAssembly host with no server side to add one to. This is
         the framework the repo already ships, not a new dependency to download. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- The echo protocol itself, compiled from the demo server's copy rather than restated here.
         The suite asserts on this protocol and the demo page is what ships it, so two
         implementations of it would drift and the tests would go on passing against the stale one. -->
    <Compile Include="..\..\Bit.Butil.Demo\Server\Endpoints\WebSocketEcho.cs"
             Link="Infrastructure\WebSocketEcho.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Playwright itself, without a per-framework integration package: the suite drives the browser
         from ButilHarnessTestBase rather than from a PageTest base class - see the comment there. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="MSTest" Version="4.3.3" />
  </ItemGroup>

  <!-- Deliberately no ProjectReference to Bit.Butil: every test here drives a deployed harness page
       through the browser, and this project's namespace sits under Bit.Butil, so referencing the
       library would shadow System.Console, System.Uri-adjacent names and the rest behind Butil's own
       Console/Window/Navigator/Screen services. What can be checked in-process against a stub
       IJSRuntime - the interop and cancellation contracts - lives in Bit.Butil.Tests.Manual. -->

</Project>
