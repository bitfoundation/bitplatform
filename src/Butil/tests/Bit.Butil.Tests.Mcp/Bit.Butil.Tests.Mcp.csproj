<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>

    <!-- The repo's global.json mandates the Microsoft.Testing.Platform runner.
         NUnit supports it via its MTP runner; these switches opt in. -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.5.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.9.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.7.3" />
    <!-- The client half of the same SDK the server is built on. The suite drives /mcp with a real
         protocol client rather than hand-rolled JSON-RPC, so what it exercises is what an editor,
         an agent host or Claude Code exercises - including the handshake and the schemas. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.1.0" />
  </ItemGroup>

  <!-- Deliberately NO ProjectReference to Bit.Butil.Demo.Server. Everything here is asserted from
       outside the process, over HTTP, against the server as it is actually deployed: catalogs built
       from embedded resources, XML documentation read from next to the assembly, and the docs pages
       rendered by the real components. A test that reached into the server's own types could pass
       while the shipped app answered nothing at all. -->

</Project>
