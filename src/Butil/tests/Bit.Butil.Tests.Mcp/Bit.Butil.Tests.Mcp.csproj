<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>

    <!-- The repo's global.json mandates the Microsoft.Testing.Platform runner. EnableMSTestRunner
         builds that test host into the assembly itself, and it only generates the entry point for
         an executable project - as a library the runner never runs. -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>

    <!-- Assert.Scope, which collects several assertion failures into one report, is still marked
         experimental by MSTest. Most of the fixtures here check a whole answer at once - every cell
         of a table, every tool's annotations - and are worth far less if the report stops at the
         first cell that broke. -->
    <NoWarn>$(NoWarn);MSTESTEXP</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.3.3" />
    <!-- The client half of the same SDK the server is built on. The suite drives /mcp with a real
         protocol client rather than hand-rolled JSON-RPC, so what it exercises is what an editor,
         an agent host or Claude Code exercises - including the handshake and the schemas. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

  <!-- Deliberately NO ProjectReference to Bit.Butil.Demo.Server. Everything here is asserted from
       outside the process, over HTTP, against the server as it is actually deployed: catalogs built
       from embedded resources, XML documentation read from next to the assembly, and the docs pages
       rendered by the real components. A test that reached into the server's own types could pass
       while the shipped app answered nothing at all. -->

</Project>
