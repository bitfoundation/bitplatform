@inject ThemeService theme

@* Fluent 2's command bar: one 56px band, an identity block at the start, the utilities at the end,
   and everything in it a 32px control on the 4px grid. The bar is the only chrome that is on every
   page - the nav panel is not on the home page - so anything a reader must be able to reach from
   anywhere lives here: search, the two outbound links, and the theme. *@

<header class="header">
    <div class="container@(IsHomePage ? " home-page" : "")">
        <div class="header-start">
            @if (IsHomePage is false)
            {
                <button class="icon-btn menu-btn" title="Toggle navigation" aria-label="Toggle navigation"
                        aria-expanded="@(IsNavPanelOpen ? "true" : "false")" aria-controls="nav-panel"
                        @onclick="OnToggleNavPanel">
                    <Icon Name="@(IsNavPanelOpen ? "dismiss" : "navigation")" Size="20" />
                </button>
            }

            @* The mark and the name are one link to the home page rather than two things that
               happen to sit together, which is also what keeps the target comfortably past 44px
               on a phone once the name is hidden. *@
            <a class="brand" href="" aria-label="bit Butil, homepage">
                <span class="brand-mark" aria-hidden="true"></span>
                <span class="brand-name">Butil</span>
            </a>

            <nav class="header-nav" aria-label="Sections">
                <a class="link@(IsHomePage ? " active" : "")" href="" aria-current="@(IsHomePage ? "page" : null)">Home</a>
                <a class="link@(IsHomePage ? "" : " active")" href="getting-started" aria-current="@(IsHomePage ? null : "page")">Docs</a>
            </nav>
        </div>

        <div class="header-end">
            @* The page is prerendered on the server, so it is visible - and inert - until the
               WebAssembly runtime takes over. Say so instead of letting clicks silently do
               nothing. *@
            @if (RendererInfo.IsInteractive is false)
            {
                @* The word is its own element so the narrowest screens - where the row is already
                   full without it - can keep the pulsing dot and drop the label. *@
                <span class="hydrating" title="Prerendered HTML - the WebAssembly runtime is still loading.">
                    <i></i><span>loading</span>
                </span>
            }

            @* In the bar rather than inside the nav panel, which only exists on documentation
               pages: search has to work from the home page too. *@
            <SearchBox />

            <a class="icon-btn" target="_blank" rel="noopener noreferrer"
               title="Bit.Butil on NuGet" aria-label="Bit.Butil on NuGet (opens in a new tab)"
               href="https://www.nuget.org/packages/Bit.Butil">
                <Icon Name="package" Size="20" />
            </a>

            <a class="icon-btn github-btn" target="_blank" rel="noopener noreferrer"
               title="bitplatform on GitHub" aria-label="bitplatform on GitHub (opens in a new tab)"
               href="https://github.com/bitfoundation/bitplatform"></a>

            @* One button rather than the two the BlazorUI demo swaps between with CSS: without the
               library's icon font the glyph is inline SVG, which is cheaper to render once and
               relabel than to render twice and hide one. *@
            <button class="icon-btn" @onclick="theme.Toggle"
                    title="@(theme.IsDark ? "Switch to the light theme" : "Switch to the dark theme")"
                    aria-label="@(theme.IsDark ? "Switch to the light theme" : "Switch to the dark theme")">
                <Icon Name="@(theme.IsDark ? "sun" : "moon")" Size="20" />
            </button>
        </div>
    </div>
</header>

@code {
    [Parameter] public bool IsHomePage { get; set; }

    [Parameter] public bool IsNavPanelOpen { get; set; }

    [Parameter] public EventCallback OnToggleNavPanel { get; set; }
}
