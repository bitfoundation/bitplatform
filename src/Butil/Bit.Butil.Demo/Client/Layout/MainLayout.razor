@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService theme

<div class="shell" data-theme="@theme.Current">
    <NavMenu @ref="_nav" />

    <div class="main">
        <header class="topbar">
            <button class="menu-btn" title="Toggle navigation" @onclick="() => _nav.Toggle()">☰</button>
            <span class="topbar-title">Bit.Butil <span class="muted">/ browser APIs for Blazor, without JavaScript</span></span>
            @* The page is prerendered on the server, so it is visible - and inert - until the
               WebAssembly runtime takes over. Say so instead of letting clicks silently do nothing. *@
            @if (RendererInfo.IsInteractive is false)
            {
                <span class="hydrating" title="Prerendered HTML - the WebAssembly runtime is still loading.">
                    <i></i>loading
                </span>
            }
            <div class="topbar-links">
                <a href="https://www.nuget.org/packages/Bit.Butil" target="_blank" rel="noopener noreferrer">NuGet</a>
                <a href="https://github.com/bitfoundation/bitplatform" target="_blank" rel="noopener noreferrer">GitHub</a>
            </div>
            <button class="theme-btn" title="Switch to @(theme.IsDark ? "light" : "dark") theme" @onclick="theme.Toggle">
                @(theme.IsDark ? "☀️" : "🌙")
            </button>
        </header>

        <main class="content">
            @Body

            <footer class="footer">
                <span>Bit.Butil demo &amp; documentation - part of the <a href="https://bitplatform.dev" target="_blank" rel="noopener noreferrer">bit platform</a> project.</span>
            </footer>
        </main>
    </div>
</div>

@code {
    private NavMenu _nav = default!;

    protected override void OnInitialized()
    {
        theme.Changed += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await theme.Initialize();
        }
    }

    private void OnThemeChanged() => StateHasChanged();

    public void Dispose()
    {
        theme.Changed -= OnThemeChanged;
    }
}
