    private async Task TransactDemo()
    {
        if (await EnsureOpen(transactOutput) is false) return;
        try
        {
            var keys = await db!.Transact(
            [
                IndexedDbOperation.Put(StoreName, new Note { Id = 101, Text = "batched one", Category = "batch" }),
                IndexedDbOperation.Put(StoreName, new Note { Id = 102, Text = "batched two", Category = "batch" }),
                IndexedDbOperation.Delete(StoreName, 103),
            ],
            durability: IndexedDbDurability.Relaxed);

            await transactOutput.Success($"Transact(3 ops) → keys [{string.Join(", ", keys.Select(k => k.ToString()))}]");
        }
        catch (Exception ex)
        {
            await transactOutput.Error(ex.Message);
        }
    }

    private async Task TransactRollbackDemo()
    {
        if (await EnsureOpen(transactOutput) is false) return;
        try
        {
            // The second Add duplicates the first, so the batch aborts and neither record survives.
            await db!.Transact(
            [
                IndexedDbOperation.Put(StoreName, new Note { Id = 201, Text = "written first", Category = "rollback" }),
                IndexedDbOperation.Add(StoreName, new Note { Id = 201, Text = "duplicate key", Category = "rollback" }),
            ]);
            await transactOutput.Warn("Expected the batch to abort, but it committed.");
        }
        catch (Exception ex)
        {
            await transactOutput.Error($"Batch aborted: {ex.Message}");
            var survivor = await db!.Get<Note>(StoreName, 201);
            await transactOutput.Success($"Get(201) → {(survivor is null ? "not found - the whole batch rolled back" : "found (unexpected)")}");
        }
    }

