    private async Task<bool> EnsureOpen(DemoConsole output)
    {
        if (db is not null) return true;
        await output.Warn("No open database - use \"Open database\" first.");
        return false;
    }

    private async Task CheckSupport()
    {
        try
        {
            await supportOutput.Success("IsSupported() →", await indexedDb.IsSupported());
        }
        catch (Exception ex)
        {
            await supportOutput.Error(ex.Message);
        }
    }

    private async Task OpenDb()
    {
        try
        {
            db = await indexedDb.Open(DbName, 2,
            [
                new IndexedDbStoreSchema
                {
                    Name = StoreName,
                    KeyPath = "id",
                    Indexes =
                    [
                        new IndexedDbIndexSchema { Name = IndexName, KeyPath = "category" },
                    ],
                },
                new IndexedDbStoreSchema { Name = BlobStoreName },
            ],
            onVersionChange: () => InvokeAsync(() => openOutput.Warn("onVersionChange - another tab is upgrading; this handle was closed.")),
            onClose: () => InvokeAsync(() => openOutput.Warn("onClose - the connection died unexpectedly.")));

            await openOutput.Log($"Open(\"{DbName}\", 2) → connection open, stores [{string.Join(", ", db.StoreNames)}].");
            await openOutput.Success($"Version {db.Version}, WasUpgraded = {db.WasUpgraded}"
                + (db.WasUpgraded ? $" (v{db.OldVersion} → v{db.NewVersion})" : ""));
        }
        catch (Exception ex)
        {
            await openOutput.Error(ex.Message);
        }
    }

