            await importExportOutput.Info("Generating RSA-2048 key pair...");
            _rsaPair ??= await crypto.GenerateRsaKeyPair(2048, CryptoKeyHash.Sha256);

            var jwk = await crypto.ExportJsonWebKey(_rsaPair.PublicKey, CryptoKeyFormat.Spki, CryptoKeyAlgorithm.RsaOaep());
            await importExportOutput.Success("ExportJsonWebKey (SPKI → JWK) →", $"kty={jwk.Kty}, alg={jwk.Alg}, e={jwk.E}, n={jwk.N?[..24]}...");

            var spki = await crypto.ImportJsonWebKey(jwk, CryptoKeyAlgorithm.RsaOaep(), CryptoKeyFormat.Spki);
            await importExportOutput.Success("ImportJsonWebKey (JWK → SPKI) →", $"{spki.Length} bytes, identical to the original: {spki.SequenceEqual(_rsaPair.PublicKey)}");
        }
        catch (Exception ex)
        {
            await importExportOutput.Error("RSA JWK export failed:", ex.Message);
        }
    }

    private async Task EcdhAgreement()
    {
        try
        {
            var alice = await crypto.GenerateEcdhKeyPair("P-256");
            var bob = await crypto.GenerateEcdhKeyPair("P-256");
            await ecdhOutput.Log("Generated a P-256 pair for each side.");

            var aliceKey = await crypto.DeriveEcdhKey(alice.PrivateKey, bob.PublicKey, CryptoKeyAlgorithm.AesGcm(256));
            var bobKey = await crypto.DeriveEcdhKey(bob.PrivateKey, alice.PublicKey, CryptoKeyAlgorithm.AesGcm(256));

            await ecdhOutput.Success("DeriveEcdhKey (Alice) →", Convert.ToHexString(aliceKey));
            await ecdhOutput.Success("DeriveEcdhKey (Bob) →", Convert.ToHexString(bobKey));
            await ecdhOutput.Success("Both sides agree →", aliceKey.SequenceEqual(bobKey));

            var shared = await crypto.DeriveEcdhBits(alice.PrivateKey, bob.PublicKey, 256);
            await ecdhOutput.Log($"DeriveEcdhBits → {shared.Length} raw bytes of agreement (feed these to HKDF, don't encrypt with them)");
        }
        catch (Exception ex)
        {
            await ecdhOutput.Error("ECDH failed:", ex.Message);
        }
    }

    private async Task HkdfDerive()
    {
        try
        {
            var secret = await crypto.GetRandomValues(32);
            var salt = await crypto.GetRandomValues(16);

            var encryptionKey = await crypto.DeriveHkdfKey(secret, salt, Encoding.UTF8.GetBytes("encryption"), CryptoKeyAlgorithm.AesGcm(256));
            var signingKey = await crypto.DeriveHkdfKey(secret, salt, Encoding.UTF8.GetBytes("signing"), CryptoKeyAlgorithm.AesGcm(256));

            await hkdfOutput.Success("DeriveHkdfKey (info: encryption) →", Convert.ToHexString(encryptionKey));
            await hkdfOutput.Success("DeriveHkdfKey (info: signing) →", Convert.ToHexString(signingKey));
            await hkdfOutput.Log($"Same secret, different purposes, different keys: {!encryptionKey.SequenceEqual(signingKey)}");

            var bits = await crypto.DeriveHkdfBits(secret, salt, Encoding.UTF8.GetBytes("encryption"), 256);
            await hkdfOutput.Log($"DeriveHkdfBits with the same inputs reproduces the key: {bits.SequenceEqual(encryptionKey)}");
        }
        catch (Exception ex)
        {
            await hkdfOutput.Error("HKDF failed:", ex.Message);
        }
    }

