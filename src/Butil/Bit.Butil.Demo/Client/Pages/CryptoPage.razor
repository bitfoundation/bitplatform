    private async Task AesJwkRoundTrip()
    {
        try
        {
            var key = await crypto.GenerateAesKey(256);
            var algorithm = CryptoKeyAlgorithm.AesGcm(256);

            var jwk = await crypto.ExportJsonWebKey(key, CryptoKeyFormat.Raw, algorithm);
            await importExportOutput.Success("ExportJsonWebKey →", $"kty={jwk.Kty}, alg={jwk.Alg}, k={jwk.K}");

            var roundTripped = await crypto.ImportJsonWebKey(jwk, algorithm, CryptoKeyFormat.Raw);
            await importExportOutput.Success("ImportJsonWebKey →", $"{roundTripped.Length * 8} bits, identical to the original: {roundTripped.SequenceEqual(key)}");
        }
        catch (Exception ex)
        {
            await importExportOutput.Error("JWK round-trip failed:", ex.Message);
        }
    }

    private async Task RsaPublicJwk()
