    private async Task WrapUnwrap()
    {
        try
        {
            var keyToProtect = await crypto.GenerateAesKey(256);
            var wrappingKey = await crypto.GenerateAesKwKey(256);
            var algorithm = CryptoKeyAlgorithm.AesGcm(256);

            var wrapped = await crypto.WrapKey(keyToProtect, CryptoKeyFormat.Raw, algorithm, wrappingKey, new AesKwCryptoAlgorithmParams());
            await wrapOutput.Success("WrapKey (AES-KW) →", $"{wrapped.Length} bytes: {Convert.ToHexString(wrapped)}");

            var recovered = await crypto.UnwrapKey(wrapped, CryptoKeyFormat.Raw, algorithm, wrappingKey, new AesKwCryptoAlgorithmParams());
            await wrapOutput.Success("UnwrapKey →", $"recovered the original key: {recovered.SequenceEqual(keyToProtect)}");

            // AES-GCM wraps too, and unlike AES-KW takes an IV - the same IV has to come back for the unwrap.
            var iv = await crypto.GetRandomValues(12);
            var gcmWrapped = await crypto.WrapKey(keyToProtect, CryptoKeyFormat.Raw, algorithm, wrappingKey,
                new AesGcmCryptoAlgorithmParams { Iv = iv });
            var gcmRecovered = await crypto.UnwrapKey(gcmWrapped, CryptoKeyFormat.Raw, algorithm, wrappingKey,
                new AesGcmCryptoAlgorithmParams { Iv = iv });
            await wrapOutput.Success("WrapKey/UnwrapKey (AES-GCM) →", $"{gcmWrapped.Length} wrapped bytes, recovered: {gcmRecovered.SequenceEqual(keyToProtect)}");
        }
        catch (Exception ex)
        {
            await wrapOutput.Error("Key wrapping failed:", ex.Message);
        }
    }

