@page "/cookie"
@inject Bit.Butil.Cookie cookie

<PageTitle>Cookie - Bit.Butil</PageTitle>

<PageHeader Category="Storage"
            Title="Cookie"
            Lead="Read, write and delete document cookies through a strongly-typed ButilCookie model - no hand-parsing of the document.cookie string, no manually concatenated attribute syntax."
            MdnUrl="https://developer.mozilla.org/en-US/docs/Web/API/Document/cookie"
            InjectAs="Cookie cookie" />

<div class="stack">
    <DemoSection Title="Set a cookie"
                 Api="Set"
                 Description="Set writes a ButilCookie to the document. Name and value are percent-encoded automatically (matching encodeURIComponent semantics), so reserved characters and non-ASCII text round-trip safely with values written by JavaScript or the server."
                 Code=@("""
@inject Bit.Butil.Cookie cookie

await cookie.Set(new ButilCookie
{
    Name = "theme",
    Value = "dark",
});
""")>
        <div class="field-row">
            <div class="field">
                <span class="field-label">Name</span>
                <input @bind="setName" placeholder="e.g. theme" />
            </div>
            <div class="field">
                <span class="field-label">Value</span>
                <input @bind="setValue" placeholder="e.g. dark" />
            </div>
        </div>
        <button @onclick="SetCookie">Set cookie</button>
        <DemoConsole @ref="setOutput" Title="set output" />
    </DemoSection>

    <DemoSection Title="Set with attributes"
                 Api="Set + ButilCookie options"
                 Description="ButilCookie carries every attribute the Set-Cookie syntax supports: Expires, MaxAge, Path, Domain, SameSite, Secure and Partitioned. Expires is emitted in RFC 1123 format; when both Expires and MaxAge are present the browser honors MaxAge."
                 Code=@("""
await cookie.Set(new ButilCookie
{
    Name = "session-hint",
    Value = "abc123",
    MaxAge = 3600,               // seconds
    Path = "/",
    SameSite = SameSite.Strict,
    Secure = true,
});

// or with an absolute expiry:
await cookie.Set(new ButilCookie
{
    Name = "campaign",
    Value = "spring",
    Expires = DateTimeOffset.UtcNow.AddDays(7),
});
""")>
        <div class="field-row">
            <div class="field">
                <span class="field-label">Name</span>
                <input @bind="advName" placeholder="e.g. session-hint" />
            </div>
            <div class="field">
                <span class="field-label">Value</span>
                <input @bind="advValue" placeholder="e.g. abc123" />
            </div>
        </div>
        <div class="field-row">
            <div class="field">
                <span class="field-label">Max-Age (seconds)</span>
                <input @bind="advMaxAge" type="number" placeholder="3600" />
            </div>
            <div class="field">
                <span class="field-label">Path</span>
                <input @bind="advPath" placeholder="/" />
            </div>
            <div class="field">
                <span class="field-label">SameSite</span>
                <select @bind="advSameSite">
                    <option value="">(unset)</option>
                    <option value="None">None</option>
                    <option value="Lax">Lax</option>
                    <option value="Strict">Strict</option>
                </select>
            </div>
        </div>
        <label class="field">
            <span class="field-label">Secure</span>
            <input type="checkbox" @bind="advSecure" />
        </label>
        <button @onclick="SetAdvancedCookie">Set cookie with attributes</button>
        <DemoConsole @ref="attributesOutput" Title="attributes output" />
    </DemoSection>

    <DemoSection Title="Read cookies"
                 Api="Get / GetValue / GetAll"
                 Description="Get returns a single ButilCookie by name, GetValue shortcuts straight to its string value, and GetAll parses every cookie visible to the document. The browser only exposes name=value pairs on read, so attributes such as Path or Expires are never populated on returned cookies."
                 Code=@("""
var theme = await cookie.Get("theme");        // ButilCookie? (Name + Value only)

var value = await cookie.GetValue("theme");   // string?

var all = await cookie.GetAll();              // ButilCookie[]
""")>
        <div class="field">
            <span class="field-label">Name</span>
            <input @bind="getName" placeholder="Cookie name to read" />
        </div>
        <div class="controls">
            <button class="secondary" @onclick="GetCookie">Get</button>
            <button class="secondary" @onclick="GetCookieValue">GetValue</button>
            <button class="secondary" @onclick="GetAllCookies">GetAll</button>
        </div>
        <DemoConsole @ref="readOutput" Title="read output" />
    </DemoSection>

    <DemoSection Title="Remove a cookie"
                 Api="Remove"
                 Description="Remove expires the cookie immediately by rewriting it with MaxAge = 0. Pass a name for the common case, or a full ButilCookie when the original was set with a specific Path or Domain - the attributes must match for the browser to delete it."
                 Code=@("""
await cookie.Remove("theme");

// cookie was set with a path? match it on removal:
await cookie.Remove(new ButilCookie { Name = "session-hint", Path = "/" });
""")>
        <div class="field">
            <span class="field-label">Name</span>
            <input @bind="removeName" placeholder="Cookie name to remove" />
        </div>
        <button class="danger" @onclick="RemoveCookie">Remove cookie</button>
        <DemoConsole @ref="removeOutput" Title="remove output" />
    </DemoSection>
</div>

<Callout Type="warning" Title="HttpOnly cookies are invisible">
    Cookies flagged <code>HttpOnly</code> by the server never appear in <code>document.cookie</code>,
    so neither <code>Get</code> nor <code>GetAll</code> can see them. That is by design - it protects
    session tokens from script access. Use them for anything security-sensitive.
</Callout>

<Callout Type="info" Title="Attributes are write-only">
    The browser returns only <code>name=value</code> pairs when reading cookies. A
    <code>ButilCookie</code> you get back therefore has default values for <code>Domain</code>,
    <code>Expires</code>, <code>MaxAge</code>, <code>Path</code>, <code>SameSite</code>,
    <code>Secure</code> and <code>Partitioned</code> - regardless of how it was originally set.
    If you need full cookie metadata, use the <a href="cookie-store">CookieStore</a> API instead.
</Callout>

<ApiTable Title="API reference">
    <ApiMember Name="GetAll"
               Signature="Task<ButilCookie[]> GetAll()"
               Description="Returns every cookie registered on the current document. Only Name and Value are populated." />
    <ApiMember Name="Get"
               Signature="Task<ButilCookie?> Get(string name)"
               Description="Returns the cookie with the given name, or null when absent." />
    <ApiMember Name="GetValue"
               Signature="Task<string?> GetValue(string name)"
               Description="Returns the value of the named cookie, or null when absent." />
    <ApiMember Name="Set"
               Signature="Task Set(ButilCookie cookie)"
               Description="Writes the cookie to the document, serializing all populated attributes." />
    <ApiMember Name="Remove"
               Signature="Task Remove(string name)"
               Description="Removes a cookie by name (sets MaxAge = 0)." />
    <ApiMember Name="Remove"
               Signature="Task Remove(ButilCookie cookie)"
               Description="Removes a cookie, matching its Path/Domain attributes when they were used to set it." />
    <ApiMember Name="ButilCookie"
               Signature="class ButilCookie { string? Name; string? Value; string? Domain; DateTimeOffset? Expires; long? MaxAge; bool Partitioned; string? Path; SameSite? SameSite; bool Secure; }"
               Description="Strongly-typed cookie model covering every Set-Cookie attribute." />
    <ApiMember Name="ButilCookie.ToString"
               Signature="string ToString()"
               Description="Serializes the cookie to document.cookie syntax with percent-encoded name and value." />
    <ApiMember Name="ButilCookie.Parse"
               Signature="static ButilCookie? Parse(string rawCookie)"
               Description="Parses a raw name=value pair into a ButilCookie; returns null for invalid input." />
    <ApiMember Name="SameSite"
               Signature="enum SameSite { None, Lax, Strict }"
               Description="Controls when the browser sends the cookie on cross-site requests." />
</ApiTable>

@code {
    private DemoConsole setOutput = default!;
    private DemoConsole attributesOutput = default!;
    private DemoConsole readOutput = default!;
    private DemoConsole removeOutput = default!;

    private string setName = "theme";
    private string setValue = "dark";
    private string advName = "session-hint";
    private string advValue = "abc123";
    private long? advMaxAge = 3600;
    private string advPath = "/";
    private string advSameSite = "Lax";
    private bool advSecure;
    private string getName = "theme";
    private string removeName = "";

    private async Task SetCookie()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(setName))
            {
                await setOutput.Warn("Enter a cookie name first.");
                return;
            }

            await cookie.Set(new ButilCookie { Name = setName, Value = setValue });
            await setOutput.Log($"Set(\"{setName}\", \"{setValue}\") →", await cookie.GetValue(setName));
        }
        catch (Exception ex)
        {
            await setOutput.Error(ex.Message);
        }
    }

    private async Task SetAdvancedCookie()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(advName))
            {
                await attributesOutput.Warn("Enter a cookie name first.");
                return;
            }

            var c = new ButilCookie
            {
                Name = advName,
                Value = advValue,
                MaxAge = advMaxAge,
                Path = string.IsNullOrWhiteSpace(advPath) ? null : advPath,
                SameSite = Enum.TryParse<SameSite>(advSameSite, out var sameSite) ? sameSite : null,
                Secure = advSecure,
            };
            await cookie.Set(c);
            await attributesOutput.Log("Set →", c.ToString());
        }
        catch (Exception ex)
        {
            await attributesOutput.Error(ex.Message);
        }
    }

    private async Task GetCookie()
    {
        try
        {
            var result = await cookie.Get(getName);
            if (result is null)
            {
                await readOutput.Warn($"Get(\"{getName}\") → not found");
                return;
            }
            await readOutput.Success($"Get(\"{getName}\") →", result);
        }
        catch (Exception ex)
        {
            await readOutput.Error(ex.Message);
        }
    }

    private async Task GetCookieValue()
    {
        try
        {
            var value = await cookie.GetValue(getName);
            await readOutput.Success($"GetValue(\"{getName}\") →", value ?? "(null)");
        }
        catch (Exception ex)
        {
            await readOutput.Error(ex.Message);
        }
    }

    private async Task GetAllCookies()
    {
        try
        {
            var all = await cookie.GetAll();
            if (all.Length == 0)
            {
                await readOutput.Warn("GetAll() → no cookies on this document.");
                return;
            }
            await readOutput.Success($"GetAll() → {all.Length} cookie(s):", string.Join("; ", all.Select(c => $"{c.Name}={c.Value}")));
        }
        catch (Exception ex)
        {
            await readOutput.Error(ex.Message);
        }
    }

    private async Task RemoveCookie()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(removeName))
            {
                await removeOutput.Warn("Enter a cookie name to remove.");
                return;
            }

            await cookie.Remove(removeName);
            await removeOutput.Warn($"Remove(\"{removeName}\") - cookie expired.");
        }
        catch (Exception ex)
        {
            await removeOutput.Error(ex.Message);
        }
    }
}
