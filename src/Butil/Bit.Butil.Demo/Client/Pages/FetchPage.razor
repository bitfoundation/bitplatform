@page "/fetch"
@inject Bit.Butil.Fetch fetch

<PageTitle>Fetch - Bit.Butil</PageTitle>

<PageHeader Category="Files & Data"
            Title="Fetch"
            Lead="Issue browser fetch() requests from C# with a typed Request / Response / Headers object model, download progress reporting, streamed uploads and two flavors of cancellation - for the cases where HttpClient can't reach fetch-only semantics."
            MdnUrl="https://developer.mozilla.org/en-US/docs/Web/API/Fetch_API"
            InjectAs="Fetch fetch" />

<div class="stack">
    <DemoSection Title="Send a request"
                 Api="Send"
                 Description="Send issues the request and resolves with a FetchResponse carrying the status, final URL (after redirects), response headers and body bytes. Ok is true for any 2xx status; network or CORS failures surface in the Error property instead of throwing."
                 Code=@("""
FetchResponse response = await fetch.Send(new FetchRequest
{
    Url = "https://jsonplaceholder.typicode.com/todos/1",
});

if (response.Ok)
{
    var json = Encoding.UTF8.GetString(response.Body);
}
""")>
        <div class="field">
            <span class="field-label">URL</span>
            <input @bind="_url" placeholder="https://jsonplaceholder.typicode.com/todos/1" />
        </div>
        <div class="controls">
            <button @onclick="SendGet" disabled="@_busy">Send GET</button>
        </div>
        @if (_bodyPreview is not null)
        {
            <pre style="margin-top:1rem;white-space:pre-wrap;word-break:break-all">@_bodyPreview</pre>
        }
        <DemoConsole @ref="sendOutput" Title="send output" />
    </DemoSection>

    <DemoSection Title="Request options"
                 Api="FetchRequest"
                 Description="FetchRequest exposes the fetch() init options as plain properties: Method, Headers, Body bytes, plus the fetch-specific Credentials, Mode, Cache and Redirect strings. This demo POSTs a JSON document with an explicit Content-Type and cache bypass."
                 Code=@("""
var request = new FetchRequest
{
    Url = "https://jsonplaceholder.typicode.com/posts",
    Method = "POST",
    Headers = new() { ["Content-Type"] = "application/json; charset=utf-8" },
    Body = Encoding.UTF8.GetBytes("{\"title\":\"Bit.Butil\",\"userId\":1}"),
    Credentials = "omit",   // "omit" | "same-origin" | "include"
    Mode = "cors",          // "cors" | "no-cors" | "same-origin" | "navigate"
    Cache = "no-store",     // "default" | "no-store" | "reload" | "no-cache" | ...
    Redirect = "follow",    // "follow" | "error" | "manual"
};

FetchResponse response = await fetch.Send(request);
""")>
        <div class="controls">
            <button @onclick="SendPost" disabled="@_busy">Send POST</button>
        </div>
        <DemoConsole @ref="requestOptionsOutput" Title="request options output" />
    </DemoSection>

    <DemoSection Title="Headers"
                 Api="FetchHeaders"
                 Description="FetchHeaders is the Headers half of the object model: an ordered list where a name may repeat, matched case-insensitively. Append keeps what is already there, Set replaces it, GetAll returns every value and Get joins them with a comma the way the Headers specification does. A Dictionary&lt;string, string&gt; still converts both ways, so code written against the old shape keeps working."
                 Code=@("""
var headers = new FetchHeaders()
    .Append("Accept", "application/json")
    .Append("X-Trace", "one")
    .Append("X-Trace", "two");

headers.GetAll("x-trace");   // ["one", "two"] - case-insensitive
headers.Get("X-Trace");      // "one, two"
headers.Set("Accept", "text/plain");   // replaces every Accept

// still assignable from - and to - a dictionary
FetchRequest request = new() { Headers = new() { ["Content-Type"] = "application/json" } };
Dictionary<string, string> flat = request.Headers;
""")>
        <div class="controls">
            <button @onclick="HeadersDemo">Build and read a header list</button>
            <button @onclick="ReadResponseHeaders" disabled="@_busy">Read a live response's headers</button>
        </div>
        <DemoConsole @ref="headersOutput" Title="headers output" />
    </DemoSection>

    <DemoSection Title="The response object"
                 Api="FetchResponse"
                 Description="Beyond the status and body, FetchResponse carries what only the browser knows: whether the request was redirected to get here, and the response Type - basic, cors, or opaque for a no-cors request whose status reads 0 and whose body is unreadable by design. A network or CORS failure is not an exception; it is a response with Ok false and Error set."
                 Code=@("""
FetchResponse response = await fetch.Send(new FetchRequest { Url = url });

// response.Redirected - true when at least one redirect got us here
// response.Type       - "basic" | "cors" | "opaque" | "opaqueredirect" | "error"
// response.Error      - set instead of throwing when the network or CORS said no

var opaque = await fetch.Send(new FetchRequest { Url = url, Mode = "no-cors" });
// opaque.Type == "opaque", opaque.Status == 0, opaque.Body is empty
""")>
        <div class="controls">
            <button @onclick="InspectResponse" disabled="@_busy">Inspect a response</button>
            <button class="secondary" @onclick="SendNoCors" disabled="@_busy">Send a no-cors request</button>
        </div>
        <DemoConsole @ref="responseOutput" Title="response object output" />
    </DemoSection>

    <DemoSection Title="Streaming upload"
                 Api="SendStream / SupportsStreamingUpload"
                 Description="SendStream hands the browser a .NET Stream as the request body and lets it pull as the connection drains, so neither side holds the payload whole - the way to POST a file larger than memory. Chromium-only, over HTTP/2 or HTTP/3 in a secure context, which is what SupportsStreamingUpload answers; where it is unsupported the request comes back as a failed response rather than throwing."
                 Code=@("""
if (await fetch.SupportsStreamingUpload() is false) return;   // fall back to Send

await using var file = File.OpenRead(path);

FetchResponse response = await fetch.SendStream(
    new FetchRequest
    {
        Url = "https://example.com/upload",
        Method = "POST",
        Headers = new() { ["Content-Type"] = "application/octet-stream" },
    },
    file,
    onProgress: p => { /* p.Loaded of p.Total handed to the browser */ });
""")>
        <div class="controls">
            <button @onclick="CheckStreamingSupport">SupportsStreamingUpload</button>
            <button @onclick="UploadStream" disabled="@_busy">Upload 256 KB as a stream</button>
        </div>
        @if (_uploadText is not null)
        {
            <p style="margin-top:0.75rem"><b>@_uploadText</b></p>
        }
        <DemoConsole @ref="streamOutput" Title="streaming upload output" />
    </DemoSection>

    <DemoSection Title="Progress reporting"
                 Api="Send + onProgress"
                 Description="Pass an onProgress callback and it fires as body chunks arrive, with Loaded bytes so far and Total from Content-Length (null for chunked responses). Ideal for progress bars on large downloads - something HttpClient on WebAssembly can't observe."
                 Code=@("""
var response = await fetch.Send(
    new FetchRequest { Url = "https://example.com/large-file" },
    onProgress: p =>
    {
        var percent = p.Total.HasValue ? $"{100.0 * p.Loaded / p.Total.Value:F0}%" : "?";
        // update UI: p.Loaded of p.Total bytes
    });
""")>
        <div class="controls">
            <button @onclick="DownloadWithProgress" disabled="@_busy">Download ~1 MB with progress</button>
        </div>
        @if (_progressText is not null)
        {
            <p style="margin-top:0.75rem"><b>@_progressText</b></p>
        }
        <DemoConsole @ref="progressOutput" Title="progress output" />
    </DemoSection>

    <DemoSection Title="Cancellation"
                 Api="Send + CancellationToken"
                 Description="Send accepts a CancellationToken; triggering it aborts the underlying fetch through an AbortController. Cancellation does not throw - it resolves with a FetchResponse whose Aborted flag is true, matching the abort-handle path."
                 Code=@("""
using var cts = new CancellationTokenSource();

var responseTask = fetch.Send(
    new FetchRequest { Url = "https://example.com/large-file" },
    cancellationToken: cts.Token);

cts.Cancel(); // abort mid-flight

var response = await responseTask;
// response.Aborted == true
""")>
        <div class="controls">
            <button @onclick="StartCancellable" disabled="@_busy">Start download</button>
            <button class="danger" @onclick="CancelDownload" disabled="@(_cts is null)">Cancel</button>
        </div>
        <DemoConsole @ref="cancellationOutput" Title="cancellation output" />
    </DemoSection>

    <DemoSection Title="Fire-and-forget abort handle"
                 Api="Start / AbortableFetch"
                 Description="Start launches the request and immediately returns an AbortableFetch handle without waiting for (or returning) the response payload. Call Abort to stop it; disposing the handle also aborts unless the request already completed. Prefer Send whenever you need the response."
                 Code=@("""
AbortableFetch handle = await fetch.Start(new FetchRequest
{
    Url = "https://example.com/large-file",
});

// later:
await handle.Abort();
""")>
        <div class="controls">
            <button @onclick="StartAndAbort" disabled="@_busy">Start, then abort after 300 ms</button>
        </div>
        <DemoConsole @ref="abortOutput" Title="abort handle output" />
    </DemoSection>
</div>

<Callout Type="info" Title="When to prefer HttpClient">
    For ordinary API calls, HttpClient remains the right tool - it integrates with delegating handlers,
    typed clients and the rest of .NET. Reach for Bit.Butil.Fetch when you need what only the browser's
    fetch() offers: download progress, abort semantics, credentials / CORS modes and cache control.
    Cross-origin demo requests on this page are still subject to the target server's CORS policy.
</Callout>

<ApiTable Title="API reference">
    <ApiMember Name="Send" Signature="Task<FetchResponse> Send(FetchRequest request, Action<FetchProgress>? onProgress = null, CancellationToken cancellationToken = default)" Description="Sends the request and returns the full response. onProgress fires as bytes arrive; the token aborts the request." />
    <ApiMember Name="SendStream" Signature="Task<FetchResponse> SendStream(FetchRequest request, Stream body, Action<FetchProgress>? onProgress = null, CancellationToken cancellationToken = default)" Description="Sends the request with a .NET Stream as a streamed upload body; the caller keeps ownership of the stream." />
    <ApiMember Name="SupportsStreamingUpload" Signature="ValueTask<bool> SupportsStreamingUpload()" Description="True when the engine can send a request body as a stream - Chromium only, over HTTP/2 or HTTP/3." />
    <ApiMember Name="Start" Signature="Task<AbortableFetch> Start(FetchRequest request)" Description="Starts the request and immediately returns an abort handle; does not return the response payload." />
    <ApiMember Name="InvokeFetchProgress" Signature="void InvokeFetchProgress(Guid id, FetchProgress progress)" Description="JSInvokable interop plumbing invoked from JavaScript as bytes arrive - not intended for direct use." />
    <ApiMember Name="DisposeAsync" Signature="ValueTask DisposeAsync()" Description="Releases the interop callback reference held for progress reporting." />
    <ApiMember Name="FetchRequest.Url" Signature="string Url" Description="The request URL." />
    <ApiMember Name="FetchRequest.Method" Signature='string Method = "GET"' Description="HTTP verb. Defaults to GET." />
    <ApiMember Name="FetchRequest.Headers" Signature="FetchHeaders Headers" Description="Request headers. Assignable from a Dictionary<string, string>; use Append when a name has to repeat." />
    <ApiMember Name="FetchRequest.Body" Signature="byte[]? Body" Description="Optional body bytes. Set a Content-Type header when needed." />
    <ApiMember Name="FetchRequest.Credentials" Signature='string Credentials = "same-origin"' Description='One of "omit", "same-origin", "include".' />
    <ApiMember Name="FetchRequest.Mode" Signature='string Mode = "cors"' Description='One of "cors", "no-cors", "same-origin", "navigate".' />
    <ApiMember Name="FetchRequest.Cache" Signature='string Cache = "default"' Description='Cache mode: "default", "no-store", "reload", "no-cache", "force-cache", "only-if-cached".' />
    <ApiMember Name="FetchRequest.Redirect" Signature='string Redirect = "follow"' Description='One of "follow", "error", "manual".' />
    <ApiMember Name="FetchRequest.Referrer" Signature="string? Referrer" Description='The referrer to send: a same-origin URL, "about:client" for the default, or "" for none.' />
    <ApiMember Name="FetchRequest.ReferrerPolicy" Signature="string? ReferrerPolicy" Description='How much of the referrer to send - "no-referrer", "origin", "strict-origin-when-cross-origin"...' />
    <ApiMember Name="FetchRequest.Integrity" Signature="string? Integrity" Description='A subresource integrity digest ("sha256-...") the response must match, or the fetch fails.' />
    <ApiMember Name="FetchRequest.KeepAlive" Signature="bool KeepAlive" Description="Lets the request outlive the page, for a beacon sent during unload. Capped at 64 KiB of body." />
    <ApiMember Name="FetchRequest.Priority" Signature="string? Priority" Description='A scheduling hint: "high", "low" or "auto". Advisory - the browser decides.' />
    <ApiMember Name="FetchResponse.Ok" Signature="bool Ok" Description="True when the status is in [200, 300)." />
    <ApiMember Name="FetchResponse.Status" Signature="int Status" Description="HTTP status, or 0 when the request was aborted or failed before headers." />
    <ApiMember Name="FetchResponse.StatusText" Signature="string StatusText" Description="The HTTP status text." />
    <ApiMember Name="FetchResponse.Url" Signature="string Url" Description="Final URL after redirects." />
    <ApiMember Name="FetchResponse.Headers" Signature="FetchHeaders Headers" Description="Response headers, repeats included - which is what makes Set-Cookie readable where the browser exposes it." />
    <ApiMember Name="FetchResponse.Body" Signature="byte[] Body" Description="Body bytes. May be empty for 204/304 or aborted responses." />
    <ApiMember Name="FetchResponse.Redirected" Signature="bool Redirected" Description="Whether the request went through at least one redirect to get here." />
    <ApiMember Name="FetchResponse.Type" Signature="string Type" Description='"basic", "cors", "opaque", "opaqueredirect" or "error". An opaque response has status 0 and no readable body.' />
    <ApiMember Name="FetchResponse.Aborted" Signature="bool Aborted" Description="True when the request was aborted via the handle or a cancellation token." />
    <ApiMember Name="FetchResponse.Error" Signature="string? Error" Description="Network/CORS error description, when one occurred." />
    <ApiMember Name="FetchHeaders.Append" Signature="FetchHeaders Append(string name, string value)" Description="Adds a header, keeping any already there under the same name." />
    <ApiMember Name="FetchHeaders.Set" Signature="FetchHeaders Set(string name, string? value)" Description="Replaces every occurrence of the name with one value, or removes it when the value is null." />
    <ApiMember Name="FetchHeaders.Get" Signature="string? Get(string name)" Description='The value, repeats joined by ", " as the Headers specification defines. Null when absent.' />
    <ApiMember Name="FetchHeaders.GetAll" Signature="string[] GetAll(string name)" Description="Every value sent under the name, in order." />
    <ApiMember Name="FetchHeaders.Has" Signature="bool Has(string name)" Description="Whether the header is present at all - absent versus present-but-empty." />
    <ApiMember Name="FetchHeaders.Remove" Signature="bool Remove(string name)" Description="Removes every occurrence of the name; returns whether anything was removed." />
    <ApiMember Name="FetchHeaders.Names" Signature="IEnumerable<string> Names" Description="The distinct header names present, in the order they first appear." />
    <ApiMember Name="FetchHeaders.ToDictionary" Signature="Dictionary<string, string> ToDictionary()" Description='Flattens to a dictionary, repeats joined by ", ". The lossy direction.' />
    <ApiMember Name="FetchProgress.Loaded" Signature="long Loaded" Description="Bytes received so far." />
    <ApiMember Name="FetchProgress.Total" Signature="long? Total" Description="Total bytes expected, or null when unknown (chunked / no Content-Length)." />
    <ApiMember Name="AbortableFetch.Id" Signature="Guid Id" Description="The internal request id." />
    <ApiMember Name="AbortableFetch.Abort" Signature="ValueTask Abort()" Description="Aborts the request immediately if it's still in flight; disposing the handle does the same." />
</ApiTable>

@code {
    private const string LargeUrl = "https://jsonplaceholder.typicode.com/photos";

    private DemoConsole sendOutput = default!;
    private DemoConsole requestOptionsOutput = default!;
    private DemoConsole progressOutput = default!;
    private DemoConsole cancellationOutput = default!;
    private DemoConsole abortOutput = default!;
    private DemoConsole headersOutput = default!;
    private DemoConsole responseOutput = default!;
    private DemoConsole streamOutput = default!;

    private string _url = "https://jsonplaceholder.typicode.com/todos/1";
    private string? _bodyPreview;
    private string? _progressText;
    private string? _uploadText;
    private bool _busy;
    private CancellationTokenSource? _cts;

    private async Task HeadersDemo()
    {
        var headers = new FetchHeaders()
            .Append("Accept", "application/json")
            .Append("X-Trace", "one")
            .Append("X-Trace", "two");

        await headersOutput.Success($"Count → {headers.Count} ({string.Join(", ", headers.Names)})");
        await headersOutput.Log($"GetAll(\"x-trace\") → [{string.Join(", ", headers.GetAll("x-trace"))}] - matched case-insensitively");
        await headersOutput.Log($"Get(\"X-Trace\") → \"{headers.Get("X-Trace")}\"");

        headers.Set("X-Trace", "replaced");
        await headersOutput.Log($"after Set → GetAll(\"X-Trace\") = [{string.Join(", ", headers.GetAll("X-Trace"))}]");

        headers.Remove("Accept");
        await headersOutput.Log($"after Remove(\"Accept\") → Has(\"accept\") = {headers.Has("accept")}");

        var flat = headers.ToDictionary();
        await headersOutput.Info($"ToDictionary → {{{string.Join(", ", flat.Select(kv => $"{kv.Key}: {kv.Value}"))}}}");
    }

    private async Task ReadResponseHeaders()
    {
        _busy = true;
        try
        {
            var response = await fetch.Send(new FetchRequest { Url = _url.Trim(), Cache = "no-store" });
            if (response.Error is not null)
            {
                await headersOutput.Error("Send failed →", response.Error);
                return;
            }

            await headersOutput.Success($"{response.Status} {response.StatusText} → {response.Headers.Count} header(s)");
            foreach (var header in response.Headers)
            {
                await headersOutput.Log($"  {header.Key}: {header.Value}");
            }
        }
        catch (Exception ex)
        {
            await headersOutput.Error("Send failed:", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task InspectResponse()
    {
        _busy = true;
        try
        {
            var response = await fetch.Send(new FetchRequest { Url = _url.Trim(), Cache = "no-store" });
            await responseOutput.Success($"Status {response.Status} · Ok {response.Ok} · Type \"{response.Type}\" · Redirected {response.Redirected}");
            await responseOutput.Log($"  final URL: {response.Url}");
            await responseOutput.Log($"  {response.Body.Length:N0} body bytes, Error: {response.Error ?? "(none)"}");
        }
        catch (Exception ex)
        {
            await responseOutput.Error("Send failed:", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendNoCors()
    {
        _busy = true;
        try
        {
            var response = await fetch.Send(new FetchRequest { Url = _url.Trim(), Mode = "no-cors", Cache = "no-store" });
            await responseOutput.Info($"no-cors → Type \"{response.Type}\", Status {response.Status}, {response.Body.Length} body bytes, {response.Headers.Count} readable header(s)");
            await responseOutput.Log("An opaque response is the browser refusing to let the page read a cross-origin answer it never had permission for - the request still went out.");
        }
        catch (Exception ex)
        {
            await responseOutput.Error("Send failed:", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CheckStreamingSupport()
    {
        try
        {
            var supported = await fetch.SupportsStreamingUpload();
            if (supported)
            {
                await streamOutput.Success("SupportsStreamingUpload → true - this engine accepts a streamed request body.");
            }
            else
            {
                await streamOutput.Warn("SupportsStreamingUpload → false. Use Send with a byte[] body here; Chromium over HTTPS is the one that supports this today.");
            }
        }
        catch (Exception ex)
        {
            await streamOutput.Error("SupportsStreamingUpload failed:", ex.Message);
        }
    }

    private async Task UploadStream()
    {
        _busy = true;
        _uploadText = null;
        try
        {
            if (await fetch.SupportsStreamingUpload() is false)
            {
                await streamOutput.Warn("This engine has no streaming upload - the request below will come back as a failed response, which is the behaviour to code against.");
            }

            // 256 KB of generated payload; a real caller would open a file instead.
            await using var body = new MemoryStream(new byte[256 * 1024]);

            var response = await fetch.SendStream(
                new FetchRequest
                {
                    Url = "https://jsonplaceholder.typicode.com/posts",
                    Method = "POST",
                    Headers = new() { ["Content-Type"] = "application/octet-stream" },
                    Credentials = "omit",
                },
                body,
                onProgress: p =>
                {
                    var percent = p.Total.HasValue ? $"{100.0 * p.Loaded / p.Total.Value:F0}%" : "?";
                    _uploadText = $"Uploaded {p.Loaded:N0} bytes ({percent})";
                    _ = InvokeAsync(StateHasChanged);
                });

            await LogResponse("SendStream", response, streamOutput);
        }
        catch (Exception ex)
        {
            await streamOutput.Error("SendStream failed:", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendGet()
    {
        if (string.IsNullOrWhiteSpace(_url))
        {
            await sendOutput.Warn("Enter a URL first.");
            return;
        }

        _busy = true;
        _bodyPreview = null;
        try
        {
            var response = await fetch.Send(new FetchRequest { Url = _url.Trim() });
            await LogResponse("GET", response, sendOutput);
            _bodyPreview = response.Body.Length > 0 ? PreviewBody(response.Body) : null;
        }
        catch (Exception ex)
        {
            await sendOutput.Error("Send failed:", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendPost()
    {
        _busy = true;
        try
        {
            var payload = JsonSerializer.Serialize(new NewPost("Bit.Butil", "Hello from C#", 1));

            var response = await fetch.Send(new FetchRequest
            {
                Url = "https://jsonplaceholder.typicode.com/posts",
                Method = "POST",
                Headers = new() { ["Content-Type"] = "application/json; charset=utf-8" },
                Body = Encoding.UTF8.GetBytes(payload),
                Credentials = "omit",
                Cache = "no-store",
            });

            await LogResponse("POST", response, requestOptionsOutput);
            if (response.Body.Length > 0)
            {
                await requestOptionsOutput.Log("Response body:", PreviewBody(response.Body));
            }
        }
        catch (Exception ex)
        {
            await requestOptionsOutput.Error("Send failed:", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadWithProgress()
    {
        _busy = true;
        _progressText = null;
        try
        {
            var response = await fetch.Send(
                new FetchRequest { Url = LargeUrl, Cache = "no-store" },
                onProgress: p =>
                {
                    _progressText = p.Total.HasValue
                        ? $"Received {p.Loaded:N0} / {p.Total.Value:N0} bytes"
                        : $"Received {p.Loaded:N0} bytes";
                    InvokeAsync(StateHasChanged);
                });

            await LogResponse("GET (progress)", response, progressOutput);
            _progressText = $"Complete - {response.Body.Length:N0} bytes";
        }
        catch (Exception ex)
        {
            await progressOutput.Error("Send failed:", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartCancellable()
    {
        _busy = true;
        _cts = new CancellationTokenSource();
        try
        {
            var response = await fetch.Send(
                new FetchRequest { Url = LargeUrl, Cache = "no-store" },
                cancellationToken: _cts.Token);

            if (response.Aborted)
            {
                await cancellationOutput.Warn("Request aborted - FetchResponse.Aborted is true.");
            }
            else
            {
                await LogResponse("GET (cancellable)", response, cancellationOutput);
            }
        }
        catch (Exception ex)
        {
            await cancellationOutput.Error("Send failed:", ex.Message);
        }
        finally
        {
            _cts.Dispose();
            _cts = null;
            _busy = false;
        }
    }

    private void CancelDownload() => _cts?.Cancel();

    private async Task StartAndAbort()
    {
        _busy = true;
        try
        {
            var handle = await fetch.Start(new FetchRequest { Url = LargeUrl, Cache = "no-store" });
            await abortOutput.Log($"Start → request {handle.Id} is in flight...");

            await Task.Delay(300);

            await handle.Abort();
            await abortOutput.Warn("Abort → request stopped via AbortableFetch.");
        }
        catch (Exception ex)
        {
            await abortOutput.Error("Start/Abort failed:", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LogResponse(string label, FetchResponse response, DemoConsole output)
    {
        if (response.Error is not null)
        {
            await output.Error($"{label} →", response.Error);
            return;
        }

        await output.Success($"{label} → {response.Status} {response.StatusText}",
            $"({response.Body.Length:N0} bytes from {response.Url})");

        var contentType = response.Headers.FirstOrDefault(h => string.Equals(h.Key, "content-type", StringComparison.OrdinalIgnoreCase));
        if (contentType.Key is not null)
        {
            await output.Info($"  {contentType.Key}: {contentType.Value}");
        }
    }

    private static string PreviewBody(byte[] body)
    {
        if (body.Length == 0) return "(empty body)";
        var text = Encoding.UTF8.GetString(body);
        return text.Length > 400 ? text[..400] + "…" : text;
    }

    private record NewPost(
        [property: System.Text.Json.Serialization.JsonPropertyName("title")] string Title,
        [property: System.Text.Json.Serialization.JsonPropertyName("body")] string Body,
        [property: System.Text.Json.Serialization.JsonPropertyName("userId")] int UserId);
}
