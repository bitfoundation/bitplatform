@page "/keyboard"
@implements IAsyncDisposable
@inject Bit.Butil.Keyboard keyboard

<PageTitle>Keyboard - Bit.Butil</PageTitle>

<PageHeader Category="DOM & Interaction"
            Title="Keyboard"
            Lead="App-wide keyboard shortcuts as one-liners: register any physical key with optional Ctrl, Alt, Shift and Meta modifiers and get a C# callback no matter where focus is. Shortcuts match on keydown by the physical key code, so they work identically across keyboard layouts."
            MdnUrl="https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent"
            InjectAs="Keyboard keyboard" />

<div class="stack">
<DemoSection Title="Register app-wide shortcuts"
             Api="Add"
             Description="Add attaches a global keydown shortcut and returns a Guid you can later pass to Remove. By default the browser action is suppressed (preventDefault and stopPropagation are true) and held keys do not auto-repeat. Two shortcuts are live on this page right now."
             Code=@("""
@inject Bit.Butil.Keyboard keyboard

@code {
    private Guid ctrlKId;

    protected override async Task OnInitializedAsync()
    {
        ctrlKId = await keyboard.Add(ButilKeyCodes.KeyK, () =>
        {
            // open your command palette...
        }, ButilModifiers.Ctrl);

        await keyboard.Add(ButilKeyCodes.F9, () => { /* ... */ });
    }
}
""")
             Language="razor">
    <div class="controls">
        <span class="kbd">Ctrl</span> + <span class="kbd">K</span>
        <span>and</span>
        <span class="kbd">F9</span>
        <span>are registered - press them and watch the output.</span>
    </div>
    <DemoConsole @ref="shortcutsOutput" Title="shortcuts output" />
</DemoSection>

<DemoSection Title="Modifier combinations"
             Api="ButilModifiers"
             Description="ButilModifiers is a flags enum - combine Ctrl, Alt, Shift and Meta with the bitwise or operator. Build a shortcut below and register it live; press it to see it fire, and register a new one to replace it."
             Code=@("""
await keyboard.Add(ButilKeyCodes.KeyU,
    () => { /* ... */ },
    ButilModifiers.Ctrl | ButilModifiers.Shift);
""")>
    <div class="field-row">
        <div class="field">
            <span class="field-label">Key code (KeyboardEvent.code)</span>
            <input @bind-value="customCode" placeholder="e.g. KeyU or F8" />
        </div>
        <div class="field">
            <span class="field-label">Modifiers</span>
            <div class="controls">
                <label><input type="checkbox" @bind="useCtrl" /> Ctrl</label>
                <label><input type="checkbox" @bind="useAlt" /> Alt</label>
                <label><input type="checkbox" @bind="useShift" /> Shift</label>
                <label><input type="checkbox" @bind="useMeta" /> Meta</label>
            </div>
        </div>
    </div>
    <div class="controls">
        <button @onclick="AddCustomShortcut">Register shortcut</button>
        <button class="danger" @onclick="RemoveCustomShortcut" disabled="@(customId is null)">Remove it</button>
    </div>
    <DemoConsole @ref="modifiersOutput" Title="modifiers output" />
</DemoSection>

<DemoSection Title="Disposable subscriptions"
             Api="Subscribe"
             Description="Subscribe is Add with lifecycle sugar: it returns a ButilSubscription whose DisposeAsync detaches the shortcut, so a component can await-using a shortcut or dispose it in DisposeAsync without tracking Guids."
             Code=@("""
private ButilSubscription? shortcut;

shortcut = await keyboard.Subscribe(ButilKeyCodes.KeyB, () =>
{
    // toggle the sidebar...
}, ButilModifiers.Ctrl);

// later:
await shortcut.DisposeAsync();
""")>
    <div class="controls">
        <button @onclick="SubscribeCtrlB">Subscribe Ctrl+B</button>
        <button class="danger" @onclick="DisposeCtrlB" disabled="@(ctrlBSub is null)">Dispose subscription</button>
    </div>
    <DemoConsole @ref="subscriptionOutput" Title="subscription output" />
</DemoSection>

<DemoSection Title="Element-scoped shortcuts"
             Api="SubscribeOn"
             Description="SubscribeOn binds the shortcut to a specific element: the handler only fires while that element (or one of its descendants) receives the keyboard event. Perfect for editor areas that need their own key handling without hijacking the whole page."
             Code=@("""
<textarea @ref="editorRef"></textarea>

@code {
    private ElementReference editorRef;
    private ButilSubscription? editorShortcut;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender is false) return;

        editorShortcut = await keyboard.SubscribeOn(editorRef,
            ButilKeyCodes.Enter, () => { /* submit */ }, ButilModifiers.Ctrl);
    }
}
""")
             Language="razor">
    <div class="field">
        <span class="field-label">Ctrl+Enter fires only while this textarea has focus</span>
        <textarea @ref="editorRef" rows="3" placeholder="focus me and press Ctrl+Enter..." style="max-width:24rem;"></textarea>
    </div>
    <DemoConsole @ref="elementScopedOutput" Title="element-scoped output" />
</DemoSection>

<DemoSection Title="Removing shortcuts"
             Api="Remove / RemoveAll"
             Description="Remove(Guid) detaches one shortcut by the id Add returned. Remove(Action) matches by delegate identity and returns the removed ids. RemoveAll wipes every shortcut registered through this Keyboard instance."
             Code=@("""
var id = await keyboard.Add(ButilKeyCodes.F9, handler);

await keyboard.Remove(id);        // by id (recommended)
await keyboard.Remove(handler);   // by the exact same delegate instance
await keyboard.RemoveAll();       // everything on this Keyboard instance
""")>
    <div class="controls">
        <button class="danger" @onclick="RemoveF9" disabled="@(f9Id is null)">Remove F9 by id</button>
        <button class="danger" @onclick="RemoveAll">RemoveAll</button>
        <button class="secondary" @onclick="ReRegister">Re-register page shortcuts</button>
    </div>
    <DemoConsole @ref="removingOutput" Title="removing output" />
</DemoSection>

<DemoSection Title="Key codes reference"
             Api="ButilKeyCodes"
             Description="ButilKeyCodes provides string constants for every physical key: letters (KeyA-KeyZ), digits (Digit0-Digit9), the numpad, function keys (F1-F12), navigation, editing and symbol keys. They are plain KeyboardEvent.code values, so any valid code string works too."
             Code=@("""
ButilKeyCodes.KeyK        // "KeyK"
ButilKeyCodes.Digit1      // "Digit1"
ButilKeyCodes.F9          // "F9"
ButilKeyCodes.Enter       // "Enter"
ButilKeyCodes.Escape      // "Escape"
ButilKeyCodes.ArrowDown   // "ArrowDown"
ButilKeyCodes.NumpadAdd   // "NumpadAdd"
ButilKeyCodes.Backquote   // "Backquote"
""") />
</div>

<Callout Type="warning" Title="RemoveAll clears more than your component">
    The <code>Keyboard</code> service is scoped to the whole app instance, so <code>RemoveAll</code> detaches
    every shortcut any component registered on it. In a component, prefer removing your own ids - or use
    <code>Subscribe</code> and dispose the returned handles - as this page does in <code>DisposeAsync</code>.
</Callout>

<Callout Type="info" Title="Physical keys, not characters">
    Matching uses <code>KeyboardEvent.code</code> - the physical key - so <code>ButilKeyCodes.KeyK</code>
    fires for that key position regardless of the active keyboard layout, and shortcuts keep working while
    Caps Lock or Shift change the produced character.
</Callout>

<ApiTable Title="API reference">
    <ApiMember Name="Add" Signature="Task<Guid> Add(string code, Action handler, ButilModifiers modifiers = ButilModifiers.None, bool preventDefault = true, bool stopPropagation = true, bool repeat = false)" Description="Registers a global keydown shortcut and returns its id. Set repeat to true to also fire on key auto-repeat." />
    <ApiMember Name="Subscribe" Signature="Task<ButilSubscription> Subscribe(string code, Action handler, ButilModifiers modifiers = ButilModifiers.None, bool preventDefault = true, bool stopPropagation = true, bool repeat = false)" Description="Same as Add but returns a disposable handle that detaches the shortcut." />
    <ApiMember Name="SubscribeOn" Signature="Task<ButilSubscription> SubscribeOn(ElementReference element, string code, Action handler, ButilModifiers modifiers = ButilModifiers.None, bool preventDefault = true, bool stopPropagation = true, bool repeat = false)" Description="Element-scoped variant: fires only while the element or a descendant receives the keyboard event." />
    <ApiMember Name="Remove" Signature="ValueTask<Guid[]> Remove(Action handler)" Description="Removes shortcuts matching the exact same delegate instance; returns the removed ids." />
    <ApiMember Name="Remove" Signature="ValueTask Remove(Guid id)" Description="Removes one shortcut by the id returned from Add." />
    <ApiMember Name="RemoveAll" Signature="ValueTask RemoveAll()" Description="Removes every shortcut registered on this Keyboard instance." />
    <ApiMember Name="DisposeAsync" Signature="ValueTask DisposeAsync()" Description="Removes all shortcuts and releases the interop reference. Called by DI when the app scope tears down." />
    <ApiMember Name="InvokeKeyboard" Signature="void InvokeKeyboard(Guid id)" Description="JSInvokable interop entry point invoked from the browser when a shortcut fires - not intended for direct application use." />
    <ApiMember Name="ButilModifiers" Signature="enum ButilModifiers { None, Alt, Ctrl, Meta, Shift }" Description="Flags enum of modifier keys; combine values with the bitwise or operator." />
</ApiTable>

@code {
    private DemoConsole shortcutsOutput = default!;
    private DemoConsole modifiersOutput = default!;
    private DemoConsole subscriptionOutput = default!;
    private DemoConsole elementScopedOutput = default!;
    private DemoConsole removingOutput = default!;

    private ElementReference editorRef;

    private Guid? ctrlKId;
    private Guid? f9Id;
    private Guid? customId;
    private string customLabel = "";
    private ButilSubscription? ctrlBSub;
    private ButilSubscription? editorSub;

    private string customCode = "KeyU";
    private bool useCtrl = true;
    private bool useAlt;
    private bool useShift = true;
    private bool useMeta;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender is false) return;

        await RegisterPageShortcuts(shortcutsOutput);

        try
        {
            editorSub = await keyboard.SubscribeOn(editorRef, ButilKeyCodes.Enter,
                () => _ = elementScopedOutput.Success("Ctrl+Enter pressed inside the textarea!"),
                ButilModifiers.Ctrl);
        }
        catch (Exception ex)
        {
            await elementScopedOutput.Error(ex.Message);
        }
    }

    private async Task RegisterPageShortcuts(DemoConsole output)
    {
        try
        {
            ctrlKId ??= await keyboard.Add(ButilKeyCodes.KeyK,
                () => _ = shortcutsOutput.Success("Ctrl+K pressed!"), ButilModifiers.Ctrl);

            f9Id ??= await keyboard.Add(ButilKeyCodes.F9,
                () => _ = shortcutsOutput.Success("F9 pressed!"));
        }
        catch (Exception ex)
        {
            await output.Error(ex.Message);
        }
    }

    private async Task AddCustomShortcut()
    {
        try
        {
            await RemoveCustomShortcut();

            var modifiers = ButilModifiers.None;
            if (useCtrl) modifiers |= ButilModifiers.Ctrl;
            if (useAlt) modifiers |= ButilModifiers.Alt;
            if (useShift) modifiers |= ButilModifiers.Shift;
            if (useMeta) modifiers |= ButilModifiers.Meta;

            var label = $"{(useCtrl ? "Ctrl+" : "")}{(useAlt ? "Alt+" : "")}{(useShift ? "Shift+" : "")}{(useMeta ? "Meta+" : "")}{customCode}";
            customLabel = label;
            customId = await keyboard.Add(customCode, () => _ = modifiersOutput.Success($"{label} pressed!"), modifiers);

            await modifiersOutput.Log($"Registered {label}");
        }
        catch (Exception ex)
        {
            await modifiersOutput.Error(ex.Message);
        }
    }

    private async Task RemoveCustomShortcut()
    {
        try
        {
            if (customId is null) return;

            await keyboard.Remove(customId.Value);
            await modifiersOutput.Warn($"Removed {customLabel}");
            customId = null;
        }
        catch (Exception ex)
        {
            await modifiersOutput.Error(ex.Message);
        }
    }

    private async Task SubscribeCtrlB()
    {
        try
        {
            if (ctrlBSub is not null)
            {
                await subscriptionOutput.Warn("Ctrl+B is already subscribed");
                return;
            }

            ctrlBSub = await keyboard.Subscribe(ButilKeyCodes.KeyB,
                () => _ = subscriptionOutput.Success("Ctrl+B pressed!"), ButilModifiers.Ctrl);

            await subscriptionOutput.Log("Subscribed to Ctrl+B - dispose the handle to detach it");
        }
        catch (Exception ex)
        {
            await subscriptionOutput.Error(ex.Message);
        }
    }

    private async Task DisposeCtrlB()
    {
        try
        {
            if (ctrlBSub is null) return;

            await ctrlBSub.DisposeAsync();
            ctrlBSub = null;
            await subscriptionOutput.Warn("Ctrl+B subscription disposed");
        }
        catch (Exception ex)
        {
            await subscriptionOutput.Error(ex.Message);
        }
    }

    private async Task RemoveF9()
    {
        try
        {
            if (f9Id is null) return;

            await keyboard.Remove(f9Id.Value);
            f9Id = null;
            await removingOutput.Warn("F9 shortcut removed");
        }
        catch (Exception ex)
        {
            await removingOutput.Error(ex.Message);
        }
    }

    private async Task RemoveAll()
    {
        try
        {
            await keyboard.RemoveAll();
            ctrlKId = null;
            f9Id = null;
            customId = null;
            ctrlBSub = null;
            editorSub = null;
            await removingOutput.Warn("RemoveAll - every shortcut on this Keyboard instance is gone");
        }
        catch (Exception ex)
        {
            await removingOutput.Error(ex.Message);
        }
    }

    private async Task ReRegister()
    {
        await RegisterPageShortcuts(removingOutput);
        await removingOutput.Log("Page shortcuts are registered");
    }

    public async ValueTask DisposeAsync()
    {
        if (ctrlKId is not null) await keyboard.Remove(ctrlKId.Value);
        if (f9Id is not null) await keyboard.Remove(f9Id.Value);
        if (customId is not null) await keyboard.Remove(customId.Value);
        if (ctrlBSub is not null) await ctrlBSub.DisposeAsync();
        if (editorSub is not null) await editorSub.DisposeAsync();
    }
}
