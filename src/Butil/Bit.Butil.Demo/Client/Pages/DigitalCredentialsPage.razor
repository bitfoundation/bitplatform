@page "/digital-credentials"
@implements IDisposable
@inject Bit.Butil.DigitalCredentials digitalCredentials

<PageTitle>DigitalCredentials - Bit.Butil</PageTitle>

<PageHeader Category="Identity &amp; Permissions"
            Title="DigitalCredentials"
            Lead="Ask the user's wallet to present a verifiable credential - a mobile driving licence, an ID card, a diploma - and get back what it signed, with the browser mediating which claims are released."
            MdnUrl="https://developer.mozilla.org/en-US/docs/Web/API/Digital_Credentials_API"
            InjectAs="DigitalCredentials digitalCredentials" />

<Callout Type="info" Title="The page never enumerates what the user holds">
    The browser lists the wallets holding something that matches, the user picks one and sees exactly
    which claims are being asked for, and only then is anything released. A request the user declines
    is indistinguishable from having nothing - which is the property that makes this safe to offer.
</Callout>

<Callout Type="warning" Title="Experimental, and server-side by nature">
    Chromium on Android leads here; the protocols are still moving, so branch on
    <code>IsProtocolSupported</code> rather than on a version. Build the request object on your
    server - it is signed, and what it asks for is what the wallet shows the user - and verify the
    response there too: its signature, its issuer, and the nonce you put in the request. Needs a
    secure context, a user gesture, and a top-level page (or an iframe with
    <code>allow="digital-credentials-get"</code>).
</Callout>

<div class="stack">
    <DemoSection Title="Support checks"
                 Api="IsSupported / IsProtocolSupported"
                 Description="Whether the runtime exposes window.DigitalCredential, and whether it will speak a given exchange protocol. During prerender/SSR these return false rather than throwing, so defer them to OnAfterRenderAsync."
                 Code=@("""
@inject Bit.Butil.DigitalCredentials digitalCredentials

var supported = await digitalCredentials.IsSupported();
var openid4vp = await digitalCredentials.IsProtocolSupported("openid4vp");
""")>
        <div class="field">
            <span class="field-label">Protocol</span>
            <input @bind="_protocol" style="width:12rem" />
        </div>
        <div class="controls">
            <button @onclick="CheckSupported">Check support</button>
        </div>
        <DemoConsole @ref="supportOutput" Title="support check output" />
    </DemoSection>

    <DemoSection Title="Present a credential"
                 Api="Get"
                 Description="Opens the wallet chooser and resolves with the presentation the wallet signed, or null when the user declined, nothing matched, or the browser refused. Must be called from a user-gesture handler. Data arrives as raw JSON - hand it to the server as it stands."
                 Code=@("""
var response = await digitalCredentials.Get(
[
    new DigitalCredentialRequest
    {
        Protocol = "openid4vp",
        Data = serverBuiltPresentationRequest   // signed, built on the server
    }
], CredentialMediation.Required);

if (response is not null)
{
    // POST response.Data to the backend and verify it there.
}
""")>
        <div class="field">
            <span class="field-label">Request object (JSON)</span>
            <textarea @bind="_requestJson" rows="6" style="width:100%;font-family:monospace"></textarea>
        </div>
        <div class="controls">
            <button @onclick="Present">Get</button>
            <button class="secondary" @onclick="Abort">Abort</button>
        </div>
        <DemoConsole @ref="presentOutput" Title="present credential output" />
    </DemoSection>

    <DemoSection Title="Issue a credential into the wallet"
                 Api="Create"
                 Description="The other direction, for an issuer that has already established who the user is. Newer than Get and thinner on the ground, so check for it before offering it. Null when the user declined or no wallet accepted it."
                 Code=@("""
var issued = await digitalCredentials.Create(
[
    new DigitalCredentialRequest
    {
        Protocol = "openid4vci",
        Data = serverBuiltIssuanceRequest
    }
]);
""")>
        <div class="field">
            <span class="field-label">Issuance request object (JSON)</span>
            <textarea @bind="_issuanceJson" rows="6" style="width:100%;font-family:monospace"></textarea>
        </div>
        <div class="controls">
            <button @onclick="Issue">Create</button>
        </div>
        <DemoConsole @ref="issueOutput" Title="issue credential output" />
    </DemoSection>
</div>

<ApiTable Title="API reference">
    <ApiMember Name="IsSupported"
               Signature="ValueTask<bool> IsSupported()"
               Description="True when the runtime exposes window.DigitalCredential. Returns default (false) during prerender/SSR instead of throwing." />
    <ApiMember Name="IsProtocolSupported"
               Signature="ValueTask<bool> IsProtocolSupported(string protocol)"
               Description="Whether the browser will speak an exchange protocol, e.g. openid4vp. The set is expected to change." />
    <ApiMember Name="Get"
               Signature="ValueTask<DigitalCredentialResponse?> Get(DigitalCredentialRequest[] requests, CredentialMediation mediation = CredentialMediation.Required, CancellationToken cancellationToken = default)"
               Description="Asks the wallet to present a credential. Null when declined, unmatched or refused. Needs a user gesture." />
    <ApiMember Name="Create"
               Signature="ValueTask<DigitalCredentialResponse?> Create(DigitalCredentialRequest[] requests, CancellationToken cancellationToken = default)"
               Description="Issues a credential into the wallet. Null when declined or unsupported. Needs a user gesture." />
    <ApiMember Name="Abort"
               Signature="ValueTask<bool> Abort()"
               Description="Ends the exchange this instance started, dismissing the wallet chooser. False when nothing was pending." />
    <ApiMember Name="DigitalCredentialRequest"
               Signature="string Protocol, object Data"
               Description="The protocol to speak and that protocol's request object - built and signed on the server." />
    <ApiMember Name="DigitalCredentialResponse"
               Signature="string Protocol, JsonElement Data"
               Description="What the wallet returned, as raw JSON. Verify it server-side; reading the claims in the browser proves nothing." />
</ApiTable>

@code {
    private DemoConsole supportOutput = default!;
    private DemoConsole presentOutput = default!;
    private DemoConsole issueOutput = default!;

    private string _protocol = "openid4vp";

    // Tied to the component, not to the click: navigating away mid-exchange leaves the wallet
    // chooser up otherwise, since nothing else reaches the call that is still pending.
    private readonly CancellationTokenSource _cts = new();

    private string _requestJson = """
{
  "response_type": "vp_token",
  "nonce": "server-generated",
  "client_id": "butil-demo"
}
""";

    // Issuance is the other direction and the other protocol: openid4vci, not the openid4vp
    // presentation request above. Handing Create a presentation request is what no wallet would
    // accept, so the demo keeps the two apart rather than reusing one box for both.
    private string _issuanceJson = """
{
  "credential_issuer": "https://issuer.example",
  "credential_configuration_ids": [ "butil-demo-card" ],
  "grants": { "urn:ietf:params:oauth:grant-type:pre-authorized_code": { "pre-authorized_code": "server-generated" } }
}
""";

    private async Task CheckSupported()
    {
        try
        {
            await supportOutput.Success("IsSupported →", await digitalCredentials.IsSupported());
            await supportOutput.Success($"IsProtocolSupported({_protocol}) →", await digitalCredentials.IsProtocolSupported(_protocol));
        }
        catch (Exception ex)
        {
            await supportOutput.Error("Support check failed →", ex.Message);
        }
    }

    private DigitalCredentialRequest[] BuildRequests()
    {
        // The demo lets you paste a request object; a real one is built and signed on the server.
        using var document = JsonDocument.Parse(_requestJson);

        return [new DigitalCredentialRequest { Protocol = _protocol, Data = document.RootElement.Clone() }];
    }

    private DigitalCredentialRequest[] BuildIssuanceRequests()
    {
        using var document = JsonDocument.Parse(_issuanceJson);

        return [new DigitalCredentialRequest { Protocol = "openid4vci", Data = document.RootElement.Clone() }];
    }

    private async Task Present()
    {
        try
        {
            if (await digitalCredentials.IsSupported() is false)
            {
                await presentOutput.Warn("The Digital Credentials API is not available in this browser.");
                return;
            }

            var response = await digitalCredentials.Get(BuildRequests(), cancellationToken: _cts.Token);

            if (response is null)
            {
                await presentOutput.Warn("Get →", "no presentation (declined, nothing matched, or the protocol is not spoken here).");
                return;
            }

            await presentOutput.Success($"Get → {response.Protocol}:", response.Data.ToString());
        }
        catch (JsonException ex)
        {
            await presentOutput.Error("The request object is not valid JSON →", ex.Message);
        }
        catch (Exception ex)
        {
            await presentOutput.Error("Get failed →", ex.Message);
        }
    }

    private async Task Issue()
    {
        try
        {
            var response = await digitalCredentials.Create(BuildIssuanceRequests(), _cts.Token);

            if (response is null)
            {
                await issueOutput.Warn("Create →", "no wallet accepted the credential.");
                return;
            }

            await issueOutput.Success($"Create → {response.Protocol}:", response.Data.ToString());
        }
        catch (JsonException ex)
        {
            await issueOutput.Error("The request object is not valid JSON →", ex.Message);
        }
        catch (Exception ex)
        {
            await issueOutput.Error("Create failed →", ex.Message);
        }
    }

    private async Task Abort()
    {
        try
        {
            await presentOutput.Success("Abort →", await digitalCredentials.Abort());
        }
        catch (Exception ex)
        {
            await presentOutput.Error("Abort failed →", ex.Message);
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
