@page "/storage"
@implements IAsyncDisposable
@inject Bit.Butil.LocalStorage localStorage
@inject Bit.Butil.SessionStorage sessionStorage

<PageTitle>Local & Session Storage - Bit.Butil</PageTitle>

<PageHeader Category="Storage"
            Title="Local & Session Storage"
            Lead="Synchronous key/value storage scoped to the origin. LocalStorage survives browser restarts; SessionStorage lives and dies with the tab. Both are exposed through the same ButilStorage API, so everything on this page applies to either service."
            MdnUrl="https://developer.mozilla.org/en-US/docs/Web/API/Web_Storage_API"
            InjectAs="LocalStorage localStorage" />

<div class="stack">
    <DemoSection Title="Write and read values"
                 Api="SetItem / GetItem / RemoveItem"
                 Description="The core of the Storage API: store a string under a key, read it back, or remove it. Values written to localStorage persist until explicitly removed - close the browser, come back tomorrow, and they are still there."
                 Code=@("""
@inject Bit.Butil.LocalStorage localStorage

await localStorage.SetItem("theme", "dark");

var theme = await localStorage.GetItem("theme"); // "dark"

await localStorage.RemoveItem("theme");
""")>
        <div class="field-row">
            <div class="field">
                <span class="field-label">Key</span>
                <input @bind="localKey" placeholder="e.g. theme" />
            </div>
            <div class="field">
                <span class="field-label">Value</span>
                <input @bind="localValue" placeholder="e.g. dark" />
            </div>
        </div>
        <div class="controls">
            <button @onclick="SetLocalItem">SetItem</button>
            <button class="secondary" @onclick="GetLocalItem">GetItem</button>
            <button class="danger" @onclick="RemoveLocalItem">RemoveItem</button>
        </div>
        <DemoConsole @ref="localOutput" Title="localStorage output" />
    </DemoSection>

    <DemoSection Title="Session storage"
                 Api="SessionStorage"
                 Description="SessionStorage shares the exact same API but is scoped to the current tab: a page reload keeps the data, closing the tab discards it, and two tabs of the same site each get their own copy. It is ideal for wizard state, draft forms and other per-visit data."
                 Code=@("""
@inject Bit.Butil.SessionStorage sessionStorage

await sessionStorage.SetItem("wizard-step", "2");

var step = await sessionStorage.GetItem("wizard-step");

await sessionStorage.RemoveItem("wizard-step");
""")>
        <div class="field-row">
            <div class="field">
                <span class="field-label">Key</span>
                <input @bind="sessionKey" placeholder="e.g. wizard-step" />
            </div>
            <div class="field">
                <span class="field-label">Value</span>
                <input @bind="sessionValue" placeholder="e.g. 2" />
            </div>
        </div>
        <div class="controls">
            <button @onclick="SetSessionItem">SetItem</button>
            <button class="secondary" @onclick="GetSessionItem">GetItem</button>
            <button class="danger" @onclick="RemoveSessionItem">RemoveItem</button>
        </div>
        <DemoConsole @ref="sessionOutput" Title="sessionStorage output" />
    </DemoSection>

    <DemoSection Title="Typed values"
                 Api="SetItem<T> / GetItem<T>"
                 Description="Browsers only store strings, so Butil offers generic overloads that JSON-serialize on write and deserialize on read. Strings round-trip untouched; any other type goes through System.Text.Json. Only read typed values you wrote with the typed overload - raw strings written via SetItem may not be valid JSON."
                 Code=@("""
public record UserPrefs(string Theme, int FontSize);

await localStorage.SetItem("prefs", new UserPrefs("dark", 14));

var prefs = await localStorage.GetItem<UserPrefs>("prefs");
// prefs.Theme == "dark", prefs.FontSize == 14
""")>
        <div class="field-row">
            <div class="field">
                <span class="field-label">Theme</span>
                <input @bind="prefsTheme" placeholder="dark" />
            </div>
            <div class="field">
                <span class="field-label">Font size</span>
                <input @bind="prefsFontSize" type="number" />
            </div>
        </div>
        <div class="controls">
            <button @onclick="SetTypedItem">SetItem&lt;UserPrefs&gt;</button>
            <button class="secondary" @onclick="GetTypedItem">GetItem&lt;UserPrefs&gt;</button>
        </div>
        <DemoConsole @ref="typedOutput" Title="typed values output" />
    </DemoSection>

    <DemoSection Title="Inspect the store"
                 Api="GetLength / GetKey / ContainsKey"
                 Description="Enumerate a storage area without knowing its keys up front: GetLength reports how many items are stored, GetKey returns the name of the nth key, and ContainsKey checks for a key's existence without materializing its value."
                 Code=@("""
var count = await localStorage.GetLength();

for (var i = 0; i < count; i++)
{
    var key = await localStorage.GetKey(i);
}

var hasTheme = await localStorage.ContainsKey("theme");
""")>
        <div class="field-row">
            <div class="field">
                <span class="field-label">Key index</span>
                <input @bind="keyIndex" type="number" />
            </div>
            <div class="field">
                <span class="field-label">Key to check</span>
                <input @bind="containsKey" placeholder="e.g. theme" />
            </div>
        </div>
        <div class="controls">
            <button class="secondary" @onclick="GetLength">GetLength</button>
            <button class="secondary" @onclick="GetKey">GetKey (by index)</button>
            <button class="secondary" @onclick="ContainsKeyDemo">ContainsKey</button>
        </div>
        <DemoConsole @ref="inspectOutput" Title="inspect output" />
    </DemoSection>

    <DemoSection Title="Clear everything"
                 Api="Clear"
                 Description="Clear empties the entire storage area for this origin in one call. It only affects the area you call it on - clearing localStorage leaves sessionStorage untouched, and vice versa."
                 Code=@("""
await localStorage.Clear();

await sessionStorage.Clear();
""")>
        <div class="controls">
            <button class="danger" @onclick="ClearLocal">Clear localStorage</button>
            <button class="danger" @onclick="ClearSession">Clear sessionStorage</button>
        </div>
        <DemoConsole @ref="clearOutput" Title="clear output" />
    </DemoSection>

    <DemoSection Title="Cross-tab change events"
                 Api="SubscribeChanges"
                 Description="The DOM storage event fires when another tab or window of the same origin modifies localStorage. SubscribeChanges wires a C# handler to it and returns a ButilSubscription you dispose to detach. To see it in action, subscribe below, open this site in a second tab, and write a value there."
                 Code=@("""
private ButilSubscription? subscription;

subscription = await localStorage.SubscribeChanges(e =>
{
    Console.WriteLine($"{e.Key}: {e.OldValue} -> {e.NewValue}");
});

// later, e.g. in DisposeAsync:
await subscription.DisposeAsync();
""")>
        <div class="controls">
            <button @onclick="Subscribe" disabled="@(subscription is not null)">SubscribeChanges</button>
            <button class="secondary" @onclick="Unsubscribe" disabled="@(subscription is null)">Dispose subscription</button>
        </div>
        <DemoConsole @ref="eventsOutput" Title="change events output" />
    </DemoSection>
</div>

<Callout Type="info" Title="localStorage vs sessionStorage">
    Same API, different lifetime. <code>localStorage</code> persists across restarts and is shared by
    every tab of the origin; <code>sessionStorage</code> is per-tab and cleared when the tab closes.
    Both are limited to roughly 5&nbsp;MB per origin and store strings only.
</Callout>

<Callout Type="warning" Title="Storage events are cross-tab only">
    The <code>storage</code> event never fires in the tab that made the change, and it only propagates
    across tabs for <code>localStorage</code> - <code>sessionStorage</code> is scoped to a single tab,
    so its subscription will not receive cross-tab notifications.
</Callout>

<ApiTable Title="API reference (ButilStorage - shared by LocalStorage and SessionStorage)">
    <ApiMember Name="GetLength"
               Signature="Task<int> GetLength()"
               Description="Returns the number of data items stored in the storage area." />
    <ApiMember Name="GetKey"
               Signature="Task<string?> GetKey(int index)"
               Description="Returns the name of the nth key in the storage, or null when the index is out of range." />
    <ApiMember Name="ContainsKey"
               Signature="Task<bool> ContainsKey(string key)"
               Description="True when the storage contains an item with the given key." />
    <ApiMember Name="GetItem"
               Signature="Task<string?> GetItem(string? key)"
               Description="Returns the raw string value stored under the key, or null when absent." />
    <ApiMember Name="GetItem<T>"
               Signature="Task<T?> GetItem<T>(string key, JsonSerializerOptions? options = null)"
               Description="Returns a JSON-deserialized value, or default(T) when the key is missing. Throws JsonException when the stored value is not valid JSON for T." />
    <ApiMember Name="SetItem"
               Signature="Task SetItem(string? key, string? value)"
               Description="Adds the key to the storage, or updates its value if it already exists." />
    <ApiMember Name="SetItem<T>"
               Signature="Task SetItem<T>(string key, T? value, JsonSerializerOptions? options = null)"
               Description="JSON-serializes the value and stores it under the key. Strings are stored as-is." />
    <ApiMember Name="RemoveItem"
               Signature="Task RemoveItem(string? key)"
               Description="Removes the key from the storage. Removing a missing key is a no-op." />
    <ApiMember Name="Clear"
               Signature="Task Clear()"
               Description="Empties all keys out of the storage area." />
    <ApiMember Name="SubscribeChanges"
               Signature="Task<ButilSubscription> SubscribeChanges(Action<StorageEvent> handler)"
               Description="Subscribes to cross-tab storage events for this storage area. Dispose the returned subscription to detach the handler." />
    <ApiMember Name="StorageEvent"
               Signature="class StorageEvent { string? Key; string? OldValue; string? NewValue; string? Url; string StorageArea; }"
               Description="Event payload: the changed key (null on clear), previous and new values, the URL of the document that triggered the change, and the storage area name." />
    <ApiMember Name="InvokeStorageEvent"
               Signature="void InvokeStorageEvent(Guid id, StorageEvent evt)"
               Description="Infrastructure - JSInvokable callback dispatched from JavaScript when a storage event fires. Not intended to be called from application code." />
    <ApiMember Name="DisposeAsync"
               Signature="ValueTask DisposeAsync()"
               Description="Detaches all active change subscriptions and releases the JS interop reference." />
</ApiTable>

@code {
    private DemoConsole localOutput = default!;
    private DemoConsole sessionOutput = default!;
    private DemoConsole typedOutput = default!;
    private DemoConsole inspectOutput = default!;
    private DemoConsole clearOutput = default!;
    private DemoConsole eventsOutput = default!;

    private string localKey = "theme";
    private string localValue = "dark";
    private string sessionKey = "wizard-step";
    private string sessionValue = "2";
    private string prefsTheme = "dark";
    private int prefsFontSize = 14;
    private int keyIndex;
    private string containsKey = "theme";
    private ButilSubscription? subscription;

    private record UserPrefs(string Theme, int FontSize);

    private async Task SetLocalItem()
    {
        try
        {
            await localStorage.SetItem(localKey, localValue);
            await localOutput.Log($"localStorage.SetItem(\"{localKey}\", \"{localValue}\")");
        }
        catch (Exception ex)
        {
            await localOutput.Error(ex.Message);
        }
    }

    private async Task GetLocalItem()
    {
        try
        {
            var value = await localStorage.GetItem(localKey);
            await localOutput.Success($"localStorage.GetItem(\"{localKey}\") →", value ?? "(null)");
        }
        catch (Exception ex)
        {
            await localOutput.Error(ex.Message);
        }
    }

    private async Task RemoveLocalItem()
    {
        try
        {
            await localStorage.RemoveItem(localKey);
            await localOutput.Warn($"localStorage.RemoveItem(\"{localKey}\")");
        }
        catch (Exception ex)
        {
            await localOutput.Error(ex.Message);
        }
    }

    private async Task SetSessionItem()
    {
        try
        {
            await sessionStorage.SetItem(sessionKey, sessionValue);
            await sessionOutput.Log($"sessionStorage.SetItem(\"{sessionKey}\", \"{sessionValue}\")");
        }
        catch (Exception ex)
        {
            await sessionOutput.Error(ex.Message);
        }
    }

    private async Task GetSessionItem()
    {
        try
        {
            var value = await sessionStorage.GetItem(sessionKey);
            await sessionOutput.Success($"sessionStorage.GetItem(\"{sessionKey}\") →", value ?? "(null)");
        }
        catch (Exception ex)
        {
            await sessionOutput.Error(ex.Message);
        }
    }

    private async Task RemoveSessionItem()
    {
        try
        {
            await sessionStorage.RemoveItem(sessionKey);
            await sessionOutput.Warn($"sessionStorage.RemoveItem(\"{sessionKey}\")");
        }
        catch (Exception ex)
        {
            await sessionOutput.Error(ex.Message);
        }
    }

    private async Task SetTypedItem()
    {
        try
        {
            var prefs = new UserPrefs(prefsTheme, prefsFontSize);
            await localStorage.SetItem("prefs", prefs);
            await typedOutput.Log("localStorage.SetItem(\"prefs\", ...) →", prefs);
        }
        catch (Exception ex)
        {
            await typedOutput.Error(ex.Message);
        }
    }

    private async Task GetTypedItem()
    {
        try
        {
            var prefs = await localStorage.GetItem<UserPrefs>("prefs");
            if (prefs is null)
            {
                await typedOutput.Warn("localStorage.GetItem<UserPrefs>(\"prefs\") → (null) - store it first.");
                return;
            }
            await typedOutput.Success("localStorage.GetItem<UserPrefs>(\"prefs\") →", prefs);
        }
        catch (Exception ex)
        {
            await typedOutput.Error(ex.Message);
        }
    }

    private async Task GetLength()
    {
        try
        {
            var length = await localStorage.GetLength();
            await inspectOutput.Success("localStorage.GetLength() →", length);
        }
        catch (Exception ex)
        {
            await inspectOutput.Error(ex.Message);
        }
    }

    private async Task GetKey()
    {
        try
        {
            var key = await localStorage.GetKey(keyIndex);
            await inspectOutput.Success($"localStorage.GetKey({keyIndex}) →", key ?? "(null)");
        }
        catch (Exception ex)
        {
            await inspectOutput.Error(ex.Message);
        }
    }

    private async Task ContainsKeyDemo()
    {
        try
        {
            var exists = await localStorage.ContainsKey(containsKey);
            await inspectOutput.Success($"localStorage.ContainsKey(\"{containsKey}\") →", exists);
        }
        catch (Exception ex)
        {
            await inspectOutput.Error(ex.Message);
        }
    }

    private async Task ClearLocal()
    {
        try
        {
            await localStorage.Clear();
            await clearOutput.Warn("localStorage.Clear() - all keys removed.");
        }
        catch (Exception ex)
        {
            await clearOutput.Error(ex.Message);
        }
    }

    private async Task ClearSession()
    {
        try
        {
            await sessionStorage.Clear();
            await clearOutput.Warn("sessionStorage.Clear() - all keys removed.");
        }
        catch (Exception ex)
        {
            await clearOutput.Error(ex.Message);
        }
    }

    private async Task Subscribe()
    {
        try
        {
            subscription = await localStorage.SubscribeChanges(e =>
            {
                _ = eventsOutput.Info($"storage event → key: {e.Key ?? "(cleared)"}, old: {e.OldValue ?? "(null)"}, new: {e.NewValue ?? "(null)"}, area: {e.StorageArea}");
            });
            await eventsOutput.Log("Subscribed. Modify localStorage from another tab of this site to see events.");
        }
        catch (Exception ex)
        {
            await eventsOutput.Error(ex.Message);
        }
    }

    private async Task Unsubscribe()
    {
        try
        {
            if (subscription is not null)
            {
                await subscription.DisposeAsync();
                subscription = null;
                await eventsOutput.Warn("Subscription disposed - no more storage events.");
            }
        }
        catch (Exception ex)
        {
            await eventsOutput.Error(ex.Message);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (subscription is not null)
            {
                await subscription.DisposeAsync();
                subscription = null;
            }
        }
        catch
        {
            // best-effort cleanup during teardown
        }
    }
}
