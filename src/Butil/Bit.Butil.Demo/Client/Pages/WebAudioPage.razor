    private async Task PlaySpatial()
    {
        try
        {
            await webAudio.Resume();
            var buffer = await EnsureChimeBuffer();
            if (buffer is null) return;

            var source = await webAudio.CreateBufferSource(buffer, loop: true);
            var panner = await webAudio.CreatePanner(new AudioPannerOptions
            {
                PanningModel = AudioPanningModel.Hrtf,
                DistanceModel = AudioDistanceModel.Inverse,
                PositionX = -3,
                PositionZ = -1,
                RefDistance = 1,
                RolloffFactor = 1
            });

            if (source is null || panner is null)
            {
                await spaceOutput.Warn("the spatial graph could not be built (no audio context?)");
                return;
            }

            await webAudio.SetListener(0, 0, 0);
            await source.Connect(panner);
            await panner.ConnectToDestination();
            await source.Start();

            // Four seconds from the left ear to the right, scheduled on the audio thread.
            await panner.RampParam("positionX", 3, overSeconds: 4);
            await spaceOutput.Success("HRTF panner: flying from left to right over four seconds (best on headphones)");

            await DisposeAfter(4200, source, panner);
        }
        catch (Exception ex)
        {
            await spaceOutput.Error("the spatial sample failed →", ex.Message);
        }
    }

    private async Task PlayEcho()
    {
        try
        {
            await webAudio.Resume();
            var buffer = await EnsureChimeBuffer();
            if (buffer is null) return;

            var source = await webAudio.CreateBufferSource(buffer);
            var delay = await webAudio.CreateDelay(1, 0.25);
            var feedback = await webAudio.CreateGain(0.45);
            if (source is null || delay is null || feedback is null)
            {
                await effectOutput.Warn("the echo graph could not be built (no audio context?)");
                return;
            }

            await source.ConnectToDestination();     // the dry signal
            await source.Connect(delay);
            await delay.Connect(feedback);
            await feedback.Connect(delay);           // the cycle that makes it repeat
            await delay.ConnectToDestination();
            await source.Start();

            await effectOutput.Success("delay 250 ms with 0.45 feedback - the one legal cycle in a Web Audio graph");
            await DisposeAfter(5000, source, delay, feedback);
        }
        catch (Exception ex)
        {
            await effectOutput.Error("the echo sample failed →", ex.Message);
        }
    }

    private async Task PlayDistorted()
    {
        try
