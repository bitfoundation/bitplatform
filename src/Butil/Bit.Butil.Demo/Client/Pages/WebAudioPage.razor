    <ApiMember Name="GetCurrentTime" Signature="ValueTask<double> GetCurrentTime()" Description="The audio clock in seconds - what every scheduled start, stop and ramp is measured against." />
    <ApiMember Name="GetSampleRate" Signature="ValueTask<double> GetSampleRate()" Description="The device's sample rate; everything decoded is resampled to it." />
    <ApiMember Name="GetMasterGain" Signature="ValueTask<double> GetMasterGain()" Description="The current master gain." />
    <ApiMember Name="DecodeAudioData" Signature="ValueTask<AudioBufferHandle?> DecodeAudioData(byte[] data)" Description="Decodes any container the browser understands into samples that can be played over and over." />
    <ApiMember Name="CreateGain" Signature="ValueTask<AudioNodeHandle?> CreateGain(double gain = 1)" Description="A volume control - the node to reach for whenever something needs to fade." />
    <ApiMember Name="CreateBiquadFilter" Signature="ValueTask<AudioNodeHandle?> CreateBiquadFilter(BiquadFilterType type, double frequency, double q = 1, double gain = 0, double detune = 0)" Description="One band of equalisation: a low-pass, a shelf, a notch." />
    <ApiMember Name="CreateAnalyser" Signature="ValueTask<AnalyserNodeHandle?> CreateAnalyser(int fftSize = 2048, double smoothingTimeConstant = 0.8, double minDecibels = -100, double maxDecibels = -30)" Description="Reads the signal without changing it - the basis of every meter and spectrum." />
    <ApiMember Name="CreateConvolver" Signature="ValueTask<AudioNodeHandle?> CreateConvolver(AudioBufferHandle impulseResponse, bool normalize = true)" Description="Convolution reverb: makes the signal sound as though played in the space the impulse was recorded in." />
    <ApiMember Name="CreatePanner" Signature="ValueTask<AudioNodeHandle?> CreatePanner(AudioPannerOptions options)" Description="Places a sound at a point in space relative to the listener." />
    <ApiMember Name="CreateStereoPanner" Signature="ValueTask<AudioNodeHandle?> CreateStereoPanner(double pan = 0)" Description="Simple left/right placement, at a fraction of a full panner's cost." />
    <ApiMember Name="CreateDelay" Signature="ValueTask<AudioNodeHandle?> CreateDelay(double maxDelaySeconds = 1, double delaySeconds = 0)" Description="Holds the signal back by a set time; fed back into itself, it is an echo." />
    <ApiMember Name="CreateDynamicsCompressor" Signature="ValueTask<AudioNodeHandle?> CreateDynamicsCompressor(double threshold = -24, double knee = 30, double ratio = 12, double attack = 0.003, double release = 0.25)" Description="Pulls loud passages down - also the standard guard against clipping a mix." />
    <ApiMember Name="CreateWaveShaper" Signature="ValueTask<AudioNodeHandle?> CreateWaveShaper(double[] curve, string oversample = &quot;none&quot;)" Description="Maps every sample through a curve: distortion, saturation, bit-crushing." />
    <ApiMember Name="CreateOscillator" Signature="ValueTask<AudioSourceNodeHandle?> CreateOscillator(AudioOscillatorType type, double frequency, double detune = 0)" Description="A tone generator. Connect it, then Start it." />
    <ApiMember Name="CreateBufferSource" Signature="ValueTask<AudioSourceNodeHandle?> CreateBufferSource(AudioBufferHandle buffer, bool loop = false, double loopStartSeconds = 0, double loopEndSeconds = 0, double playbackRate = 1, double detune = 0)" Description="Plays a decoded buffer. Single-use: one source per playback." />
    <ApiMember Name="CreateConstantSource" Signature="ValueTask<AudioSourceNodeHandle?> CreateConstantSource(double offset = 1)" Description="Emits a steady value - for driving several AudioParams from one ramp." />
    <ApiMember Name="CreateMediaElementSource" Signature="ValueTask<AudioNodeHandle?> CreateMediaElementSource(ElementReference mediaElement)" Description="Routes an audio or video element's sound through the graph. One node per element, ever." />
    <ApiMember Name="CreateMediaStreamSource" Signature="ValueTask<AudioNodeHandle?> CreateMediaStreamSource(MediaStreamHandle stream)" Description="Feeds a microphone or a screen share's audio into the graph." />
    <ApiMember Name="CreateMediaStreamDestination" Signature="ValueTask<MediaStreamAudioDestinationHandle?> CreateMediaStreamDestination()" Description="Ends a graph in a MediaStream instead of the speakers - ready for MediaRecorder." />
    <ApiMember Name="AddWorkletModule" Signature="ValueTask<bool> AddWorkletModule(string moduleUrl)" Description="Loads a JavaScript module that registers audio worklet processors. Needs a secure context." />
    <ApiMember Name="CreateWorkletNode" Signature="ValueTask<AudioWorkletNodeHandle?> CreateWorkletNode(string processorName, AudioWorkletNodeOptions? options = null, Action<string>? onMessage = null)" Description="Puts your own DSP code, running on the audio thread, into the graph." />
    <ApiMember Name="SetListener" Signature="ValueTask<bool> SetListener(double x, double y, double z, double forwardX = 0, double forwardY = 0, double forwardZ = -1, double upX = 0, double upY = 1, double upZ = 0)" Description="Where the ears are and which way they face - what every panner is measured against." />
    <ApiMember Name="AudioNodeHandle.Connect" Signature="ValueTask<bool> Connect(AudioNodeHandle destination)" Description="Routes this node's output into another. Connecting to several destinations splits the signal." />
    <ApiMember Name="AudioNodeHandle.ConnectToDestination" Signature="ValueTask<bool> ConnectToDestination()" Description="Connects to the output, through Butil's shared master gain." />
    <ApiMember Name="AudioNodeHandle.Disconnect" Signature="ValueTask<bool> Disconnect()" Description="Detaches every connection this node's output makes." />
    <ApiMember Name="AudioNodeHandle.SetParam" Signature="ValueTask<bool> SetParam(string name, double value, double afterSeconds = 0)" Description="Sets an AudioParam by name, now or at a scheduled moment." />
    <ApiMember Name="AudioNodeHandle.RampParam" Signature="ValueTask<bool> RampParam(string name, double value, double overSeconds, bool exponential = false)" Description="Moves an AudioParam smoothly, on the audio thread. What to use for anything the user hears." />
    <ApiMember Name="AudioNodeHandle.CancelScheduledParam" Signature="ValueTask<bool> CancelScheduledParam(string name)" Description="Drops everything scheduled on a parameter from now on." />
    <ApiMember Name="AudioNodeHandle.SetProperty" Signature="ValueTask<bool> SetProperty(string name, string | double | bool value)" Description="Sets a plain property - a filter's type, an analyser's fftSize, a buffer source's loop." />
    <ApiMember Name="AudioSourceNodeHandle.Start" Signature="ValueTask<bool> Start(double whenSeconds = 0, double offsetSeconds = 0, double durationSeconds = 0)" Description="Begins playback, optionally scheduled and offset into the buffer." />
    <ApiMember Name="AudioSourceNodeHandle.Stop" Signature="ValueTask<bool> Stop(double whenSeconds = 0)" Description="Ends playback, optionally at a scheduled moment." />
    <ApiMember Name="AnalyserNodeHandle.GetByteFrequencyData" Signature="ValueTask<byte[]?> GetByteFrequencyData()" Description="The current spectrum, one byte per bin - what a bar chart is drawn from." />
    <ApiMember Name="AnalyserNodeHandle.GetByteTimeDomainData" Signature="ValueTask<byte[]?> GetByteTimeDomainData()" Description="The current waveform, one byte per sample - what an oscilloscope draws." />
    <ApiMember Name="AnalyserNodeHandle.GetFloatFrequencyData" Signature="ValueTask<double[]?> GetFloatFrequencyData()" Description="The spectrum in decibels, unscaled - for measurement rather than for drawing." />
    <ApiMember Name="AnalyserNodeHandle.SetFftSize" Signature="ValueTask<bool> SetFftSize(int fftSize)" Description="Samples per analysis: resolution against latency." />
