    <ApiMember Name="PlayBuffer" Signature="ValueTask<AudioPlaybackHandle> PlayBuffer(byte[] data, double startGain = 1.0, bool loop = false)" Description="Decodes and plays the given audio bytes. Returns a handle for stop/gain control." />
    <ApiMember Name="PlayTone" Signature="ValueTask<AudioPlaybackHandle> PlayTone(double frequency, double durationMs = 0, string waveform = &quot;sine&quot;, double startGain = 0.5)" Description="Plays a sine/triangle/square/sawtooth oscillator; durationMs of 0 means an open-ended tone you stop manually." />
    <ApiMember Name="DisposeAsync" Signature="ValueTask DisposeAsync()" Description="Closes the underlying AudioContext and stops any in-flight playback; called automatically when the scoped service is disposed." />
