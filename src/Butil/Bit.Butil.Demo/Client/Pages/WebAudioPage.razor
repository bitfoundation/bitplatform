    private async Task StartChain()
    {
        try
        {
            await webAudio.Resume();
            await StopChainInternal();

            chainOscillator = await webAudio.CreateOscillator(AudioOscillatorType.Sawtooth, 110);
            chainFilter = await webAudio.CreateBiquadFilter(Enum.Parse<BiquadFilterType>(filterType), 300, filterQ);
            // Starting near silence and ramping up is what keeps the first moment from clicking.
            chainGain = await webAudio.CreateGain(0.0001);

            if (chainOscillator is null || chainFilter is null || chainGain is null)
            {
                await chainOutput.Warn("the chain could not be built (no audio context?)");
                await StopChainInternal();
                return;
            }

            await chainOscillator.Connect(chainFilter);
            await chainFilter.Connect(chainGain);
            await chainGain.ConnectToDestination();

            await chainOscillator.Start();
            await chainGain.RampParam("gain", 0.25, overSeconds: 0.05, exponential: true);

            await chainOutput.Success($"oscillator → {filterType} filter (Q {filterQ:0}) → gain → destination");
        }
        catch (Exception ex)
        {
            await chainOutput.Error("building the chain failed →", ex.Message);
        }
    }

