    private async Task StopChain()
    {
        try
        {
            // Ramp down first, then stop: stopping a source at full volume clicks.
            if (chainGain is not null) await chainGain.RampParam("gain", 0.0001, overSeconds: 0.08, exponential: true);
            await Task.Delay(120);
            await StopChainInternal();
            await chainOutput.Log("faded out, stopped and disposed");
