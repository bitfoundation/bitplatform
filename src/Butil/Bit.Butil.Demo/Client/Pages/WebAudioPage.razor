            await source.Connect(shaper);
            await shaper.Connect(compressor);
            await compressor.ConnectToDestination();
            await source.Start();

            await effectOutput.Success("wave shaper (4x oversampled) into a compressor at -30 dB, ratio 12");
            await DisposeAfter(2500, source, shaper, compressor);
        }
        catch (Exception ex)
        {
            await effectOutput.Error("the distortion sample failed →", ex.Message);
        }
    }

    private async Task PlayReverb()
    {
        try
        {
            await webAudio.Resume();
            var buffer = await EnsureChimeBuffer();
            if (buffer is null) return;

            // A decaying burst of noise is a serviceable impulse response, and it means the sample
            // needs no audio file of its own.
            impulseBuffer ??= await webAudio.DecodeAudioData(GenerateImpulseWav());
            if (impulseBuffer is null)
            {
                await effectOutput.Warn("the impulse response could not be decoded");
                return;
            }

            var source = await webAudio.CreateBufferSource(buffer);
            var reverb = await webAudio.CreateConvolver(impulseBuffer);
            var wet = await webAudio.CreateGain(0.8);
            if (source is null || reverb is null || wet is null)
            {
                await effectOutput.Warn("the reverb graph could not be built (no audio context?)");
                return;
            }

            await source.ConnectToDestination();
            await source.Connect(reverb);
            await reverb.Connect(wet);
            await wet.ConnectToDestination();
            await source.Start();

            await effectOutput.Success($"convolver over a {impulseBuffer.Duration:0.0}s impulse response");
            await DisposeAfter(4000, source, reverb, wet);
        }
        catch (Exception ex)
        {
            await effectOutput.Error("the reverb sample failed →", ex.Message);
        }
    }

    private async Task RouteElement()
    {
        try
        {
            await webAudio.Resume();

            elementSource = await webAudio.CreateMediaElementSource(audioElement);
            if (elementSource is null)
            {
                await routingOutput.Warn("CreateMediaElementSource → null (this element already has a source node, or there is no context)");
                return;
            }

            var filter = await webAudio.CreateBiquadFilter(BiquadFilterType.Lowpass, 800, 1);
            await elementSource.Connect(filter!);
            await filter!.ConnectToDestination();
            transientNodes.Add(filter);
            elementFilter = filter;

            await routingOutput.Success("the element now plays through a 800 Hz low-pass - press play and hear it muffled");
        }
        catch (Exception ex)
        {
            await routingOutput.Error("routing the element failed →", ex.Message);
        }
    }

    private async Task CaptureGraph()
    {
        try
        {
            await webAudio.Resume();
            if (streamDestination is not null) await streamDestination.DisposeAsync();

            streamDestination = await webAudio.CreateMediaStreamDestination();
            if (streamDestination is null)
            {
                await routingOutput.Warn("CreateMediaStreamDestination → null (no audio context)");
                return;
            }

            // Tap the end of the routed chain, not the element: connecting the source directly would
            // capture the raw audio and record something other than what the page is playing.
            var tap = elementFilter ?? elementSource;
            if (tap is not null) await tap.Connect(streamDestination);

            var stream = streamDestination.GetStream();
            var what = elementFilter is not null
                ? "the filtered signal"
                : tap is not null ? "the unfiltered element (route it through the filter first to capture that)"
                                  : "nothing yet - route the element first, or the stream stays silent";
            await routingOutput.Success($"CreateMediaStreamDestination → stream {stream.Id} carrying {what} - hand it to MediaRecorder");
        }
        catch (Exception ex)
        {
            await routingOutput.Error("CreateMediaStreamDestination failed →", ex.Message);
        }
    }

    private async Task StartWorklet()
    {
        try
        {
            await webAudio.Resume();
            await StopWorkletInternal();

            if (await webAudio.IsWorkletSupported() is false)
            {
                await workletOutput.Warn("IsWorkletSupported → false (audio worklets need a secure context)");
                return;
            }

            if (await webAudio.AddWorkletModule("js/butil-gain-processor.js") is false)
            {
                await workletOutput.Error("AddWorkletModule → false (the module could not be loaded)");
                return;
            }

            var buffer = await EnsureChimeBuffer();
            if (buffer is null) return;

            workletNode = await webAudio.CreateWorkletNode("butil-gain-processor",
                new AudioWorkletNodeOptions { ProcessorOptions = """{"reportIntervalSeconds":0.1}""" },
                onMessage: async json =>
                {
                    using var report = JsonDocument.Parse(json);
                    workletPeak = report.RootElement.GetProperty("peak").GetDouble();
                    await InvokeAsync(StateHasChanged);
                });

            if (workletNode is null)
            {
                await workletOutput.Warn("CreateWorkletNode → null (no processor registered under that name)");
                return;
            }

            workletSource = await webAudio.CreateBufferSource(buffer, loop: true);
            await workletSource!.Connect(workletNode);
            await workletNode.ConnectToDestination();
            await workletNode.SetParam("gain", workletGain);
            await workletSource.Start();

            await workletOutput.Success("playing through the worklet - the peak below comes from the audio thread");
        }
        catch (Exception ex)
        {
            await workletOutput.Error("starting the worklet failed →", ex.Message);
        }
    }

    private async Task ApplyWorkletGain()
    {
        try
        {
            await workletOutput.Log($"SetParam(gain, {workletGain:0.00}) →", await workletNode!.SetParam("gain", workletGain));
        }
        catch (Exception ex)
        {
            await workletOutput.Error("SetParam failed →", ex.Message);
        }
    }

    private async Task ToggleWorkletMute()
    {
        try
        {
            workletMuted = !workletMuted;
            await workletOutput.Log($"PostMessage(\"{(workletMuted ? "mute" : "unmute")}\") →",
                                    await workletNode!.PostMessage(workletMuted ? "mute" : "unmute"));
        }
        catch (Exception ex)
        {
            await workletOutput.Error("PostMessage failed →", ex.Message);
        }
    }

    private async Task StopWorklet()
    {
        try
        {
            await StopWorkletInternal();
            await workletOutput.Log("worklet node and source disposed");
        }
        catch (Exception ex)
        {
            await workletOutput.Error("stopping the worklet failed →", ex.Message);
        }
    }

    private async Task<AudioBufferHandle?> EnsureChimeBuffer()
    {
        chimeWav ??= GenerateChimeWav();
        decodedBuffer ??= await webAudio.DecodeAudioData(chimeWav);

        return decodedBuffer;
    }

    /// <summary>Plays for a while, then releases the nodes - a one-shot graph has no other owner.</summary>
    private async Task DisposeAfter(int milliseconds, params AudioNodeHandle[] nodes)
    {
        transientNodes.AddRange(nodes);
        await Task.Delay(milliseconds);

        foreach (var node in nodes)
        {
            transientNodes.Remove(node);
            await node.DisposeAsync();
        }
    }

    private async Task StopBufferSourceInternal()
    {
        if (bufferSource is null) return;

        await bufferSource.DisposeAsync();
        bufferSource = null;
    }

    private async Task StopChainInternal()
    {
        if (chainOscillator is not null) await chainOscillator.DisposeAsync();
        if (chainFilter is not null) await chainFilter.DisposeAsync();
        if (chainGain is not null) await chainGain.DisposeAsync();
        chainOscillator = null;
        chainFilter = null;
        chainGain = null;
    }

    private async Task StopMeterInternal()
    {
        if (meterTimer is not null)
        {
            await meterTimer.DisposeAsync();
            meterTimer = null;
        }
        if (analyserSource is not null) await analyserSource.DisposeAsync();
        if (analyser is not null) await analyser.DisposeAsync();
        analyserSource = null;
        analyser = null;
        spectrum = null;
    }

    private async Task StopWorkletInternal()
    {
        if (workletSource is not null) await workletSource.DisposeAsync();
        if (workletNode is not null) await workletNode.DisposeAsync();
        workletSource = null;
        workletNode = null;
        workletPeak = null;
        workletMuted = false;
    }

    /// <summary>A hyperbolic-tangent transfer curve - the usual shape for a musical distortion.</summary>
    private static double[] BuildDistortionCurve(double amount)
    {
        const int samples = 1024;
        var curve = new double[samples];
        for (var i = 0; i < samples; i++)
        {
            var x = i * 2.0 / (samples - 1) - 1;
            curve[i] = Math.Tanh(x * amount) / Math.Tanh(amount);
        }

        return curve;
    }

    /// <summary>Exponentially decaying noise as a wav - a serviceable impulse response for a convolver.</summary>
    private static byte[] GenerateImpulseWav()
    {
        const int sampleRate = 44100;
        const double seconds = 1.5;
        var sampleCount = (int)(sampleRate * seconds);
        var dataSize = sampleCount * 2;
        var random = new Random(1);   // fixed seed: the same room every time

        using var stream = new MemoryStream(44 + dataSize);
        using var writer = new BinaryWriter(stream);

        writer.Write("RIFF"u8);
        writer.Write(36 + dataSize);
        writer.Write("WAVE"u8);
        writer.Write("fmt "u8);
        writer.Write(16);
        writer.Write((short)1);
        writer.Write((short)1);
        writer.Write(sampleRate);
        writer.Write(sampleRate * 2);
        writer.Write((short)2);
        writer.Write((short)16);
        writer.Write("data"u8);
        writer.Write(dataSize);

        for (var i = 0; i < sampleCount; i++)
        {
            var t = (double)i / sampleRate;
            var envelope = Math.Pow(1 - t / seconds, 3);
            var sample = (random.NextDouble() * 2 - 1) * envelope;
            writer.Write((short)(sample * short.MaxValue * 0.6));
        }

        writer.Flush();
        return stream.ToArray();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await StopToneInternal();
            await StopBufferInternal();
            await StopBufferSourceInternal();
            await StopChainInternal();
            await StopMeterInternal();
            await StopWorkletInternal();

            // A DisposeAfter still counting down removes from this list while the loop below awaits,
            // so tear down a snapshot - enumerating the live list would throw and strand the rest.
            var pending = transientNodes.ToArray();
            transientNodes.Clear();
            foreach (var node in pending) await node.DisposeAsync();

            if (elementSource is not null) await elementSource.DisposeAsync();
            if (streamDestination is not null) await streamDestination.DisposeAsync();
            if (decodedBuffer is not null) await decodedBuffer.DisposeAsync();
            if (impulseBuffer is not null) await impulseBuffer.DisposeAsync();
        }
        catch
        {
            // best-effort cleanup during teardown
        }
    }
}
