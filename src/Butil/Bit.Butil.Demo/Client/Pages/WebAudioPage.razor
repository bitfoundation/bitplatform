            await webAudio.Resume();
            var buffer = await EnsureChimeBuffer();
            if (buffer is null) return;

            var source = await webAudio.CreateBufferSource(buffer);
            var shaper = await webAudio.CreateWaveShaper(BuildDistortionCurve(60), "4x");
            var compressor = await webAudio.CreateDynamicsCompressor(threshold: -30, ratio: 12);
            if (source is null || shaper is null || compressor is null)
