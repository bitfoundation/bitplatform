            await clockOutput.Error("reading the context failed →", ex.Message);
        }
    }

    private async Task DecodeChime()
    {
        try
        {
            chimeWav ??= GenerateChimeWav();
            if (decodedBuffer is not null) await decodedBuffer.DisposeAsync();

            decodedBuffer = await webAudio.DecodeAudioData(chimeWav);
            if (decodedBuffer is null)
            {
                await graphOutput.Warn("DecodeAudioData → null (the bytes could not be decoded)");
                return;
            }

            await graphOutput.Success($"DecodeAudioData → {decodedBuffer.Duration:0.00}s, {decodedBuffer.SampleRate} Hz, " +
                                      $"{decodedBuffer.NumberOfChannels} channel(s), {decodedBuffer.Length:N0} samples");
        }
        catch (Exception ex)
        {
            await graphOutput.Error("DecodeAudioData failed →", ex.Message);
        }
    }

    private async Task PlayFromBuffer()
    {
        try
        {
            await webAudio.Resume();
            await StopBufferSourceInternal();

            bufferSource = await webAudio.CreateBufferSource(decodedBuffer!, loop: loopSource, playbackRate: playbackRate);
            if (bufferSource is null)
