    private async Task StartMeter()
    {
        try
        {
            await webAudio.Resume();
            await StopMeterInternal();

            chimeWav ??= GenerateChimeWav();
            decodedBuffer ??= await webAudio.DecodeAudioData(chimeWav);
            if (decodedBuffer is null)
            {
                await analyserOutput.Warn("nothing to analyse - the buffer could not be decoded");
                return;
            }

            analyserSource = await webAudio.CreateBufferSource(decodedBuffer, loop: true);
            analyser = await webAudio.CreateAnalyser(fftSize: 1024, smoothingTimeConstant: 0.8);
            if (analyserSource is null || analyser is null)
            {
                await analyserOutput.Warn("the analyser could not be built (no audio context?)");
                await StopMeterInternal();
                return;
            }

            await analyserSource.Connect(analyser);
            await analyser.ConnectToDestination();
            await analyserSource.Start();

            meterTimer = new System.Threading.Timer(async _ => await SampleSpectrum(), null, 0, 100);
            await analyserOutput.Success("analysing a looping buffer at 10 Hz - fast enough for a meter, slow enough for interop");
        }
        catch (Exception ex)
        {
            await analyserOutput.Error("starting the analyser failed →", ex.Message);
        }
    }

    private async Task SampleSpectrum()
    {
        try
        {
            var current = analyser;
            if (current is null) return;

            var data = await current.GetByteFrequencyData();
            if (data is null) return;

            // 512 bins is far more than a bar chart needs; averaging into 32 buckets is both cheaper
            // to render and easier to read.
            const int buckets = 32;
            var bars = new int[buckets];
            var perBucket = data.Length / buckets;
            for (var b = 0; b < buckets; b++)
            {
                var sum = 0;
                for (var i = 0; i < perBucket; i++) sum += data[b * perBucket + i];
                bars[b] = sum / perBucket;
            }

            spectrum = bars;
            peak = data.Max();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // the graph was torn down between the timer firing and the read
        }
    }

