@page "/credentials"
@inject Bit.Butil.Credentials credentials

<PageTitle>Credentials - Bit.Butil</PageTitle>

<PageHeader Category="Identity &amp; Permissions"
            Title="Credentials"
            Lead="The password and federated half of navigator.credentials: hand a sign-in to the browser's password manager, and get it back - silently, if you ask - on the next visit."
            MdnUrl="https://developer.mozilla.org/en-US/docs/Web/API/Credential_Management_API"
            InjectAs="Credentials credentials" />

<Callout Type="info" Title="The other halves of the same container">
    Public-key credentials (passkeys) are <a href="web-authn">WebAuthn</a>, federated sign-in
    without third-party cookies is <a href="fed-cm">FedCM</a>, SMS one-time codes are
    <a href="web-otp">WebOtp</a>, and wallet credentials are
    <a href="digital-credentials">DigitalCredentials</a>. They all go through
    <code>navigator.credentials</code>; this page is the password store.
</Callout>

<Callout Type="warning" Title="Chromium only, and secure context only">
    <code>PasswordCredential</code> and <code>FederatedCredential</code> are implemented by Chromium.
    Firefox and Safari expose <code>navigator.credentials</code> for passkeys but not for these, so
    <code>IsPasswordSupported</code> - not <code>IsSupported</code> - is the check worth branching on.
</Callout>

<div class="stack">
    <DemoSection Title="Support checks"
                 Api="IsSupported / IsPasswordSupported / IsFederatedSupported"
                 Description="Whether the container exists at all, and whether the two credential types this service stores are implemented. During prerender/SSR these return false rather than throwing, so defer them to OnAfterRenderAsync."
                 Code=@("""
@inject Bit.Butil.Credentials credentials

var container = await credentials.IsSupported();
var passwords = await credentials.IsPasswordSupported();
var federated = await credentials.IsFederatedSupported();
""")>
        <div class="controls">
            <button @onclick="CheckSupported">Check support</button>
        </div>
        <DemoConsole @ref="supportOutput" Title="support check output" />
    </DemoSection>

    <DemoSection Title="Store a password"
                 Api="StorePassword"
                 Description="Offers a username/password pair to the password manager, which decides for itself whether to prompt. Call it after the server has confirmed the sign-in - storing a credential the server rejected teaches the password manager a wrong answer."
                 Code=@("""
var stored = await credentials.StorePassword(
    id: "ada@example.com",
    password: thePassword,
    name: "Ada Lovelace",
    iconUrl: "https://example.com/avatar.png");
""")>
        <div class="field">
            <span class="field-label">Account</span>
            <div class="controls">
                <input @bind="_id" placeholder="id (username or email)" style="min-width:14rem" />
                <input @bind="_password" type="password" placeholder="password" style="min-width:10rem" />
                <input @bind="_name" placeholder="display name" style="min-width:10rem" />
            </div>
        </div>
        <div class="controls">
            <button @onclick="StorePassword">StorePassword</button>
        </div>
        <DemoConsole @ref="storeOutput" Title="store password output" />
    </DemoSection>

    <DemoSection Title="Store a federated sign-in"
                 Api="StoreFederated"
                 Description="Records that this account signs in through an identity provider, so the account chooser can offer &quot;continue with ...&quot; next time. No secret is stored - just the account and the provider's origin."
                 Code=@("""
var stored = await credentials.StoreFederated(
    id: "ada@example.com",
    provider: "https://accounts.google.com",
    name: "Ada Lovelace");
""")>
        <div class="field">
            <span class="field-label">Provider origin</span>
            <input @bind="_provider" style="min-width:20rem" />
        </div>
        <div class="controls">
            <button @onclick="StoreFederated">StoreFederated</button>
        </div>
        <DemoConsole @ref="federatedOutput" Title="store federated output" />
    </DemoSection>

    <DemoSection Title="Get a credential"
                 Api="Get"
                 Description="Asks the browser for a stored credential. With Silent mediation nothing is shown at all - either a credential comes back and you can sign the user in, or nothing does and the visit continues undisturbed. Required always shows the chooser, which is what to use right after a sign-out."
                 Code=@("""
var credential = await credentials.Get(new CredentialRequestOptions
{
    Password = true,
    FederatedProviders = ["https://accounts.google.com"],
    Mediation = CredentialMediation.Silent
});

if (credential is { Type: "password" })
{
    // POST credential.Id / credential.Password to the sign-in endpoint.
}
""")>
        <div class="controls">
            <label><input type="checkbox" @bind="_wantPassword" /> Password credentials</label>
            <label><input type="checkbox" @bind="_wantFederated" /> Federated credentials</label>
        </div>
        <div class="field">
            <span class="field-label">Mediation</span>
            <select @bind="_mediation">
                <option value="@CredentialMediation.Optional">Optional</option>
                <option value="@CredentialMediation.Silent">Silent</option>
                <option value="@CredentialMediation.Required">Required</option>
                <option value="@CredentialMediation.Conditional">Conditional</option>
            </select>
        </div>
        <div class="controls">
            <button @onclick="Get">Get</button>
        </div>
        <DemoConsole @ref="getOutput" Title="get credential output" />
    </DemoSection>

    <DemoSection Title="Sign out properly"
                 Api="PreventSilentAccess"
                 Description="Turns off silent access until the user next signs in deliberately. Without it, the next visit signs them straight back in - which is the bug behind &quot;I clicked sign out and it logged me back in&quot;."
                 Code=@("""
await credentials.PreventSilentAccess();
""")>
        <div class="controls">
            <button @onclick="PreventSilentAccess">PreventSilentAccess</button>
        </div>
        <DemoConsole @ref="signOutOutput" Title="prevent silent access output" />
    </DemoSection>
</div>

<ApiTable Title="API reference">
    <ApiMember Name="IsSupported"
               Signature="ValueTask<bool> IsSupported()"
               Description="True when the runtime exposes navigator.credentials. Returns default (false) during prerender/SSR instead of throwing." />
    <ApiMember Name="IsPasswordSupported"
               Signature="ValueTask<bool> IsPasswordSupported()"
               Description="True when the runtime exposes window.PasswordCredential. This is the check to branch on." />
    <ApiMember Name="IsFederatedSupported"
               Signature="ValueTask<bool> IsFederatedSupported()"
               Description="True when the runtime exposes window.FederatedCredential." />
    <ApiMember Name="StorePassword"
               Signature="ValueTask<bool> StorePassword(string id, string password, string? name = null, string? iconUrl = null)"
               Description="Offers a username/password pair to the password manager. False when the browser declined or the API is missing." />
    <ApiMember Name="StoreFederated"
               Signature="ValueTask<bool> StoreFederated(string id, string provider, string? name = null, string? iconUrl = null, string? protocol = null)"
               Description="Records an account as signing in through an identity provider. No secret is stored." />
    <ApiMember Name="Get"
               Signature="ValueTask<CredentialInfo?> Get(CredentialRequestOptions? options = null)"
               Description="Returns a stored credential, or null when there is none or the user dismissed the chooser." />
    <ApiMember Name="PreventSilentAccess"
               Signature="ValueTask PreventSilentAccess()"
               Description="Turns off silent access until the next deliberate sign-in. Call it on sign-out." />
    <ApiMember Name="CredentialRequestOptions"
               Signature="bool Password, string[]? FederatedProviders, string[]? FederatedProtocols, CredentialMediation Mediation (asking for neither throws ArgumentException)"
               Description="Which credentials are acceptable, and how much UI the browser may show." />
    <ApiMember Name="CredentialMediation"
               Signature="enum { Optional, Silent, Required, Conditional }"
               Description="Silent shows no UI; Required always asks; Conditional offers the credential through autofill." />
    <ApiMember Name="CredentialInfo"
               Signature="string Type, string Id, string? Name, string? IconUrl, string? Password, string? Provider, string? Protocol"
               Description="The credential the manager handed back. Type is &quot;password&quot; or &quot;federated&quot;; Password is set only on the former." />
</ApiTable>

@code {
    private DemoConsole supportOutput = default!;
    private DemoConsole storeOutput = default!;
    private DemoConsole federatedOutput = default!;
    private DemoConsole getOutput = default!;
    private DemoConsole signOutOutput = default!;

    private string _id = "ada@example.com";
    private string _password = "correct horse battery staple";
    private string _name = "Ada Lovelace";
    private string _provider = "https://accounts.google.com";
    private bool _wantPassword = true;
    private bool _wantFederated;
    private CredentialMediation _mediation = CredentialMediation.Optional;

    private async Task CheckSupported()
    {
        try
        {
            await supportOutput.Success("IsSupported →", await credentials.IsSupported());
            await supportOutput.Success("IsPasswordSupported →", await credentials.IsPasswordSupported());
            await supportOutput.Success("IsFederatedSupported →", await credentials.IsFederatedSupported());
        }
        catch (Exception ex)
        {
            await supportOutput.Error("Support check failed →", ex.Message);
        }
    }

    private async Task StorePassword()
    {
        try
        {
            if (await credentials.IsPasswordSupported() is false)
            {
                await storeOutput.Warn("PasswordCredential is not implemented in this browser.");
                return;
            }

            var stored = await credentials.StorePassword(_id, _password, _name);
            await storeOutput.Success("StorePassword →", stored ? "handed to the password manager" : "declined");
        }
        catch (Exception ex)
        {
            await storeOutput.Error("StorePassword failed →", ex.Message);
        }
    }

    private async Task StoreFederated()
    {
        try
        {
            if (await credentials.IsFederatedSupported() is false)
            {
                await federatedOutput.Warn("FederatedCredential is not implemented in this browser.");
                return;
            }

            var stored = await credentials.StoreFederated(_id, _provider, _name);
            await federatedOutput.Success("StoreFederated →", stored ? "handed to the password manager" : "declined");
        }
        catch (Exception ex)
        {
            await federatedOutput.Error("StoreFederated failed →", ex.Message);
        }
    }

    private async Task Get()
    {
        try
        {
            var credential = await credentials.Get(new CredentialRequestOptions
            {
                Password = _wantPassword,
                FederatedProviders = _wantFederated ? [_provider] : null,
                Mediation = _mediation
            });

            if (credential is null)
            {
                await getOutput.Warn("Get →", "no credential (none stored, or the chooser was dismissed).");
                return;
            }

            await getOutput.Success("Get →", $"{credential.Type}: {credential.Id} ({credential.Name ?? "no name"})");

            if (credential.Provider is not null)
            {
                await getOutput.Info("Provider →", credential.Provider);
            }
        }
        catch (Exception ex)
        {
            await getOutput.Error("Get failed →", ex.Message);
        }
    }

    private async Task PreventSilentAccess()
    {
        try
        {
            await credentials.PreventSilentAccess();
            await signOutOutput.Success("PreventSilentAccess →", "the next sign-in has to be deliberate.");
        }
        catch (Exception ex)
        {
            await signOutOutput.Error("PreventSilentAccess failed →", ex.Message);
        }
    }
}
