</DemoSection>

<DemoSection Title="DOM events"
             Api="SubscribeEvent"
             Description="Subscribe to any DOM event on the element with a strongly typed args class per event family - mouse, keyboard, pointer, touch, wheel, focus, input, drag, clipboard and composition. The generic argument must match the event: ButilEvents.Click pairs with ButilMouseEventArgs, ButilEvents.KeyDown with ButilKeyboardEventArgs, and so on. A second overload takes ButilEventListenerOptions for capture, passive and once semantics."
             Code=@("""
@inject IJSRuntime js

private ButilSubscription? clickSub;

clickSub = await box.SubscribeEvent<ButilMouseEventArgs>(
    js, ButilEvents.Click, args => Console.WriteLine(args.OffsetX));

// capture / passive / once via options:
await input.SubscribeEvent<ButilKeyboardEventArgs>(
    js, ButilEvents.KeyDown, args => Console.WriteLine(args.Key),
    new ButilEventListenerOptions { Once = true });

// element subscriptions must be disposed:
await clickSub.DisposeAsync();
""")>
    <div @ref="eventsBoxRef"
         class="demo-box dashed">
        Click target - subscribe below, then click me.
    </div>
    <div class="field">
        <span class="field-label">Keydown target (the once listener fires a single time)</span>
        <input @ref="eventsInputRef" placeholder="type here after subscribing..." style="max-width:20rem;" />
    </div>
    <div class="controls">
        <button @onclick="SubscribeClick">Subscribe click</button>
        <button @onclick="SubscribeKeyDownOnce">Subscribe keydown (once)</button>
        <button class="danger" @onclick="UnsubscribeEvents">Dispose subscriptions</button>
    </div>
    <DemoConsole @ref="eventsOutput" Title="DOM events output" />
</DemoSection>

<DemoSection Title="Selector matching and removal"
             Api="Matches / Remove"
             Description="Matches tests the element against any CSS selector. Remove detaches the element from the DOM - reload the page to bring the demo target back."
             Code=@("""
var isMatch = await box.Matches("[data-demo]");

await box.Remove(); // detaches the element from the DOM
""")>
