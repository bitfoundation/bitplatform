    <ApiMember Name="SetVolume" Signature="ValueTask SetVolume(double volume)" Description="0 to 1, clamped rather than rejected. Ignored on iOS, where volume is a hardware control." />
    <ApiMember Name="SetMuted" Signature="ValueTask SetMuted(bool muted)" Description="Mutes or unmutes without changing the volume - the mute toggle that works everywhere." />
    <ApiMember Name="SetLoop" Signature="ValueTask SetLoop(bool loop)" Description="Turns looping on or off." />
    <ApiMember Name="SetPlaybackRate" Signature="ValueTask<bool> SetPlaybackRate(double rate)" Description="1 is normal speed. False when the engine rejected the rate as outside what it can resample." />
    <ApiMember Name="SetMediaSource" Signature="ValueTask SetMediaSource(string src)" Description="Points the element at a new URL - including a blob: one from ObjectUrls or a finished recording. Follow with Load." />
    <ApiMember Name="CanPlayType" Signature="ValueTask<string> CanPlayType(string mimeType)" Description=@("""The browser's own three-valued answer: "probably", "maybe", or "" for no. Deliberately not a bool.""") />
</ApiTable>

@code {
    private DemoConsole attributesOutput = default!;
    private DemoConsole scrollingOutput = default!;
    private DemoConsole metricsOutput = default!;
    private DemoConsole pointerOutput = default!;
    private DemoConsole fullscreenOutput = default!;
    private DemoConsole contentOutput = default!;
    private DemoConsole editingOutput = default!;
    private DemoConsole eventsOutput = default!;
    private DemoConsole selectorOutput = default!;
    private DemoConsole mediaOutput = default!;

    private ElementReference mediaElement;
    private MediaElementState? mediaState;

    private ElementReference targetRef;
    private ElementReference scrollBoxRef;
    private ElementReference fullscreenRef;
    private ElementReference eventsBoxRef;
    private ElementReference eventsInputRef;
    private ElementReference blurInputRef;

    private ButilSubscription? clickSub;
    private ButilSubscription? keydownOnceSub;

    private int pointerId;
    private bool isInert;

    private string attributeName = "data-demo";
    private string attributeValue = "updated";
    private string idValue = "butil-target";
    private string className = "target-box";
    private string innerText = "Rewritten from C#!";
    private string selector = "[data-demo]";

    private ContentEditable contentEditable = ContentEditable.True;
    private ElementDir dir = ElementDir.Rtl;
    private EnterKeyHint enterKeyHint = EnterKeyHint.Send;
    private InputMode inputMode = InputMode.Numeric;
    private Hidden hidden = Hidden.False;

    private async Task Run(DemoConsole output, Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            await output.Error(ex.Message);
        }
    }

    private void CapturePointerId(PointerEventArgs e) => pointerId = (int)e.PointerId;

    // ─── Attributes ───────────────────────────────────────────────────────

    private Task GetAttribute() => Run(attributesOutput, async () =>
        await attributesOutput.Success($"GetAttribute(\"{attributeName}\") →", await targetRef.GetAttribute(attributeName)));

    private Task SetAttribute() => Run(attributesOutput, async () =>
    {
        await targetRef.SetAttribute(attributeName, attributeValue);
        await attributesOutput.Log($"SetAttribute(\"{attributeName}\", \"{attributeValue}\") done");
    });

    private Task HasAttribute() => Run(attributesOutput, async () =>
        await attributesOutput.Success($"HasAttribute(\"{attributeName}\") →", await targetRef.HasAttribute(attributeName)));

    private Task HasAttributes() => Run(attributesOutput, async () =>
        await attributesOutput.Success("HasAttributes →", await targetRef.HasAttributes()));

    private Task GetAttributeNames() => Run(attributesOutput, async () =>
        await attributesOutput.Success("GetAttributeNames →", string.Join(", ", await targetRef.GetAttributeNames())));

    private Task ToggleAttribute() => Run(attributesOutput, async () =>
        await attributesOutput.Success($"ToggleAttribute(\"{attributeName}\") →", await targetRef.ToggleAttribute(attributeName, null)));

    private Task RemoveAttribute() => Run(attributesOutput, async () =>
    {
        await targetRef.RemoveAttribute(attributeName);
        await attributesOutput.Warn($"Attribute \"{attributeName}\" removed");
    });

    // ─── Scrolling ────────────────────────────────────────────────────────

    private Task ScrollToTop() => Run(scrollingOutput, async () =>
        await scrollBoxRef.Scroll(new ScrollOptions { Top = 0, Behavior = ScrollBehavior.Smooth }));

    private Task ScrollToBottom() => Run(scrollingOutput, async () =>
        await scrollBoxRef.Scroll(new ScrollOptions { Top = 9999, Behavior = ScrollBehavior.Smooth }));

    private Task ScrollByAmount() => Run(scrollingOutput, async () =>
        await scrollBoxRef.ScrollBy(new ScrollOptions { Top = 48, Behavior = ScrollBehavior.Smooth }));

    private Task ScrollIntoView() => Run(scrollingOutput, async () =>
        await scrollBoxRef.ScrollIntoView(new ScrollIntoViewOptions
        {
            Behavior = ScrollBehavior.Smooth,
            Block = ScrollLogicalPosition.Center,
            Inline = ScrollLogicalPosition.Nearest,
        }));

    // ─── Layout metrics ───────────────────────────────────────────────────

    private Task GetBoundingClientRect() => Run(metricsOutput, async () =>
        await metricsOutput.Success("GetBoundingClientRect →", await targetRef.GetBoundingClientRect()));

    private Task GetClientMetrics() => Run(metricsOutput, async () =>
        await metricsOutput.Success("Client →",
            $"width={await targetRef.GetClientWidth()}, height={await targetRef.GetClientHeight()}, " +
            $"top={await targetRef.GetClientTop()}, left={await targetRef.GetClientLeft()}"));

    private Task GetOffsetMetrics() => Run(metricsOutput, async () =>
        await metricsOutput.Success("Offset →",
            $"width={await targetRef.GetOffsetWidth()}, height={await targetRef.GetOffsetHeight()}, " +
            $"top={await targetRef.GetOffsetTop()}, left={await targetRef.GetOffsetLeft()}"));

    private Task GetScrollMetrics() => Run(metricsOutput, async () =>
        await metricsOutput.Success("Scroll →",
            $"width={await scrollBoxRef.GetScrollWidth()}, height={await scrollBoxRef.GetScrollHeight()}, " +
            $"top={await scrollBoxRef.GetScrollTop()}, left={await scrollBoxRef.GetScrollLeft()}"));

    private Task GetTagName() => Run(metricsOutput, async () =>
        await metricsOutput.Success("GetTagName →", await targetRef.GetTagName()));

    // ─── Focus & pointer ──────────────────────────────────────────────────

    private Task BlurInput() => Run(pointerOutput, async () =>
    {
        await blurInputRef.Blur();
        await pointerOutput.Log("Blur() called on the input");
    });

    private Task SetPointerCapture() => Run(pointerOutput, async () =>
    {
        await targetRef.SetPointerCapture(pointerId);
        await pointerOutput.Log($"Pointer {pointerId} captured");
    });

    private Task HasPointerCapture() => Run(pointerOutput, async () =>
        await pointerOutput.Success($"HasPointerCapture({pointerId}) →", await targetRef.HasPointerCapture(pointerId)));

    private Task ReleasePointerCapture() => Run(pointerOutput, async () =>
    {
        await targetRef.ReleasePointerCapture(pointerId);
        await pointerOutput.Log($"Pointer {pointerId} capture released");
    });

    private Task RequestPointerLock() => Run(pointerOutput, async () =>
    {
        await targetRef.RequestPointerLock();
        await pointerOutput.Log("Pointer locked - press Escape to release");
    });

    // ─── Fullscreen ───────────────────────────────────────────────────────

    private Task RequestFullScreen() => Run(fullscreenOutput, async () =>
    {
        await fullscreenRef.RequestFullScreen(new FullScreenOptions { NavigationUI = FullScreenNavigationUI.Show });
        await fullscreenOutput.Log("Fullscreen requested - press Escape to exit");
    });

    // ─── Content & identity ───────────────────────────────────────────────

    private Task SetId() => Run(contentOutput, async () =>
    {
        await targetRef.SetId(idValue);
        await contentOutput.Log($"Id set to \"{idValue}\"");
    });

    private Task GetId() => Run(contentOutput, async () => await contentOutput.Success("GetId →", await targetRef.GetId()));

    private Task SetClassName() => Run(contentOutput, async () =>
    {
        await targetRef.SetClassName(className);
        await contentOutput.Log($"ClassName set to \"{className}\"");
    });

    private Task GetClassName() => Run(contentOutput, async () => await contentOutput.Success("GetClassName →", await targetRef.GetClassName()));

    private Task SetInnerText() => Run(contentOutput, async () =>
    {
        await targetRef.SetInnerText(innerText);
        await contentOutput.Log("InnerText set");
    });

    private Task GetInnerText() => Run(contentOutput, async () => await contentOutput.Success("GetInnerText →", await targetRef.GetInnerText()));

    private Task GetInnerHtml() => Run(contentOutput, async () => await contentOutput.Success("GetInnerHtml →", await targetRef.GetInnerHtml()));

    private Task GetOuterHtml() => Run(contentOutput, async () => await contentOutput.Success("GetOuterHtml →", await targetRef.GetOuterHtml()));

    private Task GetAccessKey() => Run(contentOutput, async () => await contentOutput.Success("GetAccessKey →", await targetRef.GetAccessKey()));

    private Task GetTabIndex() => Run(contentOutput, async () => await contentOutput.Success("GetTabIndex →", await targetRef.GetTabIndex()));

    // ─── Editing & modes ──────────────────────────────────────────────────

    private Task SetContentEditable() => Run(editingOutput, async () =>
    {
        await targetRef.SetContentEditable(contentEditable);
        await editingOutput.Log($"ContentEditable set to {contentEditable} - click the target and type");
    });

    private Task IsContentEditable() => Run(editingOutput, async () =>
        await editingOutput.Success("IsContentEditable →", await targetRef.IsContentEditable()));

    private Task SetDir() => Run(editingOutput, async () =>
    {
        await targetRef.SetDir(dir);
        await editingOutput.Log($"Dir set to {dir}");
    });

    private Task SetEnterKeyHint() => Run(editingOutput, async () =>
    {
        await targetRef.SetEnterKeyHint(enterKeyHint);
        await editingOutput.Log($"EnterKeyHint set to {enterKeyHint}");
    });

    private Task SetInputMode() => Run(editingOutput, async () =>
    {
        await targetRef.SetInputMode(inputMode);
        await editingOutput.Log($"InputMode set to {inputMode}");
    });

    private Task SetHidden() => Run(editingOutput, async () =>
    {
        await targetRef.SetHidden(hidden);
        await editingOutput.Log($"Hidden set to {hidden}");
    });

    private Task ToggleInert() => Run(editingOutput, async () =>
    {
        isInert = !isInert;
        await targetRef.SetInert(isInert);
        await editingOutput.Log($"Inert set to {isInert}");
    });

    private Task GetEditingState() => Run(editingOutput, async () =>
        await editingOutput.Success("State →",
            $"contentEditable={await targetRef.GetContentEditable()}, dir={await targetRef.GetDir()}, " +
            $"enterKeyHint={await targetRef.GetEnterKeyHint()}, inputMode={await targetRef.GetInputMode()}, " +
            $"hidden={await targetRef.GetHidden()}, inert={await targetRef.GetInert()}"));

    // ─── DOM events ───────────────────────────────────────────────────────

    private Task SubscribeClick() => Run(eventsOutput, async () =>
    {
        if (clickSub is not null)
        {
            await eventsOutput.Warn("Click listener is already attached");
            return;
        }

        clickSub = await eventsBoxRef.SubscribeEvent<ButilMouseEventArgs>(js, ButilEvents.Click,
            args => _ = eventsOutput.Log($"click → offset=({args.OffsetX:F0}, {args.OffsetY:F0}), ctrl={args.CtrlKey}, shift={args.ShiftKey}"));

        await eventsOutput.Log("Subscribed to click - now click the target box");
    });

    private Task SubscribeKeyDownOnce() => Run(eventsOutput, async () =>
    {
        if (keydownOnceSub is not null)
        {
            await eventsOutput.Warn("Keydown listener is already attached");
            return;
        }

        keydownOnceSub = await eventsInputRef.SubscribeEvent<ButilKeyboardEventArgs>(js, ButilEvents.KeyDown,
            args => _ = eventsOutput.Log($"keydown (once) → key={args.Key}, code={args.Code}"),
            new ButilEventListenerOptions { Once = true });

        await eventsOutput.Log("Subscribed to keydown with Once = true - type in the input");
    });

    private Task UnsubscribeEvents() => Run(eventsOutput, async () =>
    {
        if (clickSub is not null)
        {
            await clickSub.DisposeAsync();
            clickSub = null;
        }

        if (keydownOnceSub is not null)
        {
            await keydownOnceSub.DisposeAsync();
            keydownOnceSub = null;
        }

        await eventsOutput.Warn("Event subscriptions disposed");
    });

    // ─── Matches & Remove ─────────────────────────────────────────────────

    private Task Matches() => Run(selectorOutput, async () =>
        await selectorOutput.Success($"Matches(\"{selector}\") →", await targetRef.Matches(selector)));

    private Task RemoveElement() => Run(selectorOutput, async () =>
    {
        await targetRef.Remove();
        await selectorOutput.Warn("Target element removed from the DOM - reload the page to restore it");
    });

    private Task PlayMedia() => Run(mediaOutput, async () =>
    {
        var started = await mediaElement.Play();
        if (started)
        {
            await mediaOutput.Success("Play → playing.");
        }
        else
        {
            await mediaOutput.Warn("Play → refused. Autoplay is blocked outside a user gesture, and an undecodable source fails the same way.");
        }

        await ReadMediaState();
    });

    private Task PauseMedia() => Run(mediaOutput, async () =>
    {
        await mediaElement.Pause();
        await mediaOutput.Log("Pause → paused.");
        await ReadMediaState();
    });

    private Task ReadMediaState() => Run(mediaOutput, async () =>
    {
        mediaState = await mediaElement.GetMediaState();
        if (mediaState is null)
        {
            await mediaOutput.Warn("GetMediaState → null. The reference isn't a media element.");
            return;
        }

        await mediaOutput.Success($"GetMediaState → {(mediaState.Paused ? "paused" : "playing")} at {mediaState.CurrentTime:0.00}s.");
    });

    private Task SetRate(double rate) => Run(mediaOutput, async () =>
    {
        var ok = await mediaElement.SetPlaybackRate(rate);
        if (ok)
        {
            await mediaOutput.Log($"SetPlaybackRate → {rate}x.");
        }
        else
        {
            await mediaOutput.Warn($"SetPlaybackRate({rate}) → refused by the engine.");
        }

        await ReadMediaState();
    });

    private Task ToggleMute() => Run(mediaOutput, async () =>
    {
        var state = await mediaElement.GetMediaState();
        var muted = state?.Muted ?? false;
        await mediaElement.SetMuted(!muted);
        await mediaOutput.Log($"SetMuted → {!muted}.");
        await ReadMediaState();
    });

    private Task SeekTo(double seconds) => Run(mediaOutput, async () =>
    {
        var ok = await mediaElement.SetCurrentTime(seconds);
        if (ok)
        {
            await mediaOutput.Log($"SetCurrentTime → {seconds}s.");
        }
        else
        {
            await mediaOutput.Warn("SetCurrentTime → refused. The media isn't seekable yet - its metadata hasn't loaded.");
        }

        await ReadMediaState();
    });

    // A one-second 440 Hz tone, generated rather than shipped as a file, so the media sample above
    // has something real to play without adding an asset to the site.
    private static readonly string ToneDataUrl = BuildTone();

    private static string BuildTone()
    {
        const int sampleRate = 8000;
        const int samples = sampleRate * 3;
        var data = new byte[44 + samples];

        void WriteAscii(int offset, string text)
        {
            for (var i = 0; i < text.Length; i++) data[offset + i] = (byte)text[i];
        }

        void WriteInt32(int offset, int value) => BitConverter.GetBytes(value).CopyTo(data, offset);
        void WriteInt16(int offset, short value) => BitConverter.GetBytes(value).CopyTo(data, offset);

        WriteAscii(0, "RIFF");
        WriteInt32(4, 36 + samples);
        WriteAscii(8, "WAVEfmt ");
        WriteInt32(16, 16);          // PCM header size
        WriteInt16(20, 1);           // PCM
        WriteInt16(22, 1);           // mono
        WriteInt32(24, sampleRate);
        WriteInt32(28, sampleRate);  // byte rate for 8-bit mono
        WriteInt16(32, 1);           // block align
        WriteInt16(34, 8);           // bits per sample
        WriteAscii(36, "data");
        WriteInt32(40, samples);

        for (var i = 0; i < samples; i++)
        {
            var value = Math.Sin(2 * Math.PI * 440 * i / sampleRate);
            data[44 + i] = (byte)(128 + value * 30);   // quiet on purpose
        }

        return "data:audio/wav;base64," + Convert.ToBase64String(data);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (clickSub is not null) await clickSub.DisposeAsync();
            if (keydownOnceSub is not null) await keydownOnceSub.DisposeAsync();
        }
        catch
        {
            // best-effort cleanup during teardown
        }
    }
