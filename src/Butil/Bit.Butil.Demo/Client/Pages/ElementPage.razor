</DemoSection>

<DemoSection Title="DOM events"
             Api="SubscribeEvent"
             Description="Subscribe to any DOM event on the element with a strongly typed args class per event family - mouse, keyboard, pointer, touch, wheel, focus, input, drag, clipboard and composition. The generic argument must match the event: ButilEvents.Click pairs with ButilMouseEventArgs, ButilEvents.KeyDown with ButilKeyboardEventArgs, and so on. A second overload takes ButilEventListenerOptions for capture, passive and once semantics."
             Code=@("""
@inject IJSRuntime js

private ButilSubscription? clickSub;

clickSub = await box.SubscribeEvent<ButilMouseEventArgs>(
    js, ButilEvents.Click, args => Console.WriteLine(args.OffsetX));

// capture / passive / once via options:
await input.SubscribeEvent<ButilKeyboardEventArgs>(
    js, ButilEvents.KeyDown, args => Console.WriteLine(args.Key),
    new ButilEventListenerOptions { Once = true });

// element subscriptions must be disposed:
await clickSub.DisposeAsync();
""")>
    <div @ref="eventsBoxRef"
         style="padding:0.8rem 1rem;border:1px dashed #6366f1;border-radius:8px;max-width:20rem;">
        Click target - subscribe below, then click me.
    </div>
    <div class="field">
        <span class="field-label">Keydown target (the once listener fires a single time)</span>
        <input @ref="eventsInputRef" placeholder="type here after subscribing..." style="max-width:20rem;" />
    </div>
    <div class="controls">
        <button @onclick="SubscribeClick">Subscribe click</button>
        <button @onclick="SubscribeKeyDownOnce">Subscribe keydown (once)</button>
        <button class="danger" @onclick="UnsubscribeEvents">Dispose subscriptions</button>
    </div>
    <DemoConsole @ref="eventsOutput" Title="DOM events output" />
</DemoSection>

<DemoSection Title="Selector matching and removal"
             Api="Matches / Remove"
             Description="Matches tests the element against any CSS selector. Remove detaches the element from the DOM - reload the page to bring the demo target back."
             Code=@("""
var isMatch = await box.Matches("[data-demo]");

await box.Remove(); // detaches the element from the DOM
""")>
    <div class="field">
        <span class="field-label">CSS selector</span>
        <input @bind-value="selector" style="max-width:20rem;" />
    </div>
    <div class="controls">
        <button @onclick="Matches">Matches</button>
        <button class="danger" @onclick="RemoveElement">Remove target element</button>
    </div>
    <DemoConsole @ref="selectorOutput" Title="selector output" />
</DemoSection>

<DemoSection Title="Audio and video"
             Api="Play / Pause / GetMediaState / SetCurrentTime / SetVolume / SetMuted / SetPlaybackRate"
             Description="Blazor can render a media element and bind its events, but playback is imperative: there is no markup for 'play now' or 'seek to 30 seconds'. These extensions fill that gap on any ElementReference pointing at an <audio> or <video>. GetMediaState reads the whole transport state in one round trip rather than a property at a time - every read is an interop hop, and polling a dozen of them per frame to draw a scrubber is a dozen messages per frame."
             Code=@("""
<video @ref="_video" src="clip.webm" playsinline></video>

// starting playback can be refused - autoplay outside a gesture, or an undecodable source:
var started = await _video.Play();

await _video.SetVolume(0.4);       // clamped to 0-1; ignored on iOS, where volume is hardware
await _video.SetMuted(true);       // the mute toggle that works everywhere
await _video.SetPlaybackRate(1.5);
await _video.SetCurrentTime(30);   // false when the media isn't seekable yet

var state = await _video.GetMediaState();
// state.Paused / CurrentTime / Duration / BufferedEnd / ReadyState / VideoWidth ...

await _video.Pause();
""")>
    @* A short generated tone rather than a shipped asset, so the sample has something to play. *@
    <audio @ref="mediaElement" src="@ToneDataUrl" controls style="margin-top:0.5rem;width:100%"></audio>
    <div class="controls">
        <button @onclick="PlayMedia">Play</button>
        <button class="secondary" @onclick="PauseMedia">Pause</button>
        <button class="secondary" @onclick="ReadMediaState">GetMediaState</button>
    </div>
    <div class="controls">
        <button class="secondary" @onclick="() => SetRate(0.5)">0.5x</button>
        <button class="secondary" @onclick="() => SetRate(1)">1x</button>
        <button class="secondary" @onclick="() => SetRate(2)">2x</button>
        <button class="secondary" @onclick="ToggleMute">Toggle mute</button>
        <button class="secondary" @onclick="() => SeekTo(0)">Back to start</button>
    </div>
    @if (mediaState is not null)
    {
        <div class="field">
            <span class="field-label">State</span>
            <span>
                @(mediaState.Paused ? "paused" : "playing") at
                @mediaState.CurrentTime.ToString("0.00")s of @mediaState.Duration.ToString("0.00")s,
                rate @mediaState.PlaybackRate.ToString("0.##")x,
                @(mediaState.Muted ? "muted" : $"volume {mediaState.Volume:0.##}"),
                readyState @mediaState.ReadyState
            </span>
        </div>
    }
    <DemoConsole @ref="mediaOutput" Title="media output" />
</DemoSection>
</div>

<Callout Type="warning" Title="Dispose element event subscriptions">
    <code>SubscribeEvent</code> has no owning service to clean up after you: every subscription holds a
    .NET object reference and a JS-side handler until its <code>ButilSubscription</code> is disposed.
    Store the handle and dispose it in <code>DisposeAsync</code>, exactly as this page does.
</Callout>

