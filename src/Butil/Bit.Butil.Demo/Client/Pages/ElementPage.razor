    </div>
    <div class="controls">
        <button @onclick="RequestFullScreen">RequestFullScreen</button>
    </div>
    <DemoConsole @ref="fullscreenOutput" Title="fullscreen output" />
</DemoSection>

<DemoSection Title="Content and identity"
             Api="Id / ClassName / InnerHtml / OuterHtml / InnerText / AccessKey / TabIndex"
             Description="Get and set the element's id, class list, rendered text, raw markup, access key and tab order position. The InnerHtml and OuterHtml setters write markup verbatim - never feed them untrusted input."
             Code=@("""
await box.SetId("hero");
await box.SetClassName("card highlighted");
await box.SetInnerText("Hello from C#");
await box.SetTabIndex(2);
await box.SetAccessKey("k");

var html = await box.GetInnerHtml();
await box.SetInnerHtml("<strong>Trusted markup only!</strong>");
var outer = await box.GetOuterHtml();
""")>
