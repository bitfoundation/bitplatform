    private Task SetShadowAndTimingHints() => Run(identityOutput, async () =>
    {
        // Slot and part only mean something inside a shadow tree, and elementtiming only to a
        // PerformanceObserver - writing them on a plain demo box is still the round trip that shows
        // what each wrapper does with its value.
        await targetRef.SetSlot("content");
        await targetRef.SetPart("surface highlight");
        await targetRef.SetElementTiming("butil-demo-box");
        await identityOutput.Success("SetSlot / SetPart / SetElementTiming →", "content", "surface highlight", "butil-demo-box");
    });

    private Task ReadShadowAndTimingHints() => Run(identityOutput, async () =>
        await identityOutput.Success("Slot / Part / ElementTiming / AssignedSlotName / AccessKeyLabel / Autofocus / Autocorrect / OuterText →",
            await targetRef.GetSlot(),
            string.Join(' ', await targetRef.GetPart()),
            await targetRef.GetElementTiming(),
            // Null outside a shadow tree, which is what this box is - the wrapper reports that
            // rather than inventing a slot name.
            await targetRef.GetAssignedSlotName() ?? "(unassigned)",
            await targetRef.GetAccessKeyLabel(),
            await targetRef.GetAutofocus(),
            await targetRef.GetAutocorrect(),
            await targetRef.GetOuterText()));

    private async Task CheckMoveBefore()
    {
        try
        {
            var supported = await moveLeft.IsMoveBeforeSupported();
            if (supported) await moveOutput.Success("IsMoveBeforeSupported →", true);
            else await moveOutput.Warn("IsMoveBeforeSupported →", "false - moving would have to go through insertBefore, which tears the node down.");
        }
        catch (Exception ex)
        {
            await moveOutput.Error("IsMoveBeforeSupported failed →", ex.Message);
        }
    }

    private async Task MoveTheFrame()
    {
        try
        {
            var target = frameOnLeft ? moveRight : moveLeft;
            var moved = await target.MoveBefore(movedFrame);

            if (moved)
            {
                // The browser moved the element; Blazor's render tree is untouched, which is exactly
                // why the markup above must not re-render around it.
                frameOnLeft = !frameOnLeft;
                await moveOutput.Success("MoveBefore →", "moved. The iframe kept its document rather than reloading.");
            }
            else
            {
                await moveOutput.Warn("MoveBefore →", "false - no moveBefore here, or the move was rejected.");
            }
        }
        catch (Exception ex)
        {
            await moveOutput.Error("MoveBefore failed →", ex.Message);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (clickSub is not null) await clickSub.DisposeAsync();
            if (keydownOnceSub is not null) await keydownOnceSub.DisposeAsync();
        }
        catch
        {
            // best-effort cleanup during teardown
        }
    }
