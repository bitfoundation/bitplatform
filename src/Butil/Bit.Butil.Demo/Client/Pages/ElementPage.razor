@page "/element"
@implements IAsyncDisposable
@inject IJSRuntime js

<PageTitle>Element - Bit.Butil</PageTitle>

<PageHeader Category="DOM & Interaction"
            Title="Element"
            Lead="Every Element and HTMLElement API as C# extension methods on Blazor's own ElementReference - no service to inject, no ids to invent. Capture a reference and call attributes, scrolling, layout metrics, pointer capture, fullscreen and DOM events straight from C#."
            MdnUrl="https://developer.mozilla.org/en-US/docs/Web/API/Element" />

<Callout Type="info" Title="Extension methods, not a service">
    Unlike most Butil APIs there is no <code>Element</code> class to inject. Capture any rendered element
    with <code>@@ref</code> and the extension methods light up on the <code>ElementReference</code> itself.
    Only the event subscription and observer extensions additionally need an <code>IJSRuntime</code> argument.
</Callout>

<div class="stack">
<DemoSection Title="Attributes"
             Api="GetAttribute / SetAttribute / HasAttribute / ToggleAttribute / RemoveAttribute / GetAttributeNames"
             Description="Read, write, toggle and enumerate the attributes of the target element. ToggleAttribute is handy for boolean attributes such as hidden or disabled; pass force to pin the state instead of flipping it."
             Code=@("""
<div @ref="box" data-demo="butil">...</div>

@code {
    private ElementReference box;

    private async Task InspectAttributes()
    {
        var has = await box.HasAttribute("data-demo");
        var value = await box.GetAttribute("data-demo");
        var names = await box.GetAttributeNames();

        await box.SetAttribute("data-demo", "updated");
        await box.ToggleAttribute("hidden", force: null);
        await box.RemoveAttribute("data-demo");
    }
}
""")
             Language="razor">
    <div @ref="targetRef" @onpointerdown="CapturePointerId" data-demo="butil"
         style="padding:0.8rem 1rem;border:2px solid #6366f1;border-radius:8px;max-width:20rem;">
        I am the target element - click me to record a pointer id.
    </div>
    <div class="field-row">
        <div class="field">
            <span class="field-label">Attribute name</span>
            <input @bind-value="attributeName" />
        </div>
        <div class="field">
            <span class="field-label">Attribute value</span>
            <input @bind-value="attributeValue" />
        </div>
    </div>
    <div class="controls">
        <button @onclick="GetAttribute">GetAttribute</button>
        <button @onclick="SetAttribute">SetAttribute</button>
        <button class="secondary" @onclick="HasAttribute">HasAttribute</button>
        <button class="secondary" @onclick="HasAttributes">HasAttributes</button>
        <button class="secondary" @onclick="GetAttributeNames">GetAttributeNames</button>
        <button class="secondary" @onclick="ToggleAttribute">ToggleAttribute</button>
        <button class="danger" @onclick="RemoveAttribute">RemoveAttribute</button>
    </div>
    <DemoConsole @ref="attributesOutput" Title="attributes output" />
</DemoSection>

<DemoSection Title="Scrolling"
             Api="Scroll / ScrollBy / ScrollIntoView"
             Description="Scroll inside an element to absolute coordinates, scroll by a relative amount, or bring the element itself into the viewport. All three accept an options object with smooth, instant or auto behavior; ScrollIntoView additionally takes block and inline logical positions."
             Code=@("""
await box.Scroll(new ScrollOptions { Top = 120, Behavior = ScrollBehavior.Smooth });

await box.ScrollBy(0, 48);

await box.ScrollIntoView(new ScrollIntoViewOptions
{
    Behavior = ScrollBehavior.Smooth,
    Block = ScrollLogicalPosition.Center,
    Inline = ScrollLogicalPosition.Nearest,
});
""")>
    <div @ref="scrollBoxRef"
         style="height:8rem;max-width:20rem;overflow:auto;border:1px dashed #6366f1;border-radius:8px;padding:0.6rem;">
        <div style="height:40rem;">
            This box is 40rem tall on the inside - use the buttons below to scroll it from C#.
        </div>
    </div>
    <div class="controls">
        <button @onclick="ScrollToTop">Scroll(top: 0)</button>
        <button @onclick="ScrollToBottom">Scroll(top: 9999)</button>
        <button class="secondary" @onclick="ScrollByAmount">ScrollBy(+48px)</button>
        <button class="secondary" @onclick="ScrollIntoView">ScrollIntoView (center)</button>
    </div>
    <DemoConsole @ref="scrollingOutput" Title="scrolling output" />
</DemoSection>

<DemoSection Title="Layout metrics"
             Api="GetBoundingClientRect / Client* / Offset* / Scroll* / GetTagName"
             Description="Read the element's box-model geometry: the viewport-relative bounding rect, client sizes (padding box), offset sizes (border box and position within the offset parent), scroll sizes and offsets, and the tag name."
             Code=@("""
var rect = await box.GetBoundingClientRect(); // Rect { X, Y, Width, Height }

var clientWidth = await box.GetClientWidth();
var offsetHeight = await box.GetOffsetHeight();
var scrollHeight = await box.GetScrollHeight();
var scrollTop = await box.GetScrollTop();
var tagName = await box.GetTagName();
""")>
    <div class="controls">
        <button @onclick="GetBoundingClientRect">GetBoundingClientRect</button>
        <button class="secondary" @onclick="GetClientMetrics">Client W/H/T/L</button>
        <button class="secondary" @onclick="GetOffsetMetrics">Offset W/H/T/L</button>
        <button class="secondary" @onclick="GetScrollMetrics">Scroll W/H/T/L</button>
        <button class="secondary" @onclick="GetTagName">GetTagName</button>
    </div>
    <DemoConsole @ref="metricsOutput" Title="layout metrics output" />
</DemoSection>

<DemoSection Title="Focus and pointer capture"
             Api="Blur / SetPointerCapture / HasPointerCapture / ReleasePointerCapture / RequestPointerLock"
             Description="Blur removes keyboard focus from an element (for setting focus, Blazor's built-in ElementReference.FocusAsync already covers it). Pointer capture routes all subsequent pointer events to one element - the building block for custom drag interactions. RequestPointerLock hides the cursor and streams raw movement deltas, as games do."
             Code=@("""
await input.Blur();

await box.SetPointerCapture(pointerId);
var captured = await box.HasPointerCapture(pointerId);
await box.ReleasePointerCapture(pointerId);

await box.RequestPointerLock();
""")>
    <div class="field">
        <span class="field-label">Focus this input, then press the Blur button</span>
        <input @ref="blurInputRef" placeholder="focus me..." style="max-width:20rem;" />
    </div>
    <p class="section-desc">
        Pointer id: <span class="kbd">@(pointerId == 0 ? "click the target element above first" : pointerId.ToString())</span>
    </p>
    <div class="controls">
        <button @onclick="BlurInput">Blur</button>
        <button class="secondary" @onclick="SetPointerCapture" disabled="@(pointerId == 0)">SetPointerCapture</button>
        <button class="secondary" @onclick="HasPointerCapture" disabled="@(pointerId == 0)">HasPointerCapture</button>
        <button class="secondary" @onclick="ReleasePointerCapture" disabled="@(pointerId == 0)">ReleasePointerCapture</button>
        <button class="danger" @onclick="RequestPointerLock">RequestPointerLock</button>
    </div>
    <DemoConsole @ref="pointerOutput" Title="focus and pointer output" />
</DemoSection>

<DemoSection Title="Fullscreen"
             Api="RequestFullScreen"
             Description="Ask the browser to present the element fullscreen. The options object controls whether the browser keeps its navigation UI visible; press Escape to leave fullscreen again. Browsers only honor the request from a user gesture such as a click."
             Code=@("""
await box.RequestFullScreen(new FullScreenOptions
{
    NavigationUI = FullScreenNavigationUI.Show,
});
""")>
    <div @ref="fullscreenRef"
         style="padding:1rem;border:1px solid #6366f1;border-radius:8px;max-width:20rem;background:#1e1b4b;color:#e0e7ff;">
        This panel goes fullscreen.
    </div>
    <div class="controls">
        <button @onclick="RequestFullScreen">RequestFullScreen</button>
    </div>
    <DemoConsole @ref="fullscreenOutput" Title="fullscreen output" />
</DemoSection>

<DemoSection Title="Content and identity"
             Api="Id / ClassName / InnerHtml / OuterHtml / InnerText / AccessKey / TabIndex"
             Description="Get and set the element's id, class list, rendered text, raw markup, access key and tab order position. The InnerHtml and OuterHtml setters write markup verbatim - never feed them untrusted input."
             Code=@("""
await box.SetId("hero");
await box.SetClassName("card highlighted");
await box.SetInnerText("Hello from C#");
await box.SetTabIndex(2);
await box.SetAccessKey("k");

var html = await box.GetInnerHtml();
await box.SetInnerHtml("<strong>Trusted markup only!</strong>");
var outer = await box.GetOuterHtml();
""")>
    <div class="field-row">
        <div class="field">
            <span class="field-label">Id</span>
            <input @bind-value="idValue" />
        </div>
        <div class="field">
            <span class="field-label">ClassName</span>
            <input @bind-value="className" />
        </div>
        <div class="field">
            <span class="field-label">InnerText</span>
            <input @bind-value="innerText" />
        </div>
    </div>
    <div class="controls">
        <button @onclick="SetId">SetId</button>
        <button @onclick="SetClassName">SetClassName</button>
        <button @onclick="SetInnerText">SetInnerText</button>
        <button class="secondary" @onclick="GetId">GetId</button>
        <button class="secondary" @onclick="GetClassName">GetClassName</button>
        <button class="secondary" @onclick="GetInnerText">GetInnerText</button>
        <button class="secondary" @onclick="GetInnerHtml">GetInnerHtml</button>
        <button class="secondary" @onclick="GetOuterHtml">GetOuterHtml</button>
        <button class="secondary" @onclick="GetAccessKey">GetAccessKey</button>
        <button class="secondary" @onclick="GetTabIndex">GetTabIndex</button>
    </div>
    <DemoConsole @ref="contentOutput" Title="content and identity output" />
</DemoSection>

<DemoSection Title="Editing and interaction modes"
             Api="ContentEditable / IsContentEditable / Dir / EnterKeyHint / InputMode / Hidden / Inert"
             Description="Toggle in-place editing, text direction, virtual-keyboard hints, visibility and inertness on the target element. After setting ContentEditable to True, click into the target element above and type."
             Code=@("""
await box.SetContentEditable(ContentEditable.True);
var editable = await box.IsContentEditable();

await box.SetDir(ElementDir.Rtl);
await box.SetEnterKeyHint(EnterKeyHint.Send);
await box.SetInputMode(InputMode.Numeric);
await box.SetHidden(Hidden.UntilFound);
await box.SetInert(true);
""")>
    <div class="field-row">
        <div class="field">
            <span class="field-label">ContentEditable</span>
            <select @bind="contentEditable">
                @foreach (ContentEditable option in Enum.GetValues<ContentEditable>())
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="field">
            <span class="field-label">Dir</span>
            <select @bind="dir">
                @foreach (ElementDir option in Enum.GetValues<ElementDir>())
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="field">
            <span class="field-label">EnterKeyHint</span>
            <select @bind="enterKeyHint">
                @foreach (EnterKeyHint option in Enum.GetValues<EnterKeyHint>())
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="field">
            <span class="field-label">InputMode</span>
            <select @bind="inputMode">
                @foreach (InputMode option in Enum.GetValues<InputMode>())
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="field">
            <span class="field-label">Hidden</span>
            <select @bind="hidden">
                @foreach (Hidden option in Enum.GetValues<Hidden>())
                {
                    <option value="@option">@option</option>
