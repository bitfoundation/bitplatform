    </div>
    <div class="controls">
        <button @onclick="SetContentEditable">SetContentEditable</button>
        <button @onclick="SetDir">SetDir</button>
        <button @onclick="SetEnterKeyHint">SetEnterKeyHint</button>
        <button @onclick="SetInputMode">SetInputMode</button>
        <button @onclick="SetHidden">SetHidden</button>
        <button class="secondary" @onclick="IsContentEditable">IsContentEditable</button>
        <button class="secondary" @onclick="GetEditingState">Read all back</button>
        <button class="secondary" @onclick="ToggleInert">Toggle Inert (now: @isInert)</button>
    </div>
