    private static string FormatBytes(long? bytes)
        => bytes is null ? "n/a" : $"{bytes / 1024d / 1024d:F1} MB";

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (observerSub is not null)
            {
                await observerSub.DisposeAsync();
                observerSub = null;
            }

            foreach (var sub in typedSubs)
            {
                await sub.DisposeAsync();
            }
            typedSubs.Clear();
        }
        catch
        {
            // best-effort cleanup during teardown
        }
    }
}
