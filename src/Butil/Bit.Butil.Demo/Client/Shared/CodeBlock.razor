@inject Bit.Butil.Clipboard clipboard

@* The BlazorUI demo's code pane: the source on the secondary surface, with a round copy button
   resting on it that confirms by growing into its label instead of snapping open. The language is
   kept as a data attribute rather than a header strip - there is no highlighter on this site to
   act on it, and a bar that only repeats "csharp" is a row of chrome per snippet. *@

<div class="code-holder">
    @* aria-live so the outcome is announced: the button confirms by swapping its own content, and
       a state change inside the control that was just activated is otherwise silent. The label
       tracks the same three states, so it never contradicts what the button now reads. *@
    <button class="copy-btn @(_failed ? "failed" : _copied ? "copied" : "")"
            title="Copy to clipboard" aria-live="polite"
            aria-label="@(_failed ? "Copy failed" : _copied ? "Copied to clipboard" : "Copy code to clipboard")"
            @onclick="Copy">
        @if (_failed)
        {
            <span>Copy failed</span>
        }
        else if (_copied)
        {
            <span>Copied!</span>
        }
        else
        {
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" aria-hidden="true" focusable="false">
                <rect x="9" y="9" width="11" height="11" rx="1.5" />
                <path d="M15 5.5A1.5 1.5 0 0 0 13.5 4h-8A1.5 1.5 0 0 0 4 5.5v8A1.5 1.5 0 0 0 5.5 15" />
            </svg>
        }
    </button>
    <pre data-language="@Language"><code>@Code.Trim('\r', '\n')</code></pre>
</div>

@code {
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public string Language { get; set; } = "csharp";

    private bool _copied;
    private bool _failed;

    private async Task Copy()
    {
        try
        {
            await clipboard.WriteText(Code.Trim('\r', '\n'));
        }
        catch (JSException)
        {
            // no clipboard permission, or an insecure context - not worth tearing the page down over
            _failed = true;
            StateHasChanged();
            await Task.Delay(1500);
            _failed = false;
            return;
        }

        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }
}
