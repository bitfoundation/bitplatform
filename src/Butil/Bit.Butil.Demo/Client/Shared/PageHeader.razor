@inject NavigationManager navManager

@* A page opens the way every Fluent 2 detail page does: the trail that says where in the taxonomy
   this is, the title, then the lead as prose on the bare page rather than inside one more frame. *@

@* The lead is already a one-paragraph summary of the page written for a human, which is exactly
   what a description meta wants - so it is also emitted into the head rather than having every
   page maintain a second copy of its own summary. The host page deliberately carries no static
   description for the same reason it carries no static title: with prerendering the HeadOutlet
   emits a real element, and an earlier one in the served HTML would win.

   The Open Graph and canonical tags come from the same two strings. Every page on this site is
   prerendered, so a crawler or a chat client unfurling a link gets these in the served HTML
   without running the WebAssembly runtime - which is the only reason emitting them here works. *@
<HeadContent>
    <link rel="canonical" href="@CanonicalUrl" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Bit.Butil" />
    <meta property="og:title" content="@Title" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@Title" />
    @if (string.IsNullOrWhiteSpace(Lead) is false)
    {
        <meta name="description" content="@Lead" />
        <meta property="og:description" content="@Lead" />
        <meta name="twitter:description" content="@Lead" />
    }
</HeadContent>

<header class="page-header">
    @* A trail rather than a bare overline: the area is where this page sits, and on a site with
       eleven of them that is worth being a link back to the catalogue rather than a label. *@
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="">Docs</a>
        <span class="breadcrumb-sep" aria-hidden="true">
            <Icon Name="chevron-right" Size="12" />
        </span>
        <span class="eyebrow">@Category</span>
    </nav>

    <h1>@Title</h1>

    @if (string.IsNullOrWhiteSpace(Lead) is false)
    {
        <p class="page-lead">@Lead</p>
    }

    @if (string.IsNullOrWhiteSpace(InjectAs) is false || string.IsNullOrWhiteSpace(MdnUrl) is false)
    {
        <div class="page-header-links">
            @if (string.IsNullOrWhiteSpace(InjectAs) is false)
            {
                <code class="inject-chip">@("@inject") Bit.Butil.@InjectAs</code>
            }
            @if (string.IsNullOrWhiteSpace(MdnUrl) is false)
            {
                <a class="mdn-link" href="@MdnUrl" target="_blank" rel="noopener noreferrer">
                    <span>MDN reference</span>
                    <Icon Name="open" Size="14" />
                </a>
            }
        </div>
    }
</header>

@code {
    // The query and the fragment are navigation state, not identity - two urls that differ only
    // by "#play-pause" are the same document, and a canonical that says otherwise splits the page
    // in a crawler's index.
    private string CanonicalUrl
    {
        get
        {
            var uri = new Uri(navManager.Uri);
            return $"{uri.GetLeftPart(UriPartial.Path)}";
        }
    }

    [Parameter] public string Category { get; set; } = "Bit.Butil";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Lead { get; set; }
    [Parameter] public string? MdnUrl { get; set; }

    /// <summary>The class name to show in the "@inject Bit.Butil.X" chip, e.g. "Clipboard clipboard".</summary>
    [Parameter] public string? InjectAs { get; set; }
}
