<div class="tdata-row" role="row">
    <div class="td-cell" role="cell">@Name</div>
    <div class="td-cell" role="cell"><code>@Signature</code></div>
    <div class="td-cell" role="cell">@Description</div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Signature { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
}
