@inject NavigationManager navManager

<!DOCTYPE html>
<html lang="en">

<head>
    <base href="/" />
    <meta charset="utf-8" />
    @* No static <title> here: every page supplies its own through <PageTitle>, and with
       prerendering the HeadOutlet emits a real <title> element into this head. A second,
       earlier one would win in the served HTML (browsers and crawlers take the first). *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* No static description here either, for the same reason as the title above: every page emits
       its own through PageHeader's lead, and an earlier one in the served HTML would win. *@
    <link rel="icon" href="favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="icon-512.png" />
    @* Titles and descriptions are per-page and come from the HeadOutlet below; the card image is
       the same for every page, so it is stated once here rather than repeated 91 times. A page
       that emits its own og:image would simply win, since these come first.
       Absolute, not relative: unfurlers fetch the image out of band and have no document to
       resolve a relative path against. *@
    <meta property="og:image" content="@($"{navManager.BaseUri}icon-512.png")" />
    <meta name="twitter:image" content="@($"{navManager.BaseUri}icon-512.png")" />
    @* Tints the browser's own chrome on mobile. Two of them, so the bar matches whichever theme
       the visitor's OS is set to rather than always the dark one. *@
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#292929" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="stylesheet" href="css/app.css" />
    @* Same render mode as the app itself, so <PageTitle> keeps working after hydration. *@
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    @* Prerendered on the server, then hydrated by the WebAssembly runtime. Pages only touch
       the browser from OnAfterRenderAsync and event handlers, which never run during the
       prerender pass - see Layout/MainLayout.razor for the RendererInfo-driven hydration hint. *@
    <Routes @rendermode="InteractiveWebAssembly" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>

    @* Loaded before the Blazor script so window.BitButil exists by the time the app boots. *@
    <script src="_content/Bit.Butil/bit-butil.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
