@page "/wake-lock"
@implements IAsyncDisposable
@inject Bit.Butil.WakeLock wakeLock

<PageTitle>WakeLock - Bit.Butil</PageTitle>

<PageHeader Category="Device & Hardware"
            Title="WakeLock"
            Lead="Keep the screen from dimming or locking while your app is doing something the user is watching - presentations, dashboards, recipe steps - via the Screen Wake Lock API."
            MdnUrl="https://developer.mozilla.org/en-US/docs/Web/API/Screen_Wake_Lock_API"
            InjectAs="WakeLock wakeLock" />

<Callout Type="info" Title="Secure context, and the browser has the last word">
    The Screen Wake Lock API requires a secure context (HTTPS or localhost). The browser
    automatically releases the lock whenever the page is hidden (tab switch, minimize, screen
    off) and may refuse a request outright - for example in battery-saver mode. Treat the
    boolean result of <code>Request</code> as a hint, not a guarantee.
</Callout>

<div class="stack">
    <DemoSection Title="Support check"
                 Api="IsSupported"
                 Description="Returns true when the runtime exposes navigator.wakeLock. During prerender/SSR the check returns false rather than throwing, so defer it to OnAfterRenderAsync."
                 Code=@("""
@inject Bit.Butil.WakeLock wakeLock

var supported = await wakeLock.IsSupported();
""")>
        <div class="controls">
            <button @onclick="CheckSupported">IsSupported</button>
        </div>
        <DemoConsole @ref="supportOutput" Title="support check output" />
    </DemoSection>

    <DemoSection Title="Request and release"
                 Api="Request / Release"
                 Description="Request acquires a screen wake lock and returns true on success. Release drops the most recently acquired lock; it is a no-op when nothing is held, so it's always safe to call from cleanup code."
                 Code=@("""
var acquired = await wakeLock.Request();
if (acquired)
{
    // screen stays awake while the page is visible
}

// later:
await wakeLock.Release();
""")>
        <div class="controls">
            <button @onclick="Acquire">Request</button>
            <button class="secondary" @onclick="ReleaseLock">Release</button>
        </div>
        <div class="field">
            <span class="field-label">Status</span>
            <span>@_status</span>
        </div>
        <DemoConsole @ref="requestOutput" Title="request / release output" />
    </DemoSection>

    <DemoSection Title="Persistent lock"
                 Api="RequestPersistent"
                 Description="Browsers always release the wake lock when the page is hidden. RequestPersistent acquires a lock and re-acquires it automatically every time the page becomes visible again - dispose the returned handle to stop the auto-reacquire and release the lock."
                 Code=@("""
private IAsyncDisposable? _persistent;

_persistent = await wakeLock.RequestPersistent();

// screen stays awake across tab switches - the lock is restored on resume

// stop and release:
await _persistent.DisposeAsync();
""")>
        <div class="controls">
            <button @onclick="AcquirePersistent">RequestPersistent</button>
            <button class="danger" @onclick="ReleasePersistent">Dispose persistent lock</button>
        </div>
        <div class="field">
            <span class="field-label">Persistent lock</span>
            <span>@(_persistent is null ? "Inactive" : "Active - auto re-acquired on visibility change")</span>
        </div>
        <DemoConsole @ref="persistentOutput" Title="persistent lock output" />
    </DemoSection>
</div>

<ApiTable Title="API reference">
    <ApiMember Name="IsSupported"
               Signature="ValueTask<bool> IsSupported()"
               Description="True when the runtime exposes navigator.wakeLock. Returns default (false) during prerender/SSR instead of throwing." />
    <ApiMember Name="Request"
               Signature="ValueTask<bool> Request()"
               Description="Requests a screen wake lock; returns true when acquired. The lock is released explicitly or when the user-agent decides (typically when the page is hidden)." />
    <ApiMember Name="Release"
               Signature="ValueTask Release()"
               Description="Releases the most recently acquired lock if it is still active. No-op otherwise." />
    <ApiMember Name="RequestPersistent"
               Signature="ValueTask<IAsyncDisposable> RequestPersistent()"
               Description="Acquires a wake lock and re-acquires it whenever the page becomes visible again. Dispose the handle to stop the auto-reacquire and release the lock." />
    <ApiMember Name="DisposeAsync"
               Signature="ValueTask DisposeAsync()"
               Description="Releases any held lock. Called automatically on scope/circuit teardown." />
</ApiTable>

@code {
    private DemoConsole supportOutput = default!;
    private DemoConsole requestOutput = default!;
    private DemoConsole persistentOutput = default!;
    private string _status = "No lock requested yet.";
    private IAsyncDisposable? _persistent;

    private async Task CheckSupported()
    {
        try
        {
            await supportOutput.Success("IsSupported →", await wakeLock.IsSupported());
        }
        catch (Exception ex)
        {
            await supportOutput.Error("IsSupported failed →", ex.Message);
        }
    }

    private async Task Acquire()
    {
        try
        {
            if (!await wakeLock.IsSupported())
            {
                _status = "Not supported in this browser.";
                await requestOutput.Warn("Wake lock is not supported in this browser.");
                return;
            }

            var acquired = await wakeLock.Request();
            _status = acquired ? "Lock active - screen stays awake." : "Request refused by the browser.";
            if (acquired)
            {
                await requestOutput.Success("Request →", "wake lock acquired.");
            }
            else
            {
                await requestOutput.Warn("Request →", "wake lock refused (battery saver, hidden page, ...).");
            }
        }
        catch (Exception ex)
        {
            _status = "Request failed.";
            await requestOutput.Error("Request failed →", ex.Message);
        }
    }

    private async Task ReleaseLock()
    {
        try
        {
            await wakeLock.Release();
            _status = "Lock released.";
            await requestOutput.Log("Release →", "wake lock released.");
        }
        catch (Exception ex)
        {
            await requestOutput.Error("Release failed →", ex.Message);
        }
    }

    private async Task AcquirePersistent()
    {
        try
        {
            if (!await wakeLock.IsSupported())
            {
                await persistentOutput.Warn("Wake lock is not supported in this browser.");
                return;
            }

            if (_persistent is not null)
            {
                await _persistent.DisposeAsync();
            }

            _persistent = await wakeLock.RequestPersistent();
            await persistentOutput.Success("RequestPersistent →", "persistent lock started (auto re-acquire on visibility).");
        }
        catch (Exception ex)
        {
            await persistentOutput.Error("RequestPersistent failed →", ex.Message);
        }
    }

    private async Task ReleasePersistent()
    {
        if (_persistent is null)
        {
            await persistentOutput.Warn("No persistent lock is active.");
            return;
        }

        await _persistent.DisposeAsync();
        _persistent = null;
        await persistentOutput.Log("Persistent lock disposed.");
    }

    public async ValueTask DisposeAsync()
    {
        if (_persistent is not null)
        {
            await _persistent.DisposeAsync();
            _persistent = null;
        }

        try
        {
            await wakeLock.Release();
        }
        catch (Exception)
        {
            // teardown - the circuit/runtime may already be gone
        }
    }
}
