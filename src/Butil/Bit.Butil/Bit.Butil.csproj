<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <IsTrimmable>true</IsTrimmable>
        <!-- NU5100: tasks/Bit.Butil.Build.dll is an MSBuild task, meant to be loaded by the targets rather than referenced. -->
        <NoWarn>$(NoWarn);NU5100</NoWarn>
        <!-- Opt back in to CS1591 (missing XML comment), which Bit.Build.props suppresses repo-wide. The XML
             documentation on this assembly is not decoration: it is what IntelliSense and the demo's MCP server
             hand out as the API reference, so an undocumented public member ships a blank entry to both. The
             surface is fully documented today, and this keeps the compiler saying so. -->
        <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="tsconfig.json;build.mjs" />
        <None Include="tsconfig.json;build.mjs" />
        <!-- The same two targets files under buildTransitive/ (what NuGet imports for direct and transitive
             references alike) and build/ (older tooling that only looks there). -->
        <None Include="buildTransitive\Bit.Butil.targets;buildTransitive\Bit.Butil.Endpoints.targets" Pack="true" PackagePath="buildTransitive\;build\" />
    </ItemGroup>

    <!-- The publish-time bundler (an MSBuild task) ships inside this package under tasks/. Built here as a
         plain build-order dependency; nothing from it is referenced by Bit.Butil.dll itself. -->
    <ItemGroup>
        <ProjectReference Include="..\Bit.Butil.Build\Bit.Butil.Build.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <!-- What the package carries besides the library and its static web assets:
           buildTransitive/*.targets (+ build/)         consumer-side logic (script loading mode, publish-time trimming)
           buildTransitive/chunks/*.js + manifest.txt   the per-module chunks the trimmed bundle is assembled from
           tasks/Bit.Butil.Build.dll                    the MSBuild task that does the assembling
         Added from a target rather than static items: the chunks are generated during the build (they do not
         exist when the project is evaluated on a clean checkout), and the task's output path is asked from its
         project instead of being hard-coded. Once, from the first target framework, so a multi-targeted pack
         does not add the same files three times. -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeButilBuildAssetsInPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="IncludeButilBuildAssetsInPackage"
            DependsOnTargets="BuildButilJavaScript"
            Condition="'$(TargetFrameworks)' == '$(TargetFramework)' or $([System.String]::Copy('$(TargetFrameworks)').StartsWith('$(TargetFramework);'))">
        <MSBuild Projects="..\Bit.Butil.Build\Bit.Butil.Build.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier">
            <Output TaskParameter="TargetOutputs" ItemName="_ButilBuildTaskAssembly" />
        </MSBuild>
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(BaseIntermediateOutputPath)butil-js\chunks\*.js;$(BaseIntermediateOutputPath)butil-js\chunks\manifest.txt" PackagePath="buildTransitive\chunks\" />
            <TfmSpecificPackageFile Include="@(_ButilBuildTaskAssembly)" PackagePath="tasks\" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <TypeScriptFiles Include="Scripts\**\*.ts" />
    </ItemGroup>

    <!-- Restores npm packages then compiles the TypeScript bundle. Both sub-targets are incremental
         via their Inputs/Outputs, so this is a no-op when nothing changed. -->
    <Target Name="BuildButilJavaScript" DependsOnTargets="InstallNodejsDependencies;BuildJavaScript" />

    <!-- The bundle (wwwroot/bit-butil.js) and the lazy-loadable modules (wwwroot/modules/*.js) are
         generated, git-ignored files. On a clean build they do not exist when the default "wwwroot/**"
         Content glob is evaluated, so the static web asset discovery in ResolveProjectStaticWebAssets
         would miss them and consumers get a 404 for _content/Bit.Butil/bit-butil.js (this is what breaks
         the demo on a fresh checkout).

         ResolveProjectStaticWebAssets runs BeforeTargets="AssignTargetPaths" and does NOT depend on
         ResolveStaticWebAssetsInputs, so the old ResolveStaticWebAssetsInputsDependsOn hook never ran
         early enough. Hooking BeforeTargets="ResolveProjectStaticWebAssets" guarantees the bundle is
         generated first (DependsOnTargets) and then explicitly added to @(Content) so discovery picks
         it up. The Remove-before-Include keeps it to a single Content entry (avoiding a duplicate /
         conflicting-target-path error) for builds where the glob already captured it. -->
    <Target Name="IncludeButilJavaScriptAsStaticWebAsset"
            BeforeTargets="ResolveProjectStaticWebAssets"
            DependsOnTargets="BuildButilJavaScript">
        <ItemGroup>
            <Content Remove="wwwroot\bit-butil.js;wwwroot\modules\*.js" />
            <Content Include="wwwroot\bit-butil.js;wwwroot\modules\*.js" />
        </ItemGroup>
    </Target>

    <!-- In a multi-targeted build, produce the bundle exactly once in the outer (cross-targeting)
         build, before the per-TFM inner builds are dispatched. This prevents several inner builds
         from invoking tsc/esbuild concurrently against the same shared wwwroot output file.
         The Condition is evaluated at execution time (when IsCrossTargetingBuild is set), so the
         target only runs in the outer build; inner builds emit a harmless "DispatchToInnerBuilds
         does not exist" message at detailed verbosity only. -->
    <Target Name="BuildButilJavaScriptOnCrossTargeting"
            BeforeTargets="DispatchToInnerBuilds"
            Condition="'$(IsCrossTargetingBuild)' == 'true'"
            DependsOnTargets="BuildButilJavaScript" />

    <Target Name="InstallNodejsDependencies" Inputs="package.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm install" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <!-- tsc emits one JavaScript file per Scripts/*.ts into obj/scripts; build.mjs then assembles the
         bundle (wwwroot/bit-butil.js), the self-contained lazy-loadable modules (wwwroot/modules/*.js) and
         the chunks + dependency manifest the NuGet package carries for publish-time bundle trimming
         (obj/butil-js). See build.mjs for the shape of each output and why. Release minifies; build.mjs
         writes each output to a temporary file and renames it into place, so an interrupted run cannot
         leave a half-written file that the Outputs check above would then take for an up-to-date one. -->
    <Target Name="BuildJavaScript"
            Inputs="@(TypeScriptFiles);tsconfig.json;build.mjs"
            Outputs="wwwroot/bit-butil.js;wwwroot/modules/butil.js;$(BaseIntermediateOutputPath)butil-js/chunks/manifest.txt;$(BaseIntermediateOutputPath)bit-butil.$(Configuration).stamp">
        <PropertyGroup>
            <_ButilBuildScriptArgs Condition=" '$(Configuration)' == 'Release' ">--minify</_ButilBuildScriptArgs>
        </PropertyGroup>
        <Exec Command="node_modules/.bin/tsc --outDir &quot;$(BaseIntermediateOutputPath)scripts&quot;" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Exec Command="node build.mjs $(_ButilBuildScriptArgs) --intermediate &quot;$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)').TrimEnd('\'))&quot;" StandardOutputImportance="high" StandardErrorImportance="high" />

        <!-- Configuration-aware incremental marker. The bundle (wwwroot/bit-butil.js) is a single shared
             file with a config-independent path, but only Release minifies it. Without a
             per-config marker, MSBuild's Inputs/Outputs check treats a Debug-built (unminified) bundle as
             up-to-date for a subsequent Release build - silently skipping tsc/esbuild and shipping an
             unminified bundle (and vice-versa). Stamp the current configuration and clear every other
             config's stamp so any Debug<->Release switch invalidates this target and regenerates the
             correct bundle. -->
        <ItemGroup>
            <_ButilBuildStamp Include="$(BaseIntermediateOutputPath)bit-butil.*.stamp" />
        </ItemGroup>
        <Delete Files="@(_ButilBuildStamp)" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)" />
        <Touch Files="$(BaseIntermediateOutputPath)bit-butil.$(Configuration).stamp" AlwaysCreate="true" />
    </Target>

</Project>