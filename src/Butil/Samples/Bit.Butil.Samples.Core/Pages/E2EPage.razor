@page "/e2e"
@inject Bit.Butil.LocalStorage localStorage
@inject Bit.Butil.SessionStorage sessionStorage
@inject Bit.Butil.Cookie cookie
@inject Bit.Butil.Crypto crypto
@inject Bit.Butil.Performance performance
@inject Bit.Butil.Document document
@inject Bit.Butil.Window window
@inject Bit.Butil.History history
@inject Bit.Butil.Location location
@inject Bit.Butil.TextEncoding textEncoding
@inject Bit.Butil.StructuredClone structuredClone
@inject Bit.Butil.Url url
@inject Bit.Butil.Selection selection

@*
    Deterministic end-to-end harness for Playwright. Every interactive element exposes
    a stable id and outputs are written to a single status element. The page deliberately
    avoids APIs that trigger permission prompts so the suite can run headless without flakes.
*@

<PageTitle>Butil - E2E Harness</PageTitle>

<h1>Butil E2E</h1>

<div data-testid="status" id="status">@_status</div>

<section>
    <h3>Storage</h3>
    <button id="ls-set" @onclick="LocalStorageSet">localStorage.setItem</button>
    <button id="ls-get" @onclick="LocalStorageGet">localStorage.getItem</button>
    <button id="ls-typed-set" @onclick="LocalStorageTypedSet">SetItem&lt;T&gt;</button>
    <button id="ls-typed-get" @onclick="LocalStorageTypedGet">GetItem&lt;T&gt;</button>
    <button id="ss-set" @onclick="SessionStorageSet">sessionStorage.setItem</button>
    <button id="ss-get" @onclick="SessionStorageGet">sessionStorage.getItem</button>
    <button id="ls-remove" @onclick="LocalStorageRemove">localStorage.removeItem</button>
    <button id="ls-meta" @onclick="LocalStorageMeta">length/key/containsKey</button>
    <button id="ls-clear" @onclick="LocalStorageClear">localStorage.clear</button>
    <button id="ss-clear" @onclick="SessionStorageClear">sessionStorage.clear</button>
</section>

<section>
    <h3>Cookie</h3>
    <button id="cookie-set" @onclick="CookieSet">Set cookie with reserved chars</button>
    <button id="cookie-get" @onclick="CookieGet">Get cookie</button>
    <button id="cookie-remove" @onclick="CookieRemove">Remove cookie</button>
</section>

<section>
    <h3>Crypto</h3>
    <button id="crypto-uuid" @onclick="CryptoUuid">randomUUID</button>
    <button id="crypto-rand" @onclick="CryptoRand">getRandomValues(32)</button>
    <button id="crypto-digest" @onclick="CryptoDigestSha256">SHA-256("hello")</button>
    <button id="crypto-roundtrip" @onclick="CryptoAesRoundTrip">AES-GCM roundtrip</button>
    <button id="crypto-aes-cbc" @onclick="CryptoAesCbcRoundTrip">AES-CBC roundtrip</button>
    <button id="crypto-hmac" @onclick="CryptoHmac">HMAC sign + verify</button>
    <button id="crypto-ecdsa" @onclick="CryptoEcdsa">ECDSA sign + verify</button>
    <button id="crypto-pbkdf2" @onclick="CryptoPbkdf2">PBKDF2 derive</button>
</section>

<section>
    <h3>Location</h3>
    <button id="loc-href" @onclick="LocationHref">location.href</button>
    <button id="loc-parts" @onclick="LocationParts">protocol/pathname/origin</button>
</section>

<section>
    <h3>History</h3>
    <button id="history-state" @onclick="HistoryPush">history.pushState</button>
    <button id="history-replace" @onclick="HistoryReplace">replaceState + state</button>
    <button id="history-scroll" @onclick="HistoryScrollRestoration">scrollRestoration</button>
</section>

<section>
    <h3>Document</h3>
    <button id="doc-title" @onclick="DocSetTitle">Set document.title</button>
    <button id="doc-meta" @onclick="DocMeta">visibility/charset/url</button>
</section>

<section>
    <h3>Window + Performance</h3>
    <button id="perf-now" @onclick="PerfNow">performance.now</button>
    <button id="window-base64" @onclick="WindowBase64">btoa/atob roundtrip</button>
    <button id="window-metrics" @onclick="WindowMetrics">inner size + secure ctx</button>
    <button id="window-matchmedia" @onclick="WindowMatchMedia">matchMedia</button>
</section>

<section>
    <h3>Element</h3>
    @* The element extensions run against elements this harness renders once and never re-renders,
       so a Blazor diff cannot undo what the interop writes between the click and the assertion. *@
    <div @ref="_elementBox" id="el-box" class="el-target" data-demo="butil" style="height:6rem;overflow:auto;">
        <p>Element extension target.</p>
        <ul><li>one</li><li>two</li><li>three</li></ul>
        <div style="height:20rem;">scroll space</div>
    </div>
    <div @ref="_elementHidden" id="el-hidden" style="display:none;">hidden</div>
    <div @ref="_elementContent" id="el-content-box">original</div>
    <div @ref="_elementPopover" id="el-popover-box">popover body</div>
    <button @ref="_elementButton" id="el-synthetic" @onclick="() => _syntheticClicks++">synthetic target</button>
    <input @ref="_elementInput" id="el-input" />
    <button id="el-click" @onclick="ElementClick">Click</button>
    <button id="el-focus" @onclick="ElementFocus">Focus + Matches(:focus)</button>
    <button id="el-visibility" @onclick="ElementVisibility">CheckVisibility</button>
    <button id="el-closest" @onclick="ElementClosest">Closest</button>
    <button id="el-classes" @onclick="ElementClasses">classList</button>
    <button id="el-data" @onclick="ElementData">dataset</button>
    <button id="el-style" @onclick="ElementStyle">inline style</button>
    <button id="el-content" @onclick="ElementContent">content insertion</button>
    <button id="el-aria" @onclick="ElementAria">ARIA + role</button>
    <button id="el-ns" @onclick="ElementNamespacedAttributes">namespaced attributes</button>
    <button id="el-query" @onclick="ElementQueries">query helpers</button>
    <button id="el-scroll" @onclick="ElementScrollOffsets">scroll offsets</button>
    <button id="el-rects" @onclick="ElementClientRects">getClientRects</button>
    <button id="el-popover" @onclick="ElementPopoverState">popover</button>
    <button id="el-identity" @onclick="ElementIdentity">identity + tree facts</button>
</section>

<section>
    <h3>Text, clone and URL</h3>
    <button id="text-decode" @onclick="TextDecodeLegacy">decode shift_jis</button>
    <button id="text-encode" @onclick="TextEncodeAndMeasure">encode + byte length</button>
    <button id="text-stream" @onclick="TextDecodeStreaming">streaming decoder</button>
    <button id="clone-roundtrip" @onclick="CloneRoundTrip">structuredClone</button>
    <button id="clone-can" @onclick="CloneCheck">canClone</button>
    <button id="url-parse" @onclick="UrlParse">URL parts</button>
    <button id="url-query" @onclick="UrlQuery">repeated query values</button>
    <button id="url-pattern" @onclick="UrlPattern">URLPattern</button>
    <button id="url-pattern-credentials" @onclick="UrlPatternCredentials">URLPattern credentials</button>
</section>

<section>
    <h3>Selection</h3>
    @* Fixed, never re-rendered text so the offsets below are stable across runs. *@
    <span @ref="_selectionTarget" id="sel-target">butil selection target</span>
    @* No text at all, so the one position in it is the only one there is to restore a caret to. *@
    <span @ref="_selectionEmptyTarget" id="sel-empty-target"></span>
    <button id="sel-select" @onclick="SelectionSelectContents">select contents</button>
    <button id="sel-range" @onclick="SelectionSelectRange">select range 0-5</button>
    <button id="sel-offsets" @onclick="SelectionOffsets">offsets in element</button>
    <button id="sel-empty-range" @onclick="SelectionEmptyRange">caret in an empty element</button>
    <button id="sel-content-offsets" @onclick="SelectionContentsOffsets">offsets of a whole element</button>
    <button id="sel-bad-range" @onclick="SelectionNegativeRange">negative range</button>
    <button id="sel-replace" @onclick="SelectionReplace">replace with text</button>
    <button id="sel-clear" @onclick="SelectionClear">remove all</button>
</section>

@code {
    private const string TestCookieName = "butil_e2e";
    private const string TestCookieValue = "v=1; b=hello world & again";
    private string _status = "ready";

    private void Set(string value) { _status = value; StateHasChanged(); }

    private ElementReference _elementBox;
    private ElementReference _elementContent;
    private ElementReference _elementHidden;
    private ElementReference _elementPopover;
    private ElementReference _elementButton;
    private ElementReference _elementInput;
    private int _syntheticClicks;

    /// <summary>The namespace SVG's href lives in - the usual reason for the *NS attribute overloads.</summary>
    private const string XlinkNamespace = "http://www.w3.org/1999/xlink";

    // ─── Storage ────────────────────────────────────────────────────────────────
    private async Task LocalStorageSet()
    {
        await localStorage.SetItem("butil-e2e-key", "butil-e2e-value");
        Set("ls:set");
    }
    private async Task LocalStorageGet()
    {
        var v = await localStorage.GetItem("butil-e2e-key");
        Set($"ls:get:{v}");
    }
    private async Task LocalStorageTypedSet()
    {
        await localStorage.SetItem("butil-e2e-typed", new SamplePayload(42, "answer"));
        Set("ls:typed-set");
    }
    private async Task LocalStorageTypedGet()
    {
        var v = await localStorage.GetItem<SamplePayload>("butil-e2e-typed");
        Set($"ls:typed-get:{v?.Number}/{v?.Label}");
    }
    private async Task SessionStorageSet()
    {
        await sessionStorage.SetItem("butil-e2e-skey", "butil-e2e-svalue");
        Set("ss:set");
    }
    private async Task SessionStorageGet()
    {
        var v = await sessionStorage.GetItem("butil-e2e-skey");
        Set($"ss:get:{v}");
    }
    private async Task LocalStorageClear() { await localStorage.Clear(); Set("ls:clear"); }
    private async Task SessionStorageClear() { await sessionStorage.Clear(); Set("ss:clear"); }
    private async Task LocalStorageRemove()
    {
        await localStorage.SetItem("butil-e2e-remove", "x");
        await localStorage.RemoveItem("butil-e2e-remove");
        var present = await localStorage.ContainsKey("butil-e2e-remove");
        Set($"ls:removed:{!present}");
    }
    private async Task LocalStorageMeta()
    {
        await localStorage.Clear();
        await localStorage.SetItem("alpha", "1");
        await localStorage.SetItem("beta", "2");
        var len = await localStorage.GetLength();
        var key0 = await localStorage.GetKey(0);
        var hasAlpha = await localStorage.ContainsKey("alpha");
        var hasGhost = await localStorage.ContainsKey("ghost");
        Set($"ls:meta:{len}/{key0}/{hasAlpha}/{hasGhost}");
    }

    // ─── Cookie ─────────────────────────────────────────────────────────────────
    private async Task CookieSet()
    {
        await cookie.Set(new ButilCookie { Name = TestCookieName, Value = TestCookieValue, Path = "/" });
        Set("cookie:set");
    }
    private async Task CookieGet()
    {
        var c = await cookie.Get(TestCookieName);
        Set($"cookie:get:{c?.Value}");
    }
    private async Task CookieRemove()
    {
        await cookie.Remove(new ButilCookie { Name = TestCookieName, Path = "/" });
        var c = await cookie.Get(TestCookieName);
        Set($"cookie:removed:{c is null}");
    }

    // ─── Crypto ─────────────────────────────────────────────────────────────────
    private async Task CryptoUuid()
    {
        var id = await crypto.RandomUuid();
        Set($"crypto:uuid:{id}");
    }
    private async Task CryptoRand()
    {
        var bytes = await crypto.GetRandomValues(32);
        Set($"crypto:rand:{bytes.Length}");
    }
    private async Task CryptoDigestSha256()
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes("hello");
        var hash = await crypto.Digest(CryptoKeyHash.Sha256, bytes);
        Set($"crypto:sha256:{Convert.ToHexString(hash).ToLowerInvariant()}");
    }
    private async Task CryptoAesRoundTrip()
    {
        var key = await crypto.GenerateAesKey(256);
        var iv = await crypto.GetRandomValues(12);
        var data = System.Text.Encoding.UTF8.GetBytes("payload");
        var cipher = await crypto.Encrypt(CryptoAlgorithm.AesGcm, key, data, iv);
        var plain = await crypto.Decrypt(CryptoAlgorithm.AesGcm, key, cipher, iv);
        var matches = plain is not null && System.Text.Encoding.UTF8.GetString(plain) == "payload";
        Set($"crypto:aes-gcm:{matches}");
    }

    private async Task CryptoAesCbcRoundTrip()
    {
        var key = await crypto.GenerateAesKey(256);
        var iv = await crypto.GetRandomValues(16);
        var data = System.Text.Encoding.UTF8.GetBytes("payload");
        var cipher = await crypto.Encrypt(CryptoAlgorithm.AesCbc, key, data, iv);
        var plain = await crypto.Decrypt(CryptoAlgorithm.AesCbc, key, cipher, iv);
        var matches = plain is not null && System.Text.Encoding.UTF8.GetString(plain) == "payload";
        Set($"crypto:aes-cbc:{matches}");
    }

    private async Task CryptoHmac()
    {
        var key = await crypto.GenerateHmacKey(CryptoKeyHash.Sha256);
        var data = System.Text.Encoding.UTF8.GetBytes("payload");
        var sig = await crypto.SignHmac(CryptoKeyHash.Sha256, key, data);
        var ok = await crypto.VerifyHmac(CryptoKeyHash.Sha256, key, sig, data);
        Set($"crypto:hmac:{ok}");
    }

    private async Task CryptoEcdsa()
    {
        var pair = await crypto.GenerateEcdsaKeyPair();
        var data = System.Text.Encoding.UTF8.GetBytes("payload");
        var sig = await crypto.SignEcdsa(pair.PrivateKey, data, pair.Curve);
        var ok = await crypto.VerifyEcdsa(pair.PublicKey, sig, data, pair.Curve);
        Set($"crypto:ecdsa:{ok}");
    }

    private async Task CryptoPbkdf2()
    {
        var password = System.Text.Encoding.UTF8.GetBytes("correct horse");
        var salt = await crypto.GetRandomValues(16);
        var bits = await crypto.DerivePbkdf2(password, salt, 100_000, 256);
        Set($"crypto:pbkdf2:{bits.Length}");
    }

    // ─── Misc ──────────────────────────────────────────────────────────────────
    private async Task PerfNow()
    {
        var n = await performance.Now();
        Set($"perf:now:{n > 0}");
    }
    private async Task WindowBase64()
    {
        var encoded = await window.Btoa("butil");
        var decoded = await window.Atob(encoded);
        Set($"window:b64:{encoded}/{decoded}");
    }
    private async Task DocSetTitle()
    {
        await document.SetTitle("butil-e2e-title");
        var t = await document.GetTitle();
        Set($"doc:title:{t}");
    }
    private async Task DocMeta()
    {
        var visibility = await document.GetVisibilityState();
        var charset = await document.GetCharacterSet();
        var url = await document.GetUrl();
        Set($"doc:meta:{visibility}/{charset.Length > 0}/{url.Contains("/e2e")}");
    }
    private async Task LocationHref()
    {
        var href = await location.GetHref();
        Set($"loc:href:{href.Contains("/e2e")}");
    }
    private async Task LocationParts()
    {
        var protocol = await location.GetProtocol();
        var pathname = await location.GetPathname();
        var origin = await location.GetOrigin();
        var protocolOk = protocol is "http:" or "https:";
        Set($"loc:parts:{protocolOk}/{pathname == "/e2e"}/{origin.Contains(protocol)}");
    }
    private async Task WindowMetrics()
    {
        var innerWidth = await window.GetInnerWidth();
        var innerHeight = await window.GetInnerHeight();
        Set($"window:metrics:{innerWidth > 0 && innerHeight > 0}");
    }
    private async Task WindowMatchMedia()
    {
        var mql = await window.MatchMedia("(min-width: 1px)");
        Set($"window:media:{mql.Matches}");
    }
    private async Task HistoryPush()
    {
        await history.PushState(new SamplePayload(1, "marker"), "/e2e?marked");
        var len = await history.GetLength();
        Set($"history:len:{len > 0}");
    }
    private async Task HistoryReplace()
    {
        await history.ReplaceState(new SamplePayload(7, "replaced"), "/e2e?replaced");
        var state = await history.GetState<SamplePayload>();
        Set($"history:state:{state?.Number}/{state?.Label}");
    }
    private async Task HistoryScrollRestoration()
    {
        await history.SetScrollRestoration(ScrollRestoration.Manual);
        var value = await history.GetScrollRestoration();
        await history.SetScrollRestoration(ScrollRestoration.Auto);
        Set($"history:scroll:{value}");
    }

    // ─── Element extensions ─────────────────────────────────────────────────────
    private async Task ElementClick()
    {
        var before = _syntheticClicks;
        await _elementButton.Click();
        // The button's own @onclick ran, which is the whole point: a synthetic click is a real
        // click as far as the page is concerned, gesture-gated APIs aside.
        Set($"el:click:{_syntheticClicks - before}");
    }
    private async Task ElementFocus()
    {
        await _elementInput.Focus(new FocusOptions { PreventScroll = true });
        var focused = await _elementInput.Matches(":focus");
        Set($"el:focus:{focused}");
    }
    private async Task ElementVisibility()
    {
        var options = new CheckVisibilityOptions { OpacityProperty = true, VisibilityProperty = true };
        var shown = await _elementBox.CheckVisibility(options);
        var hidden = await _elementHidden.CheckVisibility(options);
        Set($"el:vis:{shown}/{hidden}");
    }
    private async Task ElementClosest()
    {
        var inSection = await _elementBox.Closest("section");
        var inTable = await _elementBox.Closest("table");
        Set($"el:closest:{inSection}/{inTable}");
    }
    private async Task ElementClasses()
    {
        await _elementBox.AddClass("alpha", "beta");
        var has = await _elementBox.ContainsClass("alpha");
        var swapped = await _elementBox.ReplaceClass("beta", "gamma");
        var toggled = await _elementBox.ToggleClass("alpha");
        var list = await _elementBox.GetClassList();
        await _elementBox.RemoveClass("gamma");
        Set($"el:class:{has}/{swapped}/{toggled}/{list.Length}");
    }
    private async Task ElementData()
    {
        await _elementBox.SetData("userId", "42");
        var value = await _elementBox.GetData("userId");
        var names = await _elementBox.GetDataNames();
        await _elementBox.RemoveData("userId");
        var afterRemoval = await _elementBox.GetData("userId");
        Set($"el:data:{value}/{names.Contains("userId")}/{string.IsNullOrEmpty(afterRemoval)}");
    }
    private async Task ElementStyle()
    {
        await _elementBox.SetStyleProperty("--butil-accent", "#123456");
        var custom = await _elementBox.GetStyleProperty("--butil-accent");
        await _elementBox.SetStyleProperty("outline-width", "3px", important: true);
        var removed = await _elementBox.RemoveStyleProperty("outline-width");
        Set($"el:style:{custom.Trim()}/{removed}");
    }
    private async Task ElementContent()
    {
        await _elementContent.ReplaceChildren("base");
        await _elementContent.Append("+append");
        await _elementContent.Prepend("prepend+");
        await _elementContent.InsertAdjacentText(InsertPosition.BeforeEnd, "!");
        var html = await _elementContent.GetHtml();
        Set($"el:content:{html}");
    }
    private async Task ElementAria()
    {
        await _elementBox.SetRole("region");
        await _elementBox.SetAriaLabel("butil-e2e");
        await _elementBox.SetAriaExpanded("true");
        var role = await _elementBox.GetRole();
        var label = await _elementBox.GetAriaLabel();
        var expanded = await _elementBox.GetAriaExpanded();
        Set($"el:aria:{role}/{label}/{expanded}");
    }
    private async Task ElementNamespacedAttributes()
    {
        await _elementBox.SetAttributeNS(XlinkNamespace, "xlink:href", "#star");
        var value = await _elementBox.GetAttributeNS(XlinkNamespace, "href");
        var present = await _elementBox.HasAttributeNS(XlinkNamespace, "href");
        await _elementBox.RemoveAttributeNS(XlinkNamespace, "href");
        var afterRemoval = await _elementBox.HasAttributeNS(XlinkNamespace, "href");
        Set($"el:ns:{value}/{present}/{afterRemoval}");
    }
    private async Task ElementQueries()
    {
        var matches = await _elementBox.QuerySelectorMatches("li");
        var count = await _elementBox.QuerySelectorAllCount("li");
        var none = await _elementBox.QuerySelectorAllCount("table");
        Set($"el:query:{matches}/{count}/{none}");
    }
    private async Task ElementScrollOffsets()
    {
        await _elementBox.SetScrollTop(60);
        var top = await _elementBox.GetScrollTop();
        var max = await _elementBox.GetScrollTopMax();
        await _elementBox.SetScrollTop(0);
        Set($"el:scroll:{top > 0}/{max > 0}");
    }
    private async Task ElementClientRects()
    {
        var rects = await _elementBox.GetClientRects();
        Set($"el:rects:{rects.Length > 0}/{rects.Length > 0 && rects[0].Width > 0}");
    }
    private async Task ElementPopoverState()
    {
        await _elementPopover.SetPopover(ElementPopover.Manual);
        var kind = await _elementPopover.GetPopover();
        var showing = await _elementPopover.TogglePopover();
        await _elementPopover.HidePopover();
        await _elementPopover.SetPopover(ElementPopover.NotSet);
        Set($"el:popover:{kind}/{showing}");
    }
    private async Task ElementIdentity()
    {
        await _elementBox.SetTitle("butil-e2e-title");
        await _elementBox.SetLang("fa-IR");
        await _elementBox.SetDraggable(true);
        var title = await _elementBox.GetTitle();
        var lang = await _elementBox.GetLang();
        var draggable = await _elementBox.GetDraggable();
        var localName = await _elementBox.GetLocalName();
        var children = await _elementBox.GetChildElementCount();
        var zoom = await _elementBox.GetCurrentCssZoom();
        Set($"el:identity:{title}/{lang}/{draggable}/{localName}/{children}/{zoom > 0}");
    }

    // ─── Text, clone and URL ────────────────────────────────────────────────────
    // "こんにちは" in Shift_JIS. As bytes because that is the point: .NET on WebAssembly cannot
    // decode this without an extra package, and the browser can.
    private static readonly byte[] ShiftJisGreeting = [0x82, 0xB1, 0x82, 0xF1, 0x82, 0xC9, 0x82, 0xBF, 0x82, 0xCD];

    private async Task TextDecodeLegacy()
    {
        var text = await textEncoding.Decode(ShiftJisGreeting, "shift_jis");
        var canonical = await textEncoding.GetCanonicalName("sjis");
        Set($"text:decode:{text}/{canonical}");
    }
    private async Task TextEncodeAndMeasure()
    {
        var bytes = await textEncoding.Encode("héllo");
        var length = await textEncoding.GetUtf8ByteLength("héllo");
        Set($"text:encode:{bytes.Length}/{length}");
    }
    private async Task TextDecodeStreaming()
    {
        // Split through the middle of the third character - the case a per-chunk decode gets wrong.
        await using var decoder = await textEncoding.CreateDecoder("shift_jis");
        if (decoder is null) { Set("text:stream:no-decoder"); return; }

        var streamed = await decoder.Decode(ShiftJisGreeting[..5]) + await decoder.Decode(ShiftJisGreeting[5..], more: false);
        var whole = await textEncoding.Decode(ShiftJisGreeting, "shift_jis");
        Set($"text:stream:{streamed == whole}");
    }
    private async Task CloneRoundTrip()
    {
        var copy = await structuredClone.Clone(new SamplePayload(42, "answer"));
        Set($"clone:roundtrip:{copy?.Number}/{copy?.Label}");
    }
    private async Task CloneCheck()
    {
        var can = await structuredClone.CanClone(new SamplePayload(1, "x"));
        Set($"clone:can:{can}");
    }
    private async Task UrlParse()
    {
        var parts = await url.Parse("https://example.com:8080/docs/guide?tag=a&tag=b#top");
        // Pipe-separated because the components are full of slashes themselves.
        Set($"url:parse:{parts?.Origin}|{parts?.Pathname}|{parts?.Port}|{parts?.Hash}");
    }
    private async Task UrlQuery()
    {
        var values = await url.GetQueryValues("?tag=a&tag=b&page=2", "tag");
        var sorted = await url.SortQuery("https://example.com/x?b=2&a=1");
        Set($"url:query:{values.Length}/{sorted}");
    }
    private async Task UrlPattern()
    {
        if (await url.IsPatternSupported() is false) { Set("url:pattern:unsupported"); return; }

        var match = await url.MatchPattern("/books/:id", "https://example.com/books/42", "https://example.com");
        Set($"url:pattern:{match?.Groups.GetValueOrDefault("id")}");
    }

    private async Task UrlPatternCredentials()
    {
        if (await url.IsPatternSupported() is false) { Set("url:credentials:unsupported"); return; }

        // The two components a URL rarely carries - and the ones a pattern has to report when it does.
        var match = await url.MatchPattern("https://:user::pass@example.com/*", "https://ada:secret@example.com/x");
        Set($"url:credentials:{match?.Username}/{match?.Password}");
    }

    // ─── Selection ──────────────────────────────────────────────────────────────
    private ElementReference _selectionTarget;
    private ElementReference _selectionEmptyTarget;

    private async Task SelectionSelectContents()
    {
        await selection.SelectElementContents(_selectionTarget);
        var text = await selection.GetText();
        Set($"sel:select:{text}");
    }
    private async Task SelectionSelectRange()
    {
        await selection.SelectRange(_selectionTarget, 0, 5);
        var text = await selection.GetText();
        Set($"sel:range:{text}");
    }
    private async Task SelectionOffsets()
    {
        await selection.SelectRange(_selectionTarget, 6, 15);
        var offsets = await selection.GetRangeIn(_selectionTarget);
        Set($"sel:offsets:{offsets?.Start}/{offsets?.End}");
    }
    private async Task SelectionContentsOffsets()
    {
        // selectNodeContents leaves both ends on the element itself rather than in its text, which
        // still has to read as "all of it" - 0 to the text's length.
        await selection.SelectElementContents(_selectionTarget);
        var offsets = await selection.GetRangeIn(_selectionTarget);
        Set($"sel:contents:{offsets?.Start}/{offsets?.End}");
    }
    private async Task SelectionEmptyRange()
    {
        // The round trip an emptied editor needs: an element with no text reports {0,0}, and the
        // caret has to go back to exactly that.
        var placed = await selection.SelectRange(_selectionEmptyTarget, 0, 0);
        var offsets = await selection.GetRangeIn(_selectionEmptyTarget);
        Set($"sel:empty:{placed}/{offsets?.Start}/{offsets?.End}");
    }
    private async Task SelectionNegativeRange()
    {
        // Out-of-range offsets are a false, not an exception - a negative one included.
        var start = await selection.SelectRange(_selectionTarget, -1, 5);
        var end = await selection.SelectRange(_selectionTarget, 0, -5);
        Set($"sel:badrange:{start}/{end}");
    }
    private async Task SelectionReplace()
    {
        // The replacement leaves a caret after the text, not the text selected.
        await selection.SelectRange(_selectionTarget, 0, 5);
        await selection.ReplaceWithText("BUTIL");
        var collapsed = (await selection.Get())?.IsCollapsed;

        // Selecting all of it is how its text is read back from here.
        await selection.SelectElementContents(_selectionTarget);
        Set($"sel:replace:{collapsed}/{await selection.GetText()}");
    }
    private async Task SelectionClear()
    {
        await selection.SelectElementContents(_selectionTarget);
        await selection.RemoveAll();
        var text = await selection.GetText();
        Set($"sel:clear:{text.Length == 0}");
    }

    public class SamplePayload(int number, string label)
    {
        public int Number { get; set; } = number;
        public string Label { get; set; } = label;
    }
}
