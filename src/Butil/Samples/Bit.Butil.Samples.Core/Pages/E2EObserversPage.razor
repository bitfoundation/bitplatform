    private static async Task<bool> WaitFor(TaskCompletionSource<bool> tcs, int timeoutMs)
    {
        var completed = await Task.WhenAny(tcs.Task, Task.Delay(timeoutMs));
        return completed == tcs.Task && tcs.Task.Result;
    }

    private static async Task<string> WaitForValue(TaskCompletionSource<string> tcs, int timeoutMs)
    {
        var completed = await Task.WhenAny(tcs.Task, Task.Delay(timeoutMs));
        return completed == tcs.Task ? tcs.Task.Result : "";
    }

