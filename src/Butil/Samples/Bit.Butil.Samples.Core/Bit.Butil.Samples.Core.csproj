<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Multi-targeted because the library is: the test harness hosts (tests/Bit.Butil.Tests.Harness.*) serve
         these pages on every runtime Bit.Butil ships for. The sample apps themselves pick net11.0. -->
    <TargetFrameworks>net11.0;net10.0;net9.0;net8.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <ProjectReference Include="..\..\Bit.Butil\Bit.Butil.csproj" />
  </ItemGroup>

</Project>
