@page "/chat"
@implements IAsyncDisposable

@* Nothing of the AI packages is registered at startup, so the page hands the chat everything the registration would
   have: its session over the app's transport here, and - where an app wants them - its UiOptions, a cascaded
   BitAiRendererRegistry and a cascaded IBitAiGenerativeUiRegistry. *@
<div id="chat-ready">
    <BitAiChat Session="_session" EmptyTitle="Ask me anything" />
</div>

@code {
    private readonly BitAiChatSession _session = new(new EchoTransport());

    public ValueTask DisposeAsync() => _session.DisposeAsync();
}
