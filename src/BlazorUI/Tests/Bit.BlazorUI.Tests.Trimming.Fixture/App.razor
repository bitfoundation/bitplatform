@* A known handful of components, so a publish can be checked against what they need and nothing else:
   - BitButton, BitText: a stylesheet each, and no script of their own;
   - BitTextField: a script of its own, and a claim of Escape in its markup (Utils.Escape);
   - BitDropdown: the callouts (Callouts, the focus and escape scripts they use);
   - BitTooltip: the tooltips' script, kept through its interop identifiers;
   - BitIcon with BitIconName.Add: the one glyph of Bit.BlazorUI.Icons the icon trimming keeps for the code;
   - BitErrorBoundary: one component of the Extras, none of whose vendor folders (flags, leaflet, openlayers) it loads.
   - scripts/fixture.js: a script of the app's own calling BitBlazorUI.PageVisibility, which keeps that script.
   Nothing of Bit.BlazorUI.Legacy is used, though the package is referenced. *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <base href="/" />
    <link rel="stylesheet" href="_content/Bit.BlazorUI.Icons/styles/bit.blazorui.icons.css" />
    <link rel="stylesheet" href="_content/Bit.BlazorUI/styles/bit.blazorui.css" />
    <link rel="stylesheet" href="_content/Bit.BlazorUI.Extras/styles/bit.blazorui.extras.css" />
</head>
<body>
    <BitErrorBoundary>
        <BitText>Trimming fixture</BitText>
        <BitButton>Save</BitButton>
        <BitTextField Label="Name" />
        <BitDropdown TItem="BitDropdownItem<string>" TValue="string" Label="Color" Items="_colors" />
        <BitTooltip Text="Help">
            <BitIcon IconName="@BitIconName.Add" />
        </BitTooltip>
    </BitErrorBoundary>

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Bit.BlazorUI/scripts/bit.blazorui.js"></script>
    <script src="_content/Bit.BlazorUI.Extras/scripts/bit.blazorui.extras.js"></script>
    <script src="scripts/fixture.js"></script>
</body>
</html>

@code {
    private readonly List<BitDropdownItem<string>> _colors =
    [
        new() { Text = "Red", Value = "red" },
        new() { Text = "Green", Value = "green" },
    ];
}
