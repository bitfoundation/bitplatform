<Project Sdk="Microsoft.NET.Sdk">

    <!--
    A console app that exists to be published trimmed and compiled ahead of time - see AiWireFormatTrimmingTests in
    Bit.BlazorUI.Tests.Trimming, which is the only thing that publishes it - and then run: it round-trips every built-in
    BitAiEvent and a request through the wire format of Bit.BlazorUI.AI.Core (BitAiWireSerializer), the one package a
    server or a plain .NET client of the AI packages needs,, and exits with the number
    that did not survive. The samples are the unit tests' own (BitAiWireSamples).

    Not in the solution: building it on its own proves nothing.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Every trim and AOT warning is reported one by one, so the test can tell the package's apart. -->
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <!-- Set here rather than on the command line, where they would reach the netstandard projects the packages build with. -->
    <PropertyGroup Condition="'$(AiWirePublish)' == 'trimmed'">
        <PublishTrimmed>true</PublishTrimmed>
    </PropertyGroup>
    <PropertyGroup Condition="'$(AiWirePublish)' == 'aot'">
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bit.BlazorUI.AI\Bit.BlazorUI.AI.Core\Bit.BlazorUI.AI.Core.csproj" />
        <Compile Include="..\Bit.BlazorUI.Tests\Components\AI\Wire\BitAiWireSamples.cs" Link="BitAiWireSamples.cs" />
    </ItemGroup>

</Project>
