@* The host's pages and the performance pages of the client project, where they run on the server. *@
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="[typeof(ClientRoutes).Assembly]">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <p role="alert">Sorry, there's nothing at this address.</p>
    </NotFound>
</Router>
