@page "/regression/time-zone-picker"

<PageTitle>Time Zone Picker Regression</PageTitle>

@* BitTimeZonePicker driven through what only a browser does: the list opened, closed, disabled under itself and
   relocated to the body, the keys the field's own listener prevents, the time zone the browser reports, and the
   offsets read off the time zone data the server runs on. Every case has its own wrapper id; the controls above them
   push the parameters a page would. The callout and the overlay of each case carry a class of their own, since both are
   moved to the body while the list is open. *@
<div id="test-controls" style="padding: 8px; background: #f0f0f0;">
    <button id="btn-disable" @onclick="() => _disabled = !_disabled">Toggle Disabled</button>
    <button id="btn-hit" @onclick="() => _hits++">Hit</button>
    <p style="font-family: monospace; margin: 0;">
        Status: <span id="status">@_status</span> |
        Value: <span id="v-value">@_value</span> |
        TimeZoneInfo: <span id="v-info">@(BitTimeZones.Find(_info)?.Id)</span> |
        Detected: <span id="v-detected">@_detected</span> |
        Bound open: <span id="v-open">@(_boundOpen ? "true" : "false")</span> |
        Disabled: <span id="v-disabled">@(_disabled ? "true" : "false")</span> |
        NoSearchBox value: <span id="v-nosearch-value">@_noSearchValue</span> |
        Hits: <span id="v-hits">@_hits</span>
    </p>
</div>

<div id="basic" style="padding: 8px; width: 360px;">
    <BitTimeZonePicker Label="Time zone" Classes="@(new() { Callout = "basic-cal", Overlay = "basic-ovl" })" @bind-Value="_value" />
</div>

<div id="info" style="padding: 8px; width: 360px;">
    <BitTimeZonePicker Label="TimeZoneInfo" Classes="@(new() { Callout = "info-cal", Overlay = "info-ovl" })" @bind-Value="_info" />
</div>

<div id="bound" style="padding: 8px; width: 360px;">
    <BitTimeZonePicker TValue="string" Label="Bound" Classes="@(new() { Callout = "bound-cal", Overlay = "bound-ovl" })" @bind-IsOpen="_boundOpen" Disabled="_disabled" />
</div>

<div id="nosearch" style="padding: 8px; width: 360px;">
    <BitTimeZonePicker Label="No search box" Classes="@(new() { Callout = "nosearch-cal", Overlay = "nosearch-ovl" })" NoSearchBox TimeZones="_offices" ReferenceDate="_january" @bind-Value="_noSearchValue" />
</div>

<div id="detect" style="padding: 8px; width: 360px;">
    <BitTimeZonePicker Label="Detected" DetectTimeZone @bind-Value="_detected" />
</div>

<div style="height: 1200px;"></div>

@code {
    private static readonly DateTimeOffset _january = new(2026, 1, 15, 12, 0, 0, TimeSpan.Zero);

    private readonly List<BitTimeZone> _offices =
    [
        BitTimeZones.Find("Asia/Tokyo")!,
        BitTimeZones.Find("America/New_York")!,
        BitTimeZones.Find("Europe/London")!,
        BitTimeZones.Find("Asia/Tehran")!,
    ];

    private string? _value;
    private TimeZoneInfo? _info;
    private string? _detected;
    private string? _noSearchValue;
    private bool _boundOpen;
    private bool _disabled;
    private int _hits;

    // "Loading" is shown in the SSR pre-rendered HTML before the SignalR circuit connects; only the first
    // interactive render moves it on, which is what the test waits for before it drives the page.
    private string _status = "Loading";

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender is false) return;

        _status = "Ready";
        StateHasChanged();
    }
}
