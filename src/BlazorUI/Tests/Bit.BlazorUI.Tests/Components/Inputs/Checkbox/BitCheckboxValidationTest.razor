@* A checkbox bound to a model whose Value is only valid while it is false, inside an EditForm, so the tests can
   watch the invalid state come and go with the submits and the clicks. *@

<EditForm Model="@TestModel" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
    <DataAnnotationsValidator />

    <BitCheckbox Disabled="Disabled"
                 NoValidate="NoValidate"
                 @bind-Value="@TestModel.Value" />
</EditForm>

@code {
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool NoValidate { get; set; }

    [Parameter] public BitCheckboxTestModel TestModel { get; set; } = new();

    public int ValidCount { get; set; }

    public int InvalidCount { get; set; }

    private void HandleValidSubmit() => ValidCount++;

    private void HandleInvalidSubmit() => InvalidCount++;
}
