<EditForm Model="@TestModel" OnValidSubmit="@HandleOnValidSubmit" OnInvalidSubmit="@HandleOnInvalidSubmit">
    <DataAnnotationsValidator />

    <BitDateRangePicker IsEnabled="IsEnabled"
                        AllowTextInput="AllowTextInput"
                        Culture="@Culture"
                        DateFormat="@DateFormat"
                        ValueFormat="@ValueFormat"
                        MinDate="@MinDate"
                        MaxDate="@MaxDate"
                        InvalidErrorMessage="@InvalidErrorMessage"
                        OutOfRangeErrorMessage="@OutOfRangeErrorMessage"
                        @bind-Value="@TestModel.Value"
                        @bind-IsOpen="IsOpen" />

    <ValidationMessage For="@(() => TestModel.Value)" />

</EditForm>

@code {
    [Parameter] public bool IsEnabled { get; set; }
    [Parameter] public BitDateRangePickerTestModel TestModel { get; set; } = new();
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool AllowTextInput { get; set; }
    [Parameter] public System.Globalization.CultureInfo? Culture { get; set; }
    [Parameter] public string? DateFormat { get; set; }
    [Parameter] public string ValueFormat { get; set; } = "Start: {0} - End: {1}";
    [Parameter] public DateTimeOffset? MinDate { get; set; }
    [Parameter] public DateTimeOffset? MaxDate { get; set; }
    [Parameter] public string? InvalidErrorMessage { get; set; }
    [Parameter] public string? OutOfRangeErrorMessage { get; set; }

    public int ValidCount { get; set; }
    public int InvalidCount { get; set; }

    private void HandleOnValidSubmit()
    {
        ValidCount++;
    }

    private void HandleOnInvalidSubmit()
    {
        InvalidCount++;
    }
}
