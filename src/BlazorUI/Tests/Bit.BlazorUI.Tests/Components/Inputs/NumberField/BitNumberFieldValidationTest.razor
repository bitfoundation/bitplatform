<EditForm Model="@TestModel" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
    <DataAnnotationsValidator />

    <BitNumberField @bind-Value="@TestModel.Value" Disabled="@Disabled" />
</EditForm>

@code {
    [Parameter] public BitNumberFieldTestModel TestModel { get; set; } = new();
    [Parameter] public bool Disabled { get; set; }

    public int ValidCount { get; set; }
    public int InvalidCount { get; set; }

    private void HandleValidSubmit()
    {
        ValidCount++;
    }

    private void HandleInvalidSubmit()
    {
        InvalidCount++;
    }
}
