@using System.Globalization

@* A calendar bound to a required date inside an EditForm, laid out in the invariant culture and UTC so the tests
   can pick a day by its number whatever machine runs them. *@

<EditForm Model="@TestModel" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
    <DataAnnotationsValidator />

    <BitCalendar NoValidate="NoValidate"
                 Required="Required"
                 TimeZone="TimeZoneInfo.Utc"
                 Culture="CultureInfo.InvariantCulture"
                 StartingValue="@(new DateTimeOffset(2026, 1, 15, 0, 0, 0, TimeSpan.Zero))"
                 @bind-Value="@TestModel.Date" />

    <ValidationMessage For="@(() => TestModel.Date)" />
</EditForm>

@code {
    [Parameter] public bool Required { get; set; }

    [Parameter] public bool NoValidate { get; set; }

    [Parameter] public BitCalendarTestModel TestModel { get; set; } = new();

    public int ValidCount { get; set; }

    public int InvalidCount { get; set; }

    private void HandleValidSubmit() => ValidCount++;

    private void HandleInvalidSubmit() => InvalidCount++;
}
