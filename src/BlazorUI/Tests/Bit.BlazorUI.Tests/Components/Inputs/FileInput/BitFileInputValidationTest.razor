@using Bit.BlazorUI.Tests.Components.Inputs.FileInput

<EditForm Model="@TestModel" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
    <DataAnnotationsValidator />

    <BitFileInput Required Multiple MaxSize="50" @bind-Value="@TestModel.Value" />

</EditForm>

@code {
    [Parameter] public BitFileInputTestModel TestModel { get; set; } = new();

    public int ValidCount { get; set; }
    public int InvalidCount { get; set; }

    private void HandleValidSubmit()
    {
        ValidCount++;
    }

    private void HandleInvalidSubmit()
    {
        InvalidCount++;
    }
}
