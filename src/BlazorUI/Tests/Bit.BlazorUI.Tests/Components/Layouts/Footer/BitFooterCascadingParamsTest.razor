@* Covers BitFooterParams: the cascaded values fill in the parameters the footer did not set itself,
   and never overwrite the ones it did. *@

<BitParams Parameters="@(new BitFooterParams[]
                         {
                             new()
                             {
                                 Color = BitColor.Success,
                                 Variant = BitVariant.Outline,
                                 Size = BitSize.Large,
                                 Bordered = true,
                                 Gap = "1rem",
                                 Reveal = true,
                                 Sticky = true,
                                 RevealOffset = 80,
                             }
                         })">
    <BitFooter>Cascaded</BitFooter>
    <BitFooter Color="BitColor.Error" Gap="2rem">Own color</BitFooter>
</BitParams>
