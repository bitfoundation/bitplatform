@* Covers BitHeaderParams: the cascaded values fill in the parameters the header did not set itself,
   and never overwrite the ones it did. *@

<BitParams Parameters="@(new BitHeaderParams[]
                         {
                             new()
                             {
                                 Color = BitColor.Success,
                                 Variant = BitVariant.Outline,
                                 Size = BitSize.Large,
                                 Bordered = true,
                                 Gap = "1rem",
                                 Reveal = true,
                                 Sticky = true,
                                 RevealOffset = 80,
                                 ElevateOnScroll = true,
                                 ElevateOffset = 30,
                                 Wrap = true,
                                 VerticalAlign = BitAlignment.End,
                                 SkipLinkHref = "#main",
                                 SkipLinkText = "Jump to the content",
                             }
                         })">
    <BitHeader>Cascaded</BitHeader>
    <BitHeader Color="BitColor.Error" Gap="2rem">Own color</BitHeader>
</BitParams>
