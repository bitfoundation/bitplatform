    private static List<BitButtonGroupItem> Many() => Enumerable.Range(1, 8).Select(i => new BitButtonGroupItem { Key = $"m{i}", Text = $"Item {i}" }).ToList();

    private void AddDynamicItem()
    {
        _dynamicCounter++;
        _dynamicItems = [.. _dynamicItems, new() { Key = $"n{_dynamicCounter}", Text = $"New {_dynamicCounter}" }];
    }

    private void RemoveDynamicItem()
    {
        if (_dynamicItems.Count > 0) _dynamicItems = _dynamicItems.Skip(1).ToList();
    }

    private void ChangeRerender()
    {
        _rerenderVariant = BitVariant.Outline;
        _rerenderColor = BitColor.Error;
        _rerenderSize = BitSize.Large;
        _rerenderVertical = true;
        _rerenderIconOnly = true;
    }
}
