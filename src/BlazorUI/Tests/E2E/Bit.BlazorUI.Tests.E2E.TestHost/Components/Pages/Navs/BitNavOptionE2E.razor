@page "/e2e/nav/options"

<PageTitle>BitNav options E2E</PageTitle>

@* The BitNavOption API of BitNav: the items are components written in the markup. The automatic mode of the
   options is on /e2e/nav/url. *@

<E2ESection Id="basic" Title="Basic">
    <BitNav Id="onav-basic" TItem="BitNavOption" Mode="BitNavMode.Manual" AriaLabel="Option nav">
        <BitNavOption Text="Home" IconName="@BitIconName.Home" Url="/e2e/nav/url/home" Description="Start here" Title="Home tip" Class="home-class" Style="background-color: rgb(1, 2, 3);" Key="home" />
        <BitNavOption Text="Library" IconName="@BitIconName.Library" IsExpanded="true">
            <BitNavOption Text="Books" />
            <BitNavOption Text="Papers">
                <BitNavOption Text="Drafts" />
            </BitNavOption>
        </BitNavOption>
        <BitNavOption Text="Archived" IsDisabled Url="/e2e/nav/url/archived" />
        <BitNavOption IsSeparator />
        <BitNavOption Text="Reports" Url="/e2e/nav/url/reports" ExpandAriaLabel="Open reports" CollapseAriaLabel="Close reports">
            <BitNavOption Text="Monthly" />
        </BitNavOption>
        <BitNavOption Text="External" Url="https://example.com/" Target="_blank" Rel="BitLinkRels.NoReferrer" />
        <BitNavOption Text="Anchor" ForceAnchor />
        <BitNavOption Text="Inbox" Badge="5" BadgeAriaLabel="5 unread" />
        <BitNavOption Text="Alerts" Dot BadgeAriaLabel="New alerts" />
        <BitNavOption Text="Named" AriaLabel="Custom name" />
        <BitNavOption Text="Stepped" AriaCurrent="BitNavAriaCurrent.Step" />
        <BitNavOption Text="Pictured" Icon="@(BitIconInfo.Css("my-picture"))" />
    </BitNav>
</E2ESection>

<E2ESection Id="width" Title="FitWidth and FullWidth">
    <div id="owidth-container" style="width: 600px;">
        <BitNav Id="onav-fit" TItem="BitNavOption" FitWidth>
            <BitNavOption Text="Short" />
            <BitNavOption Text="A much longer item text" />
        </BitNav>
        <BitNav Id="onav-full" TItem="BitNavOption" FullWidth>
            <BitNavOption Text="Short" />
        </BitNav>
    </div>
</E2ESection>

<E2ESection Id="grouped" Title="Grouped and Separator">
    <BitNav Id="onav-grouped" TItem="BitNavOption" RenderType="BitNavRenderType.Grouped" Mode="BitNavMode.Manual">
        <BitNavOption Text="Group one">
            <BitNavOption Text="One a" />
            <BitNavOption Text="One b" />
        </BitNavOption>
        <BitNavOption IsSeparator />
        <BitNavOption Text="Lonely group" />
    </BitNav>
</E2ESection>

<E2ESection Id="manual" Title="Manual mode">
    <BitNav Id="onav-manual" TItem="BitNavOption" Mode="BitNavMode.Manual" OnSelectItem="(BitNavOption option) => _selectedKey = option?.Key">
        <BitNavOption Text="Fruits" IsExpanded="true">
            <BitNavOption Text="Apple" Key="apple" />
            <BitNavOption Text="Banana" Key="banana" />
        </BitNavOption>
        <BitNavOption Text="Ice cream" Key="ice-cream" />
    </BitNav>
    <p>Selected key: <span id="oselected-key">@_selectedKey</span></p>

    <BitNav @ref="_boundNav" Id="onav-bound" TItem="BitNavOption" Mode="BitNavMode.Manual" @bind-SelectedItem="_boundSelected">
        <BitNavOption Text="Fruits">
            <BitNavOption @ref="_bananaOption" Text="Banana" Key="banana" />
        </BitNavOption>
        <BitNavOption Text="Ice cream" Key="ice-cream" />
    </BitNav>
    <p>Bound: <span id="obound-selected">@(_boundSelected?.Text ?? "none")</span></p>
    <button id="obtn-select-banana" @onclick="() => _boundSelected = _bananaOption">Select Banana</button>
</E2ESection>

<E2ESection Id="icononly" Title="IconOnly">
    <BitNav Id="onav-icononly" TItem="BitNavOption" IconOnly Mode="BitNavMode.Manual">
        <BitNavOption Text="Home" IconName="@BitIconName.Home" />
        <BitNavOption Text="Mail" IconName="@BitIconName.Mail" Badge="3" />
    </BitNav>
</E2ESection>

<E2ESection Id="expand" Title="Expand and Collapse">
    <BitNav Id="onav-single" TItem="BitNavOption" SingleExpand Mode="BitNavMode.Manual">
        <BitNavOption Text="Alpha"><BitNavOption Text="Alpha one" /></BitNavOption>
        <BitNavOption Text="Beta"><BitNavOption Text="Beta one" /></BitNavOption>
    </BitNav>
    <BitNav Id="onav-all" TItem="BitNavOption" AllExpanded Mode="BitNavMode.Manual">
        <BitNavOption Text="Alpha"><BitNavOption Text="Alpha one"><BitNavOption Text="Alpha deep" /></BitNavOption></BitNavOption>
    </BitNav>
    <BitNav Id="onav-nocollapse" TItem="BitNavOption" NoCollapse Mode="BitNavMode.Manual">
        <BitNavOption Text="Alpha"><BitNavOption Text="Alpha one" /></BitNavOption>
    </BitNav>
</E2ESection>

<E2ESection Id="chevron" Title="Chevron and Indentation">
    <BitNav Id="onav-reversed" TItem="BitNavOption" ReversedChevron AllExpanded IndentValue="30" Mode="BitNavMode.Manual">
        <BitNavOption Text="Parent"><BitNavOption Text="Child" /></BitNavOption>
    </BitNav>
</E2ESection>

<E2ESection Id="templates" Title="Custom templates">
    <BitNav Id="onav-templates" TItem="BitNavOption" Mode="BitNavMode.Manual">
        <ItemTemplate Context="option">
            <span class="onav-item-template">Item template: @option.Text</span>
        </ItemTemplate>
        <ItemSuffixTemplate Context="option">
            <span class="onav-suffix">@option.Data</span>
        </ItemSuffixTemplate>
        <Options>
            <BitNavOption Text="Plain" Data="@("7")" />
            <BitNavOption Text="Own">
                <Template Context="option"><span class="onav-own-template">Own template: @option.Text</span></Template>
            </BitNavOption>
            <BitNavOption Text="Replaced" TemplateRenderMode="BitNavItemTemplateRenderMode.Replace">
                <Template Context="option"><div class="onav-replaced">Replaced: @option.Text</div></Template>
            </BitNavOption>
            <BitNavOption Text="Own suffix" Data="@("8")">
                <SuffixTemplate Context="option"><span class="onav-own-suffix">own @option.Data</span></SuffixTemplate>
            </BitNavOption>
        </Options>
    </BitNav>
</E2ESection>

<E2ESection Id="api" Title="Public API">
    <button id="obtn-expand-all" @onclick="() => _apiNav.ExpandAll()">ExpandAll</button>
    <button id="obtn-collapse-all" @onclick="() => _apiNav.CollapseAll()">CollapseAll</button>
    <button id="obtn-toggle" @onclick="() => _apiNav.ToggleItem(_fruitsOption)">Toggle Fruits</button>
    <button id="obtn-select" @onclick="() => _apiNav.SelectItem(_iceCreamOption)">Select Ice cream</button>
    <button id="obtn-focus" @onclick="() => _apiNav.FocusItem(_veggieOption)">Focus Veggie burger</button>
    <BitNav @ref="_apiNav" Id="onav-api" TItem="BitNavOption" Mode="BitNavMode.Manual">
        <BitNavOption @ref="_fruitsOption" Text="Fruits"><BitNavOption Text="Apple" /></BitNavOption>
        <BitNavOption Text="Fast foods">
            <BitNavOption Text="Vegetarian">
                <BitNavOption @ref="_veggieOption" Text="Veggie burger" />
            </BitNavOption>
        </BitNavOption>
        <BitNavOption @ref="_iceCreamOption" Text="Ice cream" />
    </BitNav>
</E2ESection>

<E2ESection Id="events" Title="Events">
    <BitNav Id="onav-events"
            TItem="BitNavOption"
            Mode="BitNavMode.Manual"
            OnItemClick="(BitNavOption option) => { _clicks++; _lastClicked = option.Text; }"
            OnSelectItem="(BitNavOption option) => { _selects++; _lastSelected = option?.Text; }"
            OnItemToggle="(BitNavOption option) => { _toggles++; _lastToggled = option.Text; }">
        <BitNavOption Text="Fruits"><BitNavOption Text="Apple" /></BitNavOption>
        <BitNavOption Text="Ice cream" />
    </BitNav>
    <p>
        <span id="oevent-clicks">@_clicks</span> <span id="oevent-last-clicked">@_lastClicked</span>
        <span id="oevent-selects">@_selects</span> <span id="oevent-last-selected">@_lastSelected</span>
        <span id="oevent-toggles">@_toggles</span> <span id="oevent-last-toggled">@_lastToggled</span>
    </p>
    <BitNav Id="onav-reselectable" TItem="BitNavOption" Mode="BitNavMode.Manual" Reselectable OnSelectItem="(BitNavOption option) => _reselects++">
        <BitNavOption Text="Again" />
    </BitNav>
    <p><span id="oreselects">@_reselects</span></p>
</E2ESection>

<E2ESection Id="dynamic" Title="Options added and removed">
    <button id="obtn-toggle-middle" @onclick="() => _showMiddle = !_showMiddle">Toggle middle</button>
    <BitNav Id="onav-dynamic" TItem="BitNavOption" Mode="BitNavMode.Manual">
        <BitNavOption Text="First" />
        @if (_showMiddle)
        {
            <BitNavOption Text="Middle" />
        }
        <BitNavOption Text="Last" />
    </BitNav>
</E2ESection>

<E2ESection Id="params" Title="Cascading parameters">
    <BitParams Parameters="@([new BitNavParams { IconOnly = true, Color = BitColor.Success }])">
        <BitNav Id="onav-params" TItem="BitNavOption">
            <BitNavOption Text="Home" IconName="@BitIconName.Home" />
        </BitNav>
    </BitParams>
</E2ESection>

<E2ESection Id="look" Title="Color, Size, Styles and Classes">
    <BitNav Id="onav-look"
            TItem="BitNavOption"
            Mode="BitNavMode.Manual"
            Color="BitColor.Tertiary"
            Size="BitSize.Small"
            Styles="@(new() { ItemText = "letter-spacing: 3px;" })"
            Classes="@(new() { ItemIcon = "custom-look-icon" })">
        <BitNavOption Text="Home" IconName="@BitIconName.Home" />
    </BitNav>
</E2ESection>

<E2ESection Id="rtl" Title="RTL">
    <BitNav Id="onav-rtl" TItem="BitNavOption" Dir="BitDir.Rtl" Mode="BitNavMode.Manual" FullWidth>
        <BitNavOption Text="Rtl parent"><BitNavOption Text="Rtl child" /></BitNavOption>
        <BitNavOption Text="Rtl sibling" />
    </BitNav>
</E2ESection>

<E2ESection Id="disabled" Title="Disabled">
    <BitNav Id="onav-disabled" TItem="BitNavOption" Disabled Mode="BitNavMode.Manual" OnItemClick="(BitNavOption option) => _disabledClicks++">
        <BitNavOption Text="Link" Url="/e2e/nav/url/x" />
        <BitNavOption Text="Button" />
    </BitNav>
    <p><span id="odisabled-clicks">@_disabledClicks</span></p>
</E2ESection>

<E2EStatus />

@code {
    private string? _selectedKey;

    private BitNav<BitNavOption> _boundNav = default!;
    private BitNavOption? _boundSelected;
    private BitNavOption? _bananaOption;

    private BitNav<BitNavOption> _apiNav = default!;
    private BitNavOption _fruitsOption = default!;
    private BitNavOption _iceCreamOption = default!;
    private BitNavOption _veggieOption = default!;

    private int _clicks;
    private string? _lastClicked;
    private int _selects;
    private string? _lastSelected;
    private int _toggles;
    private string? _lastToggled;
    private int _reselects;

    private bool _showMiddle;

    private int _disabledClicks;
}
