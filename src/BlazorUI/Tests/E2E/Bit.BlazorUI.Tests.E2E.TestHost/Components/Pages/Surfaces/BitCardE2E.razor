    private int _clickFooter;
    private int _disabledClicks;
    private bool _selected;
    private int _parentClicks;
    private int _stopClicks;

    private bool _pinned;

    private bool _loading = true;

    private int? _elevation = 0;

    private readonly (string Name, BitColorKind Kind)[] _kinds =
    [
        ("primary", BitColorKind.Primary),
        ("secondary", BitColorKind.Secondary),
        ("tertiary", BitColorKind.Tertiary),
        ("transparent", BitColorKind.Transparent),
    ];

    private int _optionClicks;
    private int _listItemClicks;
