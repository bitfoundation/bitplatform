    private async Task LoadingClick()
    {
        _loadingClicks++;
        _loadingTcs = new();
        await _loadingTcs.Task;
    }

    private void AddItem()
    {
        _dynamicCounter++;
        _dynamic = [.. _dynamic, new() { Key = $"n{_dynamicCounter}", Text = $"New {_dynamicCounter}" }];
    }

    private void ChangeRerender()
    {
        _rerenderText = "After";
        _rerenderVariant = BitVariant.Outline;
        _rerenderColor = BitColor.Error;
        _rerenderSize = BitSize.Large;
        _rerenderSplit = true;
        _rerenderIcon = BitIconName.Add;
    }

