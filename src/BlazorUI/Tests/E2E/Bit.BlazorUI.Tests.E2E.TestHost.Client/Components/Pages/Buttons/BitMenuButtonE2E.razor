    // The page's own handlers of the events that activate an element, splatted onto the root: written as @onclick on
    // the component they would be taken for its OnClick parameter.
    private readonly Dictionary<string, object> _disabledPageHandlers;

    public BitMenuButtonE2E()
    {
        _disabledPageHandlers = new()
        {
            ["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, () => _disabledPageEvents++),
            ["onmousedown"] = EventCallback.Factory.Create<MouseEventArgs>(this, () => _disabledPageEvents++),
        };
        _splitSticky =
        [
            new() { Key = "add", Text = "Add", OnClick = _ => { _splitStickyActions++; InvokeAsync(StateHasChanged); } },
            new() { Key = "edit", Text = "Edit", OnClick = _ => { _splitStickyActions += 10; InvokeAsync(StateHasChanged); } }
        ];
        _submenu = Submenu();
        _rtlSubmenu = Submenu();
        _rtlInheritedSubmenu = Submenu();
        _stylesItems = StyledParts();
        _classesItems = StyledParts();
    }

    // One list per menu, made once, for the menus whose items are plain.
    private List<BitMenuButtonItem> L(string id)
    {
        if (_lists.TryGetValue(id, out var list) is false)
        {
            _lists[id] = list = Basic();
        }

        return list;
    }

