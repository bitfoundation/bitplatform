    private static string Fmt(DateTimeOffset? value) => value?.ToString("yyyy-MM-dd HH:mm zzz", CultureInfo.InvariantCulture) ?? "null";

    private void HandleEventDaySelect(DateTimeOffset? date)
    {
        if (date is null)
        {
            _eventsOfDay = "-";
            return;
        }

        var day = DateOnly.FromDateTime(date.Value.Date);
        var titles = _events.Where(e => e.Date == day).Select(e => e.Title).ToArray();
        _eventsOfDay = titles.Length == 0 ? "none" : string.Join(", ", titles);
    }

    // The Persian calendar the way the demo's CultureInfoHelper builds it: fa-IR with its Farsi names on the Persian
    // calendar, whatever the runtime picks for the culture by default.
    private static CultureInfo CreateFaIrCulture()
    {
        var culture = CultureInfo.CreateSpecificCulture("fa-IR");
        culture.GetType().GetField("_calendar", BindingFlags.NonPublic | BindingFlags.Instance)!.SetValue(culture, new PersianCalendar());
        culture.DateTimeFormat.AMDesignator = "ق.ظ";
        culture.DateTimeFormat.PMDesignator = "ب.ظ";
        culture.DateTimeFormat.ShortDatePattern = "yyyy/MM/dd";
        culture.DateTimeFormat.AbbreviatedDayNames = ["ی", "د", "س", "چ", "پ", "ج", "ش"];
        culture.DateTimeFormat.ShortestDayNames = ["ی", "د", "س", "چ", "پ", "ج", "ش"];
        return culture;
    }

