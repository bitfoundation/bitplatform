@page "/e2e/checkbox/autofocus"

<PageTitle>BitCheckbox AutoFocus E2E</PageTitle>

<h1>BitCheckbox AutoFocus</h1>

<E2ESection Id="autofocus" Title="AutoFocus">
    <button id="btn-first">First focusable</button>
    <BitCheckbox Id="cb-autofocus" Label="Focused on its first render" AutoFocus />
    <BitCheckbox Id="cb-autofocus-disabled" Label="Disabled, never focused" AutoFocus Disabled />
</E2ESection>

<E2EStatus />
