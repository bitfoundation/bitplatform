        new() { Min = "0", Max = "500", Step = "5", Suffix = "cm", Underlined = true, ShowClearButton = true, Accent = BitColor.Info, Mode = BitSpinButtonMode.Compact, Description = "Between 0 and 500, in steps of 5." }
    ];

    private bool _mounted = true;

    protected override void OnInitialized()
    {
        _disabledRootAttributes = new()
        {
            ["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, () => _disabledRootClicks++),
            ["onmouseover"] = EventCallback.Factory.Create<MouseEventArgs>(this, () => _disabledRootHovers++)
        };
    }

    private void ChangeParams()
    {
        _dynLabel = "Second label";
        _dynMode = BitSpinButtonMode.Inline;
        _dynMax = "3";
    }

    private void ThrottleCommitted()
    {
        _throttleCount++;
        _throttleFirst ??= _throttleValue;
    }

    private Task ApiIncrement() => _apiRef?.IncrementAsync() ?? Task.CompletedTask;

    private Task ApiDecrement() => _apiRef?.DecrementAsync() ?? Task.CompletedTask;

    private Task ApiClear() => _apiRef?.ClearAsync() ?? Task.CompletedTask;

    private async Task ApiFocus()
    {
        if (_apiRef is not null) await _apiRef.FocusAsync();
    }

    private async Task ApiFocusHide()
    {
        if (_apiHideRef is not null) await _apiHideRef.FocusAsync();
    }

    private static string? CustomDigitsNormalizer(string? value)
    {
        if (string.IsNullOrEmpty(value)) return value;

        var chars = value.Where(c => c != '٬' && c != ',').Select(c => c is >= '۰' and <= '۹' ? (char)('0' + (c - '۰')) : c).ToArray();

        return new string(chars);
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Enter an age")]
        [Range(1, 150, ErrorMessage = "Nobody is that old")]
        public int? Age { get; set; }

        public double Weight { get; set; }

        [Range(0, 100, ErrorMessage = "The percentage must be between 0 and 100")]
        public int Percentage { get; set; }

        [Range(1, 10, ErrorMessage = "Ignored out of range")]
        public int Ignored { get; set; }
    }
