@page "/e2e/toggle/autofocus"

<PageTitle>BitToggle AutoFocus E2E</PageTitle>

<h1>BitToggle AutoFocus</h1>

<E2ESection Id="autofocus" Title="AutoFocus">
    <button id="btn-first">First focusable</button>
    <BitToggle Id="tg-autofocus" Label="Focused on its first render" AutoFocus />
    <BitToggle Id="tg-autofocus-disabled" Label="Disabled, never focused" AutoFocus Disabled />
</E2ESection>

<E2EStatus />
