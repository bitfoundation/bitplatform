    private void Log(string entry) => _log.Add(entry);

    private static string NormalizeHashtag(string tag) => string.Concat(tag.TrimStart('#').Where(c => char.IsWhiteSpace(c) is false)).ToLowerInvariant();

    private static string? EmailInvalidMessage(BitTagsInputInvalidArgs args) => args.Reason == BitTagsInputInvalidReason.Pattern ? $"'{args.Tag}' is not an email address." : null;

    private static bool ValidateFramework(string tag) => tag is "blazor" or "react" or "vue" or "angular";

    private static string PersonName(string tag) => tag switch
    {
        "ada@example.com" => "Ada Lovelace",
        "grace@example.com" => "Grace Hopper",
        _ => tag
    };

    private static string? RecipientStyle(string tag) => Regex.IsMatch(tag, EmailPattern) ? null : "background: rgb(253, 231, 233); color: rgb(164, 38, 44); border-color: rgb(164, 38, 44);";

    private static string? PriorityClass(string tag) => tag switch
    {
        "high" => "priority-high",
