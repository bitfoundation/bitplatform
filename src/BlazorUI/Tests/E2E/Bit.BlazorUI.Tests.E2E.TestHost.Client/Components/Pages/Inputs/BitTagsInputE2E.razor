    };

    private void HandleEdit(BitTagsInputEditArgs args)
    {
        _editArgs = $"{args.Tag}->{args.NewTag}";
        if (args.NewTag == "cancelme") args.Cancel = true;
        if (args.NewTag == "rewrite") args.NewTag = "rewritten";
    }

    private void HandleBeforeClear(BitTagsInputClearArgs args)
    {
        _clearGuardArgs = string.Join('|', args.Tags);
        args.Cancel = args.Tags.Count > 2;
    }

    private void HandleBeforeAdd(BitTagsInputBeforeArgs args)
    {
        if (args.Tag == "block")
        {
            args.Cancel = true;
            Log("cancelled:block");
            return;
        }

        if (args.Tag == "me") args.Tag = "me-corrected";
    }

    private void HandleBeforeRemove(BitTagsInputBeforeArgs args)
    {
        if (args.Tag == "blazor")
        {
            args.Cancel = true;
            Log("kept:blazor");
        }
    }

    private async Task HandleAsyncInput(string text)
    {
        _asyncCalls++;
        _asyncLoading = true;
        StateHasChanged();
        await Task.Delay(400);
        _asyncSuggestions = _countries.Where(c => c.Contains(text, StringComparison.OrdinalIgnoreCase)).ToList();
        _asyncLoading = false;
    }

