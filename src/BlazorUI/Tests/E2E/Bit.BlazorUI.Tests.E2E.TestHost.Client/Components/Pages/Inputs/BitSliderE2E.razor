    private static string Text(BitSliderRangeValue? range) => range is null ? "null" : $"{range.Lower.ToString(CultureInfo.InvariantCulture)}-{range.Upper.ToString(CultureInfo.InvariantCulture)}";

    private static string TimeText(double minutes) => TimeSpan.FromMinutes(minutes).ToString(@"hh\:mm", CultureInfo.InvariantCulture);

    private static string QualityText(double value) => value switch
    {
        0 => "Draft",
        1 => "Low",
        2 => "Medium",
        3 => "High",
        _ => "Lossless"
    };

    private async Task FocusLower()
    {
        if (_focusSlider is not null) await _focusSlider.FocusAsync();
    }

    private async Task FocusUpper()
    {
        if (_focusSlider is not null) await _focusSlider.FocusUpperAsync();
    }

    public class SliderModel
    {
        [Range(typeof(double), "4", "7", ErrorMessage = "Pick at least {1} days a week")]
        public double Days { get; set; }

        [MinimumRangeLength(20, ErrorMessage = "Cover a span of at least 20")]
        public BitSliderRangeValue? Budget { get; set; } = new(40, 50);
    }

    [AttributeUsage(AttributeTargets.Property)]
    public sealed class MinimumRangeLengthAttribute(double minimum) : ValidationAttribute
    {
        public override bool IsValid(object? value) => value is BitSliderRangeValue range && range.Length >= minimum;
    }
}
