        <BitTimePicker Dir="BitDir.Rtl" Standalone Label="زمان" TimeFormat="BitTimeFormat.TwelveHours" DefaultValue="new(10, 24, 0)" Culture="_en" />
    </div>
    <div id="rtl-field">
        <BitTimePicker Dir="BitDir.Rtl" ShowCloseButton Label="زمان" Culture="_en" />
    </div>
    <div id="ltr-field">
        <BitTimePicker ShowCloseButton Label="LTR" Culture="_en" />
    </div>
    <div id="rtl-inherited" dir="rtl">
        <BitTimePicker Label="Inherited" ShowCloseButton Culture="_en" />
    </div>
