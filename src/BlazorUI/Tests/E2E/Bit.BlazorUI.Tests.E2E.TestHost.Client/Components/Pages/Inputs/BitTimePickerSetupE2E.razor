@page "/e2e/time-picker/setup"
@using System.Globalization

<PageTitle>BitTimePicker setup E2E</PageTitle>

<h1>BitTimePicker first-render setups</h1>

@* The setups that act on the first render - a focus taken or a callout opened - each on a page of its own, so
   none of them takes the focus or covers the page with an overlay in the tests of the main page. *@
<E2ESection Id="setup" Title="@Mode">
    @switch (Mode)
    {
        case "autofocus-standalone":
            <BitTimePicker Label="Standalone AutoFocus" AutoFocus Standalone Culture="_en" />
            break;
        case "open":
            <BitTimePicker Label="Initially open" IsOpen="_isOpen" IsOpenChanged="v => _isOpen = v" Culture="_en" />
            break;
        default:
            <BitTimePicker Label="AutoFocus" AutoFocus Culture="_en" OnFocus="() => _focuses++" />
            break;
    }
    <span id="focus-count">@_focuses</span>
    <span id="is-open">@_isOpen</span>
</E2ESection>

<E2EStatus />

@code {
    private static readonly CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    private int _focuses;
    private bool _isOpen = true;

    [SupplyParameterFromQuery] public string? Mode { get; set; }
}
