    private int _dynamicCounter;

    private void AddRootItem() => _dynamicItems.Add(Leaf($"Added {++_dynamicCounter}"));

    private void AddChildItem() => _dynamicItems[0].ChildItems.Add(Leaf($"Added child {++_dynamicCounter}"));

    private void RemoveRootItem() => _dynamicItems.RemoveAt(_dynamicItems.Count - 1);

    // A brand new tree of new instances: the nav carries the expansion state over by each item's place in the tree.
    private void RebuildItems()
    {
        _dynamicItems = [.. _dynamicItems.Select(Clone)];

        static BitNavItem Clone(BitNavItem item) => new() { Text = item.Text, ChildItems = [.. item.ChildItems.Select(Clone)] };
    }

