    private void CycleLifecycleSize()
    {
        _lifecycleSize = _lifecycleSize switch
        {
            null => BitSize.Small,
            BitSize.Small => BitSize.Medium,
            BitSize.Medium => BitSize.Large,
            _ => null
        };
    }

    private void ToggleRenderType()
    {
        _lifecycleRenderType = _lifecycleRenderType is BitNavRenderType.Normal ? BitNavRenderType.Grouped : BitNavRenderType.Normal;
    }

