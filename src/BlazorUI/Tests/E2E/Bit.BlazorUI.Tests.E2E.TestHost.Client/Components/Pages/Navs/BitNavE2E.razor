    ];

    // New instances in the reverse order: the nav carries each item's expansion state over by its Key.
    private void ReverseKeyedItems()
    {
        _keyedItems = [.. _keyedItems.AsEnumerable().Reverse().Select(i => new BitNavItem { Key = i.Key, Text = i.Text, ChildItems = [Leaf(i.ChildItems[0].Text)] })];
    }

