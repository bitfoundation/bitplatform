@page "/e2e/sortable/events"

@* Two BitSortable lists of one group that log every event of the drag lifecycle, newest on top. A line reads
   "[OnAdd @events-right] item='Item 4' events-left#3 -> events-right#0 (mouse)": the event, the list that raised it,
   the item, where it came from and where it went, then how it was dragged and the flags that are set. OnChange is
   logged only once the checkbox asks for it. *@

<PageTitle>BitSortable events E2E</PageTitle>

<BitSortableE2EStyles />

<h1>BitSortable events</h1>

<E2ESection Id="events" Title="Events">
    <div class="srt-controls">
        <label><input id="events-log-change" type="checkbox" @bind="_logChange" /> Log OnChange too</label>
        <button type="button" id="events-clear" @onclick="() => _log.Clear()">Clear the log</button>
    </div>
    <div class="srt-cols">
        <div class="srt-col">
            <BitSortable @bind-Items="_left" TItem="string" Group="ev" Id="events-left" AriaLabel="Left"
                         Class="demo-list" Classes="_classes"
                         OnStart='e => Log("OnStart", "events-left", e)'
                         OnChange='e => Log("OnChange", "events-left", e)'
                         OnUpdate='e => Log("OnUpdate", "events-left", e)'
                         OnRemove='e => Log("OnRemove", "events-left", e)'
                         OnAdd='e => Log("OnAdd", "events-left", e)'
                         OnSort='e => Log("OnSort", "events-left", e)'
                         OnEnd='e => Log("OnEnd", "events-left", e)'>
                <ItemTemplate Context="item">@item</ItemTemplate>
            </BitSortable>
        </div>
        <div class="srt-col">
            <BitSortable @bind-Items="_right" TItem="string" Group="ev" Id="events-right" AriaLabel="Right"
                         Class="demo-list" Classes="_classes"
                         OnStart='e => Log("OnStart", "events-right", e)'
                         OnChange='e => Log("OnChange", "events-right", e)'
                         OnUpdate='e => Log("OnUpdate", "events-right", e)'
                         OnRemove='e => Log("OnRemove", "events-right", e)'
                         OnAdd='e => Log("OnAdd", "events-right", e)'
                         OnSort='e => Log("OnSort", "events-right", e)'
                         OnEnd='e => Log("OnEnd", "events-right", e)'>
                <ItemTemplate Context="item">@item</ItemTemplate>
            </BitSortable>
        </div>
    </div>
    <p class="demo-order">Left: <span id="events-left-order">@string.Join(", ", _left)</span></p>
    <p class="demo-order">Right: <span id="events-right-order">@string.Join(", ", _right)</span></p>
    <div class="srt-log" id="events-log">
        @if (_log.Count == 0)
        {
            <div class="event-log__empty">No events yet</div>
        }
        @foreach (var line in _log)
        {
            <div class="event-log__line">@line</div>
        }
    </div>
</E2ESection>

<E2EStatus />

@code {
    private readonly BitSortableClassStyles _classes = new() { Item = "demo-item", Ghost = "demo-ghost" };

    private IList<string> _left = new List<string> { "Item 1", "Item 2", "Item 3", "Item 4" };
    private IList<string> _right = new List<string> { "Item A", "Item B" };
    private readonly List<string> _log = [];
    private bool _logChange;

    private void Log(string name, string list, BitSortableEventArgs<string> e)
    {
        if (name == "OnChange" && !_logChange) return;

        var flags = string.Join(", ", new[] { e.Input.ToString().ToLowerInvariant(), e.IsClone ? "clone" : null, e.Canceled ? "canceled" : null }.OfType<string>());
        _log.Insert(0, $"[{name} @{list}] item='{e.Item}' {e.FromId}#{e.OldIndex} -> {e.ToId}#{e.NewIndex} ({flags})");
        if (_log.Count > 40) _log.RemoveAt(_log.Count - 1);
    }
}
