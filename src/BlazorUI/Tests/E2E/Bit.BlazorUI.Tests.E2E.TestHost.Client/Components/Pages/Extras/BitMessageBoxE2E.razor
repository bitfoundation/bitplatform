            { nameof(BitMessageBox.Buttons), BitMessageBoxButtons.OkCancel },
            { nameof(BitMessageBox.OnResult), EventCallback.Factory.Create<BitMessageBoxResult>(this, r => modalRef.CloseWith(r)) }
