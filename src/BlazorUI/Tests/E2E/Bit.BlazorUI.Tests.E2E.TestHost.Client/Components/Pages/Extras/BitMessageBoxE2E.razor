    private async Task ReportPrompt(Task<string?> prompt)
    {
        _promptResult = "pending";
        try
        {
            _promptResult = await prompt;
        }
        catch (Exception ex)
        {
            _promptError = ex.Message;
            _promptResult = "threw";
        }
        _promptCount++;
    }

