    private void OnBasicSortChange(IReadOnlyList<BitDataGridSortDescriptor> sorts)
    {
        _basicSortCount++;
        _basicSortLog = string.Join(",", sorts.Select(s => $"{s.ColumnId}:{s.Direction}:{s.Priority}"));
    }

    private static string CellArgs(BitDataGridCellEventArgs<Product> a)
        => $"{a.Item.Name}|{a.ColumnId}|{a.ColumnTitle}|{a.Value}|button={a.Mouse.Button}|title={a.Column.Title}";

    // A new list rather than a mutation of the bound one: the grid reloads when the Items reference changes.
    private void AddLifecycleItem()
    {
        _lifecycleItems = [.. _lifecycleItems, new() { Id = _lifecycleItems.Count + 1, Name = $"Added {_lifecycleItems.Count + 1}" }];
    }

    private void RenameLifecycleColumn() => _lifecycleTitle = "Renamed";
