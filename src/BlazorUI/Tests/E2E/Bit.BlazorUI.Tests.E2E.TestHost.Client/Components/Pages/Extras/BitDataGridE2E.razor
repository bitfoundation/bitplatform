    // Stock ascending puts the rows in stock first and the sold-out ones last.
    private readonly IComparer<object?> _inStockFirst = Comparer<object?>.Create((a, b) =>
    {
        var x = (int)a!;
        var y = (int)b!;
        var outX = x == 0;
        var outY = y == 0;
        return outX != outY ? (outX ? 1 : -1) : x.CompareTo(y);
    });

