@page "/e2e/map/providers"
@using System.Globalization
@inject NavigationManager Navigation

<PageTitle>BitMap providers E2E</PageTitle>

<h1>BitMap providers</h1>

@* The two other providers that need no key. Their libraries come from a CDN (OpenLayers from esm.sh and jsDelivr,
   MapLibre from unpkg), so this page needs the network; the tiles are the host's own image either way. *@

@* Rendered on demand, so opening the page makes no request off this machine. *@
<button id="btn-load" @onclick="() => _load = true">Load the maps</button>

@if (_load)
{
    <E2ESection Id="openlayers" Title="OpenLayers">
        <div class="map-box">
            <BitMap @ref="_olMap" TMapProvider="BitOpenLayersMapProvider" Id="map-ol" Provider="_olProvider" Markers="_markers"
                    AriaLabel="OpenLayers map"
                    OnMarkerClick="id => _olMarker = id"
                    OnMarkerDoubleClick="id => _olMarkerDouble = id"
                    OnDoubleClick="_ => _olMapDoubleClicks++"
                    OnLoadStateChanged="s => _olState = s.ToString()"
                    @bind-Zoom="_olZoom" />
        </div>
        <button id="btn-ol-zoom-in" @onclick="@(async () => await _olMap.ZoomIn(animate: false))">ZoomIn</button>
        <button id="btn-ol-project" @onclick="ProjectBigBen">Project Big Ben</button>
        <span id="ol-projected">@(_olProjected ?? "none")</span>
        <span id="ol-state">@(_olState ?? "none")</span>
        <span id="ol-marker">@(_olMarker ?? "none")</span>
        <span id="ol-marker-double">@(_olMarkerDouble ?? "none")</span>
        <span id="ol-map-double-clicks">@_olMapDoubleClicks</span>
        <span id="ol-zoom">@(_olZoom?.ToString("F1", CultureInfo.InvariantCulture) ?? "null")</span>
    </E2ESection>

    <E2ESection Id="maplibre" Title="MapLibre">
        <div class="map-box">
            <BitMap @ref="_glMap" TMapProvider="BitMapLibreMapProvider" Id="map-gl" Provider="_glProvider" Markers="_markers"
                    AriaLabel="MapLibre map"
                    OnMarkerClick="id => _glMarker = id"
                    OnMarkerDoubleClick="id => _glMarkerDouble = id"
                    OnDoubleClick="_ => _glMapDoubleClicks++"
                    OnLoadStateChanged="s => _glState = s.ToString()"
                    @bind-Zoom="_glZoom" />
        </div>
        <button id="btn-gl-zoom-in" @onclick="@(async () => await _glMap.ZoomIn(animate: false))">ZoomIn</button>
        <span id="gl-state">@(_glState ?? "none")</span>
        <span id="gl-marker">@(_glMarker ?? "none")</span>
        <span id="gl-marker-double">@(_glMarkerDouble ?? "none")</span>
        <span id="gl-map-double-clicks">@_glMapDoubleClicks</span>
        <span id="gl-zoom">@(_glZoom?.ToString("F1", CultureInfo.InvariantCulture) ?? "null")</span>
    </E2ESection>
}

@* ArcGIS needs no key either, but its SDK is far larger than the other two and its "osm" basemap draws OpenStreetMap's
   own tiles - the one map here whose tiles come off the network - so it is loaded on a demand of its own. *@
<button id="btn-load-arcgis" @onclick="() => _loadArcGis = true">Load the ArcGIS map</button>

@if (_loadArcGis)
{
    <E2ESection Id="arcgis" Title="ArcGIS">
        <div class="map-box">
            <BitMap @ref="_agMap" TMapProvider="BitArcGisMapProvider" Id="map-ag" Provider="_agProvider" Markers="_markers"
                    AriaLabel="ArcGIS map"
                    OnMarkerClick="id => _agMarker = id"
                    OnMarkerDoubleClick="id => _agMarkerDouble = id"
                    OnDoubleClick="_ => _agMapDoubleClicks++"
                    OnLoadStateChanged="s => _agState = s.ToString()"
                    @bind-Zoom="_agZoom" />
        </div>
        <button id="btn-ag-project" @onclick="ProjectBigBenOnArcGis">Project Big Ben</button>
        <span id="ag-projected">@(_agProjected ?? "none")</span>
        <span id="ag-state">@(_agState ?? "none")</span>
        <span id="ag-marker">@(_agMarker ?? "none")</span>
        <span id="ag-marker-double">@(_agMarkerDouble ?? "none")</span>
        <span id="ag-map-double-clicks">@_agMapDoubleClicks</span>
        <span id="ag-zoom">@(_agZoom?.ToString("F1", CultureInfo.InvariantCulture) ?? "null")</span>
    </E2ESection>
}

@* Cesium needs no key with its OpenStreetMap imagery, which comes off the network like ArcGIS's tiles, and its library is
   as large - so it is loaded on a demand of its own too. It draws markers on its canvas and drags them itself. *@
<button id="btn-load-cesium" @onclick="() => _loadCesium = true">Load the Cesium map</button>

@if (_loadCesium)
{
    <E2ESection Id="cesium" Title="Cesium">
        <div class="map-box">
            <BitMap @ref="_csMap" TMapProvider="BitCesiumMapProvider" Id="map-cs" Provider="_csProvider" Markers="_draggableMarkers"
                    AriaLabel="Cesium map"
                    OnMarkerClick="id => { _csMarkerClicks++; _csMarker = id; }"
                    OnMarkerDoubleClick="id => _csMarkerDouble = id"
                    OnMarkerDragEnd="e => _csDragEnd = e.Id"
                    OnDoubleClick="_ => _csMapDoubleClicks++"
                    OnLoadStateChanged="s => _csState = s.ToString()" />
        </div>
        <button id="btn-cs-project" @onclick="ProjectBigBenOnCesium">Project Big Ben</button>
        <span id="cs-projected">@(_csProjected ?? "none")</span>
        <span id="cs-state">@(_csState ?? "none")</span>
        <span id="cs-marker">@(_csMarker ?? "none")</span>
        <span id="cs-marker-clicks">@_csMarkerClicks</span>
        <span id="cs-marker-double">@(_csMarkerDouble ?? "none")</span>
        <span id="cs-drag-end">@(_csDragEnd ?? "none")</span>
        <span id="cs-map-double-clicks">@_csMapDoubleClicks</span>
    </E2ESection>
}

@* A round trip of its own, so a test knows every callback a map raised before it has been rendered. *@
<button id="btn-ping" @onclick="() => _pings++">Ping</button>
<span id="pings">@_pings</span>

<style>
    .map-box { width: 600px; height: 400px; }
</style>

<E2EStatus />

@code {
    private readonly BitOpenLayersMapProvider _olProvider = new()
    {
        TileUrl = "samples/map-tile.png?z={z}&x={x}&y={y}",
        Center = new(51.505, -0.09),
        Zoom = 13
    };

    private BitMapLibreMapProvider _glProvider = default!;

    private readonly BitArcGisMapProvider _agProvider = new()
    {
        BasemapId = "osm",
        Center = new(51.505, -0.09),
        Zoom = 13
    };

    // Centred on Big Ben: a zoom of Cesium's is a camera altitude, closer in than the same zoom elsewhere, which would
    // leave the marker off the edge of the other maps' view.
    private readonly BitCesiumMapProvider _csProvider = new()
    {
        Center = new(51.5007, -0.1246),
        Zoom = 12
    };

    private bool _load;
    private bool _loadArcGis;
    private bool _loadCesium;
    private int _pings;

    private readonly IEnumerable<BitMapMarker> _markers =
    [
        new() { Id = "big-ben", Position = new(51.5007, -0.1246), Alt = "Big Ben" },
        new() { Id = "tower", Position = new(51.5055, -0.0754), Alt = "Tower Bridge" }
    ];

    private readonly IEnumerable<BitMapMarker> _draggableMarkers =
    [
        new() { Id = "big-ben", Position = new(51.5007, -0.1246), Alt = "Big Ben", Draggable = true },
        new() { Id = "tower", Position = new(51.5055, -0.0754), Alt = "Tower Bridge" }
    ];

    private BitMap<BitOpenLayersMapProvider> _olMap = default!;
    private string? _olState;
    private string? _olMarker;
    private string? _olMarkerDouble;
    private int _olMapDoubleClicks;
    private double? _olZoom = 13;
    private string? _olProjected;

    private BitMap<BitMapLibreMapProvider> _glMap = default!;
    private string? _glState;
    private string? _glMarker;
    private string? _glMarkerDouble;
    private int _glMapDoubleClicks;
    private double? _glZoom = 13;

    private BitMap<BitArcGisMapProvider> _agMap = default!;
    private string? _agState;
    private string? _agMarker;
    private string? _agMarkerDouble;
    private int _agMapDoubleClicks;
    private double? _agZoom = 13;
    private string? _agProjected;

    private async Task ProjectBigBen()
    {
        var point = await _olMap.Project(new(51.5007, -0.1246));
        _olProjected = point is { } p ? string.Create(CultureInfo.InvariantCulture, $"{p.X:F0},{p.Y:F0}") : "null";
    }

    private BitMap<BitCesiumMapProvider> _csMap = default!;
    private string? _csState;
    private string? _csMarker;
    private int _csMarkerClicks;
    private string? _csMarkerDouble;
    private string? _csDragEnd;
    private int _csMapDoubleClicks;
    private string? _csProjected;

    private async Task ProjectBigBenOnCesium()
    {
        var point = await _csMap.Project(new(51.5007, -0.1246));
        _csProjected = point is { } p ? string.Create(CultureInfo.InvariantCulture, $"{p.X:F0},{p.Y:F0}") : "null";
    }

    private async Task ProjectBigBenOnArcGis()
    {
        var point = await _agMap.Project(new(51.5007, -0.1246));
        _agProjected = point is { } p ? string.Create(CultureInfo.InvariantCulture, $"{p.X:F0},{p.Y:F0}") : "null";
    }

    protected override void OnInitialized()
    {
        // A raster style of the host's own tile, handed over as a data URL so the tiles need no network either.
        var tile = $"{Navigation.BaseUri}samples/map-tile.png?gl=1&z={{z}}&x={{x}}&y={{y}}";
        var style = "{\"version\":8,\"sources\":{\"t\":{\"type\":\"raster\",\"tiles\":[\"" + tile + "\"],\"tileSize\":256}},\"layers\":[{\"id\":\"t\",\"type\":\"raster\",\"source\":\"t\"}]}";
        _glProvider = new()
        {
            StyleUrl = "data:application/json;charset=utf-8," + Uri.EscapeDataString(style),
            Center = new(51.505, -0.09),
            Zoom = 13
        };
    }
}
