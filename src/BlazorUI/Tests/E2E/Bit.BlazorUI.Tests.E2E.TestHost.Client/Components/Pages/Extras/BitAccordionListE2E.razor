    private async Task HandleOnToggling(BitAccordionListToggleArgs<BitAccordionListItem> args)
    {
        _togglingReport = $"{args.Key}:{(args.IsExpanding ? "expanding" : "collapsing")}:{args.Reason}";
        Log($"tg:toggling:{args.Key}:{args.IsExpanding}:{args.Reason}");

        if (_slowToggling)
        {
            StateHasChanged();
            await _togglingGate.Task;
            _togglingGate = new(TaskCreationOptions.RunContinuationsAsynchronously);
        }

        args.Cancel = _lockToggling;
    }

    private async Task HoldToggling(BitAccordionListToggleArgs<BitAccordionListItem> args)
    {
        await _holdGate.Task;
        _holdGate = new(TaskCreationOptions.RunContinuationsAsynchronously);
    }

    private void ReadMethodsState()
    {
        _methodsState = $"{string.Join("|", _methodsRef!.GetExpandedKeys())};users={_methodsRef.IsExpanded("users")};none={_methodsRef.IsExpanded(null)}";
    }

    private void AddItem()
    {
        _added++;
        _dynamicItems = [.. _dynamicItems, new() { Key = $"n{_added}", Title = $"New {_added}", Body = Body($"new-{_added}-body", $"New {_added}") }];
    }

    private void RemoveItem()
    {
        _dynamicItems = [.. _dynamicItems.Skip(1)];
    }
