@page "/e2e/sortable/touch"

@* BitSortable dragged by pointer events rather than the browser's drag and drop: a list a finger picks an item up
   from with a long press (TouchDelay), one whose handle drags at once (TouchDelay="0"), and one the mouse drags the
   same way (ForceFallback), a preview of the item following the pointer. *@

<PageTitle>BitSortable touch and pen E2E</PageTitle>

<BitSortableE2EStyles />

<h1>BitSortable touch and pen</h1>

<E2ESection Id="touch" Title="Touch, pen and ForceFallback">
    <div class="srt-cols">
        <div class="srt-col">
            <p class="srt-col-title">Long press</p>
            <BitSortable @bind-Items="_longPress" TItem="string" Id="touch-list" AriaLabel="Long press"
                         TouchDelay="200" Class="demo-list" Classes="_classes">
                <ItemTemplate Context="item">@item</ItemTemplate>
            </BitSortable>
        </div>
        <div class="srt-col">
            <p class="srt-col-title">Handle, at once</p>
            <BitSortable @bind-Items="_handle" TItem="string" Id="touch-handle-list" AriaLabel="Handle, at once"
                         Handle=".handle" TouchDelay="0" Class="demo-list" Classes="_classes">
                <ItemTemplate Context="item"><span class="handle touch-handle" aria-hidden="true">☰</span>@item</ItemTemplate>
            </BitSortable>
        </div>
        <div class="srt-col">
            <p class="srt-col-title">Mouse too (ForceFallback)</p>
            <BitSortable @bind-Items="_fallback" TItem="string" Id="touch-fallback-list" AriaLabel="Mouse too"
                         ForceFallback="true" Class="demo-list" Classes="_classes">
                <ItemTemplate Context="item">@item</ItemTemplate>
            </BitSortable>
        </div>
    </div>
    <p class="demo-order">Long press: <span id="touch-order">@string.Join(", ", _longPress)</span></p>
    <p class="demo-order">Handle: <span id="touch-handle-order">@string.Join(", ", _handle)</span></p>
    <p class="demo-order">Mouse too: <span id="touch-fallback-order">@string.Join(", ", _fallback)</span></p>
</E2ESection>

<E2ESection Id="touch-shared" Title="Touch across lists">
    <div class="srt-cols">
        <div class="srt-col">
            <BitSortable @bind-Items="_a" TItem="string" Group="touch-shared" Id="shared-a" AriaLabel="List A"
                         Class="demo-list" Classes="_classes">
                <ItemTemplate Context="item">@item</ItemTemplate>
            </BitSortable>
        </div>
        <div class="srt-col">
            <BitSortable @bind-Items="_b" TItem="string" Group="touch-shared" Id="shared-b" AriaLabel="List B"
                         Class="demo-list" Classes="_classes">
                <ItemTemplate Context="item">@item</ItemTemplate>
            </BitSortable>
        </div>
    </div>
    <p class="demo-order">A: <span id="shared-a-order">@string.Join(", ", _a)</span></p>
    <p class="demo-order">B: <span id="shared-b-order">@string.Join(", ", _b)</span></p>
</E2ESection>

<E2EStatus />

@code {
    private readonly BitSortableClassStyles _classes = new() { Item = "demo-item", Ghost = "demo-ghost" };

    private IList<string> _longPress = new List<string> { "Apples", "Bread", "Coffee", "Dates", "Eggs" };
    private IList<string> _handle = new List<string> { "Flour", "Grapes", "Honey", "Ice", "Jam" };
    private IList<string> _fallback = new List<string> { "Kale", "Lemons", "Milk", "Nuts", "Oats" };

    private IList<string> _a = new List<string> { "A1", "A2", "A3", "A4", "A5" };
    private IList<string> _b = new List<string> { "B1", "B2", "B3", "B4", "B5" };
}
