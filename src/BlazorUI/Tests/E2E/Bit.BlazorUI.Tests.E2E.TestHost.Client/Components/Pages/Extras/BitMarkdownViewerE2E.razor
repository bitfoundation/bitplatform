    private int _parseCount;
    private string _documentInfo = string.Empty;
    private BitMarkdownViewer? _runtimeViewer;
    private bool _mounted = true;

    private void HandleFrontMatterParsed(BitMarkdownDocumentNode document)
    {
        var frontMatter = BitMarkdownFrontMatterNode.Find(document);
        _frontMatterText = frontMatter is null ? "(none)" : $"{frontMatter.Fence}|{frontMatter.IsToml}|{frontMatter.Text.ReplaceLineEndings(" | ")}";
    }

    private void HandleTomlParsed(BitMarkdownDocumentNode document)
    {
        var frontMatter = BitMarkdownFrontMatterNode.Find(document);
        _tomlText = frontMatter is null ? "(none)" : $"{frontMatter.Fence}|{frontMatter.IsToml}|{frontMatter.Text.ReplaceLineEndings(" | ")}";
    }

    private void HandleTocParsed(BitMarkdownDocumentNode document)
    {
        _tocEntries = BitMarkdownAstHelper.Descendants(document)
                                          .OfType<BitMarkdownHeadingNode>()
                                          .Where(h => string.IsNullOrEmpty(h.Id) is false)
                                          .Select(h => new TocEntry(h.Level, h.Id!, BitMarkdownInlineHelpers.PlainText(h.Inlines)))
                                          .ToList();

        _tocExcerpt = BitMarkdownAstHelper.ToPlainText(document).ReplaceLineEndings(" ");
    }

    private void HandleTaskChanged(BitMarkdownViewerTaskChangedEventArgs args)
    {
        _taskMarkdown = args.Markdown;
        _taskCount++;
        _taskLast = $"{args.Index}:{args.Checked}";
    }

    private void HandleEmptyTaskChanged(BitMarkdownViewerTaskChangedEventArgs args)
    {
    }

    private void SetRuntimeMarkdown() => _runtimeMarkdown = "## Changed\n\nNew **content**";

    private void HandleRuntimeParsed(BitMarkdownDocumentNode document) => _parseCount++;

    private void ReadDocument()
    {
        var document = _runtimeViewer!.Document;
        var headings = BitMarkdownAstHelper.Descendants(document).OfType<BitMarkdownHeadingNode>().Select(h => $"h{h.Level}");
        _documentInfo = $"{document.Children.Count}:{string.Join(",", headings)}";
    }

    private void CycleVisibility()
    {
        _visibility = _visibility switch
        {
            BitVisibility.Visible => BitVisibility.Hidden,
            BitVisibility.Hidden => BitVisibility.Collapsed,
            _ => BitVisibility.Visible
        };
    }
}
