@page "/e2e/markdown-viewer"

<PageTitle>BitMarkdownViewer E2E</PageTitle>

<h1>BitMarkdownViewer</h1>

<E2ESection Id="basic" Title="Basic (CommonMark core)">
    <BitMarkdownViewer Id="mdv-basic" Markdown="@BasicMarkdown" />
    <BitMarkdownViewer Id="mdv-hard-break" Markdown="@HardBreakMarkdown" />
</E2ESection>

<E2ESection Id="github" Title="GitHub pipeline">
    <BitMarkdownViewer Id="mdv-github" Markdown="@GitHubMarkdown" Pipeline="BitMarkdownPipelines.GitHub" />
    <BitMarkdownViewer Id="mdv-github-basic" Markdown="@GitHubMarkdown" />
</E2ESection>

<E2ESection Id="custom-pipeline" Title="Custom pipeline">
    <BitMarkdownViewer Id="mdv-custom" Markdown="@CustomMarkdown" Pipeline="_customPipeline" />
    <BitMarkdownViewer Id="mdv-emoji-override" Markdown="@(":rocket: and :bitlogo:")" Pipeline="_emojiOverridePipeline" />
</E2ESection>

<E2ESection Id="typography" Title="Typography">
    <BitMarkdownViewer Id="mdv-typography" Markdown="@TypographyMarkdown" Pipeline="_typographyPipeline" />
</E2ESection>

<E2ESection Id="line-breaks" Title="Line breaks">
    <BitMarkdownViewer Id="mdv-soft" Markdown="@LineBreaksMarkdown" />
    <BitMarkdownViewer Id="mdv-hard" Markdown="@LineBreaksMarkdown" Pipeline="_softBreakPipeline" />
</E2ESection>

<E2ESection Id="front-matter" Title="Front matter">
    <BitMarkdownViewer Id="mdv-front-default" Markdown="@FrontMatterMarkdown" />
    <BitMarkdownViewer Id="mdv-front" Markdown="@FrontMatterMarkdown" Pipeline="_frontMatterPipeline" OnParsed="HandleFrontMatterParsed" />
    <BitMarkdownViewer Id="mdv-front-toml" Markdown="@TomlFrontMatterMarkdown" Pipeline="_frontMatterPipeline" OnParsed="HandleTomlParsed" />
    <div>Front matter: <span id="front-matter-text">@_frontMatterText</span></div>
    <div>TOML: <span id="front-matter-toml">@_tomlText</span></div>
</E2ESection>

<E2ESection Id="containers" Title="Containers">
    <BitMarkdownViewer Id="mdv-containers" Markdown="@ContainersMarkdown" Pipeline="_containersPipeline" />
</E2ESection>

<E2ESection Id="documentation" Title="Definition lists, abbreviations and figures">
    <BitMarkdownViewer Id="mdv-docs" Markdown="@DocumentationMarkdown" Pipeline="_documentationPipeline" />
</E2ESection>

<E2ESection Id="math" Title="Mathematics">
    <BitMarkdownViewer Id="mdv-math" Markdown="@MathMarkdown" Pipeline="_mathPipeline" />
</E2ESection>

<E2ESection Id="untrusted" Title="Untrusted content">
    <div>
        <button id="btn-img-same" @onclick="() => _imageRendering = BitMarkdownViewerImageRendering.SameOrigin">SameOrigin</button>
        <button id="btn-img-none" @onclick="() => _imageRendering = BitMarkdownViewerImageRendering.None">None</button>
        <button id="btn-img-all" @onclick="() => _imageRendering = BitMarkdownViewerImageRendering.All">All</button>
        <span id="image-rendering">@_imageRendering</span>
    </div>
    <BitMarkdownViewer Id="mdv-untrusted" Markdown="@UntrustedMarkdown" Pipeline="BitMarkdownPipelines.GitHub" ImageRendering="_imageRendering" />
    <BitMarkdownViewer Id="mdv-bidi-kept" Markdown="@BidiMarkdown" />
    <BitMarkdownViewer Id="mdv-bidi-stripped" Markdown="@BidiMarkdown" StripBidiControlCharacters="true" />
    <BitMarkdownViewer Id="mdv-max-length" Markdown="@("0123456789**bold**")" MaxLength="12" />
    <BitMarkdownViewer Id="mdv-max-length-surrogate" Markdown="@("ab😀cd")" MaxLength="3" />
    <BitMarkdownViewer Id="mdv-depth" Markdown="@DeepMarkdown" MaxNestingDepth="3" />
    <BitMarkdownViewer Id="mdv-depth-default" Markdown="@DeepMarkdown" />
</E2ESection>

<E2ESection Id="toc" Title="Headings and table of contents">
    <nav id="toc-nav">
        @foreach (var entry in _tocEntries)
        {
            <a class="toc-item" data-level="@entry.Level" href="#@entry.Id">@entry.Text</a>
        }
    </nav>
    <div id="toc-excerpt">@_tocExcerpt</div>
    <div id="toc-scroll-host" style="--bit-MarkdownViewer-scroll-margin: 40px;">
        <BitMarkdownViewer Id="mdv-toc" Markdown="@TocMarkdown" Pipeline="_tocPipeline" OnParsed="HandleTocParsed" />
    </div>
    <BitMarkdownViewer Id="mdv-auto-ids" Markdown="@("# Hello World\n\n## Hello World")" Pipeline="_autoIdsPipeline" />
    <div style="height: 1500px;"></div>
</E2ESection>

<E2ESection Id="links" Title="Links and URLs">
    <BitMarkdownViewer Id="mdv-links-default" Markdown="@LinksMarkdown" />
    <BitMarkdownViewer Id="mdv-links-policy" Markdown="@LinksMarkdown" Pipeline="_linkPolicyPipeline" />
    <BitMarkdownViewer Id="mdv-base-url" Markdown="@BaseUrlMarkdown" Pipeline="_baseUrlPipeline" />
    <BitMarkdownViewer Id="mdv-rewriter" Markdown="@RewriterMarkdown" Pipeline="_rewriterPipeline" />
</E2ESection>

<E2ESection Id="inline" Title="Inline">
    <p id="inline-host">Formatting a value in place: <BitMarkdownViewer Id="mdv-inline" Inline Markdown="@("the **fastest** path\n\nis `Span<T>`")" /> - end.</p>
    <BitMarkdownViewer Id="mdv-inline-list" Inline Markdown="@("- one\n- two")" />
</E2ESection>

<E2ESection Id="templates" Title="Templates">
    <BitMarkdownViewer Id="mdv-templates" Markdown="@TemplatesMarkdown" Pipeline="BitMarkdownPipelines.GitHub" ImageRendering="BitMarkdownViewerImageRendering.All">
        <CodeBlockTemplate>
            <div class="tpl-code" data-lang="@(context.Info ?? "text")">
                <button class="tpl-copy" @onclick="() => _copiedCode = context.Content">Copy</button>
                <pre>@context.Content</pre>
            </div>
        </CodeBlockTemplate>
        <ImageTemplate>
            <figure class="tpl-image" data-url="@context.Url">@context.Alt</figure>
        </ImageTemplate>
        <LinkTemplate>
            <a class="tpl-link" href="@context.Url" data-title="@context.Title">[@BitMarkdownInlineHelpers.PlainText(context.Children)]</a>
        </LinkTemplate>
    </BitMarkdownViewer>
    <div>Copied: <span id="copied-code">@_copiedCode</span></div>
    <BitMarkdownViewer Id="mdv-templates-blocked" Markdown="@("![blocked alt](https://images.e2e-cross-origin.test/b.png)")">
        <ImageTemplate>
            <figure class="tpl-image" data-url="@context.Url">@context.Alt</figure>
        </ImageTemplate>
    </BitMarkdownViewer>
</E2ESection>

<E2ESection Id="tasks" Title="Interactive task lists">
    <button id="btn-tasks-disable" @onclick="() => _tasksDisabled = !_tasksDisabled">Toggle disabled</button>
    <span id="tasks-disabled">@_tasksDisabled</span>
    <BitMarkdownViewer Id="mdv-tasks"
                       Markdown="@_taskMarkdown"
                       Pipeline="BitMarkdownPipelines.GitHub"
                       Disabled="_tasksDisabled"
                       OnTaskChanged="HandleTaskChanged" />
    <div>Count: <span id="task-count">@_taskCount</span></div>
    <div>Last: <span id="task-last">@_taskLast</span></div>
    <pre id="task-markdown">@_taskMarkdown</pre>
    <BitMarkdownViewer Id="mdv-tasks-readonly" Markdown="@("- [x] done\n- [ ] open")" Pipeline="BitMarkdownPipelines.GitHub" />
    <BitMarkdownViewer Id="mdv-tasks-empty" Markdown="@("- [ ] \n- [ ] named")" Pipeline="BitMarkdownPipelines.GitHub" OnTaskChanged="HandleEmptyTaskChanged" />
</E2ESection>

<E2ESection Id="localization" Title="Localization">
    <BitMarkdownViewer Id="mdv-localized" Markdown="@LocalizedMarkdown" Pipeline="_localizedPipeline" />
</E2ESection>

<E2ESection Id="accessibility" Title="Accessibility">
    <h3>Comment by Sam</h3>
    <BitMarkdownViewer Id="mdv-a11y"
                       Markdown="@CommentMarkdown"
                       Pipeline="BitMarkdownPipelines.Advanced"
                       HeadingLevelOffset="3"
                       HeadingIdPrefix="comment-42-"
                       AriaLabel="Comment by Sam" />
    <BitMarkdownViewer Id="mdv-offset-clamp" Markdown="@("#### Deep\n\n###### Deepest")" HeadingLevelOffset="4" />
    <BitMarkdownViewer Id="mdv-wide-code" Markdown="@WideCodeMarkdown" />
</E2ESection>

<E2ESection Id="cascading" Title="Cascading parameters">
    <BitParams Parameters="_viewerParams">
        <BitMarkdownViewer Id="mdv-cascaded" Markdown="@CascadingMarkdown" />
        <BitMarkdownViewer Id="mdv-cascaded-own" Markdown="@CascadingMarkdown" Pipeline="BitMarkdownPipelines.Basic" HeadingLevelOffset="0" />
    </BitParams>
</E2ESection>

<E2ESection Id="style-class" Title="Style, Class and CSS variables">
    <BitMarkdownViewer Id="mdv-style" Style="border-inline-start: 4px solid rgb(255, 0, 0); padding-inline-start: 16px;" Markdown="@("A **styled** viewer.")" />
    <BitMarkdownViewer Id="mdv-class" Class="custom-mdv" Markdown="@("### A classy viewer")" />
    <div id="css-vars-host" style="@CssVariablesStyle">
        <BitMarkdownViewer Id="mdv-css-vars" Markdown="@CssVariablesMarkdown" Pipeline="_cssVarsPipeline" />
    </div>
    <BitMarkdownViewer Id="mdv-css-defaults" Markdown="@CssVariablesMarkdown" Pipeline="_cssVarsPipeline" />
</E2ESection>

<E2ESection Id="rtl" Title="RTL">
    <BitMarkdownViewer Id="mdv-rtl" Dir="BitDir.Rtl" Markdown="@RtlMarkdown" Pipeline="BitMarkdownPipelines.Advanced" />
    <div dir="rtl">
        <BitMarkdownViewer Id="mdv-rtl-inherited" Markdown="@RtlMarkdown" Pipeline="BitMarkdownPipelines.Advanced" />
    </div>
    <BitMarkdownViewer Id="mdv-ltr" Markdown="@RtlMarkdown" Pipeline="BitMarkdownPipelines.Advanced" />
    <BitMarkdownViewer Id="mdv-auto" Dir="BitDir.Auto" Markdown="@MixedDirectionMarkdown" />
</E2ESection>

<E2ESection Id="base" Title="Base parameters">
    <button id="btn-visibility" @onclick="CycleVisibility">Cycle visibility</button>
    <span id="visibility">@_visibility</span>
    <BitMarkdownViewer Id="mdv-visibility" Visibility="_visibility" Markdown="@("Visible text")" />
    <BitMarkdownViewer Id="mdv-attrs" TabIndex="0" HtmlAttributes="_htmlAttributes" Markdown="@("With attributes")" />
    <BitMarkdownViewer Markdown="@("No id given")" Class="mdv-no-id" />
</E2ESection>

<E2ESection Id="runtime" Title="Runtime changes">
    <button id="btn-set-markdown" @onclick="SetRuntimeMarkdown">Set markdown</button>
    <button id="btn-same-markdown" @onclick="() => _runtimeMarkdown = new string(_runtimeMarkdown.ToCharArray())">Same markdown</button>
    <button id="btn-rerender" @onclick="() => _rerenders++">Re-render</button>
    <button id="btn-set-pipeline" @onclick="() => _runtimePipeline = BitMarkdownPipelines.GitHub">GitHub pipeline</button>
    <button id="btn-set-offset" @onclick="() => _runtimeOffset = 2">Offset 2</button>
    <button id="btn-read-document" @onclick="ReadDocument">Read Document</button>
    <span id="rerenders">@_rerenders</span>
    <BitMarkdownViewer @ref="_runtimeViewer" Id="mdv-runtime" Markdown="@_runtimeMarkdown" Pipeline="_runtimePipeline" HeadingLevelOffset="_runtimeOffset" OnParsed="HandleRuntimeParsed" />
    <div>Parsed: <span id="parse-count">@_parseCount</span></div>
    <div>Document: <span id="document-info">@_documentInfo</span></div>
</E2ESection>

<E2ESection Id="unmount" Title="Unmount">
    <button id="btn-toggle-mount" @onclick="() => _mounted = !_mounted">Toggle mount</button>
    <span id="mounted">@_mounted</span>
    @if (_mounted)
    {
        <BitMarkdownViewer Id="mdv-unmount" Markdown="@("[x](#install) and footnote[^1]\n\n[^1]: note")" Pipeline="BitMarkdownPipelines.GitHub" OnTaskChanged="HandleTaskChanged" />
    }
</E2ESection>

<E2EStatus />

