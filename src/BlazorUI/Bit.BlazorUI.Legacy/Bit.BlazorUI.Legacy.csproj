<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <!-- See the note in Bit.BlazorUI.csproj: Debug builds only the TFM the demo and tests run on. -->
        <TargetFrameworks Condition=" '$(Configuration)' == 'Debug' And '$(BuildAllTfms)' != 'true' ">net10.0</TargetFrameworks>
        <IsTrimmable>true</IsTrimmable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" PrivateAssets="all" />
        <PackageReference Include="Jint" Version="4.17.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="compilerconfig.json" />
        <None Include="compilerconfig.json" />
        <Watch Remove="*.scss" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.BlazorUI\Bit.BlazorUI.csproj" />
        <ProjectReference Include="..\Bit.BlazorUI.SourceGenerators\Bit.BlazorUI.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="tsconfig.json" />
        <None Include="tsconfig.json" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.AspNetCore.Components" />
        <Using Include="Microsoft.AspNetCore.Components.Web" />
        <Using Include="Microsoft.AspNetCore.Components.Rendering" />
        <Using Include="Microsoft.AspNetCore.Components.Web.Virtualization" />
        <Using Include="Microsoft.JSInterop" />
        <Using Include="Bit.BlazorUI" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="**\*.ts" />
        <ScssFiles Include="**\*.scss" />
        <BitAssetsScript Include="..\Bit.BlazorUI.Build\build-assets.mjs" />
    </ItemGroup>

    <!-- What the core package's publish-time trimming reads of this one (see Bit.BlazorUI's
         buildTransitive\Bit.BlazorUI.targets): the targets naming this package's pieces, and the pieces themselves. -->
    <ItemGroup>
        <None Include="buildTransitive\Bit.BlazorUI.Legacy.targets" Pack="true" PackagePath="buildTransitive\;build\" />
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeBitBlazorUIAssetsInPackage</TargetsForTfmSpecificContentInPackage>
        <!-- The first target framework, outside the condition that reads it: a semicolon is not allowed in one. -->
        <_BitBlazorUIPackedTfm>$(TargetFrameworks.Split(';')[0])</_BitBlazorUIPackedTfm>
        <_BitAssetsMinify Condition=" '$(Configuration)' == 'Release' ">--minify</_BitAssetsMinify>
    </PropertyGroup>

    <Target Name="IncludeBitBlazorUIAssetsInPackage" Condition="'$(TargetFramework)' == '$(_BitBlazorUIPackedTfm)'">
        <ItemGroup>
            <_BitBlazorUIAssetPiece Include="$(BaseIntermediateOutputPath)bit-assets\**\*" />
            <TfmSpecificPackageFile Include="@(_BitBlazorUIAssetPiece)" PackagePath="buildTransitive\bit-assets\%(RecursiveDir)%(Filename)%(Extension)" />
        </ItemGroup>
    </Target>

    <!-- No source map is written (build-assets.mjs deletes one an older build left beside a bundle), so none is content,
         even while an older one is still on disk as the project is evaluated. -->
    <ItemGroup>
        <Content Remove="wwwroot\styles\*.map;wwwroot\scripts\*.map" />
    </ItemGroup>

    <Target Name="BeforeBuildTasks" DependsOnTargets="InstallNodejsDependencies;BuildJavaScript;BuildCss" />

    <Target Name="IncludeGeneratedAssets" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="BeforeBuildTasksOnce" Condition=" '$(DesignTimeBuild)' != 'true' ">
        <ItemGroup>
            <Content Include="wwwroot\scripts\*.js;wwwroot\styles\*.css" Exclude="@(Content);@(None)" />
        </ItemGroup>
    </Target>

    <Target Name="BeforeBuildTasksOnce">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="BeforeBuildTasks" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
    </Target>

    <Target Name="BeforeBuildTasksOnCrossTargeting" BeforeTargets="DispatchToInnerBuilds" DependsOnTargets="BeforeBuildTasks" Condition=" '$(IsCrossTargetingBuild)' == 'true' AND '$(DesignTimeBuild)' != 'true' " />

    <Target Name="InstallNodejsDependencies" Inputs="package.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm install" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <!-- build-assets.mjs writes the bundle from one piece per .ts file and keeps the pieces in obj\bit-assets for the
         package (see Bit.BlazorUI's csproj); the stamp per configuration rebuilds it when the configuration changes. -->
    <Target Name="BuildJavaScript" Inputs="@(TypeScriptFiles);tsconfig.json;@(BitAssetsScript)" Outputs="wwwroot/scripts/bit.blazorui.legacy.js;$(BaseIntermediateOutputPath)bit-assets\scripts.json;$(BaseIntermediateOutputPath)$(Configuration)\bit.blazorui.legacy.js.stamp">
        <Exec Command="node &quot;@(BitAssetsScript->'%(FullPath)')&quot; scripts --package $(PackageId) --tsconfig tsconfig.json --bundle scripts/bit.blazorui.legacy.js --out $(BaseIntermediateOutputPath)bit-assets $(_BitAssetsMinify)" StandardOutputImportance="high" StandardErrorImportance="high" />
        <ItemGroup>
            <_OtherConfigurationScriptStamps Include="$(BaseIntermediateOutputPath)*\bit.blazorui.legacy.js.stamp" Exclude="$(BaseIntermediateOutputPath)$(Configuration)\bit.blazorui.legacy.js.stamp" />
        </ItemGroup>
        <Delete Files="@(_OtherConfigurationScriptStamps)" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)$(Configuration)" />
        <Touch Files="$(BaseIntermediateOutputPath)$(Configuration)\bit.blazorui.legacy.js.stamp" AlwaysCreate="true" />
    </Target>

    <!-- The stylesheet is nothing but its components, compiled one by one so the publish-time trimming can keep a subset. -->
    <Target Name="BuildCss" Inputs="@(ScssFiles);@(BitAssetsScript)" Outputs="wwwroot/styles/bit.blazorui.legacy.css;$(BaseIntermediateOutputPath)bit-assets\styles.json">
        <Exec Command="node &quot;@(BitAssetsScript->'%(FullPath)')&quot; styles --package $(PackageId) --components Styles/bit.blazorui.legacy.scss --out $(BaseIntermediateOutputPath)bit-assets --bundle Styles/bit.blazorui.legacy.scss=styles/bit.blazorui.legacy.css" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <ItemGroup>
        <Content Remove="package*.json" />
        <Content Remove="tsconfig.json" />
        <None Include="package*json" />
        <None Include="tsconfig.json" />
    </ItemGroup>

</Project>
