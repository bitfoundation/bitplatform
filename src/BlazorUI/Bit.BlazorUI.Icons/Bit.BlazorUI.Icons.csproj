<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />
    <Import Project="../Bit.BlazorUI.PackageValidation.props" />
    <Import Project="../Bit.BlazorUI.TrimAnalysis.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <!-- See the note in Bit.BlazorUI.csproj: Debug builds only the TFM the demo and tests run on. -->
        <TargetFrameworks Condition=" '$(Configuration)' == 'Debug' And '$(BuildAllTfms)' != 'true' ">net10.0</TargetFrameworks>
        <RootNamespace>Bit.BlazorUI</RootNamespace>
        <WarningLevel>0</WarningLevel>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <ScssFiles Include="**\*.scss" />
        <BitAssetsScript Include="..\Bit.BlazorUI.Build\build-assets.mjs" />
    </ItemGroup>

    <!-- What the core package's publish-time trimming reads of this one when an app turns BitBlazorUITrimIcons on (see
         Bit.BlazorUI's buildTransitive\Bit.BlazorUI.targets): the targets naming the glyphs, and the glyphs themselves. -->
    <ItemGroup>
        <None Include="buildTransitive\Bit.BlazorUI.Icons.targets" Pack="true" PackagePath="buildTransitive\;build\" />
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeBitBlazorUIAssetsInPackage</TargetsForTfmSpecificContentInPackage>
        <!-- The first target framework, outside the condition that reads it: a semicolon is not allowed in one. -->
        <_BitBlazorUIPackedTfm>$(TargetFrameworks.Split(';')[0])</_BitBlazorUIPackedTfm>
    </PropertyGroup>

    <Target Name="IncludeBitBlazorUIAssetsInPackage" Condition="'$(TargetFramework)' == '$(_BitBlazorUIPackedTfm)'">
        <ItemGroup>
            <_BitBlazorUIAssetPiece Include="$(BaseIntermediateOutputPath)bit-assets\**\*" />
            <TfmSpecificPackageFile Include="@(_BitBlazorUIAssetPiece)" PackagePath="buildTransitive\bit-assets\%(RecursiveDir)%(Filename)%(Extension)" />
        </ItemGroup>
    </Target>

    <!-- No source map is written (build-assets.mjs deletes one an older build left beside a bundle), so none is content,
         even while an older one is still on disk as the project is evaluated. -->
    <ItemGroup>
        <Content Remove="wwwroot\styles\*.map;wwwroot\scripts\*.map" />
    </ItemGroup>

    <Target Name="BeforeBuildTasks" DependsOnTargets="InstallNodejsDependencies;BuildCss" />

    <Target Name="IncludeGeneratedAssets" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="BeforeBuildTasksOnce" Condition=" '$(DesignTimeBuild)' != 'true' ">
        <ItemGroup>
            <Content Include="wwwroot\styles\*.css" Exclude="@(Content);@(None)" />
        </ItemGroup>
    </Target>

    <Target Name="BeforeBuildTasksOnce">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="BeforeBuildTasks" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
    </Target>

    <Target Name="BeforeBuildTasksOnCrossTargeting" BeforeTargets="DispatchToInnerBuilds" DependsOnTargets="BeforeBuildTasks" Condition=" '$(IsCrossTargetingBuild)' == 'true' AND '$(DesignTimeBuild)' != 'true' " />

    <!-- A CI build installs exactly what package-lock.json pins (npm ci), so the tools a package is built with are the
         ones reviewed; a local build keeps npm install, which also takes in a package.json edited by hand. -->
    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Condition=" '$(CI)' == 'true' " Command="npm ci" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Exec Condition=" '$(CI)' != 'true' " Command="npm install" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <!-- The stylesheet, and beside it its glyph rules one by one, which the publish-time trimming keeps a subset of. -->
    <Target Name="BuildCss" Inputs="@(ScssFiles);@(BitAssetsScript)" Outputs="wwwroot/styles/bit.blazorui.icons.css;$(BaseIntermediateOutputPath)bit-assets\styles.json">
        <Exec Command="node &quot;@(BitAssetsScript->'%(FullPath)')&quot; styles --package $(PackageId) --out $(BaseIntermediateOutputPath)bit-assets --icons Styles/bit.blazorui.icons.scss=styles/bit.blazorui.icons.css" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <ItemGroup>
        <Content Remove="package*.json" />
        <None Include="package*json" />
    </ItemGroup>

</Project>