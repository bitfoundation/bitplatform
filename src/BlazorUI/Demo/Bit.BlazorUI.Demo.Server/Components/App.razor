@using Bit.BlazorUI.Demo.Client.Core.Shared
@using Bit.BlazorUI.Demo.Client.Web.Shared.Components

@{
#if INCLUDE_WASM
    var includeWasm = true;
#else
    var includeWasm = false;
#endif
#if DEBUG
    // While debugging, boot from the framework-served blazor.web.js instead of the ES2019-transpiled
    // bit.blazor.web.es2019.js variant, which is only needed to support legacy (non-ES2019+) browsers.
    var blazorWebScript = "_framework/blazor.web.js";
#else
    var blazorWebScript = "_framework/bit.blazor.web.es2019.js";
#endif
    var noPrerender = HttpContext.Request.Query["no-prerender"].Count > 0;
    // Without the WASM client in the build, WebAssembly render modes can't boot, so fall back to Blazor Server
    // even where AppRenderMode.Current would pick WebAssembly (e.g. Release with IncludeWasm=false).
    var renderMode = noPrerender
        ? (includeWasm ? AppRenderMode.NoPrerenderBlazorWebAssembly : AppRenderMode.NoPrerenderBlazorServer)
        : (includeWasm ? AppRenderMode.Current : AppRenderMode.BlazorServer);

    // Everything the document declares about its theme, in one call: the bit-theme-system marker,
    // which the inline script <BitThemeHead> emits resolves before first paint - plus the setup
    // below. The same options object is what <BitThemeHead> is handed, so the two halves cannot
    // disagree about which theme this response paints.
    // No persisted preference is handed in, deliberately: this markup is cached by the CDN in front of
    // the site and served to every visitor, so it must not carry any one visitor's theme. Reading the
    // preference cookie here once got one visitor's Material cached and painted for everyone after
    // them. The visitor's choice lives in localStorage instead, which the inline script reads before
    // first paint - so the page is still painted in the right theme, from markup that is the same for
    // everyone.
    var themeOptions = new BitThemeSsrOptions
    {
        // The client keeps the chosen theme in localStorage only - no cookie mirror, since nothing
        // on the server reads one (see above).
        Persist = true,
        // Theme toggles cross-fade via the View Transitions API (skipped automatically on
        // unsupported browsers / prefers-reduced-motion).
        ViewTransition = true,
        // Keep the browser chrome (an installed PWA's status bar) on the surface the site is drawn
        // on, re-read from the live page - which is also what brings a picked accent, since it
        // re-derives the surfaces too, into the chrome.
        ThemeColorMeta = BitCss.Var.Color.Background.Primary.Main,
        // The site dresses in Fluent 2 by default, so the two names the OS-following resolution picks
        // between are the Fluent 2 pair rather than the core light / dark Fluent ones. A visitor who
        // has already picked a design system in the header is painted from their localStorage instead
        // and never reaches this.
        LightTheme = BitThemePresets.Fluent2Light,
        DarkTheme = BitThemePresets.Fluent2Dark,
    };
    var rootThemeAttributes = BitThemeSsr.BuildRootThemeAttributeMap(null, themeOptions);
}

<!DOCTYPE html>
<html lang="en" @attributes="rootThemeAttributes">

<head>
    @* Ahead of the theme and accent scripts below, which together run to well over a kilobyte: the
       encoding declaration is only honored inside the document's first 1024 bytes, and a page that
       falls out of that window is sniffed instead. *@
    <meta charset="utf-8" />
    @* First script in the document, and the whole of the theme's first paint: the inline script that
       resolves bit-theme from localStorage - or, with nothing stored, from the OS - before anything
       is painted, and the theme-color meta tag the browser paints its chrome from, corrected to the
       theme the script resolved. Handed the same options as the attributes above, and likewise no
       persisted preference. BitThemeSurfaces is the one table of every registered preset: the core
       Fluent family, plus the Fluent 2 / Material / Cupertino surfaces Bit.BlazorUI.Extras adds to
       it when its assembly loads - which AddBitBlazorUIExtrasServices has seen to by now. It is
       also the default, and is spelled out here only to show where the colors come from. *@
    <BitThemeHead LightTheme="@themeOptions.LightTheme"
                  DarkTheme="@themeOptions.DarkTheme"
                  ThemeColors="@BitThemeSurfaces.BackgroundPrimary" />
    @* The accent counterpart of the script above, as one component: emits the inline script that,
       before anything is painted, re-resolves bit-accent from localStorage and injects the palette
       snapshot the StoredCss strategy keeps there - which is what keeps the accent correct although
       this markup comes out of the CDN's cache, the same for every visitor. Kept AFTER the theme script above: the
       snapshot's rules split on the bit-theme attribute that script sets, so painting must not
       start before it has run, which the parser guarantees for styles that come later in <head>.
       The configuration comes from the BitAccentColorConfig registered in DI (see
       AddClientSharedServices, which this server also runs) - the same one the app's
       AccentColorSwitcher chrome instances configure the shared service with (the snapshot only
       gets stored while the service runs StoredCss); this component only emits the matching head
       half. No PersistedAccent, for the reason no theme preference is read above: markup painted
       with one visitor's accent would be cached and served to everyone. *@
    <BitAccentColorHead />
    <ResourcePreloader />
    <base href="/" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- No static <title> here: the per-page title is emitted through <HeadOutlet> (PageOutlet's <PageTitle>),
         with Routes.razor providing the "bit BlazorUI" fallback. A hardcoded <title> would produce a duplicate
         <title> element in the prerendered HTML. -->

    <Script>
        // disable auto-zoom of iOS Safari when focusing an input
        (/iPad|iPhone|iPod/.test(navigator.userAgent)) &&
        (document.querySelector('meta[name="viewport"]').content = 'width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0')
    </Script>

