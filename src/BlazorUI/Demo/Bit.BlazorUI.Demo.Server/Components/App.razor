                "@@id": "https://blazorui.bitplatform.dev/#website",
                "url": "https://blazorui.bitplatform.dev/",
                "name": "bit BlazorUI",
                "description": "Native, easy-to-customize, open-source Blazor UI components that work seamlessly across WebAssembly, Server, Hybrid (MAUI) and pre-rendering.",
                "publisher": { "@@id": "https://blazorui.bitplatform.dev/#organization" },
                "inLanguage": "en-US"
