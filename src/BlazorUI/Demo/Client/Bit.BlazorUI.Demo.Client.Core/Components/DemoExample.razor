@inherits AppComponentBase

@if (RenderForMcpClient)
{
    if (PreventRenderForMcpClient is false)
    {
        @((MarkupString)($@"\n**{Title}**:
{(string.IsNullOrWhiteSpace(RazorCode) ? "" : $@"```razor
{RazorCode}
```")}
{(string.IsNullOrWhiteSpace(CsharpCode) ? "" : $@"```csharp
{CsharpCode}
```")}"))
    }
}
else
{
    @* One open block per example: title bar over a hairline, the source, then the live preview.
       The copy buttons confirm by growing into their "copied" label, so the empty content span is
       kept hidden until there is a label to show - otherwise it would offset the icon. *@
    <section class="box">
        <BitStack Horizontal Wrap AutoHeight
                  Gap="1rem"
                  Class="box-header"
                  VerticalAlign="BitAlignment.Center"
                  HorizontalAlign="BitAlignment.SpaceBetween">
            <BitText Element="h3"
                     Typography="BitTypography.H5"
                     Color="BitColor.PrimaryForeground"
                     Class="section-title" Id="@Id" example-section-title>@Title</BitText>
            @if (RazorCode is not null || CsharpCode is not null)
            {
                <BitStack Horizontal FitWidth AutoHeight
                          Gap="0.25rem"
                          Class="header-btn-group"
                          VerticalAlign="BitAlignment.Center">
                    <BitActionButton Class="@($"header-btn copy-link{(isLinkCopied ? " copied" : "")}")"
                                     Styles="@(new() { Content = (isLinkCopied ? "" : "display: none") })"
                                     IconName="@linkIcon"
                                     Title="@copyLinkMessage"
                                     Color="BitColor.SecondaryForeground"
                                     OnClick="@CopyLinkToClipboard">
                        @if (isLinkCopied)
                        {
                            <span>@copyLinkMessage</span>
                        }
                    </BitActionButton>
                    <BitActionButton Class="header-btn"
                                     OnClick="ToggleCode"
                                     IconName="@BitIconName.CodeEdit"
                                     Title="@(showCode ? "Hide code" : "Show code")"
                                     Color="@(showCode ? BitColor.Primary : BitColor.SecondaryForeground)">
                        @(showCode ? "Hide code" : "Show code")
                    </BitActionButton>
                </BitStack>
            }
        </BitStack>

        <div class="box-content">

            @if (RazorCode is not null || CsharpCode is not null)
            {
                @* BitCollapse animates both directions, which means the panel has to stay in the DOM
                   while it is closed. inert keeps that hidden copy out of the tab order and the
                   accessibility tree, so a keyboard user never lands on a code block they cannot see.

                   What the panel holds is only mounted once the reader has actually asked for it. A
                   page like DataGrid or Dropdown carries 50-130KB of sample source across its examples,
                   and putting all of it in the document - in the prerendered HTML, in the render tree,
                   and through a Prism pass on boot - for panels most readers never open is the single
                   most expensive thing these pages do. Once mounted it stays mounted, so closing the
                   panel again still has something to animate shut. *@
                <div class="code-panel" inert="@(showCode is false)">
                    <BitCollapse Expanded="showCode">
                    @if (_isCodeMounted)
                    {
                        <div class="code-holder" id="@_codeElementId">
                            <BitActionButton Class="@($"copy-btn{(isCodeCopied ? " copied" : "")}")"
                                             Styles="@(new() { Content = (isCodeCopied ? "" : "display: none") })"
                                             IconName="@codeIcon"
                                             Title="@copyCodeMessage"
                                             OnClick="@CopyCodeToClipboard">
                                @if (isCodeCopied)
                                {
                                    <span>@copyCodeMessage</span>
                                }
                            </BitActionButton>

                            <pre class="code">

                <code class="language-cshtml">
                    @RazorCode?.Trim()
                </code>

                @if (CsharpCode.HasValue())
                {
                    <code class="language-csharp">
&#64code {
    @CsharpCode?.Trim().Replace("\n", "\n    ")
}
                    </code>
                }
            </pre>
                        </div>
                    }
                    </BitCollapse>
                </div>
            }

            @* The live preview - the working components themselves, which is the bulk of what a demo
               page costs to build. It is mounted once the reader is within reach of it rather than on
               every navigation, so a page carrying thirty of these only ever builds the handful that
               are in view (see DemoContentDeferral for when this applies, and observeVisibility in
               Scripts/app.ts for how far "in reach" reaches). The container itself always renders: it
               is what the observer watches, and it has to be in the document to be watched. *@
            <div class="example-container" id="@_previewElementId">
                @if (_isPreviewMounted)
                {
                    @ChildContent
                }
            </div>
        </div>
    </section>
}
