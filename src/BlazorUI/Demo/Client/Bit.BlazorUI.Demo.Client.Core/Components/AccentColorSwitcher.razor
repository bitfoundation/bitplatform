@inherits AppComponentBase

@{
    var placementClass = Placement switch
    {
        AccentColorSwitcherPlacement.Header => " accent-switcher--header",
        AccentColorSwitcherPlacement.NavPanel => " accent-switcher--nav-panel",
        _ => null,
    };
}

<div class="accent-switcher@(placementClass)">
    @if (Placement is AccentColorSwitcherPlacement.NavPanel)
    {
        @* The header's copy sits between two icon buttons that explain themselves; in the drawer the
           swatches are on their own, so they get a label. *@
        <BitText Element="span" Typography="BitTypography.Caption1" Class="accent-switcher-label">Accent color</BitText>
    }

    @* StoredCss + All explicitly (the component defaults persist nothing and skip first paint).
       The configuration is app-wide state fixed by the first initialized instance - these chrome
       instances render in the layout on every page, so one of them is always that first instance.
       It is what the service applies and persists by (the palette snapshot only gets stored while
       the service runs StoredCss), so the host page's BitAccentColorHead (App.razor in the Server
       project) MUST carry these same values - it only emits the matching head half. *@
    <BitAccentColorSwitcher FirstPaintStrategy="BitAccentColorFirstPaintStrategy.StoredCss"
                            Persistence="BitAccentColorPersistence.All" />
</div>
