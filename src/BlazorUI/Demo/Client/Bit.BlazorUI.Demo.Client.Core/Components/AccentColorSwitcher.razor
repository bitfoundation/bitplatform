@inherits AppComponentBase

@{
    var placementClass = Placement switch
    {
        AccentColorSwitcherPlacement.Header => " accent-switcher--header",
        AccentColorSwitcherPlacement.NavPanel => " accent-switcher--nav-panel",
        _ => null,
    };
}

<div class="accent-switcher@(placementClass)">
    @if (Placement is AccentColorSwitcherPlacement.NavPanel)
    {
        @* The header's copy sits between two icon buttons that explain themselves; in the drawer the
           swatches are on their own, so they get a label. *@
        <BitText Element="span" Typography="BitTypography.Caption1" Class="accent-switcher-label">Accent color</BitText>
    }

    @* StaticCss + All explicitly (the component defaults persist nothing and skip first paint):
       this app's host page emits the matching BitAccentColorHead and reads the accent cookie while
       prerendering (see App.razor and Services.cs in the Server project), and the first
       InitializeAsync call - which comes from one of these chrome instances - fixes the
       configuration the restore maintains. *@
    <BitAccentColorSwitcher FirstPaintStrategy="BitAccentColorFirstPaintStrategy.StaticCss"
                            Persistence="BitAccentColorPersistence.All" />
</div>
