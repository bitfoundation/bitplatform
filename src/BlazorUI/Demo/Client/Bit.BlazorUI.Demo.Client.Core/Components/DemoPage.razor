@inherits AppComponentBase

@using System.Text.Json;

@if (RenderForMcpClient)
{
    @($"\n# {Name}\n")

    @if (SecondaryNames?.Length > 0)
    {
        @($"**Also known as:** {string.Join(", ", SecondaryNames!)}\n")
    }

    @if (Description.HasValue())
    {
        @($"## Description\n{Description}\n")
    }

    @if (Notes.HasValue())
    {
        @($"## Notes\n{Notes}\n")
    }

    @if (Introduction.HasValue())
    {
        @($"## Introduction\n{Introduction}\n")
    }

    var publicMembers = PublicMembers;
    if (_inputComponents.Contains(Name))
    {
        publicMembers.AddRange(_inputBasePublicMembers);
    }
    if (_notInheritedComponents.Contains(Name) is false)
    {
        publicMembers.AddRange(_componentBasePublicMembers);
    }

    var parameters = Parameters;
    if (_textInputComponents.Contains(Name))
    {
        parameters.AddRange(_textInputBaseParameters);
    }
    if (_inputComponents.Contains(Name))
    {
        parameters.AddRange(_inputBaseParameters);
    }
    if (_notInheritedComponents.Contains(Name) is false)
    {
        parameters.AddRange(_componentBaseParameters);
    }

    var enums = SubEnums;
    if (_notInheritedComponents.Contains(Name) is false)
    {
        enums.AddRange(_componentBaseSubEnums);
    }

    @if (parameters.Any())
    {
        @("## Parameters\n")
        @("| Name | Type | Default Value | Description |\n")
        @("| :--- | :--- | :------------ | :---------- |\n")
        @foreach (var param in parameters)
        {
            @($"| {param.Name} | `{param.Type}` | {param.DefaultValue} | {param.Description} |\n")
        }
    }

    @if (publicMembers.Any())
    {
        @("## Public Members\n")
        @("| Name | Type | Default Value | Description |\n")
        @("| :--- | :--- | :------------ | :---------- |\n")
        @foreach (var member in publicMembers)
        {
            @($"| {member.Name} | `{member.Type}` | {member.DefaultValue} | {member.Description} |\n")
        }
    }

    @if (enums.Any())
    {
        @("## Enums\n")
        @foreach (var subEnum in enums)
        {
            @($"### {subEnum.Name} Enum\n")
            @("| Name | Value | Description |\n")
            @("| :--- | :--- | :---------- |\n")
            @foreach (var item in subEnum.Items)
            {
                @($"| {item.Name} | {item.Value} | {item.Description} |\n")
            }
            @("\n")
        }
    }

    @if (SubClasses.Any())
    {
        @("## Sub Classes\n")
        @foreach (var subClass in SubClasses)
        {
            @($"### {subClass.Title} Properties\n")
            @($"{subClass.Description}\n")
            @("| Name | Type | Default Value | Description |\n")
            @("| :--- | :--- | :------------ | :---------- |\n")
            @foreach (var subParam in subClass.Parameters)
            {
                @($"| {subParam.Name} | `{subParam.Type}` | {subParam.DefaultValue} | {subParam.Description} |\n")
            }
            @("\n")
        }
    }

    @("## Examples\n")
    @(ChildContent ?? Examples)
}
else
{
    @* The same article shell the prose pages use (DocsArticle / DocSection), so moving between the
       guides and the reference never feels like changing sites: an eyebrow, the title with its
       badges, a lead paragraph, then anchored sections separated by air and a hairline rather than
       by a stack of cards.

       Only the shell is shared. What the sections hold is unchanged - in particular DemoExample
       still puts an example's source ABOVE its live preview, which is the whole point of opening
       the panel. *@
    <div class="@($"doc-shell{(_forceAnimation ? " bit-fam" : " demo-reduced-motion")}")">
        <article class="doc-main">

            <header class="doc-head">
                @if (_catalogItem is not null)
                {
                    @* The category this component is filed under, so the page says where the reader
                       is without needing a breadcrumb bar of its own. *@
                    <p class="doc-eyebrow">@_catalogItem.Category</p>
                }

                <BitStack Horizontal Wrap AutoHeight
                          Gap="1rem"
                          VerticalAlign="BitAlignment.Baseline">
                    <BitText Element="h1" Class="doc-title" Typography="BitTypography.H1" Color="BitColor.PrimaryForeground">
                        @Name
                    </BitText>

                    <BitStack Horizontal Wrap FitWidth AutoHeight Gap="0.375rem">
                        @* Which NuGet package this component comes from, stated where the reader first
                           meets the component rather than only in the install guide: reaching for a
                           BitChart or a BitDataGrid without referencing Bit.BlazorUI.Extras is the most
                           common false start with this library. *@
                        <BitTag Text="@_packageName" Size="BitSize.Small" Variant="BitVariant.Outline"
                                IconName="@BitIconName.Package" Color="BitColor.SecondaryForeground" />

                        @if (SecondaryNames?.Length > 0)
                        {
                            @* Alternative names are metadata about the component, so they are set as
                               tags rather than as a second line of heading-sized text competing with
                               the title. *@
                            @foreach (var name in SecondaryNames)
                            {
                                <BitTag Text="@name" Size="BitSize.Small" Variant="BitVariant.Outline"
                                        Color="BitColor.Info" />
                            }
                        }
                    </BitStack>
                </BitStack>

                @if (Description.HasValue() || DescriptionTemplate is not null)
                {
                    @* The description reads as the page's lead paragraph: prose on the bare page,
                       not one more card. *@
                    <div id="overview-section" class="doc-lead">
                        @if (DescriptionTemplate is not null)
                        {
                            @DescriptionTemplate
                        }
                        else
                        {
                            <BitText Element="p" Typography="BitTypography.Subtitle1" Color="BitColor.SecondaryForeground">@Description</BitText>
                        }
                    </div>
                }
            </header>

            <div class="motion-bar">
                <BitToggle @bind-Value="_forceAnimation" Text="ForceAnimation (whole page)" />
            </div>

            @if (Notes.HasValue() || NotesTemplate is not null)
            {
                <DocSection Id="notes-section" Title="Notes">
                    @if (NotesTemplate is not null)
                    {
                        @NotesTemplate
                    }
                    else
                    {
                        <BitText Element="p">@Notes</BitText>
                    }
                </DocSection>
            }

            @if (IntroductionVideoUrl.HasValue() || Introduction.HasValue() || IntroductionTemplate is not null)
            {
                <DocSection Id="introduction-section" Title="Introduction">
                    @if (IntroductionVideoUrl.HasValue())
                    {
                        <BitStack Horizontal AutoHeight Class="video-container"
                                  HorizontalAlign="BitAlignment.Center">
                            @* The demo pages are served with Cross-Origin-Embedder-Policy (require-corp on
                               WebKit, see Middlewares.cs), so a cross-origin video host must send a
                               Cross-Origin-Resource-Policy header or the video is blocked in Safari.
                               crossorigin="anonymous" is deliberately not set here: it would switch the
                               request to CORS mode and break hosts that send no Access-Control-Allow-Origin. *@
                            <video src="@IntroductionVideoUrl" controls />
                        </BitStack>
                    }
                    @if (Introduction.HasValue() || IntroductionTemplate is not null)
                    {
                        @if (IntroductionTemplate is not null)
                        {
                            @IntroductionTemplate
                        }
                        else
                        {
                            <BitText Typography="BitTypography.Body2">
                                @Introduction
                            </BitText>
                        }
                    }
                </DocSection>
            }

            <DocSection Id="usage-section" Title="Usage"
                        Description="Every example is live. Open its code to see exactly what produced the component running underneath.">
                @(ChildContent ?? Examples)
            </DocSection>

            <DocSection Id="api-section" Title="API"
                        Description="Every parameter, public member, sub-class and enum this component exposes.">

                <DemoParametersTable Name="@($"Bit{Name}")" Parameters="Parameters" />

                @if (PublicMembers.Any())
                {
                    <DemoParametersTable Name="@($"Bit{Name}")" NameSuffix="public members" Parameters="PublicMembers" />
                }

                @if (_textInputComponents.Contains(Name))
                {
                    <DemoParametersTable Name="BitTextInputBase" Parameters="_textInputBaseParameters" />
                }

                @if (_inputComponents.Contains(Name))
                {
                    <DemoParametersTable Name="BitInputBase" Parameters="_inputBaseParameters" />

                    <DemoParametersTable Name="BitInputBase" NameSuffix="public members" Parameters="_inputBasePublicMembers" />
                }

                @if (_notInheritedComponents.Contains(Name) is false)
                {
                    <DemoParametersTable Name="BitComponentBase" Parameters="_componentBaseParameters" />

                    <DemoParametersTable Name="BitComponentBase" NameSuffix="public members"
                                         Parameters="_componentBasePublicMembers" />
                }

                <DemoSubClassesTable Classes="SubClasses" />

                <DemoSubEnumsTable Enums="SubEnums" />

                @if (_notInheritedComponents.Contains(Name) is false)
                {
                    <DemoSubEnumsTable Enums="_componentBaseSubEnums" />
                }
            </DocSection>

            @* The same closing block as every prose page. The source links the old wall of "Or you
               can review / edit ..." sentences carried are all still here - as buttons, because that
               is what they are. *@
            <DocFeedback DocsPagePath="@(GitHubDemoUrl.HasValue() ? $"Components/{GitHubDemoUrl}" : null)">
                @if (_sourceUrl is not null)
                {
                    <BitButton Target="_blank"
                               Href="@_sourceUrl"
                               Variant="BitVariant.Text"
                               IconName="@BitIconName.OpenSource"
                               Color="BitColor.SecondaryForeground">
                        View the component source
                    </BitButton>

                    <BitButton Target="_blank"
                               Href="@_sourceEditUrl"
                               Variant="BitVariant.Text"
                               IconName="@BitIconName.Edit"
                               Color="BitColor.SecondaryForeground">
                        Edit the component
                    </BitButton>
                }
            </DocFeedback>

            <DocPager />

        </article>

        <SideRail />
    </div>
}
