@inherits AppComponentBase

@using System.Text.Json;

@if (RenderForMcpClient)
{
    @($"\n# {Name}\n")

    @if (SecondaryNames?.Length > 0)
    {
        @($"**Also known as:** {string.Join(", ", SecondaryNames!)}\n")
    }

    @if (Description.HasValue())
    {
        @($"## Description\n{Description}\n")
    }

    @if (Notes.HasValue())
    {
        @($"## Notes\n{Notes}\n")
    }

    @if (Introduction.HasValue())
    {
        @($"## Introduction\n{Introduction}\n")
    }

    var publicMembers = PublicMembers;
    if (_inputComponents.Contains(Name))
    {
        publicMembers.AddRange(_inputBasePublicMembers);
    }
    if (_notInheritedComponents.Contains(Name) is false)
    {
        publicMembers.AddRange(_componentBasePublicMembers);
    }

    var parameters = Parameters;
    if (_textInputComponents.Contains(Name))
    {
        parameters.AddRange(_textInputBaseParameters);
    }
    if (_inputComponents.Contains(Name))
    {
        parameters.AddRange(_inputBaseParameters);
    }
    if (_notInheritedComponents.Contains(Name) is false)
    {
        parameters.AddRange(_componentBaseParameters);
    }

    var enums = SubEnums;
    if (_notInheritedComponents.Contains(Name) is false)
    {
        enums.AddRange(_componentBaseSubEnums);
    }

    @if (parameters.Any())
    {
        @("## Parameters\n")
        @("| Name | Type | Default Value | Description |\n")
        @("| :--- | :--- | :------------ | :---------- |\n")
        @foreach (var param in parameters)
        {
            @($"| {param.Name} | `{param.Type}` | {param.DefaultValue} | {param.Description} |\n")
        }
    }

    @if (publicMembers.Any())
    {
        @("## Public Members\n")
        @("| Name | Type | Default Value | Description |\n")
        @("| :--- | :--- | :------------ | :---------- |\n")
        @foreach (var member in publicMembers)
        {
            @($"| {member.Name} | `{member.Type}` | {member.DefaultValue} | {member.Description} |\n")
        }
    }

    @if (enums.Any())
    {
        @("## Enums\n")
        @foreach (var subEnum in enums)
        {
            @($"### {subEnum.Name} Enum\n")
            @("| Name | Value | Description |\n")
            @("| :--- | :--- | :---------- |\n")
            @foreach (var item in subEnum.Items)
            {
                @($"| {item.Name} | {item.Value} | {item.Description} |\n")
            }
            @("\n")
        }
    }

    @if (SubClasses.Any())
    {
        @("## Sub Classes\n")
        @foreach (var subClass in SubClasses)
        {
            @($"### {subClass.Title} Properties\n")
            @($"{subClass.Description}\n")
            @("| Name | Type | Default Value | Description |\n")
            @("| :--- | :--- | :------------ | :---------- |\n")
            @foreach (var subParam in subClass.Parameters)
            {
                @($"| {subParam.Name} | `{subParam.Type}` | {subParam.DefaultValue} | {subParam.Description} |\n")
            }
            @("\n")
        }
    }

    @("## Examples\n")
    @(ChildContent ?? Examples)
}
else
{
    @* bit-fam is the class BitComponentBase.ForceAnimation renders. Setting it here rather than on each
       sample restores the full motion durations for everything on the page, since those are inherited
       custom properties. *@
    <BitStack Horizontal AutoHeight Gap="0" Class="@(_forceAnimation ? "bit-fam" : null)">
        <div class="page-container example">

            <BitStack Element="header" Horizontal Wrap AutoHeight
                      Gap="1rem"
                      Class="page-header"
                      VerticalAlign="BitAlignment.Baseline">
                <BitText Element="h1" Typography="BitTypography.H4" Color="BitColor.PrimaryForeground">
                    @Name
                </BitText>

                @if (SecondaryNames?.Length > 0)
                {
                    <BitStack Horizontal Wrap FitWidth AutoHeight Gap="0.375rem">
                        @foreach (var name in SecondaryNames)
                        {
                            @* Alternative names are metadata about the component, so they are set as
                               tags rather than as a second line of heading-sized text competing with
                               the title. *@
                            <BitTag Text="@name" Size="BitSize.Small" Variant="BitVariant.Outline"
                                    Color="BitColor.Info" />
                        }
                    </BitStack>
                }
            </BitStack>

            @if (Description.HasValue() || DescriptionTemplate is not null)
            {
                @* The description reads as the page's lead paragraph: prose on the bare page,
                   not one more card. *@
                <section id="overview-section" class="page-lead">
                    @if (DescriptionTemplate is not null)
                    {
                        @DescriptionTemplate
                    }
                    else
                    {
                        <BitText Element="p">@Description</BitText>
                    }
                </section>
            }

            @if (Notes.HasValue() || NotesTemplate is not null)
            {
                <BitCard Id="notes-section" FullWidth
                         Background="BitColorKind.Primary"
                         Class="page-section">
                    <div class="section-heading">
                        <BitText Element="h2" Typography="BitTypography.H5" Color="BitColor.PrimaryForeground">Notes</BitText>
                        <BitSeparator />
                    </div>
                    @if (NotesTemplate is not null)
                    {
                        @NotesTemplate
                    }
                    else
                    {
                        @Notes
                    }
                </BitCard>
            }

            <div class="motion-bar">
                <BitToggle @bind-Value="_forceAnimation" Text="ForceAnimation (whole page)" />
            </div>

            @if (IntroductionVideoUrl.HasValue() || Introduction.HasValue() || IntroductionTemplate is not null)
            {
                <BitCard Id="introduction-section" FullWidth
                         Background="BitColorKind.Primary"
                         Class="page-section">
                    <div class="section-heading">
                        <BitText Element="h2" Typography="BitTypography.H5" Color="BitColor.PrimaryForeground">Introduction</BitText>
                        <BitSeparator />
                    </div>
                    @if (IntroductionVideoUrl.HasValue())
                    {
                        <BitStack Horizontal AutoHeight Class="video-container"
                                  HorizontalAlign="BitAlignment.Center">
                            <video src="@IntroductionVideoUrl" controls />
                        </BitStack>
                        <br />
                    }
                    @if (Introduction.HasValue() || IntroductionTemplate is not null)
                    {
                        @if (IntroductionTemplate is not null)
                        {
                            @IntroductionTemplate
                        }
                        else
                        {
                            <BitText Typography="BitTypography.Body2">
                                @Introduction
                            </BitText>
                        }
                    }
                </BitCard>
            }

            <BitCard Id="usage-section" FullWidth
                     Background="BitColorKind.Primary"
                     Class="page-section">
                <div class="section-heading">
                    <BitText Element="h2" Typography="BitTypography.H5" Color="BitColor.PrimaryForeground">Usage</BitText>
                    <br />
                </div>
                @(ChildContent ?? Examples)
            </BitCard>

            <BitCard Id="api-section" FullWidth
                     Background="BitColorKind.Primary"
                     Class="page-section">
                <div class="section-heading">
                    <BitText Element="h2" Typography="BitTypography.H5" Color="BitColor.PrimaryForeground">API</BitText>
                </div>

                <DemoParametersTable Name="@($"Bit{Name}")" Parameters="Parameters" />

                @if (PublicMembers.Any())
                {
                    <DemoParametersTable Name="@($"Bit{Name}")" NameSuffix="public members" Parameters="PublicMembers" />
                }

                @if (_textInputComponents.Contains(Name))
                {
                    <DemoParametersTable Name="BitTextInputBase" Parameters="_textInputBaseParameters" />
                }

                @if (_inputComponents.Contains(Name))
                {
                    <DemoParametersTable Name="BitInputBase" Parameters="_inputBaseParameters" />

                    <DemoParametersTable Name="BitInputBase" NameSuffix="public members" Parameters="_inputBasePublicMembers" />
                }

                @if (_notInheritedComponents.Contains(Name) is false)
                {
                    <DemoParametersTable Name="BitComponentBase" Parameters="_componentBaseParameters" />

                    <DemoParametersTable Name="BitComponentBase" NameSuffix="public members"
                                         Parameters="_componentBasePublicMembers" />
                }

                <DemoSubClassesTable Classes="SubClasses" />

                <DemoSubEnumsTable Enums="SubEnums" />

                @if (_notInheritedComponents.Contains(Name) is false)
                {
                    <DemoSubEnumsTable Enums="_componentBaseSubEnums" />
                }
            </BitCard>

            <BitCard Id="feedback-section" FullWidth NoShadow
                     Background="BitColorKind.Primary"
                     Border="BitColorKind.Secondary"
                     Class="page-section">
                <div class="section-heading">
                    <BitText Element="h2" Typography="BitTypography.H5" Color="BitColor.PrimaryForeground">Feedback</BitText>
                    <BitSeparator />
                </div>
                <BitText Element="p">
                    You can give us your feedback through our
                    <BitLink Href="@REPO_URL" Target="_blank">GitHub repo</BitLink>
                    by filing a new
                    <BitLink Href="@($"{REPO_URL}/issues/new/choose")" Target="_blank">Issue</BitLink>
                    or starting a new
                    <BitLink Href="@($"{REPO_URL}/discussions/new/choose")" Target="_blank">Discussion</BitLink>.
                </BitText>

                @if (GitHubDemoUrl.HasValue())
                {
                    <br />
                    <BitText Element="p">
                        Or you can
                        <BitLink
                        Href="@($"{REPO_URL}/blob/develop/src/BlazorUI/Demo/Client/Bit.BlazorUI.Demo.Client.Core/Pages/Components/{GitHubDemoUrl}")"
                        Target="_blank">review</BitLink>
                        /
                        <BitLink
                        Href="@($"{REPO_URL}/edit/develop/src/BlazorUI/Demo/Client/Bit.BlazorUI.Demo.Client.Core/Pages/Components/{GitHubDemoUrl}")"
                        Target="_blank">edit</BitLink>
                        this page on GitHub.
                    </BitText>
                }

                @if (GitHubUrl.HasValue())
                {
                    <br />
                    <BitText Element="p">
                        Or you can
                        <BitLink Href="@($"{REPO_URL}/blob/develop/src/BlazorUI/Bit.BlazorUI/Components/{GitHubUrl}")"
                                 Target="_blank">review</BitLink>
                        /
                        <BitLink Href="@($"{REPO_URL}/edit/develop/src/BlazorUI/Bit.BlazorUI/Components/{GitHubUrl}")"
                                 Target="_blank">edit</BitLink>
                        this component on GitHub.
                    </BitText>
                }

                @if (GitHubExtrasUrl.HasValue())
                {
                    <br />
                    <BitText Element="p">
                        Or you can
                        <BitLink
                        Href="@($"{REPO_URL}/blob/develop/src/BlazorUI/Bit.BlazorUI.Extras/Components/{GitHubExtrasUrl}")"
                        Target="_blank">review</BitLink>
                        /
                        <BitLink
                        Href="@($"{REPO_URL}/edit/develop/src/BlazorUI/Bit.BlazorUI.Extras/Components/{GitHubExtrasUrl}")"
                        Target="_blank">edit</BitLink>
                        this component on GitHub.
                    </BitText>
                }

                @if (GitHubLegacyUrl.HasValue())
                {
                    <br />
                    <BitText Element="p">
                        Or you can
                        <BitLink
                        Href="@($"{REPO_URL}/blob/develop/src/BlazorUI/Bit.BlazorUI.Legacy/Components/{GitHubLegacyUrl}")"
                        Target="_blank">review</BitLink>
                        /
                        <BitLink
                        Href="@($"{REPO_URL}/edit/develop/src/BlazorUI/Bit.BlazorUI.Legacy/Components/{GitHubLegacyUrl}")"
                        Target="_blank">edit</BitLink>
                        this component on GitHub.
                    </BitText>
                }
            </BitCard>
        </div>
        <SideRail HasNotes="@(Notes.HasValue() || NotesTemplate is not null)" />
    </BitStack>
}