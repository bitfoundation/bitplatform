@foreach (var subClass in Classes)
{
    <div id="@subClass.Id" class="sec-con">
        <BitText Element="h3" Typography="BitTypography.H6" Gutter Class="subclass-title"><b>@subClass.Title</b> properties</BitText>
        <BitText Element="p" Typography="BitTypography.Subtitle2" Gutter>@subClass.Description</BitText>
        <table class="table-view params-table">
            <tr class="th-row">
                <th class="th-cell"><span class="bit-txt-subtitle1 bit-txt">Name</span></th>
                <th class="th-cell"><span class="bit-txt-subtitle1 bit-txt">Type</span></th>
                <th class="th-cell"><span class="bit-txt-subtitle1 bit-txt">Default value</span></th>
                <th class="th-cell"><span class="bit-txt-subtitle1 bit-txt">Description</span></th>
            </tr>
            @foreach (var subParam in subClass.Parameters)
            {
                <tr class="tdata-row">
                    <td class="td-cell"><span class="bit-txt-caption1 bit-txt">@subParam.Name</span></td>
                    <td class="td-cell">
                        @if (subParam.LinkType == LinkType.Link)
                        {
                            <BitLink Href="@subParam.Href">
                                <span class="bit-txt-caption1 bit-txt">@subParam.Type</span>
                            </BitLink>
                        }
                        else
                        {
                            <span class="bit-txt-caption1 bit-txt">@subParam.Type</span>
                        }
                    </td>
                    <td class="td-cell"><span class="bit-txt-caption1 bit-txt">@subParam.DefaultValue</span></td>
                    <td class="td-cell"><span class="bit-txt-caption1 bit-txt">@subParam.Description</span></td>
                </tr>
            }
        </table>
    </div>
}
