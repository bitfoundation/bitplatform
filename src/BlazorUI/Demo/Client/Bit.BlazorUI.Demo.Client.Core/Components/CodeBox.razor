@inherits AppComponentBase

@if (ChildContent is not null)
{
    <div class="code-box">
        @if (HideCopyButton is false)
        {
            @* Only the wrapper is positioned; the button is left exactly as BitActionButton renders
               it, and confirms the copy by swapping its icon and its title. *@
            <div class="copy-btn-holder">
                <BitActionButton IconOnly
                                 Size="BitSize.Small"
                                 IconName="@_codeIcon"
                                 Title="@_copyCodeMessage"
                                 Color="BitColor.SecondaryForeground"
                                 OnClick="@CopyCodeToClipboard" />
            </div>
        }

        <pre @ref="_preElementRef"
             class="code-box-content"
             style="@(string.IsNullOrWhiteSpace(MaxHeight) ? null : $"max-height:{MaxHeight}")"><code class="@($"language-{Language}")">@ChildContent</code></pre>
    </div>
}
