@inherits AppComponentBase

<div class="footer">
    <section>
        <div>
            <div class="bit-logo" />
            <BitText Typography="BitTypography.Body2">
                A platform that simplifies the development process for freelancers and software companies through its clean project templates and easy-to-use one-click build and deployment feature.
            </BitText>
        </div>

        <BitStack Horizontal Wrap AutoHeight
                  Gap="1.25rem"
                  HorizontalAlign="BitAlignment.SpaceEvenly">
            <BitStack FitWidth Gap="0">
                <BitText Typography="BitTypography.H6" Gutter>Explore</BitText>
                <BitLink Href="overview">Docs</BitLink>
                <BitLink Href="iconography">Iconography</BitLink>
                <BitLink Href="theming">Theming</BitLink>
            </BitStack>

            <BitStack FitWidth Gap="0">
                <BitText Typography="BitTypography.H6" Gutter>Quick links</BitText>
                <BitLink Href="https://github.com/bitfoundation" Target="_blank">Github Org</BitLink>
                <BitLink Href="https://github.com/bitfoundation/bitplatform" Target="_blank">Github Repo</BitLink>
                <BitLink Href="https://github.com/bitfoundation/bitplatform/issues" Target="_blank">Github Issues</BitLink>
            </BitStack>

            <button class="go-to-top" @onclick="GoToTop">Go to top</button>
        </BitStack>
    </section>

    <section>
        <BitStack FitWidth AutoHeight Gap="0.1875rem" Class="address-info">
            <a class="address" target="_blank" rel="noopener noreferrer" href="https://maps.app.goo.gl/W8vtWHQ13YhYpksy6">Sixmastraat 15, 8932 PA Leeuwarden,</a>
            <div class="country">Netherlands</div>
            <a class="tel" href="tel:+31684207362">+31 6 84207362</a>
        </BitStack>
        <div>
            <BitStack Horizontal FitWidth AutoHeight
                      Gap="0"
                      Class="social-link-group"
                      VerticalAlign="BitAlignment.Center"
                      HorizontalAlign="BitAlignment.Center">
                <a class="social-link twitter-link" target="_blank" rel="noopener noreferrer" aria-label="bit platform on X (Twitter)" href="https://twitter.com/bitplatformhq"></a>
                <a class="social-link github-link" target="_blank" rel="noopener noreferrer" aria-label="bit platform on GitHub" href="https://github.com/bitfoundation/bitplatform"></a>
                <a class="social-link youtube-link" target="_blank" rel="noopener noreferrer" aria-label="bit platform on YouTube" href="https://www.youtube.com/channel/UCtk33NQ91f3GOJG0HAdkdog"></a>
                <a class="social-link linkedin-link" target="_blank" rel="noopener noreferrer" aria-label="bit platform on LinkedIn" href="https://www.linkedin.com/company/bitplatformhq"></a>
            </BitStack>
            <div class="copy-right-txt">Copyright © 2026 bit platform | All Rights Reserved </div>
        </div>
    </section>
</div>