@inherits AppComponentBase

<div class="header">
    <BitStack Horizontal AutoHeight Gap="0"
              VerticalAlign="BitAlignment.Center"
              HorizontalAlign="BitAlignment.SpaceBetween"
              Class="@($"container{(IsHomePage ? " home-page" : "")}")">
        <BitStack Horizontal FitWidth Gap="0" VerticalAlign="BitAlignment.Center">
            @if (IsHomePage is false)
            {
                <BitButton FixedColor
                           Class="menu-btn"
                           Variant="BitVariant.Text"
                           IconName="@BitIconName.CollapseMenu"
                           Color="BitColor.SecondaryBackground"
                           OnClick=@WrapHandled(ToggleNavMenu) AriaLabel="Header menu button" />
            }
            <a class="logo" href="/" aria-label="Homepage"></a>
            <a class="link@(IsHomePage ? " active" : "")" href="/">Home</a>
            <a class="link@(IsHomePage ? "" : " active")" href="/overview">Docs</a>
        </BitStack>
        <BitStack Horizontal FitWidth AutoHeight Gap="0.5rem" VerticalAlign="BitAlignment.Center">
            <a class="github-btn" target="_blank" rel="noopener noreferrer" aria-label="Github repository" href="https://github.com/bitfoundation/bitplatform"></a>

            <button @onclick="WrapHandled(ToggleTheme)" class="toggle-theme-btn dark-theme" title="Turn on light">
                <span class="icon-container"><i class="bit-icon bit-icon--Sunny"></i></span>
            </button>
            <button @onclick="WrapHandled(ToggleTheme)" class="toggle-theme-btn light-theme" title="Turn off light">
                <span class="icon-container"><i class="bit-icon bit-icon--ClearNight"></i></span>
            </button>
        </BitStack>
    </BitStack>
</div>