@inherits LayoutComponentBase

<BitAppShell @ref="_appShellRef">
    @* SkipLink is BitLayout's own: it targets the <main> the layout renders, so "skip to content"
       really does skip the nav panel - which on a documentation page is a list of every component in
       the library, and otherwise stands between a keyboard user and the article on every single
       navigation. *@
    <BitLayout SkipLink
               StickyHeader
               HideNavPanel="_isHomePage"
               NavPanelWidth="_isNavPanelOpen ? 0 : 14 * 16"
               NavPanelAriaLabel="Documentation"
               SkipLinkText="Skip to content">
        <Header>
            <AppHeader IsHomePage="_isHomePage" OnToggleNavPanel="() => _isNavPanelOpen = true" />
        </Header>
        <NavPanel>
            <BitNavPanel @bind-IsOpen="_isNavPanelOpen"
                         Top="65"
                         NoPad NoToggle
                         Items="NavItems"
                         Style="width:222px"
                         SearchBoxPlaceholder="Filter components"
                         SearchBoxStyles="@(new() { Root = "padding-inline:8px" })">
                <Footer>
                    @* The small-screen half of the header's switcher: at the widths where the header
                       hides it, this drawer is already where navigation lives, so it is where the
                       accent belongs too. It hides itself again once the header has room. *@
                    <AccentColorSwitcher Placement="AccentColorSwitcherPlacement.NavPanel" />
                </Footer>
            </BitNavPanel>
        </NavPanel>
        <Main>
            @* bit-fam is what BitComponentBase.ForceAnimation renders, and a couple of components
               (Shimmer, Carousel) gate their keyframes on it rather than on the motion tokens alone.
               Carrying it here on every page EXCEPT a component demo is the other half of the motion
               policy in app.scss: those pages honour prefers-reduced-motion and offer a toggle for
               it, and everywhere else the site animates normally. *@
            <div class="site-content @(_isDemoPage ? null : "bit-fam")">
                @Body
            </div>
        </Main>
        <Footer>
            <AppFooter AppShell="_appShellRef" />
        </Footer>
    </BitLayout>
</BitAppShell>

<BitModalContainer />

<AppAiChatPanel />
