                <br /><br />
                <BitTag>BitThemeNotifications.ThemeChanged</BitTag> &nbsp;&middot;&nbsp; <BitTag>BitThemeChangedEventArgs</BitTag>
            </BitText>

            <br />

            <BitText>
                <b>Authoring</b>
                <br />
                <BitTag>BitTheme</BitTag> &nbsp;&middot;&nbsp; <BitTag>BitThemeFactory</BitTag> (CreateLightTheme, CreateDarkTheme) &nbsp;&middot;&nbsp; <BitTag>BitThemeUtilities</BitTag> (Merge, ToCssVariables, WithAlpha) &nbsp;&middot;&nbsp; <BitTag>BitThemeSerialization</BitTag> &nbsp;&middot;&nbsp; <BitTag>BitThemeDtcg</BitTag> (Export, Import) &nbsp;&middot;&nbsp; <BitTag>BitThemeColorDerivation</BitTag> &nbsp;&middot;&nbsp; <BitTag>BitThemeColorContrast</BitTag> &nbsp;&middot;&nbsp; <BitTag>BitAccentColorPresets</BitTag> &nbsp;&middot;&nbsp; <BitTag>BitThemeBreakpointDefaults</BitTag> &nbsp;&middot;&nbsp; <BitTag>BitThemeDensityPresets</BitTag>
