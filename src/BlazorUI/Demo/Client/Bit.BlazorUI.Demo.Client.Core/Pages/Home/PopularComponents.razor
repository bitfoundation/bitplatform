@namespace Bit.BlazorUI.Demo.Client.Core.Pages
@inherits AppComponentBase

@* The proof, before the claims: five of the most-reached-for components, running, with the source
   that produced them. Picking one on the left swaps both the preview and the code on the right.

   The list used to be rendered twice - once as a column and once inside a carousel for small
   screens - which meant every change had to be made in both copies. It is one list now; below the
   tablet breakpoint it becomes a horizontally scrollable row of the same rows. *@
<div class="showcase">

    <div class="showcase-picker">
        <BitText Element="h2" Typography="BitTypography.H3" Class="showcase-title">Popular components</BitText>
        <BitText Element="p" Typography="BitTypography.Body1" Color="BitColor.SecondaryForeground" Class="showcase-lead">
            Pick one to see it running, and the markup it took to get there.
        </BitText>

        @* Buttons that toggle what the panel beside them shows, rather than role="tab": a real tablist
           owes the reader arrow-key navigation and a matching tabpanel, and claiming the role without
           providing them tells a screen reader something untrue. *@
        <div class="showcase-list" role="group" aria-label="Popular components">
            @foreach (var com in _components)
            {
                var isSelected = com.Name == SelectedComponent?.Name;
                <button type="button"
                        aria-pressed="@isSelected"
                        class="showcase-row @(isSelected ? "active" : null)"
                        @onclick="() => SelectComponent(com)">
                    <span class="showcase-row-icon">
                        <PopularComponentsIcon ComponentName="@com.Name" />
                    </span>
                    <span class="showcase-row-text">
                        <span class="showcase-row-name">@com.Name</span>
                        <span class="showcase-row-desc">@com.Description</span>
                    </span>
                </button>
            }
        </div>
    </div>

    <div class="showcase-stage">
        <div class="showcase-preview">
            <div class="showcase-preview-head">
                <BitText Element="h3" Typography="BitTypography.H6">@SelectedComponent?.Name</BitText>
                <BitSpacer />
                <BitLink Href="@SelectedComponent?.Url" Class="showcase-more">
                    Full docs
                    <BitIcon Class="showcase-more-chevron" IconName="@BitIconName.ChevronRightSmall" />
                </BitLink>
            </div>

            <div class="showcase-preview-body">
                @if (SelectedComponent?.Name == "ColorPicker")
                {
                    <BitColorPicker ShowAlphaSlider ShowPreview @bind-Alpha="Alpha" @bind-Color="@Color" />
                    <BitText Typography="BitTypography.Caption1" Color="BitColor.SecondaryForeground">
                        @Color &nbsp;·&nbsp; alpha @Alpha
                    </BitText>
                }
                else if (SelectedComponent?.Name == "DatePicker")
                {
                    <BitDatePicker @bind-Value="SelectedDate" Placeholder="Select a date" ShowWeekNumbers Style="width:100%;max-width:320px" />
                    <BitText Typography="BitTypography.Caption1" Color="BitColor.SecondaryForeground">
                        Selected: <b>@(SelectedDate?.ToString("dd MMM yyyy") ?? "nothing yet")</b>
                    </BitText>
                }
                else if (SelectedComponent?.Name == "FileUpload")
                {
                    <BitFileUpload AutoUpload
                                   Multiple
                                   ChunkedUpload
                                   Label="Select files"
                                   UploadUrl="@UploadUrl"
                                   RemoveUrl="@RemoveUrl"
                                   MaxSize="1024 * 1024 * 500" />
                }
                else if (SelectedComponent?.Name == "Dropdown")
                {
                    <BitDropdown Label="Multi-select Dropdown"
                                 MultiSelect
                                 Items="DropdownItems"
                                 @bind-Values="SelectedDropdownValues"
                                 Placeholder="Select options"
                                 Style="width:100%;max-width:320px" />
                    <BitText Typography="BitTypography.Caption1" Color="BitColor.SecondaryForeground">
                        Selected: @(SelectedDropdownValues.Any() ? string.Join(", ", SelectedDropdownValues) : "nothing yet")
                    </BitText>
                }
                else if (SelectedComponent?.Name == "Nav (TreeList)")
                {
                    <BitNav Items="NavItems"
                            Mode="BitNavMode.Manual"
                            @bind-SelectedItem="SelectedNavItem"
                            Style="width:100%;max-width:260px" />
                    <BitText Typography="BitTypography.Caption1" Color="BitColor.SecondaryForeground">
                        Selected: <b>@SelectedNavItem.Text</b>
                    </BitText>
                }
            </div>
        </div>

        <div class="showcase-code" id="@CodeBoxId">
            <CodeBox Language="cshtml" MaxHeight="18rem">@SelectedComponent?.Code</CodeBox>
        </div>
    </div>

</div>
