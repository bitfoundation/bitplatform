@namespace Bit.BlazorUI.Demo.Client.Core.Pages
@inherits AppComponentBase

@* The library, by category. This used to be every one of the ~110 component names written out by
   hand - a list that had to be edited alongside the nav, could not be searched, and told a reader
   nothing about what any of them did. The names now live on /components, which is searchable and
   built from the same source as the nav; this is the way in. *@
<BitText Element="h2" Typography="BitTypography.H3">@ComponentCatalog.Items.Count components, in @ComponentCatalog.Categories.Count categories</BitText>
<BitText Element="p" Typography="BitTypography.Body1" Color="BitColor.SecondaryForeground" Class="categories-lead">
    Everything an application UI is made of - and a few things it usually is not, like a pure-C# PDF
    viewer, a native charting component and a full scheduler.
</BitText>

<div class="category-grid">
    @foreach (var category in ComponentCatalog.Categories)
    {
        <a class="category" href="@($"/components?category={Uri.EscapeDataString(category.Name)}")">
            <BitIcon IconName="@category.IconName" Color="BitColor.Primary" Class="category-icon" />
            <span class="category-name">@category.Name</span>
            <span class="category-count">@category.Items.Count components</span>
        </a>
    }
</div>

<div class="categories-cta">
    <BitButton Href="/components" Size="BitSize.Large" Variant="BitVariant.Outline"
               IconName="@BitIconName.ChevronRightSmall" IconPosition="BitIconPosition.End">
        Browse all components
    </BitButton>
</div>
