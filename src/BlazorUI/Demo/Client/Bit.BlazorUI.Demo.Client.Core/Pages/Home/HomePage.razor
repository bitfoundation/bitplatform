@page "/"
@namespace Bit.BlazorUI.Demo.Client.Core.Pages

<PageOutlet Url=""
            FullTitle="bit BlazorUI - Native, Open-Source Blazor UI Component Library"
            Title="Home"
            Description="bit BlazorUI is an open-source set of 80+ native Blazor UI components for WebAssembly, Server, Hybrid (MAUI) and pre-rendering. Explore the docs." />

<div class="homepage-container">
    <section class="homepage-section hero-section">
        <div class="homepage-section-content">
            <HeroSection />
        </div>
    </section>

    <section class="homepage-section popular-components-section">
        <div class="homepage-section-content">
            <PopularComponents />
        </div>
    </section>

    <section class="homepage-section benefit-section">
        <div class="homepage-section-content">
            <BenefitsSection />
        </div>
    </section>

    <section class="homepage-section ai-section">
        <div class="homepage-section-content">
            <div class="ai-section-info">
                <BitText Element="h2" Typography="BitTypography.H3" Gutter>Built for the AI-assisted workflow</BitText>
                <BitText Typography="BitTypography.Body1" Gutter Style="max-width: 700px">
                    Connect your AI coding agent (GitHub Copilot, Cursor, Claude, Windsurf, and more) to the official
                    bit BlazorUI MCP server, and it will discover components, pull accurate usage examples,
                    and follow the library's best practices automatically.
                </BitText>
                <BitButton Href="/getting-started" Variant="BitVariant.Outline"
                           IconName="@BitIconName.ChevronRightSmall" IconPosition="BitIconPosition.End">
                    Set up AI integration
                </BitButton>
            </div>
            <div class="ai-section-code">
                <CodeBox Language="json">{
  "mcpServers": {
    "bitBlazorUI": {
      "type": "http",
      "url": "https://blazorui.bitplatform.dev/mcp"
    }
  }
}</CodeBox>
            </div>
        </div>
    </section>

    <section class="homepage-section component-list-section">
        <div class="homepage-section-content">
            <ComponentsSection />
        </div>
    </section>

    <section class="homepage-section contribution-section">
        <div class="homepage-section-content">
            <BitText Element="h2" Typography="BitTypography.H3" Gutter>Start building with bit BlazorUI</BitText>
            <BitText Typography="BitTypography.Body1" Gutter Style="max-width: 700px">
                Free and open source, backed by a professional dedicated development team and an active community.
                All components live on GitHub, so you can follow their production flow,
                report bugs, fork the repo, and submit pull requests.
            </BitText>
            <BitStack Horizontal Wrap Gap="1rem">
                <BitButton Href="/getting-started" Size="BitSize.Large"
                           IconName="@BitIconName.ChevronRightSmall" IconPosition="BitIconPosition.End">
                    Get started
                </BitButton>
                <BitButton IconUrl="_content/Bit.BlazorUI.Demo.Client.Core/images/icon/github-blue-icon.svg"
                           Size="BitSize.Large"
                           Variant="BitVariant.Outline"
                           Href="https://github.com/bitfoundation/bitplatform" Target="_blank">
                    GitHub
                </BitButton>
                <BitSpacer />
                <GitHubEditButton GitHubUrl="Home/HomePage.razor" />
            </BitStack>
        </div>
    </section>
</div>
