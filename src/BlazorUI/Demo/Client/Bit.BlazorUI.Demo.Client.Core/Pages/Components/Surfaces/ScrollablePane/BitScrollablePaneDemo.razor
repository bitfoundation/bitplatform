                </BitScrollablePane>
                <br /><br />
                <div>Both axes at once:</div><br />
                <BitScrollablePane Height="10rem" Width="22rem" Class="pane" Fade>
                    <div class="wide-grid">
                        @for (var row = 1; row <= 8; row++)
