@page "/components/stack"

<PageOutlet Url="components/stack"
            Title="Stack"
            Description="A Stack is a container-type component that abstracts the implementation of a flexbox in order to define the layout of its children components: a row or a column with a gap, aligned on either axis, wrapping, and responsive per breakpoint." />
<div>
    <DemoPage Name="Stack"
              SecondaryNames="@(["WrapPanel"])"
              Description="A Stack is a container-type component that abstracts the implementation of a flexbox in order to define the layout of its children components. It lays them out in a column or a row with a gap, aligns them by axis name (HorizontalAlign, VerticalAlign) so the same parameter means the same thing in either direction, sizes them and itself, acts as a flex item inside another stack, and switches direction, spacing and wrapping per breakpoint."
              Parameters="componentParameters"
              CssVariables="componentCssVariables"
              SubEnums="componentSubEnums"
              GitHubUrl="Layouts/Stack/BitStack.cs"
              GitHubDemoUrl="Layouts/Stack/BitStackDemo.razor">
        <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
            <div class="example-desc">
                A column by default; <b>Horizontal</b> makes it a row. <b>Reversed</b> flips the painted order only - screen
                readers and the keyboard still follow the source order.
            </div>
            <div class="example-content">
                <div class="caption">Default (vertical)</div>
                <BitStack Class="stack">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">Horizontal</div>
                <BitStack Horizontal Class="stack">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">Reversed vertical</div>
                <BitStack Reversed Class="stack">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">Reversed horizontal</div>
                <BitStack Horizontal Reversed Class="stack">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="Alignment" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
            <div class="example-desc">
                <b>HorizontalAlign</b> and <b>VerticalAlign</b> name the screen axis, not the flexbox property, so they keep
                their meaning when the direction flips. The space distributions only apply along the children's axis and
                <b>Baseline</b> only across it; a value that does not apply falls back to <b>Alignment</b>, the both-axes
                shorthand. To push one child away from the rest, use a <BitLink Href="/components/spacer">BitSpacer</BitLink>.
            </div>
            <div class="example-content">
                <BitStack Horizontal>
                    <BitToggle @bind-Value="isHorizontal" Text="Horizontal" />
                    <BitToggle @bind-Value="isReversed" Text="Reversed" />
                </BitStack>
                <br />
                <BitChoiceGroup @bind-Value="horizontalAlign"
                                Horizontal
                                Label="Horizontal Align"
                                TItem="BitChoiceGroupOption<BitAlignment>" TValue="BitAlignment">
                    <BitChoiceGroupOption Text="Start" Value="BitAlignment.Start" />
                    <BitChoiceGroupOption Text="Center" Value="BitAlignment.Center" />
                    <BitChoiceGroupOption Text="End" Value="BitAlignment.End" />
                    <BitChoiceGroupOption Text="SpaceBetween" Value="BitAlignment.SpaceBetween" />
                    <BitChoiceGroupOption Text="SpaceAround" Value="BitAlignment.SpaceAround" />
                    <BitChoiceGroupOption Text="SpaceEvenly" Value="BitAlignment.SpaceEvenly" />
                    <BitChoiceGroupOption Text="Baseline" Value="BitAlignment.Baseline" />
                    <BitChoiceGroupOption Text="Stretch" Value="BitAlignment.Stretch" />
                </BitChoiceGroup>
                <br />
                <BitChoiceGroup @bind-Value="verticalAlign"
                                Horizontal
                                Label="Vertical Align"
                                TItem="BitChoiceGroupOption<BitAlignment>" TValue="BitAlignment">
                    <BitChoiceGroupOption Text="Start" Value="BitAlignment.Start" />
                    <BitChoiceGroupOption Text="Center" Value="BitAlignment.Center" />
                    <BitChoiceGroupOption Text="End" Value="BitAlignment.End" />
                    <BitChoiceGroupOption Text="SpaceBetween" Value="BitAlignment.SpaceBetween" />
                    <BitChoiceGroupOption Text="SpaceAround" Value="BitAlignment.SpaceAround" />
                    <BitChoiceGroupOption Text="SpaceEvenly" Value="BitAlignment.SpaceEvenly" />
                    <BitChoiceGroupOption Text="Baseline" Value="BitAlignment.Baseline" />
                    <BitChoiceGroupOption Text="Stretch" Value="BitAlignment.Stretch" />
                </BitChoiceGroup>
                <br />
                <BitStack Class="stack"
                          Reversed="isReversed"
                          Horizontal="isHorizontal"
                          VerticalAlign="verticalAlign"
                          HorizontalAlign="horizontalAlign"
                          Style="height:15rem">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption"><code>Alignment</code>: both axes at once, which is the whole of centering something</div>
                <BitStack Alignment="BitAlignment.Center" Class="stack" Style="height:8rem">
                    <div class="item">Centered</div>
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="Wrap" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
            <div class="example-desc">
                <b>Wrap</b> moves children that do not fit onto more rows instead of squeezing them; <b>WrapReverse</b> stacks
                those rows from the far edge. <b>AlignContent</b> places the rows once there is more than one.
                <b>WrapXs</b> to <b>WrapXxl</b> switch wrapping per breakpoint, with <b>Wrap</b> as the base.
            </div>
            <div class="example-content">
                <BitSlider Label="Stack height" Min="10" Max="20" Step="0.1" ValueFormat="0.0 rem" @bind-Value="@stackHeight" />
                <br />
                <BitChoiceGroup @bind-Value="alignContent"
                                Horizontal
                                Label="Align Content"
                                TItem="BitChoiceGroupOption<BitAlignment>" TValue="BitAlignment">
                    <BitChoiceGroupOption Text="Start" Value="BitAlignment.Start" />
                    <BitChoiceGroupOption Text="Center" Value="BitAlignment.Center" />
                    <BitChoiceGroupOption Text="End" Value="BitAlignment.End" />
                    <BitChoiceGroupOption Text="SpaceBetween" Value="BitAlignment.SpaceBetween" />
                    <BitChoiceGroupOption Text="SpaceEvenly" Value="BitAlignment.SpaceEvenly" />
                    <BitChoiceGroupOption Text="Stretch" Value="BitAlignment.Stretch" />
                </BitChoiceGroup>
                <br />
                <BitToggle @bind-Value="isWrapReversed" Text="Wrap reverse" />
                <br />
                <BitStack Wrap
                          WrapReverse="isWrapReversed"
                          AlignContent="alignContent"
                          Class="stack"
                          Style="@($"height:{stackHeight.ToString(CultureInfo.InvariantCulture)}rem")">
                    @for (int i = 1; i <= 20; i++)
                    {
                        <div class="square">@i</div>
                    }
                </BitStack>
                <br />
                <div class="caption">
                    Per breakpoint: this row wraps below <code>md</code> (960px) and holds its single line from it upwards,
                    where what no longer fits is squeezed instead
                </div>
                <BitStack Horizontal Wrap WrapMd="false" Class="stack">
                    @for (int i = 1; i <= 16; i++)
                    {
                        <div class="square">@i</div>
                    }
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="Gap" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
            <div class="example-desc">
                <b>Gap</b> takes any CSS length (one for both axes, or two: vertical then horizontal) and defaults to the
                theme spacing (<code>1rem</code>), which <code>--bit-Stack-gap</code> overrides app-wide.
                <b>HorizontalGap</b> and <b>VerticalGap</b> replace it on one axis. It is a CSS gap, so there is never room
                before the first child or after the last. For a visible divider, put a
                <BitLink Href="/components/separator">BitSeparator</BitLink> between two children.
            </div>
            <div class="example-content">
                <BitSlider Label="Gap between items" Max="5" ValueFormat="0.0 rem" Step="0.1" @bind-Value="@gap" />
                <br />
                <BitStack Gap="@($"{gap.ToString(CultureInfo.InvariantCulture)}rem")" Class="stack">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">Per axis: <code>HorizontalGap</code> 2rem between the columns, <code>VerticalGap</code> 0.25rem between the rows</div>
                <BitStack Horizontal Wrap HorizontalGap="2rem" VerticalGap="0.25rem" Class="stack">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <div class="item">Item @i</div>
                    }
                </BitStack>
                <br />
                <div class="caption">A <code>BitSeparator</code> drawn in the room the gap leaves</div>
                <BitStack HorizontalAlign="BitAlignment.Stretch" Class="stack">
                    <div class="item">Item 1</div>
                    <BitSeparator />
                    <div class="item">Item 2</div>
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="Responsive" RazorCode="@example5RazorCode" Id="example5">
            <div class="example-desc">
                Per-breakpoint chains, mobile first: each value applies from its breakpoint upwards until a wider one
                replaces it, and the plain parameter is the base. <b>HorizontalXs</b>..<b>HorizontalXxl</b> set the
                direction (the alignments follow it), <b>GapXs</b>..<b>GapXxl</b> the spacing, and
                <b>HorizontalGapXs</b>..<b>VerticalGapXxl</b> one axis of it. <b>Reversed</b> and <b>WrapReverse</b> apply at
                every width. Narrow the window below <code>960px</code> to see them change.
            </div>
            <div class="example-content">
                <div class="caption">Column below <code>md</code> (960px), row from it upwards</div>
                <BitStack HorizontalMd Class="stack">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">Row below <code>lg</code> (1280px), column from it upwards</div>
                <BitStack Horizontal HorizontalLg="false" Class="stack">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">
                    The alignments follow the direction: <code>HorizontalAlign</code> SpaceBetween spreads the row and is
                    ignored by the column, <code>VerticalAlign</code> Center centers either one
                </div>
                <BitStack HorizontalMd
                          Class="stack"
                          VerticalAlign="BitAlignment.Center"
                          HorizontalAlign="BitAlignment.SpaceBetween"
                          Style="height:12rem">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">
                    Direction and spacing together: a column with a <code>0.25rem</code> gap below <code>md</code>, a row with
                    a <code>3rem</code> one from it upwards
                </div>
                <BitStack HorizontalMd Gap="0.25rem" GapMd="3rem" Class="stack">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">
                    One axis at a time: the rows of this wrapping stack keep the <code>0.5rem</code> the <code>Gap</code> chain
                    gives them at every width, while its columns open from <code>0.5rem</code> to <code>3rem</code> at
                    <code>md</code> and to <code>5rem</code> at <code>lg</code>
                </div>
                <BitStack Horizontal Wrap Gap="0.5rem" HorizontalGapMd="3rem" HorizontalGapLg="5rem" Class="stack">
                    @for (int i = 1; i <= 8; i++)
                    {
                        <div class="item">Item @i</div>
                    }
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="Nesting" RazorCode="@example6RazorCode" Id="example6">
            <div class="example-desc">
                A stack is both a flex container and a flex item, so real layouts are stacks inside stacks, each with its own
                direction and spacing.
            </div>
            <div class="example-content">
                <BitStack Horizontal HorizontalAlign="BitAlignment.SpaceAround" Class="stack">
                    <div class="item">Item 1</div>
                    <BitStack>
                        <div class="item">Item 2-1</div>
                        <div class="item">Item 2-2</div>
                        <div class="item">Item 2-3</div>
                    </BitStack>
                    <BitStack Horizontal>
                        <div class="item">Item 3-1</div>
                        <div class="item">Item 3-2</div>
                        <div class="item">Item 3-3</div>
                    </BitStack>
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="Content sizing" RazorCode="@example7RazorCode" Id="example7">
            <div class="example-desc">
                These act on the direct children. <b>FillContent</b> stretches them across the stack (full width in a
                column, full height in a row). Along it, <b>GrowContent</b> shares the leftover room (bigger content stays
                bigger), <b>EqualContent</b> gives exactly equal shares, and <b>NoShrinkContent</b> stops them being
                squeezed, so they overflow or wrap instead.
            </div>
            <div class="example-content">
                <div class="caption">FillContent (cross axis)</div>
                <BitStack FillContent Class="stack" Style="width:20rem">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">GrowContent (main axis): the leftover shared out, so the longer child stays longer</div>
                <BitStack Horizontal GrowContent Class="stack">
                    <div class="item">Item 1</div>
                    <div class="item">A much longer item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">EqualContent (main axis): exact thirds instead</div>
                <BitStack Horizontal EqualContent Class="stack">
                    <div class="item">Item 1</div>
                    <div class="item">A much longer item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">FillContent and GrowContent together</div>
                <BitStack Horizontal FillContent GrowContent Class="stack" Style="height:6rem">
                    <div class="item">Item 1</div>
                    <div class="item">Item 2</div>
                    <div class="item">Item 3</div>
                </BitStack>
                <br />
                <div class="caption">Eight squares in a row too narrow for them: squeezed to fit</div>
                <BitStack Horizontal Gap="0.5rem" Class="host" Style="width:20rem">
                    @for (int i = 1; i <= 8; i++)
                    {
                        <div class="square">@i</div>
                    }
                </BitStack>
                <br />
                <div class="caption">NoShrinkContent: kept at their own size, and what no longer fits overflows</div>
                <BitStack Horizontal NoShrinkContent Gap="0.5rem" Class="host" Style="width:20rem">
                    @for (int i = 1; i <= 8; i++)
                    {
                        <div class="square">@i</div>
                    }
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="Sizing" RazorCode="@example8RazorCode" Id="example8">
            <div class="example-desc">
                A stack fills its container by default. <b>AutoWidth</b>, <b>AutoHeight</b> and <b>AutoSize</b> size it to its
                content; <b>FitWidth</b>, <b>FitHeight</b> and <b>FitSize</b> do the same but also hold inside a parent that
                stretches its children.
            </div>
            <div class="example-content">
                <div class="caption">In a plain block: the default fills the width, AutoWidth hands it back</div>
                <BitStack Class="stack" AutoHeight>
                    <div class="item">Default</div>
                </BitStack>
                <br />
                <BitStack Class="stack" AutoHeight AutoWidth>
                    <div class="item">AutoWidth</div>
                </BitStack>
                <br />
                <div class="caption">Inside a row that stretches its children: only the fitted height holds</div>
                <BitStack Horizontal Class="host" VerticalAlign="BitAlignment.Stretch" Style="height:8rem">
                    <BitStack Class="stack" AutoWidth AutoHeight>
                        <div class="item">AutoHeight</div>
                    </BitStack>
                    <BitStack Class="stack" AutoWidth FitHeight>
                        <div class="item">FitHeight</div>
                    </BitStack>
                    <BitStack Class="stack" FitSize>
                        <div class="item">FitSize</div>
                    </BitStack>
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="As a flex item" RazorCode="@example9RazorCode" Id="example9">
            <div class="example-desc">
                For a stack inside another flex container. <b>Grow</b>/<b>Grows</b> take leftover room, <b>Basis</b> is the
                starting size (<code>0</code> gives equal columns), <b>Shrink</b>/<b>NoShrink</b> control squeezing,
                <b>Shrinkable</b> lets it shrink below its content (for ellipsis or scrolling), <b>Self</b> overrides the
                parent's cross-axis alignment, and <b>Order</b> moves it visually without changing reading or tab order.
            </div>
            <div class="example-content">
                <div class="caption">Grow &amp; Grows</div>
                <BitStack Horizontal Gap="0.5rem" Class="host" AutoHeight>
                    <BitStack Grow="3" Class="item" AutoSize Alignment="BitAlignment.Center">Grow 3</BitStack>
                    <BitStack Grow="2" Class="item" AutoSize Alignment="BitAlignment.Center">Grow 2</BitStack>
                    <BitStack Grows Class="item" AutoSize Alignment="BitAlignment.Center">Grows</BitStack>
                </BitStack>
                <br />
                <div class="caption">Grows alone, then with a Basis of 0: the same three stacks, sized by what they hold and then equally</div>
                <BitStack Horizontal Gap="0.5rem" Class="host" AutoHeight>
                    <BitStack Grows Class="item" AutoSize Alignment="BitAlignment.Center">One</BitStack>
                    <BitStack Grows Class="item" AutoSize Alignment="BitAlignment.Center">The second one</BitStack>
                    <BitStack Grows Class="item" AutoSize Alignment="BitAlignment.Center">Three</BitStack>
                </BitStack>
                <br />
                <BitStack Horizontal Gap="0.5rem" Class="host" AutoHeight>
                    <BitStack Grows Basis="0" Class="item" AutoSize Alignment="BitAlignment.Center">One</BitStack>
                    <BitStack Grows Basis="0" Class="item" AutoSize Alignment="BitAlignment.Center">The second one</BitStack>
                    <BitStack Grows Basis="0" Class="item" AutoSize Alignment="BitAlignment.Center">Three</BitStack>
                </BitStack>
                <br />
                <div class="caption">Shrink: three stacks of 12rem in a row of 24rem, giving up what it is short of by their factor</div>
                <BitStack Horizontal Gap="0.5rem" Class="host" AutoHeight Style="width:24rem">
                    <BitStack Shrink="3" Class="item squeezable" AutoSize Style="width:12rem">Shrink 3</BitStack>
                    <BitStack Class="item squeezable" AutoSize Style="width:12rem">Default</BitStack>
                    <BitStack NoShrink Class="item squeezable" AutoSize Style="width:12rem">NoShrink</BitStack>
                </BitStack>
                <br />
                <div class="caption">NoShrink: drag the handle at the corner to squeeze the row</div>
                <div class="resizable">
                    <BitStack Horizontal Gap="0.5rem" Class="host" AutoHeight>
                        <BitStack Class="item squeezable" AutoSize>Shrinks away</BitStack>
                        <BitStack Class="item" AutoSize NoShrink>Never shrinks</BitStack>
                        <BitStack Class="item squeezable" AutoSize>Shrinks away</BitStack>
                    </BitStack>
                </div>
                <br />
                <div class="caption">Shrinkable: the same nested stack without and with the floor its own content puts under it</div>
                <BitStack Horizontal Class="host" AutoHeight>
                    <BitStack Class="truncating">
                        <div class="item ellipsis">A very long label that has nowhere near enough room to be shown in full</div>
                    </BitStack>
                    <div class="item">Fixed</div>
                </BitStack>
                <br />
                <BitStack Horizontal Class="host" AutoHeight>
                    <BitStack Shrinkable Class="truncating">
                        <div class="item ellipsis">A very long label that has nowhere near enough room to be shown in full</div>
                    </BitStack>
                    <div class="item">Fixed</div>
                </BitStack>
                <br />
                <div class="caption">Self &amp; Order</div>
                <BitStack Horizontal Gap="0.5rem" Class="host" VerticalAlign="BitAlignment.Center" Style="height:8rem">
                    <BitStack Class="item" AutoSize Self="BitAlignment.Start">Self Start</BitStack>
                    <BitStack Class="item" AutoSize>Centered</BitStack>
                    <BitStack Class="item" AutoSize Self="BitAlignment.End">Self End</BitStack>
                    <BitStack Class="item" AutoSize Order="-1">Order -1 (written last)</BitStack>
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="Padding" RazorCode="@example10RazorCode" Id="example10">
            <div class="example-desc">
                <b>Padding</b> takes the CSS shorthand. The stack is border-box, so padding never grows it. Use a fluid length
                such as <code>clamp(0.5rem, 2vw, 2rem)</code> for padding that follows the viewport.
            </div>
            <div class="example-content">
                <BitStack Horizontal Gap="1rem" AutoHeight>
                    <BitStack Padding="1rem" Class="stack" AutoHeight>
                        <div class="item">Padding 1rem</div>
                    </BitStack>
                    <BitStack Padding="2rem 0.5rem" Class="stack" AutoHeight>
                        <div class="item">Padding 2rem 0.5rem</div>
                    </BitStack>
                </BitStack>
                <br />
                <div class="caption">A fluid padding: narrow the window to watch it close up</div>
                <BitStack Padding="clamp(0.5rem, 2vw, 2rem)" Class="stack" AutoHeight>
                    <div class="item">Padding clamp(0.5rem, 2vw, 2rem)</div>
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="Element & Inline" RazorCode="@example11RazorCode" Id="example11">
            <div class="example-desc">
                <b>Element</b> changes the tag (<code>nav</code>, <code>section</code>, <code>ul</code>...) for the right
                semantics; name a landmark with <b>AriaLabel</b>. A <code>ul</code>, <code>ol</code> or <code>menu</code> also
                gets <code>role="list"</code>, which flex layout makes some browsers drop. <b>Inline</b> renders an
                <code>inline-flex</code> box sized by its content, to sit inside a line of text.
            </div>
            <div class="example-content">
                <BitStack Horizontal Element="nav" AriaLabel="Main" Class="stack" AutoHeight>
                    <div class="item">Home</div>
                    <div class="item">Products</div>
                    <div class="item">About</div>
                </BitStack>
                <br />
                <div class="caption">A list, whose children are the <code>li</code> elements that belong in one</div>
                <BitStack Element="ul" AriaLabel="Tags" Class="stack list" AutoHeight>
                    <li class="item">First</li>
                    <li class="item">Second</li>
                    <li class="item">Third</li>
                </BitStack>
                <br />
                <div>
                    An inline stack
                    <BitStack Inline Horizontal Gap="0.25rem" Class="stack">
                        <div class="item">flows</div>
                        <div class="item">with</div>
                    </BitStack>
                    the text around it.
                </div>
            </div>
        </DemoExample>

        <DemoExample Title="Cascading parameters" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
            <div class="example-desc">
                <b>BitParams</b> hands a <b>BitStackParams</b> to every stack below it as defaults: a stack that sets a
                parameter itself keeps its own value.
            </div>
            <div class="example-content">
                <BitParams Parameters="@stackParams">
                    <BitStack Class="stack">
                        <div class="item">Item 1</div>
                        <div class="item">Item 2</div>
                        <div class="item">Item 3</div>
                    </BitStack>
                    <br />
                    <BitStack Horizontal="false" Class="stack">
                        <div class="item">Its own Horizontal="false"</div>
                        <div class="item">The cascaded rest</div>
                    </BitStack>
                </BitParams>
            </div>
        </DemoExample>

        <DemoExample Title="Size" RazorCode="@example13RazorCode" Id="example13">
            <div class="example-desc">
                <b>Size</b> picks the gap from the theme spacing scale (<b>Small</b>, <b>Medium</b>, <b>Large</b>), so it follows
                the theme spacing unit and density. <b>Gap</b>, <b>HorizontalGap</b> and <b>VerticalGap</b> win over it.
            </div>
            <div class="example-content">
                <BitStack Horizontal Size="BitSize.Small" Class="stack" AutoHeight>
                    <div class="item">Small</div>
                    <div class="item">Small</div>
                    <div class="item">Small</div>
                </BitStack>
                <br />
                <BitStack Horizontal Size="BitSize.Medium" Class="stack" AutoHeight>
                    <div class="item">Medium</div>
                    <div class="item">Medium</div>
                    <div class="item">Medium</div>
                </BitStack>
                <br />
                <BitStack Horizontal Size="BitSize.Large" Class="stack" AutoHeight>
                    <div class="item">Large</div>
                    <div class="item">Large</div>
                    <div class="item">Large</div>
                </BitStack>
            </div>
        </DemoExample>

        <DemoExample Title="Style & Class" RazorCode="@example14RazorCode" Id="example14">
            <div class="example-desc">
                <b>Style</b> and <b>Class</b> land on the root and win over the generated styles, except <code>display</code>.
                <code>--bit-Stack-gap</code> inherits, so setting it on <code>:root</code> or any ancestor changes the default
                gap of every stack inside that was given no gap of its own.
            </div>
            <div class="example-content">
                <BitStack Horizontal AutoHeight Style="padding:1rem;border-radius:0.5rem;border:2px dashed var(--bit-clr-err);background:color-mix(in srgb, var(--bit-clr-err) 14%, transparent)">
                    <div class="item">Style</div>
                    <div class="item">on the stack</div>
                </BitStack>
                <br />
                <BitStack Horizontal AutoHeight Class="custom-stack">
                    <div class="item">Class</div>
                    <div class="item">on the stack</div>
                </BitStack>
                <br />
                <div class="caption"><code>--bit-Stack-gap</code> set on a wrapper</div>
                <div style="--bit-Stack-gap:0.25rem">
                    <BitStack Horizontal AutoHeight Class="stack">
                        <div class="item">A tight</div>
                        <div class="item">default</div>
                        <div class="item">gap</div>
                    </BitStack>
                </div>
            </div>
        </DemoExample>

        <DemoExample Title="RTL" RazorCode="@example15RazorCode" Id="example15">
            <div class="example-desc">
                With <b>Dir</b> set to RTL a horizontal stack starts at the right, and <b>HorizontalAlign</b> start/end follow.
            </div>
            <div class="example-content">
                <div class="caption">Horizontal, right-to-left</div>
                <BitStack Horizontal Dir="BitDir.Rtl" Class="stack">
                    <div class="item">یک</div>
                    <div class="item">دو</div>
                    <div class="item">سه</div>
                </BitStack>
                <br />
                <div class="caption">Horizontal, right-to-left and reversed</div>
                <BitStack Horizontal Reversed Dir="BitDir.Rtl" Class="stack">
                    <div class="item">یک</div>
                    <div class="item">دو</div>
                    <div class="item">سه</div>
                </BitStack>
                <br />
                <div class="caption">Vertical, right-to-left, aligned to the end of the horizontal axis</div>
                <BitStack Dir="BitDir.Rtl" HorizontalAlign="BitAlignment.End" Class="stack">
                    <div class="item">یک</div>
                    <div class="item">دو</div>
                    <div class="item">سه</div>
                </BitStack>
            </div>
        </DemoExample>
    </DemoPage>
</div>
