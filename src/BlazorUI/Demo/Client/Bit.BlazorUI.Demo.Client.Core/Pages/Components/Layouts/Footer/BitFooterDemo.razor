    <DemoExample Title="Size" RazorCode="@example15RazorCode" Id="example15">
        <div>The size sets the paddings around the content.</div>
        <br />
        <div class="container">
            <BitFooter Size="BitSize.Small" Bordered>Small</BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Size="BitSize.Medium" Bordered>Medium</BitFooter>
        </div>
        <br />
