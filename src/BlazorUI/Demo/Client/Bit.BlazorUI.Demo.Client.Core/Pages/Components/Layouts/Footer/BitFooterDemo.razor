@page "/components/footer"

<PageOutlet Url="components/footer"
            Title="Footer"
            Description="The BitFooter component renders the bar at the bottom of a site or an application, with theme colors, variants, sizes, alignment, wrapping, spacing and pinned positioning." />

<DemoPage Name="Footer"
          Description="The BitFooter component renders the bar at the bottom of a site or an application: a copyright line, legal links, social icons or a toolbar of actions. It renders a semantic footer element (the contentinfo landmark), lays its content out in a themeable flex line, and can be pinned to the bottom of the viewport, reveal itself on scroll, or slide away on demand."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          CssVariables="componentCssVariables"
          GitHubUrl="Layouts/Footer/BitFooter.razor"
          GitHubDemoUrl="Layouts/Footer/BitFooterDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>As tall as its content plus the paddings of its size; <b>Height</b> fixes it in pixels.</div>
        <br />
        <div class="container">
            <BitFooter>I'm a Footer</BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Height="80">I'm a Footer with a fixed 80px height</BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter IsEnabled="false">I'm a disabled Footer</BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Variant" RazorCode="@example2RazorCode" Id="example2">
        <div><b>Fill</b> (default) paints the color as the background, <b>Outline</b> as a border, <b>Text</b> as the text alone.</div>
        <br />
        <div class="container">
            <BitFooter Variant="BitVariant.Fill" Color="BitColor.Info">Fill</BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Variant="BitVariant.Outline" Color="BitColor.Info">Outline</BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Variant="BitVariant.Text" Color="BitColor.Info">Text</BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Alignment" RazorCode="@example3RazorCode" Id="example3">
        <div>
            <b>Alignment</b> distributes the content along the line (<b>SpaceBetween</b> is the classic copyright-left, links-right footer).
            <b>VerticalAlign</b> places it in the height of a footer taller than its content (centered by default).
        </div>
        <br />
        <div class="container">
            <BitFooter Alignment="BitAlignment.Start" Bordered>
                <BitTag Text="Start" />
                <BitTag Text="of" />
                <BitTag Text="the line" />
            </BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Alignment="BitAlignment.Center" Bordered>
                <BitTag Text="Center" />
                <BitTag Text="of" />
                <BitTag Text="the line" />
            </BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Alignment="BitAlignment.End" Bordered>
                <BitTag Text="End" />
                <BitTag Text="of" />
                <BitTag Text="the line" />
            </BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Alignment="BitAlignment.SpaceBetween" Bordered>
                <BitTag Text="Space" />
                <BitTag Text="between" />
                <BitTag Text="the items" />
            </BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Alignment="BitAlignment.SpaceAround" Bordered>
                <BitTag Text="Space" />
                <BitTag Text="around" />
                <BitTag Text="the items" />
            </BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Alignment="BitAlignment.SpaceEvenly" Bordered>
                <BitTag Text="Space" />
                <BitTag Text="evenly" />
                <BitTag Text="around the items" />
            </BitFooter>
        </div>
        <br /><br />
        <div class="container">
            <BitFooter Height="72" Bordered VerticalAlign="BitAlignment.Start">
                <BitTag Text="Top of the footer" />
            </BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Height="72" Bordered VerticalAlign="BitAlignment.End">
                <BitTag Text="Bottom of the footer" />
            </BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Spacing & wrap" RazorCode="@example4RazorCode" Id="example4">
        <div>
            <b>Gap</b> spaces the children (any CSS length, or the two value gap shorthand). <b>Wrap</b> breaks a crowded line
            instead of squeezing it. <b>MaxWidth</b> centers the content in a column while the bar stays full width.
            <b>NoGutter</b> removes the paddings for edge to edge content.
        </div>
        <br />
        <div class="container">
            <BitFooter Bordered Gap="1rem">
                <BitTag Text="A" />
                <BitTag Text="1rem" />
                <BitTag Text="gap" />
            </BitFooter>
        </div>
        <br />
        <div class="container wrap-demo">
            <BitFooter Bordered Wrap Gap="0.25rem 0.5rem" Alignment="BitAlignment.Center">
                @for (var i = 1; i <= 8; i++)
                {
                    <BitTag Text="@($"Wrapped {i}")" />
                }
            </BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Bordered MaxWidth="20rem" Alignment="BitAlignment.SpaceBetween">
                <BitTag Text="Centered" />
                <BitTag Text="20rem column" />
            </BitFooter>
        </div>
        <br />
        <div class="container">
            <BitFooter Bordered NoGutter>
                <BitProgress Percent="60" />
            </BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Border & elevation" RazorCode="@example5RazorCode" Id="example5">
        <div><b>Bordered</b> draws a divider on the top edge; <b>Elevated</b> casts a shadow upwards, over the content above.</div>
        <br />
        <div class="container">
            <BitFooter Bordered>Bordered</BitFooter>
        </div>
        <br />
        <br />
        <div class="container">
            <BitFooter Elevated>Elevated</BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Position" RazorCode="@example6RazorCode" Id="example6">
        <div>
            <b>Sticky</b> stays in the flow and sticks to the bottom of the scrolling area. <b>Fixed</b> pins to the bottom of the
            page and overlaps the content (reserve room for it). <b>Absolute</b> pins to the nearest positioned ancestor.
            Fixed beats Absolute, which beats Sticky. Fixed and Sticky also make room for the device's bottom safe area.
        </div>
        <br />
        <div>Sticky (scroll inside the box):</div>
        <br />
        <div class="scroll-demo">
            @for (var i = 1; i <= 12; i++)
            {
                <div class="scroll-demo-row">Row @i</div>
            }
            <BitFooter Sticky Bordered Color="BitColor.SecondaryBackground">I'm a sticky Footer</BitFooter>
        </div>
        <br />
        <br />
        <div>Fixed (scoped to the box below for the sake of the demo):</div>
        <br />
        <div class="fixed-demo">
            <div class="scroll-demo-row">The fixed footer covers the bottom of its page.</div>
            <BitFooter Fixed Elevated Color="BitColor.Primary">I'm a fixed Footer</BitFooter>
        </div>
        <br />
        <br />
        <div>Absolute:</div>
        <br />
        <div class="absolute-demo">
            <div class="scroll-demo-row">The absolute footer covers the bottom of its container.</div>
            <BitFooter Absolute Bordered Color="BitColor.TertiaryBackground">I'm an absolute Footer</BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Reveal" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
        <div>
            <b>Reveal</b> slides a Fixed or Sticky footer away while scrolling down and back while scrolling up; it is always
            shown at both ends, and comes back when anything inside it takes the focus. <b>OnRevealChanged</b> and
            <b>IsRevealed</b> report the state.
        </div>
        <br />
        <div>Scroll inside the box: <b>@(isFooterRevealed ? "revealed" : "hidden")</b></div>
        <br />
        <div class="scroll-demo">
            @for (var i = 1; i <= 12; i++)
            {
                <div class="scroll-demo-row">Row @i</div>
            }
            <BitFooter Sticky Reveal Elevated
                       Color="BitColor.Primary"
                       Alignment="BitAlignment.Center"
                       OnRevealChanged="v => isFooterRevealed = v">
                I hide myself while you scroll down
            </BitFooter>
        </div>
        <br />
        <br />
        <div>
            <b>RevealOffset</b> keeps it in place for the first pixels of a scroll. <b>ScrollTarget</b> names the scrolling
            element when the footer is not inside it, as in an app shell whose pane and footer are siblings:
        </div>
        <br />
        <div class="fixed-demo">
            <div id="footer-reveal-pane" class="shell-pane">
                @for (var i = 1; i <= 12; i++)
                {
                    <div class="scroll-demo-row">Row @i</div>
                }
            </div>
            <BitFooter Fixed Reveal Elevated
                       RevealOffset="100"
                       ScrollTarget="#footer-reveal-pane"
                       Color="BitColor.Tertiary"
                       Alignment="BitAlignment.Center">
                I stay until the pane scrolls past 100px
            </BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Elevate on scroll" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
        <div>
            <b>ElevateOnScroll</b> shadows a Fixed or Sticky footer only while content is left underneath it, and fades the
            shadow out at the end of the scroll. <b>OnOverlapChanged</b> and <b>IsOverlapping</b> report the state;
            <b>Elevated</b> takes precedence.
        </div>
        <br />
        <div>Scroll to the end of the box: <b>@(isFooterOverlapping ? "content below" : "at the end")</b></div>
        <br />
        <div class="scroll-demo">
            @for (var i = 1; i <= 12; i++)
            {
                <div class="scroll-demo-row">Row @i</div>
            }
            <BitFooter Sticky ElevateOnScroll
                       Color="BitColor.PrimaryBackground"
                       OnOverlapChanged="v => isFooterOverlapping = v">
                I lose my shadow at the end
            </BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Hidden" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
        <div>
            <b>Hidden</b> slides the footer away on demand (a contextual action bar, for example). Unlike <b>Visibility</b>
            it animates and keeps its room, and a hidden footer is <b>inert</b>: nothing in it can be clicked or focused.
        </div>
        <br />
        <div class="fixed-demo">
            <div class="scroll-demo-row">
                <BitToggleButton @bind-IsChecked="isSelectionMode" OnText="Leave selection mode" OffText="Enter selection mode" />
            </div>
            <BitFooter Fixed Elevated
                       Gap="0.5rem"
                       Color="BitColor.Primary"
                       Hidden="@(isSelectionMode is false)"
                       Alignment="BitAlignment.SpaceBetween"
                       AriaLabel="Selection actions">
                <span>2 items selected</span>
                <BitButton Color="BitColor.Error" Size="BitSize.Small">Delete</BitButton>
            </BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Translucent" RazorCode="@example10RazorCode" Id="example10">
        <div><b>Translucent</b> softens the background and blurs what scrolls behind it (Fill variant only).</div>
        <br />
        <div class="fixed-demo translucent-demo">
            @for (var i = 1; i <= 6; i++)
            {
                <div class="scroll-demo-row">Content behind the footer - row @i</div>
            }
            <BitFooter Fixed Translucent Bordered Color="BitColor.PrimaryBackground">I'm a translucent Footer</BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Accessibility" RazorCode="@example11RazorCode" Id="example11">
        <div>
            A <b>footer</b> element outside article, aside, main, nav and section is the page's <b>contentinfo</b> landmark.
            Give any additional footer an <b>AriaLabel</b> (no need to say "footer") so the landmarks can be told apart.
        </div>
        <br />
        <div class="container">
            <BitFooter AriaLabel="Editor actions" Alignment="BitAlignment.End" Gap="0.5rem" Bordered>
                <BitButton Variant="BitVariant.Text">Discard</BitButton>
                <BitButton>Save</BitButton>
            </BitFooter>
        </div>
        <br /><br />
        <div>
            A pinned footer can hide the control the focus just moved to (WCAG 2.4.11). <b>ScrollPadding</b> reserves the
            footer's height at the bottom of the scrolling area so the browser stops short of it. Tab through both boxes:
        </div>
        <br />
        <div class="padding-demo">
            <div>
                <div>Without ScrollPadding</div>
                <div class="scroll-demo">
                    @for (var i = 1; i <= 8; i++)
                    {
                        <div class="scroll-demo-row"><BitButton Variant="BitVariant.Text" Size="BitSize.Small">Action @i</BitButton></div>
                    }
                    <BitFooter Sticky Elevated Height="56" Color="BitColor.SecondaryBackground">Covers the next action</BitFooter>
                </div>
            </div>
            <div>
                <div>With ScrollPadding</div>
                <div class="scroll-demo">
                    @for (var i = 1; i <= 8; i++)
                    {
                        <div class="scroll-demo-row"><BitButton Variant="BitVariant.Text" Size="BitSize.Small">Action @i</BitButton></div>
                    }
                    <BitFooter Sticky Elevated ScrollPadding Height="56" Color="BitColor.SecondaryBackground">Keeps the next action visible</BitFooter>
                </div>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Usage" RazorCode="@example12RazorCode" Id="example12">
        <div>A complete site footer: credit and legal links split across a centered column, wrapping on narrow screens.</div>
        <br />
        <div class="container">
            <BitFooter Bordered Wrap
                       Gap="0.5rem 1.5rem"
                       MaxWidth="60rem"
                       Color="BitColor.SecondaryBackground"
                       Alignment="BitAlignment.SpaceBetween">
                <span>© 2026 bit platform. Made with <span role="img" aria-label="love">♥</span></span>
                <nav aria-label="Legal" class="footer-links">
                    <BitLink Href="https://bitplatform.dev">Terms</BitLink>
                    <BitLink Href="https://bitplatform.dev">Privacy</BitLink>
                    <BitLink Href="https://github.com/bitfoundation/bitplatform" Target="_blank">GitHub</BitLink>
                </nav>
            </BitFooter>
        </div>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
        <div>
            <b>BitParams</b> hands a <b>BitFooterParams</b> to every footer under it. The values are defaults, not overrides:
            a parameter a footer sets itself wins.
        </div>
        <br />
        <BitParams Parameters="@footerParams">
            <div class="container">
                <BitFooter>Takes the color, variant and border from the cascade</BitFooter>
            </div>
            <br />
            <div class="container">
                <BitFooter Color="BitColor.Error">Its own color, the cascaded rest</BitFooter>
            </div>
        </BitParams>
        <br />
        <div class="container">
            <BitFooter>Outside the cascade, back to the defaults</BitFooter>
        </div>
    </DemoExample>

