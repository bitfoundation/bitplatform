@page "/components/header"

<PageOutlet Url="components/header"
            Title="Header"
            Description="The BitHeader component renders the bar at the top of a site or an application, with theme colors, variants, sizes, alignment, wrapping, a second row, pinned positioning, scroll driven reveal and elevation, a skip link and public CSS variables." />

<DemoPage Name="Header"
          Description="BitHeader is the bar at the top of a site or an application (an app bar): a semantic header element - the banner landmark - holding a brand, navigation and actions in one line, with an optional second row for tabs. It can be pinned to the top, hide on scroll down, elevate once scrolled, slide away on demand, and carries a skip link and scroll padding for keyboard users."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          CssVariables="componentCssVariables"
          GitHubUrl="Layouts/Header/BitHeader.razor"
          GitHubDemoUrl="Layouts/Header/BitHeaderDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>As tall as its content plus the paddings of its size; <b>Height</b> fixes it in pixels.</div>
        <br />
        <div class="container">
            <BitHeader>I'm a Header</BitHeader>
        </div>
        <br />
        <div class="container">
            <BitHeader Height="80">I'm a Header with a fixed 80px height</BitHeader>
        </div>
        <br />
        <div class="container">
            <BitHeader IsEnabled="false">I'm a disabled Header</BitHeader>
        </div>
    </DemoExample>

    <DemoExample Title="Variant" RazorCode="@example2RazorCode" Id="example2">
        <div><b>Fill</b> (default) paints the color as the background, <b>Outline</b> as a border, <b>Text</b> as the text only.</div>
        <br />
        <div class="container">
            <BitHeader Variant="BitVariant.Fill" Color="BitColor.Info">Fill</BitHeader>
        </div>
        <br />
        <div class="container">
            <BitHeader Variant="BitVariant.Outline" Color="BitColor.Info">Outline</BitHeader>
        </div>
        <br />
        <div class="container">
            <BitHeader Variant="BitVariant.Text" Color="BitColor.Info">Text</BitHeader>
        </div>
    </DemoExample>

    <DemoExample Title="Border & elevation" RazorCode="@example3RazorCode" Id="example3">
        <div><b>Bordered</b> draws a bottom divider, <b>Elevated</b> casts a shadow - both separate the header from the content below it.</div>
        <br />
        <div class="container">
            <BitHeader Bordered>Bordered</BitHeader>
        </div>
        <br />
        <br />
        <div class="container">
            <BitHeader Elevated>Elevated</BitHeader>
        </div>
        <br />
        <br />
        <div class="container">
            <BitHeader Bordered Elevated Color="BitColor.Tertiary" Variant="BitVariant.Outline">Bordered & Elevated</BitHeader>
        </div>
    </DemoExample>

    <DemoExample Title="Alignment" RazorCode="@example4RazorCode" Id="example4">
        <div>
            <b>Alignment</b> distributes the content along the line (SpaceBetween is the classic brand-left, actions-right bar).
            <b>VerticalAlign</b> places it in the height of the header (centered by default).
        </div>
        <br />
        <div class="container">
            <BitHeader Alignment="BitAlignment.Start" Bordered>
                <BitTag Text="Start" />
                <BitTag Text="of" />
                <BitTag Text="the line" />
            </BitHeader>
        </div>
        <br />
        <div class="container">
            <BitHeader Alignment="BitAlignment.Center" Bordered>
                <BitTag Text="Center" />
                <BitTag Text="of" />
                <BitTag Text="the line" />
            </BitHeader>
        </div>
        <br />
        <div class="container">
            <BitHeader Alignment="BitAlignment.End" Bordered>
                <BitTag Text="End" />
                <BitTag Text="of" />
                <BitTag Text="the line" />
            </BitHeader>
        </div>
        <br />
        <div class="container">
            <BitHeader Alignment="BitAlignment.SpaceBetween" Bordered>
                <BitTag Text="Space" />
                <BitTag Text="between" />
                <BitTag Text="the items" />
            </BitHeader>
        </div>
        <br />
        <div class="container">
            <BitHeader Height="72" Bordered VerticalAlign="BitAlignment.Start">
                <BitTag Text="VerticalAlign: Start" />
            </BitHeader>
        </div>
        <br />
        <div class="container">
            <BitHeader Height="72" Bordered VerticalAlign="BitAlignment.End">
                <BitTag Text="VerticalAlign: End" />
            </BitHeader>
        </div>
    </DemoExample>

    <DemoExample Title="Layout" RazorCode="@example5RazorCode" Id="example5">
        <div>
            <b>Gap</b> spaces the children (any CSS length), <b>Wrap</b> lets them break onto more lines on a narrow screen,
            <b>NoGutter</b> removes the paddings, and <b>MaxWidth</b> caps and centers the content while the surface stays full width.
        </div>
        <br />
        <div>Gap:</div>
        <div class="container">
            <BitHeader Bordered Gap="0.5rem">
                <BitTag Text="A" />
                <BitTag Text="0.5rem" />
                <BitTag Text="gap" />
            </BitHeader>
        </div>
        <br />
        <div>Wrap:</div>
        <div class="container wrap-demo">
            <BitHeader Bordered Wrap Gap="0.25rem 0.5rem">
                @for (var i = 1; i <= 8; i++)
                {
                    <BitTag Text="@($"Wrapped {i}")" />
                }
            </BitHeader>
        </div>
        <br />
        <div>NoGutter:</div>
        <div class="container">
            <BitHeader Bordered NoGutter>
                <BitProgress Percent="60" />
            </BitHeader>
        </div>
        <br />
        <div>MaxWidth:</div>
        <div class="container">
            <BitHeader Bordered MaxWidth="24rem" Color="BitColor.SecondaryBackground" Alignment="BitAlignment.SpaceBetween">
                <BitTag Text="Capped at 24rem" />
                <BitTag Text="And centered" />
            </BitHeader>
        </div>
    </DemoExample>

    <DemoExample Title="Extension" RazorCode="@example6RazorCode" Id="example6">
        <div>
            <b>ExtensionContent</b> adds a second row under the main one - tabs, a search box, a breadcrumb - sharing the
            surface and the scroll behaviors of the header, and lining up with the main row's gutter and <b>MaxWidth</b>.
        </div>
        <br />
        <div class="container">
            <BitHeader Bordered Gap="0.5rem" MaxWidth="40rem">
                <ChildContent>
                    <BitText Typography="BitTypography.Subtitle1">Project Atlas</BitText>
                    <BitSpacer />
                    <BitButton Size="BitSize.Small">Share</BitButton>
                </ChildContent>
                <ExtensionContent>
                    <BitPivot HeaderOnly AriaLabel="Project sections">
                        <BitPivotItem HeaderText="Overview" />
                        <BitPivotItem HeaderText="Issues" />
                        <BitPivotItem HeaderText="Pull requests" />
                        <BitPivotItem HeaderText="Settings" />
                    </BitPivot>
                </ExtensionContent>
            </BitHeader>
        </div>
    </DemoExample>

    <DemoExample Title="Position" RazorCode="@example7RazorCode" Id="example7">
        <div>
            <b>Sticky</b> stays in the flow and pins once scrolled to. <b>Fixed</b> leaves the flow and overlaps the top of the page.
            <b>Absolute</b> overlaps the top of its nearest positioned ancestor (a card, a panel). Fixed beats Absolute, which beats Sticky.
            Fixed and Sticky add the device's top safe area inset, on top of any <b>Height</b>.
        </div>
        <br />
        <div>Sticky (scroll inside the box):</div>
        <br />
        <div class="scroll-demo">
            <BitHeader Sticky Bordered Color="BitColor.SecondaryBackground">I'm a sticky Header</BitHeader>
            @for (var i = 1; i <= 12; i++)
            {
                <div class="scroll-demo-row">Row @i</div>
            }
        </div>
        <br />
        <br />
        <div>Fixed (scoped to the box below for the sake of the demo):</div>
        <br />
        <div class="fixed-demo">
            <BitHeader Fixed Elevated Color="BitColor.Primary">I'm a fixed Header</BitHeader>
            <div class="scroll-demo-row scroll-demo-row--offset">The fixed header covers the top of its page.</div>
        </div>
        <br />
        <br />
        <div>Absolute:</div>
        <br />
        <div class="absolute-demo">
            <BitHeader Absolute Bordered Color="BitColor.TertiaryBackground">I'm an absolute Header</BitHeader>
            <div class="scroll-demo-row scroll-demo-row--offset">The absolute header covers the top of its container.</div>
        </div>
    </DemoExample>

    <DemoExample Title="Reveal" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
        <div>
            <b>Reveal</b> hides a Fixed or Sticky header while scrolling down and brings it back on scroll up or when anything inside it
            takes the focus - and keeps it while it holds the keyboard focus. <b>RevealOffset</b> keeps it until the scroll has passed that many pixels. <b>OnRevealChanged</b> and
            <b>IsRevealed</b> report the state.
        </div>
        <br />
        <div>Scroll inside the box: <b>@(isHeaderRevealed ? "revealed" : "hidden")</b></div>
        <br />
        <div class="scroll-demo">
            <BitHeader Sticky Reveal Elevated
                       Color="BitColor.Primary"
                       Alignment="BitAlignment.Center"
                       OnRevealChanged="v => isHeaderRevealed = v">
                I hide myself while you scroll down
            </BitHeader>
            @for (var i = 1; i <= 12; i++)
            {
                <div class="scroll-demo-row">Row @i</div>
            }
        </div>
        <br />
        <br />
        <div class="scroll-demo">
            <BitHeader Sticky Reveal Elevated
                       RevealOffset="100"
                       Color="BitColor.Tertiary"
                       Alignment="BitAlignment.Center">
                I stay until you scroll past 100px
            </BitHeader>
            @for (var i = 1; i <= 12; i++)
            {
                <div class="scroll-demo-row">Row @i</div>
            }
        </div>
    </DemoExample>

    <DemoExample Title="Elevate on scroll" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
        <div>
            <b>ElevateOnScroll</b> keeps a pinned header flat at the top and fades its shadow in once content scrolls under it
            (after <b>ElevateOffset</b> pixels). <b>OnScrolledChanged</b> and <b>IsScrolled</b> expose the same state - here to
            shrink the header and swap its title.
        </div>
        <br />
        <div class="scroll-demo">
            <BitHeader Sticky ElevateOnScroll Color="BitColor.PrimaryBackground">I gain my shadow once you scroll</BitHeader>
            @for (var i = 1; i <= 12; i++)
            {
                <div class="scroll-demo-row">Row @i</div>
            }
        </div>
        <br />
        <br />
        <div class="scroll-demo">
            <BitHeader Sticky ElevateOnScroll
                       ElevateOffset="40"
                       Color="BitColor.PrimaryBackground"
                       Height="@(isHeaderScrolled ? 48 : 80)"
                       OnScrolledChanged="v => isHeaderScrolled = v">
                <BitText Typography="@(isHeaderScrolled ? BitTypography.Subtitle2 : BitTypography.H5)">
                    @(isHeaderScrolled ? "My App" : "My Awesome Application")
                </BitText>
            </BitHeader>
            @for (var i = 1; i <= 12; i++)
            {
                <div class="scroll-demo-row">Row @i</div>
            }
        </div>
    </DemoExample>

    <DemoExample Title="Scroll target" RazorCode="@example10RazorCode" Id="example10">
        <div>
            The header finds its scrolling area by walking up from itself. <b>ScrollTarget</b> names it with a CSS selector instead,
            for an app shell whose bar and content pane are siblings. A selector that matches nothing falls back to the walk.
        </div>
        <br />
        <div class="split-demo">
            <BitHeader Sticky ElevateOnScroll Bordered
                       ScrollTarget="#header-scroll-pane"
                       Color="BitColor.PrimaryBackground">
                I react to the pane below me
            </BitHeader>
            <div id="header-scroll-pane" class="split-demo-pane">
                @for (var i = 1; i <= 12; i++)
                {
                    <div class="scroll-demo-row">Row @i</div>
                }
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Hidden" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
        <div>
            <b>Hidden</b> slides the header away on demand (an immersive or reading mode). Unlike <b>Visibility</b> it animates and
            keeps its room, and the hidden header is <b>inert</b>, so none of its controls can be reached.
        </div>
        <br />
        <div class="fixed-demo">
            <BitHeader Fixed Elevated
                       Gap="0.5rem"
                       Color="BitColor.Primary"
                       Hidden="@isImmersiveMode"
                       Alignment="BitAlignment.SpaceBetween"
                       AriaLabel="Reader actions">
                <span>Chapter 3</span>
                <BitButton Size="BitSize.Small" Variant="BitVariant.Text" Color="BitColor.PrimaryBackground">Contents</BitButton>
            </BitHeader>
            <div class="scroll-demo-row scroll-demo-row--offset">
                <BitToggleButton @bind-IsChecked="isImmersiveMode" OnText="Leave immersive mode" OffText="Enter immersive mode" />
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Translucent" RazorCode="@example12RazorCode" Id="example12">
        <div><b>Translucent</b> softens the Fill background and blurs what scrolls behind it - the frosted glass of a native mobile bar.</div>
        <br />
        <div class="translucent-demo">
            <BitHeader Sticky Translucent Bordered Color="BitColor.PrimaryBackground">I'm a translucent Header</BitHeader>
            @for (var i = 1; i <= 10; i++)
            {
                <div class="scroll-demo-row">Content behind the header - row @i</div>
            }
        </div>
    </DemoExample>

    <DemoExample Title="Accessibility" RazorCode="@example13RazorCode" Id="example13">
        <div>
            The header is the page's <b>banner</b> landmark (when not nested in main, article, aside, nav or section).
            A second one - a toolbar, a pane's bar - needs an <b>AriaLabel</b> to tell them apart.
        </div>
        <br />
        <div class="container">
            <BitHeader AriaLabel="Editor actions" Alignment="BitAlignment.End" Gap="0.5rem" Bordered>
                <BitButton Variant="BitVariant.Text">Discard</BitButton>
                <BitButton>Save</BitButton>
            </BitHeader>
        </div>
        <br /><br />
        <div>
            <b>SkipLinkHref</b> renders a skip link (WCAG 2.4.1) as the first focusable element, visible only on focus;
            <b>SkipLinkText</b> rewords it. Give the target <b>tabindex="-1"</b> so the focus really moves there.
            Click the header and press Tab:
        </div>
        <br />
        <div class="container">
            <BitHeader SkipLinkHref="#header-skip-target" Gap="0.5rem" Bordered>
                <BitButton Variant="BitVariant.Text" IconName="@BitIconName.GlobalNavButton" Title="Open navigation" />
                <BitText Typography="BitTypography.Subtitle2">My Awesome App</BitText>
            </BitHeader>
        </div>
        <div id="header-skip-target" tabindex="-1" class="skip-target">The skip link lands here.</div>
        <br /><br />
        <div>
            <b>ScrollPadding</b> reserves the height of a pinned header at the top of its scrolling area, so a focused control or an
            anchor target never ends up underneath it (WCAG 2.4.11). Click the first button in each box and hold Tab:
        </div>
        <br />
        <div class="scroll-demo">
            <BitHeader Sticky Elevated Color="BitColor.Error" AriaLabel="Without scroll padding">
                Without ScrollPadding - the focus lands under me
            </BitHeader>
            @for (var i = 1; i <= 12; i++)
            {
                <div class="scroll-demo-row"><BitButton Variant="BitVariant.Text">Button @i</BitButton></div>
            }
        </div>
        <br />
        <div class="scroll-demo">
            <BitHeader Sticky Elevated ScrollPadding Color="BitColor.Success" AriaLabel="With scroll padding">
                With ScrollPadding - the focus stops below me
            </BitHeader>
            @for (var i = 1; i <= 12; i++)
            {
                <div class="scroll-demo-row"><BitButton Variant="BitVariant.Text">Button @i</BitButton></div>
            }
        </div>
    </DemoExample>

    <DemoExample Title="Usage" RazorCode="@example14RazorCode" Id="example14">
        <div>A complete application header: a navigation toggle and a brand, a BitSpacer, then the account actions.</div>
        <br />
        <div class="container">
            <BitHeader Gap="1rem">
                <BitButton Variant="BitVariant.Text" IconName="@BitIconName.GlobalNavButton" Title="Open Navigation" />
                <BitText Typography="BitTypography.Caption1">My Awesome App</BitText>
                <BitSpacer />
                <BitButton Variant="BitVariant.Text" IconName="@BitIconName.Contact" Title="Sign in" />
                <BitMenuButton TItem="BitMenuButtonOption"
                               ChevronDownIconName="@BitIconName.More"
                               Variant="BitVariant.Text"
                               title="See more"
                               Styles="@(new() { OperatorButton = "padding: 0.5rem;" })">
                    <BitMenuButtonOption Text="Settings" IconName="@BitIconName.Settings" />
                    <BitMenuButtonOption Text="About" IconName="@BitIconName.Info" />
                    <BitMenuButtonOption Text="Feedback" IconName="@BitIconName.Feedback" />
                </BitMenuButton>
            </BitHeader>
        </div>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
        <div>
            <b>BitParams</b> hands a <b>BitHeaderParams</b> to every header under it as defaults: a header keeps whatever it sets
            itself and only takes what it left unset.
        </div>
        <br />
        <BitParams Parameters="@headerParams">
            <div class="container">
                <BitHeader>Takes the color, the variant, the size and the border from the cascade</BitHeader>
            </div>
            <br />
            <div class="container">
                <BitHeader Color="BitColor.Tertiary">Its own Color, the cascaded rest</BitHeader>
            </div>
        </BitParams>
        <br />
        <div class="container">
            <BitHeader>Outside the cascade, and back to the defaults</BitHeader>
        </div>
    </DemoExample>

