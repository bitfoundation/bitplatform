@page "/components/numberfield"
@page "/components/numerictextfield"
@page "/components/numeric-text-field"
@page "/components/spinbutton"
@page "/components/spin-button"

<PageOutlet Url="components/numberfield"
            Title="NumberField"
            Description="A NumberField lets you enter, step and format numeric values of any .NET number type, with min/max bounds, step snapping, rounding precision, stepper buttons in several layouts, the full ARIA spinbutton keyboard set, mouse wheel interaction, non-Latin digit input, theming and form validation." />

<DemoPage Name="NumberField"
          SecondaryNames="@(["NumberInput"])"
          Description="A NumberField (also known as a number input or spin button) is a text field dedicated to numbers. It binds to any .NET numeric type - byte, sbyte, short, ushort, int, uint, long, ulong, float, double and decimal, plus every nullable variant - and never lets the value escape the range of that type. On top of plain typing it offers what a professional numeric editor is expected to have: Min/Max bounds that either clamp the value or let it through for a validator to report, a custom Step with optional snapping to its grid, rounding precision, .NET number formatting - in the culture of your choosing - that never gets in the way of editing, increment/decrement buttons in three layouts with press-and-hold continuous spinning, a clear button, adornments and hints, the complete ARIA spinbutton keyboard set, Shift+mouse-wheel spinning, non-Latin digit input, and first-class EditForm integration."
          Parameters="componentParameters"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          PublicMembers="componentPublicMembers"
          CssVariables="componentCssVariables"
          GitHubUrl="Inputs/NumberField/BitNumberField.razor"
          GitHubDemoUrl="Inputs/NumberField/BitNumberFieldDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>
            <b>TValue</b> picks the numeric type of the field, and is inferred from a bound value. A nullable one lets the
            field be genuinely empty, which is what you want whenever "no value yet" differs from zero.
            <b>Label</b> names the field and is read out with it, <b>Placeholder</b> shows until something is entered, and
            <b>Required</b> marks it as needing a value.
            The value is committed on blur or Enter and parsed with the invariant culture, tolerating the whitespace between
            digit groups that a number pasted from a spreadsheet carries; text that is not a number is reported through the
            validation channel rather than silently dropped.
            Focusing selects the whole text for a quick overwrite - <b>NoSelectOnFocus</b> turns that off.
            The input is an ARIA <b>spinbutton</b>: Up/Down step by the <b>Step</b>, PageUp/PageDown by a larger jump,
            Home/End go to the <b>Min</b>/<b>Max</b>.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Basic" TValue="int?" />
            <br />
            <BitNumberField Label="Disabled & DefaultValue" DefaultValue="1363" IsEnabled="false" />
            <br />
            <BitNumberField Label="Placeholder" TValue="int?" Placeholder="Enter a number..." />
            <br />
            <BitNumberField Label="Required" TValue="int?" Required />
            <br />
            <BitNumberField Label="NoSelectOnFocus" NoSelectOnFocus DefaultValue="1363" TValue="int?" />
        </div>
    </DemoExample>

    <DemoExample Title="Binding" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
        <div>
            The value binds one-way (the field reflects the source and its edits are discarded on the next render) or two-way
            with <b>@@bind-Value</b>. There is also an uncontrolled mode: give the field a <b>DefaultValue</b> and listen to
            <b>OnChange</b>, and it keeps the value itself instead of requiring a backing field.
        </div>
        <br />
        <div class="example-box">
            <div>
                <BitNumberField Label="One-way" Value="oneWayValue" />
                <BitRating @bind-Value="oneWayValue" />
            </div>
            <br />
            <div>
                <BitNumberField Label="Two-way" @bind-Value="twoWayValue" />
                <BitRating @bind-Value="twoWayValue" />
            </div>
            <br />
            <div>
                <BitNumberField Label="Uncontrolled (DefaultValue & OnChange)" TValue="int?"
                                DefaultValue="7"
                                OnChange="(int? v) => uncontrolledValue = v" />
                <div>last OnChange value: [@uncontrolledValue]</div>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Spin buttons" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
        <div>
            <b>Mode</b> decides how the increment/decrement buttons render: <b>Compact</b> stacks them at the end of the
            input, <b>Inline</b> puts them side by side, and <b>Spread</b> puts one on each side with the value centered -
            the classic quantity picker. Left unset, no buttons render and the value is changed by typing, by the arrow keys
            or by the wheel. Holding a button down spins continuously, after <b>ContinuousSpinDelay</b> and then every
            <b>ContinuousSpinInterval</b> milliseconds; clicking one keeps the caret in the input, so the keyboard can take
            over from where the mouse left off. <b>IncrementIconName</b>/<b>DecrementIconName</b> and
            <b>IncrementTitle</b>/<b>DecrementTitle</b> decorate them.
            <b>HideInput</b> drops the text box altogether and leaves a stepper (falling back to <b>Compact</b> when no mode is
            given, since the buttons are then all there is): the buttons become the tab stops, respond to Enter and Space,
            and the value is published through a hidden live region for screen readers while a hidden input keeps the field
            posting with a plain HTML form.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Compact" TValue="int" Mode="BitSpinButtonMode.Compact" />
            <br />
            <BitNumberField Label="Inline" TValue="int" Mode="BitSpinButtonMode.Inline" />
            <br />
            <BitNumberField Label="Spread" TValue="int" Mode="BitSpinButtonMode.Spread" />
            <br />
            <BitNumberField Label="Custom icons & titles" TValue="int"
                            Mode="BitSpinButtonMode.Compact"
                            IncrementTitle="Like it more"
                            DecrementTitle="Like it less"
                            IncrementIconName="@BitIconName.LikeSolid"
                            DecrementIconName="@BitIconName.DislikeSolid" />
            <br />
            <BitNumberField Label="Fast continuous spin (hold a button)" TValue="int"
                            Mode="BitSpinButtonMode.Spread"
                            ContinuousSpinDelay="200"
                            ContinuousSpinInterval="25"
                            IncrementIconName="@BitIconName.CalculatorAddition"
                            DecrementIconName="@BitIconName.CalculatorSubtract" />
            <br />
            <BitNumberField HideInput
                            @bind-Value="hideInputValue"
                            Mode="BitSpinButtonMode.Inline"
                            Label="@($"HideInput: {hideInputValue}")" />
        </div>
    </DemoExample>

    <DemoExample Title="Min & Max" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
        <div>
            <b>Min</b> and <b>Max</b> bound the value: anything entered or spun outside the range is clamped to the nearest
            bound. Unset, the natural range of the underlying type applies, so spinning can never overflow it. An explicit
            bound also makes <b>Home</b>/<b>End</b> jump straight to it, is announced through aria-valuemin/aria-valuemax, and
            turns the button that would step past it inert (marked <b>aria-disabled</b> rather than disabled, so it keeps its
            place in the tab order and any focus it holds).
            <b>NoClamp</b> lets a typed out-of-range number through so a validator can report it, exactly as a plain text input
            would, while stepping and Home/End still stay inside the range.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Min = 0" Min="0" Mode="BitSpinButtonMode.Compact" @bind-Value="minValue" />
            <div>value: [@minValue]</div>
            <br />
            <BitNumberField Label="Min & Max (-10, 10)" Min="-10" Max="10" Mode="BitSpinButtonMode.Compact" @bind-Value="minMaxValue" />
            <div>value: [@minMaxValue]</div>
            <br />
            <BitNumberField Label="Clamping (default): typing 500 commits 100" Min="0" Max="100" Mode="BitSpinButtonMode.Compact" @bind-Value="clampValue" />
            <div>value: [@clampValue]</div>
            <br />
            <BitNumberField Label="NoClamp: typing 500 commits 500" NoClamp Min="0" Max="100" Mode="BitSpinButtonMode.Compact" @bind-Value="noClampValue" />
            <div>value: [@noClampValue]</div>
        </div>
    </DemoExample>

    <DemoExample Title="Step, precision & snapping" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5">
        <div>
            <b>Step</b> is the amount a spin adds or removes, whether it comes from a button, an arrow key or the wheel, and a
            fractional one also implies the rounding precision of typed values. <b>PageStep</b> is what PageUp/PageDown jump by
            (10 times the Step when unset). Stepping always applies to the number currently visible, so typing and immediately
            pressing an arrow key steps from what was just typed.
            <b>Precision</b> sets the rounding explicitly; a negative value rounds to a power of ten, so <b>-2</b> rounds to the
            nearest hundred.
            <b>SnapToStep</b> puts typed values on the same grid the stepping produces, anchored at the <b>Min</b> when there is
            one. A Max that is not itself on the grid is then unreachable - with Step=3 and Max=10 the field stops at 9.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Step = 2" Step="2" Mode="BitSpinButtonMode.Compact" @bind-Value="stepValue" />
            <div>value: [@stepValue]</div>
            <br />
            <BitNumberField Label="Fractional step (0.1)" Step="0.1" Mode="BitSpinButtonMode.Compact" @bind-Value="fractionalStepValue" />
            <div>value: [@fractionalStepValue]</div>
            <br />
            <BitNumberField Label="PageStep = 20 (press PageUp/PageDown)" PageStep="20" Mode="BitSpinButtonMode.Compact" @bind-Value="pageStepValue" />
            <div>value: [@pageStepValue]</div>
            <br />
            <BitNumberField Label="Precision = -2 (rounds to the nearest hundred)" Precision="-2" TValue="double" Mode="BitSpinButtonMode.Compact" @bind-Value="negativePrecisionInputValue" />
            <div>value: [@negativePrecisionInputValue]</div>
            <br />
            <BitNumberField Label="SnapToStep, Min = 2 & Step = 3 (typing 7 commits 8)" SnapToStep Min="2" Step="3" Mode="BitSpinButtonMode.Compact" @bind-Value="snapAnchoredValue" />
            <div>value: [@snapAnchoredValue]</div>
            <br />
            <BitNumberField Label="SnapToStep & fractional step (typing 0.3 commits 0.25)" SnapToStep Step="0.25" Mode="BitSpinButtonMode.Compact" @bind-Value="snapFractionValue" />
            <div>value: [@snapFractionValue]</div>
        </div>
    </DemoExample>

    <DemoExample Title="Numeric types" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
        <div>
            <b>TValue</b> accepts every .NET numeric type - byte, sbyte, short, ushort, int, uint, long, ulong, float, double
            and decimal - plus their nullable variants. Spinning clamps at the bounds of the type, so a byte never overflows
            past 255, and the arithmetic runs in a type wide enough that no intermediate step can overflow either: a
            <b>ulong</b> keeps working past long.MaxValue and a <b>decimal</b> keeps its full precision.
            The type also picks the mobile keyboard - a decimal keypad for the fractional types, a numeric one for the rest.
            Neither offers a minus sign on every platform, so a field that must accept negative values on touch should ask for
            the full keyboard with <b>InputMode="BitInputMode.Text"</b>.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="byte" Mode="BitSpinButtonMode.Compact" @bind-Value="byteValue" />
            <div>value: [@byteValue]</div>
            <br />
            <BitNumberField Label="long" Mode="BitSpinButtonMode.Compact" @bind-Value="longValue" />
            <div>value: [@longValue]</div>
            <br />
            <BitNumberField Label="decimal" Mode="BitSpinButtonMode.Compact" @bind-Value="decimalValue" Step="0.01" />
            <div>value: [@decimalValue]</div>
            <br />
            <BitNumberField Label="Negative values on touch (InputMode.Text)" Mode="BitSpinButtonMode.Compact"
                            InputMode="BitInputMode.Text" Min="-100" Max="100" @bind-Value="signedValue" />
            <div>value: [@signedValue]</div>
        </div>
    </DemoExample>

    <DemoExample Title="Label position & template" RazorCode="@example7RazorCode" Id="example7">
        <div>
            <b>LabelPosition</b> puts the label on any side of the input, and <b>LabelTemplate</b> replaces it with markup
            of your own - which then has to carry the association with the input itself.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Top (default)" TValue="int" />
            <br />
            <BitNumberField Label="Start" LabelPosition="BitLabelPosition.Start" TValue="int" />
            <br />
            <BitNumberField Label="End" LabelPosition="BitLabelPosition.End" TValue="int" />
            <br />
            <BitNumberField Label="Bottom" LabelPosition="BitLabelPosition.Bottom" TValue="int" />
            <br />
            <BitNumberField TValue="int">
                <LabelTemplate>
                    <div style="display:flex;align-items:center;gap:10px">
                        <BitLabel Style="color:green;">This is custom Label</BitLabel>
                        <BitIcon IconName="@BitIconName.Filter" Style="font-size:18px;" />
                    </div>
                </LabelTemplate>
            </BitNumberField>
        </div>
    </DemoExample>

    <DemoExample Title="Description, error & loading" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
        <div>
            <b>Description</b> renders a hint under the field - the accepted range, the unit, why the value matters - which is
            where a user looks before typing rather than after being told they got it wrong. The input references it through
            <b>aria-describedby</b>, so it reaches everybody and not only the people who can see it.
            <b>ErrorMessage</b> is its counterpart for a rejection: it paints the field, renders <b>aria-invalid</b>, and is
            announced through a polite live region the moment it appears - the way to report a server-side or business-rule
            failure without building an EditForm around the field. <b>Invalid</b> marks the field without a message, for a
            rejection explained elsewhere.
            <b>Loading</b> is the third thing a field says about itself: a busy indicator for work running against the value -
            a price being recalculated, a quantity being checked against stock. The field stays editable, the input reports
            <b>aria-busy</b>, and <b>LoadingAriaLabel</b> is what the live region announces.
            <b>DescriptionTemplate</b>, <b>ErrorMessageTemplate</b> and <b>LoadingTemplate</b> take markup instead, and
            <b>AriaDescription</b> adds an explanation for assistive technologies only.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Quantity" TValue="int" Min="1" Max="99" Mode="BitSpinButtonMode.Compact"
                            Description="Between 1 and 99 items per order." />
            <br />
            <BitNumberField Label="Seats" TValue="int" Mode="BitSpinButtonMode.Compact"
                            @bind-Value="seatsValue"
                            Description="We hold the room for 15 minutes."
                            ErrorMessage="@(seatsValue > 4 ? "Only 4 seats are left for this show." : null)" />
            <br />
            <BitNumberField Label="Invalid (no message of its own)" TValue="int" Invalid DefaultValue="42" />
            <br />
            <BitToggle @bind-Value="loadingValue" Text="Loading" />
            <BitNumberField Label="Price" TValue="double" Loading="loadingValue"
                            LoadingAriaLabel="Recalculating the price" DefaultValue="19.99" />
            <br />
            <BitNumberField Label="Discount" TValue="int" Min="0" Max="100" Mode="BitSpinButtonMode.Inline">
                <DescriptionTemplate>
                    <b style="color:darkorange">Anything above 50% needs a manager's approval.</b>
                </DescriptionTemplate>
            </BitNumberField>
            <br />
            <BitNumberField Label="Label on the side" TValue="int"
                            LabelPosition="BitLabelPosition.Start"
                            Description="The hint wraps onto a line of its own." />
        </div>
    </DemoExample>

    <DemoExample Title="Appearance" RazorCode="@example9RazorCode" Id="example9">
        <div>
            Three parameters adjust the frame without touching anything the field does.
            <b>Underlined</b> replaces the border with a single bottom rule (the focus indicator follows suit), which suits
            dense forms and inline editing. <b>NoBorder</b> removes it altogether, for a field inside a surface that already
            provides one. <b>FullWidth</b> stretches the field to fill its container, which it otherwise does not do.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Underlined" TValue="int" Underlined Mode="BitSpinButtonMode.Compact" />
            <br />
            <BitNumberField Label="Underlined & Required" TValue="int" Underlined Required />
            <br />
            <BitNumberField Label="NoBorder" TValue="int" NoBorder Mode="BitSpinButtonMode.Compact" />
            <br />
            <div style="display:flex">
                <BitNumberField Label="FullWidth (inside a flex container)" TValue="int" FullWidth Mode="BitSpinButtonMode.Compact" />
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Icon, prefix & suffix" RazorCode="@example10RazorCode" Id="example10">
        <div>
            <b>IconName</b> puts a glyph inside the field - decorative by default, given a name for screen readers by
            <b>IconAriaLabel</b>. <b>Prefix</b> and <b>Suffix</b> attach a unit or a currency symbol without it becoming part
            of what the user types: they are never parsed and never part of the bound value, and the input points
            aria-describedby at them so a screen reader still says what the number is counted in.
            <b>PrefixTemplate</b> and <b>SuffixTemplate</b> take arbitrary markup instead, in which case the container and its
            styling are yours to provide too.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField TValue="int" Label="Icon" IconName="@BitIconName.Lightbulb" />
            <br />
            <BitNumberField TValue="int" Label="Prefix & Suffix" Prefix="Distance:" Suffix="km" Mode="BitSpinButtonMode.Compact" />
            <br />
            <BitNumberField TValue="int" Label="Disabled" Prefix="Distance:" Suffix="km" IsEnabled="false" />
            <br />
            <BitNumberField TValue="double" Label="Price" Mode="BitSpinButtonMode.Compact" Step="0.5">
                <PrefixTemplate>
                    <BitIcon IconName="@BitIconName.Money" Style="padding-inline: 0.5rem;" />
                </PrefixTemplate>
                <SuffixTemplate>
                    <BitTag Color="BitColor.Info" Style="margin-inline-end: 0.25rem;">USD</BitTag>
                </SuffixTemplate>
            </BitNumberField>
        </div>
    </DemoExample>

    <DemoExample Title="Clear button" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
        <div>
            <b>ShowClearButton</b> renders an X inside the field whenever it is showing something, resetting the value to null
            in one click. It follows what is in the input rather than the bound value, so it also appears for text that failed
            to parse and has to be wiped, and it is never rendered on a read-only or empty field. It stays out of the tab
            order, keeping the input the single tab stop - <b>Escape</b> is its keyboard equivalent.
            <b>ClearButtonIconName</b> and <b>ClearButtonAriaLabel</b> localize it, <b>ClearButtonTemplate</b> replaces what
            it renders without touching how it behaves, and <b>OnClear</b> reports it.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Age" TValue="int?" ShowClearButton DefaultValue="28" />
            <br />
            <BitNumberField Label="Custom icon" TValue="int?" ShowClearButton ClearButtonIconName="@BitIconName.Delete" DefaultValue="28" />
            <br />
            <BitNumberField Label="ClearButtonTemplate" TValue="int?" ShowClearButton DefaultValue="28">
                <ClearButtonTemplate>
                    <b>&times;</b>
                </ClearButtonTemplate>
            </BitNumberField>
            <br />
            <BitNumberField Label="OnClear & Escape (press Escape to clear)" TValue="int?" ShowClearButton
                            DefaultValue="28" OnClear="() => clearedCounter++" />
            <div>cleared: @clearedCounter time(s)</div>
        </div>
    </DemoExample>

    <DemoExample Title="Number format & culture" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
        <div>
            <b>NumberFormat</b> formats the displayed value with the standard or custom .NET numeric format strings - <b>N0</b>
            for grouping, <b>C0</b> for currency, <b>000000</b> for zero padding. The formatting is display only: the bound
            value stays a plain number, and while the field is being edited the plain number is what you see, so there is never
            a currency symbol or a run of zeros to type around. Typing a formatted number works too - the separators and
            symbols are stripped before parsing, including the parentheses of accounting formats.
            Value-scaling formats such as percent <b>P</b> are not suitable, since the scaled text cannot be parsed back.
            <b>Culture</b> decides whose separators those are. Left unset, a format follows the culture of the current thread
            while the plain value stays invariant, which is what keeps a typed <b>1.5</b> meaning the same thing everywhere;
            setting it pins both, so the field reads and writes that culture's numbers no matter where it runs. The
            aria-value* attributes stay plain invariant numbers either way, and what is on screen is announced through
            aria-valuetext.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="N0" DefaultValue="1234567890d" NumberFormat="N0" />
            <br />
            <BitNumberField Label="C0" DefaultValue="150" NumberFormat="C0" />
            <br />
            <BitNumberField Label="C2 (try typing a negative amount)" DefaultValue="1234.5" NumberFormat="C2" />
            <br />
            <BitNumberField Label="000000" DefaultValue="1363" NumberFormat="000000" />
            <br />
            <BitNumberField Label="Culture=de-DE & NumberFormat=C2" DefaultValue="1234.5" NumberFormat="C2" Culture="germanCulture" />
            <br />
            <BitNumberField Label="Culture=de-DE (type 1.234,5)" TValue="double?" Culture="germanCulture" @bind-Value="germanValue" />
            <div>value: [@germanValue]</div>
        </div>
    </DemoExample>

    <DemoExample Title="Input behavior" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
        <div>
            <b>Immediate</b> commits on every keystroke instead of on blur or Enter, with <b>DebounceTime</b> waiting out a
            pause in the typing and <b>ThrottleTime</b> rate-limiting the commits. While typing, the text stays exactly as
            typed for as long as it still represents the committed value, so an in-progress <b>1.</b> survives long enough to
            be finished. Combining it with a <b>NumberFormat</b> is best avoided for fractional values.
            <b>ReadOnly</b> stops typing, the buttons, the keys and the wheel alike, while the value stays focusable and
            copyable; <b>IsInputReadOnly</b> blocks only the typing, leaving a stepper with a protected text box.
            The wheel spins the value only while <b>Shift</b> is held and the field is focused, so page scrolling is never
            captured and a merely hovered field is never rewritten - on either axis, since Shift turns the scroll horizontal
            on macOS; <b>InvertMouseWheel</b> flips the direction and <b>NoMouseWheel</b> turns it off.
            <b>EnterKeyHint</b> labels the enter key of a virtual keyboard ("done", "next", "go", ...), which a numeric soft
            keyboard otherwise leaves blank; spell-checking and autocorrect are off throughout, a number being no word.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Immediate" TValue="int?" @bind-Value="immediateValue" Immediate />
            <div>Value: [@immediateValue]</div>
            <br />
            <BitNumberField Label="Immediate & decimals (try typing 1.25)" TValue="double?" @bind-Value="immediateDecimalValue" Immediate />
            <div>Value: [@immediateDecimalValue]</div>
            <br />
            <BitNumberField Label="Immediate & DebounceTime (300ms)" TValue="int?" @bind-Value="debounceValue" Immediate DebounceTime="300" />
            <div>Value: [@debounceValue]</div>
            <br />
            <BitNumberField Label="ReadOnly" ReadOnly Mode="BitSpinButtonMode.Compact" @bind-Value="readOnlyValue" />
            <br />
            <BitNumberField Label="IsInputReadOnly" IsInputReadOnly Mode="BitSpinButtonMode.Compact" @bind-Value="inputReadOnlyValue" />
            <br />
            <BitToggle @bind-Value="invertMouseWheel" Text="Invert Mouse Wheel" />
            <br />
            <BitNumberField InvertMouseWheel="invertMouseWheel" Label="Click to focus, then Shift + Mouse Wheel" TValue="int" />
            <br />
            <BitNumberField NoMouseWheel Label="NoMouseWheel (the wheel never changes it)" TValue="int" Mode="BitSpinButtonMode.Compact" />
            <br />
            <BitNumberField Label="EnterKeyHint=done (visible on a touch keyboard)" TValue="int?" EnterKeyHint="done" />
        </div>
    </DemoExample>

    <DemoExample Title="NormalizeDigits" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
        <div>
            <b>NormalizeDigits</b> maps non-Latin decimal digits (Persian "۱۲۳", Arabic "١٢٣") and the Arabic decimal separator
            to their Latin equivalents before parsing, so the field accepts what the various Persian/Arabic keyboard layouts
            emit. The same normalization applies to <b>Min</b>, <b>Max</b> and <b>Step</b>, so <b>Min="۱۰"</b> works, and the
            typed digits stay visible as long as they represent the exact bound value.
            <b>DigitsNormalizer</b> takes over with a function of your own - the one below also strips spaces and thousand
            separators, Latin and Persian alike.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Without NormalizeDigits" @bind-Value="normalizeOffValue" Placeholder="۱۲۳" />
            <div>Value: @normalizeOffValue</div>
            <br />
            <BitNumberField Label="With NormalizeDigits (۱۲۳)" @bind-Value="normalizeOnValue" NormalizeDigits Placeholder="۱۲۳" />
            <div>Value: @normalizeOnValue</div>
            <br />
            <BitNumberField Label="Fractioned NormalizeDigits (۱۲٫۵)" @bind-Value="normalizeDecimalValue" NormalizeDigits Placeholder="۱۲٫۵" Precision="2" />
            <div>Value: @normalizeDecimalValue</div>
            <br />
            <BitNumberField Label="Custom DigitsNormalizer (۱٬۲۳۴)" @bind-Value="customNormalizerValue" DigitsNormalizer="CustomDigitsNormalizer" Placeholder="۱٬۲۳۴" />
            <div>Value: @customNormalizerValue</div>
        </div>
    </DemoExample>

    <DemoExample Title="Events" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
        <div>
            <b>OnIncrement</b> and <b>OnDecrement</b> fire for every spin - button, arrow key, PageUp/PageDown or wheel - and
            receive the new value, so a consumer never has to special-case the device the change came from. <b>OnChange</b>
            fires whenever the committed value changes.
            <b>OnMinReached</b>/<b>OnMaxReached</b> report the moment a step lands on an explicit bound, once per approach
            rather than on every further attempt, which is the hook for explaining why the value stopped moving.
            The raw input events are surfaced too: <b>OnKeyDown</b>/<b>OnKeyUp</b> report every key including the ones the
            field consumes itself, <b>OnEnter</b> is raised after the typed text is committed (so the value it sees is the one
            just entered), <b>OnEscape</b> before the field clears itself (so a surface the field sits on can take the key
            instead), <b>OnClick</b> reports clicks, and focus is covered by <b>OnFocus</b>, <b>OnFocusIn</b>,
            <b>OnFocusOut</b> and <b>OnBlur</b>.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="OnIncrement & OnDecrement" Mode="BitSpinButtonMode.Compact"
                            OnIncrement="(double v) => onIncrementCounter++"
                            OnDecrement="(double v) => onDecrementCounter++" />
            <div>OnIncrement Counter: @onIncrementCounter</div>
            <div>OnDecrement Counter: @onDecrementCounter</div>
            <br />
            <BitNumberField Label="OnChange" OnChange="(double v) => onChangeCounter++" />
            <div>OnChange Counter: @onChangeCounter</div>
            <br />
            <BitNumberField Label="OnMinReached & OnMaxReached (0 to 3)" TValue="int"
                            Min="0" Max="3" Mode="BitSpinButtonMode.Compact"
                            OnMinReached="HandleMinReached"
                            OnMaxReached="HandleMaxReached" />
            <div>[@boundMessage]</div>
            <br />
            <BitNumberField Label="OnEnter (type a number and press Enter)" TValue="int?"
                            @bind-Value="enterValue"
                            OnEnter="HandleEnter" />
            <div>[@enterMessage]</div>
            <br />
            <BitNumberField Label="OnEscape (press Escape)" TValue="int?" ShowClearButton DefaultValue="9"
                            OnEscape="() => escapeCounter++" />
            <div>Escape pressed @escapeCounter time(s)</div>
            <br />
            <BitNumberField Label="OnKeyDown, OnKeyUp & OnClick" TValue="int?"
                            OnClick="() => onClickCounter++"
                            OnKeyUp="() => onKeyUpCounter++"
                            OnKeyDown="(KeyboardEventArgs e) => lastKey = e.Key" />
            <div>Last key down: [@lastKey]</div>
            <div>OnKeyUp Counter: @onKeyUpCounter</div>
            <div>OnClick Counter: @onClickCounter</div>
        </div>
    </DemoExample>

    <DemoExample Title="Public API" RazorCode="@example16RazorCode" CsharpCode="@example16CsharpCode" Id="example16">
        <div>
            Captured with <b>@@ref</b>, the component exposes the operations its own controls perform, so an external control -
            a slider, a keypad, a barcode scanner - can drive the field without reimplementing its arithmetic.
            <b>IncrementAsync</b> and <b>DecrementAsync</b> step by the <b>Step</b> with the bounds, the snapping, the rounding
            and the callbacks all applied, and do nothing once the value sits on the bound they would move towards.
            <b>ClearAsync</b> wipes whatever the field is showing and raises <b>OnClear</b> without requiring the clear button.
            All three respect the disabled and read-only states and are safe to call from a background thread.
            <b>FocusAsync</b> moves the caret into the field - or onto the increment button in <b>HideInput</b> mode, where a
            hidden input cannot take it - and <b>InputElement</b> exposes the element reference.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField @ref="apiNumberField" Label="Driven from the outside" TValue="int?"
                            Min="0" Max="10" Step="2" @bind-Value="apiValue" />
            <div>value: [@apiValue]</div>
            <br />
            <BitStack Horizontal Gap="0.5rem">
                <BitButton OnClick="() => apiNumberField?.DecrementAsync()">Decrement</BitButton>
                <BitButton OnClick="() => apiNumberField?.IncrementAsync()">Increment</BitButton>
                <BitButton Variant="BitVariant.Outline" OnClick="() => apiNumberField?.ClearAsync()">Clear</BitButton>
                <BitButton Variant="BitVariant.Text" OnClick="() => apiNumberField?.FocusAsync()">Focus</BitButton>
            </BitStack>
        </div>
    </DemoExample>

    <DemoExample Title="Validation" RazorCode="@example17RazorCode" CsharpCode="@example17CsharpCode" Id="example17">
        <div>
            The field integrates with <b>EditForm</b> and data annotations out of the box: messages show up for out-of-range or
            missing values, the field takes the invalid styling, and aria-invalid is rendered automatically.
            Text that is not a number at all goes through the same channel instead of being dropped - the rejected text stays
            in the input to be corrected and the message comes from <b>ParsingErrorMessage</b>, whose <b>{0}</b> is filled with
            the <b>DisplayName</b> or the bound field name.
            Pair <b>NoClamp</b> with a <b>[Range]</b> annotation when the range is a business rule the user should be told
            about rather than silently corrected to.
            <b>NoValidate</b> detaches the field from the EditContext entirely, for a field that is a UI control rather than
            part of the edited model.
        </div>
        <br />
        <div class="example-box">
            @if (string.IsNullOrEmpty(SuccessMessage))
            {
                <EditForm Model="@validationModel" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
                    <DataAnnotationsValidator />

                    <BitNumberField Label="@($"Age: [{validationModel.Age}]")" @bind-Value="validationModel.Age" />
                    <ValidationMessage For="@(() => validationModel.Age)" />
                    <br />
                    <BitButton ButtonType="BitButtonType.Submit">Submit</BitButton>
                </EditForm>
            }
            else
            {
                <BitMessage Color="BitColor.Success">@SuccessMessage</BitMessage>
            }
            <br />
            <EditForm Model="@validationModel">
                <DataAnnotationsValidator />

                <BitNumberField Label="Custom ParsingErrorMessage (try typing letters)"
                                DisplayName="Weight"
                                ParsingErrorMessage="{0} must be a number."
                                @bind-Value="parsingErrorValue" />
                <ValidationMessage For="@(() => parsingErrorValue)" />
            </EditForm>
            <br />
            <EditForm Model="@rangeModel">
                <DataAnnotationsValidator />

                <BitNumberField Label="NoClamp & [Range(0, 100)]" NoClamp Min="0" Max="100" @bind-Value="rangeModel.Percentage" />
                <ValidationMessage For="@(() => rangeModel.Percentage)" />
            </EditForm>
        </div>
    </DemoExample>

    <DemoExample Title="Accessibility" RazorCode="@example18RazorCode" Id="example18">
        <div>
            The input is an ARIA <b>spinbutton</b> whose aria-valuenow, aria-valuemin, aria-valuemax and aria-valuetext stay in
            sync with the value and the bounds. aria-valuemin/max appear only for an explicit <b>Min</b>/<b>Max</b> - the
            extremes of the type would be noise - and aria-valuenow is left off entirely while the field is empty, which is how
            ARIA says "no value yet". aria-valuetext is added only when the visible text differs from the raw number, as it
            does with a <b>NumberFormat</b> or non-Latin digits; <b>AriaValueText</b> overrides the reading with a phrase.
            The icon-only buttons always carry a name - <b>IncrementAriaLabel</b>, <b>DecrementAriaLabel</b> and
            <b>ClearButtonAriaLabel</b> localize it - and stay out of the tab order, leaving the input as the single tab stop
            that handles the whole spinbutton keyboard set. They still step the value when an assistive technology activates
            them directly - a double tap in TalkBack or VoiceOver, a voice command - and not only under a real pointer. In <b>HideInput</b> mode they become the tab stops instead, are
            tied together into a group named by the label, and the value is announced through a live region; the group also
            carries the description, the error message and the prefix/suffix, which the hidden input cannot.
            The spinbutton role replaces the native role of the input, and with it what the <b>Required</b> and
            <b>ReadOnly</b> attributes would map into the accessibility tree on their own, so both states are written out as
            aria-required and aria-readonly instead.
            On a touch device the stacked <b>Compact</b> buttons grow so each one clears the 24px minimum pointer target, as
            they do on any pointer in <b>HideInput</b> mode, where there is no input left to reach the same value with.
            <b>AriaSetSize</b> and <b>AriaPositionInSet</b> place the field within a larger group of related fields.
        </div>
        <br />
        <div class="example-box">
            <BitNumberField Label="Volume" TValue="int" Min="0" Max="10" Mode="BitSpinButtonMode.Compact"
                            AriaDescription="Use the up and down arrow keys to adjust the volume between 0 and 10."
                            IncrementAriaLabel="Louder"
                            DecrementAriaLabel="Quieter" />
            <br />
            <BitNumberField Label="Rating" TValue="int" Min="1" Max="5" DefaultValue="3" Mode="BitSpinButtonMode.Compact"
                            AriaValueText="3 out of 5 stars" />
            <br />
            <BitNumberField Label="Quantity (2 of 3)" TValue="int?" ShowClearButton DefaultValue="1"
                            AriaSetSize="3" AriaPositionInSet="2"
                            ClearButtonAriaLabel="Remove the quantity" />
        </div>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example19RazorCode" CsharpCode="@example19CsharpCode" Id="example19">
        <div>
            <b>BitParams</b> carries a <b>BitNumberFieldParams</b> down to every number field under it, so a form, a card or a
            whole page sets the shared look and the shared numeric rules once instead of on every field.
            What it carries is a default and not an override: a field that writes a parameter for itself keeps its own value,
            and only what it left unset is filled in from the cascade - which is what lets one field step out of the group it is
            in without the group having to know about it. Every parameter of the component other than the ones that belong to a
            single field (its label, its value, its templates and its callbacks) is on the params object, and each is filled in
            on its own, so a field can take its <b>Mode</b> from the cascade and its <b>Suffix</b> from its own markup.
        </div>
        <br />
        <div class="example-box">
            <BitParams Parameters="@numberFieldParams">
                <BitNumberField Label="Width" TValue="int" />
                <BitNumberField Label="Height" TValue="int" />
                <BitNumberField Label="Depth (its own Suffix)" TValue="int" Suffix="m" />
            </BitParams>
            <br />
            <BitNumberField Label="Outside the cascade" TValue="int" />
        </div>
    </DemoExample>

