@page "/components/colorpicker"
@page "/components/color-picker"

<PageOutlet Url="components/colorpicker"
            Title="ColorPicker"
            Description="A keyboard-accessible color picker with a saturation-brightness area, hue and alpha sliders, hex/RGB/HSL/HSV fields, preset swatches, a WCAG contrast readout, the screen eyedropper, and a value in hex, rgb, hsl, hsv, hwb, oklab or oklch." />

<DemoPage Name="ColorPicker"
          Description="BitColorPicker is the panel a color is chosen on: a saturation-brightness area, hue and alpha sliders, text fields in hex, RGB, HSL or HSV, a palette of presets and the browser's eyedropper. It reads any CSS color notation and answers in the one it was given, or in the one Format pins. Every part is optional, so the same component is also a palette picker, a tint picker or a row of fields. It is fully keyboard-operable, announces colors by name, mirrors in right-to-left, and every string it writes is translatable."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          CssVariables="componentCssVariables"
          GitHubUrl="Inputs/ColorPicker/BitColorPicker.razor"
          GitHubDemoUrl="Inputs/ColorPicker/BitColorPickerDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
        <div>
            Unbound, the picker keeps its own state, starting on white. <b>Label</b> (or <b>LabelTemplate</b>) names
            the panel. <b>IsEnabled="false"</b> greys it out and takes it out of the tab order; <b>ReadOnly</b> keeps
            it at full contrast and focusable, and only refuses changes.
        </div>
        <br />
        <div class="example-box">
            <div>Basic:</div>
            <BitColorPicker />
            <br />
            <div>Label:</div>
            <BitColorPicker Label="Brand color" />
            <br />
            <div>LabelTemplate:</div>
            <BitColorPicker>
                <LabelTemplate>
                    <BitIcon IconName="@BitIconName.Color" /> <b>Accent color</b>
                </LabelTemplate>
            </BitColorPicker>
            <br />
            <div>Disabled:</div>
            <BitColorPicker IsEnabled="false" Color="#B34D4D" />
            <br />
            <div>ReadOnly:</div>
            <BitColorPicker ReadOnly ShowInputs @bind-Color="readOnlyColor" />
        </div>
    </DemoExample>

    <DemoExample Title="Alpha & Preview" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
        <div>
            <b>ShowAlphaSlider</b> adds the transparency track and <b>ShowPreview</b> the swatch beside it, both drawn
            over a checkerboard. The alpha is tracked, and readable through <b>Alpha</b>, even without the slider.
        </div>
        <br />
        <div class="example-box">
            <div>Alpha slider and preview:</div>
            <BitColorPicker ShowAlphaSlider ShowPreview @bind-Color="alphaColor" @bind-Alpha="alphaValue" />
            <BitLabel>Color: @alphaColor &nbsp; Alpha: @alphaValue</BitLabel>
            <br />
            <div>Preview only:</div>
            <BitColorPicker ShowPreview @bind-Color="previewColor" />
            <BitLabel>Color: @previewColor</BitLabel>
        </div>
    </DemoExample>

    <DemoExample Title="Inputs" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
        <div>
            <b>ShowInputs</b> adds text fields that commit on Enter or blur; an invalid value is put back. The hex
            field takes any CSS color, with or without the <b>#</b>, and grows to eight digits (plus an <b>A%</b>
            field) with the alpha slider on. <b>InputsMode</b> picks the channels - HexRgb, Hex, Rgb, Hsl or Hsv - and
            <b>ShowInputsModeSwitch</b> lets the user cycle them (<b>@@bind-InputsMode</b> follows). The mode only
            changes how the color is typed, never the published <b>Format</b>.
        </div>
        <br />
        <div class="example-box">
            <div>Hex and RGB, with alpha:</div>
            <BitColorPicker ShowInputs ShowPreview ShowAlphaSlider Format="BitColorFormat.HexAlpha" @bind-Color="inputsAlphaColor" />
            <BitLabel>Color: @inputsAlphaColor</BitLabel>
            <br />
            <div>User-selectable mode (the button at the end of the row):</div>
            <BitColorPicker ShowInputs ShowPreview ShowInputsModeSwitch
                            @bind-InputsMode="inputsMode" @bind-Color="inputsModeColor" />
            <BitLabel>Mode: @inputsMode &nbsp; Color: @inputsModeColor</BitLabel>
            <br />
            <div>Fixed to HSL:</div>
            <BitColorPicker ShowInputs ShowPreview InputsMode="BitColorInputsMode.Hsl" @bind-Color="hslInputsColor" />
            <BitLabel>Color: @hslInputsColor</BitLabel>
        </div>
    </DemoExample>

    <DemoExample Title="Presets" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
        <div>
            <b>Presets</b> adds one-click swatches in any notation; the current one is ringed. A preset with its own
            alpha applies it, one without keeps the current alpha, and <b>transparent</b> offers "no color".
            <b>PresetsPerRow</b> lays them on a grid. The palette is one tab stop walked with the arrow keys,
            <b>Home</b> and <b>End</b>.
        </div>
        <br />
        <div class="example-box">
            <div>Brand palette:</div>
            <BitColorPicker ShowPreview Presets="brandPresets" @bind-Color="presetColor" />
            <BitLabel>Color: @presetColor</BitLabel>
            <br />
            <div>One hue at four transparencies, plus "no color":</div>
            <BitColorPicker ShowPreview ShowAlphaSlider Presets="alphaPresets" Format="BitColorFormat.Rgba" @bind-Color="alphaPresetColor" />
            <BitLabel>Color: @alphaPresetColor</BitLabel>
            <br />
            <div>A shade ramp, five to a row:</div>
            <BitColorPicker ShowPreview Presets="rampPresets" PresetsPerRow="5" @bind-Color="rampPresetColor" />
            <BitLabel>Color: @rampPresetColor</BitLabel>
        </div>
    </DemoExample>

    <DemoExample Title="Eye dropper" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5">
        <div>
            <b>ShowEyeDropper</b> adds a button that samples a color from anywhere on the screen. It is only rendered
            where the browser supports the EyeDropper API (Chromium); Escape cancels without changing the color.
        </div>
        <br />
        <div class="example-box">
            <div>Click the eyedropper, then click anywhere on the screen:</div>
            <BitColorPicker ShowEyeDropper ShowPreview ShowInputs @bind-Color="eyeDropperColor" />
            <BitLabel>Color: @eyeDropperColor</BitLabel>
        </div>
    </DemoExample>

    <DemoExample Title="Contrast" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
        <div>
            <b>ShowContrast</b> shows the WCAG ratio against <b>ContrastColor</b> (white by default) with AA verdicts for
            normal (4.5:1) and large (3:1) text. A transparent color is composited onto the background first. Each
            verdict carries a mark as well as a color, and is announced with the saturation area.
        </div>
        <br />
        <div class="example-box">
            <div>Text color against a page background:</div>
            <BitColorPicker ShowContrast ShowInputs ShowPreview
                            ContrastColor="@contrastBackground"
                            @bind-Color="contrastColor" />
            <BitLabel>@contrastColor on @contrastBackground</BitLabel>
            <br />
            <div>Pick the background it is read on:</div>
            <BitColorPicker ShowPreview ShowInputs @bind-Color="contrastBackground" />
            <br />
            <div>Against a dark surface, with transparency:</div>
            <BitColorPicker ShowContrast ShowAlphaSlider ShowPreview
                            ContrastColor="#1B1A19"
                            Format="BitColorFormat.Rgba"
                            @bind-Color="contrastOnDarkColor" />
            <BitLabel>Color: @contrastOnDarkColor</BitLabel>
        </div>
    </DemoExample>

    <DemoExample Title="Format" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
        <div>
            Unset, the picker answers in the notation it was given. <b>Format</b> pins one: Hex, Rgb, Hsl, Hsv, Hwb,
            Oklab or Oklch, each with an alpha-carrying twin (<b>HexAlpha</b>, <b>Rgba</b>, ...) that keeps the
            transparency in the string. <b>Hsv</b> is not a CSS notation.
        </div>
        <br />
        <div class="example-box">
            <BitColorPicker ShowAlphaSlider ShowPreview Format="selectedFormat" @bind-Color="formatColor" />
            <BitLabel>Color: @formatColor</BitLabel>
            <br />
            <BitChoiceGroup Horizontal
                            Label="Format"
                            @bind-Value="selectedFormat"
                            TItem="BitChoiceGroupOption<BitColorFormat>" TValue="BitColorFormat">
                <BitChoiceGroupOption Text="Hex" Value="BitColorFormat.Hex" />
                <BitChoiceGroupOption Text="HexAlpha" Value="BitColorFormat.HexAlpha" />
                <BitChoiceGroupOption Text="Rgb" Value="BitColorFormat.Rgb" />
                <BitChoiceGroupOption Text="Rgba" Value="BitColorFormat.Rgba" />
                <BitChoiceGroupOption Text="Hsl" Value="BitColorFormat.Hsl" />
                <BitChoiceGroupOption Text="Hsla" Value="BitColorFormat.Hsla" />
                <BitChoiceGroupOption Text="Hsv" Value="BitColorFormat.Hsv" />
                <BitChoiceGroupOption Text="Hsva" Value="BitColorFormat.Hsva" />
                <BitChoiceGroupOption Text="Hwb" Value="BitColorFormat.Hwb" />
                <BitChoiceGroupOption Text="Hwba" Value="BitColorFormat.Hwba" />
                <BitChoiceGroupOption Text="Oklab" Value="BitColorFormat.Oklab" />
                <BitChoiceGroupOption Text="Oklaba" Value="BitColorFormat.Oklaba" />
                <BitChoiceGroupOption Text="Oklch" Value="BitColorFormat.Oklch" />
                <BitChoiceGroupOption Text="Oklcha" Value="BitColorFormat.Oklcha" />
            </BitChoiceGroup>
        </div>
    </DemoExample>

    <DemoExample Title="Binding" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
        <div>
            A one-way <b>Color</b> with no callback makes the picker a display: the page drives it and its own controls
            are inert. <b>@@bind-Color</b> makes it two-way. The parser takes hex (3, 4, 6, 8 digits), rgb(), hsl(),
            hsv(), hwb(), lab(), lch(), oklab(), oklch(), color(srgb ...), keywords and <b>transparent</b>; anything
            else leaves the color unchanged. <b>@@bind-Alpha</b> binds the transparency separately.
        </div>
        <br />
        <div class="example-box">
            <div>One-way:</div>
            <BitColorPicker Color="oneWayColor" ShowPreview />
            <div class="buttons">
                @foreach (var (label, color) in oneWayOptions)
                {
                    <BitButton OnClick="() => oneWayColor = color">@label</BitButton>
                }
            </div>
            <br />
            <div>Two-way (try 'tomato', '#0f8', 'rgb(255 128 0 / 40%)', 'hwb(280 10% 20%)', 'oklch(0.7 0.18 200)'):</div>
            <BitColorPicker @bind-Color="twoWayColor" @bind-Alpha="twoWayAlpha" ShowAlphaSlider ShowPreview />
            <BitTextField Label="Enter a color" @bind-Value="twoWayColor" Style="width: 220px;" />
            <BitLabel>Alpha: @twoWayAlpha</BitLabel>
        </div>
    </DemoExample>

    <DemoExample Title="Events & API" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
        <div>
            <b>OnChange</b> fires on every step of a drag; <b>OnChangeEnd</b> once per gesture (drag end, slider
            release, field commit, preset) - use it for expensive work. Both pass a <b>BitColorChangeEventArgs</b> with
            the color in every notation. A <b>@@ref</b> exposes the same readings (<b>Hex</b>, <b>Rgba</b>, <b>Hsl</b>,
            <b>Oklch</b>, <b>ColorDescription</b>, ...) and <b>FocusAsync</b>.
        </div>
        <br />
        <div class="example-box">
            <BitColorPicker @ref="colorPickerRef" ShowAlphaSlider ShowPreview
                            OnChange="HandleOnChange"
                            OnChangeEnd="HandleOnChangeEnd" />
            <BitButton OnClick="() => colorPickerRef?.FocusAsync()">Focus the picker</BitButton>
            <BitLabel>OnChange: @changeCount times, last @changedColor</BitLabel>
            <BitLabel>OnChangeEnd: @changeEndCount times, last @changedHex / @changedRgba</BitLabel>
            <br />
            <BitLabel>ColorDescription: @colorPickerRef?.ColorDescription</BitLabel>
            <BitLabel>Hex / HexAlpha: @colorPickerRef?.Hex / @colorPickerRef?.HexAlpha</BitLabel>
            <BitLabel>Rgb / Rgba: @colorPickerRef?.Rgb / @colorPickerRef?.Rgba</BitLabel>
            <BitLabel>Hsl: @colorPickerRef?.Hsl</BitLabel>
            <BitLabel>Hsv: @colorPickerRef?.Hsv</BitLabel>
            <BitLabel>Hwb: @colorPickerRef?.Hwb</BitLabel>
            <BitLabel>Oklch: @colorPickerRef?.Oklch</BitLabel>
        </div>
    </DemoExample>

    <DemoExample Title="Accessibility & localization" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
        <div>
            The saturation area is a "2D slider": arrows move 1%, <b>Shift</b> or <b>PageUp</b>/<b>PageDown</b> 10%,
            <b>Home</b>/<b>End</b> jump along the saturation axis, and horizontal arrows follow the reading direction.
            Colors are announced by name ("light vibrant green, ...") rather than channel numbers. Unnamed, the panel
            describes its color; <b>AriaLabel</b> overrides that. <b>AutoFocus</b> focuses the first control on render.
        </div>
        <br />
        <div>
            <b>Texts</b> translates every string the picker writes - accessible names, field captions and
            announcements. Its <b>...Format</b> properties are <b>string.Format</b> templates, so a translation can
            reorder or drop placeholders.
        </div>
        <br />
        <div class="example-box">
            <div>Tab to the gradient, then use the arrow, Page, Home and End keys:</div>
            <BitColorPicker ShowAlphaSlider ShowInputs ShowPreview
                            AriaLabel="Choose the brand color"
                            @bind-Color="accessibilityColor" />
            <BitLabel>Color: @accessibilityColor</BitLabel>
            <br />
            <div>Read-only: still reachable, still announced, refuses every change.</div>
            <BitColorPicker ReadOnly ShowAlphaSlider ShowInputs ShowPreview
                            Presets="brandPresets"
                            @bind-Color="accessibilityColor" />
        </div>
        <br />
        <div dir="rtl">
            <div class="example-box">
                <BitColorPicker Dir="BitDir.Rtl" ShowAlphaSlider ShowInputs ShowPreview ShowInputsModeSwitch
                                Texts="persianTexts"
                                Label="رنگ برند"
                                Presets="brandPresets"
                                @bind-Color="localizedColor" />
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Compact pickers" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
        <div>
            <b>ShowSaturationArea</b> and <b>ShowHueSlider</b> (both on by default) turn off the gradient and the hue
            track, leaving a palette picker, a tint picker pinned to one hue, or a row of fields. For a dropdown-style
            picker, put it in a <b>BitCallout</b>: its <b>AutoFocus</b> lands on the picker's first control, and
            <b>FocusAsync</b> does the same from code.
        </div>
        <br />
        <div class="example-box">
            <div>A palette picker - no gradient, no hue:</div>
            <BitColorPicker ShowSaturationArea="false" ShowHueSlider="false" ShowPreview
                            Presets="brandPresets"
                            PresetsPerRow="5"
                            @bind-Color="paletteOnlyColor" />
            <BitLabel>Color: @paletteOnlyColor</BitLabel>
            <br />
            <div>A tint picker, pinned to one hue:</div>
            <BitColorPicker ShowHueSlider="false" ShowPreview ShowInputs @bind-Color="tintColor" />
            <BitLabel>Color: @tintColor</BitLabel>
            <br />
            <div>Fields only:</div>
            <BitColorPicker ShowSaturationArea="false" ShowHueSlider="false" ShowInputs ShowInputsModeSwitch ShowPreview ShowAlphaSlider
                            @bind-Color="fieldsOnlyColor" />
            <BitLabel>Color: @fieldsOnlyColor</BitLabel>
            <br />
            <div>In a popover:</div>
            <BitCallout AutoFocus>
                <Anchor>
                    <BitButton Variant="BitVariant.Outline" AriaLabel="@($"Text color, {popoverColor}")">
                        <span style="display:inline-block;width:1rem;height:1rem;border:1px solid;border-radius:2px;background:@popoverColor"></span>
                        &nbsp;@popoverColor
                    </BitButton>
                </Anchor>
                <Content>
                    <BitColorPicker ShowInputs Presets="brandPresets"
                                    Label="Text color"
                                    Style="--bit-ColorPicker-padding: 0.75rem;"
                                    @bind-Color="popoverColor" />
                </Content>
            </BitCallout>
        </div>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
        <div>
            <b>BitParams</b> with a <b>BitColorPickerParams</b> sets defaults - shown parts, palette, format - for every
            picker under it; a picker's own value always wins. <b>Color</b>, <b>Alpha</b> and the callbacks are not
            cascaded, and the mode is cascaded as <b>DefaultInputsMode</b> so the user can still switch it.
        </div>
        <br />
        <div class="example-box">
            <BitParams Parameters="@colorPickerParams">
                <div>Takes the palette, the inputs, the preview and the format from the cascade:</div>
                <BitColorPicker @bind-Color="cascadedColor" />
                <BitLabel>Color: @cascadedColor</BitLabel>
                <br />
                <div>The same, without repeating any of it:</div>
                <BitColorPicker @bind-Color="cascadedOtherColor" />
                <BitLabel>Color: @cascadedOtherColor</BitLabel>
                <br />
                <div>Its own Size, the cascaded rest:</div>
                <BitColorPicker Size="BitSize.Small" @bind-Color="cascadedSmallColor" />
            </BitParams>
            <br />
            <div>Outside the cascade, and back to the defaults:</div>
            <BitColorPicker @bind-Color="cascadedSmallColor" />
        </div>
    </DemoExample>

    <DemoExample Title="External Icons" RazorCode="@example13RazorCode" Id="example13">
        <div>
            <b>EyeDropperIconName</b> and <b>InputsModeSwitchIconName</b> take a bit icon name;
            <b>EyeDropperIcon</b> and <b>InputsModeSwitchIcon</b> take a <b>BitIconInfo</b> for external libraries
            (<b>BitIconInfo.Fa</b>, <b>.Bi</b>, <b>.Css</b>) and win when both are set. Reference the library's
            stylesheet yourself. The eyedropper only appears on supporting browsers.
        </div>

        <br /><br />

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

        <div class="example-box">
            <div>bit icon set:</div>
            <BitColorPicker ShowEyeDropper ShowInputs ShowInputsModeSwitch
                            EyeDropperIconName="@BitIconName.Color"
                            InputsModeSwitchIconName="@BitIconName.Switch" />
            <br />
            <div>FontAwesome:</div>
            <BitColorPicker ShowEyeDropper ShowInputs ShowInputsModeSwitch
                            EyeDropperIcon="@BitIconInfo.Fa("solid eye-dropper")"
                            InputsModeSwitchIcon="@BitIconInfo.Fa("solid right-left")" />
            <br />
            <div>Bootstrap:</div>
            <BitColorPicker ShowEyeDropper ShowInputs ShowInputsModeSwitch
                            EyeDropperIcon="@BitIconInfo.Bi("eyedropper")"
                            InputsModeSwitchIcon="@BitIconInfo.Bi("arrow-left-right")" />
        </div>
    </DemoExample>

    <DemoExample Title="Size" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
        <div>
            <b>Size</b> scales the whole panel - gradient, tracks, thumbs, preview, swatches and type. <b>Medium</b> is
            the default.
        </div>
        <br />
        <div class="example-box">
            <div>Small:</div>
            <BitColorPicker Size="BitSize.Small" ShowAlphaSlider ShowInputs ShowPreview Presets="brandPresets" @bind-Color="smallColor" />
            <br />
            <div>Medium:</div>
            <BitColorPicker Size="BitSize.Medium" ShowAlphaSlider ShowInputs ShowPreview Presets="brandPresets" @bind-Color="mediumColor" />
            <br />
            <div>Large:</div>
            <BitColorPicker Size="BitSize.Large" ShowAlphaSlider ShowInputs ShowPreview Presets="brandPresets" @bind-Color="largeColor" />
        </div>
    </DemoExample>

    <DemoExample Title="Style & Class" RazorCode="@example15RazorCode" Id="example15">
        <div>
            <b>Style</b> and <b>Class</b> reach the root; a fixed height shrinks the gradient, not the controls.
            <b>Styles</b> and <b>Classes</b> address each part by name (see
            <a href="#color-picker-class-styles">BitColorPickerClassStyles</a>). The public
            <b>--bit-ColorPicker-*</b> variables (see <a href="#css-variables-section">CSS variables</a>) inherit, so
            set them on <b>:root</b>, an ancestor, or one picker's <b>Style</b>; they win over <b>Size</b>.
        </div>
        <br />
        <div class="example-box">
            <div>Component's Style & Class:</div>
            <BitColorPicker ShowAlphaSlider Style="width: 230px; height: 150px;" />
            <br />
            <BitColorPicker ShowAlphaSlider Class="custom-class" />
            <br /><br />
            <div>Styles & Classes:</div>
            <BitColorPicker ShowAlphaSlider ShowPreview ShowInputs
                            Styles="@(new() { SaturationPicker = "border-radius: 1rem;",
                                              SaturationThumb = "width: 1.5rem; height: 1.5rem;",
                                              Preview = "border-radius: 50%;" })" />
            <br />
            <BitColorPicker ShowAlphaSlider ShowInputs Presets="brandPresets"
                            Classes="@(new() { FieldInput = "custom-field",
                                               Preset = "custom-preset",
                                               SelectedPreset = "custom-preset-selected" })" />
            <br /><br />
            <div>CSS variables, on one instance:</div>
            <BitColorPicker ShowAlphaSlider ShowInputs ShowPreview Presets="brandPresets"
                            Style="--bit-ColorPicker-width: 18rem;
                                   --bit-ColorPicker-saturation-height: 8rem;
                                   --bit-ColorPicker-saturation-radius: 1rem;
                                   --bit-ColorPicker-track-height: 0.75rem;
                                   --bit-ColorPicker-thumb-size: 1.25rem;
                                   --bit-ColorPicker-swatch-size: 1.25rem;
                                   --bit-ColorPicker-swatch-radius: 50%;
                                   --bit-ColorPicker-border-color: #7E4AE2;
                                   --bit-ColorPicker-focus-color: #7E4AE2;" />
            <br />
            <div>The same variables on an ancestor, re-skinning both pickers under it:</div>
            <div class="themed-pickers">
                <BitColorPicker ShowInputs ShowPreview Presets="brandPresets" />
                <BitColorPicker ShowInputs ShowPreview Size="BitSize.Small" />
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="RTL" RazorCode="@example16RazorCode" Id="example16">
        <div>
            <b>Dir="BitDir.Rtl"</b> mirrors the whole panel: the saturation axis, both tracks, the thumbs, the arrow
            keys, the fields and the presets.
        </div>
        <br />
        <div dir="rtl">
            <div class="example-box">
                <BitColorPicker Dir="BitDir.Rtl" ShowAlphaSlider ShowPreview ShowInputs Presets="brandPresets" @bind-Color="rtlColor" />
                <BitLabel>@rtlColor</BitLabel>
            </div>
        </div>
    </DemoExample>
</DemoPage>
