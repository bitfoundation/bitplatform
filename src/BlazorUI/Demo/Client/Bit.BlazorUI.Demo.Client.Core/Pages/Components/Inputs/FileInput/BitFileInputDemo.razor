        <div dir="rtl">
            <BitFileInput Dir="BitDir.Rtl" Label="انتخاب یا رها کردن فایل" Multiple ShowPreview ShowRemoveButton
                          RemoveButtonTitle="حذف" />
        </div>
    </DemoExample>
