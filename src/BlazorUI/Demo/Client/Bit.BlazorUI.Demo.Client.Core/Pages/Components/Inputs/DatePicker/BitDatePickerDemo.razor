@page "/components/datepicker"
@page "/components/date-picker"
@using Bit.BlazorUI.Demo.Client.Core.Helpers

<PageOutlet Url="components/datepicker"
            Title="DatePicker"
            Description="A BitDatePicker offers a drop-down calendar for picking a date, or a date and time, with any culture and time zone and full keyboard accessibility." />

<DemoPage Name="DatePicker"
          Description="A BitDatePicker picks a date, or a date and time, from a drop-down or inline calendar with day, month and year views. It supports min/max, disabled and highlighted dates, typed input, any culture, calendar and time zone, and the WAI-ARIA combobox and grid keyboard patterns."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          CssVariables="componentCssVariables"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          GitHubUrl="Inputs/DatePicker/BitDatePicker.razor"
          GitHubDemoUrl="Inputs/DatePicker/BitDatePickerDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
        <div>
            The everyday options: disabled, required, placeholder, week numbers, month highlighting, time picker,
            clear and close buttons, <b>AutoClose</b>, <b>AllowDeselect</b> (pick the selected day again to clear it),
            <b>StartingValue</b> (where an empty picker opens) and <b>Today</b> (overrides the current date).
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="Basic DatePicker" />
            <br /><br />
            <BitDatePicker Label="Disabled" IsEnabled="false" />
            <br /><br />
            <BitDatePicker Label="Required" Required />
            <br /><br />
            <BitDatePicker Label="PlaceHolder" Placeholder="Select a date" />
            <br /><br />
            <BitDatePicker Label="Week numbers" ShowWeekNumbers />
            <br /><br />
            <BitDatePicker Label="Highlight months" HighlightCurrentMonth HighlightSelectedMonth />
            <br /><br />
            <BitDatePicker Label="TimePicker" ShowTimePicker />
            <br /><br />
            <BitDatePicker Label="Show clear button when has a value" ShowClearButton />
            <br /><br />
            <BitDatePicker Label="Show close button" ShowCloseButton />
            <br /><br />
            <BitDatePicker Label="AutoClose (false)" AutoClose="false" />
            <br /><br />
            <BitDatePicker Label="AllowDeselect (re-select the selected day to clear)" AllowDeselect AutoClose="false" />
            <br /><br />
            <BitDatePicker Label="StartingValue: December 2020, 20:45" ShowTimePicker StartingValue="startingValue" />
            <br /><br />
            <BitDatePicker Label="Custom Today (March 2021)" Today="customToday" />
        </div>
    </DemoExample>

    <DemoExample Title="Min & Max" RazorCode="@example2RazorCode" Id="example2">
        <div>
            <b>MinDate</b> and <b>MaxDate</b> disable the days outside the range and stop the navigation at it;
            <b>DisablePast</b> and <b>DisableFuture</b> do the same with today as the bound. The narrower bound wins.
        </div>
        <br /><br />
        <div class="example-content">
            <div>Min: Now.AddDays(-5)</div>
            <div>Max: Now.AddDays(+5)</div>
            <BitDatePicker MinDate="DateTimeOffset.Now.AddDays(-5)" MaxDate="DateTimeOffset.Now.AddDays(5)" />
            <br /><br />
            <div>Min: Now.AddMonths(-2)</div>
            <div>Max: Now.AddMonths(+1)</div>
            <BitDatePicker MinDate="DateTimeOffset.Now.AddMonths(-2)" MaxDate="DateTimeOffset.Now.AddMonths(1)" />
            <br /><br />
            <div>Min: Now.AddYears(-5)</div>
            <div>Max: Now.AddYears(+1)</div>
            <BitDatePicker MinDate="DateTimeOffset.Now.AddYears(-5)" MaxDate="DateTimeOffset.Now.AddYears(1)" />
            <br /><br />
            <BitDatePicker Label="DisablePast (from today on)" DisablePast />
            <br /><br />
            <BitDatePicker Label="DisableFuture (up to today)" DisableFuture />
        </div>
    </DemoExample>

    <DemoExample Title="Disabled dates" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
        <div>
            Disable a list of dates (<b>DisabledDates</b>), whole weekdays (<b>DisabledDaysOfWeek</b>) or any rule
            (<b>IsDateDisabled</b>). Disabled days cannot be selected and the keyboard skips them.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="DisabledDaysOfWeek (weekends)" DisabledDaysOfWeek="@weekendDays" />
            <br /><br />
            <BitDatePicker Label="DisabledDates (a few upcoming dates)" DisabledDates="@disabledDates" />
            <br /><br />
            <BitDatePicker Label="IsDateDisabled (odd days)" IsDateDisabled="@(d => d.Day % 2 == 1)" />
        </div>
    </DemoExample>

    <DemoExample Title="Highlighted dates" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
        <div>
            <b>HighlightedDates</b> marks days (and names them as such for a screen reader through
            <b>HighlightedDateAriaLabel</b>), <b>GetDayClass</b> adds CSS classes to any day, and
            <b>HighlightToday</b> turns off the accent on today.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="HighlightedDates" HighlightedDates="@highlightedDates" />
            <br /><br />
            <BitDatePicker Label="GetDayClass (Sundays)" GetDayClass='@(d => d.DayOfWeek == DayOfWeek.Sunday ? "sunday-cell" : null)' />
            <br /><br />
            <BitDatePicker Label="HighlightToday (false)" HighlightToday="false" />
        </div>
    </DemoExample>

    <DemoExample Title="Calendar layout" RazorCode="@example5RazorCode" Id="example5">
        <div>
            <b>FirstDayOfWeek</b>, <b>WeekNumberRule</b> (ISO 8601: FirstFourDayWeek from Monday),
            <b>ShowOutsideDays</b> and <b>FixedWeeks</b> shape the day grid. <b>MonthCount</b> shows up to three
            months side by side (fewer on a narrow viewport) and <b>PagedNavigation</b> moves them all at once.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="FirstDayOfWeek (Monday)" FirstDayOfWeek="DayOfWeek.Monday" />
            <br /><br />
            <BitDatePicker Label="ISO 8601 week numbers"
                           ShowWeekNumbers
                           FirstDayOfWeek="DayOfWeek.Monday"
                           WeekNumberRule="CalendarWeekRule.FirstFourDayWeek" />
            <br /><br />
            <BitDatePicker Label="ShowOutsideDays (false)" ShowOutsideDays="false" />
            <br /><br />
            <BitDatePicker Label="FixedWeeks (always six weeks)" FixedWeeks />
            <br /><br />
            <BitDatePicker Label="MonthCount (2)" MonthCount="2" IsMonthPickerVisible="false" />
            <br /><br />
            <BitDatePicker Label="MonthCount (3) with PagedNavigation"
                           MonthCount="3"
                           PagedNavigation
                           ShowMonthPickerAsOverlay />
        </div>
    </DemoExample>

    <DemoExample Title="Month & year pickers" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
        <div>
            Hide the month/year picker with <b>IsMonthPickerVisible</b>, or open it over the day picker from the
            month title with <b>ShowMonthPickerAsOverlay</b> - which a narrow screen turns on by itself.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="IsMonthPickerVisible" IsMonthPickerVisible="@isMonthPickerVisible" />
            <br />
            <BitToggleButton OnText="MonthPicker visible" OffText="MonthPicker hidden" @bind-IsChecked="@isMonthPickerVisible" />
            <br /><br /><br />
            <BitDatePicker Label="ShowMonthPickerAsOverlay" ShowMonthPickerAsOverlay="@showMonthPickerAsOverlay" />
            <br />
            <BitToggleButton OnText="Position overlay" OffText="Position besides" @bind-IsChecked="@showMonthPickerAsOverlay" />
        </div>
    </DemoExample>

    <DemoExample Title="TimePicker" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
        <div>
            <b>ShowTimePicker</b> adds the time of day, <b>ShowSeconds</b> a seconds field, <b>TimeFormat</b> the
            12-hour clock, <b>ShowTimePickerAsOverlay</b> puts it behind a clock button, and <b>ShowNowButton</b>
            hides the now button. Selecting a day keeps the callout open so the time can be set too.
            <br /><br />
            The offered times: <b>HourStep</b>/<b>MinuteStep</b>/<b>SecondStep</b> set the grid,
            <b>MinTime</b>/<b>MaxTime</b> bound every day (MinDate/MaxDate only bound the day they fall on), and
            <b>AllowedHours</b>/<b>AllowedMinutes</b>/<b>AllowedSeconds</b> rule out the rest. The spin buttons, the
            PageUp/PageDown keys and typing all obey them. <b>ContinuousSpinDelay</b> and
            <b>ContinuousSpinInterval</b> tune press-and-hold.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="Basic time picker (24-hour)" ShowTimePicker @bind-Value="@selectedDateTime" />
            <div>Selected DateTime: @selectedDateTime.ToString()</div>
            <br /><br />
            <BitDatePicker Label="TimeFormat (12-hour with AM/PM)" ShowTimePicker TimeFormat="BitTimeFormat.TwelveHours" />
            <br /><br />
            <BitDatePicker Label="ShowSeconds (SecondStep 15)" ShowTimePicker ShowSeconds SecondStep="15" />
            <br /><br />
            <BitDatePicker Label="ShowTimePickerAsOverlay" ShowTimePicker ShowTimePickerAsOverlay />
            <br /><br />
            <BitDatePicker Label="Without the now button" ShowTimePicker ShowNowButton="false" />
            <br /><br />
            <BitDatePicker Label="HourStep 2 & MinuteStep 15" ShowTimePicker HourStep="2" MinuteStep="15" />
            <br /><br />
            <BitDatePicker Label="Working hours only, no lunch hour"
                           ShowTimePicker
                           MinuteStep="15"
                           MinTime="TimeSpan.FromHours(9)"
                           MaxTime="new TimeSpan(17, 30, 0)"
                           AllowedHours="@(h => h != 13)" />
            <br /><br />
            <BitDatePicker Label="Slower press-and-hold spin"
                           ShowTimePicker
                           ContinuousSpinDelay="800"
                           ContinuousSpinInterval="200" />
            <br /><br />
            <BitDatePicker Label="Nothing later than now (MaxDate)" ShowTimePicker MaxDate="DateTimeOffset.Now" />
        </div>
    </DemoExample>

    <DemoExample Title="Date format & text input" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
        <div class="example-desc">
            <b>DateFormat</b> sets the pattern the value is written and read with (default: the culture's short date,
            plus its time). <b>AllowTextInput</b> lets the date be typed; the input then carries the expected pattern
            as its accessible description (<b>DateFormatAriaDescription</b>). Invalid text, a date out of range, a
            disabled date and a disallowed time fail validation with <b>InvalidErrorMessage</b>,
            <b>OutOfRangeErrorMessage</b>, <b>DisabledDateErrorMessage</b> and <b>DisallowedTimeErrorMessage</b>.
        </div>
        <div class="example-content">
            <BitDatePicker Label="DateFormat"
                           DateFormat="dd=MM(yy)"
                           Placeholder="Select a date" />
            <br /><br />
            <BitDatePicker Label="Text input allowed"
                           AllowTextInput
                           DateFormat="dd/MM/yyyy"
                           Placeholder="Enter a date (dd/MM/yyyy)" />
            <br /><br />
            <BitDatePicker Label="With custom error messages"
                           AllowTextInput
                           DateFormat="dd/MM/yyyy"
                           MinDate="DateTimeOffset.Now.AddDays(-5)"
                           MaxDate="DateTimeOffset.Now.AddDays(5)"
                           DisabledDaysOfWeek="@weekendDays"
                           InvalidErrorMessage="The date format must be dd/MM/yyyy."
                           OutOfRangeErrorMessage="Only the ±5 days around today are allowed."
                           DisabledDateErrorMessage="That day of the week is not available."
                           Placeholder="Enter a date (dd/MM/yyyy)" />
        </div>
    </DemoExample>

    <DemoExample Title="Binding" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
        <div>
            Two-way bind with <b>@@bind-Value</b>, or set <b>DefaultValue</b> and listen to <b>OnChange</b>.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="Two-way binding" @bind-Value="@selectedDate" />
        </div>
        <br />
        <div>Selected date: @selectedDate.ToString()</div>
        <br /><br /><br />
        <div class="example-content">
            <BitDatePicker Label="DefaultValue & OnChange"
                           DefaultValue="DateTimeOffset.Now"
                           OnChange="v => changedDate = v" />
        </div>
        <br />
        <div>Changed date: @(changedDate?.ToString() ?? "-")</div>
    </DemoExample>

    <DemoExample Title="Culture & localization" RazorCode="@example10RazorCode" Id="example10">
        <div>
            <b>Culture</b> supplies the names, the first day of the week, the formats and the calendar itself
            (the Persian one below is a calendar of its own). Every title and accessible name is a parameter, so
            the rest is localized too - the last picker sets them all. See
            <BitLink Href="https://github.com/bitfoundation/bitplatform/blob/develop/src/BlazorUI/Demo/Client/Bit.BlazorUI.Demo.Client.Core/Helpers/CultureInfoHelper.cs" Target="_blank">
                CultureInfoHelper
            </BitLink> for building a custom culture.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="fa-IR culture with Farsi names"
                           GoToTodayTitle="برو به امروز"
                           Culture="CultureInfoHelper.GetFaIrCultureWithFarsiNames()" />
            <br /><br />
            <BitDatePicker Label="fa-IR culture with Fingilish names"
                           GoToTodayTitle="Boro be emrouz"
                           Culture="CultureInfoHelper.GetFaIrCultureWithFingilishNames()" />
            <br /><br />
            <BitDatePicker Label="Every title and accessible name translated"
                           ShowTimePicker
                           ShowWeekNumbers
                           ShowClearButton
                           ShowCloseButton
                           Culture="CultureInfoHelper.GetFaIrCultureWithFarsiNames()"
                           Placeholder="یک تاریخ انتخاب کنید"
                           CalloutAriaLabel="تقویم"
                           SelectedDateAriaAtomic="تاریخ انتخاب‌شده {0}"
                           ClearButtonTitle="پاک کردن تاریخ"
                           CloseButtonTitle="بستن تقویم"
                           GoToTodayTitle="برو به امروز"
                           GoToPrevMonthTitle="ماه قبل"
                           GoToNextMonthTitle="ماه بعد"
                           GoToPrevYearTitle="سال قبل {0}"
                           GoToNextYearTitle="سال بعد {0}"
                           GoToPrevYearRangeTitle="بازه قبلی {0} - {1}"
                           GoToNextYearRangeTitle="بازه بعدی {0} - {1}"
                           MonthPickerToggleTitle="{0}، تغییر ماه"
                           YearPickerToggleTitle="{0}، تغییر سال"
                           YearRangePickerToggleTitle="{0} - {1}، تغییر ماه"
                           WeekNumbersHeaderTitle="هفته"
                           WeekNumberTitle="هفته {0}"
                           NowButtonTitle="برو به اکنون"
                           ShowTimePickerTitle="نمایش ساعت"
                           HideTimePickerTitle="پنهان کردن ساعت"
                           TimePickerHourTitle="ساعت"
                           TimePickerMinuteTitle="دقیقه"
                           TimePickerIncreaseHourTitle="افزایش ساعت"
                           TimePickerDecreaseHourTitle="کاهش ساعت"
                           TimePickerIncreaseMinuteTitle="افزایش دقیقه"
                           TimePickerDecreaseMinuteTitle="کاهش دقیقه" />
        </div>
    </DemoExample>

    <DemoExample Title="TimeZone" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
        <div>
            <b>TimeZone</b> is the zone the value is read and shown in: the selected day, the month the calendar
            opens on and the time. Time zone data differs per OS and runtime settings (e.g. InvariantTimezone,
            <BitLink Href="https://learn.microsoft.com/en-us/aspnet/core/blazor/globalization-localization?view=aspnetcore-9.0#timezone-information"
                     Target="_blank">more info</BitLink>).
        </div>
        <br /><br />
        <div><b>Default (local TimeZone)</b>:</div><br/>
        <div class="example-content">
            <BitDatePicker @bind-Value="@timeZoneDate1" ShowTimePicker />
        </div>
        <br />
        <div>Selected date: @timeZoneDate1?.ToString()</div>

        @{
            TimeZoneInfo? timeZoneInfo = null;
            var allTimeZones = TimeZoneInfo.GetSystemTimeZones();
            if (allTimeZones.Count > 0)
            {
                timeZoneInfo = allTimeZones[0];
            }
        }

        @if (timeZoneInfo is not null) {
            <br /><br /><br /><br />
            <div><b>"@timeZoneInfo.Id" TimeZone</b>:</div><br/>
            <div class="example-content">
                <BitDatePicker TimeZone="timeZoneInfo" @bind-Value="@timeZoneDate2" ShowTimePicker />
            </div>
            <br />
            <div>Selected date: @timeZoneDate2?.ToString()</div>
        }
    </DemoExample>

    <DemoExample Title="Standalone" RazorCode="@example12RazorCode" Id="example12">
        <div>
            <b>Standalone</b> renders the calendar inline, without the input and callout. It still takes part in
            an EditForm through a hidden input.
        </div>
        <br />
        <div class="example-content-standalone">
            <BitDatePicker Label="Basic DatePicker" Standalone />
            <br /><br />
            <BitDatePicker Label="Disabled" IsEnabled="false" Standalone />
            <br /><br />
            <BitDatePicker Label="Week numbers, highlighted months and a time picker"
                           Standalone
                           ShowTimePicker
                           ShowWeekNumbers
                           HighlightCurrentMonth
                           HighlightSelectedMonth />
        </div>
    </DemoExample>

    <DemoExample Title="Mode" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
        <div>
            <b>Mode</b> picks a month (<b>MonthPicker</b>) or a year (<b>YearPicker</b>) instead of a day: the input
            shows just that, and the value is its first day the Min/Max range and the day rules allow.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker @bind-Value="monthPickerDate"
                           Label="MonthPicker"
                           Placeholder="Select a month"
                           Mode="BitDatePickerMode.MonthPicker" />
            <div>Selected date: @(monthPickerDate?.ToString("yyyy/MM/dd") ?? "None")</div>
            <br /><br />
            <BitDatePicker Label="MonthPicker with Min/Max and highlighting"
                           Placeholder="Select a month"
                           Mode="BitDatePickerMode.MonthPicker"
                           HighlightCurrentMonth
                           HighlightSelectedMonth
                           MinDate="DateTimeOffset.Now.AddMonths(-6)"
                           MaxDate="DateTimeOffset.Now.AddMonths(6)" />
            <br /><br />
            <BitDatePicker @bind-Value="yearPickerDate"
                           Label="YearPicker (year of birth)"
                           Placeholder="Select a year"
                           Mode="BitDatePickerMode.YearPicker"
                           DisableFuture />
            <div>Selected date: @(yearPickerDate?.ToString("yyyy/MM/dd") ?? "None")</div>
        </div>
        <br /><br />
        <div class="example-content-standalone">
            <BitDatePicker Standalone
                           Label="Standalone MonthPicker"
                           Mode="BitDatePickerMode.MonthPicker" />
            <br /><br />
            <BitDatePicker Standalone
                           Label="Standalone YearPicker"
                           Mode="BitDatePickerMode.YearPicker" />
        </div>
    </DemoExample>

    <DemoExample Title="ReadOnly" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
        <div>
            <b>ReadOnly</b> shows the value and lets the calendar be browsed, but nothing can change it - not the
            days, the time, the clear button or typing.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="Basic" ReadOnly @bind-Value="readOnlyDate" />
            <br /><br />
            <BitDatePicker Label="Text input allowed" ReadOnly AllowTextInput @bind-Value="readOnlyDate" />
        </div>
        <br /><br />
        <div class="example-content-standalone">
            <BitDatePicker Label="Standalone" ReadOnly Standalone @bind-Value="readOnlyDate" />
            <br /><br />
            <BitDatePicker Label="Standalone with TimePicker" ReadOnly ShowTimePicker Standalone @bind-Value="readOnlyDate" />
        </div>
    </DemoExample>

    <DemoExample Title="Templates" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
        <div>
            <b>LabelTemplate</b>, <b>IconTemplate</b>, <b>DayCellTemplate</b>, <b>MonthCellTemplate</b> and
            <b>YearCellTemplate</b> replace their parts; <b>CalloutHeaderTemplate</b> and
            <b>CalloutFooterTemplate</b> add content around the calendar, such as preset buttons.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker>
                <LabelTemplate>
                    Custom label <BitIcon IconName="@BitIconName.Calendar" />
                </LabelTemplate>
            </BitDatePicker>
            <br /><br /><br />
            <BitDatePicker Label="DayCellTemplate">
                <DayCellTemplate>
                    <span class="day-cell@(context.DayOfWeek == DayOfWeek.Sunday ? " weekend-cell" : null)">
                        @context.Day

                        @if (context.Day % 5 is 0)
                        {
                            <span class="badge"></span>
                        }
                    </span>
                </DayCellTemplate>
            </BitDatePicker>
            <br /><br /><br />
            <BitDatePicker Label="MonthCellTemplate">
                <MonthCellTemplate>
                    <div style="padding:3px;color:black;background:@(context.Month == 1 ? "lightcoral" : "yellowgreen")">
                        @culture.DateTimeFormat.GetAbbreviatedMonthName(context.Month)
                    </div>
                </MonthCellTemplate>
            </BitDatePicker>
            <br /><br /><br />
            <BitDatePicker Label="YearCellTemplate">
                <YearCellTemplate>
                    <span style="position: relative">
                        @context
                        <span class="year-suffix">AC</span>
                    </span>
                </YearCellTemplate>
            </BitDatePicker>
            <br /><br /><br />
            <BitDatePicker @ref="presetsPicker" @bind-Value="presetsValue" Label="Callout header & footer (presets)">
                <CalloutHeaderTemplate>
                    <div class="callout-header">Pick your appointment</div>
                </CalloutHeaderTemplate>
                <CalloutFooterTemplate>
                    <div class="callout-footer">
                        <BitButton Variant="BitVariant.Text" OnClick="() => SelectPreset(0)">Today</BitButton>
                        <BitButton Variant="BitVariant.Text" OnClick="() => SelectPreset(1)">Tomorrow</BitButton>
                        <BitButton Variant="BitVariant.Text" OnClick="() => SelectPreset(7)">In a week</BitButton>
                    </div>
                </CalloutFooterTemplate>
            </BitDatePicker>
        </div>
    </DemoExample>

    <DemoExample Title="Responsive" RazorCode="@example16RazorCode" Id="example16">
        <div>
            <b>Responsive</b> turns the callout into a full-width panel on small screens that slides in from the
            top and closes with a swipe. Resize the window to try it.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="Responsive DatePicker"
                           Responsive
                           ShowWeekNumbers
                           Placeholder="Select a date" />
        </div>
    </DemoExample>

    <DemoExample Title="Events" RazorCode="@example17RazorCode" CsharpCode="@example17CsharpCode" Id="example17">
        <div>
            <b>OnSelectDate</b> reports each picked date and <b>OnMonthChange</b> the first day of the month the
            calendar moves to (handy for lazy-loading). <b>OnClick</b>, <b>OnFocusIn</b>, <b>OnFocusOut</b>,
            <b>OnClear</b>, <b>OnOpen</b> and <b>OnClose</b> report the rest, however they were triggered.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="OnSelectDate & OnMonthChange"
                           OnSelectDate="v => selectedDateEvent = v"
                           OnMonthChange="v => displayedMonth = v" />
            <br />
            <div>Selected date: @(selectedDateEvent?.ToString() ?? "-")</div>
            <div>Displayed month: @(displayedMonth?.ToString("MMMM yyyy") ?? "-")</div>
            <br /><br />
            <BitDatePicker Label="OnClick & OnFocusIn & OnFocusOut & OnClear"
                           ShowClearButton
                           OnClick="() => clickCount++"
                           OnFocusIn="() => focusInCount++"
                           OnFocusOut="() => focusOutCount++"
                           OnClear="() => clearCount++" />
            <br />
            <div>Clicked: @clickCount times</div>
            <div>Focused in: @focusInCount times</div>
            <div>Focused out: @focusOutCount times</div>
            <div>Cleared: @clearCount times</div>
            <br /><br />
            <BitDatePicker Label="OnOpen & OnClose"
                           OnOpen="() => openCount++"
                           OnClose="() => closeCount++" />
            <br />
            <div>Opened: @openCount times</div>
            <div>Closed: @closeCount times</div>
        </div>
    </DemoExample>

    <DemoExample Title="Keyboard & screen readers" RazorCode="@example18RazorCode" Id="example18">
        <div>
            The input follows the WAI-ARIA combobox pattern: <b>↓</b>/<b>↑</b> - and <b>Enter</b>/<b>Space</b> on a field
            that is not typed into - open the calendar and move the focus into it, <b>Esc</b> closes it and
            returns the focus. The callout is a modal dialog that keeps the
            focus while open. In the day grid:
            <br /><br />
            <ul>
                <li><b>←</b> / <b>→</b>: previous/next day</li>
                <li><b>↑</b> / <b>↓</b>: same day of the previous/next week</li>
                <li><b>Home</b> / <b>End</b>: first/last day of the week</li>
                <li><b>PageUp</b> / <b>PageDown</b>: same day of the previous/next month</li>
                <li><b>Shift+PageUp</b> / <b>Shift+PageDown</b>: same day of the previous/next year</li>
                <li><b>Enter</b> / <b>Space</b>: select the focused day</li>
            </ul>
            <br />
            The month and year grids take the same keys (PageUp/PageDown move a year or a range of years), and the
            time fields step with PageUp/PageDown. Disabled cells are skipped. Every day is named with its full
            date, and the selection and displayed month are announced as they change.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="Try the keyboard" ShowWeekNumbers ShowTimePicker />
            <br /><br />
            <BitDatePicker Label="Try the keyboard (month picker)" Mode="BitDatePickerMode.MonthPicker" />
        </div>
    </DemoExample>

    <DemoExample Title="Validation & messages" RazorCode="@example19RazorCode" CsharpCode="@example19CsharpCode" Id="example19">
        <div>
            In an <b>EditForm</b> the picker validates like any input and sets <code>aria-invalid</code>.
            <b>Description</b> adds helper text, <b>ErrorMessage</b> shows a rejection the app decides itself (e.g.
            a server response) and <b>Invalid</b> marks the field without a message. Both are tied to the input
            through <code>aria-describedby</code>, the error is announced as it appears, and
            <b>AriaDescription</b> adds text for screen readers alone.
        </div>
        <br />
        <div class="example-content">
            <EditForm Model="validationModel" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />

                <BitDatePicker Label="Required date" @bind-Value="validationModel.Date" />

                <ValidationMessage For="@(() => validationModel.Date)" />
                <br />
                <BitButton ButtonType="BitButtonType.Submit">Submit</BitButton>
                <BitButton ButtonType="BitButtonType.Reset" Variant="BitVariant.Outline"
                           OnClick="() => { validationModel = new(); SuccessMessage = string.Empty; }">
                    Reset
                </BitButton>
            </EditForm>
            @if (string.IsNullOrEmpty(SuccessMessage) is false)
            {
                <br />
                <BitMessage Color="BitColor.Success">@SuccessMessage</BitMessage>
            }
            <br /><br />
            <BitDatePicker Label="Appointment"
                           Description="Pick a weekday - we are closed on weekends."
                           ErrorMessage="@appointmentError"
                           OnChange="CheckAppointment" />
            <br /><br />
            <BitDatePicker Label="Invalid"
                           Invalid
                           Description="Marked invalid by the app."
                           AriaDescription="Dates are stored in UTC." />
        </div>
    </DemoExample>

    <DemoExample Title="Programmatic control" RazorCode="@example20RazorCode" CsharpCode="@example20CsharpCode" Id="example20">
        <div>
            Two-way bind <b>IsOpen</b>, or call <b>OpenCallout</b> and <b>CloseCalloutAndFocus</b> on a reference.
            A one-way bound IsOpen leaves the callout to the app: the picker reports changes but never closes it.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker @ref="programmaticPicker" @bind-IsOpen="isCalloutOpen" Label="Controlled callout" />
            <br />
            <div>IsOpen: @isCalloutOpen</div>
            <br />
            <BitButton OnClick="() => programmaticPicker?.OpenCallout()">OpenCallout()</BitButton>
            <BitButton Variant="BitVariant.Outline" OnClick="() => programmaticPicker?.CloseCalloutAndFocus()">
                CloseCalloutAndFocus()
            </BitButton>
        </div>
    </DemoExample>

    <DemoExample Title="Appearance" RazorCode="@example21RazorCode" Id="example21">
        <div>
            <b>Underlined</b>, <b>HasBorder</b>, <b>IconLocation</b> and <b>IconName</b> style the field,
            <b>ShowGoToToday</b> hides the today button, and <b>DropDirection</b> lets the callout open on any side.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="Underlined" Underlined />
            <br /><br />
            <BitDatePicker Label="HasBorder (false)" HasBorder="false" />
            <br /><br />
            <BitDatePicker Label="IconLocation (Left)" IconLocation="BitIconLocation.Left" />
            <br /><br />
            <BitDatePicker Label="IconName" IconName="@BitIconName.Calendar" />
            <br /><br />
            <BitDatePicker Label="ShowGoToToday (false)" ShowGoToToday="false" />
            <br /><br />
            <BitDatePicker Label="DropDirection (All sides)" DropDirection="BitDropDirection.All" />
        </div>
    </DemoExample>

    <DemoExample Title="CSS variables" RazorCode="@example22RazorCode" Id="example22">
        <div>
            Every visual value reads a <code>--bit-DatePicker-*</code> variable: set one on <code>:root</code> to
            re-skin every picker, or on <b>Style</b> to re-skin one - the picker copies them onto its callout, so the
            field and the calendar change together. <b>Styles.Callout</b> targets the calendar alone.
        </div>
        <br />
        <div class="example-content">
            <BitDatePicker Label="Re-skinned field and calendar"
                           ShowWeekNumbers
                           HighlightedDates="@highlightedDates"
                           Style="--bit-DatePicker-input-radius: 1rem;
                                  --bit-DatePicker-input-border-color: mediumpurple;
                                  --bit-DatePicker-icon-color: mediumpurple;
                                  --bit-DatePicker-focus-color: mediumpurple;
                                  --bit-DatePicker-callout-radius: 1rem;
                                  --bit-DatePicker-day-radius: 0.5rem;
                                  --bit-DatePicker-today-radius: 0.5rem;
                                  --bit-DatePicker-today-background: mediumpurple;
                                  --bit-DatePicker-selected-background: #ede7f6;
                                  --bit-DatePicker-highlighted-background: #d1c4e9;" />
            <br /><br />
            <BitDatePicker Label="Roomier calendar, same field"
                           ShowTimePicker
                           Styles="@(new() { Callout = "--bit-DatePicker-day-size: 2.75rem;" +
                                                       "--bit-DatePicker-day-font-size: 1rem;" +
                                                       "--bit-DatePicker-header-font-size: 1rem;" +
                                                       "--bit-DatePicker-time-font-size: 1.5rem;" +
                                                       "--bit-DatePicker-padding: 1rem;" })" />
        </div>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example23RazorCode" CsharpCode="@example23CsharpCode" Id="example23">
        <div>
            <b>BitParams</b> hands a <b>BitDatePickerParams</b> to every DatePicker inside it. The values are
            defaults, not overrides: a picker keeps whatever it sets itself.
        </div>
        <br />
        <div class="example-content">
            <BitParams Parameters="@datePickerParams">
                <div>Takes the week layout, the bounds and the clear button from the cascade:</div>
                <BitDatePicker Label="Start" />
                <br /><br />
                <div>So does this one, without repeating any of it:</div>
                <BitDatePicker Label="End" />
                <br /><br />
                <div>Its own bounds and placeholder, the cascaded week layout:</div>
                <BitDatePicker Label="Deadline"
                               Placeholder="Any day of the next year"
                               MinDate="DateTimeOffset.Now"
                               MaxDate="DateTimeOffset.Now.AddYears(1)" />
            </BitParams>
            <br /><br />
            <div>Outside the cascade, and back to the defaults:</div>
            <BitDatePicker Label="Anything" />
        </div>
    </DemoExample>

