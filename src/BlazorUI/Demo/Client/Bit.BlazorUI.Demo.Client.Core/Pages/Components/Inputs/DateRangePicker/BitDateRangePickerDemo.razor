@page "/components/daterangepicker"
@page "/components/date-range-picker"
@using Bit.BlazorUI.Demo.Client.Core.Helpers

<PageOutlet Url="components/daterangepicker"
            Title="DateRangePicker"
            Description="A BitDateRangePicker is a drop-down calendar for picking a start and an end date, with preset shortcuts, up to three months side by side, optional time selection, range limits, disabled days, an optional Apply/Cancel commit step and full globalization support." />

<DemoPage Name="DateRangePicker"
          Description="A BitDateRangePicker offers a drop-down control that’s optimized for picking two dates from a calendar view where contextual information like the day of the week or fullness of the calendar is important. The first click sets the start of the range, the second one closes it, and the days in between are highlighted while the pointer moves. Up to three months can be shown side by side and the most common ranges offered as one-click presets. The calendar can be constrained (MinDate, MaxDate, MinRange, MaxRange, disabled days), extended with a start/end time picker, turned into a transaction that commits on an Apply button, rendered inline, sized in three steps, navigated entirely from the keyboard and localized to any culture and time zone."
          Parameters="componentParameters"
          CssVariables="componentCssVariables"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          GitHubUrl="Inputs/DateRangePicker/BitDateRangePicker.razor"
          GitHubDemoUrl="Inputs/DateRangePicker/BitDateRangePickerDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
        <div class="example-desc">
            A read-only field that opens a calendar: the first click starts the range, the second closes it, a third
            starts over. Opening the callout moves the keyboard focus onto the day grid, unless the field is editable
            and the range may still be typed.
            <br /><br />
            <b>Label</b>, <b>Placeholder</b>, <b>Required</b> and <b>IsEnabled</b> behave as on any input.
            <b>ShowWeekNumbers</b>, <b>HighlightCurrentMonth</b>, <b>HighlightSelectedMonth</b>, <b>IsMonthPickerVisible</b>
            and <b>ShowTimePicker</b> shape the calendar; <b>IconName</b>, <b>IconLocation</b>, <b>Underlined</b>,
            <b>HasBorder</b> and <b>DropDirection</b> shape the field and where its callout opens.
            <b>ShowClearButton</b> adds a reset button once a range is set, <b>AutoClose</b> keeps the callout open after
            the second pick, and <b>StartingValue</b> decides the month and the times the calendar opens on while the
            value is empty.
        </div>
        <div class="example-content">
            <BitDateRangePicker Label="Basic DateRangePicker" />
            <br /><br />
            <BitDateRangePicker Label="Disabled" IsEnabled="false" />
            <br /><br />
            <BitDateRangePicker Label="Required" Required />
            <br /><br />
            <BitDateRangePicker Label="PlaceHolder" Placeholder="Select a date range" />
            <br /><br />
            <BitDateRangePicker Label="Week numbers" ShowWeekNumbers />
            <br /><br />
            <BitDateRangePicker Label="Highlight months" HighlightCurrentMonth HighlightSelectedMonth />
            <br /><br />
            <BitDateRangePicker Label="TimePicker" ShowTimePicker />
            <br /><br />
            <BitDateRangePicker Label="Custom Icon" IconName="@BitIconName.Airplane" />
            <br /><br />
            <BitDateRangePicker Label="Left icon" IconLocation="BitIconLocation.Left" />
            <br /><br />
            <BitDateRangePicker Label="Underlined" Underlined />
            <br /><br />
            <BitDateRangePicker Label="Without border" HasBorder="false" />
            <br /><br />
            <BitDateRangePicker Label="DropDirection: All" DropDirection="BitDropDirection.All" />
            <br /><br />
            <BitDateRangePicker Label="Disabled AutoClose" AutoClose="false" />
            <br /><br />
            <BitDateRangePicker Label="Show clear button when has a value" ShowClearButton ClearButtonTitle="Clear the dates" />
            <br /><br />
            <BitDateRangePicker Label="Hidden month picker" IsMonthPickerVisible="false" />
            <br /><br />
            <div style="font-weight:600;padding:4px 0;font-size:14px;color:var(--bit-clr-fg-pri);">
                <div>StartingValue: December 2020</div>
                <div>Start Time: 10:12</div>
                <div>End Time: 16:59</div>
            </div>
            <BitDateRangePicker ShowTimePicker StartingValue="startingValue" />
        </div>
    </DemoExample>

    <DemoExample Title="Presets" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
        <div class="example-desc">
            <b>Presets</b> puts the common ranges one click away, in a column beside the calendar. Each
            <b>BitDateRangePickerPreset</b> carries its button text and either a fixed <b>Value</b> or a
            <b>ValueProvider</b>, re-evaluated on every click - which is what keeps "Last 7 days" correct however long
            the page has been open. It can also be disabled, titled and styled on its own.
            <br /><br />
            The applied preset stays highlighted until the range changes by any other means, <b>OnPresetSelect</b>
            reports the click, and the callout closes on it exactly as it does on the second date. A preset whose range
            breaks the calendar's restrictions is rejected rather than clamped: a shifted variant would not be the range
            its button promised.
        </div>
        <div class="example-content">
            <BitDateRangePicker Label="Common ranges" Presets="presets" @bind-Value="presetsValue"
                                OnPresetSelect="@(preset => lastSelectedPreset = preset.Text)" />
        </div>
        <br />
        <div>Selected: <b>@(presetsValue?.StartDate?.ToString("d") ?? "-") → @(presetsValue?.EndDate?.ToString("d") ?? "-")</b></div>
        <div>Last selected preset: <b>@(lastSelectedPreset ?? "-")</b></div>
        <br /><br />
        <div class="example-content-standalone">
            <BitDateRangePicker Label="Presets in standalone mode" Presets="presets" Standalone />
        </div>
    </DemoExample>

    <DemoExample Title="Min & Max" RazorCode="@example3RazorCode" Id="example3">
        <div class="example-desc">
            <b>MinDate</b> and <b>MaxDate</b> bound the whole calendar: days, months and years outside them are disabled and
            the navigation buttons stop at the boundary. <b>MaxRange</b> and <b>MinRange</b> instead bound the length of the
            selection itself - once the start date is picked, every day that would produce a range longer than
            <b>MaxRange</b> or shorter than <b>MinRange</b> becomes unselectable. <b>MaxRange</b> bounds the day grid in whole days,
            equally far either side of the picked start date, and also accounts for the hours and minutes, so the time
            picker's spinners are disabled as soon as they would exceed it - and a <b>MaxRange</b> shorter than a day
            leaves the day the range started on as the only one it can end on.
            <b>DisablePast</b> and <b>DisableFuture</b> bound the calendar by today exactly as a <b>MinDate</b> or a
            <b>MaxDate</b> of today would, without having to keep one up to date; where both apply, the narrower of
            the two wins.
        </div>
        <div class="example-content">
            <div>Min: Now.AddDays(-5)</div>
            <div>Max: Now.AddDays(+5)</div>
            <BitDateRangePicker MinDate="DateTimeOffset.Now.AddDays(-5)" MaxDate="DateTimeOffset.Now.AddDays(5)" />
            <br /><br />
            <div>Min: Now.AddMonths(-2)</div>
            <div>Max: Now.AddMonths(+1)</div>
            <BitDateRangePicker MinDate="DateTimeOffset.Now.AddMonths(-2)" MaxDate="DateTimeOffset.Now.AddMonths(1)" />
            <br /><br />
            <div>Min: Now.AddYears(-5)</div>
            <div>Max: Now.AddYears(+1)</div>
            <BitDateRangePicker MinDate="DateTimeOffset.Now.AddYears(-5)" MaxDate="DateTimeOffset.Now.AddYears(1)" />
            <br /><br />
            <div>DisablePast:</div>
            <BitDateRangePicker DisablePast />
            <br /><br />
            <div>DisableFuture:</div>
            <BitDateRangePicker DisableFuture />
            <br /><br />
            <div>MaxRange: 2 days, 4 hours and 30 minutes</div>
            <BitDateRangePicker MaxRange="new TimeSpan(2, 4, 30, 0)" ShowTimePicker />
            <br /><br />
            <div>MaxRange: 6 hours (shorter than a day, so the range stays on the day it starts on)</div>
            <BitDateRangePicker MaxRange="TimeSpan.FromHours(6)" ShowTimePicker />
            <br /><br />
            <div>MinRange: 3 days (a stay of at least 3 nights)</div>
            <BitDateRangePicker MinRange="TimeSpan.FromDays(3)" />
            <br /><br />
            <div>MinRange: 2 days &amp; MaxRange: 7 days</div>
            <BitDateRangePicker MinRange="TimeSpan.FromDays(2)" MaxRange="TimeSpan.FromDays(7)" />
        </div>
    </DemoExample>

    <DemoExample Title="Disabled dates" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
        <div class="example-desc">
            Beyond the min/max bounds, individual days can be blocked out. <b>DisabledDaysOfWeek</b> takes the recurring days
            to disable (weekends, for example), <b>DisabledDates</b> takes an explicit list of dates (holidays, blackout days)
            and <b>IsDateDisabled</b> takes a predicate for anything rule-based. Disabled days cannot be clicked and are
            skipped by the keyboard navigation, but by default the range simply spans over them, so use them for days that
            must not be a start or an end of the selection. When the range must not cover them at all, <b>ExcludeDisabledDates</b>
            also disables every day whose range, measured from the already picked start date, would contain one.
        </div>
        <br />
        <div class="example-content">
            <div>DisabledDaysOfWeek: weekends</div>
            <BitDateRangePicker DisabledDaysOfWeek="@([DayOfWeek.Saturday, DayOfWeek.Sunday])" />
            <br /><br />
            <div>DisabledDates: an explicit list of blackout days</div>
            <BitDateRangePicker DisabledDates="disabledDates" />
            <br /><br />
            <div>IsDateDisabled: every day before today</div>
            <BitDateRangePicker IsDateDisabled="@(date => date.Date < DateTimeOffset.Now.Date)" />
            <br /><br />
            <div>ExcludeDisabledDates: the range cannot reach past a blackout day</div>
            <BitDateRangePicker DisabledDates="disabledDates" ExcludeDisabledDates />
        </div>
    </DemoExample>

    <DemoExample Title="Highlighted dates" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5">
        <div class="example-desc">
            <b>HighlightedDates</b> marks days that deserve attention without making them unselectable, and <b>GetDayClass</b>
            attaches an arbitrary CSS class to any day cell, which makes it possible to color-code a calendar (busy days,
            promotions, deadlines) from the application's own data.
        </div>
        <div class="example-content">
            <div>HighlightedDates: the next three days</div>
            <BitDateRangePicker HighlightedDates="highlightedDates" />
            <br /><br />
            <div>GetDayClass: paints every Friday</div>
            <BitDateRangePicker GetDayClass="@(date => date.DayOfWeek == DayOfWeek.Friday ? "custom-friday" : null)" />
        </div>
    </DemoExample>

    <DemoExample Title="Calendar layout" RazorCode="@example6RazorCode" Id="example6">
        <div class="example-desc">
            The shape of the day grid is configurable: <b>FirstDayOfWeek</b> overrides the first column of the week coming
            from the culture, <b>ShowOutsideDays</b> hides the leading and trailing days of the adjacent months,
            <b>FixedWeeks</b> always renders six week rows so the calendar keeps a constant height while navigating,
            <b>WeekNumberRule</b> chooses how week numbers are computed, <b>Today</b> overrides the date the calendar
            considers as today, which is useful for tests and for server-driven "current date" scenarios, and
            <b>HighlightToday</b> turns off the accent on today's cell - the cell still reports itself as the current
            date to a screen reader, so only the paint goes away.
            <br /><br />
            The chrome around the grid is optional too: <b>ShowMonthPickerAsOverlay</b> hides the month and year picker
            until the month title is clicked instead of standing it beside the days, <b>ShowGoToToday</b> drops the
            jump-to-today button, and <b>ShowCloseButton</b> adds a dismiss button to the callout's header.
        </div>
        <div class="example-content">
            <BitDateRangePicker Label="FirstDayOfWeek: Monday" FirstDayOfWeek="DayOfWeek.Monday" />
            <br /><br />
            <BitDateRangePicker Label="ShowOutsideDays: false" ShowOutsideDays="false" />
            <br /><br />
            <BitDateRangePicker Label="FixedWeeks (always six rows)" FixedWeeks />
            <br /><br />
            <BitDateRangePicker Label="WeekNumberRule: FirstFourDayWeek"
                                ShowWeekNumbers
                                FirstDayOfWeek="DayOfWeek.Monday"
                                WeekNumberRule="System.Globalization.CalendarWeekRule.FirstFourDayWeek" />
            <br /><br />
            <BitDateRangePicker Label="Today: 2020/12/04" Today="new DateTimeOffset(2020, 12, 4, 0, 0, 0, DateTimeOffset.Now.Offset)" />
            <br /><br />
            <BitDateRangePicker Label="HighlightToday: false" HighlightToday="false" />
            <br /><br />
            <BitDateRangePicker Label="ShowMonthPickerAsOverlay" ShowMonthPickerAsOverlay />
            <br /><br />
            <BitDateRangePicker Label="ShowGoToToday: false, with a close button" ShowGoToToday="false" ShowCloseButton />
        </div>
    </DemoExample>

    <DemoExample Title="Multiple months" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
        <div class="example-desc">
            <b>MonthCount</b> renders up to three consecutive months side by side, so a range across a month
            boundary needs no navigating in between: the hover preview, the selection and the arrow keys all flow
            across the grids. The strip moves as a whole - only the first month carries the "previous" button and
            only the last the "next" one - and it falls back to a single month on a viewport too narrow for it.
            <b>PagedNavigation</b> moves it by a whole page instead of a single month, so consecutive pages never
            overlap.
        </div>
        <div class="example-content">
            <BitDateRangePicker Label="Two months" MonthCount="2" @bind-Value="monthCountValue" />
            <br /><br />
            <BitDateRangePicker Label="Two months with presets" MonthCount="2" Presets="presets" />
            <br /><br />
            <BitDateRangePicker Label="Three months with week numbers" MonthCount="3" ShowWeekNumbers />
            <br /><br />
            <BitDateRangePicker Label="Two months with paged navigation" MonthCount="2" PagedNavigation />
        </div>
        <br />
        <div>
            Selected: <b>@(monthCountValue?.StartDate?.ToString("d") ?? "-") → @(monthCountValue?.EndDate?.ToString("d") ?? "-")</b>
        </div>
        <br /><br />
        <div class="example-content-standalone">
            <BitDateRangePicker Label="Two months in standalone mode" MonthCount="2" Standalone />
        </div>
    </DemoExample>

    <DemoExample Title="Time picker" RazorCode="@example8RazorCode" Id="example8">
        <div class="example-desc">
            <b>ShowTimePicker</b> puts a start and an end time under the calendar, so the range carries a time of day
            as well as a date. <b>TimeFormat</b> switches it between the 24-hour clock and a 12-hour one with the
            culture's AM/PM designators. <b>HourStep</b> and <b>MinuteStep</b> lay a grid over the day that every time
            the spin buttons produce sits on - a quarter-hour booking or a shift-based schedule says so this way - and
            holding a spin button repeats it, after <b>ContinuousSpinDelay</b> and then every
            <b>ContinuousSpinInterval</b>. <b>ShowTimePickerAsOverlay</b> puts the times on top of the calendar behind a
            toggle instead of beside it, which is what a callout too narrow for both does on its own.
        </div>
        <div class="example-content">
            <BitDateRangePicker ShowTimePicker
                                Label="12-hour clock"
                                TimeFormat="BitTimeFormat.TwelveHours" />
            <br /><br />
            <BitDateRangePicker ShowTimePicker
                                Label="HourStep = 2"
                                HourStep="2" />
            <br /><br />
            <BitDateRangePicker ShowTimePicker
                                Label="MinuteStep = 15, with a faster press-and-hold"
                                MinuteStep="15"
                                ContinuousSpinDelay="250"
                                ContinuousSpinInterval="40" />
            <br /><br />
            <BitDateRangePicker ShowTimePicker
                                Label="Times on top of the calendar"
                                ShowTimePickerAsOverlay />
        </div>
    </DemoExample>

    <DemoExample Title="Formatting" RazorCode="@example9RazorCode" Id="example9">
        <div class="example-desc">
            <b>DateFormat</b> controls how each of the two dates is rendered (and parsed back, when text input is allowed),
            while <b>ValueFormat</b> is the template that composes them into the single string shown in the input;
            <code>{0}</code> is the start date and <code>{1}</code> is the end date. When no <b>DateFormat</b> is provided the culture's
            short date pattern is used, extended with the time pattern whenever <b>ShowTimePicker</b> is enabled.
            An end date that has not been picked yet is rendered as <code>---</code>, which <b>NoDateText</b> replaces with any
            wording of its own, both when the value is written out and when it is typed back in.
        </div>
        <div class="example-content">
            <BitDateRangePicker Label="DateFormat: 'dd=MM(yy)'" DateFormat="dd=MM(yy)" />
            <br /><br />
            <BitDateRangePicker Label="ValueFormat: 'Dep: {0}, Arr: {1}'" ValueFormat="Dep: {0}, Arr: {1}" />
            <br /><br />
            <BitDateRangePicker Label="NoDateText: 'open ended'" NoDateText="open ended" ValueFormat="{0} - {1}" />
            <br /><br />
            <BitDateRangePicker Label="Default format with the time picker" ShowTimePicker />
        </div>
    </DemoExample>

    <DemoExample Title="Text input" RazorCode="@example10RazorCode" Id="example10">
        <div class="example-desc">
            <b>AllowTextInput</b> makes the field editable and parses the typed text back into a range. It must follow
            the <b>ValueFormat</b> template with both dates in the <b>DateFormat</b> pattern; leaving the end date as
            <code>---</code> keeps the range open-ended and a reversed pair is swapped. A typed range is held to every
            restriction the calendar enforces, so nothing that could not be picked from the day grid slips in this way -
            see <BitLink Href="#example20">Validation</BitLink> for the three messages that tell the failures apart.
        </div>
        <div class="example-content">
            <BitDateRangePicker Label="Text input allowed"
                                AllowTextInput
                                DateFormat="dd/MM/yyyy"
                                ValueFormat="{0} - {1}"
                                Placeholder="dd/MM/yyyy - dd/MM/yyyy" />
            <br /><br />
            <BitDateRangePicker Label="Custom invalid error message"
                                AllowTextInput
                                DateFormat="dd/MM/yyyy"
                                ValueFormat="{0} - {1}"
                                InvalidErrorMessage="The entered date range is not valid."
                                Placeholder="dd/MM/yyyy - dd/MM/yyyy" />
            <br /><br />
            <div>A typed range longer than the 7-day MaxRange is rejected as invalid:</div>
            <BitDateRangePicker Label="Text input with MaxRange: 7 days"
                                AllowTextInput
                                MaxRange="TimeSpan.FromDays(7)"
                                DateFormat="dd/MM/yyyy"
                                ValueFormat="{0} - {1}"
                                Placeholder="dd/MM/yyyy - dd/MM/yyyy" />
        </div>
    </DemoExample>

    <DemoExample Title="Binding" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
        <div class="example-desc">
            The value of the component is a <b>BitDateRangePickerValue</b> holding a nullable <b>StartDate</b> and
            <b>EndDate</b>, so a half-picked range is representable. Use <code>@@bind-Value</code> for two-way binding, or
            <b>DefaultValue</b> together with the <b>OnChange</b> callback for the uncontrolled mode.
        </div>
        <div class="example-content">
            <BitDateRangePicker @bind-Value="@selectedDateRange" />
        </div>
        <br />
        <div>From: <b>@selectedDateRange?.StartDate.ToString()</b></div>
        <div>To: <b>@selectedDateRange?.EndDate.ToString()</b></div>
    </DemoExample>

    <DemoExample Title="Apply & Cancel" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
        <div class="example-desc">
            <b>AutoApply="false"</b> turns the callout into a transaction: it grows a <b>Cancel</b> and an
            <b>Apply</b> button, and the range it was opened on is put back unless Apply commits the new one -
            dismissing the callout any other way (Escape, the overlay, the close button) rolls it back too.
            <b>Apply</b> stays disabled while only one end of the range is picked, and <b>AutoClose</b> is ignored,
            since the callout has to stay open for it. <b>OnApply</b> and <b>OnCancel</b> report the outcome;
            the buttons' wording comes from <b>ApplyButtonText</b> and <b>CancelButtonText</b>.
            <br /><br />
            The picks still reach the bound value as they are made - that is what the calendar, the presets and
            the time picker all read - so an application watching <b>Value</b> sees the range being built and
            then either kept or rolled back. A <b>Standalone</b> picker has no callout to commit, so it never
            renders the buttons.
        </div>
        <div class="example-content">
            <BitDateRangePicker Label="Pick, then apply"
                                AutoApply="false"
                                ShowClearButton
                                Presets="presets"
                                @bind-Value="applyValue"
                                OnApply="@(v => applyOutcome = $"Applied {Fmt(v)}")"
                                OnCancel="@(() => applyOutcome = "Cancelled")" />
        </div>
        <br />
        <div>Committed value: <b>@Fmt(applyValue)</b></div>
        <div>Last outcome: <b>@(applyOutcome ?? "-")</b></div>
    </DemoExample>

    <DemoExample Title="Events" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
        <div class="example-desc">
            <b>OnSelectDate</b> fires on every pick with the range as it stands, so the half-picked range (a start date
            and no end date yet) is reported too. <b>OnChange</b> fires only once the value itself changes,
            <b>OnMonthChange</b> reports the month the calendar navigated to however it got there (buttons, keyboard or
            a selection), <b>OnClear</b> follows the clear button, and <b>OnOpen</b>/<b>OnClose</b> bracket the callout.
        </div>
        <div class="example-content">
            <BitDateRangePicker Label="Watch the log" ShowClearButton
                                @bind-Value="eventsValue"
                                OnSelectDate="LogSelectDate"
                                OnChange="LogChange"
                                OnMonthChange="LogMonthChange"
                                OnClear="LogClear"
                                OnOpen="LogOpen"
                                OnClose="LogClose" />
        </div>
        <br />
        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => eventLog.Clear()">Clear log</BitButton>
        <br /><br />
        <div class="event-log">
            @foreach (var entry in eventLog)
            {
                <div>@entry</div>
            }
        </div>
    </DemoExample>

    <DemoExample Title="Culture" RazorCode="@example14RazorCode" Id="example14">
        <div class="example-desc">
            By default, BitDateRangePicker picks the current culture.
            But you can provide your own instance of CultureInfo for any custom culture.
            The whole calendar follows it: the calendar system (Gregorian, Persian, Hijri…), the month and day names,
            the first day of the week, the AM/PM designators and the text direction.
            <br />
            You also can use our
            <BitLink Href="https://github.com/bitfoundation/bitplatform/blob/develop/src/BlazorUI/Demo/Client/Bit.BlazorUI.Demo.Client.Core/Helpers/CultureInfoHelper.cs" Target="_blank">
                CultureInfoHelper
            </BitLink> class or check its code to see how to create a custom culture.
        </div>
        <br />
        <div class="example-content">
            <BitDateRangePicker Label="fa-IR culture with Farsi names"
                                GoToTodayTitle="برو به امروز"
                                ValueFormat="شروع: {0}, پایان: {1}"
                                Culture="CultureInfoHelper.GetFaIrCultureWithFarsiNames()" />
            <br /><br />
            <BitDateRangePicker Label="fa-IR culture with Fingilish names"
                                GoToTodayTitle="Boro be emrouz"
                                ValueFormat="Shoro: {0}, Payan: {1}"
                                Culture="CultureInfoHelper.GetFaIrCultureWithFingilishNames()" />
        </div>
    </DemoExample>

    <DemoExample Title="TimeZone" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
        <div class="example-desc">
            <b>TimeZone</b> specifies the time zone used to interpret and display the selected dates and times, so the
            offsets of the produced <b>DateTimeOffset</b> values belong to that zone instead of the local one.
            <br />
            Remember using this feature in different runtimes needs more investigations, for example,
            there are different data available based on the OS the code is running on or different settings
            enabled for the project (like InvariantTimezone in the project file,
            <BitLink Href="https://learn.microsoft.com/en-us/aspnet/core/blazor/globalization-localization?view=aspnetcore-9.0#timezone-information"
                     Target="_blank">more info</BitLink>).
        </div>
        <br />
        <div>Default (local TimeZone):</div><br />
        <div class="example-content">
            <BitDateRangePicker @bind-Value="@timeZoneDateRange1" ShowTimePicker />
        </div>
        <br />
        <div>Selected date range: from @(timeZoneDateRange1?.StartDate?.ToString() ?? "-") to @(timeZoneDateRange1?.EndDate?.ToString() ?? "-")</div>

        @{
            TimeZoneInfo? timeZoneInfo = null;
            var allTimeZones = TimeZoneInfo.GetSystemTimeZones();
            if (allTimeZones.Count > 0)
            {
                timeZoneInfo = allTimeZones[0];
            }
        }

        @if (timeZoneInfo is not null)
        {
            <br /><br /><br /><br />
            <div>"@timeZoneInfo.Id" TimeZone:</div><br />
            <div class="example-content">
                <BitDateRangePicker TimeZone="timeZoneInfo" @bind-Value="@timeZoneDateRange2" ShowTimePicker />
            </div>
            <br />
            <div>Selected date range: from @(timeZoneDateRange2?.StartDate?.ToString() ?? "-") to @(timeZoneDateRange2?.EndDate?.ToString() ?? "-")</div>
        }
    </DemoExample>

    <DemoExample Title="Standalone" RazorCode="@example16RazorCode" Id="example16">
        <div class="example-desc">
            <b>Standalone</b> renders the calendar inline instead of inside a callout, dropping the input and the overlay.
            It suits filter panels, dashboards and any layout where the calendar should always be visible; the value
            binding, the constraints and the time picker all behave exactly as they do in the drop-down mode.
        </div>
        <div class="example-content-standalone">
            <BitDateRangePicker Label="Basic DatePicker" Standalone />
            <br /><br />
            <BitDateRangePicker Label="Disabled" IsEnabled="false" Standalone />
            <br /><br />
            <BitDateRangePicker Label="Week numbers" ShowWeekNumbers Standalone />
            <br /><br />
            <BitDateRangePicker Label="Highlight months" HighlightCurrentMonth HighlightSelectedMonth Standalone />
            <br /><br />
            <BitDateRangePicker Label="TimePicker" ShowTimePicker Standalone />
        </div>
    </DemoExample>

    <DemoExample Title="ReadOnly" RazorCode="@example17RazorCode" CsharpCode="@example17CsharpCode" Id="example17">
