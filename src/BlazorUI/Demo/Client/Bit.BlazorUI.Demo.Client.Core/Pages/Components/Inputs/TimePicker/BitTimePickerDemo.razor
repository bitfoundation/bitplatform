@page "/components/timepicker"
@page "/components/time-picker"
@using Bit.BlazorUI.Demo.Client.Core.Helpers

<PageOutlet Url="components/timepicker"
            Title="TimePicker"
            Description="A BitTimePicker offers a drop-down control that's optimized for picking a single time value using hour and minute spin buttons, with optional seconds, 12/24-hour formats, culture-aware formatting, min/max limits, custom allowed-time rules, and full keyboard and screen reader support." />

<DemoPage Name="TimePicker"
          Description="A BitTimePicker offers a drop-down control that's optimized for picking a single time value using hour and minute spin buttons. The time it holds is a TimeSpan of the day, written and read in the format of the current culture, and every part of it can be set with the pointer or the keyboard alike. You can customize the picker to fit your scenario, for example by changing the time format, showing the seconds, stepping in intervals, limiting the selectable range or the exact values that can be picked, rendering it inline instead of in a callout, or letting users type the time directly."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          SubEnums="componentSubEnums"
          SubClasses="componentSubClasses"
          CssVariables="componentCssVariables"
          GitHubUrl="Inputs/TimePicker/BitTimePicker.razor"
          GitHubDemoUrl="Inputs/TimePicker/BitTimePickerDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
        <div>
            The states a picker can be in. <code>ReadOnly</code> keeps the value visible, focusable and posted with
            the form while refusing every change of it; <code>IsEnabled</code> set to <code>false</code> takes it out
            of the form and out of the tab order as well.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Basic TimePicker" />
            <br /><br />
            <BitTimePicker Label="Placeholder" Placeholder="Select a time..." />
            <br /><br />
            <BitTimePicker Label="Required" Required />
            <br /><br />
            <BitTimePicker Label="ReadOnly" ReadOnly @bind-Value="@readOnlyTime" />
            <br /><br />
            <BitTimePicker Label="Disabled" IsEnabled="false" @bind-Value="@readOnlyTime" />
        </div>
    </DemoExample>

    <DemoExample Title="Time format & seconds" RazorCode="@example2RazorCode" Id="example2">
        <div>
            <code>TimeFormat</code> switches between the 24-hour and the 12-hour clock, and <code>ShowSeconds</code>
            adds a third spin section. The value itself is always a time of day: half past five in the afternoon is
            17:30 whichever format shows it, and a picker without the seconds still carries the seconds of the value
            it was given - stepping the hour of 10:30:45 gives 11:30:45.
            <br /><br />
            In the 12-hour format the AM/PM buttons say which half of the day the time is in. Typing an hour keeps
            that half - typing 5 into an afternoon time means 17:00, not a silent jump to the morning - while the
            spin buttons move the time itself, so stepping past noon moves the AM/PM state with it.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker TimeFormat="BitTimeFormat.TwentyFourHours"
                           Placeholder="Select a time..."
                           Label="24 hours" />
            <br />
            <BitTimePicker TimeFormat="BitTimeFormat.TwelveHours"
                           Placeholder="Select a time..."
                           Label="12 hours (AM/PM)" />
            <br />
            <BitTimePicker ShowSeconds
                           Label="With seconds"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker ShowSeconds
                           TimeFormat="BitTimeFormat.TwelveHours"
                           Label="With seconds (AM/PM)"
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Text input" RazorCode="@example3RazorCode" Id="example3">
        <div class="example-desc">
            <code>AllowTextInput</code> lets the time be typed into the field. A typed time does not have to be
            written the way the picker writes one: the spellings of the culture are accepted in either clock format,
            with or without the seconds, so <b>2:05 PM</b> lands in a 24-hour picker as 14:05 and is rewritten in its
            own format. Anything that is not a time of day - or one the range and the allowed-value rules refuse - is
            reported by the form validation.
        </div>
        <div class="example-content">
            <BitTimePicker AllowTextInput Label="Start time" />
            <br />
            <BitTimePicker AllowTextInput
                           ShowSeconds
                           Label="Start time (with seconds)"
                           TimeFormat="BitTimeFormat.TwelveHours" />
        </div>
    </DemoExample>

    <DemoExample Title="Icon" RazorCode="@example4RazorCode" Id="example4">
        <div>
            <code>IconName</code> replaces the clock of the field and <code>IconLocation</code> moves it to either
            side. The icons inside the callout are customizable too: <code>IncreaseHourIconName</code>,
            <code>DecreaseHourIconName</code> and their minute and second counterparts replace the arrows of the spin
            buttons, and <code>CloseButtonIconName</code> the icon of the close button. Each has an <code>Icon</code>
            twin (<code>IncreaseHourIcon</code>, …) taking the CSS classes of an external icon library instead.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker IconName="@BitIconName.HourGlass" Placeholder="Select a time..." />
            <br />
            <BitTimePicker IconName="@BitIconName.HourGlass"
                           IconLocation="BitIconLocation.Left"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker Label="Custom spin & close icons"
                           ShowCloseButton
                           IncreaseHourIconName="@BitIconName.CaretSolidUp"
                           DecreaseHourIconName="@BitIconName.CaretSolidDown"
                           IncreaseMinuteIconName="@BitIconName.CaretSolidUp"
                           DecreaseMinuteIconName="@BitIconName.CaretSolidDown"
                           CloseButtonIconName="@BitIconName.ChromeClose"
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Formatting & culture" RazorCode="@example5RazorCode" Id="example5">
        <div class="example-desc">
            Left alone, the picker writes and reads a time the way its culture does: the pattern of the culture,
            rewritten into the clock format of the picker and extended with the seconds when
            <code>ShowSeconds</code> is set, with every part padded so the field spells the time the same way the
            two-digit inputs do. <code>Culture</code> takes any <code>CultureInfo</code>, which also supplies the
            AM/PM designators and - for a culture that reads right to left - the direction of the layout, without an
            explicit <code>Dir</code>. See the
            <BitLink Href="https://github.com/bitfoundation/bitplatform/blob/develop/src/BlazorUI/Demo/Client/Bit.BlazorUI.Demo.Client.Core/Helpers/CultureInfoHelper.cs" Target="_blank">
                CultureInfoHelper
            </BitLink> class for the Farsi culture used below.
            <br /><br />
            <code>ValueFormat</code> replaces that with a pattern of standard .NET time format specifiers, which is
            then the only spelling a typed time may use as well: an application asking for a format of its own gets
            it taken literally, in both directions.
        </div>
        <div class="example-content">
            <BitTimePicker Label="ValueFormat (hh-mm.ss)" Placeholder="Select a time..." ValueFormat="hh-mm.ss" />
            <br />
            <BitTimePicker Label="فارسی"
                           TimeFormat="BitTimeFormat.TwelveHours"
                           Culture="CultureInfoHelper.GetFaIrCultureWithFarsiNames()"
                           Placeholder="یک زمان انتخاب کنید..." />
        </div>
    </DemoExample>

    <DemoExample Title="Binding" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
        <div>
            <code>@@bind-Value</code> two-way binds the selected time to a <code>TimeSpan?</code>. The value is a time
            of day, so a span of a day or more - or a negative one - is read as the time of day it lands on. A
            one-way bound <code>Value</code> paired with <code>OnChange</code> keeps the value under the control of
            the application.
            <br /><br />
            Two parameters seed a picker, and they are not the same thing: <code>DefaultValue</code> is a value, so
            the picker starts out holding it and showing it; <code>StartingValue</code> is only where the first
            change lands, so the picker stays empty and its inputs stay blank until something is picked - stepping
            the hour of the third picker below selects 10:30 rather than 01:00.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker @bind-Value="@selectedTime" Label="@@bind-Value" Placeholder="Select a time..." />
            <div>Selected time: @selectedTime.ToString()</div>
            <br /><br />
            <BitTimePicker DefaultValue="new(8, 15, 0)" Label="DefaultValue (08:15)" />
            <br /><br />
            <BitTimePicker Label="StartingValue (09:30), still empty"
                           StartingValue="new(9, 30, 0)"
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Standalone" RazorCode="@example7RazorCode" Id="example7">
        <div>
            <code>Standalone</code> renders the time picking part inline, without the field and the callout. It still
            carries its value in a hidden input, so it posts and validates in a form like any other input - and since
            it is part of the page rather than a popup over it, it is not announced as a dialog, its label points at
            the hour input, and that is where the focus lands.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Standalone Label="Standalone picker" />
            <br />
            <BitTimePicker Standalone
                           Label="Picker (AM/PM)"
                           TimeFormat="BitTimeFormat.TwelveHours" />
            <br />
            <BitTimePicker Standalone
                           ReadOnly
                           Label="ReadOnly"
                           Value="new(10, 24, 0)"
                           TimeFormat="BitTimeFormat.TwelveHours" />
        </div>
    </DemoExample>

    <DemoExample Title="Selectable range" RazorCode="@example8RazorCode" Id="example8">
        <div>
            <code>MinTime</code> and <code>MaxTime</code> bound the selectable range: the spin buttons clamp into it,
            and a typed time outside it is rejected with the <code>OutOfRangeErrorMessage</code> text. The
            <code>AllowedHours</code>, <code>AllowedMinutes</code> and <code>AllowedSeconds</code> predicates add an
            arbitrary rule on top - the spin buttons skip what they reject, a typed number snaps to the nearest
            accepted one, and a time entered as text that lands on a rejected value is reported with the
            <code>DisallowedTimeErrorMessage</code> text. Both bounds are times of day, so one outside of a day is
            pulled back into one, and where a bound and a predicate disagree the bound wins.
            <br /><br />
            <code>DisablePast</code> and <code>DisableFuture</code> add the current time as a bound of their own,
            taken to the precision the picker shows so the minute that is running can still be picked. Where they
            overlap with <code>MinTime</code> and <code>MaxTime</code>, the narrower of the two wins.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Working hours (09:00 to 17:00)"
                           MinTime="new(9, 0, 0)"
                           MaxTime="new(17, 0, 0)"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker Label="Even hours, on the quarter"
                           AllowedHours="@(h => h % 2 == 0)"
                           AllowedMinutes="@(m => m % 15 == 0)"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker Label="Later today only (DisablePast)"
                           DisablePast
                           ShowNowButton
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker Label="Earlier today only (DisableFuture)"
                           DisableFuture
                           ShowNowButton
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Steps" RazorCode="@example9RazorCode" Id="example9">
        <div>
            <code>HourStep</code>, <code>MinuteStep</code> and <code>SecondStep</code> lay a grid over their range
            that every value the controls produce sits on - the spin buttons, <b>PageUp</b> and <b>PageDown</b>, and
            the now button all land on it. The grid starts at the matching part of <code>MinTime</code>, and at the
            top of the range where there is none, so a picker whose range begins at 09:07 can still be set to 09:07.
            A value that arrives off the grid is kept and shown as it is; the first press of a spin button then moves
            it onto the nearest grid point in the direction it was pressed. A typed time is not held to the grid -
            a step is the granularity the controls move in, not a validation rule.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker HourStep="2"
                           Label="HourStep = 2"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker MinuteStep="15"
                           Label="MinuteStep = 15"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker ShowSeconds
                           SecondStep="30"
                           Label="SecondStep = 30"
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Action buttons" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
        <div>
            The callout can carry action buttons: <code>ShowNowButton</code> selects the current time of day - the
            time the picker itself could have stepped to, snapped to the steps and the allowed values and pulled into
            the bounds - <code>ShowClearButton</code> clears the value (disabled while there is nothing to clear, and
            reported by <code>OnClear</code>), and <code>ShowCloseButton</code> adds a dismiss button in its corner.
            <code>NowButtonText</code>, <code>ClearButtonText</code> and <code>CloseButtonTitle</code> caption them.
            <br /><br />
            <code>ShowInputClearButton</code> puts the same clear action in the field itself, where it appears only
            once a time is selected and can be reached without opening the callout first.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker @bind-Value="@actionsTime"
                           ShowNowButton
                           ShowClearButton
                           Label="Now & Clear buttons"
                           Placeholder="Select a time..." />
            <div>Selected time: @actionsTime.ToString()</div>
            <br /><br />
            <BitTimePicker ShowInputClearButton
                           ShowCloseButton
                           Label="Clear button in the field"
                           DefaultValue="new(14, 30, 0)"
                           CloseButtonTitle="Dismiss the picker" />
            <br /><br />
            <BitTimePicker Standalone
                           ShowNowButton
                           ShowClearButton
                           NowButtonText="Current time"
                           ClearButtonText="Reset"
                           Label="Custom button texts" />
        </div>
    </DemoExample>

    <DemoExample Title="Validation & helper text" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
        <div>
            <code>Description</code> renders helper text under the field and ties it to the input through
            <code>aria-describedby</code>, so a screen reader reads it along with the picker.
            <code>ErrorMessage</code> renders text in its place and marks the picker invalid; <code>Invalid</code>
            marks it invalid on its own, for a rejection the application decided about (a server response, a rule
            spanning two fields) that no <code>EditContext</code> knows of.
            <br /><br />
            Inside an <code>EditForm</code> the picker validates with the data annotations of its model. Each of the
            three ways a typed time can be refused carries its own message: <code>InvalidErrorMessage</code> for text
            that is not a time at all, <code>OutOfRangeErrorMessage</code> for one outside the bounds, and
            <code>DisallowedTimeErrorMessage</code> for one the predicates reject - each falling back to a message
            naming the field.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Meeting time"
                           Description="Rounded to the nearest quarter hour."
                           Placeholder="Select a time..." />
            <br /><br />
            <BitTimePicker Label="Handover time"
                           ErrorMessage="That slot was taken while you were choosing."
                           DefaultValue="new(9, 0, 0)" />
        </div>
        <br /><br />
        <EditForm Model="formValidationTimePickerModel" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <div class="validation-summary">
                <ValidationSummary />
            </div>
            <div class="example-content">
                <BitTimePicker @bind-Value="formValidationTimePickerModel.Time"
                               AllowTextInput
                               Label="Time required"
                               Description="Between 08:00 and 18:00, on the quarter hour."
                               Placeholder="Select a time..."
                               MinTime="new(8, 0, 0)"
                               MaxTime="new(18, 0, 0)"
                               AllowedMinutes="@(m => m % 15 == 0)"
                               InvalidErrorMessage="Invalid Time!"
                               OutOfRangeErrorMessage="The time must be between 08:00 and 18:00!"
                               DisallowedTimeErrorMessage="Only quarter hours can be booked!" />
                <ValidationMessage For="@(() => formValidationTimePickerModel.Time)" />
            </div>
            <br />
            <BitButton ButtonType="BitButtonType.Submit">
                Submit
            </BitButton>
        </EditForm>

        @if (string.IsNullOrEmpty(successMessage) is false)
        {
            <br />
            <BitMessage Color="BitColor.Success">@successMessage</BitMessage>
        }
    </DemoExample>

    <DemoExample Title="Appearance" RazorCode="@example12RazorCode" Id="example12">
        <div>
            <code>Underlined</code> trades the box of the field for a single rule under it, and <code>HasBorder</code>
            set to <code>false</code> takes the box away altogether - for a picker sitting inside a container of its
            own. <code>DropDirection</code> decides where the callout may open: <code>TopAndBottom</code> keeps it
            above or below the field, <code>All</code> lets it take whichever side has the room.
            <br /><br />
            <code>Responsive</code> turns the callout into a full-width panel that slides down from the top of small
            screens and can be dismissed by swiping it up. <code>ShowCloseButton</code> pairs well with it, giving
            the panel an obvious way out.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Underlined" Underlined Placeholder="Select a time..." />
            <br />
            <BitTimePicker Label="No border" HasBorder="false" Placeholder="Select a time..." />
            <br />
            <BitTimePicker Label="DropDirection (All)"
                           DropDirection="BitDropDirection.All"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker Label="Responsive (narrow the window)"
                           Responsive
                           ShowCloseButton
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Keyboard & accessibility" RazorCode="@example13RazorCode" Id="example13">
        <div>
            The whole time can be set without leaving the keyboard, and every part of the picker carries a label a
            screen reader can announce:
        </div>
        <br />
        <ul>
            <li><b>Enter</b>, <b>Space</b> or <b>&darr;</b> on the field opens the picker (an editable field keeps
                <b>Enter</b> and <b>Space</b> for typing and opens with <b>&darr;</b> only); <b>Esc</b> or
                <b>Alt</b>+<b>&uarr;</b> closes it and puts the focus back on the field, while <b>Tab</b> closes it
                and carries on to the next control.</li>
            <li>Unless the field is editable, opening the picker moves the focus onto the hour input, and <b>Tab</b>
                moves on between the time inputs, the AM/PM pair, and the action buttons.</li>
            <li><b>&uarr;</b> / <b>&darr;</b> on a time input change it by one, and a number typed into it snaps to
                the nearest selectable value.</li>
            <li><b>PageUp</b> / <b>PageDown</b> make the same move the spin buttons make - by the step of the picker,
                wrapping around the clock and skipping over what the allowed-value predicates reject.</li>
            <li><b>Home</b> / <b>End</b> jump to the first and the last value the input can be set to (the ends of
                the current half of the day for the hour of a 12-hour picker), and <b>Enter</b> takes the time that
                is on the inputs, closes the picker and puts the focus back on the field.</li>
            <li>In the 12-hour format, the first letter of either designator of the culture (<b>a</b> and <b>p</b> in
                English) sets the half of the day from any of the time inputs.</li>
        </ul>
        <br />
        <div>
            <code>CalloutAriaLabel</code> names the popup, which is a modal dialog while it floats over the page and
            plain page content when the picker is standalone; <code>HourInputAriaLabel</code>,
            <code>MinuteInputAriaLabel</code> and <code>SecondInputAriaLabel</code> name the time inputs; the
            <code>IncreaseHourTitle</code>-style parameters caption the spin buttons for the tooltip and the screen
            reader alike; and the AM/PM buttons report their state through <code>aria-pressed</code>. The selected
            time is announced as a whole by a live region whenever any part of it changes, so the buttons that set
            all of it at once - now, clear, AM/PM - never change it silently. <code>AriaDescription</code> carries an
            instruction for a screen reader alone, and <code>AutoFocus</code> puts the focus on the field as soon as
            the picker renders.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Try it with the keyboard"
                           TimeFormat="BitTimeFormat.TwelveHours"
                           CalloutAriaLabel="Pick a meeting time"
                           HourInputAriaLabel="Meeting hour"
                           MinuteInputAriaLabel="Meeting minute"
                           IncreaseHourTitle="One hour later"
                           DecreaseHourTitle="One hour earlier"
                           IncreaseMinuteTitle="One minute later"
                           DecreaseMinuteTitle="One minute earlier"
                           AriaDescription="Press A or P to switch between morning and afternoon."
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Events" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
        <div>
            <code>OnSelectTime</code> fires for every change made with the picker, <code>OnChange</code> for every
            change of the bound value, <code>OnClear</code> for either clear button, <code>OnOpen</code> and
            <code>OnClose</code> follow the callout, and <code>OnClick</code>, <code>OnFocusIn</code> and
            <code>OnFocusOut</code> follow the field.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Watch the log"
                           ShowClearButton
                           Placeholder="Select a time..."
                           OnOpen="LogOpen"
                           OnClose="LogClose"
                           OnClick="LogClick"
                           OnClear="LogClear"
                           OnFocusIn="LogFocusIn"
                           OnFocusOut="LogFocusOut"
                           OnSelectTime="LogSelectTime"
                           OnChange="LogChange" />
        </div>
        <br />
        <div class="event-log">
            @foreach (var log in eventLogs)
            {
                <div>@log</div>
            }
        </div>
    </DemoExample>

    <DemoExample Title="Programmatic control" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
        <div>
            Two-way bind <code>IsOpen</code> to drive the callout from the code, or call <code>OpenCallout</code> and
            <code>DismissCallout</code> on a reference to the component - the first opens it exactly as clicking the
            field would (moving the focus onto the hour input), the second closes it and leaves the focus wherever it
            is. <code>OnOpen</code> and <code>OnClose</code> report every change of the state, whichever side asked
            for it.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker @ref="programmaticPicker" @bind-IsOpen="isCalloutOpen" Label="Controlled callout" />
            <br />
            <div>IsOpen: @isCalloutOpen</div>
            <br />
            <BitButton OnClick="() => programmaticPicker!.OpenCallout()">
                OpenCallout()
            </BitButton>
            <br />
            <BitButton Variant="BitVariant.Outline" OnClick="() => programmaticPicker!.DismissCallout()">
                DismissCallout()
            </BitButton>
        </div>
    </DemoExample>

    <DemoExample Title="Templates" RazorCode="@example16RazorCode" CsharpCode="@example16CsharpCode" Id="example16">
        <div>
            <code>LabelTemplate</code> replaces the label with any content (here an action button calling the public
            <code>OpenCallout</code> method), <code>IconTemplate</code> the icon of the field,
            <code>DescriptionTemplate</code> the helper text, and <code>CalloutHeaderTemplate</code> and
            <code>CalloutFooterTemplate</code> add content above and below the time inputs - a title, a hint, or
            preset buttons that set the value from the code.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker @ref="timePicker" Placeholder="Select a time...">
                <LabelTemplate>
                    Custom label <BitButton Variant="BitVariant.Text" IconName="@BitIconName.AlarmClock" OnClick="OpenCallout"></BitButton>
                </LabelTemplate>
            </BitTimePicker>
            <br /><br />
            <BitTimePicker Label="Custom icon" Placeholder="Select a time...">
                <IconTemplate>
                    <img src="https://img.icons8.com/fluency/2x/clock.png" width="24" height="24" />
                </IconTemplate>
            </BitTimePicker>
            <br /><br />
            <BitTimePicker @bind-Value="@templateTime" Label="Callout header & footer" Placeholder="Select a time...">
                <CalloutHeaderTemplate>
                    <div class="callout-header">Pick a meeting time</div>
                </CalloutHeaderTemplate>
                <CalloutFooterTemplate>
                    <div class="callout-footer">
                        <BitButton Size="BitSize.Small" Variant="BitVariant.Text" OnClick="() => templateTime = new(9, 0, 0)">09:00</BitButton>
                        <BitButton Size="BitSize.Small" Variant="BitVariant.Text" OnClick="() => templateTime = new(13, 30, 0)">13:30</BitButton>
                        <BitButton Size="BitSize.Small" Variant="BitVariant.Text" OnClick="() => templateTime = new(17, 45, 0)">17:45</BitButton>
                    </div>
                </CalloutFooterTemplate>
            </BitTimePicker>
        </div>
    </DemoExample>

    <DemoExample Title="CSS variables" RazorCode="@example17RazorCode" Id="example17">
        <div>
            Every public <code>--bit-TimePicker-*</code> property is read off the root with a fallback and never
            declared by the component, so it inherits: set one on <code>:root</code> to re-skin every picker of the
            app, or on the <code>Style</code> of an instance to re-skin that one alone. Since the callout is moved to
            the end of the document while it is open, the component carries the declarations of <code>Style</code>
            and <code>Styles.Root</code> across to it by hand - one <code>Style</code> restyles the field and the
            popup it opens together, while a value set on an ancestor other than <code>:root</code> reaches the field
            only. The full list is in the <b>CSS variables</b> table at the bottom of this page.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Rounder, roomier, teal"
                           TimeFormat="BitTimeFormat.TwelveHours"
                           ShowNowButton
                           ShowClearButton
                           DefaultValue="new(9, 45, 0)"
                           Style="--bit-TimePicker-color: teal;
                                  --bit-TimePicker-radius: 2rem;
                                  --bit-TimePicker-height: 3rem;
                                  --bit-TimePicker-padding: 1rem;
                                  --bit-TimePicker-border-color: teal;
                                  --bit-TimePicker-icon-color: teal;
                                  --bit-TimePicker-callout-radius: 1.5rem;
                                  --bit-TimePicker-callout-padding: 1.5rem;
                                  --bit-TimePicker-cell-radius: 50%;" />
            <br /><br />
            <BitTimePicker Label="Dense: smaller cells, tighter popup"
                           Standalone
                           ShowSeconds
                           Style="--bit-TimePicker-cell-size: 1.5rem;
                                  --bit-TimePicker-cell-font-size: 0.875rem;
                                  --bit-TimePicker-gap: 0.125rem;
                                  --bit-TimePicker-callout-padding: 0.5rem;
                                  --bit-TimePicker-separator-font-size: 1rem;" />
        </div>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example18RazorCode" CsharpCode="@example18CsharpCode" Id="example18">
        <div>
            <b>BitParams</b> carries a <b>BitTimePickerParams</b> down to every TimePicker under it, so a form, a
            panel or a whole page sets the shared configuration once instead of on every picker. What it carries is a
            default and not an override: a picker that writes a parameter for itself keeps its own value, and only
            what it left unset is filled in from the cascade. Each parameter is filled in on its own, so a picker can
            take its <b>TimeFormat</b> from the cascade and its <b>MinuteStep</b> from its own markup. What stays on
            the instance is what belongs to one field alone - its value and the callbacks reporting a change of it,
            the open state of its callout, and the rejection it is currently showing.
        </div>
        <br />
        <div class="example-content">
            <BitParams Parameters="@timePickerParams">
                <BitTimePicker Label="Takes the format, the step and the buttons from the cascade" />
                <br />
                <BitTimePicker Label="So does this one, without repeating any of it" />
                <br />
                <BitTimePicker Label="Its own MinuteStep, the cascaded rest" MinuteStep="1" />
            </BitParams>
        </div>
    </DemoExample>

