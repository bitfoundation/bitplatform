@page "/components/timepicker"
@page "/components/time-picker"
@using Bit.BlazorUI.Demo.Client.Core.Helpers

<PageOutlet Url="components/timepicker"
            Title="TimePicker"
            Description="A BitTimePicker offers a drop-down control that's optimized for picking a single time value using hour and minute spin buttons, with optional seconds, 12/24-hour formats, min/max limits, and custom allowed-time rules." />

<DemoPage Name="TimePicker"
          Description="A BitTimePicker offers a drop-down control that's optimized for picking a single time value using hour and minute spin buttons. You can customize the time picker to fit your scenario, for example by changing the time format, showing the seconds, limiting the selectable time range or the exact values that can be picked, or letting users type the time directly."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          SubEnums="componentSubEnums"
          SubClasses="componentSubClasses"
          GitHubUrl="Inputs/TimePicker/BitTimePicker.razor"
          GitHubDemoUrl="Inputs/TimePicker/BitTimePickerDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>
            Explore the basic states of the BitTimePicker component: a simple picker, a disabled one, a required one that
            renders the required indicator next to its label, and one showing a placeholder text until a time gets selected.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Basic TimePicker" />
            <br /><br />
            <BitTimePicker Label="Disabled" IsEnabled="false" />
            <br /><br />
            <BitTimePicker Label="Required" Required />
            <br /><br />
            <BitTimePicker Label="Placeholder" Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Time format" RazorCode="@example2RazorCode" Id="example2">
        <div>
            The BitTimePicker supports both the 12-hour and the 24-hour time formats using the <code>TimeFormat</code> parameter.
            In the 12-hour format, AM/PM buttons appear in the callout and the displayed value uses the AM/PM designators of the current culture.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker TimeFormat="BitTimeFormat.TwelveHours"
                           Placeholder="Select a time..."
                           Label="12 hours (AM/PM)" />
            <br />
            <BitTimePicker TimeFormat="BitTimeFormat.TwentyFourHours"
                           Placeholder="Select a time..."
                           Label="24 hours" />
        </div>
    </DemoExample>

    <DemoExample Title="Seconds" RazorCode="@example3RazorCode" Id="example3">
        <div>
            Enable the <code>ShowSeconds</code> parameter to add a third spin section for picking the seconds.
            The displayed value format automatically extends to include the seconds part in both 12 and 24-hour formats.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker ShowSeconds
                           Label="Seconds enabled"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker ShowSeconds
                           TimeFormat="BitTimeFormat.TwelveHours"
                           Label="Seconds (AM/PM)"
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Text input" RazorCode="@example4RazorCode" Id="example4">
        <div class="example-desc">
            Enabling <code>AllowTextInput</code> lets users type the time directly into the input field.
            Clicking the input field opens the BitTimePicker callout, and clicking it again dismisses the callout and
            allows text input. Please note that when using this feature, the entered time must match the exact
            format of the BitTimePicker (<code>TimeFormat</code> or the custom <code>ValueFormat</code>), otherwise the value
            is considered invalid and the form validation reports it.
        </div>
        <div class="example-content">
            <BitTimePicker AllowTextInput Label="Start time" />
        </div>
    </DemoExample>

    <DemoExample Title="Icon" RazorCode="@example5RazorCode" Id="example5">
        <div>
            Customize the icon of the BitTimePicker using the <code>IconName</code> parameter,
            and place it on either side of the input using the <code>IconLocation</code> parameter.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker IconName="@BitIconName.HourGlass" Placeholder="Select a time..." />
            <br />
            <BitTimePicker IconName="@BitIconName.HourGlass"
                           IconLocation="BitIconLocation.Left"
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Formatting" RazorCode="@example6RazorCode" Id="example6">
        <div class="example-desc">
            Applications can customize how times are formatted and parsed using the <code>ValueFormat</code> parameter with
            standard .NET time format specifiers. Formatted times can be ambiguous, so the control avoids parsing the formatted
            strings of times selected using the UI when text input is allowed.
            In this example, the time is formatted and parsed as hh-mm.ss.
        </div>
        <div class="example-content">
            <BitTimePicker Placeholder="Select a time..." ValueFormat="hh-mm.ss" />
        </div>
    </DemoExample>

    <DemoExample Title="Binding" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
        <div>
            Two-way bind the selected time of the BitTimePicker to a <code>TimeSpan?</code> variable using <code>@@bind-Value</code>.
            The open state of the callout can also be controlled from code by two-way binding the <code>IsOpen</code> parameter.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker @bind-Value="@selectedTime" Placeholder="Select a time..." />
            <div>Selected time: @selectedTime.ToString()</div>
            <br /><br />
            <BitTimePicker @bind-IsOpen="isOpen" @bind-Value="@boundTime" Placeholder="Select a time..." />
            <br />
            <BitButton OnClick="() => isOpen = true">Open TimePicker</BitButton>
        </div>
    </DemoExample>

    <DemoExample Title="Culture" RazorCode="@example8RazorCode" Id="example8">
        <div class="example-desc">
            By default, the BitTimePicker picks the current culture to format and parse the time value and to render the AM/PM designators.
            The <code>Culture</code> parameter accepts any custom <code>CultureInfo</code> instance to change that. In this example a
            customized Farsi culture (see the
            <BitLink Href="https://github.com/bitfoundation/bitplatform/blob/develop/src/BlazorUI/Demo/Client/Bit.BlazorUI.Demo.Client.Core/Helpers/CultureInfoHelper.cs" Target="_blank">
                CultureInfoHelper
            </BitLink> class) renders the localized AM/PM designators.
        </div>
        <div class="example-content">
            <BitTimePicker Label="فارسی"
                           Dir="BitDir.Rtl"
                           TimeFormat="BitTimeFormat.TwelveHours"
                           Culture="CultureInfoHelper.GetFaIrCultureWithFarsiNames()"
                           Placeholder="یک زمان انتخاب کنید..." />
        </div>
    </DemoExample>

    <DemoExample Title="Standalone" RazorCode="@example9RazorCode" Id="example9">
        <div>
            The <code>Standalone</code> parameter renders the time picking part of the BitTimePicker inline, without the input field
            and the callout. It still carries its value in a hidden input, so it posts and validates in a form like any other input component.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Standalone Label="Standalone picker" />
            <br />
            <BitTimePicker Standalone
                           Label="Picker (AM/PM)"
                           TimeFormat="BitTimeFormat.TwelveHours" />
            <br />
            <BitTimePicker Standalone
                           Label="Disabled"
                           IsEnabled="false"
                           Value="new(10, 24, 0)"
                           TimeFormat="BitTimeFormat.TwelveHours" />
        </div>
    </DemoExample>

    <DemoExample Title="ReadOnly" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
        <div>
            The <code>ReadOnly</code> parameter makes the time picker non-editable: the value stays visible and focusable,
            but the spin buttons, the AM/PM buttons, and the text input reject any change of it.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Basic" ReadOnly @bind-Value="@readOnlyTime" />
            <br /><br />
            <BitTimePicker Label="Text input allowed" ReadOnly AllowTextInput @bind-Value="@readOnlyTime" />
        </div>
        <br /><br />
        <div class="example-content">
            <BitTimePicker Label="Standalone" Standalone ReadOnly @bind-Value="@readOnlyTime" />
            <br /><br />
            <BitTimePicker Label="Standalone TimeFormat (AM/PM)" Standalone ReadOnly TimeFormat="BitTimeFormat.TwelveHours" @bind-Value="@readOnlyTime" />
        </div>
    </DemoExample>

    <DemoExample Title="Selectable range" RazorCode="@example11RazorCode" Id="example11">
        <div>
            Limit the selectable time range using the <code>MinTime</code> and <code>MaxTime</code> parameters:
            stepping with the spin buttons clamps the value into the range, and a typed time outside of it is
            rejected as an invalid value. The <code>AllowedHours</code>, <code>AllowedMinutes</code>, and
            <code>AllowedSeconds</code> predicates add an arbitrary rule on top of that: the spin buttons skip
            over the values they reject, a number typed into a time input snaps to the nearest accepted one, and
            a time entered as text that lands on a rejected value fails validation.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Working hours (09:00 to 17:00)"
                           MinTime="new(9, 0, 0)"
                           MaxTime="new(17, 0, 0)"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker Label="Morning only (until 11:59)"
                           MaxTime="new(11, 59, 0)"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker Label="Even hours, on the quarter"
                           AllowedHours="@(h => h % 2 == 0)"
                           AllowedMinutes="@(m => m % 15 == 0)"
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Steps" RazorCode="@example12RazorCode" Id="example12">
        <div>
            Customize the hour, minute, and second steps of the BitTimePicker using the <code>HourStep</code>, <code>MinuteStep</code>,
            and <code>SecondStep</code> parameters, letting users increment or decrement the time parts by a specified interval
            using the spin buttons. The now button snaps the current time to these steps as well, while a typed time is
            only checked against the bounds - a step is the granularity the spin buttons move in, not a validation rule.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker HourStep="2"
                           Label="HourStep = 2"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker MinuteStep="15"
                           Label="MinuteStep = 15"
                           Placeholder="Select a time..." />
            <br />
            <BitTimePicker ShowSeconds
                           SecondStep="30"
                           Label="SecondStep = 30"
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Action buttons" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
        <div>
            The BitTimePicker can render action buttons in its callout: <code>ShowNowButton</code> adds a button that selects the
            current time of day (snapped to the steps and to the allowed values), <code>ShowClearButton</code> adds a button that
            clears the selected value, and <code>ShowCloseButton</code> adds a dismiss button in the corner of the callout.
            Their captions can be customized using the <code>NowButtonText</code>, <code>ClearButtonText</code>, and
            <code>CloseButtonTitle</code> parameters.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker @bind-Value="@actionsTime"
                           ShowNowButton
                           ShowClearButton
                           Label="Now & Clear buttons"
                           Placeholder="Select a time..." />
            <div>Selected time: @actionsTime.ToString()</div>
            <br /><br />
            <BitTimePicker ShowCloseButton
                           Label="Close button"
                           CloseButtonTitle="Dismiss the picker"
                           Placeholder="Select a time..." />
            <br /><br />
            <BitTimePicker Standalone
                           ShowNowButton
                           ShowClearButton
                           NowButtonText="Current time"
                           ClearButtonText="Reset"
                           Label="Custom button texts" />
        </div>
    </DemoExample>

    <DemoExample Title="Appearance" RazorCode="@example14RazorCode" Id="example14">
        <div>
            <code>Underlined</code> trades the box of the input field for a single rule under it, and <code>HasBorder</code>
            set to <code>false</code> takes the box away altogether - for a picker that sits inside a container of its own.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Underlined" Underlined Placeholder="Select a time..." />
            <br />
            <BitTimePicker Label="No border" HasBorder="false" Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Validation" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
        <div>
            The BitTimePicker integrates with the Blazor <code>EditForm</code> and its data annotations validation.
            Validation happens when the <code>Submit</code> button is clicked, and also whenever an entered text fails to parse
            as a valid time, in which case the <code>InvalidErrorMessage</code> text gets reported.
        </div>
        <br />
        <EditForm Model="formValidationTimePickerModel" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <div class="validation-summary">
                <ValidationSummary />
            </div>
            <div class="example-content">
                <BitTimePicker @bind-Value="formValidationTimePickerModel.Time"
                               AllowTextInput
                               Label="Time required"
                               AriaLabel="Select a time"
                               Placeholder="Select a time..."
                               InvalidErrorMessage="Invalid Time!" />
                <ValidationMessage For="@(() => formValidationTimePickerModel.Time)" />
            </div>
            <br />
            <BitButton ButtonType="BitButtonType.Submit">
                Submit
            </BitButton>
        </EditForm>

        @if (string.IsNullOrEmpty(successMessage) is false)
        {
            <br />
            <BitMessage Color="BitColor.Success">@successMessage</BitMessage>
        }
    </DemoExample>

    <DemoExample Title="Responsive" RazorCode="@example16RazorCode" Id="example16">
        <div>
            Enable the <code>Responsive</code> parameter to adjust the callout's layout for small screens: it turns into a full-width
            panel sliding down from the top of the screen that can also be dismissed by swiping it up.
            The <code>ShowCloseButton</code> parameter pairs well with this mode, giving the panel an obvious way out.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Responsive
                           ShowCloseButton
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Keyboard & accessibility" RazorCode="@example17RazorCode" Id="example17">
        <div>
            The whole time can be set without leaving the keyboard, and every part of the picker carries a label a
            screen reader can announce:
        </div>
        <br />
        <ul>
            <li><b>Enter</b>, <b>Space</b> or <b>&darr;</b> on the field opens the picker (an editable field keeps
                <b>Enter</b> and <b>Space</b> for typing and opens with <b>&darr;</b> only); <b>Esc</b> or
                <b>Alt</b>+<b>&uarr;</b> closes it and puts the focus back on the field, while <b>Tab</b> closes it
                and carries on to the next control.</li>
            <li>Unless the field is editable, opening the picker moves the focus onto the hour input, and <b>Tab</b>
                moves on between the time inputs, the AM/PM pair, and the action buttons.</li>
            <li><b>&uarr;</b> / <b>&darr;</b> on a time input change it by its step, and a number typed into it snaps
                to the nearest selectable value.</li>
            <li><b>Esc</b> anywhere inside the picker closes it and hands the focus back to the field.</li>
        </ul>
        <br />
        <div>
            <code>CalloutAriaLabel</code> names the popup dialog; <code>HourInputAriaLabel</code>,
            <code>MinuteInputAriaLabel</code>, and <code>SecondInputAriaLabel</code> name the time inputs; the
            <code>IncreaseHourTitle</code>-style parameters caption the spin buttons for the tooltip and the screen
            reader alike; and the AM/PM buttons report their state via <code>aria-pressed</code>.
            <code>AutoFocus</code> puts the focus on the field as soon as the picker renders.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Try it with the keyboard"
                           CalloutAriaLabel="Pick a meeting time"
                           HourInputAriaLabel="Meeting hour"
                           MinuteInputAriaLabel="Meeting minute"
                           IncreaseHourTitle="One hour later"
                           DecreaseHourTitle="One hour earlier"
                           IncreaseMinuteTitle="One minute later"
                           DecreaseMinuteTitle="One minute earlier"
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Events" RazorCode="@example18RazorCode" CsharpCode="@example18CsharpCode" Id="example18">
        <div>
            <code>OnSelectTime</code> fires for every change made with the picker, <code>OnChange</code> for every
            change of the bound value, <code>OnOpen</code> and <code>OnClose</code> follow the callout, and
            <code>OnClick</code>, <code>OnFocusIn</code>, and <code>OnFocusOut</code> follow the input field.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker Label="Watch the log"
                           ShowClearButton
                           Placeholder="Select a time..."
                           OnOpen="LogOpen"
                           OnClose="LogClose"
                           OnClick="LogClick"
                           OnFocusIn="LogFocusIn"
                           OnFocusOut="LogFocusOut"
                           OnSelectTime="LogSelectTime"
                           OnChange="LogChange" />
        </div>
        <br />
        <div class="event-log">
            @foreach (var log in eventLogs)
            {
                <div>@log</div>
            }
        </div>
    </DemoExample>

    <DemoExample Title="Templates" RazorCode="@example19RazorCode" CsharpCode="@example19CsharpCode" Id="example19">
        <div>
            Customize parts of the BitTimePicker using templates: the <code>LabelTemplate</code> replaces the label with any custom
            content (here with an action button that opens the callout using the public <code>OpenCallout</code> method),
            and the <code>IconTemplate</code> replaces the default icon of the input field.
        </div>
        <br />
        <div class="example-content">
            <BitTimePicker @ref="timePicker" Placeholder="Select a time...">
                <LabelTemplate>
                    Custom label <BitButton Variant="BitVariant.Text" IconName="@BitIconName.AlarmClock" OnClick="OpenCallout"></BitButton>
                </LabelTemplate>
            </BitTimePicker>
            <br /><br />
            <BitTimePicker Label="Custom icon" Placeholder="Select a time...">
                <IconTemplate>
                    <img src="https://img.icons8.com/fluency/2x/clock.png" width="24" height="24" />
                </IconTemplate>
            </BitTimePicker>
        </div>
    </DemoExample>

    <DemoExample Title="External Icons" RazorCode="@example20RazorCode" Id="example20">
        <div>Use icons from external libraries like FontAwesome, Material Icons, and Bootstrap Icons with the <b>Icon</b> parameter.</div>

        <br />
        <br />

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />

        <div>FontAwesome:</div>
        <br />
        <div class="example-content">
            <BitTimePicker Icon="@("fa-solid fa-clock")" Placeholder="Select a time..." />
            <br />
            <BitTimePicker Icon="@BitIconInfo.Css("fa-solid fa-hourglass-half")"
                           Placeholder="Select a time..."
                           IconLocation="BitIconLocation.Left" />
            <br />
            <BitTimePicker Icon="@BitIconInfo.Fa("solid stopwatch")"
                           Placeholder="Select a time..." />
        </div>

        <br /><br /><br /><br />

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

        <div>Bootstrap:</div>
        <br />
        <div class="example-content">
            <BitTimePicker Icon="@("bi bi-clock-fill")" Placeholder="Select a time..." />
            <br />
            <BitTimePicker Icon="@BitIconInfo.Css("bi bi-alarm-fill")"
                           Placeholder="Select a time..."
                           IconLocation="BitIconLocation.Left" />
            <br />
            <BitTimePicker Icon="@BitIconInfo.Bi("stopwatch-fill")"
                           Placeholder="Select a time..." />
        </div>
    </DemoExample>

    <DemoExample Title="Style & Class" RazorCode="@example21RazorCode" CsharpCode="@example21CsharpCode" Id="example21">
        <div>
            Explore styling and class customization of the BitTimePicker: the <code>Style</code> and <code>Class</code> parameters affect
            the root element, while the <code>Styles</code> and <code>Classes</code> parameters give fine-grained control over every part of
            the component, like the input, the label, and each of the spin buttons.
        </div>
        <br /><br />
        <div>Component's Style & Class:</div>
        <br />
        <div class="example-content">
            <BitTimePicker Style="margin: 1rem; box-shadow: dodgerblue 0 0 1rem;" />
            <br />
            <BitTimePicker Class="custom-class" />
        </div>
        <br /><br /><br />
        <div><b>Styles</b> & <b>Classes</b>:</div>
        <br />
        <div class="example-content">
            <BitTimePicker Placeholder="Select a time..."
                           Styles="@(new() { Root = "margin-inline: 1rem;",
                                                 Focused = "--focused-background: #b2b2b25a;",
                                                 Input = "padding: 0.5rem;",
                                                 InputContainer = "background: var(--focused-background);",
                                                 IncreaseHourButton = "color: dodgerblue;",
                                                 DecreaseHourButton = "color: dodgerblue;",
                                                 IncreaseMinuteButton = "color: dodgerblue;",
                                                 DecreaseMinuteButton = "color: dodgerblue;" })" />
            <br />
            <BitTimePicker @bind-Value="@classesValue"
                           Label="Select a time"
                           Classes="@(new() { Root = "custom-root",
                                                  Focused = "custom-focus",
                                                  Input = "custom-input",
                                                  InputContainer = "custom-input-container",
                                                  Label = $"custom-label{(classesValue is null ? string.Empty : " custom-label-top")}",
                                                  IncreaseHourButton = "custom-button",
                                                  DecreaseHourButton = "custom-button",
                                                  IncreaseMinuteButton = "custom-button",
                                                  DecreaseMinuteButton = "custom-button" })" />
        </div>
    </DemoExample>

    <DemoExample Title="RTL" RazorCode="@example22RazorCode" Id="example22">
        <div>
            Use the <code>Dir</code> parameter to render the BitTimePicker in right-to-left (RTL) direction,
            adapting the input, the callout, and the close button placement accordingly.
        </div>
        <br />
        <div dir="rtl">
            <div class="example-content">
                <BitTimePicker Dir="BitDir.Rtl"
                               Standalone
                               Label="تایم"
                               Value="new(10, 24, 0)"
                               TimeFormat="BitTimeFormat.TwelveHours" />

                <br />
                <br />

                <BitTimePicker Dir="BitDir.Rtl"
                               ShowCloseButton
                               Label="تایم"
                               Placeholder="تایم خود را انتخاب کنید..." />
            </div>
        </div>
    </DemoExample>
</DemoPage>
