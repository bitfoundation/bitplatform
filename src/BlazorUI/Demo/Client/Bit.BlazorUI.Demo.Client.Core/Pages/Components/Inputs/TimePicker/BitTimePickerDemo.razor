                <br />
                <br />

                <BitTimePicker Dir="BitDir.Rtl"
                               ShowCloseButton
                               Label="زمان"
                               Placeholder="زمان خود را انتخاب کنید..." />
            </div>
        </div>
    </DemoExample>
