@page "/components/otpinput"
@page "/components/otp-input"

<PageOutlet Url="components/otpinput"
            Title="OtpInput"
            Description="A one-time password (OTP) input for Blazor: a row of single character boxes bound to one string, with auto advancing focus, full keyboard navigation, whole-code copy and paste, SMS auto fill, masking, grouping separators, an accessible described group, busy and error states, and public CSS variables." />

<DemoPage Name="OtpInput"
          Description="A one-time passcode entered as a row of single character boxes bound to one string value. Typing advances the focus, the keyboard walks and edits the code, a pasted or SMS-filled code is cleaned up and spread over the boxes, and a copy hands over the whole code. Accepted characters are narrowed by the input type or a regular expression, case folded and normalized to ASCII; a rejection is reported rather than silently dropped. It binds and validates like any other Blazor input, raises a callback the moment the code is complete, and carries the busy and error states of the round trip that follows."
          Parameters="componentParameters"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          CssVariables="componentCssVariables"
          PublicMembers="componentPublicMembers"
          GitHubUrl="Inputs/OtpInput/BitOtpInput.razor"
          GitHubDemoUrl="Inputs/OtpInput/BitOtpInputDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>
            <b>Length</b> single character boxes (5 by default) holding one string value. The focus advances on
            its own as each box is filled, so the code is typed without reaching for Tab.
        </div>
        <br />
        <div>
            The row behaves as the single field it stands for. Backspace clears the box it is pressed in and
            stays there, so the character can be retyped at once; only on an already empty box does it delete
            the character before it and follow it. Delete clears without moving, the arrows walk the row, Home
            and End jump to the first and last character. Focusing a box selects what it holds, so typing
            replaces rather than appends - which is why the space bar is refused like any other character no
            code is made of. A click in a gap or on a separator lands in the box the typing carries on in.
        </div>
        <br />
        <div>
            <b>IsEnabled</b> dims the component and drops it out of the tab order; <b>ReadOnly</b> keeps it
            readable and copyable. <b>AutoFocus</b> lands in the first box left to fill, <b>AutoShift</b> makes
            Backspace and Delete pull the rest of the code one box along instead of leaving a hole, and
            <b>BlurOnFill</b> drops the focus on the last character, getting a phone keyboard out of the way.
        </div>
        <br />
        <div>
            <b>Sequential</b> keeps the code free of holes: a click or a paste past the first empty box is
            pulled back to it. Without it a character typed into the middle of an empty row is reported as the
            first of the code, since the value is the boxes joined together. A complete code is left alone and
            stays correctable.
        </div>
        <br /><br />
        <div>Basic</div><br />
        <BitOtpInput />
        <br /><br /><br />
        <div>Length = 4</div><br />
        <BitOtpInput Length="4" />
        <br /><br /><br />
        <div>Disabled</div><br />
        <BitOtpInput IsEnabled="false" DefaultValue="12345" />
        <br /><br /><br />
        <div>ReadOnly</div><br />
        <BitOtpInput ReadOnly DefaultValue="12345" />
        <br /><br /><br />
        <div>AutoFocus</div><br />
        <BitOtpInput AutoFocus />
        <br /><br /><br />
        <div>AutoShift</div><br />
        <BitOtpInput AutoShift DefaultValue="12345" />
        <br /><br /><br />
        <div>BlurOnFill</div><br />
        <BitOtpInput BlurOnFill Length="4" />
        <br /><br /><br />
        <div>Sequential (try clicking the last box)</div><br />
        <BitOtpInput Sequential Length="6" />
    </DemoExample>

    <DemoExample Title="Label & description" RazorCode="@example2RazorCode" Id="example2">
        <div>
            <b>Label</b> is a real <code>label</code> element bound to the first box, so clicking it focuses the
            code, and it names the group of boxes for screen readers. <b>LabelTemplate</b> replaces the text with
            markup, <b>Required</b> adds the asterisk and marks the boxes required for the browser and for
            assistive technologies.
        </div>
        <br />
        <div>
            <b>Description</b> is the helper text under the boxes: where the code was sent, how long it stays
            valid, what to do when it never arrives. The group references it through
            <code>aria-describedby</code> - attached to the group and not to each box, which would repeat the
            whole sentence at every character. <b>DescriptionTemplate</b> takes markup instead, so a countdown or
            a "resend" action is announced with the group just the same.
        </div>
        <br /><br />
        <div>Label:</div>
        <br /><br />
        <BitOtpInput Label="OTP" />
        <br /><br /><br /><br />
        <div>Required:</div>
        <br /><br />
        <BitOtpInput Label="OTP" Required />
        <br /><br /><br /><br />
        <div>LabelTemplate:</div>
        <br /><br />
        <BitOtpInput>
            <LabelTemplate>
                <BitStack Horizontal>
                    <BitText Gutter><i>Custom label</i></BitText>
                    <BitSpacer />
                    <BitIcon IconName="@BitIconName.TemporaryAccessPass" />
                </BitStack>
            </LabelTemplate>
        </BitOtpInput>
        <br /><br /><br /><br />
        <div>Description:</div>
        <br /><br />
        <BitOtpInput Label="Verification code" Length="6"
                     Description="We sent a 6 digit code to +1 555 0100. It stays valid for 10 minutes." />
        <br /><br /><br /><br />
        <div>DescriptionTemplate:</div>
        <br /><br />
        <BitOtpInput Label="Verification code" Length="6">
            <DescriptionTemplate>
                <BitStack Horizontal FitWidth Gap="0.25rem" VerticalAlign="BitAlignment.Center">
                    <BitText Typography="BitTypography.Caption1">Didn't get it?</BitText>
                    <BitLink Href="#example2">Send it again</BitLink>
                </BitStack>
            </DescriptionTemplate>
        </BitOtpInput>
    </DemoExample>

    <DemoExample Title="Type & keyboard" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
        <div>
            <b>Type</b> decides the accepted characters and the virtual keyboard. <b>Number</b> asks for the
            numeric keypad and rejects anything that is not a digit, typed or pasted, so a code copied as
            <code>123-456</code> still lands as <code>123456</code>. <b>Password</b> masks with the bullet of the
            browser.
        </div>
        <br />
        <div>
            Only <b>Password</b> and <b>Tel</b> are rendered as their own element. <b>Number</b> would carry spin
            buttons, react to the mouse wheel and report an empty value for characters a number accepts but a
            code does not (<code>e</code>, <code>-</code>); <b>Email</b> and <b>Url</b> carry a constraint
            validation a single character can never satisfy, which would keep a plain HTML form from ever
            submitting. All three are text inputs that keep only their keyboard, through <code>inputmode</code>.
        </div>
        <br />
        <div>
            <b>InputMode</b> asks for a keyboard on its own, changing neither the element nor the accepted
            characters. It defaults to the one the <b>Type</b> implies, so it is only needed for the exceptions:
            <b>Tel</b> on a code of digits brings up the telephone keypad, whose keys are larger than the
            numeric ones on most Android keyboards.
        </div>
        <br />
        <div>
            A code of digits is not always written in ASCII - a Persian message carries it as <code>۱۲۳۴۵۶</code>,
            an Arabic one as <code>١٢٣٤٥٦</code>. <b>NormalizeDigits</b> folds every other numbering system into
            ASCII on the way in, before the <b>Type</b> and the <b>Pattern</b> decide what to accept, so the
            value stays the ASCII form a server expects.
        </div>
        <br />
        <BitOtpInput Label="Text" Type="BitInputType.Text" />
        <br /><br />
        <BitOtpInput Label="Number" Type="BitInputType.Number" />
        <br /><br />
        <BitOtpInput Label="Password" Type="BitInputType.Password" />
        <br /><br />
        <BitOtpInput Label="Number, with the telephone keypad" Type="BitInputType.Number" InputMode="BitInputMode.Tel" />
        <br /><br />
        <BitOtpInput Label="Number, typed or pasted in any numbering system" Length="6"
                     Type="BitInputType.Number" NormalizeDigits @bind-Value="normalizeDigitsValue" />
        <div>Value: @normalizeDigitsValue</div>
        <div>Try pasting <code>۱۲۳۴۵۶</code> or <code>١٢٣٤٥٦</code>.</div>
    </DemoExample>

    <DemoExample Title="Mask & placeholder" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
        <div>
            The two ends of what a box can show, neither of which touches the value: <b>Placeholder</b> is the
            hint in an empty box, <b>Mask</b> is what a filled one shows in place of its character.
        </div>
        <br />
        <div>
            A <b>Placeholder</b> exactly as long as <b>Length</b> is spread over the boxes one character each, so
            a shape like <code>000000</code> or <code>ABCDEF</code> can be drawn; any other value is repeated in
            every box as is.
        </div>
        <br />
        <div>
            <b>Mask</b> hides the code without turning the boxes into password inputs, so the masking character
            is yours rather than the browser's: a bullet, an asterisk, even an emoji. Only the rendering changes -
            binding, validation and the callbacks all still see the typed code. A masked code is kept off the
            clipboard, as is a <code>Password</code> <b>Type</b>; pasting into it keeps working either way.
        </div>
        <br />
        <BitOtpInput Label="A hint in every empty box" Placeholder="•" />
        <br /><br />
        <BitOtpInput Label="One hint character per box" Length="6" Placeholder="123456" />
        <br /><br />
        <BitOtpInput Label="Bullet" Mask="●" DefaultValue="12345" />
        <br /><br />
        <BitOtpInput Label="Asterisk, over a hint" Mask="*" Placeholder="0" Type="BitInputType.Number" />
        <br /><br />
        <BitOtpInput Label="Emoji" Mask="🔒" DefaultValue="12345" />
        <br /><br />
        <BitOtpInput Label="Masked, with the real value below" Mask="●" @bind-Value="maskValue" />
        <div>Value: @maskValue</div>
    </DemoExample>

    <DemoExample Title="Pattern" RazorCode="@example5RazorCode" Id="example5">
        <div>
            <b>Pattern</b> is a regular expression every single character has to match, for a set of characters
            no input type covers on its own. A typed character that does not match is rejected; the ones a
            pasted code brings are dropped instead of the whole paste being refused. An expression that does not
            compile is ignored rather than leaving a field that accepts nothing.
        </div>
        <br />
        <div>
            <b>Uppercase</b> keeps such a restriction from becoming a dead end: it folds the character before the
            expression is applied, so a code printed in upper case can be typed in either. <b>Lowercase</b> is
            its mirror and <b>Uppercase</b> wins when both are set. Both reach an assigned code as well as a
            typed or pasted one, so the boxes never show one casing while the value reports another.
        </div>
        <br />
        <BitOtpInput Label="Hexadecimal" Length="6" Pattern="^[a-fA-F0-9]$" Placeholder="0" />
        <br /><br />
        <BitOtpInput Label="Upper case letters" Length="4" Pattern="^[A-Z]$" Placeholder="A" />
        <br /><br />
        <BitOtpInput Label="Upper case letters, typed in any case" Length="4" Pattern="^[A-Z]$" Placeholder="A" Uppercase />
        <br /><br />
        <BitOtpInput Label="Lower case letters, typed in any case" Length="4" Pattern="^[a-z]$" Placeholder="a" Lowercase />
    </DemoExample>

    <DemoExample Title="Separator" RazorCode="@example6RazorCode" Id="example6">
        <div>
            <b>Separator</b> draws text between the boxes, the way a long code is printed in the message that
            delivers it. It is decoration only: hidden from screen readers, unfocusable, never part of the value.
            A pasted code is filtered by the same rules as a typed one, so its own dashes are dropped by a
            <b>Type</b> of <code>Number</code> or a <b>Pattern</b> that rejects them, and taken as characters
            otherwise.
        </div>
        <br />
        <div>
            <b>SeparatorInterval</b> is how many boxes a group holds. It defaults to 1, a separator between every
            pair; 3 on a six character code renders one separator in the middle, <code>123-456</code>.
            <b>SeparatorTemplate</b> takes markup instead, an icon above all, with the zero based index of the
            box it precedes as its context.
        </div>
        <br />
        <BitOtpInput Label="Dash" Length="6" Separator="-" />
        <br /><br />
        <BitOtpInput Label="Dot" Length="6" Separator="•" Type="BitInputType.Number" />
        <br /><br />
        <BitOtpInput Label="Grouped by 3" Length="6" Separator="-" SeparatorInterval="3" />
        <br /><br />
        <BitOtpInput Label="Grouped by 4" Length="8" Separator="—" SeparatorInterval="4" Type="BitInputType.Number" />
        <br /><br />
        <BitOtpInput Label="Icon separator" Length="6" SeparatorInterval="3" Type="BitInputType.Number">
            <SeparatorTemplate>
                <BitIcon IconName="@BitIconName.Remove" />
            </SeparatorTemplate>
        </BitOtpInput>
    </DemoExample>

    <DemoExample Title="Layout" RazorCode="@example7RazorCode" Id="example7">
        <div>
            <b>Vertical</b> stacks the boxes in a column, <b>Reversed</b> renders them in the opposite order. The
            arrow keys follow the layout - left and right walk a row, up and down a column, both flipping with
            <b>Reversed</b> and with a right-to-left direction. Home and End are the exception on purpose: they
            address the code, so they always land on its first and last character.
        </div>
        <br />
        <div>
            <b>FullWidth</b> stretches the row across the width it is given and lets the boxes share it evenly,
            which keeps a long code from running off a narrow screen and lines the row up with the full width
            fields around it. Only the layout axis grows: the boxes keep the height of their <b>Size</b>, and a
            <b>Vertical</b> row stretches each box across the column instead.
        </div>
        <br />
        <BitOtpInput Label="Default" />
        <br /><br />
        <BitOtpInput Label="Reversed" Reversed />
        <br /><br />
        <BitOtpInput Label="Vertical" Vertical />
        <br /><br />
        <BitOtpInput Label="Reversed Vertical" Vertical Reversed />
        <br /><br />
        <div style="max-width: 24rem;">
            <BitOtpInput Label="FullWidth" Length="6" FullWidth Type="BitInputType.Number" />
            <br />
            <BitOtpInput Label="FullWidth, grouped" Length="6" FullWidth Separator="-" SeparatorInterval="3"
                         Type="BitInputType.Number" />
        </div>
    </DemoExample>

    <DemoExample Title="Merged" RazorCode="@example8RazorCode" Id="example8">
        <div>
            <b>Merged</b> glues the boxes into a single field: the gaps close, the rule two neighbours share is
            drawn once, and only the two ends keep their rounding. It draws the code the way it is printed on a
            card, while every character keeps the input of its own that typing, autofill and screen readers need.
        </div>
        <br />
        <div>
            A <b>Separator</b> cuts the row into groups and the gluing follows them, so a six character code with
            a <b>SeparatorInterval</b> of 3 is two joined boxes of three. The separator keeps a little room of
            its own there, and a group of a single box keeps all four corners rounded.
        </div>
        <br />
        <div>
            It composes with the rest of the layout: <b>Vertical</b> glues along the column, <b>Reversed</b> and
            a right-to-left direction keep the rounding at the two visual ends of each group, and the
            <b>Variant</b> decides what is joined - filled boxes, outlined ones, or one continuous underline. The
            focused box is drawn above its neighbours, so its ring is never clipped.
        </div>
        <br />
        <BitOtpInput Label="Merged" Length="6" Merged Type="BitInputType.Number" />
        <br /><br />
        <BitOtpInput Label="Merged, grouped by 3" Length="6" Merged Separator="-" SeparatorInterval="3"
                     Type="BitInputType.Number" />
        <br /><br />
        <BitOtpInput Label="Merged, filled" Length="6" Merged Variant="BitVariant.Fill"
                     Type="BitInputType.Number" DefaultValue="123456" />
        <br /><br />
        <BitOtpInput Label="Merged, underlined" Length="6" Merged Variant="BitVariant.Text"
                     Type="BitInputType.Number" />
        <br /><br />
        <BitOtpInput Label="Merged, vertical" Length="4" Merged Vertical Type="BitInputType.Number" />
        <br /><br />
        <BitOtpInput Label="Merged, reversed" Length="4" Merged Reversed Type="BitInputType.Number" />
    </DemoExample>

    <DemoExample Title="Accessibility" RazorCode="@example9RazorCode" Id="example9">
        <div>
            The boxes sit in a <code>group</code> named after the <b>Label</b>, or after <b>AriaLabel</b> when
            there is none, and described by the <b>Description</b> under them - so the purpose of the code and
            where it was sent are announced once, not once per box. Each box is then named after its own
            position, <i>1 of 6</i> by default; <b>InputAriaLabelFormat</b> is the composite format behind it,
            <code>{0}</code> the one based position and <code>{1}</code> the <b>Length</b>.
        </div>
        <br />
        <div>
            <b>SingleTabStop</b> turns the component into one stop of the tab order: only the first box stays
            reachable with Tab, the rest are left to the auto advancing focus, the arrow keys and the mouse. The
            boxes still take the focus on a click and through <b>FocusAsync</b>. <b>TabIndex</b> composes with it
            - a box taken out of the order has no position left to be given - and is worth using sparingly,
            since a positive value pulls the component out of the document order for everyone.
        </div>
        <br />
        <div>
            The wait for the server and the answer it sends back both happen while the focus is usually nowhere
            near the boxes: the bar of <b>IsLoading</b> is only drawn, and <code>aria-invalid</code> is only
            announced once the focus lands on a box. The component therefore carries a live region of its own,
            holding the <b>Description</b> while <b>IsLoading</b> or <b>Invalid</b> is on - the status message
            WCAG 2.2 SC 4.1.3 asks for. Only text goes in it: a <b>DescriptionTemplate</b> is markup, so a
            countdown or a "resend" link keeps whatever <code>aria-live</code> you give it and nothing more.
        </div>
        <br />
        <div>
            The rest comes for free: <b>Required</b> marks every box required, a failing validation and
            <b>Invalid</b> add <code>aria-invalid</code>, <b>IsLoading</b> marks the group <code>aria-busy</code>
            so a screen reader holds off on the boxes changing under it, the separators are hidden so the code is
            never read out with the dashes in it, and a disabled component drops out of the tab order.
        </div>
        <br />
        <BitOtpInput Label="Verification code" Length="6" />
        <br /><br />
        <BitOtpInput AriaLabel="Enter the 6 digit code sent to your phone" Length="6" />
        <br /><br />
        <BitOtpInput Label="Localized announcement" Length="6" InputAriaLabelFormat="رقم {0} از {1}" />
        <br /><br />
        <BitOtpInput Label="Single tab stop" Length="6" SingleTabStop />
        <br /><br />
        <BitOtpInput Label="Described group" Length="6"
                     Description="Enter the code from the text message we sent to +1 555 0100." />
    </DemoExample>

    <DemoExample Title="Autofill, paste & copy" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
        <div>
            A one-time code is copied far more often than typed, and all three ways it arrives in one go end in
            the same place: <code>autocomplete="one-time-code"</code> on every box, which is what makes iOS and
            Safari offer the code that just arrived by SMS; the WebOTP API, requested by the component itself
            where it exists; and a paste anywhere in the row. A box the browser fills keeps the colors of the
            theme rather than the pale blue a Chromium or a WebKit engine paints an autofilled control with,
            which in a dark scheme would be the code itself falling under the contrast minimum.
        </div>
        <br />
        <div>
            An arriving code is cleaned up before it lands. Whitespace and whatever the <b>Type</b> or the
            <b>Pattern</b> rejects are dropped instead of the paste being refused, so a code copied as
            <code>123-456</code>, wrapped over two lines or surrounded by the words of the message still fills
            the boxes; <b>Uppercase</b>, <b>Lowercase</b> and <b>NormalizeDigits</b> apply to it too. Characters
            with no glyph - bidi marks, zero width joiners, a byte order mark, control characters - always go,
            since one of them would hand the server a code the user cannot see.
        </div>
        <br />
        <div>
            Where it lands depends on its length: a code that fills the component starts at the first box
            whichever one received it, a shorter one is inserted where it was pasted and replaces only as many
            characters as it brings, a longer one keeps its first <b>Length</b>. <b>Sequential</b> keeps a chunk
            from landing past the first empty box.
        </div>
        <br />
        <div>
            Per-character filtering cannot pull a code of <i>letters</i> out of the text around it - the letters
            of the words match just as well, so <code>your code is A1B2C3</code> would fill the boxes with
            <code>YOURCODEI</code>. <b>PasteTransformer</b> runs one regular expression over the whole chunk
            first. Returning an empty string rejects it and raises <b>OnInvalid</b>; a single typed character
            never reaches it.
        </div>
        <br />
        <div>
            On the way back out, a copy from any box hands over the whole code rather than the one character
            that box holds, and a cut empties the boxes afterwards. A code that is not shown - a <b>Mask</b> or
            a <b>Password</b> <b>Type</b> - is kept off the clipboard, the way a password input is.
        </div>
        <br />
        <div>
            <b>NoSmsAutoFill</b> turns those routes off for a code that never arrives by SMS, one read from an
            authenticator app above all, and reaches the password managers with them: an <code>autocomplete</code>
            of <code>off</code> is a request the extensions deliberately ignore, so the attributes 1Password,
            LastPass, Bitwarden and Dashlane read instead are rendered along with it. They are not rendered
            otherwise, since offering the code from the vault that issued it is what a password manager is for.
        </div>
        <br />
        <div>Try pasting <code>123 456</code>, <code>12-34-56</code> or <code>your code is 123456</code>:</div>
        <br />
        <BitOtpInput Label="Paste a code" Length="6" Type="BitInputType.Number" @bind-Value="pasteValue" />
        <div>Value: @pasteValue</div>
        <br /><br />
        <div>Try pasting <code>your code is A1B2C3, do not share it</code>:</div>
        <br />
        <BitOtpInput Label="Alphanumeric, pulled out of the message" Length="6" Uppercase
                     PasteTransformer="@(v => System.Text.RegularExpressions.Regex.Match(v, "[A-Za-z0-9]{6}").Value)"
                     @bind-Value="transformedPasteValue" />
        <div>Value: @transformedPasteValue</div>
        <br /><br />
        <BitOtpInput Label="Without the SMS auto fill" Length="6" NoSmsAutoFill />
    </DemoExample>

    <DemoExample Title="Binding" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
        <div>
            The value is the whole code as one string, not one value per box. <b>Value</b> alone makes the boxes
            follow the model without letting the user change it; <b>bind-Value</b> syncs both ways, and
            <code>null</code> or an empty string clears them all. <b>DefaultValue</b> is the uncontrolled
            counterpart: it seeds the boxes on the first render and then leaves them to the user.
        </div>
        <br />
        <BitOtpInput Label="One-way" Value="@oneWayValue" />
        <BitTextField Style="margin-top: 5px;" @bind-Value="oneWayValue" />
        <br /><br />
        <BitOtpInput Label="Two-way" @bind-Value="twoWayValue" />
        <BitTextField Style="margin-top: 5px;" @bind-Value="twoWayValue" />
    </DemoExample>

    <DemoExample Title="Events" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
        <div>
            <b>OnChange</b> reports every change of the value. <b>OnFill</b> fires the moment the last empty box
            is filled - the callback to submit from, and the place to switch
            <b><BitLink Href="#example15">IsLoading</BitLink></b> on. It is raised once per completed code, so
            retyping the same character over a complete code does not submit it twice, and it fires again once
            the code is edited into a different complete one.
        </div>
        <br />
        <div>
            <b>OnInvalid</b> is the other side of that coin: it fires when what was typed, pasted or auto filled
            is rejected in full by the <b>Type</b> or the <b>Pattern</b>, with the rejected text and the index of
            the box that received it. A rejection is otherwise silent, leaving the user typing into a box that
            never fills, so this is what turns it into a message, a shake of the row or the <b>Invalid</b> state.
            A paste that only loses some of its characters still fills the boxes and is not a rejection.
        </div>
        <br />
        <div>
            The remaining callbacks forward the raw DOM events of each box along with its index.
        </div>
        <br />
        <BitOtpInput Label="OnChange" OnChange="v => onChangeValue = v" />
        <div>OnChange value: @onChangeValue</div>
        <br /><br />
        <BitOtpInput Label="OnFill" OnFill="v => onFillValue = v" />
        <div>OnFill value: @onFillValue</div>
        <br /><br />
        <BitOtpInput Label="OnInvalid (digits only)" Type="BitInputType.Number" OnInvalid="args => onInvalidArgs = args" />
        <div>Rejected: @onInvalidArgs?.Value</div>
        <div>Input index: @onInvalidArgs?.Index</div>
        <br /><br />
        <BitOtpInput Label="OnFocusIn" OnFocusIn="args => onFocusInArgs = args" />
        <div>Focus type: @onFocusInArgs?.Event.Type</div>
        <div>Input index: @onFocusInArgs?.Index</div>
        <br /><br />
        <BitOtpInput Label="OnFocusOut" OnFocusOut="args => onFocusOutArgs = args" />
        <div>Focus type: @onFocusOutArgs?.Event.Type</div>
        <div>Input index: @onFocusOutArgs?.Index</div>
        <br /><br />
        <BitOtpInput Label="OnInput" OnInput="args => onInputArgs = args" />
        <div>Value: @onInputArgs?.Event.Value</div>
        <div>Input index: @onInputArgs?.Index</div>
        <br /><br />
        <BitOtpInput Label="OnKeyDown" OnKeyDown="args => onKeyDownArgs = args" />
        <div>Key & Code: [@onKeyDownArgs?.Event.Key] [@onKeyDownArgs?.Event.Code]</div>
        <div>Input index: @onKeyDownArgs?.Index</div>
        <br /><br />
        <BitOtpInput Label="OnPaste" OnPaste="args => onPasteArgs = args" />
        <div>Focus type: @onPasteArgs?.Event.Type</div>
        <div>Input index: @onPasteArgs?.Index</div>
    </DemoExample>

    <DemoExample Title="Public API" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
        <div>
            A reference exposes <b>FocusAsync</b> (a specific box, index clamped into the rendered range),
            <b>BlurAsync</b> (drops the focus and with it a phone's keyboard), <b>Clear</b> (empties the boxes and
            the value) and <b>InputElements</b>. Clearing and re-focusing the first box is exactly what a "that
            code is wrong, try again" branch needs.
        </div>
        <br />
        <div>
            All of them are safe at any point in the lifetime of the component: focusing before the first render
            does nothing rather than asking the browser for an element that is not there yet, blurring does
            nothing when the focus is elsewhere, and clearing does nothing while the component is disabled or
            read-only. <b>Clear</b> is deliberately not blocked by
            <b><BitLink Href="#example15">IsLoading</BitLink></b>, since that state belongs to the very code
            about to be cleared.
        </div>
        <br />
        <BitOtpInput @ref="apiOtpInput" Label="OTP" Length="6" DefaultValue="123456" />
        <br />
        <BitStack Horizontal FitWidth Gap="0.5rem" Wrap>
            <BitButton OnClick="() => apiOtpInput?.FocusAsync(0)">Focus first</BitButton>
            <BitButton OnClick="() => apiOtpInput?.FocusAsync(5)">Focus last</BitButton>
            <BitButton Variant="BitVariant.Outline" OnClick="() => apiOtpInput?.BlurAsync()">Blur</BitButton>
            <BitButton Variant="BitVariant.Outline" OnClick="HandleClearClick">Clear</BitButton>
        </BitStack>
    </DemoExample>

    <DemoExample Title="Validation" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
        <div>
            A regular Blazor input: it picks up the cascading <code>EditContext</code>, reports its value on every
            keystroke, paints the error state on the boxes and marks them <code>aria-invalid</code>. Data
            annotations such as <code>[Required]</code> and <code>[MinLength]</code> on the bound property are all
            it takes to validate the length. Outside an <code>EditForm</code>, <b>Name</b> posts the whole code as
            one named field of a plain HTML form, not one field per box.
        </div>
        <br /><br />
        <div>
            @if (formIsValidSubmit is false)
            {
                <EditForm Model="validationOtpInputModel" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />

                    <BitOtpInput Length="6" @bind-Value="validationOtpInputModel.OtpValue" />
                    <ValidationMessage For="() => validationOtpInputModel.OtpValue" />

                    <br />

                    <BitButton Style="margin-top: 10px;" ButtonType="BitButtonType.Submit">Submit</BitButton>
                </EditForm>
            }
            else
            {
                <BitMessage Color="BitColor.Success">
                    The form submitted successfully.
                </BitMessage>
            }
        </div>
    </DemoExample>

    <DemoExample Title="Loading & invalid" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
        <div>
            Entering a one-time code is a round trip, and these are its two halves. Such a code is almost never
            wrong in a way a validator can see - it is the right length and made of the right characters, and
            only the server that issued it knows it has expired - so both are states of the component rather
            than of an <code>EditContext</code>.
        </div>
        <br />
        <div>
            <b>IsLoading</b> is the middle of the trip: an indeterminate bar under the boxes, the
            <b>Description</b> put into the component's live region so the wait is announced as well as drawn,
            <code>aria-busy</code> on the group, and the code held still the way <b>ReadOnly</b> does - nothing
            typed, deleted, pasted or cut over a code already submitted, and no further SMS request. What it
            does not block is your own <b>Clear</b>.
        </div>
        <br />
        <div>
            <b>Invalid</b> is the answer that came back rejected, painted in the error color and marked
            <code>aria-invalid</code>. An <b>EditForm</b> renders the very same state on its own, so the two
            divide the work: data annotations catch a code that is too short before it is sent, <b>Invalid</b>
            catches the one that was sent and refused. Pair it with <b>Description</b>, the sentence the server
            answered with, which keeps color from being the only carrier of the message.
        </div>
        <br />
        <div>
            The order is the order of the round trip: <b>OnFill</b> submits and switches <b>IsLoading</b> on, the
            answer switches it off, a rejected code switches <b>Invalid</b> on along with the sentence for it.
            The bar follows the <b>Accent</b> color, and keeps to the error color while a rejected code is being
            checked again.
        </div>
        <br />
        <BitOtpInput @ref="loadingOtpInput" Label="Verification code" Length="6"
                     Type="BitInputType.Number"
                     Invalid="loadingInvalid"
                     IsLoading="isLoading"
                     Description="@loadingDescription"
                     OnFill="HandleLoadingDemoFill" />
        <br />
        <BitStack Horizontal FitWidth Gap="0.5rem">
            <BitButton Variant="BitVariant.Outline" OnClick="HandleLoadingDemoRetry">Clear &amp; retry</BitButton>
        </BitStack>
    </DemoExample>

    <DemoExample Title="Variant" RazorCode="@example16RazorCode" Id="example16">
        <div>
            <b>Variant</b> decides how much of a frame each box carries: <b>Outline</b> (the default) a full rule,
            <b>Fill</b> a surface color and no rule, <b>Text</b> only an underline, for a code entry that should
            not outweigh the fields around it.
        </div>
        <br />
        <BitOtpInput Label="Fill" Variant="BitVariant.Fill" DefaultValue="12345" />
        <br /><br />
        <BitOtpInput Label="Outline" Variant="BitVariant.Outline" DefaultValue="12345" />
        <br /><br />
        <BitOtpInput Label="Text" Variant="BitVariant.Text" DefaultValue="12345" />
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example17RazorCode" CsharpCode="@example17CsharpCode" Id="example17">
        <div>
            <b>BitParams</b> carries a <b>BitOtpInputParams</b> down to every otp input under it, so a sign-in
            flow sets the shape of its codes once instead of repeating it on every screen. What it carries is a
            default and not an override: a component that writes a parameter for itself keeps its own value, and
            only what it left unset is filled in, parameter by parameter.
        </div>
        <br />
        <div>
            It is the natural home of the rules that belong to the application rather than to one field:
            <b>Length</b> and <b>Type</b>, which the server issuing the code decides; <b>Pattern</b>,
            <b>Uppercase</b> and <b>NormalizeDigits</b> for the alphabets your users write in; and
            <b>PasteTransformer</b>, the one regular expression that pulls your codes out of the messages they
            arrive in. <b>ReadOnly</b> and <b>Required</b> travel with them, so a review step can hold every
            code on the screen still at once. What identifies a single field - <b>Value</b>,
            <b>DefaultValue</b>, <b>Name</b> - is deliberately not carried.
        </div>
        <br />
        <div>
            <BitParams Parameters="@otpInputParams">
                <BitOtpInput Label="Takes the length, the type, the separator and the variant from the cascade" />
                <br />
                <BitOtpInput Label="So does this one, without repeating any of it" />
                <br />
                <BitOtpInput Label="Its own Length, the cascaded rest" Length="4" />
            </BitParams>
        </div>
        <br />
        <div>
            <BitOtpInput Label="Outside the cascade, and back to the defaults" />
        </div>
    </DemoExample>

    <DemoExample Title="Accent" RazorCode="@example18RazorCode" Id="example18">
        <div>
            <b>Accent</b> is the color role the focused box carries, on both its border and its focus ring, and
            the color of the <b>IsLoading</b> bar. The error state always wins over it, so an invalid code stays
            recognizable whatever the accent is.
        </div>
        <br />
        <BitOtpInput Label="Primary" Accent="BitColor.Primary" />
        <br /><br />
        <BitOtpInput Label="Secondary" Accent="BitColor.Secondary" />
        <br /><br />
        <BitOtpInput Label="Tertiary" Accent="BitColor.Tertiary" />
        <br /><br />
        <BitOtpInput Label="Info" Accent="BitColor.Info" />
        <br /><br />
        <BitOtpInput Label="Success" Accent="BitColor.Success" />
        <br /><br />
        <BitOtpInput Label="Warning" Accent="BitColor.Warning" />
        <br /><br />
        <BitOtpInput Label="SevereWarning" Accent="BitColor.SevereWarning" />
        <br /><br />
        <BitOtpInput Label="Error" Accent="BitColor.Error" />
    </DemoExample>

    <DemoExample Title="Size" RazorCode="@example19RazorCode" Id="example19">
        <div>
            <b>Size</b> scales the boxes and the text inside them together. Match it to the density around it:
            large for a standalone verification screen, small for a code entry tucked into a dense dialog.
        </div>
        <br />
        <BitOtpInput Label="Small" Size="BitSize.Small" />
        <br /><br />
        <BitOtpInput Label="Medium" Size="BitSize.Medium" />
        <br /><br />
        <BitOtpInput Label="Large" Size="BitSize.Large" />
    </DemoExample>

    <DemoExample Title="Style & Class" RazorCode="@example20RazorCode" Id="example20">
        <div>
            <b>Style</b> and <b>Class</b> reach the root element only; <b>Styles</b> and <b>Classes</b> reach
            every part by name - root, label, description, the wrapper of the inputs, each input, the separator
            and the <b>Loader</b> - plus the two state slots <b>Focused</b> and <b>Filled</b>, the hooks for a
            per-box appearance that follows the progress of the typing.
        </div>
        <br /><br />
        <div>
            <div>Component's Style & Class:</div><br />
            <BitOtpInput Style="margin-inline: 1rem; box-shadow: aqua 0 0 0.5rem;" />
            <br />
            <BitOtpInput Class="custom-class" />
            <br /><br /><br />
            <div><b>Styles</b> & <b>Classes</b>:</div><br />
            <BitOtpInput Label="Styles" Description="Every part of the component has a slot of its own."
                         Styles="@(new() { Root = "margin-inline: 1rem;",
                                           Label = "color: blueviolet; letter-spacing: 0.1rem;",
                                           Description = "color: blueviolet;",
                                           InputsWrapper = "gap: 0.25rem;",
                                           Input = "border-color: blueviolet;",
                                           Filled = "background-color: #f3e8ff;",
                                           Focused = "box-shadow: blueviolet 0 0 1rem;" })" />
            <br />
            <BitOtpInput Label="Classes" Length="6" Separator="-"
                         Description="Every part of the component has a slot of its own."
                         Classes="@(new() { Root = "custom-root",
                                            Label = "custom-label",
                                            Description = "custom-description",
                                            InputsWrapper = "custom-wrapper",
                                            Input = "custom-input",
                                            Filled = "custom-filled",
                                            Focused = "custom-focused",
                                            Separator = "custom-separator" })" />
        </div>
        <br /><br />
        <div>
            What the parameters do not cover, the public
            <BitLink Href="#css-variables-section">CSS variables</BitLink> do. They inherit, so a value on
            <code>:root</code> or any ancestor re-skins every code entry below it and one on an instance's
            <b>Style</b> re-skins that one alone - without a selector against the internal class names, which
            are not part of the API. <b>--bit-OtpInput-filled-background</b> and
            <b>--bit-OtpInput-filled-border-color</b> are the pair with no parameter behind them: they paint
            the boxes that already hold a character, which turns the row into its own progress indicator.
        </div>
        <br />
        <div>
            <BitOtpInput Label="Bigger boxes, softer corners" Length="6" Type="BitInputType.Number"
                         Style="--bit-OtpInput-input-size: 3.5rem; --bit-OtpInput-radius: 1rem; --bit-OtpInput-font-size: 1.5rem; --bit-OtpInput-label-font-size: 0.875rem; --bit-OtpInput-font-weight: 600; --bit-OtpInput-gap: 0.5rem;" />
            <br />
            <BitOtpInput Label="A filled box shows its own progress" Length="6" Type="BitInputType.Number"
                         Style="--bit-OtpInput-filled-background: color-mix(in srgb, var(--bit-clr-pri) 12%, transparent); --bit-OtpInput-filled-border-color: var(--bit-clr-pri);" />
            <br />
            <BitOtpInput Label="A ticket stub, wider than it is tall" Length="6" Uppercase Merged
                         Style="--bit-OtpInput-input-width: 2.75rem; --bit-OtpInput-input-height: 3.5rem; --bit-OtpInput-border-width: 2px; --bit-OtpInput-background: var(--bit-clr-bg-sec); --bit-OtpInput-radius: 0.25rem;" />
            <br />
            <BitOtpInput Label="Set in the monospaced face of the theme" Length="6" Uppercase DefaultValue="0OI1L5"
                         Style="--bit-OtpInput-font-family: var(--bit-tpg-font-family-mono);" />
        </div>
        <br />
        <div>Set once on an ancestor, inherited by every code entry inside it:</div>
        <br />
        <div style="--bit-OtpInput-radius: 999px; --bit-OtpInput-focus-border-color: var(--bit-clr-suc); --bit-OtpInput-focus-color: var(--bit-clr-suc-focus);">
            <BitOtpInput Label="Sign in" Length="4" Type="BitInputType.Number" />
            <br />
            <BitOtpInput Label="Confirm" Length="4" Type="BitInputType.Number" />
        </div>
    </DemoExample>

    <DemoExample Title="RTL" RazorCode="@example21RazorCode" Id="example21">
        <div>
            In a right-to-left direction the boxes are laid out from right to left and the arrow keys swap with
            them, so the left arrow still moves towards the box on the visual left. The value keeps its logical
            order: the first box is always the first character of the code.
        </div>
        <br /><br />
        <div dir="rtl">
            <BitOtpInput Label="پیش‌فرض" Dir="BitDir.Rtl" />
            <br /><br />
            <BitOtpInput Label="معکوس" Reversed Dir="BitDir.Rtl" />
            <br /><br />
            <BitOtpInput Label="جداکننده" Length="6" Separator="-" Dir="BitDir.Rtl" />
        </div>
    </DemoExample>
</DemoPage>
