                <br /><br />
                <div>PrimaryForeground:</div>
                <BitCalendar Color="BitColor.PrimaryForeground" HighlightCurrentMonth />
                <br /><br />
                <div>SecondaryForeground:</div>
                <BitCalendar Color="BitColor.SecondaryForeground" HighlightCurrentMonth />
