<DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
    <div>The basic ChoiceGroup lets people select a single option from a set of mutually exclusive choices. It is fully keyboard accessible: Tab focuses the checked option and the arrow keys move the selection. The NoCircle mode removes the radio circle of each option.</div>
    <br />
    <div class="example-content">
        <BitChoiceGroup Label="Basic Options" DefaultValue="@("B")" TItem="BitChoiceGroupOption<string>" TValue="string">
            <BitChoiceGroupOption Text="Option A" Value="@("A")" />
            <BitChoiceGroupOption Text="Option B" Value="@("B")" />
            <BitChoiceGroupOption Text="Option C" Value="@("C")" />
            <BitChoiceGroupOption Text="Option D" Value="@("D")" />
        </BitChoiceGroup>

        <BitChoiceGroup Label="NoCircle" NoCircle DefaultValue="@("B")" TItem="BitChoiceGroupOption<string>" TValue="string">
            <BitChoiceGroupOption Text="Option A" Value="@("A")" />
            <BitChoiceGroupOption Text="Option B" Value="@("B")" />
            <BitChoiceGroupOption Text="Option C" Value="@("C")" />
            <BitChoiceGroupOption Text="Option D" Value="@("D")" />
        </BitChoiceGroup>
    </div>
</DemoExample>

<DemoExample Title="Disabled" RazorCode="@example2RazorCode" Id="example2" PreventRenderForMcpClient>
    <div>Disables the whole ChoiceGroup or its individual options. Disabled options cannot be selected and are skipped by the keyboard navigation.</div>
    <br />
    <div class="example-content">
        <BitChoiceGroup Label="Disabled ChoiceGroup"
                        IsEnabled="false"
                        DefaultValue="@("A")"
                        TItem="BitChoiceGroupOption<string>" TValue="string">
            <BitChoiceGroupOption Text="Option A" Value="@("A")" />
            <BitChoiceGroupOption Text="Option B" Value="@("B")" />
            <BitChoiceGroupOption Text="Option C" Value="@("C")" />
            <BitChoiceGroupOption Text="Option D" Value="@("D")" />
        </BitChoiceGroup>

        <BitChoiceGroup Label="ChoiceGroup with Disabled Option"
                        DefaultValue="@("A")"
                        TItem="BitChoiceGroupOption<string>" TValue="string">
            <BitChoiceGroupOption Text="Option A" Value="@("A")" />
            <BitChoiceGroupOption Text="Option B" Value="@("B")" />
