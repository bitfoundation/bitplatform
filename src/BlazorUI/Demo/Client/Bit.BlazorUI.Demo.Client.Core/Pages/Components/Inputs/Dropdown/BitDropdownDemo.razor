@page "/components/dropdown"
@inherits AppComponentBase

<PageOutlet Url="components/dropdown"
            Title="Dropdown"
            Description="An accessible select component for picking one or more options, with a searchable callout that keeps its grouping while filtering, full keyboard navigation, a ComboBox mode with chips, virtualization and rich templating." />

<div>
    <DemoPage Name="Dropdown"
              SecondaryNames="@(["Select", "MultiSelect", "ComboBox"])"
              Description="BitDropdown (also known as Select, MultiSelect or ComboBox) lets users pick one or more options from a list that opens on demand. It stays fully operable with the keyboard and with a screen reader: the callout is a real listbox whose options are counted, grouped under their header and navigated with the arrow keys - wrapping around at the ends, or stopping there when a long list makes the wrap read as a lost focus - and whose search results are announced as they change, counted as the list is actually rendered. It also has a text of its own for every message it produces, including the ones only a screen reader reads. The callout is searchable, with typeahead, four match modes, optional diacritic-insensitive matching and a fully replaceable search algorithm, and a minimum term length that says how many characters are still missing rather than silently leaving the list unfiltered. The filtered list keeps its group headers instead of collapsing into a flat one, dropping only the ones left naming nothing. Selection adds select all with an indeterminate state, a selection limit, and distinct loading, empty and no-results states, and the selection is reported in the order it was made. The ComboBox mode adds free typing, chips and autocomplete on Enter, with the item Enter is about to take marked in the list as you type, by sight and to a screen reader alike. Token separators turn a pasted delimited list into selections, dynamic item addition is offered as a row of the list you can see and click rather than as a shortcut to know about, the callout can open on focus, the term already in the input can be selected when it takes the focus so that typing replaces it, and virtualization and on-demand loading cover large datasets. Templates cover every part of the component: the items, the group headers, the chips, the selected text, the placeholder, the label, the description and the callout header and footer, along with a swappable icon for every one it draws itself. In a form it offers EditForm validation alongside a hidden native select that carries the value into a plain HTML form post, a description tied to the control as its accessible description, an equality of your own for values that are not their own identity, and a cap of your own on the height of the item list. It also offers three sizes, boxed, borderless and underlined variants, a swipeable panel on small screens, and RTL support. Each mode dismisses the callout the way its interaction expects, and lets you override that, and however the callout is dismissed the focus comes back to the dropdown rather than being dropped at the top of the page. Escape stays a dismiss key first - the callout, then the typed term - and can be asked to take back the whole selection once there is nothing left for it to dismiss, so clearing never requires finding a button with the mouse."
              Parameters="componentParameters"
              SubClasses="componentSubClasses"
              SubEnums="componentSubEnums"
              PublicMembers="componentPublicMembers"
              GitHubUrl="Inputs/Dropdown/BitDropdown.razor"
              GitHubDemoUrl="Inputs/Dropdown/BitDropdownDemo.razor"
              IntroductionVideoUrl="https://videos.bitplatform.dev/bit%20Dropdown.mp4">
        <NotesTemplate>
            <BitText>
                The BitDropdown is a <BitTag Color="BitColor.SecondaryBackground">Multi-API</BitTag> component
                which can accept the list of Items in 3 different ways:
                <br />
                1. The <BitLink Href="#dropdown-item"><BitTag Color="BitColor.SecondaryBackground">BitDropdownItem</BitTag></BitLink> class <br />
                2. A <BitTag Color="BitColor.SecondaryBackground">Custom Generic</BitTag> class <br />
                3. The <BitLink Href="#dropdown-option"><BitTag Color="BitColor.SecondaryBackground">BitDropdownOption</BitTag></BitLink> component
            </BitText>
        </NotesTemplate>
        <IntroductionTemplate>
            <BitScrollablePane>
                <BitText Typography="BitTypography.Body2" Color="BitColor.TertiaryForeground">
                    Music: Music Cocktails, Musician: AlexGuz, URL:
                    <a href="https://open.spotify.com/artist/1u0Nlnljg2xGHJV6X7W4i1"
                       target="_blank" style="color:inherit">
                        https://open.spotify.com/artist/1u0Nlnljg2xGHJV6X7W4i1
                    </a>
                </BitText>
            </BitScrollablePane>
        </IntroductionTemplate>
        <Examples>
            <BitPivot Classes="@(new() { HeaderContainer = "pivot-sticky-header" })" MountAll="RenderForMcpClient">
                <BitPivotItem HeaderText="Item">
                    <_BitDropdownItemDemo />
                </BitPivotItem>

                <BitPivotItem HeaderText="Custom">
                    <_BitDropdownCustomDemo />
                </BitPivotItem>

                <BitPivotItem HeaderText="Option">
                    <_BitDropdownOptionDemo />
                </BitPivotItem>
            </BitPivot>
        </Examples>
    </DemoPage>
</div>
