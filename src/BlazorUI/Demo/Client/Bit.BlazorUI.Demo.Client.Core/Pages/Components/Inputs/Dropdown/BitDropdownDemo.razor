@page "/components/dropdown"
@inherits AppComponentBase

<PageOutlet Url="components/dropdown"
            Title="Dropdown"
            Description="BitDropdown is a full-featured select component for picking one or more options: a searchable callout with four match modes, diacritic-insensitive matching and match highlighting, full keyboard navigation and typeahead, select all with an indeterminate state, a selection limit, loading and empty states, a ComboBox mode with chips, autocomplete on Enter, paste-to-select through token separators and dynamic item addition, an optional open-on-focus behavior, virtualization and on-demand loading for large datasets, rich templates and swappable icons for every part, EditForm validation and plain HTML form posts, three sizes, a responsive mobile panel, RTL, an accessible listbox with grouped, counted options and disciplined focus management, and a fully localizable set of texts down to the accessible names." />

<div>
    <DemoPage Name="Dropdown"
              SecondaryNames="@(["Select", "MultiSelect", "ComboBox"])"
              Description="BitDropdown (also known as Select, MultiSelect or ComboBox) lets users pick one or more options from a list that opens on demand, and stays fully operable with the keyboard and with a screen reader: the callout is a real listbox whose options are counted, grouped under their header and navigated with the arrow keys, and whose search results are announced as they change. Beyond the basics, it offers a searchable callout with typeahead, four match modes, optional diacritic-insensitive matching and a fully replaceable search algorithm, select all with an indeterminate state, a selection limit, distinct loading, empty and no-results states, a ComboBox mode with free typing, chips, autocomplete on Enter, token separators that turn a pasted delimited list into selections, and dynamic item addition, an optional callout that opens on focus, virtualization and on-demand loading for large datasets, templates for every part of the component and a swappable icon for every one it draws itself, EditForm validation alongside a hidden native select that carries the value into a plain HTML form post, three sizes, a swipeable panel on small screens, RTL support, and a text of its own for every message it produces &mdash; including the ones only a screen reader reads. The selection is reported in the order it was made, each mode dismisses the callout the way its interaction expects (and lets you override that), and however the callout is dismissed the focus comes back to the dropdown rather than being dropped at the top of the page."
              Parameters="componentParameters"
              SubClasses="componentSubClasses"
              SubEnums="componentSubEnums"
              PublicMembers="componentPublicMembers"
              GitHubUrl="Inputs/Dropdown/BitDropdown.razor"
              GitHubDemoUrl="Inputs/Dropdown/BitDropdownDemo.razor"
              IntroductionVideoUrl="https://videos.bitplatform.dev/bit%20Dropdown.mp4">
        <NotesTemplate>
            <BitText>
                The BitDropdown is a <BitTag Color="BitColor.SecondaryBackground">Multi-API</BitTag> component
                which can accept the list of Items in 3 different ways:
                <br />
                1. The <BitLink Href="#dropdown-item"><BitTag Color="BitColor.SecondaryBackground">BitDropdownItem</BitTag></BitLink> class <br />
                2. A <BitTag Color="BitColor.SecondaryBackground">Custom Generic</BitTag> class <br />
                3. The <BitLink Href="#dropdown-option"><BitTag Color="BitColor.SecondaryBackground">BitDropdownOption</BitTag></BitLink> component
            </BitText>
        </NotesTemplate>
        <IntroductionTemplate>
            <BitScrollablePane>
                <BitText Typography="BitTypography.Body2" Color="BitColor.TertiaryForeground">
                    Music: Music Cocktails, Musician: AlexGuz, URL:
                    <a href="https://open.spotify.com/artist/1u0Nlnljg2xGHJV6X7W4i1"
                       target="_blank" style="color:inherit">
                        https://open.spotify.com/artist/1u0Nlnljg2xGHJV6X7W4i1
                    </a>
                </BitText>
            </BitScrollablePane>
        </IntroductionTemplate>
        <Examples>
            <BitPivot Classes="@(new() { HeaderContainer = "pivot-sticky-header" })" MountAll="RenderForMcpClient">
                <BitPivotItem HeaderText="Item">
                    <_BitDropdownItemDemo />
                </BitPivotItem>

                <BitPivotItem HeaderText="Custom">
                    <_BitDropdownCustomDemo />
                </BitPivotItem>

                <BitPivotItem HeaderText="Option">
                    <_BitDropdownOptionDemo />
                </BitPivotItem>
            </BitPivot>
        </Examples>
    </DemoPage>
</div>
