@page "/components/dropdown"
@inherits AppComponentBase

<PageOutlet Url="components/dropdown"
            Title="Dropdown"
            Description="BitDropdown is a full-featured select component for picking one or more options: a searchable callout with full keyboard navigation and typeahead, select all with an indeterminate state, a selection limit, loading and empty states, a ComboBox mode with chips and dynamic item addition, virtualization and on-demand loading for large datasets, rich templates for every part, EditForm validation and plain HTML form posts, three sizes, a responsive mobile panel, RTL, an accessible listbox with grouped and counted options, and a fully localizable set of texts down to the accessible names." />

<div>
    <DemoPage Name="Dropdown"
              SecondaryNames="@(["Select", "MultiSelect", "ComboBox"])"
              Description="BitDropdown (also known as Select, MultiSelect or ComboBox) lets users pick one or more options from a list that opens on demand, and stays fully operable with the keyboard and with a screen reader: the callout is a real listbox whose options are counted, grouped under their header and navigated with the arrow keys, and whose search results are announced as they change. Beyond the basics, it offers a searchable callout with typeahead and a customizable search algorithm, select all with an indeterminate state, a selection limit, distinct loading, empty and no-results states, a ComboBox mode with free typing, chips and dynamic item addition, virtualization and on-demand loading for large datasets, templates for every part of the component, EditForm validation alongside a hidden native select that carries the value into a plain HTML form post, three sizes, a swipeable panel on small screens, RTL support, and a text of its own for every message it produces &mdash; including the ones only a screen reader reads."
              Parameters="componentParameters"
              SubClasses="componentSubClasses"
              SubEnums="componentSubEnums"
              PublicMembers="componentPublicMembers"
              GitHubUrl="Inputs/Dropdown/BitDropdown.razor"
              GitHubDemoUrl="Inputs/Dropdown/BitDropdownDemo.razor"
              IntroductionVideoUrl="https://videos.bitplatform.dev/bit%20Dropdown.mp4">
        <NotesTemplate>
            <BitText>
                The BitDropdown is a <BitTag Color="BitColor.SecondaryBackground">Multi-API</BitTag> component
                which can accept the list of Items in 3 different ways:
                <br />
                1. The <BitLink Href="#dropdown-item"><BitTag Color="BitColor.SecondaryBackground">BitDropdownItem</BitTag></BitLink> class <br />
                2. A <BitTag Color="BitColor.SecondaryBackground">Custom Generic</BitTag> class <br />
                3. The <BitLink Href="#dropdown-option"><BitTag Color="BitColor.SecondaryBackground">BitDropdownOption</BitTag></BitLink> component
            </BitText>
        </NotesTemplate>
        <IntroductionTemplate>
            <BitScrollablePane>
                <BitText Typography="BitTypography.Body2" Color="BitColor.TertiaryForeground">
                    Music: Music Cocktails, Musician: AlexGuz, URL:
                    <a href="https://open.spotify.com/artist/1u0Nlnljg2xGHJV6X7W4i1"
                       target="_blank" style="color:inherit">
                        https://open.spotify.com/artist/1u0Nlnljg2xGHJV6X7W4i1
                    </a>
                </BitText>
            </BitScrollablePane>
        </IntroductionTemplate>
        <Examples>
            <BitPivot Classes="@(new() { HeaderContainer = "pivot-sticky-header" })" MountAll="RenderForMcpClient">
                <BitPivotItem HeaderText="Item">
                    <_BitDropdownItemDemo />
                </BitPivotItem>

                <BitPivotItem HeaderText="Custom">
                    <_BitDropdownCustomDemo />
                </BitPivotItem>

                <BitPivotItem HeaderText="Option">
                    <_BitDropdownOptionDemo />
                </BitPivotItem>
            </BitPivot>
        </Examples>
    </DemoPage>
</div>
