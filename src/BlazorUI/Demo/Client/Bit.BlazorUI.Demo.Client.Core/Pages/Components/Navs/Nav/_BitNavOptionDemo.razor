<DemoExample Title="Chevron & Indentation" RazorCode="@example7RazorCode" Id="example7" PreventRenderForMcpClient>
    <div>
        <b>ReversedChevron</b> moves the chevron to the end of the option, and <b>ChevronDownIconName</b> (or
        <b>ChevronDownIcon</b> for an external library) replaces its icon. <b>IndentValue</b> is the padding added per
        level, <b>IndentPadding</b> the room a childless option keeps for the chevron it lacks, and
        <b>IndentReversedPadding</b> replaces it while the chevron is reversed.
    </div>
    <br /><br /><br />
    <div>ReversedChevron</div><br />
    <BitNav TItem="BitNavOption" ReversedChevron AllExpanded FitWidth>
        <BitNavOption Text="bit platform" IconName="@BitIconName.Website">
            <BitNavOption Text="Home" IconName="@BitIconName.Home" />
            <BitNavOption Text="Products & Services" IconName="@BitIconName.Product">
                <BitNavOption Text="BlazorUI" IconName="@BitIconName.F12DevTools" />
                <BitNavOption Text="Pricing" IconName="@BitIconName.Money" />
            </BitNavOption>
        </BitNavOption>
        <BitNavOption Text="Iconography" IconName="@BitIconName.AppIconDefault" />
    </BitNav>
    <br /><br /><br />
    <div>Custom chevron icon</div><br />
    <BitNav TItem="BitNavOption" ChevronDownIconName="@BitIconName.CircleAdditionSolid" AllExpanded FitWidth>
        <BitNavOption Text="bit platform" IconName="@BitIconName.Website">
            <BitNavOption Text="Home" IconName="@BitIconName.Home" />
            <BitNavOption Text="Products & Services" IconName="@BitIconName.Product">
                <BitNavOption Text="BlazorUI" IconName="@BitIconName.F12DevTools" />
                <BitNavOption Text="Pricing" IconName="@BitIconName.Money" />
            </BitNavOption>
        </BitNavOption>
        <BitNavOption Text="Iconography" IconName="@BitIconName.AppIconDefault" />
    </BitNav>
    <br /><br /><br />
    <div>IndentValue &amp; IndentPadding</div><br />
    <BitNav TItem="BitNavOption" IndentValue="40" IndentPadding="40" AllExpanded FitWidth>
