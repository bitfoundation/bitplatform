    // The center item is a control of its own rather than a destination, so its template replaces the
    // element the navbar would have rendered for it instead of being nested inside it.
    private static readonly List<BitNavBarItem> replacedTemplateNavBarItems =
    [
        new() { Text = "Home", IconName = BitIconName.Home },
        new() { Text = "Search", IconName = BitIconName.Search },
        new()
