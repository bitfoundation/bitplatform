<DemoExample Title="Badge" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11" PreventRenderForMcpClient>
    <div>
        The <b>Badge</b> selector puts a count on the icon and the <b>Dot</b> selector marks it without one. The badge is
        folded into the item's name ("Inbox (12)"); <b>BadgeAriaLabel</b> replaces that text, and is the only way a dot
        is announced.
    </div>
    <br />
    <div class="container">
        <BitNavBar Items="badgeNavBarCustoms"
                   NameSelectors="@(new() { Text = { Selector = item => item.Title },
                                            IconName = { Selector = item => item.ImageName },
                                            Badge = { Selector = item => item.Counter },
                                            BadgeAriaLabel = { Selector = item => item.CounterLabel },
                                            Dot = { Selector = item => item.Marker } })" />
    </div>
</DemoExample>

<DemoExample Title="Templates" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
    <div>
        <b>ItemTemplate</b> replaces the content of every item and the <b>Template</b> selector an item's own. With a
        <b>TemplateRenderMode</b> selector (or <b>ItemTemplateRenderMode</b>) of <b>Replace</b> the template replaces the
        whole item, for an item that is a control of its own; it then owns its clicks, focus and name.
    </div>
    <br />
    <div>ItemTemplate:</div><br />
    <div class="container short">
        <BitNavBar Items="basicNavBarCustoms"
                   NameSelectors="@(new() { Text = { Selector = item => item.Title },
                                            IconName = { Selector = item => item.ImageName } })">
            <ItemTemplate Context="custom">
                <BitText Typography="BitTypography.Caption1" Color="BitColor.Warning">@custom.Title</BitText>
                <BitIcon IconName="@custom.ImageName" Color="BitColor.Success" />
            </ItemTemplate>
        </BitNavBar>
    </div>
    <br /><br />
    <div>Item's template:</div><br />
    <div class="container short">
        <BitNavBar Items="templateNavBarCustoms"
                   NameSelectors="@(new() { Text = { Selector = item => item.Title },
                                            IconName = { Selector = item => item.ImageName },
                                            Template = { Selector = item => item.Fragment } })" />
    </div>
    <br /><br />
    <div>Replaced item template:</div><br />
    <div class="container short">
        <BitNavBar Mode="BitNavMode.Manual"
                   Items="replacedTemplateNavBarCustoms"
                   DefaultSelectedItem="replacedTemplateNavBarCustoms[0]"
                   NameSelectors="@(new() { Text = { Selector = item => item.Title },
                                            IconName = { Selector = item => item.ImageName },
                                            Template = { Selector = item => item.Fragment },
                                            TemplateRenderMode = { Selector = item => item.FragmentRenderMode } })" />
    </div>
</DemoExample>

<DemoExample Title="Events" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
    <div>
        <b>OnItemClick</b> fires on a click and <b>OnSelectItem</b> when the selection moves. Both skip the already
        selected item unless <b>Reselectable</b> is set - for a bar that scrolls its page to the top on a second tap.
    </div>
    <br />
    <BitToggle @bind-Value="reselectable" Label="Reselectable" Inline />
    <br />
    <div class="container short">
        <BitNavBar Items="basicNavBarCustoms"
                   Mode="BitNavMode.Manual"
                   Reselectable="reselectable"
                   OnItemClick="(MenuItem item) => { eventsClickedItem = item; clickCount++; }"
                   OnSelectItem="(MenuItem item) => { eventsSelectedItem = item; selectCount++; }"
                   NameSelectors="@(new() { Text = { Selector = item => item.Title },
                                            IconName = { Selector = item => item.ImageName } })" />
    </div>
    <br />
    <div>Clicked item: @eventsClickedItem?.Title (@clickCount clicks)</div>
    <div>Selected item: @eventsSelectedItem?.Title (@selectCount selections)</div>
</DemoExample>

<DemoExample Title="Binding" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
