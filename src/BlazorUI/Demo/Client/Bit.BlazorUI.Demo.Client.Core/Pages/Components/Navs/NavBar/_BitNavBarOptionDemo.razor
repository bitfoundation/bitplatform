        <BitNavBar TItem="BitNavBarOption" Vertical FitWidth IconOnly>
            <HeaderTemplate>
                <BitButton IconOnly Title="New" IconName="@BitIconName.Add" />
            </HeaderTemplate>
            <Options>
                <BitNavBarOption Text="Home" IconName="@BitIconName.Home" />
