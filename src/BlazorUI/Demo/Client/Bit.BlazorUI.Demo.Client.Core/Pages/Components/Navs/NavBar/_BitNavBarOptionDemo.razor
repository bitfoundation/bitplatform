<DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
    <div>
        Each option is an icon over its text, and a link when it has a <b>Url</b>. The options are written as the
        navbar's content. In the default <b>Automatic</b> mode the option whose URL matches the current page is
        selected and marked <code>aria-current="page"</code>.
    </div>
    <br />
    <div class="container">
        <BitNavBar TItem="BitNavBarOption">
            <BitNavBarOption Text="Home" IconName="@BitIconName.Home" />
            <BitNavBarOption Text="Products" IconName="@BitIconName.ProductVariant" />
            <BitNavBarOption Text="Academy" IconName="@BitIconName.LearningTools" />
            <BitNavBarOption Text="Profile" IconName="@BitIconName.Contact" />
        </BitNavBar>
    </div>
</DemoExample>

<DemoExample Title="Disabled" RazorCode="@example2RazorCode" Id="example2" PreventRenderForMcpClient>
    <div>
        <b>IsEnabled</b> disables the whole navbar or a single option. A disabled option loses its link and its tab
        stop, and is announced as dimmed.
    </div>
    <br />
    <div>Disabled navbar:</div><br />
    <div class="container short">
        <BitNavBar TItem="BitNavBarOption" IsEnabled="false">
            <BitNavBarOption Text="Home" IconName="@BitIconName.Home" />
            <BitNavBarOption Text="Products" IconName="@BitIconName.ProductVariant" />
            <BitNavBarOption Text="Academy" IconName="@BitIconName.LearningTools" />
            <BitNavBarOption Text="Profile" IconName="@BitIconName.Contact" />
        </BitNavBar>
    </div>
    <br /><br />
    <div>Disabled item:</div><br />
    <div class="container short">
        <BitNavBar TItem="BitNavBarOption">
            <BitNavBarOption Text="Home" IconName="@BitIconName.Home" />
            <BitNavBarOption Text="Products" IconName="@BitIconName.ProductVariant" />
            <BitNavBarOption Text="Academy" IconName="@BitIconName.LearningTools" IsEnabled="false" />
            <BitNavBarOption Text="Profile" IconName="@BitIconName.Contact" />
        </BitNavBar>
    </div>
</DemoExample>

<DemoExample Title="Manual Mode" RazorCode="@example3RazorCode" Id="example3" PreventRenderForMcpClient>
    <div>
        In the <b>Manual</b> mode clicks select the options instead of the URL, for a navbar that switches panels of
        one page. <b>DefaultSelectedKey</b> sets the starting option by its <b>Key</b>.
    </div>
    <br />
    <div class="container">
        <BitNavBar TItem="BitNavBarOption" Mode="BitNavMode.Manual" DefaultSelectedKey="home">
            <BitNavBarOption Text="Home" IconName="@BitIconName.Home" Key="home" />
            <BitNavBarOption Text="Products" IconName="@BitIconName.ProductVariant" />
            <BitNavBarOption Text="Academy" IconName="@BitIconName.LearningTools" />
            <BitNavBarOption Text="Profile" IconName="@BitIconName.Contact" />
        </BitNavBar>
    </div>
</DemoExample>

<DemoExample Title="URL Matching" RazorCode="@example4RazorCode" Id="example4" PreventRenderForMcpClient>
    <div>
        <b>Match</b> (per navbar, or per option) compares URLs <b>Exact</b>ly (the default), by <b>Prefix</b>, as a
        <b>Wildcard</b> pattern (<b>?</b>, <b>*</b> within a segment, <b>**</b> across segments) or as a <b>Regex</b>.
        Exact and Prefix ignore case and a trailing slash. <b>AdditionalUrls</b> gives an option more URLs to match.
        All of these are matched against the URL of this page.
    </div>
    <br />
    <div>Exact (the default):</div><br />
    <div class="container short">
        <BitNavBar TItem="BitNavBarOption">
            <BitNavBarOption Text="NavBar" IconName="@BitIconName.GlobalNavButton" Url="/components/navbar" />
            <BitNavBarOption Text="Nav" IconName="@BitIconName.BulletedList" Url="/components/nav" />
        </BitNavBar>
    </div>
    <br /><br />
    <div>Prefix:</div><br />
    <div class="container short">
        <BitNavBar TItem="BitNavBarOption" Match="BitNavMatch.Prefix">
            <BitNavBarOption Text="Components" IconName="@BitIconName.F12DevTools" Url="/components" />
            <BitNavBarOption Text="Iconography" IconName="@BitIconName.AppIconDefault" Url="/iconography" />
        </BitNavBar>
    </div>
    <br /><br />
    <div>Wildcard:</div><br />
    <div class="container short">
        <BitNavBar TItem="BitNavBarOption">
            <BitNavBarOption Text="/components/*" IconName="@BitIconName.F12DevTools" Url="/components/*" Match="BitNavMatch.Wildcard" IsEnabled="false" />
            <BitNavBarOption Text="/iconography/*" IconName="@BitIconName.AppIconDefault" Url="/iconography/*" Match="BitNavMatch.Wildcard" IsEnabled="false" />
        </BitNavBar>
    </div>
    <br /><br />
    <div>Regex:</div><br />
    <div class="container short">
        <BitNavBar TItem="BitNavBarOption">
            <BitNavBarOption Text="^/components/navbar$" IconName="@BitIconName.Code" Url="^/components/navbar$" Match="BitNavMatch.Regex" IsEnabled="false" />
            <BitNavBarOption Text="^/iconography$" IconName="@BitIconName.Code" Url="^/iconography$" Match="BitNavMatch.Regex" IsEnabled="false" />
        </BitNavBar>
    </div>
    <br /><br />
    <div>AdditionalUrls:</div><br />
    <div class="container short">
        <BitNavBar TItem="BitNavBarOption">
            <BitNavBarOption Text="Navs" IconName="@BitIconName.GlobalNavButton" Url="/components/nav" AdditionalUrls="@(["/components/navbar", "/components/breadcrumb"])" />
            <BitNavBarOption Text="Buttons" IconName="@BitIconName.ButtonControl" Url="/components/button" AdditionalUrls="@(["/components/togglebutton"])" />
        </BitNavBar>
    </div>
</DemoExample>

<DemoExample Title="Labels" RazorCode="@example5RazorCode" Id="example5" PreventRenderForMcpClient>
