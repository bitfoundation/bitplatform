@page "/components/pagination"

<PageOutlet Url="components/pagination"
            Title="Pagination"
            Description="Pagination component helps users easily navigate through content, allowing swift browsing across multiple pages or sections." />

<DemoPage Name="Pagination"
          Description="Pagination splits long content into pages and renders the navigation between them: pages collapsing into (optionally clickable) ellipses, first/previous/next/last buttons, a position summary, a page size selector and a jump to a page number. The range comes from a page count or from the number of items and the page size; every control is a button, or a link once it is given an address; and the whole thing is a navigation landmark that names each of its controls."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          SubEnums="componentSubEnums"
          SubClasses="componentSubClasses"
          CssVariables="componentCssVariables"
          GitHubUrl="Navs/Pagination/BitPagination.razor"
          GitHubDemoUrl="Navs/Pagination/BitPaginationDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div><b>Count</b> is all it needs. <b>DefaultSelectedPage</b> picks the page it starts on (the first by default).</div>
        <br />
        <BitPagination Count="5" />
        <br /><br />
        <BitPagination Count="5" DefaultSelectedPage="3" />
    </DemoExample>

    <DemoExample Title="Binding" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
        <div>
            <b>SelectedPage</b> bound one way is only rendered, never changed: apply the clicks <b>OnChange</b> reports yourself.
            Bound two ways it follows the clicks on its own. <b>OnChange</b> runs in both cases.
        </div>
        <br />
        <div class="binding-box">
            <div>One-way:</div>
            <BitPagination Count="5" SelectedPage="oneWaySelectedPage" />
            <BitNumberField @bind-Value="oneWaySelectedPage" Min="1" Max="5" />
            <br />
            <div>Two-way:</div>
            <BitPagination Count="5" @bind-SelectedPage="twoWaySelectedPage" />
            <BitNumberField @bind-Value="twoWaySelectedPage" Min="1" Max="5" />
            <br />
            <div>OnChange:</div>
            <BitPagination Count="5" OnChange="p => onChangeSelectedPage = p" />
            <div>Changed page: <b>@onChangeSelectedPage</b></div>
        </div>
    </DemoExample>

    <DemoExample Title="Variant & Rounded" RazorCode="@example3RazorCode" Id="example3">
        <div>
            <b>Variant</b>: <b>Fill</b> (default), <b>Outline</b> or <b>Text</b>. <b>Rounded</b> turns the buttons and the ellipses
            into circles, or pills where a button is wider than it is tall.
        </div>
        <br />
        <BitPagination Count="5" Variant="BitVariant.Fill" />
        <br /><br />
        <BitPagination Count="5" Variant="BitVariant.Outline" />
        <br /><br />
        <BitPagination Count="5" Variant="BitVariant.Text" />
        <br /><br />
        <BitPagination Count="9" Rounded ShowFirstButton ShowLastButton DefaultSelectedPage="5" />
        <br /><br />
        <BitPagination Count="9" Rounded Variant="BitVariant.Outline" DefaultSelectedPage="5" />
    </DemoExample>

    <DemoExample Title="BoundaryCount & MiddleCount" RazorCode="@example4RazorCode" Id="example4">
        <div>
            <b>BoundaryCount</b> (2 by default) is how many pages stay at each end of the range; <b>MiddleCount</b> (3 by default) how
            many surround the selected one. An ellipsis that would hide a single page shows that page instead.
        </div>
        <br />
        <BitPagination Count="11" BoundaryCount="1" DefaultSelectedPage="6" />
        <br /><br />
        <BitPagination Count="20" BoundaryCount="1" MiddleCount="5" DefaultSelectedPage="10" />
    </DemoExample>

    <DemoExample Title="Ellipsis" RazorCode="@example5RazorCode" Id="example5">
        <div>
            <b>EllipsisText</b> replaces the glyph and <b>EllipsisAriaLabel</b> the name it is announced with.
            <b>ClickableEllipsis</b> makes each gap a control that jumps into the middle of the pages it hides.
        </div>
        <br />
        <BitPagination Count="24" EllipsisText="..." EllipsisAriaLabel="Hidden pages" DefaultSelectedPage="12" />
        <br /><br />
        <BitPagination Count="500" ClickableEllipsis DefaultSelectedPage="250" />
    </DemoExample>

    <DemoExample Title="Navigation buttons" RazorCode="@example6RazorCode" Id="example6">
        <div>
            <b>ShowFirstButton</b> and <b>ShowLastButton</b> add the jumps to the ends; <b>ShowPreviousButton</b> and
            <b>ShowNextButton</b> (on by default) turn those two off. <b>Loop</b> wraps previous and next around the ends.
        </div>
        <br />
        <BitPagination Count="24" ShowFirstButton ShowLastButton />
        <br /><br />
        <BitPagination Count="24" ShowFirstButton ShowLastButton ShowNextButton="false" ShowPreviousButton="false" />
        <br /><br />
        <BitPagination Count="5" Loop />
    </DemoExample>

    <DemoExample Title="Button text & icons" RazorCode="@example7RazorCode" Id="example7">
        <div>
            <b>FirstButtonText</b>, <b>PreviousButtonText</b>, <b>NextButtonText</b> and <b>LastButtonText</b> put a text beside the icon;
            the <b>*ButtonIconName</b> parameters replace the chevrons (only the default chevrons mirror in RTL).
        </div>
        <br />
        <BitPagination Count="12" PreviousButtonText="Previous" NextButtonText="Next" DefaultSelectedPage="5" />
        <br /><br />
        <BitPagination Count="5"
                       ShowFirstButton
                       ShowLastButton
                       NextButtonIconName="@BitIconName.Next"
                       PreviousButtonIconName="@BitIconName.Previous"
                       FirstButtonIconName="@BitIconName.DoubleChevronLeft"
                       LastButtonIconName="@BitIconName.DoubleChevronRight" />
    </DemoExample>

    <DemoExample Title="Compact & Summary" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
        <div>
            <b>ShowPageButtons="false"</b> leaves the navigation buttons alone. <b>ShowSummary</b> adds <i>"Page 4 of 12"</i>, a status
            region a screen reader announces as the page changes; <b>GetSummary</b> rewrites it.
        </div>
        <br />
        <BitPagination Count="12" ShowSummary DefaultSelectedPage="4" />
        <br /><br />
        <BitPagination Count="12" ShowSummary ShowPageButtons="false" ShowFirstButton ShowLastButton DefaultSelectedPage="4" />
        <br /><br />
        <BitPagination Count="24" ShowSummary ShowPageButtons="false" GetSummary="@GetItemsRangeSummary" DefaultSelectedPage="3" />
    </DemoExample>

    <DemoExample Title="Total items & Page size" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
        <div>
            <b>TotalItems</b> replaces <b>Count</b>: the range follows <b>PageSize</b>, the summary counts items, and a new size
            keeps the first item of the page in view. <b>ShowPageSizeSelector</b> picks the size out of <b>PageSizeOptions</b>.
        </div>
        <br />
        <BitPagination ShowSummary
                       ShowPageSizeSelector
                       TotalItems="240"
                       PageSizeOptions="@([10, 25, 100])"
                       @bind-PageSize="totalItemsPageSize"
                       @bind-SelectedPage="totalItemsSelectedPage" />
        <br /><br />
        <div>Page <b>@totalItemsSelectedPage</b>, <b>@totalItemsPageSize</b> items a page</div>
        <br /><br />
        <div>
            With <b>Count</b> instead, recompute it from the size <b>OnPageSizeChange</b> / <b>@@bind-PageSize</b> reports.
            An empty <b>PageSizeText</b> drops the visible label and <b>PageSizeAriaLabel</b> names the select.
        </div>
        <br />
        <BitPagination ShowPageSizeSelector
                       PageSizeText=""
                       Count="@pageSizeCount"
                       PageSizeOptions="@([10, 20, 50])"
                       @bind-PageSize="selectedPageSize"
                       @bind-SelectedPage="pageSizeSelectedPage" />
        <br /><br />
        <div>Page <b>@pageSizeSelectedPage</b> of <b>@pageSizeCount</b>, <b>@selectedPageSize</b> items a page</div>
    </DemoExample>

    <DemoExample Title="Go to page" RazorCode="@example10RazorCode" Id="example10">
        <div>
            <b>ShowGoToPage</b> adds an input that jumps to the page typed into it on Enter or blur; a number past either end lands on
            that end. <b>GoToPageText=""</b> drops the label and <b>GoToPageAriaLabel</b> names the input.
        </div>
        <br />
        <BitPagination Count="1250" ShowGoToPage DefaultSelectedPage="4" />
        <br /><br />
        <BitPagination Count="24" ShowGoToPage GoToPageText="" ShowSummary ShowPageButtons="false" DefaultSelectedPage="4" />
    </DemoExample>

    <DemoExample Title="Hide on single page" RazorCode="@example11RazorCode" Id="example11">
        <div><b>HideOnSinglePage</b> renders nothing at all (summary, selector and jump included) while there is a single page.</div>
        <br />
        <BitPagination Count="1" HideOnSinglePage />
        <div>(nothing is rendered above for a single page)</div>
        <br />
        <BitPagination Count="3" HideOnSinglePage />
    </DemoExample>

    <DemoExample Title="Alignment" RazorCode="@example12RazorCode" Id="example12">
        <div>
            <b>Alignment</b> stretches the pagination across its container and lines the controls up inside it.
            <b>Baseline</b> and <b>Stretch</b> do not apply to a single row.
        </div>
        <br />
        <div class="alignment-box">
            <BitPagination Count="5" Alignment="BitAlignment.Start" />
        </div>
        <br />
        <div class="alignment-box">
            <BitPagination Count="5" Alignment="BitAlignment.Center" />
        </div>
        <br />
        <div class="alignment-box">
            <BitPagination Count="5" Alignment="BitAlignment.End" />
        </div>
        <br />
        <div class="alignment-box">
            <BitPagination Count="5" Alignment="BitAlignment.SpaceBetween" />
        </div>
    </DemoExample>

    <DemoExample Title="Links" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
        <div>
            <b>GetPageHref</b> turns every control into a link, so pages can be crawled, bookmarked or opened in another tab (previous and
            next carry <code>rel="prev"</code> / <code>rel="next"</code>). A link with nowhere to go drops its href and reports
            <code>aria-disabled</code>. A plain click still selects the page; a Ctrl/Cmd/Shift/Alt click leaves it to the browser.
        </div>
        <br />
        <BitPagination Count="linkPageCount"
                       ShowFirstButton
                       ShowLastButton
                       GetPageHref="@GetDemoPageHref"
                       @bind-SelectedPage="linkSelectedPage" />
        <br /><br />
        <div>Selected page: <b>@linkSelectedPage</b></div>
    </DemoExample>

    <DemoExample Title="Accessibility" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
        <div>
            A <code>nav</code> landmark (named by <b>AriaLabel</b>; give each one its own name) holding a list, with the current page marked
            <code>aria-current="page"</code>. The <b>*ButtonAriaLabel</b> parameters name the icon buttons (and double as tooltips),
            <b>GetPageAriaLabel</b> names the pages. A button that disables itself hands the focus to the selected page, and
            <b>FocusAsync</b> puts it back after a reload.
        </div>
        <br />
        <BitPagination @ref="accessiblePagination"
                       Count="12"
                       ShowFirstButton
                       ShowLastButton
                       DefaultSelectedPage="4"
                       AriaLabel="Search results pages"
                       FirstButtonAriaLabel="Go to the first page"
                       LastButtonAriaLabel="Go to the last page"
                       NextButtonAriaLabel="Go to the next page"
                       PreviousButtonAriaLabel="Go to the previous page"
                       GetPageAriaLabel="@GetResultsRangeLabel" />
        <br /><br />
        <BitButton Variant="BitVariant.Outline" OnClick="@(async () => await accessiblePagination.FocusAsync())">Reload & focus the pagination</BitButton>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
        <div>
            <b>BitParams</b> with a <b>BitPaginationParams</b> sets defaults for every pagination inside it - the one place to localize
            them all. A pagination's own parameters win; only unset ones are filled in.
        </div>
        <br />
        <BitParams Parameters="@paginationParams">
            <BitPagination Count="12" DefaultSelectedPage="4" />
            <br /><br />
            <BitPagination Count="12" DefaultSelectedPage="4" Variant="BitVariant.Fill" ShowSummary="false" />
        </BitParams>
        <br /><br />
        <div>Outside the cascade:</div>
        <br />
        <BitPagination Count="12" DefaultSelectedPage="4" />
    </DemoExample>

    <DemoExample Title="Color" RazorCode="@example16RazorCode" Id="example16">
        <div><b>Color</b> paints the buttons, the hover, the selected page and the focus ring from one role.</div>
        <br />
        <div>Primary</div>
        <br />
        <div class="color-row">
            <BitPagination Count="5" Color="BitColor.Primary" />
            <BitPagination Count="5" Color="BitColor.Primary" Variant="BitVariant.Outline" />
            <BitPagination Count="5" Color="BitColor.Primary" Variant="BitVariant.Text" />
        </div>
        <br /><br />
        <div>Secondary</div>
        <br />
        <div class="color-row">
            <BitPagination Count="5" Color="BitColor.Secondary" />
            <BitPagination Count="5" Color="BitColor.Secondary" Variant="BitVariant.Outline" />
            <BitPagination Count="5" Color="BitColor.Secondary" Variant="BitVariant.Text" />
        </div>
        <br /><br />
        <div>Tertiary</div>
        <br />
        <div class="color-row">
            <BitPagination Count="5" Color="BitColor.Tertiary" />
            <BitPagination Count="5" Color="BitColor.Tertiary" Variant="BitVariant.Outline" />
            <BitPagination Count="5" Color="BitColor.Tertiary" Variant="BitVariant.Text" />
        </div>
        <br /><br />
        <div>Info</div>
        <br />
        <div class="color-row">
            <BitPagination Count="5" Color="BitColor.Info" />
            <BitPagination Count="5" Color="BitColor.Info" Variant="BitVariant.Outline" />
            <BitPagination Count="5" Color="BitColor.Info" Variant="BitVariant.Text" />
        </div>
        <br /><br />
        <div>Success</div>
        <br />
        <div class="color-row">
            <BitPagination Count="5" Color="BitColor.Success" />
            <BitPagination Count="5" Color="BitColor.Success" Variant="BitVariant.Outline" />
            <BitPagination Count="5" Color="BitColor.Success" Variant="BitVariant.Text" />
        </div>
        <br /><br />
        <div>Warning</div>
        <br />
        <div class="color-row">
            <BitPagination Count="5" Color="BitColor.Warning" />
            <BitPagination Count="5" Color="BitColor.Warning" Variant="BitVariant.Outline" />
            <BitPagination Count="5" Color="BitColor.Warning" Variant="BitVariant.Text" />
        </div>
        <br /><br />
        <div>SevereWarning</div>
        <br />
        <div class="color-row">
            <BitPagination Count="5" Color="BitColor.SevereWarning" />
            <BitPagination Count="5" Color="BitColor.SevereWarning" Variant="BitVariant.Outline" />
            <BitPagination Count="5" Color="BitColor.SevereWarning" Variant="BitVariant.Text" />
        </div>
        <br /><br />
        <div>Error</div>
        <br />
