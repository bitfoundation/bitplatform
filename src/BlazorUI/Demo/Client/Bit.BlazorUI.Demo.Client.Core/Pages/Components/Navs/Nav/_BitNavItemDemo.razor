    <div><b>Bootstrap Icons:</b></div>
    <br />
    <BitNav Items="bootstrapIconNavItems" ChevronDownIcon="bootstrapChevronIcon" FitWidth />
</DemoExample>

<DemoExample Title="Size" RazorCode="@example16RazorCode" CsharpCode="@example16CsharpCode" Id="example16" PreventRenderForMcpClient>
    <div>
        <b>Size</b> scales the height, text, icon and description of the items, and the height and text of the group
