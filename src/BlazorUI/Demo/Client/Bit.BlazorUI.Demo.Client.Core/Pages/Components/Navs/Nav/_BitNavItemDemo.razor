        item: a background, foreground or border role tints it, while a semantic role fills it and recolors what it holds.
    </div>
    <br /><br /><br />
    <div>Primary</div><br />
    <BitNav FitWidth Color="BitColor.Primary" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br />
    <div>Secondary</div><br />
    <BitNav FitWidth Color="BitColor.Secondary" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br />
    <div>Tertiary</div><br />
    <BitNav FitWidth Color="BitColor.Tertiary" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br />
    <div>Info</div><br />
    <BitNav FitWidth Color="BitColor.Info" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br />
    <div>Success</div><br />
    <BitNav FitWidth Color="BitColor.Success" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br />
    <div>Warning</div><br />
    <BitNav FitWidth Color="BitColor.Warning" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br />
    <div>SevereWarning</div><br />
    <BitNav FitWidth Color="BitColor.SevereWarning" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br />
    <div>Error</div><br />
    <BitNav FitWidth Color="BitColor.Error" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br /><br />
    <div><b>Accent</b>:</div>
    <br /><br />
    <div>Primary</div><br />
    <BitNav FitWidth Accent="BitColor.Primary" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br />
    <div>Success</div><br />
    <BitNav FitWidth Accent="BitColor.Success" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br />
    <div>Warning</div><br />
    <BitNav FitWidth Accent="BitColor.Warning" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
    <br /><br /><br />
    <div>Error</div><br />
    <BitNav FitWidth Accent="BitColor.Error" Items="colorNavItems" Mode="BitNavMode.Manual" DefaultSelectedItem="colorNavItems[0]" />
</DemoExample>

<DemoExample Title="External Icons" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
    <div>
        <b>Icon</b> takes the CSS classes of an external icon library (FontAwesome, Bootstrap Icons, ...) and wins over
