    </div>
    <br /><br /><br />
    <div>Small</div><br />
    <BitNav FitWidth Size="BitSize.Small" Items="sizeNavItems" />
    <br /><br /><br />
    <div>Medium</div><br />
    <BitNav FitWidth Size="BitSize.Medium" Items="sizeNavItems" />
