@page "/components/navbar"
@inherits AppComponentBase

<PageOutlet Url="components/navbar"
            Title="NavBar"
            Description="A bar of navigation links to the main areas of an app: automatic selection by URL, selected icons, line and pill indicators, badges, icon-only and rail layouts, scrolling, header and footer content, full keyboard support and public CSS variables." />

<div>
    <DemoPage Name="NavBar"
              SecondaryNames="@(["NavMenu", "TabPanel", "BottomNavigation", "TabBar", "NavigationRail"])"
              Description="A bar of navigation links to the main areas of an app - the bottom navigation of a mobile app, or a navigation rail down its side."
              Parameters="componentParameters"
              PublicMembers="componentPublicMembers"
              SubClasses="componentSubClasses"
              SubEnums="componentSubEnums"
              CssVariables="componentCssVariables"
              GitHubUrl="Navs/NavBar/BitNavBar.razor"
              GitHubDemoUrl="Navs/NavBar/BitNavBarDemo.razor">
        <NotesTemplate>
            <BitText>
                Each item is an icon over its text, and a link when it has a URL. In the default
                <BitTag Color="BitColor.SecondaryBackground">Automatic</BitTag> mode the current URL selects the item;
                in <BitTag Color="BitColor.SecondaryBackground">Manual</BitTag> mode clicks and the two-way
                <BitTag Color="BitColor.SecondaryBackground">SelectedItem</BitTag> do. The items are a list inside a
                <code>nav</code> landmark, the selected one carries <code>aria-current</code>, and the arrow keys,
                Home and End move the focus along the bar.
                <br /><br />
                BitNavBar is a <BitTag Color="BitColor.SecondaryBackground">Multi-API</BitTag> component that takes its items as:
                <br />
                1. The <BitLink Href="#navbar-item"><BitTag Color="BitColor.SecondaryBackground">BitNavBarItem</BitTag></BitLink> class <br />
                2. A <BitTag Color="BitColor.SecondaryBackground">Custom Generic</BitTag> class <br />
                3. The <BitLink Href="#navbar-option"><BitTag Color="BitColor.SecondaryBackground">BitNavBarOption</BitTag></BitLink> component
            </BitText>
        </NotesTemplate>
        <Examples>
            <BitPivot Classes="@(new() { HeaderContainer = "pivot-sticky-header" })" MountAll="RenderForMcpClient">
                <BitPivotItem HeaderText="Item">
                    <_BitNavBarItemDemo />
                </BitPivotItem>

                <BitPivotItem HeaderText="Custom">
                    <_BitNavBarCustomDemo />
                </BitPivotItem>

                <BitPivotItem HeaderText="Option">
                    <_BitNavBarOptionDemo />
                </BitPivotItem>
            </BitPivot>
        </Examples>
    </DemoPage>
</div>
