        <br />
        <BitStack Horizontal Wrap Gap="1rem" FitHeight VerticalAlign="BitAlignment.Center">
            <BitDropMenu Text="Small" Size="BitSize.Small" IconName="@BitIconName.Filter">
                <BitStack Gap="0.5rem" Style="padding:0.5rem">
