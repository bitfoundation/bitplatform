@page "/components/dropmenu"

<PageOutlet Url="components/dropmenu"
            Title="DropMenu"
            Description="DropMenu is a button that opens a callout hosting any content: an action list, a form, a filter panel, or a navigation menu." />

<DemoPage Name="DropMenu"
          Description="DropMenu is a button that opens a callout hosting any content you put in it: an action list, a form, a filter panel, or a navigation menu. The callout is anchored to the button, flips to the side with the most room, can be sized in every direction, and closes on an outside click or the Escape key. It opens on a click or on hover, carries the menu-button semantics and the keyboard that goes with them, can keep the focus inside itself while it is open, and turns into a swipeable side panel on small screens."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          GitHubUrl="Navs/DropMenu/BitDropMenu.razor"
          GitHubDemoUrl="Navs/DropMenu/BitDropMenuDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>
            The <b>Text</b> parameter labels the button and the content of the component becomes the body of the callout.
            <b>IsEnabled</b> turns the whole drop menu off, <b>Transparent</b> drops the background of the button,
            <b>NoShadow</b> drops the box-shadow of the callout, and <b>FullWidth</b> stretches the button to the
            available width.
        </div>
        <br />
        <BitDropMenu Text="Basic">
            <BitStack Gap="1rem" Style="padding:0.5rem">
                <BitText Typography="BitTypography.Subtitle1">This is the content</BitText>
                <BitButton>Click me</BitButton>
                <BitToggle>Toggle me</BitToggle>
