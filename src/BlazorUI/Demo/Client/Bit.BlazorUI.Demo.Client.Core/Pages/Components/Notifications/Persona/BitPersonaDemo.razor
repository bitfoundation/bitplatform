    <DemoExample Title="External Icons" RazorCode="@example17RazorCode" CsharpCode="@example17CsharpCode" Id="example17">
        <div>
            Every icon - action, coin, presence and unknown - takes a <b>BitIconInfo</b> beside its name, for FontAwesome, Bootstrap Icons or any other font.
        </div>
        <br />
