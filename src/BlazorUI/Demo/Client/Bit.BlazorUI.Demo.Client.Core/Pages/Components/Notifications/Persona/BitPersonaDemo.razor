            <BitPersona Dir="BitDir.Rtl"
                        PrimaryText="Saleh Khafan"
                        SecondaryText="یک نام لاتین"
                        Presence="BitPersonaPresence.Online"
                        Size="@BitPersonaSize.Size56" />
            <br /><br />
            <BitPersona Dir="BitDir.Rtl"
                        PrimaryText="صالح یوسف نژاد"
