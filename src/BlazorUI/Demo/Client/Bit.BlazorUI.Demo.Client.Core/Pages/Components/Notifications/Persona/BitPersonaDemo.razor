    <DemoExample Title="Size" RazorCode="@example20RazorCode" CsharpCode="@example20CsharpCode" Id="example20">
        <div>
            <strong>Size</strong> runs from <strong>Size8</strong>, which is a presence dot and a name and
            no coin at all, up to <strong>Size120</strong>. The size also decides how many of the four
            texts there is room for: the secondary from 40 up, the tertiary from 72, the optional from 100.
            <strong>ShowSecondaryText</strong> puts the second line back on the sizes that leave no room for
            it, which is what a compact list of people with a role under each name wants.
            <strong>CoinSize</strong> overrides the coin with a pixel size of your own, and scales the
            initials and the presence dot along with it. <strong>HidePersonaDetails</strong> drops the
            texts and leaves the coin alone, which then names itself after the primary text for anyone who
            cannot see it.
        </div>
        <br />
        <BitCheckbox @bind-Value="isDetailsShown" Label="Include BitPersona details" />
        <br /><br /><br /><br />
        <div>Size 8 Persona:</div><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Secondary"
                    Size="BitPersonaSize.Size8"
                    HidePersonaDetails="!isDetailsShown"
                    Presence="BitPersonaPresence.Online"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br /><br /><br />
        <div>Size 24 Persona:</div><br />
        <BitPersona PrimaryText="Xafan Salina"
