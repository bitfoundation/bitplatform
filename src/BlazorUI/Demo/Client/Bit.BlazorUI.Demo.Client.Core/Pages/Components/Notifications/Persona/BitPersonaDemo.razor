@page "/components/persona"

<PageOutlet Url="components/persona"
            Title="Persona"
            Description="The Persona is a visual representation of a person: their picture or initials, the name and details beside it, the presence dot that says whether they are around, and a coin that can be a button or a link." />

<DemoPage Name="Persona"
          SecondaryNames="@(["Avatar"])"
          Description="The Persona shows who someone is: a coin holding their picture, their initials or an icon, up to four lines of detail beside it and a presence dot. Nine sizes from a bare dot to 120px (or any CoinSize), three shapes, three coin variants, palette or hashed coin colors, active and inactive states, a coin that is a button or a link, and a vertical layout for cards and tiles."
          Parameters="componentParameters"
          CssVariables="componentCssVariables"
          SubEnums="componentSubEnums"
          SubClasses="componentSubClasses"
          GitHubUrl="Notifications/Persona/BitPersona.razor"
          GitHubDemoUrl="Notifications/Persona/BitPersonaDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>
            <b>PrimaryText</b> is the name and <b>SecondaryText</b> the line under it. The coin shows the picture at
            <b>ImageUrl</b>, else the initials of the name, else a person icon.
        </div>
        <br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Software Engineer"
                    Size="BitPersonaSize.Size72"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Saleh Khafan"
                    SecondaryText="Developer"
                    Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona PrimaryText="+1 (555) 016 7788"
                    SecondaryText="No initials to take"
                    Size="BitPersonaSize.Size72" />
    </DemoExample>

    <DemoExample Title="Presence" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
        <div>
            <b>Presence</b> puts a status dot on the coin, named after its status for screen readers.
            <b>PresenceTitles</b> (or <b>PresenceTitle</b>) replaces that name and adds a tooltip; <b>PresenceIconNames</b>
            (or <b>PresenceIconName</b>) puts a glyph in the dot, shown on coins of 40px and up.
        </div>
        <br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Online"
                    Presence="BitPersonaPresence.Online"
                    Size="BitPersonaSize.Size56"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Away"
                    Presence="BitPersonaPresence.Away"
                    Size="BitPersonaSize.Size56"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Busy"
                    Presence="BitPersonaPresence.Busy"
                    Size="BitPersonaSize.Size56"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Dnd (do not disturb)"
                    Presence="BitPersonaPresence.Dnd"
                    Size="BitPersonaSize.Size56"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Offline"
                    Presence="BitPersonaPresence.Offline"
                    Size="BitPersonaSize.Size56"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Blocked"
                    Presence="BitPersonaPresence.Blocked"
                    Size="BitPersonaSize.Size56"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="OutOfOffice"
                    Presence="BitPersonaPresence.OutOfOffice"
                    Size="BitPersonaSize.Size56"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Unknown"
                    Presence="BitPersonaPresence.Unknown"
                    Size="BitPersonaSize.Size56"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br /><br />
        <div>A glyph in the dot (<b>PresenceIconNames</b>), and a single status's glyph (<b>PresenceIconName</b>):</div>
        <br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Software Engineer"
                    Presence="BitPersonaPresence.Online"
                    PresenceIconNames="_iconNames"
                    Size="BitPersonaSize.Size100"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Out of office"
                    Presence="BitPersonaPresence.OutOfOffice"
                    PresenceIconName="@BitIconName.Airplane"
                    Size="BitPersonaSize.Size100"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br /><br />
        <div>Named for the reader (<b>PresenceTitles</b>) - hover the dot:</div>
        <br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Software Engineer"
                    Presence="BitPersonaPresence.Dnd"
                    PresenceTitles="_presenceTitles"
                    Size="BitPersonaSize.Size100"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
    </DemoExample>

    <DemoExample Title="Initials" RazorCode="@example3RazorCode" Id="example3">
        <div>
            Two words give two initials, three skip the middle one; asides, punctuation and an address's domain are dropped.
            A name with no letters gets the icon unless <b>AllowPhoneInitials</b> is set. <b>ImageInitials</b> overrides it all,
            stepped down to fit when longer than two letters. <b>ShowInitialsUntilImageLoads</b> shows them while the picture loads, and after it fails.
        </div>
        <br />
        <BitPersona PrimaryText="Saleh Khafan" SecondaryText="Two words" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona PrimaryText="Ted Alan Randall" SecondaryText="Three words - the middle one is skipped" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona PrimaryText="Elvia Atkins (Contoso)" SecondaryText="The aside is dropped" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona PrimaryText="carlos.slattery@@contoso.com" SecondaryText="An address, not a name" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona AllowPhoneInitials PrimaryText="+1 (555) 016 7788" SecondaryText="AllowPhoneInitials" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona PrimaryText="Saleh Khafan" SecondaryText="ImageInitials" ImageInitials="SK!" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona PrimaryText="Saleh Khafan" SecondaryText="Four letters, stepped down to fit" ImageInitials="SKHN" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona PrimaryText="Saleh Khafan"
                    SecondaryText="Broken image url"
                    Size="BitPersonaSize.Size72"
                    ShowInitialsUntilImageLoads
                    ImageUrl="invalid-src" />
    </DemoExample>

    <DemoExample Title="Icon & Unknown" RazorCode="@example4RazorCode" Id="example4">
        <div>
            <b>CoinIconName</b> (or <b>CoinIcon</b>) puts an icon in place of the initials - a team, a room, a service account.
            <b>Unknown</b> marks a person nobody could resolve, over any picture or initials; <b>UnknownIconName</b> (or <b>UnknownIcon</b>) replaces its question mark.
        </div>
        <br />
        <BitPersona PrimaryText="Design Team"
                    SecondaryText="12 members"
                    CoinIconName="@BitIconName.Group"
                    Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona PrimaryText="Build Bot"
                    SecondaryText="Service account"
                    CoinIconName="@BitIconName.Robot"
                    Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona PrimaryText="Unknown"
                    SecondaryText="Developer"
                    Size="BitPersonaSize.Size72"
                    Unknown />
        <br /><br />
        <BitPersona PrimaryText="Unresolved"
                    SecondaryText="Custom unknown icon"
                    Size="BitPersonaSize.Size72"
                    UnknownIconName="@BitIconName.StatusErrorFull"
                    Unknown />
    </DemoExample>

    <DemoExample Title="Shape & Variant" RazorCode="@example5RazorCode" Id="example5">
        <div>
            <b>Shape</b> is <b>Circular</b> (default), <b>Rounded</b> or <b>Square</b>; the presence dot follows the corner out.
            <b>Squared</b> is the older shorthand for <b>Rounded</b>. <b>CoinVariant</b> spends the coin color as a <b>Fill</b> (default),
            an <b>Outline</b> or <b>Text</b> only.
        </div>
        <br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Circular (default)"
                    Presence="BitPersonaPresence.Online"
                    Size="BitPersonaSize.Size72"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona Shape="BitPersonaShape.Rounded"
                    PrimaryText="Xafan Salina"
                    SecondaryText="Rounded"
                    Presence="BitPersonaPresence.Online"
                    Size="BitPersonaSize.Size72"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona Shape="BitPersonaShape.Square"
                    PrimaryText="Design Team"
                    SecondaryText="Square"
                    CoinIconName="@BitIconName.Group"
                    Size="BitPersonaSize.Size72" />
        <br /><br /><br />
        <BitPersona PrimaryText="Saleh Xafan"
                    SecondaryText="Fill (default)"
                    Size="BitPersonaSize.Size72"
                    CoinVariant="BitVariant.Fill" />
        <br /><br />
        <BitPersona PrimaryText="Saleh Xafan"
                    SecondaryText="Outline"
                    Size="BitPersonaSize.Size72"
                    CoinVariant="BitVariant.Outline" />
        <br /><br />
        <BitPersona PrimaryText="Saleh Xafan"
                    SecondaryText="Text"
                    Size="BitPersonaSize.Size72"
                    CoinVariant="BitVariant.Text" />
    </DemoExample>

    <DemoExample Title="Active" RazorCode="@example6RazorCode" Id="example6">
        <div>
            <b>Active</b> points at the person a view is about - a <b>Ring</b> (default), a <b>Shadow</b> or both, by <b>ActiveAppearance</b>.
            <b>Inactive</b> shrinks and fades everyone else back. On a surface of its own, retune the ring's gap with <b>--bit-Persona-ring-gap-color</b>.
        </div>
        <br />
        <BitPersona Active
                    PrimaryText="Xafan Salina"
                    SecondaryText="Ring (default)"
                    Size="BitPersonaSize.Size72"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona Active
                    ActiveAppearance="BitPersonaActiveAppearance.Shadow"
                    PrimaryText="Xafan Salina"
                    SecondaryText="Shadow"
                    Size="BitPersonaSize.Size72"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona Active
                    ActiveAppearance="BitPersonaActiveAppearance.RingShadow"
                    PrimaryText="Xafan Salina"
                    SecondaryText="RingShadow"
                    Size="BitPersonaSize.Size72"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona Inactive
                    PrimaryText="Saleh Khafan"
                    SecondaryText="Inactive"
                    Size="BitPersonaSize.Size72" />
        <br /><br /><br />
        <div>On a tinted surface, with the gap cut in that surface:</div>
        <br />
        <div style="padding: 1rem; border-radius: 0.5rem; background-color: var(--bit-clr-bg-ter);">
            <BitPersona Active
                        PrimaryText="Xafan Salina"
                        SecondaryText="Retuned gap color"
                        Size="BitPersonaSize.Size72"
                        Style="--bit-Persona-ring-gap-color: var(--bit-clr-bg-ter);"
                        ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        </div>
    </DemoExample>

    <DemoExample Title="Action" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
        <div>
            <b>OnActionClick</b> adds a small button at the foot of the coin, revealed on hover or focus; <b>ActionIconName</b> and
            <b>ActionButtonTitle</b> dress it and <b>ActionTemplate</b> replaces it. <b>OnImageClick</b> makes the coin itself a button
            that reveals <b>ImageOverlayText</b> - an empty text leaves it unveiled.
        </div>
        <br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Software Engineer"
                    TertiaryText="In a meeting"
                    OptionalText="Available at 4:00pm"
                    Size="BitPersonaSize.Size120"
                    Presence="BitPersonaPresence.Online"
                    OnActionClick="() => actionClickCount++"
                    ActionIconName="@BitIconName.CloudUpload"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <p>Action click count: @actionClickCount</p>
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Software Engineer"
                    TertiaryText="In a meeting"
                    Size="BitPersonaSize.Size120"
                    ImageOverlayText="Change photo"
                    OnImageClick="() => imageClickCount++"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Saleh Khafan"
                    SecondaryText="No picture, same overlay"
                    Size="BitPersonaSize.Size120"
                    ImageOverlayText="Add photo"
                    OnImageClick="() => imageClickCount++" />
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Empty ImageOverlayText"
                    Size="BitPersonaSize.Size120"
                    ImageOverlayText=""
                    OnImageClick="() => imageClickCount++"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <p>Image click count: @imageClickCount</p>
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="ActionTemplate"
                    Size="BitPersonaSize.Size120"
                    OnActionClick="() => actionClickCount++"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png">
            <ActionTemplate>
                <BitButton Size="BitSize.Small" Variant="BitVariant.Text" OnClick="() => actionClickCount++">Upload</BitButton>
            </ActionTemplate>
        </BitPersona>
    </DemoExample>

    <DemoExample Title="Link" RazorCode="@example8RazorCode" Id="example8">
        <div>
            <b>Href</b> makes the coin a real link to the person's profile, named after them. <b>Target</b> <b>_blank</b> adds
            <b>rel="noopener"</b> unless <b>Rel</b> says otherwise, and <b>ImageOverlayText</b> puts a veil back on it.
        </div>
        <br />
        <BitPersona Href="/components/persona"
                    PrimaryText="Xafan Salina"
                    SecondaryText="Opens this page"
                    Presence="BitPersonaPresence.Online"
                    Size="BitPersonaSize.Size72"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona Href="https://github.com/bitfoundation/bitplatform"
                    Target="_blank"
                    PrimaryText="bit platform"
                    SecondaryText="Opens in a new tab"
                    CoinIconName="@BitIconName.Globe"
                    Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona Href="/components/persona"
                    ImageOverlayText="View profile"
                    PrimaryText="Xafan Salina"
                    SecondaryText="With a veil"
                    Size="BitPersonaSize.Size72"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
    </DemoExample>

    <DemoExample Title="Disabled" RazorCode="@example9RazorCode" Id="example9">
        <div>
            <b>IsEnabled</b> false dims the coin and texts; the action button is disabled, a clickable coin leaves the tab order and a link coin drops its href.
        </div>
        <br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Software Engineer"
                    Presence="BitPersonaPresence.Online"
                    Size="BitPersonaSize.Size72"
                    IsEnabled="false"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitPersona PrimaryText="Saleh Khafan"
                    SecondaryText="Clickable, disabled"
                    Size="BitPersonaSize.Size72"
                    OnImageClick="() => {}"
                    IsEnabled="false" />
        <br /><br />
        <BitPersona Href="/components/persona"
                    PrimaryText="Xafan Salina"
                    SecondaryText="Link, disabled"
                    Size="BitPersonaSize.Size72"
                    IsEnabled="false"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
    </DemoExample>

    <DemoExample Title="Image loading" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
        <div>
            <b>OnImageLoad</b> and <b>OnImageError</b> report the picture's fate; a failed one falls back to the initials by itself.
            <b>ImageLoading</b> picks <b>Lazy</b> or <b>Eager</b>, <b>ImageAttributes</b> reaches any other img attribute, and
            <b>ImageFadeIn</b> fades the picture in.
        </div>
        <br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Loads, lazily"
                    Size="BitPersonaSize.Size72"
                    ImageLoading="BitImageLoading.Lazy"
                    OnImageLoad="() => imageLoadCount++"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <p>Image load count: @imageLoadCount</p>
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Fails"
                    Size="BitPersonaSize.Size72"
                    OnImageError="() => imageErrorCount++"
                    ImageUrl="invalid-image-url" />
        <p>Image error count: @imageErrorCount</p>
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Eager, not draggable"
                    Size="BitPersonaSize.Size72"
                    ImageLoading="BitImageLoading.Eager"
                    ImageAttributes="@(new() { { "draggable", "false" }, { "decoding", "async" } })"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br />
        <BitButton Size="BitSize.Small" Variant="BitVariant.Outline" OnClick="() => isFadeInPersonaShown = !isFadeInPersonaShown">
            @(isFadeInPersonaShown ? "Hide" : "Show")
        </BitButton>
        <br /><br />
        @if (isFadeInPersonaShown)
        {
            <BitPersona ImageFadeIn
                        PrimaryText="Xafan Salina"
                        SecondaryText="Faded in"
                        Size="BitPersonaSize.Size72"
                        ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        }
    </DemoExample>

    <DemoExample Title="Responsive image" RazorCode="@example11RazorCode" Id="example11">
        <div>
            <b>ImageSrcSet</b> and <b>ImageSizes</b> let the browser pick the sharpest copy the screen needs; candidates alone,
            without <b>ImageUrl</b>, still make a picture. <b>ImageAlt</b> describes the picture - unset, it is decorative, since the name already says who this is.
        </div>
        <br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Software Engineer"
                    Size="BitPersonaSize.Size72"
                    ImageAlt="Xafan Salina smiling at the camera"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png"
                    ImageSizes="72px"
                    ImageSrcSet="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female-72.png 72w, /_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png 96w" />
        <br /><br />
        <BitPersona PrimaryText="Xafan Salina"
                    SecondaryText="Candidates only"
                    Size="BitPersonaSize.Size72"
                    ImageSizes="72px"
                    ImageSrcSet="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female-72.png 72w, /_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png 96w" />
    </DemoExample>

    <DemoExample Title="Templates" RazorCode="@example12RazorCode" Id="example12">
        <div>
            Each text row has a template (<b>PrimaryTextTemplate</b>, <b>SecondaryTextTemplate</b>, <b>TertiaryTextTemplate</b>,
            <b>OptionalTextTemplate</b>); <b>ImageOverlayTemplate</b> replaces the overlay and <b>CoinTemplate</b> the coin's contents.
        </div>
        <br />
        <BitPersona Size="BitPersonaSize.Size100" ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" OnImageClick="() => {}">
            <PrimaryTextTemplate>
                <BitIcon IconName="@BitIconName.Contact" Class="custom-ico" />
                Xafan Salina
            </PrimaryTextTemplate>
            <SecondaryTextTemplate>
                <BitIcon IconName="@BitIconName.Suitcase" Class="custom-ico" />
                Software Engineer
            </SecondaryTextTemplate>
            <TertiaryTextTemplate>
                <BitIcon IconName="@BitIconName.JoinOnlineMeeting" Class="custom-ico" />
                In a meeting
            </TertiaryTextTemplate>
            <OptionalTextTemplate>
                <BitIcon IconName="@BitIconName.Clock" Class="custom-ico" />
                Available at 7:00pm
            </OptionalTextTemplate>
            <ImageOverlayTemplate>
                <BitIcon IconName="@BitIconName.Edit" Class="custom-ico" />
                Edit image
            </ImageOverlayTemplate>
        </BitPersona>
        <br /><br />
        <BitPersona Size="BitPersonaSize.Size100" PrimaryText="Xafan Salina" SecondaryText="CoinTemplate" Presence="BitPersonaPresence.Online" CoinVariant="BitVariant.Text">
            <CoinTemplate>
                <img src="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" width="100" height="100" class="custom-coin" />
            </CoinTemplate>
        </BitPersona>
    </DemoExample>

    <DemoExample Title="AutoCoinColor" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
        <div>
            <b>AutoCoinColor</b> picks the coin color by a stable hash of <b>CoinColorSeed</b> (a user id keeps it from moving
            with the display name), else of the initials or name. <b>AutoCoinColors</b> narrows the palette; an explicit <b>CoinColor</b> wins.
        </div>
        <br />
        <BitPersona AutoCoinColor PrimaryText="Xafan Salina" SecondaryText="Software Engineer" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona AutoCoinColor PrimaryText="Saleh Khafan" SecondaryText="Developer" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona AutoCoinColor PrimaryText="Ted Randall" SecondaryText="Designer" Size="BitPersonaSize.Size72" />
        <br /><br /><br />
        <div>Same seed, same color (<b>CoinColorSeed</b>):</div>
        <br />
        <BitPersona AutoCoinColor CoinColorSeed="u-1024" PrimaryText="Xafan Salina" SecondaryText="u-1024" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona AutoCoinColor CoinColorSeed="u-1024" PrimaryText="X. Salina" SecondaryText="u-1024" Size="BitPersonaSize.Size72" />
        <br /><br /><br />
        <div>A palette of your own (<b>AutoCoinColors</b>), and an explicit <b>CoinColor</b>:</div>
        <br />
        <BitPersona AutoCoinColor AutoCoinColors="_coinColors" PrimaryText="Carlos Slattery" SecondaryText="Manager" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona AutoCoinColor AutoCoinColors="_coinColors" PrimaryText="Elvia Atkins" SecondaryText="QA Engineer" Size="BitPersonaSize.Size72" />
        <br /><br />
        <BitPersona AutoCoinColor CoinColor="BitColor.Success" PrimaryText="Xafan Salina" SecondaryText="Always green" Size="BitPersonaSize.Size72" />
    </DemoExample>

    <DemoExample Title="Layout" RazorCode="@example14RazorCode" Id="example14">
        <div>
            <b>Reversed</b> puts the coin after the texts. <b>Vertical</b> stacks the coin over them, centered, for cards and tiles.
            <b>FullWidth</b> stretches the persona across its container so long texts ellipsize; each row keeps a tooltip of its
            full text unless <b>ShowOverflowTooltip</b> is false.
        </div>
        <br />
        <BitPersona Reversed
                    PrimaryText="Xafan Salina"
                    SecondaryText="Reversed"
