                    SecondaryText="Secondary"
                    Size=@BitPersonaSize.Size32
                    HidePersonaDetails="!isDetailsShown"
                    ImageUrl="/_content/Bit.BlazorUI.Demo.Client.Core/images/persona/persona-female.png" />
        <br /><br /><br /><br />
        <div>Size 40 Persona:</div><br />
