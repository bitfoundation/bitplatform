        <DemoExample Title="Alignment" RazorCode="@example4RazorCode" Id="example4">
            <div>
                <b>Alignment</b> places the icon and the content along the width of the message. It only shows
                when the content is narrower than the message, which is the case for a short single-line notice.
            </div>
            <br />
            <div class="box">
                <BitMessage Alignment="BitAlignment.Start" Color="BitColor.Primary">Start</BitMessage>
                <BitMessage Alignment="BitAlignment.Center" Color="BitColor.Secondary">Center</BitMessage>
                <BitMessage Alignment="BitAlignment.End" Color="BitColor.Tertiary">End</BitMessage>
