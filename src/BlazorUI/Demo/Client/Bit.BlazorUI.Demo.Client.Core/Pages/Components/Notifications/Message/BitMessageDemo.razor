        <DemoExample Title="Square" RazorCode="@example13RazorCode" Id="example13">
            <div>
                <b>Square</b> removes the rounded corners so the message can run edge to edge as a page-wide banner,
                flush against the sides of whatever contains it.
            </div>
            <br />
            <div class="banner-host">
                <BitMessage Square OnDismiss="() => {}">
                    Scheduled maintenance starts at 02:00 UTC. Save your work before then.
                </BitMessage>
                <div class="banner-body">The content of the page sits below the banner.</div>
            </div>
        </DemoExample>

