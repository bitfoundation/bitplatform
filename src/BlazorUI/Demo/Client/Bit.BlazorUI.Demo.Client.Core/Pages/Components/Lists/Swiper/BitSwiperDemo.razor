@page "/components/swiper"

<PageOutlet Url="components/swiper"
            Title="Swiper"
            Description="Swiper (touch slider) scrolls a row of items freely, with navigation buttons, dots, drag, keyboard, wheel, snapping, autoplay and responsive multi-item layouts." />

<DemoPage Name="Swiper"
          SecondaryNames="@(["TouchSlider"])"
          Description="Swiper (touch slider) shows items in a natively scrolling row: touch swipes keep the platform's momentum, and it can be moved with buttons, dots, drag, keyboard, wheel, code or autoplay. Unlike the Carousel it does not page through slides; it can snap to items, fit a responsive number of them, scroll vertically, and follows the ARIA carousel pattern."
          Parameters="componentParameters"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          PublicMembers="componentPublicMembers"
          CssVariables="componentCssVariables"
          GitHubUrl="Lists/Swiper/BitSwiper.razor"
          GitHubDemoUrl="Lists/Swiper/BitSwiperDemo.razor">

    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>
            Items keep their own size and scroll in a row. Drag it, swipe it, or focus it and use the arrow and
            Home/End keys; each button hides at the end it cannot pass. Name the region with <b>AriaLabel</b>.
        </div>
        <br />
        <div>
            <BitSwiper AriaLabel="Landscape photos">
                @for (int i = 1; i <= 32; i++)
                {
                    var index = i;
                    var imageIndex = (index - 1) % 4 + 1;
                    <BitSwiperItem Class="item">
                        <div class="number">Item @index</div>
                        <img class="image" alt="Landscape @index" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img@(imageIndex).jpg" />
                    </BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="Navigation" RazorCode="@example2RazorCode" Id="example2">
        <div>
            <b>ScrollItemsCount</b> sets the step of the buttons, arrow keys and wheel (never overshooting the end).
            <b>Rewind</b> wraps the buttons and arrow keys around the ends. <b>HideNextPrev</b> removes the buttons.
        </div>
        <br />
        <div>Two at a time, rewinding at the ends:</div>
        <br />
        <div>
            <BitSwiper ScrollItemsCount="2" Rewind>
                @for (int i = 1; i <= 12; i++)
                {
                    var index = i;
                    var imageIndex = (index - 1) % 4 + 1;
                    <BitSwiperItem Class="item">
                        <div class="number">Item @index</div>
                        <img class="image" alt="Landscape @index" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img@(imageIndex).jpg" />
                    </BitSwiperItem>
                }
            </BitSwiper>
        </div>
        <br /><br />
        <div>No buttons:</div>
        <br />
        <div>
            <BitSwiper HideNextPrev>
                @for (int i = 1; i <= 12; i++)
                {
                    var index = i;
                    var imageIndex = (index - 1) % 4 + 1;
                    <BitSwiperItem Class="item">
                        <div class="number">Item @index</div>
                        <img class="image" alt="Landscape @index" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img@(imageIndex).jpg" />
                    </BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="Multiple items" RazorCode="@example3RazorCode" Id="example3">
        <div>
            <b>VisibleItemsCount</b> sizes the items so that many fit at once, with <b>Gap</b> (any CSS length)
            between them. <b>Peek</b> keeps room at both ends for the neighbors to show through, a hint there is more.
            The <b>Xs</b>-<b>Xxl</b> variants apply from their breakpoint up, measured on the swiper's own width, not
            the window's.
        </div>
        <br />
        <div>Three at a time, 1rem apart, the neighbors peeking in 3rem:</div>
        <br />
        <div>
            <BitSwiper VisibleItemsCount="3" Gap="1rem" Peek="3rem">
                @for (int i = 1; i <= 16; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
        <br /><br />
        <div>Responsive, one to five (resize the window):</div>
        <br />
        <div>
            <BitSwiper VisibleItemsCount="1" VisibleItemsCountSm="2" VisibleItemsCountMd="3" VisibleItemsCountLg="5" Gap="0.5rem">
                @for (int i = 1; i <= 16; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="Snap" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
        <div>
            <b>Snap</b> settles the swiper on an item - at its <b>Start</b>, <b>Center</b> or <b>End</b> - instead of
            wherever the scroll ran out. It is CSS scroll snapping, so touch swipes settle the same way.
        </div>
        <br />
        <BitChoiceGroup @bind-Value="snap" Horizontal TItem="BitChoiceGroupOption<BitSwiperSnap>" TValue="BitSwiperSnap" Label="Snap">
            <BitChoiceGroupOption Text="Start" Value="BitSwiperSnap.Start" />
            <BitChoiceGroupOption Text="Center" Value="BitSwiperSnap.Center" />
            <BitChoiceGroupOption Text="End" Value="BitSwiperSnap.End" />
        </BitChoiceGroup>
        <br />
        <div>
            <BitSwiper Snap="snap" VisibleItemsCount="3" Gap="0.5rem">
                @for (int i = 1; i <= 12; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="box-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="Vertical" RazorCode="@example5RazorCode" Id="example5">
        <div>
            <b>Vertical</b> scrolls up and down: the buttons move to the top and bottom and the up/down arrow keys
            navigate. Give it a height (it falls back to <b>--bit-Swiper-vertical-height</b>).
        </div>
        <br />
        <div>
            <BitSwiper Vertical Style="height: 200px" Gap="0.5rem" Snap="BitSwiperSnap.Start" AriaLabel="Vertical items">
                @for (int i = 1; i <= 12; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="box-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="Dots" RazorCode="@example6RazorCode" Id="example6">
        <div>
            <b>ShowDots</b> adds one dot per screenful (not per item), hidden while everything fits.
            <b>DotTemplate</b> replaces a dot's content and receives its zero based page index.
        </div>
        <br />
        <div>
            <BitSwiper ShowDots VisibleItemsCount="4" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                @for (int i = 1; i <= 16; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="box-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
        <br /><br />
        <div>Numbered dots:</div>
        <br />
        <div>
            <BitSwiper ShowDots VisibleItemsCount="4" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                <DotTemplate Context="index"><span>@(index + 1)</span></DotTemplate>
                <ChildContent>
                    @for (int i = 1; i <= 16; i++)
                    {
                        var index = i;
                        <BitSwiperItem><div class="box-item">@index</div></BitSwiperItem>
                    }
                </ChildContent>
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="AutoPlay" RazorCode="@example7RazorCode" Id="example7">
        <div>
            <b>AutoPlay</b> scrolls every <b>AutoPlayInterval</b> ms and rewinds at the end (<b>StopOnLastSlide</b>
            stops there, <b>AutoPlayReverse</b> plays backwards). It pauses on hover, on focus and in a background tab.
            <b>ShowPlayPause</b> adds the stop control WCAG asks for, and <b>StopOnInteraction</b> stops it once the
            swiper is navigated by hand.
        </div>
        <br />
        <div>
            <BitSwiper AutoPlay AutoPlayInterval="1500" ShowDots ShowPlayPause StopOnInteraction
                       VisibleItemsCount="4" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                @for (int i = 1; i <= 16; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="box-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="Interaction & motion" RazorCode="@example8RazorCode" Id="example8">
        <div>
            <b>Wheel</b> navigates with the mouse wheel, <b>NoDrag</b> turns off mouse dragging (touch still scrolls),
            <b>DragThreshold</b> sets how far a press travels before it drags, <b>ShowScrollbar</b> keeps the
            scrollbar and <b>NoKeyboard</b> removes the keyboard navigation. <b>AnimationDuration</b> (seconds, 0 for
            none) times the swiper's own moves; reduced motion turns it off.
        </div>
        <br />
        <div>Wheel, no drag, slow animation:</div>
        <br />
        <div>
            <BitSwiper Wheel NoDrag AnimationDuration="1.5" VisibleItemsCount="4" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                @for (int i = 1; i <= 16; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="box-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
        <br /><br />
        <div>Scrollbar, no buttons, no animation:</div>
        <br />
        <div>
            <BitSwiper ShowScrollbar HideNextPrev AnimationDuration="0" VisibleItemsCount="4" Gap="0.5rem">
                @for (int i = 1; i <= 16; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="box-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="Public API" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
        <div>
            <b>DefaultItem</b> (1 based) sets where it starts. Through a <b>@@ref</b>, <b>GoNext</b>, <b>GoPrev</b>,
            <b>GoTo</b>, <b>GoToPage</b>, <b>GoToStart</b> and <b>GoToEnd</b> navigate it, and members like
            <b>CurrentIndex</b>, <b>PagesCount</b> and <b>IsAtEnd</b> report where it stands. <b>OnChange</b> fires
            with the new item index however it moved.
        </div>
        <br />
        <div>
            <BitSwiper @ref="swiper" DefaultItem="5" HideNextPrev VisibleItemsCount="4" Gap="0.5rem"
                       Snap="BitSwiperSnap.Start" OnChange="v => currentIndex = v">
                @for (int i = 1; i <= 16; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="box-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
        <br />
        <div class="buttons-container">
            <div>
                <BitButton OnClick="GoPrev">&lt; Prev</BitButton>
                <BitButton OnClick="GoNext">Next &gt;</BitButton>
            </div>
            <div class="goto-container">
                <BitButton Class="goto-button" OnClick="GoTo">GoTo</BitButton>
                <BitNumberField @bind-Value="number" Min="1" Max="16" Mode="BitSpinButtonMode.Compact" AriaLabel="Item number" />
            </div>
            <div>
                <BitButton OnClick="GoToStart">Start</BitButton>
                <BitButton OnClick="GoToEnd">End</BitButton>
            </div>
        </div>
        <br />
        <div>Current item: @(currentIndex + 1)</div>
    </DemoExample>

    <DemoExample Title="Load more" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
        <div>
            <b>OnReachEnd</b> fires each time the swiper arrives at its end (<b>OnReachStart</b> at its start), never for
            one that already fits, so it is where more items are loaded.
        </div>
        <br />
        <div>
            <BitSwiper VisibleItemsCount="4" Gap="0.5rem" OnReachEnd="LoadMore">
                @for (int i = 1; i <= loadedCount; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="box-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
        <br />
        <div>Loaded: @loadedCount items</div>
    </DemoExample>

    <DemoExample Title="Accessibility" RazorCode="@example11RazorCode" Id="example11">
        <div>
            Built on the ARIA carousel pattern: a focusable region of labelled slides, real buttons with
            <b>aria-controls</b>, the play/pause button first in tab order, and dots with a 24px pointer target. The item
            it moves to is announced (silenced while it autoplays), a button that hides at an end hands its focus to
            the swiper, and arrow keys are left to text fields, sliders and lists inside the items. Every label is settable:
        </div>
        <ul>
            <li><b>AriaLabel</b> names the region.</li>
            <li><b>ItemAriaLabelFormat</b> names unlabelled items (<b>{0}</b> position, <b>{1}</b> count; "{0} of {1}" by default).</li>
            <li><b>DotsAriaLabel</b> names the dots group; <b>DotAriaLabel</b> prefixes each dot's page number.</li>
            <li><b>NextAriaLabel</b> / <b>PrevAriaLabel</b> and <b>PlayButtonAriaLabel</b> / <b>PauseButtonAriaLabel</b> name the buttons.</li>
        </ul>
        <div>
            <BitSwiper AutoPlay
                       ShowDots
                       ShowPlayPause
                       Gap="0.5rem"
                       VisibleItemsCount="3"
                       Snap="BitSwiperSnap.Start"
                       AriaLabel="Landscape photos"
                       ItemAriaLabelFormat="Photo {0} of {1}"
                       DotAriaLabel="Photo group"
                       DotsAriaLabel="Choose a group of photos to display"
                       NextAriaLabel="Next photo"
                       PrevAriaLabel="Previous photo"
                       PlayButtonAriaLabel="Start the photo slide show"
                       PauseButtonAriaLabel="Stop the photo slide show">
                @for (int i = 1; i <= 12; i++)
                {
                    var index = i;
                    var imageIndex = (index - 1) % 4 + 1;
                    <BitSwiperItem AriaLabel="@(index == 1 ? "Aurora over a frozen lake" : null)">
                        <img class="image" alt="Landscape @index" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img@(imageIndex).jpg" />
                    </BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
        <div>
            <b>BitParams</b> with a <b>BitSwiperParams</b> sets defaults for every swiper under it; a swiper's own
            value always wins. The items, <b>DefaultItem</b> and <b>OnChange</b> are not cascaded.
        </div>
        <br />
        <BitParams Parameters="@swiperParams">
            <div>Takes its dots, step, rewinding, snapping and sizing from the cascade:</div>
            <br />
            <BitSwiper>
                @for (int i = 1; i <= 12; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
            <br /><br />
            <div>Its own VisibleItemsCount and no dots, the cascaded rest:</div>
            <br />
            <BitSwiper VisibleItemsCount="2" ShowDots="false">
                @for (int i = 1; i <= 12; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </BitParams>
    </DemoExample>

    <DemoExample Title="Color" RazorCode="@example13RazorCode" Id="example13">
        <div>
            <b>Color</b> paints the current dot, the buttons and the focus ring. <b>Accent</b> only colors the current
            dot, from the primary/secondary/tertiary/transparent kinds.
        </div>
        <br />
        <div class="colors-container">
            <div>
                <BitLabel>Primary</BitLabel>
                <BitSwiper ShowDots Color="BitColor.Primary" VisibleItemsCount="2" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                    @for (int i = 1; i <= 6; i++)
                    {
                        var index = i;
                        <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                    }
                </BitSwiper>
            </div>
            <div>
                <BitLabel>Success</BitLabel>
                <BitSwiper ShowDots Color="BitColor.Success" VisibleItemsCount="2" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                    @for (int i = 1; i <= 6; i++)
                    {
                        var index = i;
                        <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                    }
                </BitSwiper>
            </div>
            <div>
                <BitLabel>Warning</BitLabel>
                <BitSwiper ShowDots Color="BitColor.Warning" VisibleItemsCount="2" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                    @for (int i = 1; i <= 6; i++)
                    {
                        var index = i;
                        <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                    }
                </BitSwiper>
            </div>
            <div>
                <BitLabel>Error</BitLabel>
                <BitSwiper ShowDots Color="BitColor.Error" VisibleItemsCount="2" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                    @for (int i = 1; i <= 6; i++)
                    {
                        var index = i;
                        <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                    }
                </BitSwiper>
            </div>
            <div>
                <BitLabel>Accent: Secondary</BitLabel>
                <BitSwiper ShowDots Accent="BitColorKind.Secondary" VisibleItemsCount="2" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                    @for (int i = 1; i <= 6; i++)
                    {
                        var index = i;
                        <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                    }
                </BitSwiper>
            </div>
            <div>
                <BitLabel>Accent: Tertiary</BitLabel>
                <BitSwiper ShowDots Accent="BitColorKind.Tertiary" VisibleItemsCount="2" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                    @for (int i = 1; i <= 6; i++)
                    {
                        var index = i;
                        <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                    }
                </BitSwiper>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="External Icons" RazorCode="@example14RazorCode" Id="example14">
        <div>
            <b>NextIcon</b>, <b>PrevIcon</b>, <b>PlayIcon</b> and <b>PauseIcon</b> take a <b>BitIconInfo</b> for
            external libraries (<b>BitIconInfo.Fa</b>, <b>.Bi</b>, <b>.Css</b>) and win over the <b>*IconName</b>
            parameters.
        </div>
        <br />

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

        <div>FontAwesome:</div>
        <br />
        <div>
            <BitSwiper NextIcon="@BitIconInfo.Fa("solid chevron-right")" PrevIcon="@BitIconInfo.Fa("solid chevron-left")">
                @for (int i = 1; i <= 8; i++)
                {
                    var index = i;
                    var imageIndex = (index - 1) % 4 + 1;
                    <BitSwiperItem Class="item">
                        <div class="number">Item @index</div>
                        <img class="image" alt="Landscape @index" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img@(imageIndex).jpg" />
                    </BitSwiperItem>
                }
            </BitSwiper>
        </div>
        <br /><br />
        <div>Bootstrap Icons:</div>
        <br />
        <div>
            <BitSwiper NextIcon="@BitIconInfo.Bi("arrow-right")" PrevIcon="@BitIconInfo.Bi("arrow-left")">
                @for (int i = 1; i <= 8; i++)
                {
                    var index = i;
                    var imageIndex = (index - 1) % 4 + 1;
                    <BitSwiperItem Class="item">
                        <div class="number">Item @index</div>
                        <img class="image" alt="Landscape @index" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img@(imageIndex).jpg" />
                    </BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="Size" RazorCode="@example15RazorCode" Id="example15">
        <div><b>Size</b> scales the dots and the navigation buttons.</div>
        <br />
        <div class="colors-container">
            <div>
                <BitLabel>Small</BitLabel>
                <BitSwiper ShowDots Size="BitSize.Small" VisibleItemsCount="2" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                    @for (int i = 1; i <= 6; i++)
                    {
                        var index = i;
                        <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                    }
                </BitSwiper>
            </div>
            <div>
                <BitLabel>Medium</BitLabel>
                <BitSwiper ShowDots Size="BitSize.Medium" VisibleItemsCount="2" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                    @for (int i = 1; i <= 6; i++)
                    {
                        var index = i;
                        <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                    }
                </BitSwiper>
            </div>
            <div>
                <BitLabel>Large</BitLabel>
                <BitSwiper ShowDots Size="BitSize.Large" VisibleItemsCount="2" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                    @for (int i = 1; i <= 6; i++)
                    {
                        var index = i;
                        <BitSwiperItem><div class="card-item">@index</div></BitSwiperItem>
                    }
                </BitSwiper>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Style & Class" RazorCode="@example16RazorCode" Id="example16">
        <div>
            <b>Style</b> and <b>Class</b> reach the root; <b>Styles</b> and <b>Classes</b> address each part by name
            (see <a href="#class-styles">BitSwiperClassStyles</a>). The public <b>--bit-Swiper-*</b> variables
            (see <a href="#css-variables-section">CSS variables</a>) inherit, so set them on <b>:root</b>, an
            ancestor, or one swiper's <b>Style</b>; they win over <b>Size</b> and <b>Color</b>.
        </div>
        <br />
        <div>Styles & Classes:</div>
        <br />
        <div>
            <BitSwiper ShowDots
                       VisibleItemsCount="4"
                       Gap="0.5rem"
                       Snap="BitSwiperSnap.Start"
                       Style="padding: 0.5rem; border-radius: 0.5rem; background: rgba(128,128,128,0.15)"
                       Classes="@(new() { CurrentItem = "custom-item" })"
                       Styles="@(new() { Buttons = "color: white; background-color: rgba(0,0,0,0.35); width: 2.5rem;",
                                         CurrentDot = "background-color: mediumpurple;" })">
                @for (int i = 1; i <= 16; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="box-item">@index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
        <br /><br />
        <div>CSS variables on an ancestor - a pill-shaped current dot and dark button strips:</div>
        <br />
        <div class="themed-swiper">
            <BitSwiper ShowDots VisibleItemsCount="3" Gap="0.75rem" Snap="BitSwiperSnap.Start">
                @for (int i = 1; i <= 12; i++)
                {
                    var index = i;
                    var imageIndex = (index - 1) % 4 + 1;
                    <BitSwiperItem>
                        <img class="image" alt="Landscape @index" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img@(imageIndex).jpg" />
                    </BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

    <DemoExample Title="RTL" RazorCode="@example17RazorCode" Id="example17">
        <div>
            <b>Dir="BitDir.Rtl"</b> lays the items out right to left and swaps the buttons; the arrow keys still move
            the view the way they point.
        </div>
        <br />
        <div dir="rtl">
            <BitSwiper Dir="BitDir.Rtl" ShowDots VisibleItemsCount="4" Gap="0.5rem" Snap="BitSwiperSnap.Start">
                @for (int i = 1; i <= 16; i++)
                {
                    var index = i;
                    <BitSwiperItem><div class="box-item">مورد @index</div></BitSwiperItem>
                }
            </BitSwiper>
        </div>
    </DemoExample>

</DemoPage>
