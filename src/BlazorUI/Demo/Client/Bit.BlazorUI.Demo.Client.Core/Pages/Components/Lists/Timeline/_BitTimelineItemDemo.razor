<DemoExample Title="External Icons" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
    <div>
        Besides the built-in icons of IconName, the Icon parameter of an item accepts the CSS classes of any
        external icon library, such as FontAwesome or Bootstrap Icons, and takes precedence over IconName.
    </div>

    <br />
    <br />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />

    <div><b>FontAwesome Icons:</b></div>
    <br />
    <BitTimeline Horizontal Items="externalIconItems1" />
    <br /><br /><br />
    <BitTimeline Horizontal Items="externalIconItems2" Variant="BitVariant.Outline" />
    <br /><br /><br />
    <BitTimeline Horizontal Items="externalIconItems3" Variant="BitVariant.Text" />

    <br /><br /><br /><br />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <div><b>Bootstrap Icons:</b></div>
    <br />
    <BitTimeline Horizontal Items="bootstrapIconItems1" />
    <br /><br /><br />
    <BitTimeline Horizontal Items="bootstrapIconItems2" Variant="BitVariant.Outline" />
    <br /><br /><br />
    <BitTimeline Horizontal Items="bootstrapIconItems3" Variant="BitVariant.Text" />
</DemoExample>

