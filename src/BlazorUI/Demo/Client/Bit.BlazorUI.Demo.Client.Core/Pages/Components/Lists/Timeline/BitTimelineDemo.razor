@page "/components/timeline"
@inherits AppComponentBase


<PageOutlet Url="components/timeline"
            Title="Timeline"
            Description="The Timeline component displays events in chronological order along a vertical or horizontal line, marking each one with a dot and placing its content on either side of the line." />

<div>
    <DemoPage Name="Timeline"
              Description="The Timeline component displays events in chronological order along a vertical or horizontal line: each one gets a dot, which can carry an icon or a template, and contents on either side. The line can be solid, dashed or dotted and truncated at its ends, the items alternated, reordered, recolored and made clickable, and the whole look re-skinned through CSS variables."
              Parameters="componentParameters"
              SubClasses="componentSubClasses"
              SubEnums="componentSubEnums"
              CssVariables="componentCssVariables"
              GitHubUrl="Lists/Timeline/BitTimeline.razor"
              GitHubDemoUrl="Lists/Timeline/BitTimelineDemo.razor">
        <NotesTemplate>
            <BitText>
                The BitTimeline is a <BitTag Color="BitColor.SecondaryBackground">Multi-API</BitTag> component
                which can accept the list of Items in 3 different ways:
                <br />
                1. The <BitLink Href="#timeline-item"><BitTag Color="BitColor.SecondaryBackground">BitTimelineItem</BitTag></BitLink> class <br />
                2. A <BitTag Color="BitColor.SecondaryBackground">Custom Generic</BitTag> class <br />
                3. The <BitLink Href="#timeline-option"><BitTag Color="BitColor.SecondaryBackground">BitTimelineOption</BitTag></BitLink> component
            </BitText>
        </NotesTemplate>
        <Examples>
            <BitPivot Classes="@(new() { HeaderContainer = "pivot-sticky-header" })" MountAll="RenderForMcpClient">
                <BitPivotItem HeaderText="Item">
                    <_BitTimelineItemDemo />
                </BitPivotItem>

                <BitPivotItem HeaderText="Custom">
                    <_BitTimelineCustomDemo />
                </BitPivotItem>

                <BitPivotItem HeaderText="Option">
                    <_BitTimelineOptionDemo />
                </BitPivotItem>
            </BitPivot>
        </Examples>
    </DemoPage>
</div>