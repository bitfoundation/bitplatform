        </div>
        <br />
        <div>
            <BitCarousel Fade InfiniteScrolling>
                <BitCarouselItem>
                    <div class="number">1 / 4</div>
                    <img class="image" alt="Aurora" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img1.jpg" />
                </BitCarouselItem>
                <BitCarouselItem>
