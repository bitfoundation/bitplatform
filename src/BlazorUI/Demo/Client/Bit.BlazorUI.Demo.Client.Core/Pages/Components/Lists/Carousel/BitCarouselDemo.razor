@page "/components/carousel"

<PageOutlet Url="components/carousel"
            Title="Carousel"
            Description="Carousel (slideshow) displays items across sliding pages with navigation buttons, dots, drag, keyboard, wheel, autoplay and responsive multi-item layouts." />

<DemoPage Name="Carousel"
          SecondaryNames="@(["SlideShow"])"
          Description="Carousel (slideshow) shows a set of items across sliding pages. Navigate it with its buttons and dots, by dragging, with the keyboard or the wheel, from code, or let it play on its own. It shows one or several items at a time (adapting to its own width), scrolls horizontally or vertically, or cross-fades, and follows the ARIA carousel pattern."
          Parameters="componentParameters"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          PublicMembers="componentPublicMembers"
          CssVariables="componentCssVariables"
          GitHubUrl="Lists/Carousel/BitCarousel.razor"
          GitHubDemoUrl="Lists/Carousel/BitCarouselDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>
            One slide at a time, with next/prev buttons and dots. Drag it, or focus it and use the arrow keys, Home and End.
            Name it with <b>AriaLabel</b> so screen readers announce what it holds.
        </div>
        <br />
        <div>
            <BitCarousel AriaLabel="Landscape photos">
                <BitCarouselItem>
                    <div class="number">1 / 4</div>
                    <img class="image" alt="Aurora" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img1.jpg" />
                </BitCarouselItem>
                <BitCarouselItem>
                    <div class="number">2 / 4</div>
                    <img class="image" alt="Beautiful mountain" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img2.jpg" />
                </BitCarouselItem>
                <BitCarouselItem>
                    <div class="number">3 / 4</div>
                    <img class="image" alt="Forest in the valley" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img3.jpg" />
                </BitCarouselItem>
                <BitCarouselItem>
                    <div class="number">4 / 4</div>
                    <img class="image" alt="Road among the mountains" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img4.jpg" />
                </BitCarouselItem>
            </BitCarousel>
        </div>
    </DemoExample>

