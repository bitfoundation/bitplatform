                <BitCarouselItem>
                    <div class="number">4 / 4</div>
                    <img class="image" src="_content/Bit.BlazorUI.Demo.Client.Core/images/carousel/img4.jpg" />
                </BitCarouselItem>
            </BitCarousel>
        </div>
