@page "/components/actionbutton"
@page "/components/action-button"

<PageOutlet Url="components/actionbutton"
            Title="ActionButton"
            Description="ActionButton is a lightweight, icon-first text button with a transparent background and colorized content that renders as a native button or a link, featuring built-in loading states, auto-loading with double-click protection, and accessible disabled and loading semantics." />

<DemoPage Name="ActionButton"
          Description="ActionButton is the lightweight, icon-first flavor of button: a transparent box with a colorized icon and plain text, made for inline commands like New, Edit, or Share. It renders as a native button or, given an Href, as a link with hardened navigation attributes, and ships with a full loading state (AutoLoading with double-click protection, loading label, delayed spinner) and accessible disabled and loading semantics."
          Parameters="componentParameters"
          CssVariables="componentCssVariables"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          GitHubUrl="Buttons/ActionButton/BitActionButton.razor"
          GitHubDemoUrl="Buttons/ActionButton/BitActionButtonDemo.razor">

    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>
            A native <b>button</b> with the icon first and the content beside it. The icon is optional, and the content is any markup, not just text.
            <b>IsEnabled</b> false dims the button and suppresses its click. <b>IconOnly</b> drops the content, so give it an <b>AriaLabel</b> to keep a name for screen readers.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton IconName="@BitIconName.AddFriend">
                Create account
            </BitActionButton>

            <BitActionButton IconName="@BitIconName.AddFriend" IsEnabled="false">
                Disabled
            </BitActionButton>

            <BitActionButton>
                No icon
            </BitActionButton>

            <BitActionButton IconOnly IconName="@BitIconName.Phone" AriaLabel="Call" />

            <BitActionButton IconName="@BitIconName.Mail">
                Inbox <b>(3 unread)</b>
            </BitActionButton>
        </div>
    </DemoExample>

    <DemoExample Title="IconPosition" RazorCode="@example2RazorCode" Id="example2">
        <div>
            <b>IconPosition</b> moves the icon to the other side of the content. End suits forward actions like Next or Open, and the spinner takes the same side while loading.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton IconPosition="BitIconPosition.Start" IconName="@BitIconName.AddFriend">
                Start (default)
            </BitActionButton>

            <BitActionButton IconPosition="BitIconPosition.End" IconName="@BitIconName.Forward">
                End
            </BitActionButton>
        </div>
    </DemoExample>

    <DemoExample Title="Href" RazorCode="@example3RazorCode" Id="example3">
        <div>
            An <b>Href</b> renders a real <b>anchor</b> instead of a button, so open-in-new-tab, the context menu, and the link announcement all keep working.
            <b>Target</b> picks where it opens; with <code>_blank</code>, <code>rel="noopener"</code> is added automatically.
            A disabled or loading link drops its href rather than rendering an invalid disabled attribute.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton IconName="@BitIconName.Globe" Href="https://bitplatform.dev" Target="_blank">
                Open bitplatform.dev in a new tab
            </BitActionButton>

            <BitActionButton IconName="@BitIconName.Globe" Href="https://github.com/bitfoundation/bitplatform">
                Go to bitplatform GitHub
            </BitActionButton>
        </div>
        <br /><br />
        <div>
            <b>Download</b> saves the resource instead of navigating to it: an empty value keeps the server-provided file name, any other value suggests one.
            Browsers honor it only for same-origin, <code>blob:</code>, and <code>data:</code> URLs.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton IconName="@BitIconName.Download"
                             Href="/_content/Bit.BlazorUI.Demo.Client.Core/images/bit-logo.svg"
                             Download="">
                Download the logo
            </BitActionButton>

            <BitActionButton IconName="@BitIconName.Download"
                             Href="/_content/Bit.BlazorUI.Demo.Client.Core/images/bit-logo.svg"
                             Download="bit-platform-logo.svg">
                Download with a custom file name
            </BitActionButton>
        </div>
        <br /><br />
        <div>
            <b>Rel</b> declares the relationship with the destination. It is a flags enum (<BitLink Href="#link-rels">BitLinkRels</BitLink>), so values combine with <code>|</code>.
            It is emitted for real navigations only, never for empty or hash-only hrefs.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton Rel="BitLinkRels.NoFollow" Href="https://bitplatform.dev" Target="_blank" IconName="@BitIconName.Globe">
                nofollow
            </BitActionButton>

            <BitActionButton Rel="BitLinkRels.NoFollow | BitLinkRels.NoReferrer" Href="https://bitplatform.dev" Target="_blank" IconName="@BitIconName.Globe">
                nofollow & noreferrer
            </BitActionButton>
        </div>
    </DemoExample>

    <DemoExample Title="ButtonType" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
        <div>
            Inside an <b>EditForm</b> the button defaults to <code>submit</code>, outside it to <code>button</code>; <b>ButtonType</b> overrides that.
            <b>FormId</b> ties a button placed outside the form to it through the native <code>form</code> attribute.
        </div>
        <br />
        <div class="form-container">
            <EditForm id="action-button-form" Model="buttonValidationModel" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit" novalidate>
                <DataAnnotationsValidator />

                <BitTextField Label="Required" Required @bind-Value="buttonValidationModel.RequiredText" />
                <ValidationMessage For="() => buttonValidationModel.RequiredText" style="color:red" />

                <br />

                <BitTextField Label="Non-required" @bind-Value="buttonValidationModel.NonRequiredText" />

                <br />

                <div class="form-actions">
                    <BitActionButton IconName="@BitIconName.SendMirrored" ButtonType="BitButtonType.Submit">
                        Submit
                    </BitActionButton>

                    <BitActionButton IconName="@BitIconName.Reset" ButtonType="BitButtonType.Reset">
                        Reset
                    </BitActionButton>

                    <BitActionButton IconName="@BitIconName.ButtonControl" ButtonType="BitButtonType.Button">
                        Button
                    </BitActionButton>
                </div>
            </EditForm>

            <br />

            <BitActionButton FormId="action-button-form" ButtonType="BitButtonType.Submit" IconName="@BitIconName.Send">
                Submit from outside the form
            </BitActionButton>

            @if (formIsValidSubmit)
            {
                <br />
                <BitMessage Color="BitColor.Success">The form submitted successfully.</BitMessage>
            }
        </div>
    </DemoExample>

    <DemoExample Title="FullWidth" RazorCode="@example5RazorCode" Id="example5">
        <div>
            <b>FullWidth</b> stretches the button across its container and lets the content fill the room, so an end-positioned icon lands on the far edge:
            the familiar navigation row with the label on one side and a chevron on the other.
        </div>
        <br />
        <div class="full-width-container">
            <BitActionButton FullWidth IconName="@BitIconName.Settings">
                Settings
            </BitActionButton>

            <BitActionButton FullWidth IconPosition="BitIconPosition.End" IconName="@BitIconName.ChevronRight">
                Notifications
            </BitActionButton>

            <BitActionButton FullWidth IconPosition="BitIconPosition.End" IconName="@BitIconName.ChevronRight">
                Privacy
            </BitActionButton>
        </div>
    </DemoExample>

    <DemoExample Title="Loading" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
        <div>
            <b>IsLoading</b> swaps the icon for a spinner, marks the button busy for assistive technologies, and ignores further clicks. It is two-way bindable.
        </div>
        <br />
        <BitToggle @bind-Value="isLoading" Label="Toggle loading" />
        <br />
        <div class="example-content">
            <BitActionButton IsLoading="isLoading" IconName="@BitIconName.Save">
                Save changes
            </BitActionButton>

            <BitActionButton IsLoading="isLoading" IconName="@BitIconName.Send" Color="BitColor.Success" IconPosition="BitIconPosition.End">
                Send message
            </BitActionButton>
        </div>
        <br /><br />
        <div>
            <b>AutoLoading</b> enters and leaves the loading state around an async <b>OnClick</b>, even when it throws.
            <b>LoadingLabel</b> replaces the content with a progress message and announces it to screen readers.
            <b>LoadingDelay</b> holds the spinner back for the given milliseconds so quick operations do not flash, while the click-guard still applies from the first moment.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton AutoLoading OnClick="HandleAutoLoadingClick" IconName="@BitIconName.Save">
                AutoLoading
            </BitActionButton>

            <BitActionButton AutoLoading OnClick="HandleAutoLoadingClick" LoadingLabel="Saving..." IconName="@BitIconName.Save">
                LoadingLabel
            </BitActionButton>

            <BitActionButton AutoLoading OnClick="HandleAutoLoadingClick" LoadingDelay="500" IconName="@BitIconName.Save">
                LoadingDelay
            </BitActionButton>
        </div>
        <br /><br />
        <div>
            Clicks are ignored while loading, which is what keeps a submit or a payment from firing twice. <b>Reclickable</b> lets them through when repeats are meaningful. Click each counter rapidly to compare.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton AutoLoading OnClick="HandleGuardedClick" IconName="@BitIconName.Shield">
                Guarded (@guardedClickCount)
            </BitActionButton>

            <BitActionButton AutoLoading Reclickable OnClick="HandleReclickableClick" IconName="@BitIconName.RepeatAll">
                Reclickable (@reclickableClickCount)
            </BitActionButton>
        </div>
        <br /><br />
        <div>
            <b>LoadingTemplate</b> takes over the whole loading visual. Declare the normal content through <b>Body</b> so both templates fit on one button.
        </div>
        <br />
        <BitToggle @bind-Value="templateIsLoading" Label="Toggle loading" />
        <br />
        <div class="example-content">
            <BitActionButton IsLoading="templateIsLoading" IconName="@BitIconName.Download">
                <Body>
                    Download
                </Body>
                <LoadingTemplate>
                    <BitRingLoading CustomSize="20" Color="BitColor.Tertiary" /> Downloading...
                </LoadingTemplate>
            </BitActionButton>
        </div>
    </DemoExample>

    <DemoExample Title="Underlined" RazorCode="@example7RazorCode" Id="example7">
        <div>
            <b>Underlined</b> draws a hyperlink-style underline under the text that thickens on hover, for a button that sits inside running text where color alone is not enough of a cue.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton Underlined IconName="@BitIconName.Link">
                Link style
            </BitActionButton>

            <BitActionButton Underlined IconName="@BitIconName.OpenInNewTab" Href="https://github.com/bitfoundation/bitplatform" Target="_blank">
                Open GitHub
            </BitActionButton>

            <BitActionButton Underlined Color="BitColor.Info" IconName="@BitIconName.Info">
                More info
            </BitActionButton>
        </div>
    </DemoExample>

    <DemoExample Title="Events" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
        <div>
            <b>OnClick</b> fires on mouse, touch, and keyboard activation, never while disabled or loading.
            Inside another clickable surface, such as a row or a card, set <b>StopPropagation</b> so the container's handler stays quiet.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton OnClick="() => clickCounter++" IconName="@BitIconName.TouchPointer">
                Click me (@clickCounter)
            </BitActionButton>
        </div>
        <br />
        <div class="clickable-row" @onclick="() => rowClickCount++">
            <span>Row clicks: @rowClickCount &nbsp;|&nbsp; Button clicks: @innerClickCount</span>

            <div class="example-content">
                <BitActionButton OnClick="() => innerClickCount++" IconName="@BitIconName.Edit">
                    Bubbles up
                </BitActionButton>

                <BitActionButton StopPropagation OnClick="() => innerClickCount++" IconName="@BitIconName.Edit">
                    StopPropagation
                </BitActionButton>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Accessibility" RazorCode="@example9RazorCode" Id="example9">
        <div>
            <b>Title</b> is a native tooltip the browser shows on hover only, so it never replaces an accessible name: an icon-only button also needs an <b>AriaLabel</b>, kept consistent with it.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton Title="Save your changes" IconName="@BitIconName.Save">
                Hover me
            </BitActionButton>

            <BitActionButton IconOnly Title="Delete" AriaLabel="Delete" Color="BitColor.Error" IconName="@BitIconName.Delete" />
        </div>
        <br /><br />
        <div>
            <b>AriaDescription</b> is a longer sentence rendered as visually hidden text the button points at through <code>aria-describedby</code>.
            It is read after the name, not as part of it, which makes it the place for what the user would want to know before acting: the size of a file, what a page will ask for.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton IconName="@BitIconName.Download"
                             AriaDescription="SVG, 12 kilobytes"
                             Href="/_content/Bit.BlazorUI.Demo.Client.Core/images/bit-logo.svg"
                             Download="">
                Download the brand guidelines
            </BitActionButton>
        </div>
        <br /><br />
        <div>
            A disabled button normally leaves the tab order, so keyboard and screen reader users can miss that the action exists.
            <b>AllowDisabledFocus</b> conveys the state through <code>aria-disabled</code> instead of the native attribute: the button stays focusable and discoverable, its click stays suppressed,
            and the focus ring is drawn in the muted disabled color. Tab through the two buttons to feel the difference.
        </div>
        <br />
        <div class="example-content">
            <BitActionButton IsEnabled="false" IconName="@BitIconName.Blocked">
                Disabled (skipped by Tab)
            </BitActionButton>

            <BitActionButton IsEnabled="false" AllowDisabledFocus IconName="@BitIconName.Blocked">
                Disabled (still focusable)
            </BitActionButton>
        </div>
    </DemoExample>

