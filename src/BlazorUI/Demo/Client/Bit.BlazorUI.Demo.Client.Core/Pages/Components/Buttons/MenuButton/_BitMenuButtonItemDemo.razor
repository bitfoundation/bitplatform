                       OnClick="(BitMenuButtonItem? item) => submenuClickedItem = item?.Text" />
        <BitMenuButton Split Text="Share" Items="shareItems" Variant="BitVariant.Outline"
                       SubmenuIconName="@BitIconName.ChevronRightMed"
                       OnClick="(BitMenuButtonItem? item) => submenuClickedItem = item?.Text" />
    </div>
    <br />
