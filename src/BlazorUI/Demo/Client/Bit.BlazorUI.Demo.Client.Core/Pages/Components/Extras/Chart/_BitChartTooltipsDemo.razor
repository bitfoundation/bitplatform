@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Title &amp; footer callbacks" RazorCode="@footerRazorCode" CsharpCode="@footerCsharpCode" Id="tooltips-footer">
    <div class="example-desc">
        <code>Callbacks.Title</code> builds the heading from the active items and <code>Callbacks.Footer</code>
        adds a summary line - here the total at the hovered category.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="_footer" /></div></div>
</DemoExample>

<DemoExample Title="Currency labels" RazorCode="@currencyRazorCode" CsharpCode="@currencyCsharpCode" Id="tooltips-currency">
    <div class="example-desc">
        <code>Callbacks.Label</code> replaces a single item's body row; <code>LabelFormatter</code> is the
        shorthand for formatting just the number.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="TwoSeries()" Options="_currency" /></div></div>
</DemoExample>

<DemoExample Title="After-body note" RazorCode="@afterBodyRazorCode" CsharpCode="@afterBodyCsharpCode" Id="tooltips-after-body">
    <div class="example-desc">
        <code>BeforeBody</code> and <code>AfterBody</code> add free lines around the values; newlines split the
        text into several lines.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="TwoSeries()" Options="_afterBody" /></div></div>
</DemoExample>

<DemoExample Title="Styled box" RazorCode="@styledRazorCode" CsharpCode="@styledCsharpCode" Id="tooltips-styled">
    <div class="example-desc">
        Colors, padding, corner radius, border, caret and per-part alignment are all options. The tooltip stays
        inside the chart and flips below the anchor when there is no room above.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="_styled" /></div></div>
</DemoExample>

<DemoExample Title="Point-style swatches" RazorCode="@pointStyleRazorCode" CsharpCode="@pointStyleCsharpCode" Id="tooltips-point-style">
    <div class="example-desc">
        <code>UsePointStyle</code> swaps the color square for each dataset's own marker.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Markers()" Options="_pointStyle" /></div></div>
</DemoExample>

<DemoExample Title="Wrapping a longer note" RazorCode="@wrappedRazorCode" CsharpCode="@wrappedCsharpCode" Id="tooltips-wrapped">
    <div class="example-desc">
        Tooltip rows stay on one line unless <code>MaxWidth</code> caps the box in pixels, which wraps longer text
        inside it.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Countries()" Options="_wrapped" /></div></div>
</DemoExample>
