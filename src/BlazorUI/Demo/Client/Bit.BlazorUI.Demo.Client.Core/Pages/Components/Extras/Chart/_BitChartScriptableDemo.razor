@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Color by sign" RazorCode="@bySignRazorCode" CsharpCode="@bySignCsharpCode" Id="scriptable-by-sign">
    <div class="example-desc">
        A scriptable option is a function of <code>BitChartScriptableContext</code> evaluated per element - here
        <code>BackgroundColorFn</code> turns bars red below zero. The context's <code>Active</code> is set while
        building the hover appearance, so one function styles both states.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BySign()" Options="_noLegend" /></div></div>
</DemoExample>

<DemoExample Title="Color by threshold" RazorCode="@byThresholdRazorCode" CsharpCode="@byThresholdCsharpCode" Id="scriptable-by-threshold">
    <div class="example-desc">
        <code>PointBackgroundColorFn</code> and <code>PointRadiusFn</code> give points of 75 and above a different
        color and a larger radius.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="ByThreshold()" Options="_noLegend" /></div></div>
</DemoExample>

<DemoExample Title="Radius by value" RazorCode="@radiusByValueRazorCode" CsharpCode="@radiusByValueCsharpCode" Id="scriptable-radius-by-value" PreventRenderForMcpClient>
    <div class="example-desc">The point radius scales with the value via <code>PointRadiusFn</code>.</div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="RadiusByValue()" Options="_noLegend" /></div></div>
</DemoExample>

<DemoExample Title="Style by parity" RazorCode="@styleByParityRazorCode" CsharpCode="@styleByParityCsharpCode" Id="scriptable-style-by-parity" PreventRenderForMcpClient>
    <div class="example-desc">Alternating point styles chosen per index via <code>PointStyleFn</code>.</div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="StyleByParity()" Options="_noLegend" /></div></div>
</DemoExample>
