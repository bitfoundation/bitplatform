@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Pie" RazorCode="@pieRazorCode" CsharpCode="@pieCsharpCode" Id="pie-pie">
    <div class="example-desc">
        A pie splits one dataset into proportional slices, colored from the palette by data index. Hover shows a
        slice's value and percentage; clicking a legend label removes it from the total.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Pie" Data="BitChartSampleData.Traffic()" Options="_right" /></div></div>
</DemoExample>

<DemoExample Title="Doughnut" RazorCode="@doughnutRazorCode" CsharpCode="@doughnutCsharpCode" Id="pie-doughnut" PreventRenderForMcpClient>
    <div class="example-desc">
        A doughnut is a pie with the middle cut out by <code>CutoutPercentage</code>, leaving room for a headline
        number.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Doughnut" Data="BitChartSampleData.Traffic()" Options="_doughnut" /></div></div>
</DemoExample>

<DemoExample Title="Half doughnut (gauge)" RazorCode="@gaugeRazorCode" CsharpCode="@gaugeCsharpCode" Id="pie-gauge">
    <div class="example-desc">
        Narrowing the sweep with <code>CircumferenceDegrees</code> and rotating the start with
        <code>RotationDegrees</code> turns a doughnut into a gauge - 180° starting at the left here.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Doughnut" Data="Gauge()" Options="_gauge" /></div></div>
</DemoExample>

<DemoExample Title="Multi-ring" RazorCode="@multiRingRazorCode" CsharpCode="@multiRingCsharpCode" Id="pie-multi-ring">
    <div class="example-desc">
        Several datasets render as concentric rings sharing one set of labels.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Doughnut" Data="MultiRing()" Options="_right" /></div></div>
</DemoExample>

<DemoExample Title="Center text (KPI)" RazorCode="@centerTextRazorCode" CsharpCode="@centerTextCsharpCode" Id="pie-center-text">
    <div class="example-desc">
        <code>BitChartCenterTextPlugin</code> writes one or two lines into the cutout, shrunk to fit. It is an
        ordinary <code>IBitChartPlugin</code>, so custom overlays hook in the same way.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Doughnut" Data="BitChartSampleData.Traffic()" Options="_centerText" /></div></div>
</DemoExample>

<DemoExample Title="Spacing, offset and hover" RazorCode="@spacingRazorCode" CsharpCode="@spacingCsharpCode" Id="pie-spacing">
    <div class="example-desc">
        <code>SpacingArc</code> gaps neighbouring slices, <code>Offset</code> pushes every slice out from the
        center and <code>HoverOffset</code> the hovered one further, with <code>HoverBackgroundColor</code>
        repainting it.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Doughnut" Data="Exploded()" Options="_exploded" /></div></div>
</DemoExample>

<DemoExample Title="Rounded arcs and ring weights" RazorCode="@roundedRingsRazorCode" CsharpCode="@roundedRingsCsharpCode" Id="pie-rounded-rings">
    <div class="example-desc">
        <code>BorderRadius</code> rounds an arc's corners, clamped to half the ring's thickness.
        <code>Weight</code> sets each ring's share of the radius in a multi-dataset doughnut.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Doughnut" Data="Weighted()" Options="_rounded" /></div></div>
</DemoExample>
