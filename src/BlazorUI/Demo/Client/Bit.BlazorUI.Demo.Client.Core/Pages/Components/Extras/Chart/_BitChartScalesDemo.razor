@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Fixed min / max" RazorCode="@minMaxRazorCode" CsharpCode="@minMaxCsharpCode" Id="scales-fixed-min-max">
    <div class="example-desc">
        <code>Min</code> and <code>Max</code> pin the axis range, so it does not rescale as the data changes.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Series()" Options="_minMax" /></div></div>
</DemoExample>

<DemoExample Title="Suggested min / max" RazorCode="@suggestedRazorCode" CsharpCode="@suggestedCsharpCode" Id="scales-suggested-min-max" PreventRenderForMcpClient>
    <div class="example-desc">
        <code>SuggestedMin</code> and <code>SuggestedMax</code> only widen the range; the axis still grows past
        them to fit the data.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Series()" Options="_suggested" /></div></div>
</DemoExample>

<DemoExample Title="Explicit step size" RazorCode="@stepRazorCode" CsharpCode="@stepCsharpCode" Id="scales-explicit-step-size">
    <div class="example-desc">
        <code>StepSize</code> fixes the tick spacing and <code>MaxTicksLimit</code> caps the tick count. Labels
        that do not fit are dropped, so they never collide.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="Series()" Options="_step" /></div></div>
</DemoExample>

<DemoExample Title="Logarithmic" RazorCode="@logRazorCode" CsharpCode="@logCsharpCode" Id="scales-logarithmic">
    <div class="example-desc">
        <code>Type = BitChartScaleType.Logarithmic</code> gives every decade equal space; faint minor gridlines
        mark the steps in between.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="LogData()" Options="_log" /></div></div>
</DemoExample>

<DemoExample Title="Reversed Y axis" RazorCode="@reverseRazorCode" CsharpCode="@reverseCsharpCode" Id="scales-reversed-y-axis">
    <div class="example-desc">
        <code>Reverse</code> flips the axis - for rankings, first place at the top.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Rank()" Options="_reverse" /></div></div>
</DemoExample>

<DemoExample Title="Axes at the zero line" RazorCode="@centerRazorCode" CsharpCode="@centerCsharpCode" Id="scales-center">
    <div class="example-desc">
        <code>Placement = BitPlacement.Center</code> draws an axis at the other axis's zero instead of the plot
        edge, splitting signed data into quadrants. It takes no layout space.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Scatter" Data="Quadrants()" Options="_center" /></div></div>
</DemoExample>

<DemoExample Title="Grace (padding)" RazorCode="@graceRazorCode" CsharpCode="@graceCsharpCode" Id="scales-grace-padding" PreventRenderForMcpClient>
    <div class="example-desc">
        <code>Grace</code> pads the range by a fraction of itself, so the extremes do not touch the frame.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Series()" Options="_grace" /></div></div>
</DemoExample>
