@page "/components/virtualize"

<PageOutlet Url="components/virtualize"
            Title="Virtualize"
            Description="BitVirtualize renders huge lists and grids fast by keeping only the items in view in the DOM, with fixed or measured sizes, lazy loading, sticky headers and a chat mode." />

<div>
    <DemoPage Name="Virtualize"
              SecondaryNames="@(["VirtualScroll", "Windowing", "VirtualGrid"])"
              Description="BitVirtualize renders only the items in its scroll viewport, plus a small overscan buffer, so lists of millions of items scroll as smoothly as a few dozen. Items can share one size or be measured as they render, come from memory or be loaded window by window, scroll vertically or horizontally (by themselves, or with an ancestor or the page) and be laid out in a fixed or responsive grid of lanes. It adds header and footer content, sticky group headers, infinite scrolling in both directions, a bottom-anchored chat mode, programmatic scrolling and full keyboard and screen-reader support."
              Parameters="componentParameters"
              CssVariables="componentCssVariables"
              PublicMembers="componentPublicMembers"
              SubClasses="componentSubClasses"
              SubEnums="componentSubEnums"
              GitHubExtrasUrl="Virtualize/BitVirtualize.razor"
              GitHubDemoUrl="Extras/Virtualize/BitVirtualizeDemo.razor">
        <NotesTemplate>
            <BitText>
                To use this component, you need to install the
                <BitLink Href="https://www.nuget.org/packages/Bit.BlazorUI.Extras" Target="_blank">
                    <BitTag Reversed
                            Text="Bit.BlazorUI.Extras"
                            Color="BitColor.SecondaryBackground"
                            IconName="@BitIconName.NavigateExternalInline" />
                </BitLink>
                nuget package, as described in the Optional steps of the
                <BitLink Href="/getting-started">Getting started</BitLink> page.
            </BitText>
        </NotesTemplate>
        <Examples>
            <DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
                <div>
                    An in-memory <b>Items</b> collection with a fixed <b>ItemSize</b> (px along the scroll axis). Only the rows
                    in view, plus <b>OverscanCount</b> rows on each side (3 by default), are in the DOM. The list is its own
                    scroll container, so give it a height.
                </div>
                <br />
                <BitVirtualize Items="basicItems" ItemSize="56"
                               TItem="int" Context="item"
                               Class="list">
                    <div class="basic-item">
                        <b>#@item.ToString("N0")</b>
                        <span>Item number @item of one million</span>
                    </div>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="ItemsProvider" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
                <div>
                    An <b>ItemsProvider</b> loads the data window by window: it gets the <b>StartIndex</b> and <b>Count</b> needed
                    and returns them with the <b>TotalItemCount</b>. Obsolete requests are cancelled and loaded items cached.
                    <b>LoadingTemplate</b> shows until the first window arrives, <b>PlaceholderTemplate</b> fills each slot still
                    loading. With several templates, the item one is <b>ItemTemplate</b>.
                </div>
                <br />
                <BitVirtualize TItem="Product" ItemsProvider="LoadProducts" ItemSize="60" Class="list">
                    <ItemTemplate Context="product">
                        <div class="provider-item">
                            <b>@product.Name</b>
                            <span>record #@product.Id.ToString("N0") · loaded at @product.LoadedAt</span>
                        </div>
                    </ItemTemplate>
                    <PlaceholderTemplate Context="context">
                        <div class="provider-item">
                            <BitShimmer Height="@($"{context.Size / 2}px")" Width="@($"{100 - (context.Index % 3) * 15}%")" />
                        </div>
                    </PlaceholderTemplate>
                    <LoadingTemplate>
                        <BitSpinnerLoading />
                    </LoadingTemplate>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="Dynamic size" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
                <div>
                    With <b>Dynamic</b>, every rendered item is measured and its size remembered; the rest are assumed to be
                    <b>EstimatedItemSize</b> px. When an item above the viewport turns out a different size, the scroll is
                    corrected so the content in view never jumps.
                </div>
                <br />
                <BitVirtualize Items="posts" Dynamic EstimatedItemSize="96"
                               TItem="Post" Context="post"
                               Class="list">
                    <div class="post">
                        <div class="post-header">@post.Author · @post.Time</div>
                        <div>@post.Body</div>
                    </div>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="Horizontal" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
                <div>
                    <b>Horizontal</b> scrolls along the x-axis; ItemSize becomes the width of each item.
                </div>
                <br />
                <BitVirtualize Items="horizontalItems" ItemSize="120" Horizontal
                               TItem="int" Context="item"
                               Class="horizontal-list">
                    <div class="tile">
                        <b>@item.ToString("N0")</b>
                    </div>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="Grid (Lanes)" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5">
                <div>
                    <b>Lanes</b> lays the items side by side in equal columns (rows when Horizontal), turning the list into a
                    virtualized grid; ItemSize is then the height of a row. <b>MinLaneSize</b> makes it responsive: as many
                    lanes as fit at that minimum width (resize the window). The arrow keys move across and along the lanes,
                    and in Dynamic mode each row is as tall as its tallest item.
                </div>
                <br />
                <div class="toolbar">
                    <BitNumberField @bind-Value="gridLanes" Min="1" Max="8" Mode="BitSpinButtonMode.Inline" Label="Lanes" LabelPosition="BitLabelPosition.Start" IsEnabled="@(gridResponsive is false)" Style="max-width:12rem" />
                    <BitToggle @bind-Value="gridResponsive" Label="MinLaneSize = 200" Inline />
                </div>
                <br />
                <BitVirtualize Items="gridItems" ItemSize="120" Lanes="gridLanes" MinLaneSize="@(gridResponsive ? 200 : null)"
                               TItem="int" Context="item"
                               Class="list">
                    <div class="tile">
                        <b>@item.ToString("N0")</b>
                    </div>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="Scrolling" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
                <div>
                    <b>InitialIndex</b> opens the list at an item. <b>ScrollToIndexAsync</b> brings an item into view aligned to
                    its Start, Center or End, or by the least movement (Auto); <b>ScrollToOffsetAsync</b>, <b>ScrollByAsync</b>,
                    <b>ScrollToStartAsync</b> and <b>ScrollToEndAsync</b> cover the rest. Each can animate, and a call made before
                    the list is ready is applied once it is. <b>OnVisibleRangeChanged</b> reports the visible [Start, End).
                </div>
                <br />
                <div class="toolbar">
                    <BitNumberField @bind-Value="scrollTargetIndex" Min="0" Max="99999" Style="max-width:9rem" />
                    <BitButton OnClick="() => ScrollToTarget(BitVirtualizeScrollAlignment.Start)">Start</BitButton>
                    <BitButton OnClick="() => ScrollToTarget(BitVirtualizeScrollAlignment.Center)">Center</BitButton>
                    <BitButton OnClick="() => ScrollToTarget(BitVirtualizeScrollAlignment.End)">End</BitButton>
                    <BitButton OnClick="() => ScrollToTarget(BitVirtualizeScrollAlignment.Auto)">Auto</BitButton>
                    <BitToggle @bind-Value="scrollSmooth" Label="Smooth" Inline />
                </div>
                <br />
                <div class="toolbar">
                    <BitButton Variant="BitVariant.Outline" OnClick="() => scrollRef.ScrollToStartAsync(scrollSmooth)">To start</BitButton>
                    <BitButton Variant="BitVariant.Outline" OnClick="() => scrollRef.ScrollByAsync(-500, scrollSmooth)">-500px</BitButton>
                    <BitButton Variant="BitVariant.Outline" OnClick="() => scrollRef.ScrollByAsync(500, scrollSmooth)">+500px</BitButton>
                    <BitButton Variant="BitVariant.Outline" OnClick="() => scrollRef.ScrollToEndAsync(scrollSmooth)">To end</BitButton>
                    <BitTag Text="@($"[{visibleRange.Start:N0}, {visibleRange.End:N0}) visible")" Color="BitColor.SecondaryBackground" />
                </div>
                <br />
                <BitVirtualize @ref="scrollRef" Items="scrollItems" ItemSize="48"
                               TItem="int" Context="item"
                               InitialIndex="500"
                               OnVisibleRangeChanged="range => visibleRange = range"
                               Class="list">
                    <div class="basic-item @(item == scrollTargetIndex ? "target" : null)">
                        <b>#@item.ToString("N0")</b>
                    </div>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="ScrollerSelector" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
                <div>
                    By default the list scrolls itself. <b>ScrollerSelector</b> hands the scrolling to an ancestor (or to the
                    page, with "window"): the list grows to the full size of its items, scrolls along with the content around
                    it, and still renders only the items in view.
                </div>
                <br />
                <div class="page-scroller">
                    <div class="page-content">Content above the list scrolls away with it.</div>
                    <BitVirtualize Items="pageItems" ItemSize="48" ScrollerSelector=".page-scroller"
                                   TItem="int" Context="item">
                        <div class="basic-item">Item @item</div>
                    </BitVirtualize>
                    <div class="page-content">Content below the list.</div>
                </div>
            </DemoExample>

            <DemoExample Title="Keyboard & accessibility" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
                <div>
                    Each item carries its position in the whole list (aria-posinset / aria-setsize), so a screen reader says
                    "article 12 of 10,000" with only a few items in the DOM. <b>Role</b> and <b>ItemRole</b> (list / listitem by
                    default) are set here to a feed of articles, and <b>AriaLabel</b> names it.
                </div>
                <br />
                <div>
                    Tab in, then use the arrows, PageUp / PageDown, Home and End: only the focused item is tabbable (roving
                    tabindex), the list scrolls to it, and it stays in the DOM - focused - when scrolled away with the mouse.
                    Keys pressed in an item's own controls are left to them.
                </div>
                <br />
                <BitVirtualize Items="articles" ItemSize="72"
                               TItem="Article" Context="article"
                               Role="feed" ItemRole="article" AriaLabel="News feed"
                               Class="list">
                    <div class="news-item">
                        <b>@article.Title</b>
                        <span>@article.Summary</span>
                    </div>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="Templates" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
                <div>
                    <b>HeaderTemplate</b> and <b>FooterTemplate</b> scroll with the items, inside the list. <b>EmptyTemplate</b>
                    replaces the items when there are none. <b>IndexedItemTemplate</b> also receives each item's <b>Index</b> in
                    the whole list, here to number and stripe the rows.
                </div>
                <br />
                <div class="toolbar">
                    <BitButton OnClick="() => templateItems = []">Empty the list</BitButton>
                    <BitButton OnClick="() => templateItems = [.. Enumerable.Range(0, 1_000)]">Refill the list</BitButton>
                </div>
                <br />
                <BitVirtualize Items="templateItems" ItemSize="48"
                               TItem="int"
                               Class="list">
                    <HeaderTemplate>
                        <div class="list-header">Header · @templateItems.Count.ToString("N0") items</div>
                    </HeaderTemplate>
                    <IndexedItemTemplate Context="context">
                        <div class="basic-item @(context.Index % 2 == 1 ? "odd" : null)">
                            <b>@(context.Index + 1).</b> Item @context.Item
                        </div>
                    </IndexedItemTemplate>
                    <FooterTemplate>
                        <div class="list-footer">Footer · end of the list</div>
                    </FooterTemplate>
                    <EmptyTemplate>
                        No items to show
                    </EmptyTemplate>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="Infinite scrolling" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
                <div>
                    <b>OnEndReached</b> fires once per item count when the last item comes within <b>ReachedThreshold</b> items
                    of the view. The handler appends a batch and calls <b>RefreshDataAsync</b> (or passes a new collection).
                </div>
                <br />
                <BitVirtualize @ref="feedRef" Items="feedItems" ItemSize="56"
                               TItem="string"
                               OnEndReached="LoadMoreFeedItems" ReachedThreshold="6"
                               Class="list">
                    <ItemTemplate Context="item">
                        <div class="basic-item">@item</div>
                    </ItemTemplate>
                    <FooterTemplate>
                        <div class="list-footer">@(feedLoading ? "Loading more..." : $"{feedItems.Count:N0} items loaded")</div>
                    </FooterTemplate>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="Sticky headers" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
                <div>
                    <b>IsStickyItem</b> marks the group headers: the current one stays pinned while its group scrolls, and the
                    next pushes it out. <b>StickyTemplate</b> renders the pinned copy, which is hidden from assistive
                    technologies (they read the real header in its place).
                </div>
                <br />
                <BitVirtualize Items="contacts" Dynamic EstimatedItemSize="56"
                               TItem="Contact"
                               IsStickyItem="c => c.IsHeader"
                               Class="list">
                    <ItemTemplate Context="contact">
                        @if (contact.IsHeader)
                        {
                            <div class="group-header">@contact.Name</div>
                        }
                        else
                        {
                            <div class="contact">
                                <b>@contact.Name</b>
                                <span>@contact.Email</span>
                            </div>
                        }
                    </ItemTemplate>
                    <StickyTemplate Context="contact">
                        <div class="group-header pinned">@contact.Name</div>
                    </StickyTemplate>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="ItemKey" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
                <div>
                    By default rows are keyed by index, so an insertion hands every following row's state to another item.
                    With <b>ItemKey</b> each row keeps its state (tick some boxes, then add or remove tasks), measured sizes follow
                    their items, and the item at the top stays put when items change above it (scroll down a little first).
                </div>
                <br />
                <div class="toolbar">
                    <BitButton OnClick="AddTasks">Add 5 at the top</BitButton>
                    <BitButton OnClick="RemoveTasks" IsEnabled="@(tasks.Count > 0)">Remove the first 5</BitButton>
                </div>
                <br />
                <BitVirtualize Items="tasks" ItemSize="48" ItemKey="t => t.Id"
                               TItem="TaskItem" Context="task"
                               Class="list">
                    <div class="basic-item">
                        <BitCheckbox Label="@task.Title" />
                    </div>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="Reversed (chat)" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
                <div>
                    <b>Reversed</b> starts at the newest message and stays pinned there as messages arrive. Scrolling up,
                    <b>OnStartReached</b> prepends older history without moving the view. <b>AlignToEnd</b> keeps a short
                    conversation at the bottom (start a new one to see it).
                </div>
                <br />
                <BitVirtualize @ref="chatRef" Items="messages" Dynamic EstimatedItemSize="48"
                               TItem="Message"
                               Reversed AlignToEnd ItemKey="m => m.Id"
                               OnStartReached="LoadChatHistory" ReachedThreshold="3"
                               AriaLabel="Messages"
                               Class="list">
                    <HeaderTemplate>
                        <div class="list-header">@(loadingChatHistory ? "Loading older messages..." : chatHistoryRemaining > 0 ? "Scroll up for older messages" : "This is the beginning of the conversation")</div>
                    </HeaderTemplate>
                    <ItemTemplate Context="message">
                        <div class="message @(message.Mine ? "mine" : null)">
                            <div class="bubble">@message.Text</div>
                        </div>
                    </ItemTemplate>
                </BitVirtualize>
                <div class="composer">
                    <BitTextField @bind-Value="draftMessage" Immediate Placeholder="Write a message..." AriaLabel="Message" Style="flex-grow:1" />
                    <BitButton OnClick="SendChatMessage" IsEnabled="@(string.IsNullOrWhiteSpace(draftMessage) is false)">Send</BitButton>
                </div>
                <div class="composer">
                    <BitButton Variant="BitVariant.Outline" OnClick="() => chatRef.ScrollToEndAsync(smooth: true)">Jump to latest</BitButton>
                    <BitButton Variant="BitVariant.Outline" OnClick="NewConversation">New conversation</BitButton>
                </div>
            </DemoExample>

            <DemoExample Title="Cascading parameters" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
                <div>
                    <b>BitParams</b> with a <b>BitVirtualizeParams</b> sets defaults (sizing, overscan, roles, state templates,
                    styles) for every list under it. A list's own value wins: the second keeps its own ItemSize.
                </div>
                <br />
                <BitParams Parameters="virtualizeParams">
                    <BitVirtualize Items="styleItems" TItem="int" Context="item">
                        <div class="basic-item">Item @item</div>
                    </BitVirtualize>
                    <br />
                    <BitVirtualize Items="styleItems" ItemSize="64" TItem="int" Context="item">
                        <div class="basic-item">Item @item</div>
                    </BitVirtualize>
                </BitParams>
            </DemoExample>

            <DemoExample Title="Style & Class" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
                <div>
                    <b>Style</b> and <b>Class</b> reach the root, which is the scroll container. <b>Styles</b> and <b>Classes</b>
                    reach each part: <b>Root</b>, <b>Header</b>, <b>Item</b>, <b>Sticky</b>, <b>Footer</b>, <b>Loading</b> and
                    <b>Empty</b>. The public <b>--bit-Virtualize-*</b> CSS variables restyle the focus ring, the pinned item and
                    the states, here or for the whole app from <code>:root</code>.
                </div>
                <br />
                <div>Style & Class:</div><br />
                <BitVirtualize Items="styleItems" ItemSize="48"
                               TItem="int" Context="item"
                               Style="height: 15rem; border: 2px solid dodgerblue; border-radius: 0.5rem;"
                               Class="custom-class">
                    <div class="basic-item">Item @item</div>
                </BitVirtualize>
                <br /><br />
                <div>Styles:</div><br />
                <BitVirtualize Items="styleItems" ItemSize="48"
                               TItem="int"
                               IsStickyItem="i => i % 10 == 0"
                               Styles="@(new() { Root = "height: 15rem; border: 1px solid tomato;",
                                                 Header = "padding: 0.5rem 1rem; color: white; background: tomato;",
                                                 Sticky = "color: white; background: darkorange;",
                                                 Item = "padding-inline-start: 1rem;" })">
                    <HeaderTemplate>Header</HeaderTemplate>
                    <ItemTemplate Context="item">
                        <div class="basic-item">@(item % 10 == 0 ? $"Group {item / 10}" : $"Item {item}")</div>
                    </ItemTemplate>
                </BitVirtualize>
                <br /><br />
                <div>Classes:</div><br />
                <BitVirtualize Items="styleItems" ItemSize="48"
                               TItem="int" Context="item"
                               Classes="@(new() { Root = "custom-root", Item = "custom-item", Footer = "custom-footer" })">
                    <ItemTemplate>
                        <div class="basic-item">Item @item</div>
                    </ItemTemplate>
                    <FooterTemplate>Footer</FooterTemplate>
                </BitVirtualize>
                <br /><br />
                <div>CSS variables (Tab in to see the focus ring):</div><br />
                <BitVirtualize Items="styleItems" ItemSize="48"
                               TItem="int"
                               IsStickyItem="i => i % 10 == 0"
                               Class="list short-list"
                               Style="@cssVariablesStyle">
                    <ItemTemplate Context="item">
                        <div class="basic-item">@(item % 10 == 0 ? $"Group {item / 10}" : $"Item {item}")</div>
                    </ItemTemplate>
                </BitVirtualize>
            </DemoExample>

            <DemoExample Title="RTL" RazorCode="@example16RazorCode" CsharpCode="@example16CsharpCode" Id="example16">
                <div>
                    With <b>Dir</b> set to Rtl, a horizontal list starts at the right and scrolls left, and the arrow keys follow
                    the reading direction (ArrowLeft moves to the next item, or the next lane of a grid).
                </div>
                <br />
                <BitVirtualize Items="horizontalItems" ItemSize="120" Horizontal Dir="BitDir.Rtl"
                               TItem="int" Context="item"
                               Class="horizontal-list">
                    <div class="tile">
                        <b>مورد @item.ToString("N0")</b>
                    </div>
                </BitVirtualize>
            </DemoExample>
        </Examples>
    </DemoPage>
</div>
