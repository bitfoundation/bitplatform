@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Values on the bars" RazorCode="@barsRazorCode" CsharpCode="@barsCsharpCode" Id="datalabels-bars">
    <div class="example-desc">
        <code>Plugins.DataLabels</code> prints each value on the chart. <code>Anchor</code> picks the point on the
        element (tip, middle or baseline) and <code>Align</code> places the label outside, on or inside that point.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="Sales()" Options="_outside" /></div></div>
</DemoExample>

<DemoExample Title="Inside the bars" RazorCode="@insideRazorCode" CsharpCode="@insideCsharpCode" Id="datalabels-inside">
    <div class="example-desc">
        <code>Anchor = End</code> with <code>Align = Start</code> puts the label inside the bar; a
        <code>BackgroundColor</code> turns it into a pill that stays readable over any fill.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="Sales()" Options="_inside" /></div></div>
</DemoExample>

<DemoExample Title="Formatted labels on a line" RazorCode="@lineRazorCode" CsharpCode="@lineCsharpCode" Id="datalabels-line">
    <div class="example-desc">
        Line, scatter and radar points take labels too. <code>Formatter</code> shapes the text and
        <code>DisplayFn</code> filters which elements get one - here only values above 250.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Traffic()" Options="_line" /></div></div>
</DemoExample>

<DemoExample Title="Percentages in a doughnut" RazorCode="@doughnutRazorCode" CsharpCode="@doughnutCsharpCode" Id="datalabels-doughnut">
    <div class="example-desc">
        On arcs the anchor moves the label between the ring's inner and outer edge. <code>FormatterCtx</code> also
        receives the dataset and data index, which makes share-of-total labels possible.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Doughnut" Data="BitChartSampleData.Traffic()" Options="_doughnut" /></div></div>
</DemoExample>
