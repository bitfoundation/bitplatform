@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Hover anywhere" RazorCode="@anywhereRazorCode" CsharpCode="@anywhereCsharpCode" Id="interaction-anywhere">
    <div class="example-desc">
        With the default <code>Interaction.Intersect = false</code>, hovering anywhere over a category activates
        that index, so marker-less lines (<code>PointRadius = 0</code>) stay hoverable.
        <code>Interaction.Crosshair</code> and <code>Interaction.CrosshairLabel</code> toggle the crosshair and its
        axis chip.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Series()" Options="_default" /></div></div>
</DemoExample>

<DemoExample Title="Require an intersection" RazorCode="@intersectRazorCode" CsharpCode="@intersectCsharpCode" Id="interaction-intersect">
    <div class="example-desc">
        <code>Interaction.Intersect = true</code> makes only the element directly under the pointer react, so a
        dataset without visible markers has nothing to hover.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Markers()" Options="_intersect" /></div></div>
</DemoExample>

<DemoExample Title="Interaction modes" RazorCode="@modesRazorCode" CsharpCode="@modesCsharpCode" Id="interaction-modes">
    <div class="example-desc">
        <code>Interaction.Mode</code> picks which elements join the hovered one: <code>Nearest</code> just that
        one, <code>Index</code> every series at the same label, <code>Dataset</code> the whole series.
        <code>Plugins.Tooltip.Mode</code> overrides it for the tooltip.
    </div>
    <div class="controls">
        <label>
            Mode
            <select @bind="_mode">
                <option value="@BitChartInteractionMode.Nearest">Nearest</option>
                <option value="@BitChartInteractionMode.Index">Index</option>
                <option value="@BitChartInteractionMode.Dataset">Dataset</option>
            </select>
        </label>
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="ModeOptions()" /></div></div>
</DemoExample>

<DemoExample Title="Loading and empty states" RazorCode="@emptyRazorCode" CsharpCode="@emptyCsharpCode" Id="interaction-empty">
    <div class="example-desc">
        <code>IsLoading</code> veils the plot with a spinner and <code>LoadingLabel</code> (or your
        <code>LoadingTemplate</code>), marks the chart <code>aria-busy</code> and holds back the empty state.
        With nothing to draw, the chart shows <code>NoDataText</code> or your <code>NoDataTemplate</code> instead
        of bare axes.
    </div>
    <div class="buttons-container">
        <BitButton Variant="BitVariant.Outline" OnClick="Reload" Disabled="_loading">Reload</BitButton>
        <BitButton Variant="BitVariant.Outline" OnClick="ToggleEmpty">@(_hasData ? "Clear the data" : "Restore the data")</BitButton>
    </div>
    <div class="chart-wrapper">
        <div class="chart-container">
            <BitChart Type="BitChartType.Bar"
                      Data="EmptyDemoData()"
                      IsLoading="_loading"
                      LoadingLabel="Fetching revenue..."
                      NoDataText="No results for this filter" />
        </div>
    </div>
</DemoExample>

<DemoExample Title="Linked charts" RazorCode="@linkedRazorCode" CsharpCode="@linkedCsharpCode" Id="interaction-linked">
    <div class="example-desc">
        <code>OnElementHover</code> reports the active items whenever they change, and null when none are active -
        enough to link charts, as here, or drive a shared readout or table highlight.
    </div>
    <div class="linked-readout">@(_linked ?? "Hover either chart")</div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="_linkedOptions" OnElementHover="Link" /></div></div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="BitChartSampleData.MonthlySales()" Options="_linkedOptions" OnElementHover="Link" /></div></div>
</DemoExample>
