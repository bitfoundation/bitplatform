@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Daily series (auto unit)" RazorCode="@dailyRazorCode" CsharpCode="@dailyCsharpCode" Id="time-daily">
    <div class="example-desc">
        A time scale reads each x value as an OLE Automation date (<code>DateTime.ToOADate</code>), places uneven
        samples at their true position, and picks the tick unit from the span - weekly here.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="BitChartSampleData.TimeSeries()" Options="@_time" /></div></div>
</DemoExample>

<DemoExample Title="Forced month unit + custom format" RazorCode="@monthRazorCode" CsharpCode="@monthCsharpCode" Id="time-month">
    <div class="example-desc">
        <code>TimeUnit</code> forces a unit when the automatic choice is too fine or too coarse, and
        <code>TimeFormat</code> takes over the label text entirely.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="BitChartSampleData.TimeSeries()" Options="@_month" /></div></div>
</DemoExample>
