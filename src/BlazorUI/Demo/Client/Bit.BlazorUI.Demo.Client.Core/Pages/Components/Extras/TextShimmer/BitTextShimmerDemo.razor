@page "/components/textshimmer"

<PageOutlet Url="components/textshimmer"
            Title="TextShimmer"
            Description="BitTextShimmer sweeps a bright band across a run of text, the signal an AI thinking label, a loading message or a progressive reveal needs - in pure CSS, in every render mode." />

<DemoPage Name="TextShimmer"
          SecondaryNames="@(["ShinyText", "Skeleton", "Loading", "AI"])"
          Description="BitTextShimmer sweeps a bright band across a run of text - for AI thinking labels, loading messages and progressive reveals. It is pure CSS, so it works in every render mode including static SSR. The text stays real text for copying, find-in-page and screen readers, and falls back to a flat color under reduced motion, forced colors and print."
          Parameters="componentParameters"
          CssVariables="componentCssVariables"
          SubEnums="componentSubEnums"
          GitHubExtrasUrl="TextShimmer/BitTextShimmer.cs"
          GitHubDemoUrl="Extras/TextShimmer/BitTextShimmerDemo.razor">
    <NotesTemplate>
        <BitText>
            To use this component, you need to install the
            <BitLink Href="https://www.nuget.org/packages/Bit.BlazorUI.Extras" Target="_blank">
                <BitTag Reversed
                        Text="Bit.BlazorUI.Extras"
                        Color="BitColor.SecondaryBackground"
                        IconName="@BitIconName.NavigateExternalInline" />
            </BitLink>
            nuget package, as described in the Optional steps of the
            <BitLink Href="/getting-started">Getting started</BitLink> page.
        </BitText>
        <br />
        <BitText>
            BitTextShimmer honors the reduced motion preference (prefers-reduced-motion) and shows the text at rest instead.
            If the band does not sweep, turn off reduced motion or use the ForceAnimation toggle at the top of this page.
        </BitText>
    </NotesTemplate>
    <Examples>
        <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
            <div>
                Give it a <b>Text</b>: a band sweeps across it in the reading direction, scaled to the length of the text.
                <b>ForceAnimation</b> keeps it moving under reduced motion - reserve it for motion that carries a meaning.
            </div>
            <br />
            <BitTextShimmer Text="Thinking about your question..." />
            <br />
            <BitTextShimmer ForceAnimation Text="This shimmer keeps animating even in reduced motion mode" />
        </DemoExample>

        <DemoExample Title="Element" RazorCode="@example2RazorCode" Id="example2">
            <div>
                Renders a <b>p</b> by default. <b>Element</b> picks another tag: a heading, or a <b>span</b> inside a sentence or a button.
                The font is inherited, so inside a <b>BitText</b> the shimmer takes the typography of the theme.
            </div>
            <br />
            <BitTextShimmer Element="h1" Text="A shimmering heading" />
            <br />
            <div>An <BitTextShimmer Element="span" Text="inline text shimmer" /> in the middle of a sentence.</div>
            <br />
            <BitText Typography="BitTypography.H4">
                <BitTextShimmer Element="span" Text="A heading in the typography of the theme" />
            </BitText>
        </DemoExample>

        <DemoExample Title="Band" RazorCode="@example3RazorCode" Id="example3">
            <div>
                <b>Spread</b> is the half-width of the band in px per character (2 by default): wider is a soft glow, narrower a crisp
                glint. <b>SpreadLength</b> replaces it with any CSS length; a font-relative one (<b>em</b>, <b>ch</b>) looks alike at every
                font size. <b>Angle</b> tilts the band in degrees - keep it within about 45 either way.
            </div>
            <br />
            <BitTextShimmer Spread="5" Text="A wide shimmer band" />
            <br />
            <BitTextShimmer Spread="0.5" Text="A narrow shimmer band" />
            <br />
            <BitTextShimmer SpreadLength="2em" Element="h3" Text="A band two ems wide" />
            <br />
            <BitTextShimmer Angle="25" Element="h2" Text="A band tilted by 25 degrees" />
            <br />
            <BitTextShimmer Angle="-25" Element="h2" Text="A band tilted by -25 degrees" />
        </DemoExample>

        <DemoExample Title="Content" RazorCode="@example4RazorCode" Id="example4">
            <div>
                <b>ChildContent</b> shimmers any markup and wins over <b>Text</b>. Its length cannot be measured, so set
                <b>ContentLength</b> (10 by default) or a font-relative <BitLink Href="#example3">SpreadLength</BitLink>.
                A part that keeps its own colors (an emoji) or is transformed (a spinning icon) needs
                <b>-webkit-text-fill-color: currentcolor</b>.
            </div>
            <br />
            <BitTextShimmer ContentLength="30">
                Thinking <strong>really</strong> hard about it...
            </BitTextShimmer>
            <br />
            <BitTextShimmer SpreadLength="3em">
                <BitIcon IconName="@BitIconName.Robot" /> Searching <em>the docs</em> for an answer...
            </BitTextShimmer>
            <br />
            <BitTextShimmer SpreadLength="3em">
                <span style="-webkit-text-fill-color:currentcolor">✨</span> Generating a summary...
            </BitTextShimmer>
        </DemoExample>

        <DemoExample Title="Timing" RazorCode="@example5RazorCode" Id="example5">
            <div>
                <b>Duration</b> is one sweep in ms (2000 by default). <b>RepeatDelay</b> rests between sweeps without changing the speed
                of the band - calmer for a long wait. <b>Delay</b> postpones the first sweep; staggered, it turns a list into one wave.
            </div>
            <br />
            <BitTextShimmer Duration="4000" Text="Slow and calm shimmer (4 seconds)" />
            <br />
            <BitTextShimmer Duration="750" Text="Fast and urgent shimmer (750 milliseconds)" />
            <br />
            <BitTextShimmer RepeatDelay="2000" Text="A sweep, then an extra two seconds of rest" />
            <br /><br />
            <BitTextShimmer Delay="0" Text="Reading the question..." />
            <br />
            <BitTextShimmer Delay="250" Text="Searching the knowledge base..." />
            <br />
            <BitTextShimmer Delay="500" Text="Drafting an answer..." />
        </DemoExample>

        <DemoExample Title="Direction & iterations" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
            <div>
                <b>Reversed</b> sweeps against the reading direction, <b>Alternate</b> back and forth. <b>Iterations</b> plays a set
                number of sweeps and then rests - a single sweep is a reveal rather than a waiting state.
            </div>
            <br />
            <BitTextShimmer Reversed Text="Against the reading direction" />
            <br />
            <BitTextShimmer Alternate Text="Back and forth" />
            <br /><br />
            <BitButton OnClick="() => replayCount++">Replay</BitButton>
            <br /><br />
            <BitTextShimmer @key="@($"once-{replayCount}")" Iterations="1" Element="h2" Text="Revealed with a single sweep" />
            <br />
            <BitTextShimmer @key="@($"thrice-{replayCount}")" Iterations="3" Text="Three sweeps, then at rest" />
        </DemoExample>

        <DemoExample Title="Playback" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
            <div>
                <b>Paused</b> freezes the band where it is and resumes from there. <b>PauseOnHover</b> freezes it under the pointer or the
                focus, so it holds still for whoever is reading it. <b>Static</b> takes the band away - the finished state. A disabled
                shimmer rests too, dimmed.
            </div>
            <br />
            <BitToggle @bind-Value="isPaused" Text="Paused" />
            <BitTextShimmer Paused="isPaused" Text="Pause me and resume me" />
            <br /><br />
            <BitTextShimmer PauseOnHover Text="Hover over me to pause the sweep" />
            <br /><br />
            <BitToggle @bind-Value="isStatic" Text="Static" />
            <BitTextShimmer Static="isStatic" Text="Stop me and start me again" />
            <br /><br />
            <BitTextShimmer Disabled Text="A disabled shimmer" />
        </DemoExample>

        <DemoExample Title="Thinking status" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
            <div>
                An AI assistant pattern. Attributes that are not parameters are splatted onto the element, so <b>role="status"</b> makes
                it a polite live region; <BitLink Href="#example7">Static</BitLink> stops the band once the answer is in, and the same
                region announces it.
            </div>
            <br />
            <BitButton OnClick="AskAsync" Disabled="isThinking">Ask a question</BitButton>
            <br /><br />
            <BitTextShimmer role="status"
                            Static="isThinking is false"
                            RepeatDelay="1000"
                            Text="@(isThinking ? "Thinking about your question..." : thinkingResult)" />
        </DemoExample>

        <DemoExample Title="Cascading parameters" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
            <div>
                <b>BitParams</b> with a <b>BitTextShimmerParams</b> sets the defaults of every shimmer inside it, and a parameter of the
                shimmer itself still wins. A cascaded <b>Paused</b> is one "pause animations" switch for a whole region (WCAG 2.2.2).
            </div>
            <br />
            <BitToggle @bind-Value="pauseAll" Text="Pause animations" />
            <BitParams Parameters="shimmerParams">
                <BitTextShimmer Text="Reading the question..." />
                <br />
                <BitTextShimmer Text="Searching the knowledge base..." />
                <br />
                <BitTextShimmer Duration="1000" Text="Drafting an answer (its own Duration)..." />
            </BitParams>
        </DemoExample>

        <DemoExample Title="Color" RazorCode="@example10RazorCode" Id="example10">
            <div>
                <b>Color</b> paints the band in a theme color while the text rests in the dim foreground of the theme. <b>BaseColor</b>
                and <b>GradientColor</b> take any CSS color, and <b>GradientColor</b> wins over <b>Color</b>. Check <b>BaseColor</b> for
                contrast: it is what the text is read in.
            </div>
            <br />
            <BitTextShimmer Color="BitColor.Primary" Text="Primary" />
            <br />
            <BitTextShimmer Color="BitColor.Secondary" Text="Secondary" />
            <br />
            <BitTextShimmer Color="BitColor.Tertiary" Text="Tertiary" />
            <br />
            <BitTextShimmer Color="BitColor.Info" Text="Info" />
            <br />
            <BitTextShimmer Color="BitColor.Success" Text="Success" />
            <br />
            <BitTextShimmer Color="BitColor.Warning" Text="Warning" />
            <br />
            <BitTextShimmer Color="BitColor.SevereWarning" Text="SevereWarning" />
            <br />
            <BitTextShimmer Color="BitColor.Error" Text="Error" />
            <br /><br />
            <BitTextShimmer BaseColor="#64748b" GradientColor="#22d3ee" Text="An ocean colored shimmer" />
            <br />
            <BitTextShimmer BaseColor="#a16207" GradientColor="#fbbf24" Text="A golden colored shimmer" />
        </DemoExample>

        <DemoExample Title="Style & Class" RazorCode="@example11RazorCode" Id="example11">
            <div>
                <b>Style</b> and <b>Class</b> style the root. The public <b>--bit-TextShimmer-*</b> variables inherit, so setting them on
                <b>:root</b>, a container or a class restyles every shimmer below it; a parameter of the shimmer itself wins over them.
            </div>
            <br />
            @* A plain element of this page for the scoped ::deep .custom-class rule to anchor on. *@
            <div>
                <BitTextShimmer Style="font-size:2rem;font-weight:bold" Text="A styled text shimmer" />
                <br />
                <BitTextShimmer Class="custom-class" Text="A classy text shimmer" />
                <br /><br />
                <div style="--bit-TextShimmer-gradient-color:hotpink;--bit-TextShimmer-spread:2em;--bit-TextShimmer-duration:3s">
                    <BitTextShimmer Text="Restyled by the variables of its container" />
                    <br />
                    <BitTextShimmer GradientColor="deepskyblue" Text="Its own GradientColor wins" />
                </div>
            </div>
        </DemoExample>

        <DemoExample Title="RTL" RazorCode="@example12RazorCode" Id="example12">
            <div>
                In right-to-left text the band sweeps from right to left - whether the direction comes from <b>Dir</b> or from a
                <b>dir</b> attribute around it - and a tilted band is mirrored with it.
            </div>
            <br />
            <BitTextShimmer Dir="BitDir.Rtl" Text="در حال فکر کردن به سوال شما..." />
            <br />
            <div dir="rtl">
                <BitTextShimmer Text="در حال جستجو در مستندات..." />
            </div>
            <br />
            <BitTextShimmer Dir="BitDir.Rtl" Angle="25" Element="h2" Text="نواری که ۲۵ درجه کج شده است" />
        </DemoExample>
    </Examples>
</DemoPage>
