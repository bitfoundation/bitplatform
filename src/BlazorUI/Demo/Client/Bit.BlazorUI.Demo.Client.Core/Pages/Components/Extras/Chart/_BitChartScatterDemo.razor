@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Scatter" RazorCode="@scatterRazorCode" CsharpCode="@scatterCsharpCode" Id="scatter-scatter">
    <div class="example-desc">
        A scatter chart places each point at its own <code>(x, y)</code> on two linear axes, with no shared labels.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Scatter" Data="@ScatterData()" Options="_bottom" /></div></div>
</DemoExample>

<DemoExample Title="Bubble" RazorCode="@bubbleRazorCode" CsharpCode="@bubbleCsharpCode" Id="scatter-bubble">
    <div class="example-desc">
        A bubble chart adds a third measure: each point's <code>R</code> is its radius.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bubble" Data="@BubbleData()" Options="_bottom" /></div></div>
</DemoExample>
