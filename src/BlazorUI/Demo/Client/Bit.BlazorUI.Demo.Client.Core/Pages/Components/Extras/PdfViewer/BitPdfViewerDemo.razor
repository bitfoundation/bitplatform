@page "/components/pdfviewer"
@page "/components/pdfreader"

<PageOutlet Url="components/pdfviewer"
            Title="PdfViewer"
            Description="BitPdfViewer is a native pure-C# pdf viewer component for Blazor with a full reading toolbar and no js library dependency." />

<div>
    <DemoPage Name="PdfViewer"
              SecondaryNames="@(["PdfReader", "Pdf"])"
              Description="BitPdfViewer is a native pure-C# pdf viewer for Blazor: it parses pdf files and paints their pages as plain HTML/CSS (or onto a canvas), with no browser plugin and no js library. It ships a full reading toolbar - navigation, zoom and fit modes, page layouts, rotation, find, thumbnails, bookmarks, attachments and layers, printing, download, presentation and fullscreen - and everything the toolbar does is on the public API too."
              Parameters="componentParameters"
              PublicMembers="componentPublicMembers"
              CssVariables="componentCssVariables"
              SubClasses="componentSubClasses"
              SubEnums="componentSubEnums"
              GitHubExtrasUrl="PdfViewer/BitPdfViewer.razor"
              GitHubDemoUrl="Extras/PdfViewer/BitPdfViewerDemo.razor">
        <NotesTemplate>
            <BitText>
                To use this component, you need to install the
                <BitLink Href="https://www.nuget.org/packages/Bit.BlazorUI.Extras" Target="_blank">
                    <BitTag Reversed
                            Text="Bit.BlazorUI.Extras"
                            Color="BitColor.SecondaryBackground"
                            IconName="@BitIconName.NavigateExternalInline" />
                </BitLink>
                nuget package, as described in the Optional steps of the
                <BitLink Href="/getting-started">Getting started</BitLink> page.
            </BitText>
            <br />
            <BitText>
                Parsing and rendering run in .NET, so a document never leaves the app. On single-threaded WebAssembly
                that work shares the UI thread, which is why every example after the first loads its document on demand.
            </BitText>
        </NotesTemplate>
        <Examples>
            <DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
                <div>
                    A <b>BitPdfSource</b> is the document: <b>FromUrl</b> (fetched through the registered HttpClient),
                    <b>FromBytes</b>, <b>FromBase64</b> or <b>FromStreamAsync</b>. <b>AllowDropFile</b> also opens a pdf
                    dropped onto the viewer.
                </div>
                <br />
                <InputFile OnChange="OnBasicFileChange" accept=".pdf,application/pdf" />
                <br /><br />
                <BitPdfViewer Source="basicSource" AllowDropFile />
            </DemoExample>

            <DemoExample Title="Dimensions" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
                <div>
                    <b>Height</b> and <b>Width</b> take any CSS length. Unset, the viewer fills its host's width and is at
                    most 780px tall, shrinking with the viewport. A fit mode re-fits whenever the box resizes.
                </div>
                <br />
                <BitButton IsEnabled="heightSource is null" OnClick="() => heightSource = CreateSampleSource()">Load document</BitButton>
                <br /><br />
                <BitPdfViewer Source="heightSource" Height="400px" Width="min(100%, 40rem)" />
            </DemoExample>

            <DemoExample Title="Toolbar" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
                <div>
                    <b>ToolbarItems</b> (a flags enum) picks the built-in groups - a group left out takes its find, print or
                    download shortcut with it - and <b>ShowToolbar</b> hides the bar.
                    <b>ToolbarStartTemplate</b> and <b>ToolbarEndTemplate</b> add your own content, with the viewer as its
                    context. <b>OpenFile</b> adds a file picker; handle <b>OnFileOpened</b> to take the picked file
                    yourself, and <b>MaxOpenFileSize</b> caps what it reads.
                </div>
                <br />
                <BitButton IsEnabled="toolbarSource is null" OnClick="() => toolbarSource = CreateSampleSource()">Load document</BitButton>
                <br /><br />
                <BitPdfViewer Source="toolbarSource" Height="400px"
                              ToolbarItems="BitPdfToolbarItems.Navigation | BitPdfToolbarItems.Zoom | BitPdfToolbarItems.OpenFile | BitPdfToolbarItems.Fullscreen">
                    <ToolbarStartTemplate>
                        <BitTag Text="Draft" Color="BitColor.Warning" Variant="BitVariant.Outline" Size="BitSize.Small" />
                    </ToolbarStartTemplate>
                    <ToolbarEndTemplate>
                        <BitButton Size="BitSize.Small" Variant="BitVariant.Outline" IconName="@BitIconName.Share"
                                   OnClick="() => Share(context)">
                            Share
                        </BitButton>
                    </ToolbarEndTemplate>
                </BitPdfViewer>
                @if (toolbarMessage is not null)
                {
                    <br />
                    <div role="status">@toolbarMessage</div>
                }
            </DemoExample>

            <DemoExample Title="Sidebars" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
                <div>
                    Four side panels: page thumbnails, bookmarks (the document outline), embedded attachments and
                    optional-content layers. <b>DefaultSidebar</b> picks the one open when a document loads. Thumbnails
                    render lazily, and a panel with nothing to show keeps its toggle disabled.
                </div>
                <br />
                <BitButton IsEnabled="sidebarSource is null" OnClick="() => sidebarSource = CreateArticleSource()">Load document</BitButton>
                <br /><br />
                <BitPdfViewer Source="sidebarSource" Height="450px" DefaultSidebar="BitPdfSidebar.Thumbnails" />
            </DemoExample>

            <DemoExample Title="Zoom" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5">
                <div>
                    <b>InitialZoomMode</b> picks the starting fit: <b>Automatic</b> (fit width, capped at 125%),
                    <b>FitWidth</b>, <b>FitPage</b>, <b>FitHeight</b> or <b>ActualSize</b>. <b>ZoomPresets</b> replaces the
                    dropdown's percentages; <b>MinZoom</b>, <b>MaxZoom</b> and <b>ZoomStep</b> bound and pace every zoom,
                    including Ctrl+wheel and pinch, which keep the point under the cursor in place.
                </div>
                <br />
                <BitButton IsEnabled="zoomSource is null" OnClick="() => zoomSource = CreateSampleSource()">Load document</BitButton>
                <br /><br />
                <BitPdfViewer Source="zoomSource" Height="450px"
                              InitialZoomMode="BitPdfZoomMode.Automatic"
                              ZoomPresets="zoomPresets"
                              MinZoom="0.5" MaxZoom="3" ZoomStep="1.5" />
            </DemoExample>

            <DemoExample Title="Page layout" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
                <div>
                    <b>ScrollMode</b> stacks pages vertically, lays them in a horizontal row, wraps them, or shows one at a
                    time (a swipe turns it on touch). <b>SpreadMode</b> pairs them like an open book (<b>Even</b> keeps page 1 as a cover), and
                    <b>CursorTool</b> switches dragging between selecting text and panning. Presentation mode
                    (<kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>P</kbd>) combines them fullscreen and restores the layout on exit.
                </div>
                <br />
                <div style="display:flex;gap:1rem;flex-wrap:wrap">
                    <BitDropdown @bind-Value="scrollMode" Label="ScrollMode" TItem="BitDropdownOption<BitPdfScrollMode>" TValue="BitPdfScrollMode" Style="width:12rem">
                        <BitDropdownOption Text="Vertical" Value="BitPdfScrollMode.Vertical" />
                        <BitDropdownOption Text="Horizontal" Value="BitPdfScrollMode.Horizontal" />
                        <BitDropdownOption Text="Wrapped" Value="BitPdfScrollMode.Wrapped" />
                        <BitDropdownOption Text="Page" Value="BitPdfScrollMode.Page" />
                    </BitDropdown>
                    <BitDropdown @bind-Value="spreadMode" Label="SpreadMode" TItem="BitDropdownOption<BitPdfSpreadMode>" TValue="BitPdfSpreadMode" Style="width:12rem">
                        <BitDropdownOption Text="None" Value="BitPdfSpreadMode.None" />
                        <BitDropdownOption Text="Odd" Value="BitPdfSpreadMode.Odd" />
                        <BitDropdownOption Text="Even" Value="BitPdfSpreadMode.Even" />
                    </BitDropdown>
                    <BitToggle @bind-Value="panTool" Label="Pan tool" />
                </div>
                <br />
                <BitButton IsEnabled="layoutSource is null" OnClick="() => layoutSource = CreateArticleSource()">Load document</BitButton>
                <br /><br />
                <BitPdfViewer Source="layoutSource" Height="500px"
                              ScrollMode="scrollMode"
                              SpreadMode="spreadMode"
                              CursorTool="@(panTool ? BitPdfCursorTool.Pan : BitPdfCursorTool.Select)" />
            </DemoExample>

            <DemoExample Title="Find in document" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
                <div>
                    Matches are counted over the whole document without rendering it, and painted with the CSS Custom
                    Highlight API. The options match case, whole words and diacritics (off by default, so <i>resume</i>
                    finds <i>résumé</i>), and paint every match or only the current one. <b>Search</b>,
                    <b>SetSearchOptions</b>, <b>FindNext</b> and <b>ClearSearch</b> do the same from code.
                </div>
                <br />
                <BitButton IsEnabled="searchSource is null" OnClick="() => searchSource = CreateArticleSource()">Load document</BitButton>
                <BitButton IsEnabled="searchSource is not null" OnClick="() => searchViewerRef.Search(searchTerm)">Search from code</BitButton>
                <BitButton IsEnabled="searchSource is not null" OnClick="() => searchViewerRef.SetSearchOptions(matchCase: true, wholeWord: true)">Case + whole word</BitButton>
                <br /><br />
                <BitTextField @bind-Value="searchTerm" Label="Term" Style="max-width:16rem" />
                <br />
                <BitPdfViewer @ref="searchViewerRef" Source="searchSource" Height="450px" />
            </DemoExample>

            <DemoExample Title="Rendering" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
                <div>
                    <b>RenderMode</b>: <b>Html</b> (default) lays pages out as prerenderable positioned DOM; <b>Canvas</b>
                    paints them onto a canvas - far fewer DOM nodes - while selection, find and links keep working.
                    <b>TextCoalescing</b>: <b>Compact</b> merges same-line runs into one span per line, at a small position
                    cost. <b>BackgroundRendering</b> moves the work off the UI thread where the runtime has a spare one.
                </div>
                <br />
                <div style="display:flex;gap:2rem;flex-wrap:wrap">
                    <BitChoiceGroup @bind-Value="renderMode" Horizontal Label="RenderMode" TItem="BitChoiceGroupOption<BitPdfRenderMode>" TValue="BitPdfRenderMode">
                        <BitChoiceGroupOption Text="Html" Value="BitPdfRenderMode.Html" />
                        <BitChoiceGroupOption Text="Canvas" Value="BitPdfRenderMode.Canvas" />
                    </BitChoiceGroup>
                    <BitChoiceGroup @bind-Value="textCoalescing" Horizontal Label="TextCoalescing" TItem="BitChoiceGroupOption<BitPdfTextCoalescing>" TValue="BitPdfTextCoalescing">
                        <BitChoiceGroupOption Text="Exact" Value="BitPdfTextCoalescing.Exact" />
                        <BitChoiceGroupOption Text="Compact" Value="BitPdfTextCoalescing.Compact" />
                    </BitChoiceGroup>
                </div>
                <br />
                <BitButton IsEnabled="renderingSource is null" OnClick="() => renderingSource = CreateArticleSource()">Load document</BitButton>
                <br /><br />
                <BitPdfViewer Source="renderingSource" Height="450px" BackgroundRendering
                              RenderMode="renderMode"
                              TextCoalescing="textCoalescing" />
            </DemoExample>

            <DemoExample Title="Document info" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
                <div>
                    The toolbar's info button opens the properties dialog. The same data is on the reference -
                    <b>Metadata</b>, <b>Permissions</b>, <b>PageLabels</b>, <b>FormFields</b>, <b>StructureTree</b> and the
                    parsed <b>Document</b> - for indexing or auditing without parsing twice.
                </div>
                <br />
                <BitButton IsEnabled="infoSource is null" OnClick="() => infoSource = CreateArticleSource()">Load document</BitButton>
                <br /><br />
                <BitPdfViewer @ref="infoViewerRef" Source="infoSource" Height="400px" OnDocumentLoaded="StateHasChanged" />
                <br />
                @if (infoViewerRef?.Document is not null)
                {
                    <div class="pdf-info">
                        <div>Title: @(infoViewerRef.Metadata?.Title ?? "-")</div>
                        <div>Producer: @(infoViewerRef.Metadata?.Producer ?? "-")</div>
                        <div>Pdf version: @(infoViewerRef.PdfVersion ?? "-")</div>
                        <div>Encrypted: @infoViewerRef.IsEncrypted</div>
                        <div>Can print: @infoViewerRef.Permissions.CanPrint, can copy: @infoViewerRef.Permissions.CanCopy</div>
                        <div>Form fields: @infoViewerRef.FormFields.Count</div>
                        <div>File size: @infoViewerRef.FileSize bytes</div>
                    </div>
                }
            </DemoExample>

            <DemoExample Title="Encrypted documents" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
                <div>
                    An encrypted document asks for its password in a built-in dialog. <b>WithPassword</b> carries a known
                    one on the source, <b>OnPasswordRequested</b> replaces the dialog with your own UI, and
                    <b>ShowPasswordPrompt</b>=false reports the failure through <b>OnError</b> instead.
                    <b>RespectPermissions</b> enforces the owner's no-print / no-copy flags (advisory, so off by default).
                </div>
                <br />
                <div>Select an encrypted pdf file to try it:</div>
                <InputFile OnChange="OnPasswordFileChange" accept=".pdf,application/pdf" />
                <br /><br />
                <BitPdfViewer Source="passwordSource" Height="400px" RespectPermissions />
            </DemoExample>

            <DemoExample Title="Loading, empty & error states" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
                <div>
                    <b>LoadingTemplate</b> replaces the page-shaped placeholder while a document is fetched and parsed,
                    <b>EmptyTemplate</b> the message of a viewer with no document, and <b>ErrorTemplate</b> that of a
                    failed load, with the message <b>OnError</b> receives. A failure is announced as an alert either way.
                </div>
                <br />
                <BitButton OnClick="() => statesSource = CreateArticleSource()">Load a document</BitButton>
                <BitButton OnClick="LoadBrokenFile">Load a broken file</BitButton>
                <BitButton IsEnabled="statesSource is not null" OnClick="() => statesSource = null">Clear</BitButton>
                <br /><br />
                <BitPdfViewer Source="statesSource" Height="300px" AllowDropFile>
                    <LoadingTemplate>
                        <BitSpinnerLoading Label="Opening the document..." />
                    </LoadingTemplate>
                    <EmptyTemplate>
                        <BitText>Drop a pdf file here.</BitText>
                    </EmptyTemplate>
                    <ErrorTemplate>
                        <BitText Color="BitColor.Error">This file could not be opened: @context</BitText>
                    </ErrorTemplate>
                </BitPdfViewer>
            </DemoExample>

            <DemoExample Title="Events" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
                <div>
                    Every state change is reported: loading, page, zoom, rotation and sidebar, each rendered page
                    (<b>OnPageRendered</b>), load progress of a URL source (<b>OnProgress</b>), non-fatal parse
                    diagnostics (<b>OnWarnings</b>) and failures (<b>OnError</b>). <b>OnDownloading</b> and
                    <b>OnPrinting</b> run first, whatever started them (toolbar, shortcut or code): this one renames the
                    download and can block printing.
                </div>
                <br />
                <BitToggle @bind-Value="blockPrinting" Label="Block printing" />
                <BitButton IsEnabled="eventsSource is null" OnClick="() => eventsSource = CreateSampleSource()">Load document</BitButton>
                <br /><br />
                <BitPdfViewer Source="eventsSource" Height="400px"
                              OnDocumentLoaded='() => eventsLog.Add("Document loaded")'
                              OnPageChanged='p => eventsLog.Add($"Page changed: {p}")'
                              OnPageRendered='p => eventsLog.Add($"Page rendered: {p}")'
                              OnZoomChanged='z => eventsLog.Add($"Zoom changed: {z:P0}")'
                              OnRotationChanged='r => eventsLog.Add($"Rotation changed: {r}deg")'
                              OnSidebarChanged='s => eventsLog.Add($"Sidebar changed: {s}")'
                              OnWarnings='w => eventsLog.Add($"Warnings: {w.Count}")'
                              OnProgress='p => eventsLog.Add($"Loading: {p:P0}")'
                              OnError='e => eventsLog.Add($"Error: {e}")'
                              OnDownloading="HandleDownloading"
                              OnPrinting="HandlePrinting" />
                <br />
                <div>Events:</div>
                <div style="max-height:8rem;overflow:auto">
                    @foreach (var log in Enumerable.Reverse(eventsLog).Take(8))
                    {
                        <div>@log</div>
                    }
                </div>
            </DemoExample>

            <DemoExample Title="Binding" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
                <div>
                    <b>CurrentPage</b>, <b>Zoom</b> and <b>Rotation</b> are two-way bindable. Bound one way (no
                    <b>Changed</b> callback) the value is the host's to control, and the reader's moves arrive through the
                    events instead.
                </div>
                <br />
                <BitButton IsEnabled="bindingSource is null" OnClick="() => bindingSource = CreateArticleSource()">Load document</BitButton>
                <br /><br />
                <div style="display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-end">
                    <BitNumberField @bind-Value="boundPage" Label="CurrentPage" Min="1" Style="max-width:9rem" />
                    <BitNumberField @bind-Value="boundZoom" Label="Zoom" Step="0.25" Min="0.1" Max="8" Style="max-width:9rem" />
                    <BitNumberField @bind-Value="boundRotation" Label="Rotation" Step="90" Style="max-width:9rem" />
                </div>
                <br />
                <BitPdfViewer Source="bindingSource" Height="400px"
                              @bind-CurrentPage="boundPage"
                              @bind-Zoom="boundZoom"
                              @bind-Rotation="boundRotation" />
            </DemoExample>

            <DemoExample Title="Public API" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
                <div>
                    Every toolbar action is a method, so your own chrome can drive a viewer whose toolbar is hidden.
                    <b>Print</b> takes the whole document, a page range, or (<b>PrintCurrentPage</b>) one page, at each
                    page's true size. <b>GoToDestination</b> lands on the exact spot a bookmark points at,
                    <b>GetSelectedText</b> reads what the reader highlighted, and <b>OpenAsync</b>, <b>ExtractText</b> and
                    <b>RenderPageHtml</b> are API-only.
                </div>
                <br />
                <BitButton IsEnabled="publicApiSource is null" OnClick="() => publicApiSource = CreateArticleSource()">Load document</BitButton>
                <br /><br />
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center">
                    <BitButton OnClick="() => pdfViewerRef.FirstPage()">First</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.PrevPage()">Prev</BitButton>
                    <BitTag Variant="BitVariant.Outline" Text="@PublicApiPosition" Color="BitColor.Info" />
                    <BitButton OnClick="() => pdfViewerRef.NextPage()">Next</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.LastPage()">Last</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.ZoomOut()">Zoom -</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.SetZoom(1)">100%</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.ZoomIn()">Zoom +</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.SetZoomMode(BitPdfZoomMode.FitPage)">Fit page</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.RotateClockwise()">Rotate</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.ShowSidebar(BitPdfSidebar.Thumbnails)">Thumbnails</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.GoToDestination(FirstBookmarkDestination())">First bookmark</BitButton>
                    <BitButton OnClick="ShowSelectedText">Selected text</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.Download()">Download</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.Print()">Print all</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.PrintCurrentPage()">Print page</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.Print(1, 2)">Print 1-2</BitButton>
                    <BitButton OnClick="() => pdfViewerRef.TogglePresentationMode()">Present</BitButton>
                </div>
                <br />
                <BitPdfViewer @ref="pdfViewerRef"
                              Source="publicApiSource"
                              Height="400px"
                              ShowToolbar="false"
                              OnDocumentLoaded="StateHasChanged"
                              OnPageChanged="_ => StateHasChanged()" />
                @if (selectedText is not null)
                {
                    <div>Selected: @(selectedText.Length == 0 ? "(nothing)" : selectedText)</div>
                }
            </DemoExample>

            <DemoExample Title="Localization" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
                <div>
                    Every string the viewer shows or announces comes from <b>Texts</b> (a <b>BitPdfViewerTexts</b>); set
                    only the ones you replace.
                </div>
                <br />
                <BitButton IsEnabled="localizedSource is null" OnClick="() => localizedSource = CreateSampleSource()">Load document</BitButton>
                <br /><br />
                <BitPdfViewer Source="localizedSource" Height="400px" Texts="germanTexts" />
            </DemoExample>

            <DemoExample Title="Keyboard & accessibility" RazorCode="@example16RazorCode" CsharpCode="@example16CsharpCode" Id="example16">
                <div>
                    With focus inside the viewer the familiar shortcuts work (and override the browser's <kbd>Ctrl</kbd>+
                    <kbd>F</kbd> / <kbd>P</kbd> / <kbd>S</kbd>), and each toolbar button announces its own through
                    <b>aria-keyshortcuts</b>; <b>EnableKeyboardShortcuts</b>=false hands them back. The
                    thumbnails are a listbox and the bookmarks a tree, each one tab stop moved by the arrow keys. Each page
                    is a named group whose text is read once, its links are named tab stops, and page moves are
                    announced; the dialogs trap focus and close on <kbd>Esc</kbd>. A disabled viewer
                    (<b>IsEnabled</b>=false) keeps showing the document with its chrome inert.
                </div>
                <br />
                <div class="pdf-shortcuts">
                    <div><kbd>n</kbd> <kbd>j</kbd> <kbd>PageDown</kbd> next page, <kbd>p</kbd> <kbd>k</kbd> <kbd>PageUp</kbd> previous</div>
                    <div><kbd>&#8594;</kbd> <kbd>&#8595;</kbd> <kbd>Space</kbd> next, <kbd>&#8592;</kbd> <kbd>&#8593;</kbd> <kbd>Shift</kbd>+<kbd>Space</kbd> previous - one page at a time</div>
                    <div><kbd>Home</kbd> <kbd>End</kbd> first / last page</div>
                    <div><kbd>Ctrl</kbd>+<kbd>+</kbd> <kbd>Ctrl</kbd>+<kbd>-</kbd> <kbd>Ctrl</kbd>+<kbd>0</kbd> zoom in / out / 100%</div>
                    <div><kbd>r</kbd> <kbd>Shift</kbd>+<kbd>r</kbd> rotate clockwise / counter-clockwise</div>
                    <div><kbd>Ctrl</kbd>+<kbd>F</kbd> <kbd>Ctrl</kbd>+<kbd>G</kbd> <kbd>Shift</kbd>+<kbd>Ctrl</kbd>+<kbd>G</kbd> find / next / previous</div>
                    <div><kbd>Ctrl</kbd>+<kbd>P</kbd> <kbd>Ctrl</kbd>+<kbd>S</kbd> print / download, <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>P</kbd> present</div>
                    <div><kbd>F4</kbd> toggle the sidebar, <kbd>Esc</kbd> close the find box, a dialog or presentation mode</div>
                </div>
                <br />
                <BitToggle @bind-Value="a11yEnabled" Label="IsEnabled" />
                <BitButton IsEnabled="a11ySource is null" OnClick="() => a11ySource = CreateArticleSource()">Load document</BitButton>
                <br /><br />
                <BitPdfViewer Source="a11ySource" Height="450px" DefaultSidebar="BitPdfSidebar.Bookmarks" IsEnabled="a11yEnabled" />
            </DemoExample>

            <DemoExample Title="Cascading parameters" RazorCode="@example17RazorCode" CsharpCode="@example17CsharpCode" Id="example17">
                <div>
                    <b>BitParams</b> with a <b>BitPdfViewerParams</b> sets defaults - texts, toolbar, size, zoom, styles -
                    for every viewer under it. A viewer's own value wins (the second keeps its own toolbar).
                </div>
                <br />
                <BitButton IsEnabled="cascadeSource is null" OnClick="() => cascadeSource = CreateSampleSource()">Load document</BitButton>
                <br /><br />
                <BitParams Parameters="pdfViewerParams">
                    <BitPdfViewer Source="cascadeSource" />
                    <br />
                    <BitPdfViewer Source="cascadeSource" ToolbarItems="BitPdfToolbarItems.All" />
                </BitParams>
            </DemoExample>

            <DemoExample Title="Style & Class" RazorCode="@example18RazorCode" CsharpCode="@example18CsharpCode" Id="example18">
                <div>
                    <b>Style</b> and <b>Class</b> reach the root; <b>Styles</b> and <b>Classes</b> reach each part. The public
                    <b>--bit-PdfViewer-*</b> CSS variables restyle a viewer here, or every viewer from <code>:root</code> -
                the third one also reads in a dark mode through <b>--bit-PdfViewer-page-filter</b>.
                </div>
                <br />
                <BitButton IsEnabled="styleSource is null" OnClick="() => styleSource = CreateSampleSource()">Load document</BitButton>
                <br /><br />
                <div>Component's Style & Class:</div>
                <br />
                <BitPdfViewer Source="styleSource" Height="300px" Style="border-color:tomato" Class="custom-class" />
                <br /><br />
                <div>Styles & Classes:</div>
                <br />
                <BitPdfViewer Source="styleSource" Height="300px"
                              Classes="@(new() { Toolbar = "custom-toolbar" })"
                              Styles="@(new() { Toolbar = "background:var(--bit-clr-pri);color:var(--bit-clr-pri-text)",
                                                ToolbarButton = "color:var(--bit-clr-pri-text)" })" />
                <br /><br />
