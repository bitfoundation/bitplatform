@page "/components/pdfviewer"
@page "/components/pdfreader"

<PageOutlet Url="components/pdfviewer"
            Title="PdfViewer"
            Description="BitPdfViewer is a native pure-C# pdf viewer component for Blazor with no js library dependency." />

<DemoPage Name="PdfViewer"
          SecondaryNames="@(["PdfReader, Pdf"])"
          Description="BitPdfViewer is a native pure-C# pdf viewer component for Blazor. It parses pdf files and renders pages as plain HTML/CSS DOM (or onto a canvas) with no browser pdf plugin and no js library dependency, offering page navigation, zoom and fit modes, rotation, find-in-document, thumbnails, bookmarks, download, print, fullscreen, keyboard shortcuts and a document-properties dialog out of the box, plus read access to the parsed document (metadata, permissions, page labels, form fields and the tagged structure tree)."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          GitHubExtrasUrl="PdfViewer/BitPdfViewer.razor"
          GitHubDemoUrl="Extras/PdfViewer/BitPdfViewerDemo.razor">
    <NotesTemplate>
        <BitText>
            To use this component, you need to install the
            <BitLink Href="https://www.nuget.org/packages/Bit.BlazorUI.Extras" Target="_blank">
                <BitTag Reversed
                        Text="Bit.BlazorUI.Extras"
                        Color="BitColor.SecondaryBackground"
                        IconName="@BitIconName.NavigateExternalInline" />
            </BitLink>
            nuget package, as described in the Optional steps of the
            <BitLink Href="/getting-started">Getting started</BitLink> page.
        </BitText>
        <br />
        <BitText>
            Parsing and rendering happen entirely in .NET, so a document never leaves the app and no server round-trip
            is needed. On the single-threaded WebAssembly runtime that work shares the UI thread, which is why every
            example below other than the first one loads its document on demand.
        </BitText>
    </NotesTemplate>
    <Examples>
        <DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
            <div>
                A document is described by a <BitTag Text="BitPdfSource" Color="BitColor.Info" />: either
                <BitTag Text="FromUrl" Color="BitColor.SecondaryBackground" /> (fetched through the registered
                <code>HttpClient</code>) or <BitTag Text="FromBytes" Color="BitColor.SecondaryBackground" /> for a buffer
                you already have - an upload, a database blob, an embedded resource. Everything else is on by default:
                the toolbar, lazy per-page rendering as you scroll, selectable text, and clickable links.
            </div>
            <br />
            <div>You can also select a pdf file from your computer to view it here:</div>
            <InputFile OnChange="OnBasicFileChange" accept=".pdf,application/pdf" />
            <br /><br />
            <BitPdfViewer Source="basicSource" />
        </DemoExample>

        <DemoExample Title="Height" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
            <div>
                Without a <BitTag Text="Height" Color="BitColor.Info" /> the viewer is responsive: it is capped at 780px
                and shrinks to fit the viewport on small screens. Set the parameter to any CSS length to pin it instead.
            </div>
            <br />
            <BitButton IsEnabled="heightSource is null" OnClick="() => heightSource = CreateSampleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Source="heightSource" Height="400px" />
        </DemoExample>

        <DemoExample Title="Toolbar" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
            <div>
                <BitTag Text="ShowToolbar" Color="BitColor.Info" /> hides the toolbar entirely - useful when the hosting
                page drives the viewer through its public API. To keep the toolbar but trim it,
                <BitTag Text="ToolbarItems" Color="BitColor.Info" /> is a flags enum: combine only the groups you want
                and the rest are not rendered at all.
            </div>
            <br />
            <BitButton IsEnabled="toolbarSource is null" OnClick="() => toolbarSource = CreateSampleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Source="toolbarSource" Height="400px"
                          ToolbarItems="BitPdfToolbarItems.Navigation | BitPdfToolbarItems.Zoom | BitPdfToolbarItems.Fullscreen" />
        </DemoExample>

        <DemoExample Title="Sidebars" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
            <div>
                Four side panels ship with the viewer: page thumbnails, the document's own bookmarks (its outline), its
                embedded files, and its optional-content layers. Thumbnails render lazily on their own scroll, so opening
                the panel on a 500-page document only builds the handful on screen; the bookmarks tree folds and unfolds
                and is navigable by keyboard; the attachments panel saves an embedded file when its row is activated; the
                layers panel switches a group of content on or off and repaints the pages, the way a CAD or map document
                expects.
                <BitTag Text="DefaultSidebar" Color="BitColor.Info" /> picks the one that is open when a document loads,
                and the toolbar toggles decide from there. A toggle whose panel has nothing to show - no outline, no
                attachments - stays disabled.
            </div>
            <br />
            <BitButton IsEnabled="sidebarSource is null" OnClick="() => sidebarSource = CreateArticleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Source="sidebarSource" Height="450px" DefaultSidebar="BitPdfSidebar.Thumbnails" />
        </DemoExample>

        <DemoExample Title="Zoom" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5">
            <div>
                <BitTag Text="InitialZoomMode" Color="BitColor.Info" /> sets the fit the viewer opens with; the zoom
                dropdown then offers fit-width, fit-page, actual size and the usual percentage presets. Fit modes
                re-apply themselves when the container resizes. <BitTag Text="MinZoom" Color="BitColor.Info" />,
                <BitTag Text="MaxZoom" Color="BitColor.Info" /> and <BitTag Text="ZoomStep" Color="BitColor.Info" />
                bound and pace every zoom, whether it comes from the buttons, Ctrl+wheel, a pinch or the public API.
            </div>
            <br />
            <BitButton IsEnabled="zoomSource is null" OnClick="() => zoomSource = CreateSampleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Source="zoomSource" Height="450px"
                          InitialZoomMode="BitPdfZoomMode.FitPage"
                          MinZoom="0.5" MaxZoom="3" ZoomStep="1.5" />
        </DemoExample>

        <DemoExample Title="Page layout" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
            <div>
                <BitTag Text="ScrollMode" Color="BitColor.Info" /> lays the pages out the four ways a desktop viewer
                does: stacked vertically (the default), side by side on one horizontally scrolling row, wrapped into rows
                that fill the width, or one page at a time.
                <BitTag Text="SpreadMode" Color="BitColor.Info" /> pairs them into spreads the way a printed book falls
                open - <BitTag Text="Odd" Color="BitColor.SecondaryBackground" /> pairs 1-2, 3-4, while
                <BitTag Text="Even" Color="BitColor.SecondaryBackground" /> leaves page 1 alone as a cover.
                <BitTag Text="CursorTool" Color="BitColor.Info" /> switches dragging between selecting text and panning
                the document. All three are toolbar controls too, and a choice made there survives the host re-rendering.
                Presentation mode (the toolbar's screen button, <code>Ctrl+Alt+P</code>, or
                <BitTag Text="TogglePresentationMode" Color="BitColor.Info" />) combines them: fullscreen, one page at a
                time, scaled to fit - and leaving it, however it happens, puts the previous layout back.
            </div>
            <br />
            <div style="display:flex;gap:1rem;flex-wrap:wrap">
                <BitDropdown @bind-Value="scrollMode" Label="ScrollMode" TItem="BitDropdownItem<BitPdfScrollMode>" TValue="BitPdfScrollMode" Style="min-width:12rem">
                    <BitDropdownOption Text="Vertical" Value="BitPdfScrollMode.Vertical" />
                    <BitDropdownOption Text="Horizontal" Value="BitPdfScrollMode.Horizontal" />
                    <BitDropdownOption Text="Wrapped" Value="BitPdfScrollMode.Wrapped" />
                    <BitDropdownOption Text="Page" Value="BitPdfScrollMode.Page" />
                </BitDropdown>
                <BitDropdown @bind-Value="spreadMode" Label="SpreadMode" TItem="BitDropdownItem<BitPdfSpreadMode>" TValue="BitPdfSpreadMode" Style="min-width:12rem">
                    <BitDropdownOption Text="None" Value="BitPdfSpreadMode.None" />
                    <BitDropdownOption Text="Odd" Value="BitPdfSpreadMode.Odd" />
                    <BitDropdownOption Text="Even" Value="BitPdfSpreadMode.Even" />
                </BitDropdown>
                <BitToggle @bind-Value="panTool" Label="Pan tool" />
            </div>
            <br />
            <BitButton IsEnabled="layoutSource is null" OnClick="() => layoutSource = CreateArticleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Source="layoutSource" Height="500px"
                          ScrollMode="scrollMode"
                          SpreadMode="spreadMode"
                          CursorTool="@(panTool ? BitPdfCursorTool.Pan : BitPdfCursorTool.Select)" />
        </DemoExample>

        <DemoExample Title="Find in document" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
            <div>
                Matches are counted in C# over a per-page text index, so the total covers the whole document without
                rendering any of it - stepping to a match is what brings its page in, one page at a time. The hits
                themselves are painted with the CSS Custom Highlight API, which never touches the page markup, and
                <BitTag Text="Aa" Color="BitColor.SecondaryBackground" /> and
                <BitTag Text="ab" Color="BitColor.SecondaryBackground" /> narrow the query to case-sensitive and
                whole-word matching. Typing searches as you pause; <code>Enter</code> and <code>Shift+Enter</code> step
                through the results.
            </div>
            <br />
            <BitButton IsEnabled="searchSource is null" OnClick="() => searchSource = CreateArticleSource()">Load document</BitButton>
            <BitButton IsEnabled="searchSource is not null" OnClick="() => searchViewerRef.Search(searchTerm)">Search from code</BitButton>
            <br /><br />
            <BitTextField @bind-Value="searchTerm" Label="Term" Style="max-width:16rem" />
            <br />
            <BitPdfViewer @ref="searchViewerRef" Source="searchSource" Height="450px" />
        </DemoExample>

        <DemoExample Title="Keyboard shortcuts" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
            <div>
                While focus is inside the viewer it handles the shortcuts readers already know from desktop pdf viewers.
                They are matched in the browser, so <code>Ctrl+F</code>, <code>Ctrl+P</code> and <code>Ctrl+S</code> open
                the viewer's own find box, print pass and download instead of the browser's, and a bare letter typed into
                the find or page box is never mistaken for a command. Set
                <BitTag Text="EnableKeyboardShortcuts" Color="BitColor.Info" /> to <code>false</code> to hand every key
                back to the page.
            </div>
            <br />
            <div class="pdf-shortcuts">
                <div><kbd>n</kbd> <kbd>j</kbd> <kbd>PageDown</kbd> next page</div>
                <div><kbd>p</kbd> <kbd>k</kbd> <kbd>PageUp</kbd> previous page</div>
                <div><kbd>Home</kbd> <kbd>End</kbd> first / last page</div>
                <div><kbd>Ctrl</kbd>+<kbd>+</kbd> <kbd>Ctrl</kbd>+<kbd>-</kbd> <kbd>Ctrl</kbd>+<kbd>0</kbd> zoom in / out / 100%</div>
                <div><kbd>r</kbd> <kbd>Shift</kbd>+<kbd>r</kbd> rotate clockwise / counter-clockwise</div>
                <div><kbd>Ctrl</kbd>+<kbd>F</kbd> <kbd>Ctrl</kbd>+<kbd>G</kbd> <kbd>Shift</kbd>+<kbd>Ctrl</kbd>+<kbd>G</kbd> find / next / previous</div>
                <div><kbd>Ctrl</kbd>+<kbd>P</kbd> <kbd>Ctrl</kbd>+<kbd>S</kbd> print / download</div>
                <div><kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>P</kbd> presentation mode</div>
                <div><kbd>F4</kbd> toggle the sidebar, <kbd>Esc</kbd> close the find box, the properties dialog or presentation mode</div>
            </div>
            <br />
            <BitButton IsEnabled="keyboardSource is null" OnClick="() => keyboardSource = CreateArticleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Source="keyboardSource" Height="450px" />
        </DemoExample>

        <DemoExample Title="Render mode" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
            <div>
                <BitTag Text="Html" Color="BitColor.Info" /> (the default) lays every page out as positioned DOM: it is
                fully prerenderable, stays crisp at any zoom and needs no JavaScript to paint.
                <BitTag Text="Canvas" Color="BitColor.Info" /> instead replays a display list produced by the same C#
                engine onto a per-page <code>&lt;canvas&gt;</code> - far fewer DOM nodes on graphics-heavy documents,
                re-rasterized when the zoom settles - while selection, find and links keep working through the DOM text
                layer above it.
            </div>
            <br />
            <BitChoiceGroup @bind-Value="renderMode" Horizontal Label="RenderMode" TItem="BitChoiceGroupOption<BitPdfRenderMode>" TValue="BitPdfRenderMode">
                <BitChoiceGroupOption Text="Html" Value="BitPdfRenderMode.Html" />
                <BitChoiceGroupOption Text="Canvas" Value="BitPdfRenderMode.Canvas" />
            </BitChoiceGroup>
            <br />
            <BitButton IsEnabled="canvasSource is null" OnClick="() => canvasSource = CreateSampleSource()">Load document</BitButton>
            <br /><br />
            <div>You can also select a pdf file from your computer to view it here:</div>
            <InputFile OnChange="OnCanvasFileChange" accept=".pdf,application/pdf" />
            <br /><br />
            <BitPdfViewer Source="canvasSource" Height="450px" RenderMode="renderMode" />
        </DemoExample>

        <DemoExample Title="Text coalescing" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
            <div>
                Some producers emit one show-text operator per glyph. <BitTag Text="Exact" Color="BitColor.Info" /> (the
                default) keeps each run in its own positioned span, so every glyph lands where the pdf says it does.
                <BitTag Text="Compact" Color="BitColor.Info" /> merges same-line, same-style runs into one span per
                visual line - dramatically fewer DOM nodes on those documents, at the cost of a small intra-line drift
                where explicit kerning between runs is approximated. Rotated text is never coalesced.
            </div>
            <br />
            <BitChoiceGroup @bind-Value="textCoalescing" Horizontal Label="TextCoalescing" TItem="BitChoiceGroupOption<BitPdfTextCoalescing>" TValue="BitPdfTextCoalescing">
                <BitChoiceGroupOption Text="Exact" Value="BitPdfTextCoalescing.Exact" />
                <BitChoiceGroupOption Text="Compact" Value="BitPdfTextCoalescing.Compact" />
            </BitChoiceGroup>
            <br />
            <BitButton IsEnabled="coalescingSource is null" OnClick="() => coalescingSource = CreateArticleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Source="coalescingSource" Height="450px" TextCoalescing="textCoalescing" />
        </DemoExample>

        <DemoExample Title="Document info" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
            <div>
                The toolbar's info button opens a properties dialog with the file name and size, the
                <code>/Info</code> fields, the pdf version and the current page size. The same data - and more - is on
                the component reference: <BitTag Text="Metadata" Color="BitColor.Info" />,
                <BitTag Text="Permissions" Color="BitColor.Info" />,
                <BitTag Text="PageLabels" Color="BitColor.Info" />,
                <BitTag Text="FormFields" Color="BitColor.Info" />,
                <BitTag Text="StructureTree" Color="BitColor.Info" /> and the whole parsed
                <BitTag Text="Document" Color="BitColor.Info" />, so an app can index, audit or reflow a file without
                parsing it a second time.
            </div>
            <br />
            <BitButton IsEnabled="infoSource is null" OnClick="() => infoSource = CreateArticleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer @ref="infoViewerRef" Source="infoSource" Height="400px" OnDocumentLoaded="StateHasChanged" />
            <br />
            @if (infoViewerRef?.Document is not null)
            {
                <div class="pdf-info">
                <div>Title: @(infoViewerRef.Metadata?.Title ?? "-")</div>
                <div>Producer: @(infoViewerRef.Metadata?.Producer ?? "-")</div>
                <div>Pdf version: @(infoViewerRef.PdfVersion ?? "-")</div>
                <div>Encrypted: @infoViewerRef.IsEncrypted</div>
                <div>Can print: @infoViewerRef.Permissions.CanPrint, can copy: @infoViewerRef.Permissions.CanCopy</div>
                <div>Form fields: @infoViewerRef.FormFields.Count</div>
                <div>File size: @infoViewerRef.FileSize bytes</div>
                </div>
            }
        </DemoExample>

        <DemoExample Title="Encrypted documents" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
            <div>
                An encrypted document opens with a password the viewer asks for in a dialog of its own, retrying as long
                as answers keep arriving and giving up when the reader cancels. A known password can be carried on the
                source instead with <BitTag Text="WithPassword" Color="BitColor.Info" />, and
                <BitTag Text="OnPasswordRequested" Color="BitColor.Info" /> replaces the built-in dialog with your own
                UI. Set <BitTag Text="ShowPasswordPrompt" Color="BitColor.Info" /> to <code>false</code> to skip the
                asking entirely and let the failure surface through <BitTag Text="OnError" Color="BitColor.Info" />.
                Once open, <BitTag Text="Permissions" Color="BitColor.Info" /> reports what the document's owner allows.
            </div>
            <br />
            <div>Select an encrypted pdf file from your computer to try it:</div>
            <InputFile OnChange="OnPasswordFileChange" accept=".pdf,application/pdf" />
            <br /><br />
            <BitPdfViewer Source="passwordSource" Height="400px"
                          OnError='e => passwordError = e' />
            @if (passwordError is not null)
            {
                <div>Error: @passwordError</div>
            }
        </DemoExample>

        <DemoExample Title="Events" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
            <div>
                The viewer reports every state change a host might want to mirror: the document loading, the focused
                page, the zoom factor, the rotation and the open side panel - plus
                <BitTag Text="OnProgress" Color="BitColor.Info" /> while a URL source downloads (when the server declares
                a length), <BitTag Text="OnWarnings" Color="BitColor.Info" /> for the non-fatal diagnostics of a damaged
                file (a rebuilt cross-reference table, say) and <BitTag Text="OnError" Color="BitColor.Info" /> when a
                load or a page render fails.
            </div>
            <br />
            <BitButton IsEnabled="eventsSource is null" OnClick="() => eventsSource = CreateSampleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Source="eventsSource" Height="400px"
                          OnDocumentLoaded='() => eventsLog.Add("Document loaded")'
                          OnPageChanged='p => eventsLog.Add($"Page changed: {p}")'
                          OnZoomChanged='z => eventsLog.Add($"Zoom changed: {z:P0}")'
                          OnRotationChanged='r => eventsLog.Add($"Rotation changed: {r}deg")'
                          OnSidebarChanged='s => eventsLog.Add($"Sidebar changed: {s}")'
                          OnWarnings='w => eventsLog.Add($"Warnings: {w.Count}")'
                          OnProgress='p => eventsLog.Add($"Downloading: {p:P0}")'
                          OnError='e => eventsLog.Add($"Error: {e}")' />
            <br />
            <div>Events:</div>
            <div style="max-height:8rem;overflow:auto">
                @foreach (var log in Enumerable.Reverse(eventsLog).Take(8))
                {
                    <div>@log</div>
                }
            </div>
        </DemoExample>

        <DemoExample Title="Public API" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
            <div>
                Every toolbar action is also a method, so the viewer can be driven from your own chrome with the toolbar
                hidden. <BitTag Text="BackgroundRendering" Color="BitColor.Info" /> additionally moves parsing and page
                building off the UI thread where the runtime has a spare one (Blazor Server, or a WebAssembly app built
                with <code>WasmEnableThreads</code>); on the default single-threaded WebAssembly runtime it is a safe
                no-op.
            </div>
            <br />
            <BitButton IsEnabled="publicApiSource is null" OnClick="() => publicApiSource = CreateArticleSource()">Load document</BitButton>
            <br /><br />
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center">
                <BitButton OnClick="() => pdfViewerRef.FirstPage()">First</BitButton>
                <BitButton OnClick="() => pdfViewerRef.PrevPage()">Prev</BitButton>
                <BitTag Variant="BitVariant.Outline" Text="@($"{pdfViewerRef?.CurrentPage}/{pdfViewerRef?.PageCount}")" Color="BitColor.Info" />
                <BitButton OnClick="() => pdfViewerRef.NextPage()">Next</BitButton>
                <BitButton OnClick="() => pdfViewerRef.LastPage()">Last</BitButton>
                <BitButton OnClick="() => pdfViewerRef.ZoomOut()">Zoom -</BitButton>
                <BitButton OnClick="() => pdfViewerRef.SetZoom(1)">100%</BitButton>
                <BitButton OnClick="() => pdfViewerRef.ZoomIn()">Zoom +</BitButton>
                <BitButton OnClick="() => pdfViewerRef.SetZoomMode(BitPdfZoomMode.FitPage)">Fit page</BitButton>
                <BitButton OnClick="() => pdfViewerRef.RotateCounterClockwise()">Rotate ccw</BitButton>
                <BitButton OnClick="() => pdfViewerRef.RotateClockwise()">Rotate cw</BitButton>
                <BitButton OnClick="() => pdfViewerRef.ShowSidebar(BitPdfSidebar.Thumbnails)">Thumbnails</BitButton>
                <BitButton OnClick="() => pdfViewerRef.Download()">Download</BitButton>
                <BitButton OnClick="() => pdfViewerRef.Print()">Print</BitButton>
                <BitButton OnClick="() => pdfViewerRef.TogglePresentationMode()">Present</BitButton>
                <BitButton OnClick="() => pdfViewerRef.ToggleFullscreen()">Fullscreen</BitButton>
            </div>
            <br />
            <BitPdfViewer @ref="pdfViewerRef" BackgroundRendering
                          Source="publicApiSource"
                          Height="400px"
                          ShowToolbar="false"
                          OnDocumentLoaded="StateHasChanged"
                          OnPageChanged="_ => StateHasChanged()" />
        </DemoExample>

        <DemoExample Title="Binding" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
            <div>
                <BitTag Text="CurrentPage" Color="BitColor.Info" />,
                <BitTag Text="Zoom" Color="BitColor.Info" /> and
                <BitTag Text="Rotation" Color="BitColor.Info" /> are two-way bindable: read them to follow the reader,
                assign them to drive the viewer. Bound one way - a value without its <code>Changed</code> callback - the
                value becomes the host's to control and the viewer stops moving it on its own, reporting what the reader
                did through <BitTag Text="OnPageChanged" Color="BitColor.Info" /> and friends instead.
            </div>
            <br />
            <BitButton IsEnabled="bindingSource is null" OnClick="() => bindingSource = CreateArticleSource()">Load document</BitButton>
            <br /><br />
            <div style="display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-end">
                <BitNumberField @bind-Value="boundPage" Label="CurrentPage" Min="1" Style="max-width:9rem" />
                <BitNumberField @bind-Value="boundZoom" Label="Zoom" Step="0.25" Min="0.1" Max="8" Style="max-width:9rem" />
                <BitNumberField @bind-Value="boundRotation" Label="Rotation" Step="90" Style="max-width:9rem" />
            </div>
            <br />
            <BitPdfViewer Source="bindingSource" Height="400px"
                          @bind-CurrentPage="boundPage"
                          @bind-Zoom="boundZoom"
                          @bind-Rotation="boundRotation" />
        </DemoExample>

        <DemoExample Title="Localization" RazorCode="@example16RazorCode" CsharpCode="@example16CsharpCode" Id="example16">
            <div>
                Every string the viewer renders - button labels, aria labels, the zoom dropdown, the find box, the
                status messages and the properties dialog - comes from a
                <BitTag Text="BitPdfViewerTexts" Color="BitColor.Info" /> instance. Assign
                <BitTag Text="Texts" Color="BitColor.Info" /> with only the properties you want to replace; the rest keep
                their English defaults.
            </div>
            <br />
            <BitButton IsEnabled="localizedSource is null" OnClick="() => localizedSource = CreateSampleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Dir="BitDir.Rtl" Source="localizedSource" Height="400px" Texts="persianTexts" />
        </DemoExample>

        <DemoExample Title="Style & Class" RazorCode="@example17RazorCode" CsharpCode="@example17CsharpCode" Id="example17">
            <div>
                <BitTag Text="Style" Color="BitColor.Info" /> and <BitTag Text="Class" Color="BitColor.Info" /> reach the
                root element, while <BitTag Text="Styles" Color="BitColor.Info" /> and
                <BitTag Text="Classes" Color="BitColor.Info" /> address the individual parts - the toolbar and its
                buttons, the sidebars, the surface, each page and the properties dialog.
            </div>
            <br />
            <BitButton IsEnabled="styleSource is null" OnClick="() => styleSource = CreateSampleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Source="styleSource" Height="400px"
                          Styles="@(new() { Toolbar = "background:var(--bit-clr-pri);color:var(--bit-clr-pri-text)",
                                            ToolbarButton = "color:var(--bit-clr-pri-text)",
                                            Surface = "background:#2b2b30" })" />
        </DemoExample>

        <DemoExample Title="RTL" RazorCode="@example18RazorCode" CsharpCode="@example18CsharpCode" Id="example18">
            <div>
                Set <BitTag Text="Dir" Color="BitColor.Info" /> to <BitTag Text="BitDir.Rtl" Color="BitColor.Info" /> to
                mirror the chrome - the toolbar groups, the sidebars and the find box - for right-to-left layouts. Page
                content itself keeps the orientation the document defines.
            </div>
            <br />
            <BitButton IsEnabled="rtlSource is null" OnClick="() => rtlSource = CreateSampleSource()">Load document</BitButton>
            <br /><br />
            <BitPdfViewer Dir="BitDir.Rtl" Source="rtlSource" Height="400px" />
        </DemoExample>
    </Examples>
</DemoPage>
