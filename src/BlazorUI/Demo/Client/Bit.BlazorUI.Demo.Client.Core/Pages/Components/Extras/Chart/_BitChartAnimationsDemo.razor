@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Bars" RazorCode="@barsRazorCode" CsharpCode="@barsCsharpCode" Id="animations-bars">
    <div class="example-desc">
        Entry animations are pure CSS, so they cost no JavaScript and replay whenever the data changes - the
        renderer keys the scene on the values, so resizing, zooming and panning stay still. Duration and easing
        map straight to <code>animation-duration</code> and <code>animation-timing-function</code>, and a positive
        <code>DelayBetween</code> staggers the bars so they grow out of the axis one after another.
    </div>
    <div class="controls" style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-bottom:1rem">
        <label>
            Duration
            <input type="range" min="0" max="2000" step="100" @bind="_barsDuration" @bind:event="oninput" />
            <span>@_barsDuration ms</span>
        </label>
        <label>
            Easing
            <select @bind="_barsEasing">
                <option value="ease-out">ease-out</option>
                <option value="ease-in-out">ease-in-out</option>
                <option value="cubic-bezier(.34,1.56,.64,1)">spring</option>
                <option value="linear">linear</option>
            </select>
        </label>
        <label>
            Stagger
            <input type="range" min="0" max="120" step="10" @bind="_barsStagger" @bind:event="oninput" />
            <span>@_barsStagger ms/el</span>
        </label>
        <BitButton Variant="BitVariant.Outline" OnClick="RandomizeBars">Randomize data</BitButton>
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart RespectReducedMotion="false" Type="BitChartType.Bar" Data="_barsData" Options="BarsOpts()" /></div></div>
</DemoExample>

<DemoExample Title="Line draw-on" RazorCode="@lineDrawRazorCode" CsharpCode="@lineDrawCsharpCode" Id="animations-line-draw">
    <div class="example-desc">
        With <code>Progressive</code> the stroke draws itself on from left to right and each marker pops in as the
        line reaches it, which reads like the series being gathered over time. Dashed lines fade in instead, since
        the dash pattern is already using the stroke dash array.
    </div>
    <div class="controls" style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-bottom:1rem">
        <label>
            Duration
            <input type="range" min="0" max="2000" step="100" @bind="_lineDuration" @bind:event="oninput" />
            <span>@_lineDuration ms</span>
        </label>
        <label>
            Easing
            <select @bind="_lineEasing">
                <option value="ease-out">ease-out</option>
                <option value="ease-in-out">ease-in-out</option>
                <option value="cubic-bezier(.34,1.56,.64,1)">spring</option>
                <option value="linear">linear</option>
            </select>
        </label>
        <label>
            Stagger
            <input type="range" min="0" max="120" step="10" @bind="_lineStagger" @bind:event="oninput" />
            <span>@_lineStagger ms/el</span>
        </label>
        <BitButton Variant="BitVariant.Outline" OnClick="RandomizeLine">Randomize data</BitButton>
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart RespectReducedMotion="false" Type="BitChartType.Line" Data="_lineData" Options="LineOpts()" /></div></div>
</DemoExample>
