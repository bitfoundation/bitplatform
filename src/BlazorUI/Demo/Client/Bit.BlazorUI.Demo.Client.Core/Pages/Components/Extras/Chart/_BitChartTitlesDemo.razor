@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Title and subtitle" RazorCode="@basicRazorCode" CsharpCode="@basicCsharpCode" Id="titles-basic">
    <div class="example-desc">
        <code>Plugins.Title</code> and <code>Plugins.Subtitle</code> render above the plot with their own font,
        color and alignment. The title is also the chart's accessible name when no <code>AriaLabel</code> is set.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="_titled" /></div></div>
</DemoExample>

<DemoExample Title="Placement" RazorCode="@placementRazorCode" CsharpCode="@placementCsharpCode" Id="titles-placement">
    <div class="example-desc">
        <code>Position</code> puts the title on any side (left and right run vertically), <code>Align</code> pins
        it to the start, center or end, and a newline in the text breaks it over two lines.
    </div>
    <div class="controls">
        <label>
            Position
            <select @bind="_position">
                <option value="@BitChartPosition.Top">Top</option>
                <option value="@BitChartPosition.Bottom">Bottom</option>
                <option value="@BitChartPosition.Left">Left</option>
                <option value="@BitChartPosition.Right">Right</option>
            </select>
        </label>
        <label>
            Align
            <select @bind="_align">
                <option value="@BitChartAlign.Start">Start</option>
                <option value="@BitChartAlign.Center">Center</option>
                <option value="@BitChartAlign.End">End</option>
            </select>
        </label>
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="BitChartSampleData.MonthlySales()" Options="Placement()" /></div></div>
</DemoExample>

<DemoExample Title="Axis titles" RazorCode="@axisRazorCode" CsharpCode="@axisCsharpCode" Id="titles-axis">
    <div class="example-desc">
        Each scale's <code>Title</code> is drawn along its axis, with room reserved so it never overlaps the tick
        labels.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="BitChartSampleData.MonthlySales()" Options="_axisTitles" /></div></div>
</DemoExample>
