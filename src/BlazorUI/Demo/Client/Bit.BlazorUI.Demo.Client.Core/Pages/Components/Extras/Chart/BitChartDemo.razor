                </BitPivotItem>
                <BitPivotItem HeaderText="Tooltips" Key="tooltips">
                    <_BitChartTooltipsDemo />
                </BitPivotItem>
                <BitPivotItem HeaderText="Interaction" Key="interaction">
                    <_BitChartInteractionDemo />
                </BitPivotItem>
                <BitPivotItem HeaderText="Data labels" Key="datalabels">
