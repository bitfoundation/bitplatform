@page "/components/errorboundary"

<PageOutlet Url="components/errorboundary"
            Title="ErrorBoundary"
            Description="BitErrorBoundary catches the exceptions thrown inside it and renders a recoverable error UI in their place." />

<DemoPage Name="ErrorBoundary"
          Description="BitErrorBoundary catches what the components inside it throw and renders a themed, accessible and recoverable error UI in their place, so one failure does not take the whole app down. It builds on Blazor's ErrorBoundary with a complete default UI, templates for every part, logging, callbacks, automatic recovery and a way in for the exceptions the renderer never sees."
          Parameters="componentParameters"
          SubEnums="componentSubEnums"
          SubClasses="componentSubClasses"
          PublicMembers="componentPublicMembers"
          CssVariables="componentCssVariables"
          GitHubExtrasUrl="ErrorBoundary/BitErrorBoundary.razor"
          GitHubDemoUrl="Extras/ErrorBoundary/BitErrorBoundaryDemo.razor">
    <NotesTemplate>
        <BitText>
            To use this component, you need to install the
            <BitLink Href="https://www.nuget.org/packages/Bit.BlazorUI.Extras" Target="_blank">
                <BitTag Reversed
                        Text="Bit.BlazorUI.Extras"
                        Color="BitColor.SecondaryBackground"
                        IconName="@BitIconName.NavigateExternalInline" />
            </BitLink>
            nuget package, as described in the Optional steps of the
            <BitLink Href="/getting-started">Getting started</BitLink> page.
        </BitText>
        <br />
        <BitText>
            A boundary catches what its content throws while rendering, in a lifecycle method or in an event handler -
            not what never reaches the renderer (a fire-and-forget task, a timer, a JS callback), which is what
            <b>Capture</b> is for. Scope boundaries narrowly: the closer one sits to what failed, the more of the page survives.
        </BitText>
    </NotesTemplate>
    <Examples>
        <DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
            <div>
                Wrap anything that can fail. Until something throws, the boundary renders its content and nothing of its
                own; then the default error UI takes the content's place.
            </div>
            <br />
            <BitErrorBoundary>
                <BitButton OnClick="ThrowException">Throw an exception</BitButton>
            </BitErrorBoundary>
        </DemoExample>

        <DemoExample Title="Title & message" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
            <div>
                <b>Title</b> replaces the heading (an empty one drops it) and <b>Message</b> tells the reader what to do next.
            </div>
            <br />
            <BitErrorBoundary Title="This report could not be built"
                              Message="The numbers behind it are still being imported. Try again in a minute, or head back to the dashboard.">
                <BitButton OnClick="ThrowException">Throw an exception</BitButton>
            </BitErrorBoundary>
        </DemoExample>

        <DemoExample Title="Icon" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
            <div>
                <b>IconName</b> swaps the illustration for a Fluent glyph, <b>IconTemplate</b> for your own markup, and
                <b>HideIcon</b> drops it - which suits a boundary around a small region.
            </div>
            <br />
            <div class="example-content">
                <BitErrorBoundary IconName="@BitIconName.ErrorBadge" Title="Something went wrong">
                    <BitButton OnClick="ThrowException">Throw (IconName)</BitButton>
                </BitErrorBoundary>
                <BitErrorBoundary Title="Something went wrong">
                    <ChildContent>
                        <BitButton OnClick="ThrowException">Throw (IconTemplate)</BitButton>
                    </ChildContent>
                    <IconTemplate>
                        <BitText Typography="BitTypography.H2" aria-hidden="true">🛠️</BitText>
                    </IconTemplate>
                </BitErrorBoundary>
                <BitErrorBoundary HideIcon Title="Something went wrong">
                    <BitButton OnClick="ThrowException">Throw (HideIcon)</BitButton>
                </BitErrorBoundary>
            </div>
        </DemoExample>

        <DemoExample Title="Exception details" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
            <div>
                <b>ShowException</b> renders the full exception in a scrolling block, and <b>ShowCopyButton</b> copies it
                for a bug report. Both expose internals, so keep them behind an environment check in production.
            </div>
            <br />
            <BitErrorBoundary ShowException ShowCopyButton>
                <BitButton OnClick="ThrowException">Throw an exception</BitButton>
            </BitErrorBoundary>
        </DemoExample>

        <DemoExample Title="Actions" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5">
            <div>
                <b>Refresh</b> reloads the page, <b>Home</b> goes to <b>HomeUrl</b> and <b>Recover</b> renders the content
                again. Each has its own text and <b>Hide...Button</b> parameter; <b>AdditionalButtons</b> appends to the
                row, while <b>Footer</b> replaces it.
            </div>
            <br />
            <div class="example-content">
                <BitErrorBoundary HideRefreshButton
                                  HomeUrl="/components/errorboundary"
                                  HomeText="Back to the docs"
                                  RecoverText="Try again">
                    <ChildContent>
                        <BitButton OnClick="ThrowException">Throw (AdditionalButtons)</BitButton>
                    </ChildContent>
                    <AdditionalButtons>
                        <BitButton Variant="BitVariant.Text" OnClick="() => reportedCount++">
                            Report (@reportedCount)
                        </BitButton>
                    </AdditionalButtons>
                </BitErrorBoundary>
                <BitErrorBoundary @ref="footerBoundary" Title="The upload failed">
                    <ChildContent>
                        <BitButton OnClick="ThrowException">Throw (Footer)</BitButton>
                    </ChildContent>
                    <Footer>
                        <BitButton Size="BitSize.Small" OnClick="() => footerBoundary?.Recover()">Try again</BitButton>
                        <BitButton Size="BitSize.Small" Variant="BitVariant.Text" OnClick="() => reportedCount++">
                            Report (@reportedCount)
                        </BitButton>
                    </Footer>
                </BitErrorBoundary>
            </div>
        </DemoExample>

        <DemoExample Title="Error template" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
            <div>
                <b>ErrorTemplate</b> replaces the whole error UI and receives a <BitLink Href="#context">BitErrorBoundaryContext</BitLink>:
                the exception plus the <b>Recover</b>, <b>Refresh</b> and <b>GoHome</b> actions. It wins over the inherited
                <b>ErrorContent</b>.
            </div>
            <br />
            <BitErrorBoundary>
                <ChildContent>
                    <BitButton OnClick="ThrowException">Throw an exception</BitButton>
                </ChildContent>
                <ErrorTemplate Context="error">
                    <BitMessage Color="BitColor.Error" Multiline>
                        <b>@error.Exception.Message</b>
                        <br />
                        <BitButton Size="BitSize.Small" Variant="BitVariant.Text" OnClick="error.Recover">Try again</BitButton>
                    </BitMessage>
                </ErrorTemplate>
            </BitErrorBoundary>
        </DemoExample>

        <DemoExample Title="Events" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
            <div>
                <b>OnError</b> runs before the error UI renders - report the exception there. <b>OnRecover</b> runs on every
                way out and says which one through <BitLink Href="#recover-reason-enum">BitErrorBoundaryRecoverReason</BitLink>.
                The boundary also logs through <b>IErrorBoundaryLogger</b> unless <b>NoLogging</b> is set.
            </div>
            <br />
            <BitErrorBoundary OnError="HandleError" OnRecover="HandleRecover">
                <BitButton OnClick="ThrowException">Throw an exception</BitButton>
            </BitErrorBoundary>
            <br />
            <div>
                Caught: @errorCount &nbsp;|&nbsp; Recovered: @recoverCount &nbsp;|&nbsp;
                Last error: @(lastError ?? "-") &nbsp;|&nbsp; Last recovery: @(lastRecoverReason?.ToString() ?? "-")
            </div>
        </DemoExample>

        <DemoExample Title="Capture" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" CodeFiles="@example8CodeFiles" Id="example8">
            <div>
                What is thrown where nothing awaits it - a fire-and-forget task, a timer, a JS callback - never reaches a
                boundary. <b>Capture</b> hands it over, through <b>@@ref</b> or through the boundary cascaded to its
                content; use <b>CaptureAsync</b> off the renderer's thread.
            </div>
            <br />
            <BitErrorBoundary @ref="captureBoundary" ShowException>
                <BitButton OnClick="CaptureFromReference">Capture through @@ref</BitButton>
                <_BitErrorBoundaryCaptureDemo />
            </BitErrorBoundary>
        </DemoExample>

        <DemoExample Title="Automatic recovery" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
            <div>
                <b>RecoverKeys</b> recovers the moment one of its values changes, such as the selected record.
                <b>RecoverOnNavigation</b> recovers on the next location change, which a boundary around a layout's body needs.
            </div>
            <br />
            <div class="example-content">
                <div class="example-box">
                    <BitErrorBoundary RecoverKeys="@(new object?[] { selectedRecord })"
                                      HideRefreshButton HideHomeButton HideRecoverButton
                                      Title="@($"Record {selectedRecord} could not be shown")"
                                      Message="Pick another one and this clears itself.">
                        <BitButton OnClick="ThrowException">Throw (RecoverKeys)</BitButton>
                    </BitErrorBoundary>
                    <div class="example-content">
                        <BitButton Variant="BitVariant.Outline" OnClick="() => selectedRecord = 1">Record 1</BitButton>
                        <BitButton Variant="BitVariant.Outline" OnClick="() => selectedRecord = 2">Record 2</BitButton>
                        <BitButton Variant="BitVariant.Outline" OnClick="() => selectedRecord = 3">Record 3</BitButton>
                    </div>
                </div>
                <div class="example-box">
                    <BitErrorBoundary RecoverOnNavigation
                                      HideRefreshButton HideHomeButton HideRecoverButton
                                      Title="Something went wrong"
                                      Message="Navigate anywhere and this clears itself.">
                        <BitButton OnClick="ThrowException">Throw (RecoverOnNavigation)</BitButton>
                    </BitErrorBoundary>
                    <div class="example-content">
                        <BitButton Variant="BitVariant.Outline" OnClick="NavigateInPlace">Navigate</BitButton>
                    </div>
                </div>
            </div>
        </DemoExample>

        <DemoExample Title="Accessibility" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
            <div>
                The icon, title and message are an <b>alert</b>, announced as they appear, inside a group named by the title
                and described by the message. <b>AutoFocus</b> moves the focus to that group, which announces it instead.
                A <b>role</b> or <b>aria-live</b> of the page's own on the boundary makes it the live region in place of the alert.
                <b>HeadingLevel</b> fits the title into the page outline and <b>ExceptionLabel</b> names the focusable
                exception block.
            </div>
            <br />
            <BitErrorBoundary AutoFocus
                              ShowException
                              HeadingLevel="2"
                              ExceptionLabel="Server response"
                              Title="This page could not be shown"
                              Message="The focus moves here, so the keyboard is already next to the way out.">
                <BitButton OnClick="ThrowException">Throw an exception</BitButton>
            </BitErrorBoundary>
        </DemoExample>

        <DemoExample Title="Cascading parameters" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
            <div>
                <b>BitParams</b> carries a <b>BitErrorBoundaryParams</b> to every boundary
                under it - wrap a layout's body to set the texts, buttons and look of all of them once. These are defaults:
                a parameter a boundary sets itself wins.
            </div>
            <br />
            <div class="example-content">
                <BitParams Parameters="@errorBoundaryParams">
                    <BitErrorBoundary>
                        <BitButton OnClick="ThrowException">Throw (cascaded)</BitButton>
                    </BitErrorBoundary>
                    <BitErrorBoundary Title="Its own title, the cascaded rest">
                        <BitButton OnClick="ThrowException">Throw (own Title)</BitButton>
                    </BitErrorBoundary>
                </BitParams>
            </div>
        </DemoExample>

        <DemoExample Title="External Icons" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
            <div>
                <b>Icon</b> takes a <b>BitIconInfo</b> for external icon libraries: use the <b>Fa</b>, <b>Bi</b> and
                <b>Css</b> helpers, or pass the classes as a plain string.
            </div>
            <br />
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
            <div class="example-content">
                <BitErrorBoundary Icon="@BitIconInfo.Fa("solid triangle-exclamation")" Title="FontAwesome">
                    <BitButton OnClick="ThrowException">Throw an exception</BitButton>
                </BitErrorBoundary>
                <BitErrorBoundary Icon="@BitIconInfo.Bi("exclamation-octagon-fill")" Title="Bootstrap Icons">
                    <BitButton OnClick="ThrowException">Throw an exception</BitButton>
                </BitErrorBoundary>
            </div>
        </DemoExample>

        <DemoExample Title="Style & Class" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" CodeFiles="@example13CodeFiles" Id="example13">
            <div>
                <b>Style</b> and <b>Class</b> land on the root of the error UI; <b>Styles</b> and <b>Classes</b> reach each
                part by name. The <BitLink Href="#css-variables-section">CSS variables</BitLink> inherit, so one set on
                <code>:root</code> or an ancestor restyles every boundary below it.
            </div>
            <br />
            <div class="example-content">
                <BitErrorBoundary Title="Styles"
                                  Message="Every part reached by name."
                                  Styles="@(new() { Root = "background: linear-gradient(180deg, #7c1d1d, transparent) #240a0a; border-radius: 0.5rem",
                                                    Title = "color: #ffd9d9",
                                                    Message = "color: #ffb4b4",
                                                    RecoverButton = new() { Root = "border-radius: 1rem" } })">
                    <BitButton OnClick="ThrowException">Throw (Styles)</BitButton>
                </BitErrorBoundary>
                <BitErrorBoundary Title="Classes"
                                  Message="Every part reached by name."
                                  Classes="@(new() { Root = "custom-erb", Title = "custom-erb-ttl", RecoverButton = new() { Root = "custom-erb-btn" } })">
                    <BitButton OnClick="ThrowException">Throw (Classes)</BitButton>
                </BitErrorBoundary>
                <BitErrorBoundary Title="CSS variables"
                                  Message="Aligned to the start, boxed and tinted."
                                  HideRefreshButton HideHomeButton
                                  Style="--bit-ErrorBoundary-align: start; --bit-ErrorBoundary-icon-size: 2.5rem; --bit-ErrorBoundary-radius: 0.5rem; --bit-ErrorBoundary-border: 1px solid var(--bit-clr-err); --bit-ErrorBoundary-background: var(--bit-clr-err-tint);">
                    <BitButton OnClick="ThrowException">Throw (CSS variables)</BitButton>
                </BitErrorBoundary>
            </div>
        </DemoExample>

        <DemoExample Title="RTL" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
            <div>Use BitErrorBoundary in right-to-left (RTL).</div>
            <br />
            <div dir="rtl">
                <BitErrorBoundary Dir="BitDir.Rtl"
                                  Title="اوه، مشکلی پیش آمد..."
                                  Message="لطفاً دوباره تلاش کنید یا به صفحه اصلی بازگردید."
                                  HomeText="خانه"
                                  RefreshText="بارگذاری مجدد"
                                  RecoverText="تلاش دوباره"
                                  HomeUrl="/components/errorboundary">
                    <BitButton OnClick="ThrowException">ایجاد خطا</BitButton>
                </BitErrorBoundary>
            </div>
        </DemoExample>
    </Examples>
</DemoPage>
