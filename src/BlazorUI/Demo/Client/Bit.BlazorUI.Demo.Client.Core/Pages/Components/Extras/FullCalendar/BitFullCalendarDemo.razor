@page "/components/fullcalendar"

<PageOutlet Url="components/fullcalendar"
            Title="FullCalendar"
            Description="BitFullCalendar is a full-featured scheduling calendar with day, week, month, year, agenda, and resource timeline views, recurring and all-day events, business hours, event editing, drag-and-drop, and resizing." />

<DemoPage Name="FullCalendar"
          Description="BitFullCalendar is a full-featured scheduling calendar: day, week, month, year, agenda and resource timeline views; recurring and all-day events; built-in create, edit and delete; drag-and-drop, resizing and range selection; business hours and booking rules; templates, keyboard navigation, theming, and culture-aware, right-to-left-ready rendering."
          SecondaryNames="@(["Scheduler", "EventCalendar", "Planner"])"
          Parameters="componentParameters"
          CssVariables="componentCssVariables"
          PublicMembers="componentPublicMembers"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          GitHubExtrasUrl="FullCalendar/BitFullCalendar.razor"
          GitHubDemoUrl="Extras/FullCalendar/BitFullCalendarDemo.razor">
    <NotesTemplate>
        <BitText>
            Ships in the
            <BitLink Href="https://www.nuget.org/packages/Bit.BlazorUI.Extras" Target="_blank">
                <BitTag Reversed
                        Text="Bit.BlazorUI.Extras"
                        Color="BitColor.SecondaryBackground"
                        IconName="@BitIconName.NavigateExternalInline" />
            </BitLink>
            nuget package (see the Optional steps of <BitLink Href="/getting-started">Getting started</BitLink>).
        </BitText>
    </NotesTemplate>
    <IntroductionTemplate>
        <BitText>
            A complete scheduler: six layouts (day, week, month, year, agenda and a resource timeline), built-in
            create/edit/delete dialogs, drag-and-drop, resizing and range selection, recurring and all-day events,
            business hours and booking rules. It follows the Bit theme in light and dark mode, and every date grid
            is a single tab stop the arrow keys walk.
        </BitText>
    </IntroductionTemplate>
    <Examples>
        <DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
            <div>
                Pass <b>Events</b>. The month view opens first, the toolbar navigates and switches views, and a click on a
                day or an event opens the built-in add and details dialogs.
            </div>
            <br />
            <BitFullCalendar Events="basicEvents" />
        </DemoExample>

        <DemoExample Title="Views" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
            <div>
                <b>Views</b> sets which views are offered and in which order. Excluded views are unreachable, and a single
                view hides the tab strip.
            </div>
            <br />
            <BitChoiceGroup Horizontal
                            Label="Available views"
                            TItem="BitChoiceGroupOption<string>"
                            TValue="string"
                            @bind-Value="viewsPreset">
                <BitChoiceGroupOption Text="Week and Day" Value="@("week-day")" />
                <BitChoiceGroupOption Text="Month and Agenda" Value="@("month-agenda")" />
                <BitChoiceGroupOption Text="Month only" Value="@("month")" />
            </BitChoiceGroup>
            <br />
            <BitFullCalendar Events="viewsEvents" Views="SelectedViews" />
        </DemoExample>

        <DemoExample Title="Settings" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
            <div>
                <b>Settings</b> holds the preferences: time format, badge style, the hour the grid scrolls to, how
                overlapping events are laid out (<b>EventLayout</b>), and more. What the user changes from the settings
                gear is written back onto the same instance, so a re-render never reverts it, and <b>OnSettingsChange</b>
                reports it so whatever else reads that instance can re-render too.
            </div>
            <br />
            <BitChoiceGroup Horizontal
                            Label="Event layout"
                            TItem="BitChoiceGroupOption<BitFullCalendarEventLayout>"
                            TValue="BitFullCalendarEventLayout"
                            @bind-Value="layoutMode">
                <BitChoiceGroupOption Text="Overlap" Value="BitFullCalendarEventLayout.Overlap" />
                <BitChoiceGroupOption Text="Stack" Value="BitFullCalendarEventLayout.Stack" />
            </BitChoiceGroup>
            <br />
            <BitFullCalendar Events="settingsEvents"
                             Settings="settings"
                             DefaultView="BitFullCalendarView.Week"
                             OnSettingsChange="HandleSettingsChange" />
        </DemoExample>

        <DemoExample Title="Time grid" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
            <div>
                <b>VisibleStartHour</b>/<b>VisibleEndHour</b> narrow the day, week and timeline grids, and
                <b>SlotDurationMinutes</b> sets how each hour is split and what drags snap to. Press and drag down a column to
                create an event spanning a range (<b>AllowRangeSelection</b>).
            </div>
            <br />
            <div class="example-row">
                <BitChoiceGroup Horizontal
                                Label="Visible hours"
                                TItem="BitChoiceGroupOption<string>"
                                TValue="string"
                                @bind-Value="gridHoursPreset">
                    <BitChoiceGroupOption Text="Whole day" Value="@("full")" />
                    <BitChoiceGroupOption Text="08 - 18" Value="@("office")" />
                    <BitChoiceGroupOption Text="06 - 22" Value="@("extended")" />
                </BitChoiceGroup>
                <BitChoiceGroup Horizontal
                                Label="Slot duration"
                                TItem="BitChoiceGroupOption<int>"
                                TValue="int"
                                @bind-Value="gridSlotMinutes">
                    <BitChoiceGroupOption Text="15 min" Value="15" />
                    <BitChoiceGroupOption Text="30 min" Value="30" />
                    <BitChoiceGroupOption Text="60 min" Value="60" />
                </BitChoiceGroup>
            </div>
            <br />
            <BitFullCalendar Events="gridEvents" Settings="gridSettings" DefaultView="BitFullCalendarView.Week" />
        </DemoExample>

        <DemoExample Title="Work week" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5">
            <div>
                <b>HiddenDays</b> removes weekdays from every date grid, <b>FirstDayOfWeek</b> overrides the culture's first
                day, and <b>ShowWeekNumbers</b> adds ISO-8601 week numbers.
            </div>
            <br />
            <div class="example-row">
                <BitChoiceGroup Horizontal
                                Label="Days"
                                TItem="BitChoiceGroupOption<string>"
                                TValue="string"
                                @bind-Value="workWeekPreset">
                    <BitChoiceGroupOption Text="Full week" Value="@("full")" />
                    <BitChoiceGroupOption Text="Mon - Fri" Value="@("mon-fri")" />
                    <BitChoiceGroupOption Text="Sun - Thu" Value="@("sun-thu")" />
                </BitChoiceGroup>
                <BitToggle @bind-Value="workWeekNumbers" Text="Week numbers" />
            </div>
            <br />
            <BitFullCalendar Events="workWeekEvents" Settings="workWeekSettings" DefaultView="BitFullCalendarView.Week" />
        </DemoExample>

        <DemoExample Title="Month grid" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
            <div>
                <b>FixedWeekCount</b> always draws six rows, <b>ShowNonCurrentDates</b> blanks the days borrowed from the
                neighbouring months, <b>MaxEventsPerDayCell</b> sets when the "+N more" link appears, and <b>NavLinks</b>
                turns day numbers, week headers and week numbers into links to that day or week.
            </div>
            <br />
            <div class="example-row">
                <BitToggle @bind-Value="fixedWeeks" Text="Fixed six weeks" />
                <BitToggle @bind-Value="showOtherMonthDays" Text="Show neighbouring days" />
                <BitToggle @bind-Value="navLinks" Text="Navigation links" />
            </div>
            <br />
            <BitFullCalendar Events="monthGridEvents" Settings="monthGridSettings" />
        </DemoExample>

        <DemoExample Title="All-day events" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
            <div>
                <b>IsAllDay</b> takes an event off the hour axis into the all-day row above the day and week grids; its badge
                and details show the dates instead of a time.
            </div>
            <br />
            <BitFullCalendar Events="allDayEvents" DefaultView="BitFullCalendarView.Week" />
        </DemoExample>

        <DemoExample Title="Recurring events" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
            <div>
                A <b>Recurrence</b> repeats an event daily, weekly (on <b>DaysOfWeek</b>), monthly or yearly, every
                <b>Interval</b> units, ending after a <b>Count</b>, on an <b>Until</b> date, or never. <b>WeekOfMonth</b>
                lands it on "the third Tuesday"; <b>ExceptionDates</b> and <b>AdditionalDates</b> skip or add single dates.
                Only the visible range is expanded. The dialogs edit the rule too, and ask whether an edit means this
                occurrence or the whole series.
            </div>
            <br />
            <BitFullCalendar Events="recurringEvents" />
        </DemoExample>

        <DemoExample Title="Event colors" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
            <div>
                <b>EventColorOptions</b> is the palette the dialogs, the color filter and the agenda's grouping offer; an event
                joins one through its <b>Color</b> id. A <b>Color</b> no option matches can be a CSS color of its own
                (<code>#db2777</code>, <code>oklch(...)</code>); anything else takes <b>--bit-FullCalendar-event-color</b>.
            </div>
            <br />
            <div style="--bit-FullCalendar-event-color:#64748b">
                <BitFullCalendar Events="colorEvents" EventColorOptions="colorOptions" />
            </div>
        </DemoExample>

        <DemoExample Title="Templates" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
            <div>
                <b>DayEventTemplate</b>, <b>WeekEventTemplate</b>, <b>MonthEventTemplate</b> and <b>TimelineEventTemplate</b>
                replace an event's content per layout; the calendar keeps its placement, color, accessible name and
                drag/resize. <b>MonthCellTemplate</b> adds to a month day (the holidays here) and <b>AgendaEventTemplate</b>
                replaces an agenda row (open the Agenda view).
            </div>
            <br />
            <BitFullCalendar Events="templateEvents"
                             DayEventTemplate="EventCard"
                             WeekEventTemplate="EventCard"
                             MonthEventTemplate="MonthBadge"
                             MonthCellTemplate="HolidayCell"
                             AgendaEventTemplate="AgendaRow" />
        </DemoExample>

        <DemoExample Title="Resource timeline" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
            <div>
                <b>Resources</b> enables Timeline mode: rows are resources, columns are time. Events join a row through their
                <b>Resource</b> id, unmatched ones fall into "Unassigned", and dragging a block between rows reassigns it.
                <b>ResourceTemplate</b> replaces a row's header; <b>TimelineEventTemplate</b> its events.
            </div>
            <br />
            <BitFullCalendar Events="resourceEvents"
                             Resources="resources"
                             ResourceTemplate="ResourceHeader"
                             DefaultMode="BitFullCalendarMode.Timeline" />
        </DemoExample>

        <DemoExample Title="Date bounds" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
            <div>
                <b>MinDate</b> and <b>MaxDate</b> fence in the reachable dates: prev/next disable at the edges, days outside
                are dimmed and inert, and a drag or save that would land outside is refused.
            </div>
            <br />
            <BitFullCalendar Events="boundsEvents" MinDate="boundsMin" MaxDate="boundsMax" />
            <br />
            <BitText>Allowed range: <b>@boundsMin.ToString("yyyy-MM-dd")</b> to <b>@boundsMax.ToString("yyyy-MM-dd")</b></BitText>
        </DemoExample>

        <DemoExample Title="Booking rules" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
            <div>
                <b>AllowEventOverlap</b> off prevents double booking; <b>BusinessDays</b>/<b>BusinessStartHour</b>/<b>BusinessEndHour</b>
                describe the working week, <b>HighlightBusinessHours</b> shades the rest and <b>RestrictToBusinessHours</b>
                enforces it. A single event can be frozen with <b>IsReadOnly</b> (the "Payroll run" below). A refused drag,
                resize or save shows a notice and raises <b>OnRefused</b>.
            </div>
            <br />
            <div class="example-row">
                <BitToggle @bind-Value="allowOverlap" Text="Allow overlapping events" />
                <BitToggle @bind-Value="highlightBusiness" Text="Highlight business hours" />
                <BitToggle @bind-Value="restrictBusiness" Text="Restrict to business hours" />
            </div>
            <br />
            <BitFullCalendar Events="rulesEvents" Settings="rulesSettings" OnRefused="HandleRefused" DefaultView="BitFullCalendarView.Week" />
            <br />
            <BitText>Last refusal: <b>@(lastRefusal ?? "-")</b></BitText>
        </DemoExample>

        <DemoExample Title="Read-only" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14">
            <div>
                <b>ReadOnly</b> removes the add affordances, dragging, resizing and the edit/delete actions; navigation,
                filtering and reading details keep working. <b>IsEnabled="false"</b> takes the same path.
            </div>
            <br />
            <BitToggle @bind-Value="isReadOnly" Text="Read-only" />
            <br />
            <BitFullCalendar Events="readOnlyEvents" ReadOnly="isReadOnly" />
        </DemoExample>

        <DemoExample Title="OnChange & OnChanging" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15">
            <div>
                <b>OnChange</b> reports every add, edit and delete with the new and previous snapshots, the <b>Kind</b> and
                the <b>Source</b> (dialog, drag or resize) - apply it to your own store so it survives the next render.
                <b>OnChanging</b> comes first and can <b>Cancel</b> a change for rules only your app knows: the event goes
                back and the dialog stays open. Here, nothing may start in the past.
            </div>
            <br />
            <BitToggle @bind-Value="refusePast" Text="Refuse changes that start in the past" />
            <br />
            <BitFullCalendar Events="changeEvents" OnChanging="HandleChanging" OnChange="HandleChange" />
            <br />
            <BitText>Last change: <b>@(lastChange ?? "-")</b></BitText>
        </DemoExample>

        <DemoExample Title="Binding" RazorCode="@example16RazorCode" CsharpCode="@example16CsharpCode" Id="example16">
            <div>
                <b>View</b>, <b>Mode</b> and <b>Date</b> are two-way bound; <b>OnViewChange</b>, <b>OnModeChange</b> and
                <b>OnDateChange</b> report user-driven changes. <b>DefaultView</b>, <b>DefaultMode</b> and <b>DefaultDate</b>
                set the start without taking control.
            </div>
            <br />
            <div class="example-row">
                <BitChoiceGroup Horizontal
                                Label="View"
                                TItem="BitChoiceGroupOption<BitFullCalendarView>"
                                TValue="BitFullCalendarView"
                                @bind-Value="bindingView">
                    <BitChoiceGroupOption Text="Day" Value="BitFullCalendarView.Day" />
                    <BitChoiceGroupOption Text="Week" Value="BitFullCalendarView.Week" />
                    <BitChoiceGroupOption Text="Month" Value="BitFullCalendarView.Month" />
                    <BitChoiceGroupOption Text="Year" Value="BitFullCalendarView.Year" IsEnabled="@(bindingMode == BitFullCalendarMode.Event)" />
                    <BitChoiceGroupOption Text="Agenda" Value="BitFullCalendarView.Agenda" IsEnabled="@(bindingMode == BitFullCalendarMode.Event)" />
                </BitChoiceGroup>
                <BitChoiceGroup Horizontal
                                Label="Mode"
                                TItem="BitChoiceGroupOption<BitFullCalendarMode>"
                                TValue="BitFullCalendarMode"
                                @bind-Value="bindingMode">
                    <BitChoiceGroupOption Text="Event" Value="BitFullCalendarMode.Event" />
                    <BitChoiceGroupOption Text="Timeline" Value="BitFullCalendarMode.Timeline" />
                </BitChoiceGroup>
                <div class="example-buttons">
                    <BitButton Variant="BitVariant.Outline" OnClick="() => bindingDate = bindingDate.AddDays(-1)">Prev day</BitButton>
                    <BitButton Variant="BitVariant.Outline" OnClick="() => bindingDate = DateTime.Today">Today</BitButton>
                    <BitButton Variant="BitVariant.Outline" OnClick="() => bindingDate = bindingDate.AddDays(1)">Next day</BitButton>
                </div>
            </div>
            <br />
            <BitFullCalendar Events="bindingEvents"
                             Resources="resources"
                             @bind-View="bindingView"
                             @bind-Mode="bindingMode"
                             @bind-Date="bindingDate"
                             OnViewChange="HandleViewChange"
                             OnModeChange="HandleModeChange"
                             OnDateChange="HandleDateChange" />
            <br />
            <BitText>View: <b>@bindingView</b> | Mode: <b>@bindingMode</b> | Date: <b>@bindingDate.ToString("yyyy-MM-dd")</b></BitText>
            <BitText>Last calendar event: <b>@(bindingLog ?? "-")</b></BitText>
        </DemoExample>

        <DemoExample Title="Loading" RazorCode="@example17RazorCode" CsharpCode="@example17CsharpCode" Id="example17">
            <div>
                <b>OnDateChange</b> fires on the first render and whenever the visible range moves - fetch that range there,
                and set <b>IsLoading</b> meanwhile: a progress bar runs across the top and the body is marked busy for screen
                readers, without blocking the calendar.
            </div>
            <br />
            <BitFullCalendar Events="loadedEvents" IsLoading="isLoading" OnDateChange="LoadRange" />
            <br />
            <BitText>Loaded: <b>@(loadedRange ?? "-")</b></BitText>
        </DemoExample>

        <DemoExample Title="Custom toolbar" RazorCode="@example18RazorCode" CsharpCode="@example18CsharpCode" Id="example18">
            <div>
                <b>HideFilters</b>, <b>HideSettings</b> and <b>HideHeader</b> trim the toolbar. Drive the calendar from your own
                chrome with <b>GoToDate</b>, <b>GoToToday</b>, <b>NavigateNext</b>, <b>NavigatePrevious</b>, <b>ChangeView</b>
                and <b>ChangeMode</b>, which obey the same date window and view set as the toolbar; <b>GetVisibleRange</b>
                reads what is on screen.
            </div>
            <br />
            <BitToggle @bind-Value="hideHeader" Text="Hide the whole toolbar" />
            <div class="example-buttons">
                <BitButton Variant="BitVariant.Outline" OnClick="() => toolbarCalendar?.NavigatePrevious()">Previous</BitButton>
                <BitButton Variant="BitVariant.Outline" OnClick="() => toolbarCalendar?.GoToToday()">Today</BitButton>
                <BitButton Variant="BitVariant.Outline" OnClick="() => toolbarCalendar?.NavigateNext()">Next</BitButton>
                <BitButton Variant="BitVariant.Outline" OnClick="() => toolbarCalendar?.ChangeView(BitFullCalendarView.Day)">Day view</BitButton>
                <BitButton Variant="BitVariant.Outline" OnClick="() => toolbarCalendar?.ChangeView(BitFullCalendarView.Month)">Month view</BitButton>
                <BitButton Variant="BitVariant.Outline" OnClick="ShowVisibleRange">Read visible range</BitButton>
            </div>
            <br />
            <BitFullCalendar @ref="toolbarCalendar" Events="toolbarEvents" HideFilters HideSettings HideHeader="hideHeader" />
            <br />
            <BitText>Visible range: <b>@(visibleRange ?? "-")</b></BitText>
        </DemoExample>

        <DemoExample Title="Localization" RazorCode="@example19RazorCode" CsharpCode="@example19CsharpCode" Id="example19">
            <div>
                <b>CultureName</b> (or <b>Culture</b>) decides the calendar system, the names, the first day of the week and
                the direction - a right-to-left culture flips the layout on its own. <b>Texts</b> translates every string,
                including the accessible names. Here: Persian (<code>fa-IR</code>).
            </div>
            <br />
            <BitFullCalendar Events="localizationEvents" CultureName="fa-IR" Texts="persianTexts" />
        </DemoExample>

        <DemoExample Title="Accessibility" RazorCode="@example20RazorCode" CsharpCode="@example20CsharpCode" Id="example20">
            <div>
                <b>AriaLabel</b> names the calendar and makes it a page region. Tab reaches each grid once - a multi-day event
                once per week row - and the arrow keys walk it, on into the next month (Home/End; PageUp/PageDown turn the
                month, Shift the year). Enter or Space on a day or slot adds an event; Alt+Arrow moves and Shift+Arrow resizes
                a focused event. Escape closes any dialog, and the focus returns to the event even when a keyboard edit or a
                save redrew it. Dialog errors are tied to their fields; refusals, ranges and search results are announced.
            </div>
            <br />
            <BitFullCalendar Events="accessibilityEvents" AriaLabel="Team schedule" />
        </DemoExample>

        <DemoExample Title="CSS variables" RazorCode="@example21RazorCode" CsharpCode="@example21CsharpCode" Id="example21">
            <div>
                The public <b>--bit-FullCalendar-*</b> variables re-skin the calendar without overriding its selectors. They
                inherit, so set them on <code>:root</code>, on a wrapper (as here) or on one calendar's <b>Style</b>.
                <b>--bit-FullCalendar-hour-height</b> re-scales the time grids, events and resizing included.
            </div>
            <br />
            <div style="--bit-FullCalendar-accent-color:#0f766e;
                        --bit-FullCalendar-accent-hover-color:#115e59;
                        --bit-FullCalendar-today-background:rgba(15, 118, 110, 0.08);
                        --bit-FullCalendar-selection-background:rgba(15, 118, 110, 0.2);
                        --bit-FullCalendar-now-indicator-color:#f59e0b;
                        --bit-FullCalendar-border-radius:16px;
                        --bit-FullCalendar-event-border-radius:999px;
                        --bit-FullCalendar-hour-height:64px;
                        --bit-FullCalendar-height:480px;">
                <BitFullCalendar Events="cssVarsEvents" DefaultView="BitFullCalendarView.Week" />
            </div>
        </DemoExample>

        <DemoExample Title="Cascading parameters" RazorCode="@example22RazorCode" CsharpCode="@example22CsharpCode" Id="example22">
            <div>
                <b>BitParams</b> with a <b>BitFullCalendarParams</b> sets defaults for every calendar under it - here the views,
                a hidden filter bar and one shared <b>Settings</b> object (a preference changed in one calendar's gear reaches
                the other). A calendar's own value wins: the second one keeps the full set of views.
            </div>
            <br />
            <BitParams Parameters="calendarParams">
                <div class="cascade-pair">
                    <BitFullCalendar Events="cascadeEvents1" />
                    <BitFullCalendar Events="cascadeEvents2" Views="null" />
                </div>
            </BitParams>
        </DemoExample>

        <DemoExample Title="Style & Class" RazorCode="@example23RazorCode" CsharpCode="@example23CsharpCode" Id="example23">
            <div>
                <b>Style</b> and <b>Class</b> reach the root; <b>Styles</b> and <b>Classes</b> reach each part: <b>Root</b>,
                <b>Header</b>, <b>Body</b>, <b>Event</b> (every event surface, beside its own <b>CssClass</b>) and
                <b>Dialog</b>.
            </div>
            <br />
            <BitFullCalendar Events="styleEvents"
                             Style="border: 2px dashed var(--bit-clr-pri)"
                             Styles="calendarStyles" />
        </DemoExample>

        <DemoExample Title="RTL" RazorCode="@example24RazorCode" CsharpCode="@example24CsharpCode" Id="example24">
            <div>
                <b>Dir="BitDir.Rtl"</b> renders right-to-left - toolbar, chevrons, grids, dialogs and the timeline - and the arrow
                keys and resizing follow. Only needed when the direction differs from the culture's.
            </div>
            <br />
            <BitFullCalendar Dir="BitDir.Rtl" Events="rtlEvents" />
        </DemoExample>
    </Examples>
</DemoPage>

@code {
    private RenderFragment<BitFullCalendarEvent> EventCard => ev =>
        @<div class="event-card">
            <strong>@ev.Title</strong>
            @if (!string.IsNullOrWhiteSpace(ev.Description))
            {
                <span>@ev.Description</span>
            }
        </div>;

    private RenderFragment<BitFullCalendarEvent> MonthBadge => ev => @<span>📌 @ev.Title</span>;

    private RenderFragment<BitFullCalendarCell> HolidayCell => cell =>
        @<text>
            @if (holidays.TryGetValue(cell.Date, out var holiday))
            {
                <span>🎉 @holiday</span>
            }
        </text>;

    private RenderFragment<BitFullCalendarEvent> AgendaRow => ev =>
        @<span class="agenda-row">
            <strong>@ev.Title</strong>
            <span>@ev.StartDate.ToString("ddd d MMM, HH:mm")</span>
        </span>;

    private RenderFragment<BitFullCalendarResource> ResourceHeader => resource =>
        @<div class="resource-header">
            <span class="resource-avatar" aria-hidden="true">@resource.Title[..1]</span>
            <span>
                <strong>@resource.Title</strong>
                <small>@resource.Subtitle</small>
            </span>
        </div>;
}
