@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Threshold lines" RazorCode="@linesRazorCode" CsharpCode="@linesCsharpCode" Id="annotations-threshold-lines">
    <div class="example-desc">
        <code>BitChartAnnotationPlugin</code> draws reference lines, boxes, points and labels in data coordinates,
        so they follow the values as the chart resizes - here a target line and a shaded warning band. A label's
        pill takes the annotation's <code>Color</code>. Screen readers hear what each one marks - its
        <code>Label</code> and value ("Target: 80"), or a <code>Description</code> of your own.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Series()" Options="_lines" /></div></div>
</DemoExample>

<DemoExample Title="Box + vertical marker" RazorCode="@boxRazorCode" CsharpCode="@boxCsharpCode" Id="annotations-box-vertical-marker">
    <div class="example-desc">
        A box highlights a span of categories and a vertical line marks a single event.
        <code>DrawBehindDatasets</code> places an annotation under or over the data.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="Bars()" Options="_box" /></div></div>
</DemoExample>

<DemoExample Title="Ellipse, polygon and point" RazorCode="@shapesRazorCode" CsharpCode="@shapesCsharpCode" Id="annotations-shapes">
    <div class="example-desc">
        An annotation can also be an <code>Ellipse</code> inscribed in its XMin/XMax/YMin/YMax bounds, a regular
        <code>Polygon</code> (<code>Sides</code>, <code>Radius</code>, <code>Rotation</code>) or a
        <code>Point</code>. All are placed in data coordinates and take a <code>Label</code>.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Series()" Options="_shapes" /></div></div>
</DemoExample>
