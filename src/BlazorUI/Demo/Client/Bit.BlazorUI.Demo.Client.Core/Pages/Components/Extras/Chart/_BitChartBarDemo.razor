@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Grouped" RazorCode="@groupedRazorCode" CsharpCode="@groupedCsharpCode" Id="bar-grouped">
    <div class="example-desc">
        By default datasets stand side by side within each category. <code>CategoryPercentage</code> sets how much
        of the band the group takes and <code>BarPercentage</code> how much of its slot each bar fills.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="_bottom" /></div></div>
</DemoExample>

<DemoExample Title="Stacked" RazorCode="@stackedRazorCode" CsharpCode="@stackedCsharpCode" Id="bar-stacked">
    <div class="example-desc">
        <code>Stacked</code> on the value scale accumulates the datasets, so each bar is a total broken into parts.
        Positive and negative values stack away from zero independently.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="@_stacked" /></div></div>
</DemoExample>

<DemoExample Title="Horizontal" RazorCode="@horizontalRazorCode" CsharpCode="@horizontalCsharpCode" Id="bar-horizontal">
    <div class="example-desc">
        <code>IndexAxis = BitChartIndexAxis.Y</code> draws horizontal bars, giving long category names more room.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="@PerColor()" Options="@_horizontal" /></div></div>
</DemoExample>

<DemoExample Title="Rounded + per-bar colors" RazorCode="@roundedRazorCode" CsharpCode="@roundedCsharpCode" Id="bar-rounded" PreventRenderForMcpClient>
    <div class="example-desc">
        <code>BorderRadius</code> rounds the corners away from the baseline, keeping a flat foot on the axis. A
        list in <code>BackgroundColors</code> gives one color per category instead of per series.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="@PerColorRounded()" Options="@_rounded" /></div></div>
</DemoExample>

<DemoExample Title="Floating bars" RazorCode="@floatingRazorCode" CsharpCode="@floatingCsharpCode" Id="bar-floating">
    <div class="example-desc">
        With <code>RangeData</code> each bar spans a <code>[low, high]</code> pair instead of growing from zero -
        for ranges, price bands and Gantt-style schedules.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="@Floating()" Options="_noLegend" /></div></div>
</DemoExample>

<DemoExample Title="100% stacked" RazorCode="@stacked100RazorCode" CsharpCode="@stacked100CsharpCode" Id="bar-stacked-100">
    <div class="example-desc">
        <code>Stacked100</code> normalizes every category to 100% to show composition; the tooltip still shows the
        original values.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="@_stacked100" /></div></div>
</DemoExample>

<DemoExample Title="Pattern fills" RazorCode="@patternedRazorCode" CsharpCode="@patternedCsharpCode" Id="bar-patterned">
    <div class="example-desc">
        <code>BackgroundPattern</code> fills the bars with a repeating hatch, grid or dot texture, keeping series
        distinguishable in black-and-white print and for color-blind readers.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="@Patterned()" Options="_bottom" /></div></div>
</DemoExample>

<DemoExample Title="Top-rounded corners" RazorCode="@topRoundedRazorCode" CsharpCode="@topRoundedCsharpCode" Id="bar-top-rounded" PreventRenderForMcpClient>
    <div class="example-desc">
        <code>BorderRadiusCorners</code> sets which corners are rounded when the automatic choice is not wanted -
        here only the top two, with <code>BitChartBorderRadiusCorners.Top</code>.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="@TopRounded()" Options="_noLegend" /></div></div>
</DemoExample>

<DemoExample Title="Auto-rotated labels" RazorCode="@rotatedRazorCode" CsharpCode="@rotatedCsharpCode" Id="bar-rotated" PreventRenderForMcpClient>
    <div class="example-desc">
        Category labels that do not fit their band rotate just enough to fit, never past <code>MaxRotation</code>,
        and the axis reserves the extra height they need.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Countries()" Options="_noLegend" /></div></div>
</DemoExample>

<DemoExample Title="Stacked groups" RazorCode="@stackedGroupsRazorCode" CsharpCode="@stackedGroupsCsharpCode" Id="bar-stacked-groups">
    <div class="example-desc">
        Datasets sharing a <code>Stack</code> id accumulate together, one column per id. The value axis fits the
        tallest stack, not the sum of all of them.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="@StackedGroups()" Options="@_stackedGroups" /></div></div>
</DemoExample>

<DemoExample Title="Minimum length and a custom base" RazorCode="@minLengthRazorCode" CsharpCode="@minLengthCsharpCode" Id="bar-min-length">
    <div class="example-desc">
        <code>MinBarLength</code> keeps near-zero values visible instead of collapsing into the axis, and
        <code>Base</code> moves the value bars grow from - here a target of 100.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="@AgainstTarget()" Options="@_target" /></div></div>
</DemoExample>

<DemoExample Title="Overlaid series and skipped gaps" RazorCode="@overlayRazorCode" CsharpCode="@overlayCsharpCode" Id="bar-overlay">
    <div class="example-desc">
        A dataset with <code>Grouped = false</code> spans the full category band, e.g. a target drawn behind the
        actuals. <code>SkipNull</code> lets the other bars widen over categories where a series has no value.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="@Overlay()" Options="_bottom" /></div></div>
</DemoExample>

<DemoExample Title="Error bars" RazorCode="@errorBarsRazorCode" CsharpCode="@errorBarsCsharpCode" Id="bar-error-bars">
    <div class="example-desc">
        <code>ErrorData</code> draws a capped whisker through each value's tip and names the interval in the
        tooltip. A <code>BitChartErrorBar</code> takes one number (symmetric) or two (asymmetric);
        <code>null</code> skips a value. Style it with <code>ErrorBarColor</code>, <code>ErrorBarWidth</code> and
        <code>ErrorBarCapWidth</code>; lines and scatter support it too.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="@Measured()" Options="_bottom" /></div></div>
</DemoExample>

<DemoExample Title="Waterfall" RazorCode="@waterfallRazorCode" CsharpCode="@waterfallCsharpCode" Id="bar-waterfall">
    <div class="example-desc">
        A waterfall from existing options: <code>RangeData</code> floats each bar between the running totals before
        and after its step, <code>BackgroundColorFn</code> colors it by direction, and <code>Callbacks.Label</code>
        reports the step instead of the bar's two ends.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="@Waterfall()" Options="_waterfall" /></div></div>
</DemoExample>
