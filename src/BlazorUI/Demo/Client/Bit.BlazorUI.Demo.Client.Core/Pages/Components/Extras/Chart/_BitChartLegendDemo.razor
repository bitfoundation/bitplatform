@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Interactive legend controls" RazorCode="@liveRazorCode" CsharpCode="@liveCsharpCode" Id="legend-live">
    <div class="example-desc">
        The legend sits on any side, aligned to its start, center or end; <code>Reverse</code> flips the entry
        order. Hovering or focusing an entry fades the other series (<code>HighlightOnHover</code>); clicking it hides
        its dataset and re-scales the axes. Set <code>OnClickToggle</code> to false for a label-only legend.
    </div>
    <div class="controls">
        <label>
            Placement
            <select @bind="_position">
                <option value="@BitPlacement.Top">Top</option>
                <option value="@BitPlacement.Bottom">Bottom</option>
                <option value="@BitPlacement.Left">Left</option>
                <option value="@BitPlacement.Right">Right</option>
            </select>
        </label>
        <label>
            Align
            <select @bind="_align">
                <option value="@BitPlacement.Start">Start</option>
                <option value="@BitPlacement.Center">Center</option>
                <option value="@BitPlacement.End">End</option>
            </select>
        </label>
        <label><input type="checkbox" @bind="_usePointStyle" /> Point style</label>
        <label><input type="checkbox" @bind="_reverse" /> Reverse</label>
        <label><input type="checkbox" @bind="_highlight" /> Highlight on hover</label>
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="MultiSeries()" Options="Live()" /></div></div>
</DemoExample>

<DemoExample Title="Legend title" RazorCode="@titledRazorCode" CsharpCode="@titledCsharpCode" Id="legend-title">
    <div class="example-desc">
        A legend <code>Title</code> names what the entries stand for.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="_titled" /></div></div>
</DemoExample>

<DemoExample Title="Point-style markers" RazorCode="@pointStyleRazorCode" CsharpCode="@pointStyleCsharpCode" Id="legend-point-style" PreventRenderForMcpClient>
    <div class="example-desc">
        <code>UsePointStyle</code> draws each entry with its dataset's marker instead of a color box. Entries are
        buttons: reached by Tab, toggled with Enter or Space, state exposed via <code>aria-pressed</code>.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Markers()" Options="_pointStyle" /></div></div>
</DemoExample>

<DemoExample Title="Capping a long legend" RazorCode="@maxHeightRazorCode" CsharpCode="@maxHeightCsharpCode" Id="legend-max-height">
    <div class="example-desc">
        <code>MaxHeight</code> caps the legend in pixels and scrolls the rest, so many series do not shrink the
        plot. Entries below the fold stay reachable by Tab.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="ManySeries()" Options="_capped" /></div></div>
</DemoExample>
