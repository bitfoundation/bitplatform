@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Two players" RazorCode="@twoPlayersRazorCode" CsharpCode="@twoPlayersCsharpCode" Id="radar-two-players">
    <div class="example-desc">
        A radar chart plots several measures on one shared radial scale to compare profiles by shape. <code>Fill =
        BitChartFillMode.Origin</code> fills the webs.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Radar" Data="BitChartSampleData.Skills()" Options="_bottom" /></div></div>
</DemoExample>

<DemoExample Title="Outline only" RazorCode="@outlineRazorCode" CsharpCode="@outlineCsharpCode" Id="radar-outline" PreventRenderForMcpClient>
    <div class="example-desc">
        Outlines only: past two or three series, a thicker border and no fill keep every web readable.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Radar" Data="@Outline()" Options="_bottom" /></div></div>
</DemoExample>

<DemoExample Title="Circular grid" RazorCode="@circularRazorCode" CsharpCode="@circularCsharpCode" Id="radar-circular">
    <div class="example-desc">
        <code>Grid.Circular</code> draws the rings as circles instead of polygons; the radial tick labels get a
        backdrop to stay legible over the web.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Radar" Data="BitChartSampleData.Skills()" Options="@_circular" /></div></div>
</DemoExample>

<DemoExample Title="Skipped points" RazorCode="@skipRazorCode" CsharpCode="@skipCsharpCode" Id="radar-skipped">
    <div class="example-desc">
        A <code>null</code> value skips its vertex and the web closes over it, instead of dropping to the center as
        a zero.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Radar" Data="@Skip()" Options="_bottom" /></div></div>
</DemoExample>
