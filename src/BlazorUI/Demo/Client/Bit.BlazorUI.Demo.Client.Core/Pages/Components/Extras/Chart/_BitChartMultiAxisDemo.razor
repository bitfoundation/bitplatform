@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Rainfall + temperature" RazorCode="@comboRazorCode" CsharpCode="@comboCsharpCode" Id="multiaxis-rainfall-temperature">
    <div class="example-desc">
        Rainfall bars on the left axis, temperature line on the right (<code>YAxisID</code>). Each axis scales to
        its own datasets, so neither measure flattens the other.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Data="BitChartSampleData.TempAndRainfall()" Options="_combo" /></div></div>
</DemoExample>

<DemoExample Title="Dual line axes" RazorCode="@dualLineRazorCode" CsharpCode="@dualLineCsharpCode" Id="multiaxis-dual-line-axes" PreventRenderForMcpClient>
    <div class="example-desc">
        Two lines whose ranges differ by orders of magnitude, each on its own axis so the smaller one is not
        flattened.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="DualLine()" Options="_dual" /></div></div>
</DemoExample>

<DemoExample Title="Two x-axes" RazorCode="@dualXRazorCode" CsharpCode="@dualXCsharpCode" Id="multiaxis-two-x-axes">
    <div class="example-desc">
        Secondary x axes work the same way through <code>XAxisID</code>. They stack outside the plot
        (<code>Position = BitPlacement.Top</code> here), and only the primary axis draws the grid.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Scatter" Data="DualX()" Options="_dualX" /></div></div>
</DemoExample>
