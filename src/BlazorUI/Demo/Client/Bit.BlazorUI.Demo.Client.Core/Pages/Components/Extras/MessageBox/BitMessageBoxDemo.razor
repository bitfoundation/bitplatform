@page "/components/messagebox"

<PageOutlet Url="components/messagebox"
            Title="MessageBox"
            Description="BitMessageBox is a pre-implemented box for showing a message with a title, a body, a severity icon and the buttons it is answered with." />

<DemoPage Name="MessageBox"
          Description="BitMessageBox is a ready-made box for a message with a title, a body, an optional severity icon and the buttons it is answered with (Ok, Ok/Cancel, Yes/No, Yes/No/Cancel or none). Render it inline, inside a BitModal, or through the BitMessageBoxService, which shows it in a modal and returns the BitMessageBoxResult it was answered with."
          Parameters="componentParameters"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          PublicMembers="componentPublicMembers"
          CssVariables="componentCssVariables"
          GitHubExtrasUrl="MessageBox/BitMessageBox.razor"
          GitHubDemoUrl="Extras/MessageBox/BitMessageBoxDemo.razor">
    <NotesTemplate>
        <BitText>
            To use this component, you need to install the
            <BitLink Href="https://www.nuget.org/packages/Bit.BlazorUI.Extras" Target="_blank">
                <BitTag Reversed
                        Text="Bit.BlazorUI.Extras"
                        Color="BitColor.SecondaryBackground"
                        IconName="@BitIconName.NavigateExternalInline" />
            </BitLink>
            nuget package, as described in the Optional steps of the
            <BitLink Href="/getting-started">Getting started</BitLink> page.
        </BitText>
    </NotesTemplate>
    <Examples>
        <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
            <div>
                A <b>Title</b>, a <b>Body</b> and the Ok button. Line breaks in the body are kept and long lines wrap.
            </div>
            <br />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox Title="It's a title" Body="It's a body." />
                </BitCard>
            </div>
        </DemoExample>

        <DemoExample Title="Buttons" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
            <div>
                <b>Buttons</b> picks the set; <b>OnResult</b> reports which button answered (the close button answers
                <b>None</b>). <b>OkText</b>, <b>CancelText</b>, <b>YesText</b> and <b>NoText</b> rename them, and the
                <b>None</b> set leaves the footer off.
            </div>
            <br />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox Title="Ok"
                                   Body="A single button, which is the default."
                                   OkText="Got it"
                                   OnResult="v => buttonsResult = v" />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="OkCancel"
                                   Body="An Ok and a Cancel button."
                                   Buttons="BitMessageBoxButtons.OkCancel"
                                   OnResult="v => buttonsResult = v" />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="YesNo"
                                   Body="A Yes and a No button."
                                   Buttons="BitMessageBoxButtons.YesNo"
                                   OnResult="v => buttonsResult = v" />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="YesNoCancel"
                                   Body="A Yes, a No and a Cancel button."
                                   Buttons="BitMessageBoxButtons.YesNoCancel"
                                   OnResult="v => buttonsResult = v" />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="None"
                                   Body="No buttons at all - only the close button ends this one."
                                   Buttons="BitMessageBoxButtons.None"
                                   OnResult="v => buttonsResult = v" />
                </BitCard>
            </div>
            <br />
            <div>Last answer: <b>@buttonsResult</b></div>
        </DemoExample>

        <DemoExample Title="Order, focus & emphasis" RazorCode="@example3RazorCode" Id="example3">
            <div>
                <b>Reversed</b> flips the buttons (and their tab order). <b>DefaultButton</b> is where <b>AutoFocus</b>
                lands - point it at the harmless answer of a destructive question, or at <b>None</b> for the close button.
                <b>PrimaryButtonColor</b> paints the affirmative button, <b>ButtonColor</b> the whole set.
            </div>
            <br />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox Reversed
                                   Title="Reversed"
                                   Body="Cancel comes first here."
                                   Buttons="BitMessageBoxButtons.OkCancel" />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="Delete the file?"
                                   Body="Keep is where the focus would land."
                                   Buttons="BitMessageBoxButtons.YesNo"
                                   YesText="Delete"
                                   NoText="Keep"
                                   PrimaryButtonColor="BitColor.Error"
                                   DefaultButton="BitMessageBoxResult.No" />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="ButtonColor"
                                   Body="Every button in the primary color."
                                   Buttons="BitMessageBoxButtons.YesNoCancel"
                                   ButtonColor="BitColor.Primary" />
                </BitCard>
            </div>
        </DemoExample>

        <DemoExample Title="Icon" RazorCode="@example4RazorCode" Id="example4">
            <div>
                <b>IconName</b> (built-in), <b>Icon</b> (external, see External Icons) or <b>IconTemplate</b> (any markup)
                adds a leading glyph (a <b>Color</b> brings one too, see Color). The glyph is
                decorative unless <b>IconAriaLabel</b> names it - do that when the icon alone carries the severity.
            </div>
            <br />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox Title="IconName"
                                   Body="A glyph from the built-in Fluent set."
                                   IconName="@BitIconName.Lightbulb" />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="IconTemplate"
                                   Body="Any markup can stand in for the glyph.">
                        <IconTemplate>
                            <span class="example-emoji">🎉</span>
                        </IconTemplate>
                    </BitMessageBox>
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="IconAriaLabel"
                                   Body="The glyph is announced as &quot;Warning&quot;."
                                   IconName="@BitIconName.Warning"
                                   IconAriaLabel="Warning" />
                </BitCard>
            </div>
        </DemoExample>

        <DemoExample Title="Close button" RazorCode="@example5RazorCode" Id="example5">
            <div>
                The close button dismisses without an answer (<b>OnClose</b>, result <b>None</b>).
                <b>ShowCloseButton</b> removes it, <b>CloseIconName</b> / <b>CloseIcon</b> change its glyph, and
                <b>CloseButtonTitle</b> is its tooltip and accessible name - the text to localize.
            </div>
            <br />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox Title="No close button"
                                   Body="This one has to be answered."
                                   ShowCloseButton="false"
                                   Buttons="BitMessageBoxButtons.YesNo" />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="Custom close button"
                                   Body="Another glyph, and another name for it."
                                   CloseIconName="@BitIconName.Cancel"
                                   CloseButtonTitle="Dismiss this message" />
                </BitCard>
            </div>
        </DemoExample>

        <DemoExample Title="Templates" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
            <div>
                <b>BodyTemplate</b> (or child content), <b>HeaderTemplate</b> (replaces icon, title and close button) and
                <b>FooterTemplate</b> (replaces the buttons) take markup. Controls in a custom footer answer through
                <b>AnswerAsync</b>, which takes the same path as a pressed button.
            </div>
            <br />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox @ref="templatesMessageBox"
                                   Title="Delete the workspace?"
                                   OnResult="v => templatesResult = v">
                        <BodyTemplate>
                            <div>
                                Everything in <b>Design system</b> is removed, including:
                                <ul>
                                    <li>18 projects</li>
                                    <li>4 shared libraries</li>
                                </ul>
                                <BitLink Href="/components/messagebox">Read what this means</BitLink>
                            </div>
                        </BodyTemplate>
                        <FooterTemplate>
                            <BitButton Color="BitColor.Error"
                                       IconName="@BitIconName.Delete"
                                       OnClick="() => templatesMessageBox!.AnswerAsync(BitMessageBoxResult.Yes)">
                                Delete forever
                            </BitButton>
                            <BitButton Variant="BitVariant.Outline"
                                       Color="BitColor.Tertiary"
                                       OnClick="() => templatesMessageBox!.AnswerAsync(BitMessageBoxResult.No)">
                                Keep it
                            </BitButton>
                        </FooterTemplate>
                    </BitMessageBox>
                </BitCard>
            </div>
            <br />
            <div>Last answer: <b>@templatesResult</b></div>
        </DemoExample>

        <DemoExample Title="Guarding the answer" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
            <div>
                Set <b>Cancel</b> in <b>OnBeforeResult</b> to refuse an answer: nothing is reported and the box stays open.
                It guards every button of the box, the close button included (a modal's Escape and overlay are guarded by
                <b>BitModalParameters.CanClose</b>). <b>AutoLoading</b> spins the pressed button while it runs, and the close
                button takes the answer back meanwhile, cancelling the args' <b>CancellationToken</b>.
            </div>
            <br />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox AutoLoading
                                   Title="Delete the file?"
                                   Buttons="BitMessageBoxButtons.YesNo"
                                   YesText="Delete"
                                   NoText="Keep"
                                   PrimaryButtonColor="BitColor.Error"
                                   DefaultButton="BitMessageBoxResult.No"
                                   OnBeforeResult="HandleBeforeResult"
                                   OnResult="v => guardResult = v">
                        <BodyTemplate>
                            <BitCheckbox @bind-Value="guardConfirmed" Label="Yes, I understand this cannot be undone." />
                        </BodyTemplate>
                    </BitMessageBox>
                </BitCard>
            </div>
            <br />
            <div>
                Last answer: <b>@guardResult</b>
                @if (guardRefused)
                {
                    <span> - the last Delete was refused, since the box was not ticked.</span>
                }
            </div>
        </DemoExample>

        <DemoExample Title="BitModal" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
            <div>
                Inside a <b>BitModal</b>, close it from <b>OnClose</b> and turn <b>AutoFocus</b> on. Give the box an
                <b>Id</b> and point the modal's <b>TitleAriaId</b> / <b>SubtitleAriaId</b> at <b>{Id}-ttl</b> /
                <b>{Id}-bdy</b> so the dialog is named and described; <b>TitleElement</b> sets the heading level.
            </div>
            <br />
            <BitButton OnClick="() => isModalOpen = true">Show</BitButton>
            <BitModal @bind-IsOpen="isModalOpen" TitleAriaId="modal-msb-ttl" SubtitleAriaId="modal-msb-bdy">
                <BitMessageBox Id="modal-msb"
                               AutoFocus
                               TitleElement="h2"
                               OnClose="() => isModalOpen = false"
                               Title="Session expiring"
                               Body="You will be signed out in 2 minutes." />
            </BitModal>
        </DemoExample>

        <DemoExample Title="BitModalService" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
            <div>
                As the content of a <b>BitModalService</b> modal: <b>OnResult</b> closes the modal with the answer, so
                awaiting the modal reference awaits the answer.
            </div>
            <br />
            <BitButton OnClick="ShowMessageBox">Show MessageBox</BitButton>
            <br /><br />
            <div>Last answer: <b>@modalServiceResult</b></div>
        </DemoExample>

        <DemoExample Title="BitMessageBoxService" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
            <div>
                One call shows the box in a modal, focuses it, names and describes the dialog, and returns the
                <b>BitMessageBoxResult</b>. <b>ShowInfo</b> ... <b>ShowError</b> preset the severity. Questions and
                the Warning, SevereWarning and Error severities are <b>alertdialog</b>s. A <b>CancellationToken</b>
                closes the box from code (answer <b>None</b>). Needs a <b>BitModalContainer</b> in the layout. A
                <b>FooterTemplate</b> of a service box answers through <b>AnswerAsync</b> too: a component of your own in it
                gets the box as a <b>[CascadingParameter] BitMessageBox</b>.
            </div>
            <br />
            <div class="example-buttons">
                <BitButton OnClick="ShowMessageBoxService">Show</BitButton>
                <BitButton Color="BitColor.Info" OnClick="ShowInfoMessageBox">Info</BitButton>
                <BitButton Color="BitColor.Success" OnClick="ShowSuccessMessageBox">Success</BitButton>
                <BitButton Color="BitColor.Warning" OnClick="ShowWarningMessageBox">Warning</BitButton>
                <BitButton Color="BitColor.SevereWarning" OnClick="ShowSevereWarningMessageBox">SevereWarning</BitButton>
                <BitButton Color="BitColor.Error" OnClick="ShowErrorMessageBox">Error</BitButton>
                <BitButton Variant="BitVariant.Outline" OnClick="ShowTimedMessageBox">Closes in 5s</BitButton>
            </div>
            <br />
            <div>Last answer: <b>@serviceResult</b></div>
        </DemoExample>

        <DemoExample Title="Confirmation" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
            <div>
                <b>Confirm</b> returns <b>true</b> only for Ok or Yes - a refusal or a dismissal is <b>false</b>.
                <b>BitMessageBoxParameters</b> sets everything else, including the modal through its <b>Modal</b> member
                (the second one is <b>Blocking</b>: a click beside it does not dismiss it).
            </div>
            <br />
            <div class="example-buttons">
                <BitButton OnClick="ShowConfirm">Confirm</BitButton>
                <BitButton Color="BitColor.Error" OnClick="ShowDangerousConfirm">Delete something</BitButton>
            </div>
            <br />
            <div>Last answer: <b>@(confirmResult?.ToString() ?? "-")</b></div>
        </DemoExample>

        <DemoExample Title="Prompt" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
            <div>
                <b>Prompt</b> asks for text and returns it, or <b>null</b> when dismissed. The field takes the focus and Enter
                answers (Ctrl+Enter when <b>Multiline</b>). <b>Required</b>, <b>Validator</b> and <b>AsyncValidator</b> (a server
                check, run on answering while the field shows it is busy, and given up on by Cancel) refuse a value with a
                message under the field;
                <b>Label</b>, <b>Description</b>, <b>Placeholder</b>, <b>InputType</b>, <b>AutoComplete</b> and <b>MaxLength</b>
                shape it. Try naming the new folder "Projects".
            </div>
            <br />
            <div class="example-buttons">
                <BitButton OnClick="ShowPrompt">Rename</BitButton>
                <BitButton OnClick="ShowValidatedPrompt">New folder</BitButton>
                <BitButton OnClick="ShowPasswordPrompt">Password</BitButton>
                <BitButton OnClick="ShowMultilinePrompt">Feedback</BitButton>
            </div>
            <br />
            <div>Last answer: <b>@(promptResult ?? "null")</b></div>
        </DemoExample>

        <DemoExample Title="Cascading parameters" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13">
            <div>
                <b>BitParams</b> with a <b>BitMessageBoxParams</b> sets defaults - button texts, colors, order, size -
                for every message box under it; a box's own value wins (the second keeps its own Yes text). Wrap the
                <b>BitModalContainer</b> to reach the service's boxes too. Title, body, buttons and color are not cascaded.
            </div>
            <br />
            <BitParams Parameters="messageBoxParams">
                <div class="example-grid">
                    <BitCard Style="padding:0">
                        <BitMessageBox Title="Save changes?"
                                       Body="Your edits have not been saved."
                                       Buttons="BitMessageBoxButtons.YesNoCancel" />
                    </BitCard>
                    <BitCard Style="padding:0">
                        <BitMessageBox Title="Discard the draft?"
                                       Body="The draft is removed for good."
                                       Buttons="BitMessageBoxButtons.YesNoCancel"
                                       YesText="Discard" />
                    </BitCard>
                </div>
            </BitParams>
        </DemoExample>

        <DemoExample Title="Color" RazorCode="@example14RazorCode" Id="example14">
            <div>
                <b>Color</b> is the severity: it paints the glyph and, for Info, Success, Warning, SevereWarning and
                Error, picks it. <b>IconName</b> still overrides the glyph and <b>HideIcon</b> removes it.
            </div>
            <br />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox Color="BitColor.Info" Title="Info" Body="Something worth knowing." />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Color="BitColor.Success" Title="Success" Body="Something went well." />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Color="BitColor.Warning" Title="Warning" Body="Something needs attention." />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Color="BitColor.SevereWarning" Title="SevereWarning" Body="Something needs attention now." />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Color="BitColor.Error" Title="Error" Body="Something went wrong." />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Color="BitColor.Primary" Title="Primary" Body="The accent of the theme." />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Color="BitColor.Error" HideIcon Title="HideIcon" Body="An Error without its glyph." />
                </BitCard>
            </div>
        </DemoExample>

        <DemoExample Title="External Icons" RazorCode="@example15RazorCode" Id="example15">
            <div>
                <b>Icon</b> and <b>CloseIcon</b> take any CSS-class icon library (raw classes or <b>BitIconInfo.Css</b> /
                <b>Fa</b> / <b>Bi</b>) and win over <b>IconName</b> / <b>CloseIconName</b>. Reference the library's
                stylesheet in your app.
            </div>
            <br />
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox Color="BitColor.Warning"
                                   Icon="@BitIconInfo.Fa("solid triangle-exclamation")"
                                   Title="FontAwesome"
                                   Body="The glyph comes from FontAwesome." />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Color="BitColor.Info"
                                   Icon="@BitIconInfo.Bi("info-circle")"
                                   CloseIcon="@BitIconInfo.Bi("x-lg")"
                                   Title="Bootstrap Icons"
                                   Body="The glyph and the close icon come from Bootstrap Icons." />
                </BitCard>
            </div>
        </DemoExample>

        <DemoExample Title="Size" RazorCode="@example16RazorCode" Id="example16">
            <div>
                <b>Size</b> scales the inset, title, body, glyph and buttons together. Medium is the default.
            </div>
            <br />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox Size="BitSize.Small" Color="BitColor.Info" Title="Small" Body="The small size." />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Size="BitSize.Medium" Color="BitColor.Info" Title="Medium" Body="The medium size." />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Size="BitSize.Large" Color="BitColor.Info" Title="Large" Body="The large size." />
                </BitCard>
            </div>
        </DemoExample>

        <DemoExample Title="Style & Class" RazorCode="@example17RazorCode" CsharpCode="@example17CsharpCode" Id="example17">
            <div>
                <b>Style</b> / <b>Class</b> reach the root, <b>Styles</b> / <b>Classes</b> each part (<b>ActionButton</b>
                covers the buttons given nothing of their own). The public <b>--bit-MessageBox-*</b> variables (see the
                CSS variables table) re-skin it from <b>:root</b>, an ancestor or <b>Style</b>.
            </div>
            <br />
            <div class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox Title="It's a title"
                                   Body="It's a body."
                                   Styles="@(new() { Root = "background: linear-gradient(180deg, #222444, transparent) #000",
                                                     Title = "color: #fff",
                                                     Body = "color: #fff",
                                                     CloseButton = new() { Root = "color: #fff" },
                                                     OkButton = new() { Root = "border-radius:1rem" } })" />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="It's a title"
                                   Body="It's a body."
                                   Buttons="BitMessageBoxButtons.OkCancel"
                                   Classes="@(new() { Root = "custom-msg",
                                                      Title = "custom-msg-txt",
                                                      Body = "custom-msg-txt",
                                                      CloseButton = new() { Root = "custom-msg-txt" },
                                                      ActionButton = new() { Root = "custom-msg-btn" } })" />
                </BitCard>
                <BitCard Style="padding:0">
                    <BitMessageBox Title="CSS variables"
                                   Body="Centered, with a larger glyph."
                                   Color="BitColor.Success"
                                   Buttons="BitMessageBoxButtons.OkCancel"
                                   Style="@cssVariablesStyle" />
                </BitCard>
            </div>
        </DemoExample>

        <DemoExample Title="RTL" RazorCode="@example18RazorCode" Id="example18">
            <div>Use BitMessageBox in right-to-left (RTL).</div>
            <br />
            <div dir="rtl" class="example-grid">
                <BitCard Style="padding:0">
                    <BitMessageBox Dir="BitDir.Rtl"
                                   Color="BitColor.Warning"
                                   Title="عنوان پیام"
                                   Body="متن تست پیام..."
                                   Buttons="BitMessageBoxButtons.YesNo"
                                   YesText="بله"
                                   NoText="خیر"
                                   CloseButtonTitle="بستن" />
                </BitCard>
            </div>
        </DemoExample>
    </Examples>
</DemoPage>
