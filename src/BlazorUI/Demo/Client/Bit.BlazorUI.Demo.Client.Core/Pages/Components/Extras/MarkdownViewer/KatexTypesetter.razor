@* Typesets the TeX a BitMarkdownViewer with UseMathematics() leaves in place, once the viewer has
   rendered it. The call is made from here, after this component's own render, rather than from the
   page: the page cannot tell when the viewer reaches the DOM - a demo example's preview, for one, is
   only mounted when the reader scrolls near it. *@
@inject IJSRuntime JSRuntime

<div @ref="host">@ChildContent</div>

@code {
    private ElementReference host;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Every render rather than only the first: the script skips what it has already typeset, so
        // only math the viewer has drawn since is touched.
        await JSRuntime.InvokeVoidAsync("typesetMath", host);
    }
}
