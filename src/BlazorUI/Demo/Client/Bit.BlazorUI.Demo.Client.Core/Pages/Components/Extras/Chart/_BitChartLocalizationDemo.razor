@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Culture-aware numbers" RazorCode="@cultureRazorCode" CsharpCode="@cultureCsharpCode" Id="localization-culture">
    <div class="example-desc">
        <code>Options.Culture</code> formats every number the chart prints: ticks, tooltips, data labels and the
        CSV export. It defaults to the invariant culture; set <code>CultureInfo.CurrentCulture</code> to follow the
        user.
    </div>
    <div class="controls">
        <label>
            Culture
            <select @bind="_culture">
                <option value="en-US">en-US</option>
                <option value="de-DE">de-DE</option>
                <option value="fr-FR">fr-FR</option>
                <option value="fa-IR">fa-IR</option>
            </select>
        </label>
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="Revenue()" Options="CultureOptions()" /></div></div>
</DemoExample>

<DemoExample Title="Currency ticks" RazorCode="@currencyRazorCode" CsharpCode="@currencyCsharpCode" Id="localization-currency">
    <div class="example-desc">
        <code>Ticks.Format</code> takes any .NET numeric format string, applied with the chart's culture
        (<code>"C0"</code> for currency). <code>Prefix</code> and <code>Suffix</code> simply wrap the number.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Revenue()" Options="_currency" /></div></div>
</DemoExample>

<DemoExample Title="Localized dates" RazorCode="@datesRazorCode" CsharpCode="@datesCsharpCode" Id="localization-dates">
    <div class="example-desc">
        A time axis names months and days in <code>Options.Culture</code> too; <code>TimeFormat</code> overrides
        the label text entirely.
    </div>
    <div class="controls">
        <label>
            Culture
            <select @bind="_dateCulture">
                <option value="en-US">en-US</option>
                <option value="de-DE">de-DE</option>
                <option value="fr-FR">fr-FR</option>
                <option value="ja-JP">ja-JP</option>
            </select>
        </label>
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="BitChartSampleData.TimeSeries()" Options="DateOptions()" /></div></div>
</DemoExample>

<DemoExample Title="Non-Latin labels" RazorCode="@wideRazorCode" CsharpCode="@wideCsharpCode" Id="localization-wide-labels">
    <div class="example-desc">
        Layout measures every tick label, legend entry and axis title before placing the plot, counting CJK, Kana
        and Hangul glyphs as a full em wide, so non-Latin labels get the room they need instead of colliding.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="Japanese()" Options="_wide" /></div></div>
</DemoExample>

<DemoExample Title="Right-to-left and translated texts" RazorCode="@rtlRazorCode" CsharpCode="@rtlCsharpCode" Id="localization-rtl">
    <div class="example-desc">
        <code>Dir="BitDir.Rtl"</code> mirrors the title, legend, tooltip and screen-reader table, but not the plot;
        set <code>Reverse</code> on the index scale to mirror that too. <code>Texts</code> translates what the chart
        writes for screen readers and the CSV - what the plot is called, the legend's name, the announced positions, the
        table headers - and
        <code>NavigationHint</code> the keyboard instructions.
    </div>
    <div class="chart-wrapper">
        <div class="chart-container">
            <BitChart Dir="BitDir.Rtl"
                      Type="BitChartType.Bar"
                      Data="Persian()"
                      Options="_rtl"
                      Texts="_persianTexts"
                      NavigationHint="با کلیدهای جهت‌نما میان فصل‌ها و سری‌ها حرکت کنید." />
        </div>
    </div>
</DemoExample>
