<DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
    <div>
        <code>Items</code> takes a list of <code>BitAccordionListItem</code>s, each with a <code>Title</code>, an
        optional <code>Description</code> and a <code>Body</code>. One panel is open at a time by default.
    </div>
    <br />
    <BitAccordionList Items="basicItems" TItem="BitAccordionListItem" />
</DemoExample>

<DemoExample Title="Multiple" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2" PreventRenderForMcpClient>
    <div>
        <code>Multiple</code> lets several panels stay open. <code>MaxExpanded</code> caps them: opening one more
        closes the panel open the longest.
    </div>
    <br />
    <div class="example-content">
        <div>Multiple:</div>
        <BitAccordionList Multiple Items="basicItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>MaxExpanded="2":</div>
        <BitAccordionList Multiple MaxExpanded="2" Items="basicItems" TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="DefaultExpanded & Collapsible" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3" PreventRenderForMcpClient>
    <div>
        <code>DefaultExpandedKey</code> and <code>DefaultExpandedKeys</code> pick the panels that start open (a
        missing <code>Key</code> is generated from the position, so these set their own).
        <code>Collapsible="false"</code> keeps one panel open at all times; its header then reports
        <code>aria-disabled</code>.
    </div>
    <br />
    <div class="example-content">
        <div>DefaultExpandedKey:</div>
        <BitAccordionList DefaultExpandedKey="users" Items="keyedItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>DefaultExpandedKeys:</div>
        <BitAccordionList Multiple
                          DefaultExpandedKeys="@(["general", "advanced"])"
                          Items="keyedItems"
                          TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Collapsible="false":</div>
        <BitAccordionList Collapsible="false" DefaultExpandedKey="general" Items="keyedItems" TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="Icons" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4" PreventRenderForMcpClient>
    <div>
        <code>ExpanderIconName</code> replaces every chevron and <code>ExpandedExpanderIconName</code> swaps it while
        open; each item can set its own, plus a leading <code>IconName</code>. <code>ExpanderIconPosition</code> moves
        the expander to the start, <code>NoExpanderRotation</code> stops it turning and <code>HideExpanderIcon</code>
        removes it.
    </div>
    <br />
    <div class="example-content">
        <div>Per-item icons:</div>
        <BitAccordionList Items="iconItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>ExpandedExpanderIconName:</div>
        <BitAccordionList ExpanderIconName="@BitIconName.Add"
                          ExpandedExpanderIconName="@BitIconName.Remove"
                          Items="basicItems"
                          TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>ExpanderIconPosition:</div>
        <BitAccordionList ExpanderIconPosition="BitIconPosition.Start" Items="basicItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>HideExpanderIcon:</div>
        <BitAccordionList HideExpanderIcon Items="basicItems" TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="Actions" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5" PreventRenderForMcpClient>
    <div>
        <code>ActionsTemplate</code> renders beside each header, outside the toggle button, so it can hold buttons and
        menus of its own. An item's own <code>Actions</code> wins over it.
    </div>
    <br />
    <BitAccordionList Items="basicItems" TItem="BitAccordionListItem">
        <ActionsTemplate Context="item">
            <BitButton IconOnly
                       Variant="BitVariant.Text"
                       IconName="@BitIconName.MoreVertical"
                       Title="@($"More about {item.Title}")"
                       OnClick="() => actionedTitle = item.Title" />
        </ActionsTemplate>
    </BitAccordionList>
    <br />
    <div>Last action: <b>@actionedTitle</b></div>
</DemoExample>

<DemoExample Title="Templates" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6" PreventRenderForMcpClient>
    <div>
        <code>HeaderTemplate</code> and <code>BodyTemplate</code> replace the whole header and panel;
        <code>TitleTemplate</code> and <code>ExpanderTemplate</code> replace only their part. Each gets the item as
        its context, and an item's own template wins.
    </div>
    <br />
    <div class="example-content">
        <div>HeaderTemplate &amp; BodyTemplate:</div>
        <BitAccordionList Items="templateItems" TItem="BitAccordionListItem">
            <HeaderTemplate Context="item">
                <BitIcon IconName="@BitIconName.FavoriteStarFill" Color="BitColor.Warning" />
                <b>@item.Title</b>
            </HeaderTemplate>
            <BodyTemplate Context="item">
                <BitText Typography="BitTypography.Caption1">@item.Description</BitText>
            </BodyTemplate>
        </BitAccordionList>
    </div>
    <br /><br />
    <div class="example-content">
        <div>TitleTemplate &amp; ExpanderTemplate:</div>
        <BitAccordionList Items="basicItems" TItem="BitAccordionListItem">
            <TitleTemplate Context="item">
                <BitTag Text="@item.Title" Color="BitColor.SecondaryBackground" />
            </TitleTemplate>
            <ExpanderTemplate Context="item">
                <BitIcon IconName="@BitIconName.ChevronDownSmall" />
            </ExpanderTemplate>
        </BitAccordionList>
    </div>
</DemoExample>

<DemoExample Title="Disabled & Read-only" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7" PreventRenderForMcpClient>
    <div>
        <code>IsEnabled="false"</code> greys an item out and takes it out of the tab order. <code>ReadOnly</code>
        keeps it focusable and in its colors but frozen (<code>aria-disabled</code>), and still raises
        <code>OnItemClick</code>. Both work for the whole list or per item.
    </div>
    <br />
    <BitAccordionList Multiple
                      DefaultExpandedKeys="@(["locked"])"
                      OnItemClick="(BitAccordionListItem item) => { if (item.ReadOnly is true) readOnlyClickCount++; }"
                      Items="stateItems"
                      TItem="BitAccordionListItem" />
    <br />
    <div>Clicks on the read-only header: <b>@readOnlyClickCount</b></div>
</DemoExample>

<DemoExample Title="Events" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8" PreventRenderForMcpClient>
    <div>
        <code>OnExpand</code>, <code>OnCollapse</code> and <code>OnToggle</code> report every item that moves,
        including the one single-expand mode closes. Each item can also have its own <code>OnClick</code>.
    </div>
    <br />
    <BitAccordionList OnExpand="(BitAccordionListItem item) => expandedTitle = item.Title"
                      OnCollapse="(BitAccordionListItem item) => collapsedTitle = item.Title"
                      OnToggle="(BitAccordionListItem item) => toggledTitle = item.Title"
                      Items="eventsItems"
                      TItem="BitAccordionListItem" />
    <br />
    <div>Last expanded: <b>@expandedTitle</b></div>
    <div>Last collapsed: <b>@collapsedTitle</b></div>
    <div>Last toggled: <b>@toggledTitle</b></div>
    <div>Header clicks: <b>@clickCounter</b></div>
</DemoExample>

<DemoExample Title="Cancelling a toggle" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9" PreventRenderForMcpClient>
    <div>
        <code>OnToggling</code> runs before an item moves; set <code>Cancel</code> to keep it where it is, and read
        <code>Reason</code> for what asked. It is awaited, so it can confirm or load data first, while the header
        reports <code>aria-busy</code>.
    </div>
    <br />
    <BitCheckbox @bind-Value="lockToggling" Label="Refuse every toggle" />
    <BitCheckbox @bind-Value="slowToggling" Label="Take a second to decide" />
    <br />
    <BitAccordionList OnToggling="HandleOnToggling" Items="basicItems" TItem="BitAccordionListItem" />
    <br />
    <div>Last request: <b>@togglingReport</b></div>
</DemoExample>

<DemoExample Title="Binding & methods" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10" PreventRenderForMcpClient>
    <div>
        <code>@@bind-ExpandedKey</code> and <code>@@bind-ExpandedKeys</code> hand the open state to the page.
        <code>Expand</code>, <code>Collapse</code>, <code>Toggle</code>, <code>ExpandAll</code> (Multiple only),
        <code>CollapseAll</code> and <code>FocusItem</code> drive it from code, and are not blocked by
        <code>ReadOnly</code> or <code>Collapsible</code>.
    </div>
    <br />
    <div class="example-content">
        <div>@@bind-ExpandedKey:</div>
        <BitButtonGroup Toggle Items="bindingButtons" TItem="BitButtonGroupItem" @bind-ToggleKey="boundExpandedKey" />
        <BitAccordionList @bind-ExpandedKey="boundExpandedKey" Items="keyedItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Methods &amp; @@bind-ExpandedKeys:</div>
        <BitStack Horizontal Wrap>
            <BitButton OnClick="@(() => accordionListRef!.ExpandAll())">Expand all</BitButton>
            <BitButton OnClick="@(() => accordionListRef!.CollapseAll())">Collapse all</BitButton>
            <BitButton OnClick="@(() => accordionListRef!.Toggle("users"))">Toggle Users</BitButton>
            <BitButton OnClick="@(() => accordionListRef!.FocusItem("advanced"))">Focus Advanced</BitButton>
        </BitStack>
        <BitAccordionList @ref="accordionListRef"
                          Multiple
                          @bind-ExpandedKeys="programmaticKeys"
                          Items="keyedItems"
                          TItem="BitAccordionListItem" />
        <div>Expanded keys: <b>@string.Join(", ", programmaticKeys)</b></div>
    </div>
</DemoExample>

<DemoExample Title="Content rendering" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11" PreventRenderForMcpClient>
    <div>
        Panels render up front by default. <code>LazyContent</code> renders a panel on its first open and keeps it;
        <code>UnmountOnCollapse</code> removes it again on every close. Watch the timestamps.
    </div>
    <br />
    <div class="example-content">
        <div>LazyContent:</div>
        <BitAccordionList Multiple LazyContent Items="lazyItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>UnmountOnCollapse:</div>
        <BitAccordionList Multiple UnmountOnCollapse Items="unmountItems" TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="MaxHeight & Transition" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12" PreventRenderForMcpClient>
    <div>
        <code>MaxHeight</code> caps a panel, which then scrolls and takes a tab stop so the keyboard can scroll it.
        <code>TransitionDuration</code> sets the animation in milliseconds (<code>0</code> turns it off); a
        reduced-motion preference still wins unless <code>ForceAnimation</code> is set.
    </div>
    <br />
    <div class="example-content">
        <div>MaxHeight="100px":</div>
        <BitAccordionList MaxHeight="100px" DefaultExpandedKey="long-1" Items="longItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>TransitionDuration="0":</div>
        <BitAccordionList TransitionDuration="0" Items="basicItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>TransitionDuration="1500":</div>
        <BitAccordionList TransitionDuration="1500" Items="basicItems" TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="Find & print" RazorCode="@example13RazorCode" CsharpCode="@example13CsharpCode" Id="example13" PreventRenderForMcpClient>
    <div>
        <code>HiddenUntilFound</code> keeps closed panels searchable: find-in-page opens the item around a match
        through the list, so <code>OnToggling</code> sees it with the <code>Reveal</code> reason.
        <code>ExpandOnPrint</code> prints every panel open. Content that is not in the DOM (an unopened
        <code>LazyContent</code> panel, <code>UnmountOnCollapse</code>) cannot be found or printed.
    </div>
    <br />
    <div>Search the page (Ctrl+F) for <b>refund</b> or <b>invoice</b>, or open the print preview (Ctrl+P).</div>
    <br />
    <BitAccordionList HiddenUntilFound ExpandOnPrint Items="faqItems" TItem="BitAccordionListItem" />
</DemoExample>

<DemoExample Title="Scroll into view" RazorCode="@example14RazorCode" CsharpCode="@example14CsharpCode" Id="example14" PreventRenderForMcpClient>
    <div>
        <code>ScrollIntoViewOnExpand</code> scrolls a newly opened item into view - only as far as needed, and
        instantly under reduced motion. <code>ExpandAll</code> scrolls to nothing.
    </div>
    <br />
    <div>Open the last panels: the box follows them.</div>
    <br />
    <div class="scroll-box">
        <BitAccordionList ScrollIntoViewOnExpand Items="scrollItems" TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="Joined, Gap & NoBorder" RazorCode="@example15RazorCode" CsharpCode="@example15CsharpCode" Id="example15" PreventRenderForMcpClient>
    <div>
        <code>Joined</code> fuses the items into one surface: one shared line between neighbours, rounded outer
        corners only. <code>Gap</code> spaces separate items (in pixels), and <code>NoBorder</code> trades the outline
        for a filled background.
    </div>
    <br />
    <div class="example-content">
        <div>Joined:</div>
        <BitAccordionList Joined Items="basicItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Joined &amp; NoBorder:</div>
        <BitAccordionList Joined NoBorder Items="basicItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Gap="16" &amp; NoBorder:</div>
        <BitAccordionList Gap="16" NoBorder Items="basicItems" TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="Empty content" RazorCode="@example16RazorCode" CsharpCode="@example16CsharpCode" Id="example16" PreventRenderForMcpClient>
    <div>
        <code>EmptyContent</code> renders while the list has no items.
    </div>
    <br />
    <BitCheckbox @bind-Value="showEmptyItems" Label="Show the items" />
    <br />
    <BitAccordionList Items="@(showEmptyItems ? basicItems : noItems)" TItem="BitAccordionListItem">
        <EmptyContent>
            <BitText Typography="BitTypography.Body2">There is nothing to show here yet.</BitText>
        </EmptyContent>
    </BitAccordionList>
</DemoExample>

<DemoExample Title="Accessibility" RazorCode="@example17RazorCode" CsharpCode="@example17CsharpCode" Id="example17" PreventRenderForMcpClient>
    <div>
        Each header is a button inside a heading, wired to a region panel as the WAI-ARIA accordion pattern asks.
        <code>HeadingLevel</code> sets the level (3 by default). The arrow, Home and End keys move between headers
        (<code>Navigable</code>, on by default), wrapping around unless <code>NoNavigationLoop</code> is set.
        <code>NoContentRegion</code> drops the region role for long lists, <code>AriaLabel</code> (or an
        <code>aria-labelledby</code>) names the list, and an item's <code>HeaderAriaLabel</code> names an icon-only
        header.
    </div>
    <br />
    <BitAccordionList Multiple
                      HeadingLevel="2"
                      NoContentRegion
                      NoNavigationLoop
                      AriaLabel="Application settings"
                      Items="basicItems"
                      TItem="BitAccordionListItem" />
</DemoExample>

<DemoExample Title="Cascading parameters" RazorCode="@example18RazorCode" CsharpCode="@example18CsharpCode" Id="example18" PreventRenderForMcpClient>
    <div>
        A <code>BitParams</code> with a <code>BitAccordionListParams</code> sets the defaults of every list inside it;
        a list's own parameters win.
    </div>
    <br />
    <BitParams Parameters="@accordionListParams">
        <BitAccordionList Items="basicItems" TItem="BitAccordionListItem" />
        <br />
        <BitAccordionList Joined="false" Items="basicItems" TItem="BitAccordionListItem" />
    </BitParams>
</DemoExample>

<DemoExample Title="Color" RazorCode="@example19RazorCode" CsharpCode="@example19CsharpCode" Id="example19" PreventRenderForMcpClient>
    <div>
        <code>Background</code> and <code>Border</code> take a <code>BitColorKind</code> and repaint every item, hover
        shades included. A <code>Transparent</code> background on a <code>Joined</code>, <code>NoBorder</code> list
        leaves only the lines between the items: a flush list for a FAQ or a sidebar.
    </div>
    <br />
    <div class="example-content">
        <div>Background="Secondary" &amp; Border="Tertiary":</div>
        <BitAccordionList Background="BitColorKind.Secondary"
                          Border="BitColorKind.Tertiary"
                          Items="basicItems"
                          TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Background="Tertiary" &amp; Border="Transparent":</div>
        <BitAccordionList Background="BitColorKind.Tertiary"
                          Border="BitColorKind.Transparent"
                          Items="basicItems"
                          TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Flush (Background="Transparent", Joined &amp; NoBorder):</div>
        <BitAccordionList Joined
                          NoBorder
                          Background="BitColorKind.Transparent"
                          Items="basicItems"
                          TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="External Icons" RazorCode="@example20RazorCode" CsharpCode="@example20CsharpCode" Id="example20" PreventRenderForMcpClient>
    <div>
        <code>ExpanderIcon</code>, <code>ExpandedExpanderIcon</code> and an item's <code>Icon</code> take a
        <code>BitIconInfo</code>, for icon libraries such as FontAwesome (<code>BitIconInfo.Fa</code>) and Bootstrap
        Icons (<code>BitIconInfo.Bi</code>).
    </div>
    <br />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <br />
    <div class="example-content">
        <div>FontAwesome:</div>
        <BitAccordionList ExpanderIcon="@BitIconInfo.Fa("solid angle-down")" Items="faItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Bootstrap:</div>
        <BitAccordionList ExpanderIcon="@BitIconInfo.Bi("chevron-down")" Items="biItems" TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="Size" RazorCode="@example21RazorCode" CsharpCode="@example21CsharpCode" Id="example21" PreventRenderForMcpClient>
    <div>
        <code>Size</code> scales the padding and the type of every item.
    </div>
    <br />
    <div class="example-content">
        <div>Small:</div>
        <BitAccordionList Size="BitSize.Small" Items="basicItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Medium:</div>
        <BitAccordionList Size="BitSize.Medium" Items="basicItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Large:</div>
        <BitAccordionList Size="BitSize.Large" Items="basicItems" TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="Style & Class" RazorCode="@example22RazorCode" CsharpCode="@example22CsharpCode" Id="example22">
    <div>
        <code>Style</code> and <code>Class</code> dress the list root; <code>Styles</code> and <code>Classes</code>
        reach every part of every item, with <code>ItemExpanded</code> and <code>ItemExpandedIcon</code> applied only
        while open. The <code>--bit-AccordionList-*</code> and <code>--bit-Accordion-*</code> CSS variables restyle
        all the items from one place.
    </div>
    <br />
    <div class="example-content">
        <div>Style &amp; Class:</div>
        <BitAccordionList Gap="8"
                          Style="border: 1px solid var(--bit-clr-pri); border-radius: 0.5rem; padding: 0.5rem;"
                          Items="basicItems"
                          TItem="BitAccordionListItem" />
        <BitAccordionList Gap="8" Class="custom-item" Items="basicItems" TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Styles &amp; Classes:</div>
        <BitAccordionList Styles="@(new() { ItemTitle = "color: tomato;", ItemHeader = "background-color: var(--bit-clr-bg-sec);" })"
                          Items="basicItems"
                          TItem="BitAccordionListItem" />
        <BitAccordionList Classes="@(new() { ItemTitle = "custom-title", ItemExpanded = "custom-expanded" })"
                          Items="basicItems"
                          TItem="BitAccordionListItem" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>CSS variables:</div>
        <BitAccordionList Style="--bit-AccordionList-gap: 2px; --bit-Accordion-radius: 0; --bit-Accordion-title-color: var(--bit-clr-pri); --bit-Accordion-header-expanded-background: var(--bit-clr-bg-sec);"
                          Items="basicItems"
                          TItem="BitAccordionListItem" />
        <BitAccordionList Joined
                          Style="--bit-Accordion-border-color: var(--bit-clr-pri); --bit-AccordionList-divider-color: var(--bit-clr-brd-sec);"
                          Items="basicItems"
                          TItem="BitAccordionListItem" />
    </div>
</DemoExample>

<DemoExample Title="RTL" RazorCode="@example23RazorCode" CsharpCode="@example23CsharpCode" Id="example23" PreventRenderForMcpClient>
    <div>
        <code>Dir="BitDir.Rtl"</code> mirrors the whole list.
    </div>
    <br />
    <BitAccordionList Dir="BitDir.Rtl" Items="rtlItems" TItem="BitAccordionListItem" />
</DemoExample>
