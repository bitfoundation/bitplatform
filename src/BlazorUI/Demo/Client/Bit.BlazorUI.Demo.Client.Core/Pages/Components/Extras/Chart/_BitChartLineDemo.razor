@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Smooth line with area fill" RazorCode="@filledRazorCode" CsharpCode="@filledCsharpCode" Id="line-filled">
    <div class="example-desc">
        A line chart smoothed with <code>Tension = 0.4</code> and filled to the origin.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Filled()" Options="_legendBottom" /></div></div>
</DemoExample>

<DemoExample Title="Straight lines" RazorCode="@straightRazorCode" CsharpCode="@straightCsharpCode" Id="line-straight" PreventRenderForMcpClient>
    <div class="example-desc">
        <code>Tension = 0</code> draws straight segments between the points, showing exactly what was measured.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="BitChartSampleData.MonthlySales()" Options="_legendBottom" /></div></div>
</DemoExample>

<DemoExample Title="Stepped line" RazorCode="@steppedRazorCode" CsharpCode="@steppedCsharpCode" Id="line-stepped" PreventRenderForMcpClient>
    <div class="example-desc">
        <code>Stepped</code> holds each value until the next one instead of sloping, for quantities that change at
        a moment. <code>Before</code> steps at the new point, <code>After</code> at the old one and
        <code>Middle</code> halfway.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Stepped()" Options="_legendBottom" /></div></div>
</DemoExample>

<DemoExample Title="Dashed border with custom points" RazorCode="@dashedRazorCode" CsharpCode="@dashedCsharpCode" Id="line-dashed">
    <div class="example-desc">
        <code>BorderDash</code> sets the dash pattern and <code>PointStyle</code> picks one of ten marker shapes. A
        <code>null</code> value breaks the line by default; <code>SpanGaps</code> bridges it, as here.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Dashed()" Options="_legendBottom" /></div></div>
</DemoExample>

<DemoExample Title="Logarithmic Y axis" RazorCode="@logRazorCode" CsharpCode="@logCsharpCode" Id="line-log">
    <div class="example-desc">
        A value scale with <code>Type = BitChartScaleType.Logarithmic</code> keeps data spanning several orders of
        magnitude readable.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Log()" Options="_logOptions" /></div></div>
</DemoExample>

<DemoExample Title="Per-segment styling" RazorCode="@segmentedRazorCode" CsharpCode="@segmentedCsharpCode" Id="line-segmented">
    <div class="example-desc">
        <code>Segment</code> callbacks style each span between two points from its endpoints - here rising green,
        falling red and the last stretch dashed. Returning null falls back to the dataset's styling.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Segmented()" Options="_legendBottom" /></div></div>
</DemoExample>

<DemoExample Title="Monotone smoothing" RazorCode="@monotoneRazorCode" CsharpCode="@monotoneCsharpCode" Id="line-monotone" PreventRenderForMcpClient>
    <div class="example-desc">
        Plain <code>Tension</code> (a cardinal spline) can overshoot the values it connects, as the grey line
        shows. <code>CubicInterpolationMode.Monotone</code> smooths the same points without overshooting.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Monotone()" Options="_legendBottom" /></div></div>
</DemoExample>

<DemoExample Title="Sparkline" RazorCode="@sparklineRazorCode" CsharpCode="@sparklineCsharpCode" Id="line-sparkline">
    <div class="example-desc">
        <code>Sparkline</code> hides axes, grid, tick labels, legend and title so the series fills the box, e.g. in
        a KPI tile or table cell. Data, hover, keyboard navigation and the screen-reader table are unaffected; any
        chart type supports it.
    </div>
    <div class="sparkline-tiles">
        @foreach (var tile in _tiles)
        {
            <div class="sparkline-tile">
                <div class="sparkline-caption">@tile.Caption</div>
                <div class="sparkline-value">@tile.Value</div>
                <BitChart Type="tile.Type" Data="tile.Data" Options="_sparkline" Height="48px" />
            </div>
        }
    </div>
</DemoExample>
