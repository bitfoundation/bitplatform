<DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
    <div>Provide a custom generic type and map its properties using NameSelectors.</div>
    <br />
    <BitAccordionList Items="basicSections" TItem="Section" NameSelectors="nameSelectors" />
</DemoExample>

<DemoExample Title="Multiple" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
    <div>Enable the <code>Multiple</code> parameter to allow more than one item to be expanded at the same time.</div>
    <br />
    <BitAccordionList Multiple Items="basicSections" TItem="Section" NameSelectors="nameSelectors" />
</DemoExample>

<DemoExample Title="DefaultExpanded" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
    <div>Use <code>DefaultExpandedKey</code> (single) or <code>DefaultExpandedKeys</code> (multiple) to set the initially expanded items.</div>
    <br /><br />
    <div class="example-content">
        <div>Single (DefaultExpandedKey):</div>
        <BitAccordionList Items="basicSections" TItem="Section" NameSelectors="nameSelectors" DefaultExpandedKey="users" />
    </div>
    <br /><br />
    <div class="example-content">
        <div>Multiple (DefaultExpandedKeys):</div>
        <BitAccordionList Multiple Items="basicSections" TItem="Section" NameSelectors="nameSelectors" DefaultExpandedKeys="@(["general", "advanced"])" />
    </div>
</DemoExample>

<DemoExample Title="Events" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
    <div>Handle the OnExpand, OnCollapse and OnToggle events of the component.</div>
    <br />
    <BitAccordionList Items="basicSections"
                      TItem="Section"
                      NameSelectors="nameSelectors"
                      OnExpand="(Section item) => expandedName = item.Name"
                      OnCollapse="(Section item) => collapsedName = item.Name"
                      OnToggle="(Section item) => toggledName = item.Name" />
    <br />
    <div>Last expanded: <b>@expandedName</b></div>
    <div>Last collapsed: <b>@collapsedName</b></div>
    <div>Last toggled: <b>@toggledName</b></div>
    <br /><br />
    <div>The item's own click handler can be mapped with the OnClick selector.</div>
    <br />
    <BitAccordionList Items="eventsSections"
                      TItem="Section"
                      NameSelectors="@(new() { Key = { Selector = i => i.Id },
                                               Title = { Selector = i => i.Name },
                                               Body = { Selector = i => i.Content },
                                               OnClick = { Selector = i => i.Clicked } })" />
    <div>Item click count: <b>@clickCounter</b></div>
</DemoExample>

<DemoExample Title="Binding" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5">
    <div>Two-way bind the expanded key in single-expand mode using <code>@@bind-ExpandedKey</code>.</div>
    <br />
    <BitButtonGroup Items="bindingButtons" TItem="BitButtonGroupItem" />
    <br />
    <div>Bound expanded key: <b>@boundExpandedKey</b></div>
    <br />
    <BitAccordionList @bind-ExpandedKey="boundExpandedKey" Items="basicSections" TItem="Section" NameSelectors="nameSelectors" />
</DemoExample>

<DemoExample Title="ExpanderIcon" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
    <div>Map the expander icon name of each item using the ExpanderIconName selector.</div>
    <br />
    <BitAccordionList Items="iconSections"
                      TItem="Section"
                      NameSelectors="@(new() { Key = { Selector = i => i.Id },
                                               Title = { Selector = i => i.Name },
                                               Body = { Selector = i => i.Content },
                                               ExpanderIconName = { Selector = i => i.Image } })" />
</DemoExample>

<DemoExample Title="Style & Class" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
    <div>Map the per-item style and class using the Style and Class selectors.</div>
    <br />
    <BitAccordionList Items="styleClassSections"
                      TItem="Section"
                      NameSelectors="@(new() { Key = { Selector = i => i.Id },
                                               Title = { Selector = i => i.Name },
                                               Body = { Selector = i => i.Content },
                                               Style = { Selector = i => i.Style },
                                               Class = { Selector = i => i.Class } })" />
</DemoExample>
