<DemoExample Title="Find & print" RazorCode="@example13RazorCode" Id="example13" PreventRenderForMcpClient>
    <div>
        <code>HiddenUntilFound</code> keeps closed panels searchable: find-in-page opens the option around a match
        through the list, so <code>OnToggling</code> sees it with the <code>Reveal</code> reason.
        <code>ExpandOnPrint</code> prints every panel open. Content that is not in the DOM (an unopened
        <code>LazyContent</code> panel, <code>UnmountOnCollapse</code>) cannot be found or printed.
    </div>
    <br />
    <div>Search the page (Ctrl+F) for <b>refund</b> or <b>invoice</b>, or open the print preview (Ctrl+P).</div>
    <br />
    <BitAccordionList HiddenUntilFound ExpandOnPrint TItem="BitAccordionListOption">
        <BitAccordionListOption Title="How do I reset my password?" Description="Account">
            Open Settings, choose Security and pick Reset password; the link we email you expires after one hour.
        </BitAccordionListOption>
        <BitAccordionListOption Title="Can I get a refund?" Description="Billing">
            Refunds are issued within 14 days, to the payment method the order was paid with.
        </BitAccordionListOption>
        <BitAccordionListOption Title="Where is my invoice?" Description="Billing">
            Every invoice is listed under Billing, ready to download as a PDF.
        </BitAccordionListOption>
    </BitAccordionList>
</DemoExample>

