<DemoExample Title="Actions" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5" PreventRenderForMcpClient>
    <div>
        <code>ActionsTemplate</code> renders beside each header, outside the toggle button, so it can hold buttons and
        menus of its own. An option's own <code>Actions</code> wins over it.
    </div>
    <br />
    <BitAccordionList TItem="BitAccordionListOption">
        <ActionsTemplate Context="option">
            <BitButton IconOnly
                       Variant="BitVariant.Text"
                       IconName="@BitIconName.MoreVertical"
                       Title="@($"More about {option.Title}")"
                       OnClick="() => actionedTitle = option.Title" />
        </ActionsTemplate>
        <Options>
            <BitAccordionListOption Title="General settings" Description="The general settings of the application">
                Once upon a time, stories wove connections between people, a symphony of voices crafting shared dreams.
            </BitAccordionListOption>
            <BitAccordionListOption Title="Users" Description="You are currently not an owner">
                Every story starts with a blank canvas, a quiet space waiting to be filled with ideas, emotions, and dreams.
            </BitAccordionListOption>
            <BitAccordionListOption Title="Advanced settings" Description="Filtering has been entirely disabled">
                In the beginning, there is silence a blank canvas yearning to be filled, a quiet space where creativity waits to awaken.
            </BitAccordionListOption>
        </Options>
    </BitAccordionList>
    <br />
    <div>Last action: <b>@actionedTitle</b></div>
</DemoExample>

<DemoExample Title="Templates" RazorCode="@example6RazorCode" Id="example6" PreventRenderForMcpClient>
    <div>
        <code>HeaderTemplate</code> and <code>BodyTemplate</code> replace the whole header and panel;
        <code>TitleTemplate</code> and <code>ExpanderTemplate</code> replace only their part. Each gets the option as
        its context, and an option's own template wins.
    </div>
    <br />
    <div class="example-content">
        <div>HeaderTemplate &amp; BodyTemplate:</div>
        <BitAccordionList TItem="BitAccordionListOption">
            <HeaderTemplate Context="option">
                <BitIcon IconName="@BitIconName.FavoriteStarFill" Color="BitColor.Warning" />
                <b>@option.Title</b>
            </HeaderTemplate>
            <BodyTemplate Context="option">
                <BitText Typography="BitTypography.Caption1">@option.Description</BitText>
            </BodyTemplate>
            <Options>
                <BitAccordionListOption Title="General settings" Description="The general settings of the application" />
                <BitAccordionListOption Title="Users" Description="You are currently not an owner" />
                <BitAccordionListOption Title="Advanced settings" Description="Filtering has been entirely disabled" />
            </Options>
        </BitAccordionList>
    </div>
    <br /><br />
    <div class="example-content">
        <div>TitleTemplate &amp; ExpanderTemplate:</div>
        <BitAccordionList TItem="BitAccordionListOption">
            <TitleTemplate Context="option">
                <BitTag Text="@option.Title" Color="BitColor.SecondaryBackground" />
            </TitleTemplate>
            <ExpanderTemplate Context="option">
                <BitIcon IconName="@BitIconName.ChevronDownSmall" />
            </ExpanderTemplate>
            <Options>
                <BitAccordionListOption Title="General settings" Description="The general settings of the application">
                    Once upon a time, stories wove connections between people, a symphony of voices crafting shared dreams.
                </BitAccordionListOption>
                <BitAccordionListOption Title="Users" Description="You are currently not an owner">
                    Every story starts with a blank canvas, a quiet space waiting to be filled with ideas, emotions, and dreams.
                </BitAccordionListOption>
                <BitAccordionListOption Title="Advanced settings" Description="Filtering has been entirely disabled">
                    In the beginning, there is silence a blank canvas yearning to be filled, a quiet space where creativity waits to awaken.
                </BitAccordionListOption>
            </Options>
        </BitAccordionList>
    </div>
</DemoExample>

<DemoExample Title="Disabled & Read-only" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7" PreventRenderForMcpClient>
    <div>
        <code>IsEnabled="false"</code> greys an option out and takes it out of the tab order. <code>ReadOnly</code>
        keeps it focusable and in its colors but frozen (<code>aria-disabled</code>), and still raises
        <code>OnItemClick</code>. Both work for the whole list or per option.
    </div>
    <br />
    <BitAccordionList Multiple
                      DefaultExpandedKeys="@(["locked"])"
                      OnItemClick="(BitAccordionListOption option) => { if (option.ReadOnly is true) readOnlyClickCount++; }"
                      TItem="BitAccordionListOption">
        <BitAccordionListOption Key="normal" Title="General settings" Description="A live option">
            Once upon a time, stories wove connections between people, a symphony of voices crafting shared dreams.
        </BitAccordionListOption>
        <BitAccordionListOption Key="disabled" Title="Users" Description="Turned off altogether" IsEnabled="false">
            Every story starts with a blank canvas, a quiet space waiting to be filled with ideas, emotions, and dreams.
        </BitAccordionListOption>
        <BitAccordionListOption Key="locked" Title="Advanced settings" Description="Open on purpose and staying that way" ReadOnly="true">
            In the beginning, there is silence a blank canvas yearning to be filled, a quiet space where creativity waits to awaken.
        </BitAccordionListOption>
    </BitAccordionList>
    <br />
    <div>Clicks on the read-only header: <b>@readOnlyClickCount</b></div>
</DemoExample>

<DemoExample Title="Events" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8" PreventRenderForMcpClient>
    <div>
        <code>OnExpand</code>, <code>OnCollapse</code> and <code>OnToggle</code> report every option that moves,
        including the one single-expand mode closes. Each option can also have its own <code>OnClick</code>.
    </div>
    <br />
    <BitAccordionList OnExpand="(BitAccordionListOption option) => expandedTitle = option.Title"
                      OnCollapse="(BitAccordionListOption option) => collapsedTitle = option.Title"
                      OnToggle="(BitAccordionListOption option) => toggledTitle = option.Title"
                      TItem="BitAccordionListOption">
        <BitAccordionListOption Title="General settings" Description="The general settings of the application" OnClick="_ => { clickCounter++; StateHasChanged(); }">
            Once upon a time, stories wove connections between people, a symphony of voices crafting shared dreams.
        </BitAccordionListOption>
        <BitAccordionListOption Title="Users" Description="You are currently not an owner" OnClick="_ => { clickCounter++; StateHasChanged(); }">
            Every story starts with a blank canvas, a quiet space waiting to be filled with ideas, emotions, and dreams.
        </BitAccordionListOption>
        <BitAccordionListOption Title="Advanced settings" Description="Filtering has been entirely disabled" OnClick="_ => { clickCounter++; StateHasChanged(); }">
            In the beginning, there is silence a blank canvas yearning to be filled, a quiet space where creativity waits to awaken.
        </BitAccordionListOption>
    </BitAccordionList>
    <br />
    <div>Last expanded: <b>@expandedTitle</b></div>
    <div>Last collapsed: <b>@collapsedTitle</b></div>
    <div>Last toggled: <b>@toggledTitle</b></div>
    <div>Header clicks: <b>@clickCounter</b></div>
</DemoExample>

<DemoExample Title="Cancelling a toggle" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9" PreventRenderForMcpClient>
    <div>
        <code>OnToggling</code> runs before an option moves; set <code>Cancel</code> to keep it where it is, and read
        <code>Reason</code> for what asked. It is awaited, so it can confirm or load data first, while the header
        reports <code>aria-busy</code>.
    </div>
    <br />
    <BitCheckbox @bind-Value="lockToggling" Label="Refuse every toggle" />
    <BitCheckbox @bind-Value="slowToggling" Label="Take a second to decide" />
