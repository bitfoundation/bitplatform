            Once upon a time, stories wove connections between people, a symphony of voices crafting shared dreams.
        </BitAccordionListOption>
        <BitAccordionListOption Title="Users" Description="You are currently not an owner">
            Every story starts with a blank canvas, a quiet space waiting to be filled with ideas, emotions, and dreams.
        </BitAccordionListOption>
        <BitAccordionListOption Title="Advanced settings" Description="Filtering has been entirely disabled">
            In the beginning, there is silence a blank canvas yearning to be filled, a quiet space where creativity waits to awaken.
        </BitAccordionListOption>
    </BitAccordionList>
    <br />
    <div>Last request: <b>@togglingReport</b></div>
</DemoExample>

<DemoExample Title="Binding & methods" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10" PreventRenderForMcpClient>
    <div>
        <code>@@bind-ExpandedKey</code> and <code>@@bind-ExpandedKeys</code> hand the open state to the page.
        <code>Expand</code>, <code>Collapse</code>, <code>Toggle</code>, <code>ExpandAll</code> (Multiple only),
        <code>CollapseAll</code> and <code>FocusItem</code> drive it from code, and are not blocked by
        <code>ReadOnly</code> or <code>Collapsible</code>.
    </div>
    <br />
    <div class="example-content">
        <div>@@bind-ExpandedKey:</div>
        <BitButtonGroup Toggle Items="bindingButtons" TItem="BitButtonGroupItem" @bind-ToggleKey="boundExpandedKey" />
        <BitAccordionList @bind-ExpandedKey="boundExpandedKey" TItem="BitAccordionListOption">
            <BitAccordionListOption Key="general" Title="General settings" Description="The general settings of the application">
                Once upon a time, stories wove connections between people, a symphony of voices crafting shared dreams.
            </BitAccordionListOption>
            <BitAccordionListOption Key="users" Title="Users" Description="You are currently not an owner">
                Every story starts with a blank canvas, a quiet space waiting to be filled with ideas, emotions, and dreams.
            </BitAccordionListOption>
            <BitAccordionListOption Key="advanced" Title="Advanced settings" Description="Filtering has been entirely disabled">
                In the beginning, there is silence a blank canvas yearning to be filled, a quiet space where creativity waits to awaken.
            </BitAccordionListOption>
        </BitAccordionList>
    </div>
    <br /><br />
    <div class="example-content">
        <div>Methods &amp; @@bind-ExpandedKeys:</div>
        <BitStack Horizontal Wrap>
            <BitButton OnClick="@(() => accordionListRef!.ExpandAll())">Expand all</BitButton>
            <BitButton OnClick="@(() => accordionListRef!.CollapseAll())">Collapse all</BitButton>
            <BitButton OnClick="@(() => accordionListRef!.Toggle("users"))">Toggle Users</BitButton>
            <BitButton OnClick="@(() => accordionListRef!.FocusItem("advanced"))">Focus Advanced</BitButton>
        </BitStack>
        <BitAccordionList @ref="accordionListRef" Multiple @bind-ExpandedKeys="programmaticKeys" TItem="BitAccordionListOption">
            <BitAccordionListOption Key="general" Title="General settings" Description="The general settings of the application">
                Once upon a time, stories wove connections between people, a symphony of voices crafting shared dreams.
            </BitAccordionListOption>
            <BitAccordionListOption Key="users" Title="Users" Description="You are currently not an owner">
                Every story starts with a blank canvas, a quiet space waiting to be filled with ideas, emotions, and dreams.
            </BitAccordionListOption>
            <BitAccordionListOption Key="advanced" Title="Advanced settings" Description="Filtering has been entirely disabled">
                In the beginning, there is silence a blank canvas yearning to be filled, a quiet space where creativity waits to awaken.
            </BitAccordionListOption>
        </BitAccordionList>
        <div>Expanded keys: <b>@string.Join(", ", programmaticKeys)</b></div>
    </div>
</DemoExample>

<DemoExample Title="Content rendering" RazorCode="@example11RazorCode" Id="example11" PreventRenderForMcpClient>
    <div>
        Panels render up front by default. <code>LazyContent</code> renders a panel on its first open and keeps it;
        <code>UnmountOnCollapse</code> removes it again on every close. Watch the timestamps.
    </div>
    <br />
    <div class="example-content">
        <div>LazyContent:</div>
        <BitAccordionList Multiple LazyContent TItem="BitAccordionListOption">
            <BitAccordionListOption Title="Lazy panel" Description="Rendered on its first open, and kept afterwards">
                This panel was rendered at @DateTime.Now.ToString("HH:mm:ss.fff")
            </BitAccordionListOption>
        </BitAccordionList>
    </div>
    <br /><br />
    <div class="example-content">
        <div>UnmountOnCollapse:</div>
        <BitAccordionList Multiple UnmountOnCollapse TItem="BitAccordionListOption">
            <BitAccordionListOption Title="Unmounted panel" Description="Rendered again on every open">
                This panel was rendered at @DateTime.Now.ToString("HH:mm:ss.fff")
            </BitAccordionListOption>
        </BitAccordionList>
    </div>
</DemoExample>

