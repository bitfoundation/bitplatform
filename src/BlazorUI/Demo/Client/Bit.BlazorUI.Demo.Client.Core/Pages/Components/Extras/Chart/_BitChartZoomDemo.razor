@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Decimated line (zoom + pan)" RazorCode="@decimationRazorCode" CsharpCode="@decimationCsharpCode" Id="zoom-decimation">
    <div class="example-desc">
        Scroll to zoom X, drag to pan, double-click to reset; on touch, drag with one finger and pinch with two.
        With the plot focused, <b>+</b> / <b>-</b> zoom and <b>0</b> resets. The @(_count.ToString("N0"))-point
        series is LTTB-downsampled to @_samples points, keeping its peaks.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="_data" Options="_options" /></div></div>
</DemoExample>

<DemoExample Title="Zoom both axes" RazorCode="@xyRazorCode" CsharpCode="@xyCsharpCode" Id="zoom-xy" PreventRenderForMcpClient>
    <div class="example-desc">
        <code>Mode = XY</code> zooms and pans both axes. Modes name screen directions, not axis ids: <code>X</code>
        is the axis across the plot. <code>LimitToData</code> keeps the view inside the series;
        <code>MinRangeFraction</code> limits how far it zooms in.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Scatter" Data="Scatter()" Options="_xy" /></div></div>
</DemoExample>

<DemoExample Title="Drag-to-zoom box" RazorCode="@dragRazorCode" CsharpCode="@dragCsharpCode" Id="zoom-drag">
    <div class="example-desc">
        <code>DragZoom</code> makes dragging select a rectangle to zoom into instead of panning. Double-click or
        <code>ResetZoom()</code> resets, <code>ZoomTo(axisId, min, max)</code> zooms from code and
        <code>OnZoomChange</code> reports every change.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Scatter" Data="Scatter()" Options="_drag" /></div></div>
</DemoExample>

<DemoExample Title="Category-axis zoom" RazorCode="@catZoomRazorCode" CsharpCode="@catZoomCsharpCode" Id="zoom-category">
    <div class="example-desc">
        Category axes zoom too: the visible window is a range of indexes, here a handful of the 40 categories at a
        time.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="ManyBars()" Options="_catZoom" /></div></div>
</DemoExample>

<DemoExample Title="Overview and detail" RazorCode="@brushRazorCode" CsharpCode="@brushCsharpCode" Id="zoom-brush">
    <div class="example-desc">
        Overview and detail from the zoom API: a <code>Sparkline</code> below shows the whole series,
        <code>ZoomTo</code> moves the top chart's window, and <code>GetAxisRange</code> and
        <code>OnZoomChange</code> report it. Drag, scroll or use the buttons.
    </div>
    <div class="buttons-container" style="gap:.5rem">
        <BitButton Variant="BitVariant.Outline" OnClick="() => ShowWindow(0, 0.25)">First quarter</BitButton>
        <BitButton Variant="BitVariant.Outline" OnClick="() => ShowWindow(0.375, 0.625)">Middle</BitButton>
        <BitButton Variant="BitVariant.Outline" OnClick="() => ShowWindow(0.75, 1)">Last quarter</BitButton>
        <BitButton Variant="BitVariant.Outline" OnClick="() => _brush?.ResetZoom()">Whole series</BitButton>
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart @ref="_brush" Type="BitChartType.Line" Data="_brushData" Options="_brushOptions" OnZoomChange="ReadWindow" /></div></div>
    <div class="brush-readout">Showing @_window</div>
    <BitChart Type="BitChartType.Line" Data="_brushData" Options="_overview" Height="56px" />
</DemoExample>
