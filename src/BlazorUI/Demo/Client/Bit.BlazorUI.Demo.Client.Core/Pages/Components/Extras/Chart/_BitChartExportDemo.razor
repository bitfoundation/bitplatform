@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Download the chart" RazorCode="@exportRazorCode" CsharpCode="@exportCsharpCode" Id="export-download">
    <div class="example-desc">
        Because the chart is a live SVG element, it can hand itself over as a file. Capture the component with
        <code>@@ref</code> and call <code>ExportSvgAsync</code> for a vector file (theme tokens are resolved into
        it so it looks right outside the app), <code>ExportPngAsync</code> for a raster image at the pixel ratio
        you pass, or <code>ExportCsvAsync</code> for the underlying values &mdash; formatted with the chart's culture.
    </div>
    <div class="buttons-container" style="gap:.5rem">
        <BitButton Variant="BitVariant.Outline" OnClick="ExportSvg">Download SVG</BitButton>
        <BitButton Variant="BitVariant.Outline" OnClick="ExportPng">Download PNG</BitButton>
        <BitButton Variant="BitVariant.Outline" OnClick="ExportCsv">Download CSV</BitButton>
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart @ref="_chart" RespectReducedMotion="false" Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="_options" /></div></div>
</DemoExample>

<DemoExample Title="The CSV without downloading it" RazorCode="@csvRazorCode" CsharpCode="@csvCsharpCode" Id="export-csv-text">
    <div class="example-desc">
        <code>ToCsv()</code> returns the same text the CSV export writes, so you can post it to a server, put it on
        the clipboard, or show it &mdash; as here. Value datasets become one row per series with a column per label;
        scatter and bubble datasets become one row per point.
    </div>
    <div class="buttons-container">
        <BitButton Variant="BitVariant.Outline" OnClick="ShowCsv">Show the CSV</BitButton>
    </div>
    @if (_csv is not null)
    {
        <pre class="csv-preview">@_csv</pre>
    }
    <div class="chart-wrapper"><div class="chart-container"><BitChart @ref="_csvChart" RespectReducedMotion="false" Type="BitChartType.Line" Data="BitChartSampleData.MonthlySales()" Options="_options" /></div></div>
</DemoExample>
