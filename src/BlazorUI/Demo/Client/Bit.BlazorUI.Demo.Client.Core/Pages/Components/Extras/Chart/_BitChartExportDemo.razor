@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Download the chart" RazorCode="@exportRazorCode" CsharpCode="@exportCsharpCode" Id="export-download">
    <div class="example-desc">
        Capture the chart with <code>@@ref</code> and call <code>ExportSvgAsync</code> (vector, theme tokens
        resolved), <code>ExportPngAsync</code> (raster at the pixel ratio you pass, on the chart's own surface so a dark theme
        exports dark) or <code>ExportCsvAsync</code>
        (values in the chart's culture, with a byte order mark so non-Latin labels open correctly in spreadsheets).
    </div>
    <div class="buttons-container" style="gap:.5rem">
        <BitButton Variant="BitVariant.Outline" OnClick="ExportSvg">Download SVG</BitButton>
        <BitButton Variant="BitVariant.Outline" OnClick="ExportPng">Download PNG</BitButton>
        <BitButton Variant="BitVariant.Outline" OnClick="ExportCsv">Download CSV</BitButton>
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart @ref="_chart" Type="BitChartType.Bar" Data="BitChartSampleData.Revenue()" Options="_options" /></div></div>
</DemoExample>

<DemoExample Title="The CSV without downloading it" RazorCode="@csvRazorCode" CsharpCode="@csvCsharpCode" Id="export-csv-text">
    <div class="example-desc">
        <code>ToCsv()</code> returns the CSV export's text without downloading it. Value datasets become one row
        per series with a column per label; scatter and bubble datasets one row per point.
    </div>
    <div class="buttons-container">
        <BitButton Variant="BitVariant.Outline" OnClick="ShowCsv">Show the CSV</BitButton>
    </div>
    @if (_csv is not null)
    {
        <pre class="csv-preview">@_csv</pre>
    }
    <div class="chart-wrapper"><div class="chart-container"><BitChart @ref="_csvChart" Type="BitChartType.Line" Data="BitChartSampleData.MonthlySales()" Options="_options" /></div></div>
</DemoExample>

<DemoExample Title="The picture without downloading it" RazorCode="@imageRazorCode" CsharpCode="@imageCsharpCode" Id="export-image">
    <div class="example-desc">
        <code>ToSvgStringAsync()</code> returns the SVG download's standalone markup and
        <code>ToBase64ImageAsync()</code> its raster picture as a <code>data:</code> URL, without touching the file
        system - e.g. for an <code>img</code> tag, as below.
    </div>
    <div class="buttons-container" style="gap:.5rem">
        <BitButton Variant="BitVariant.Outline" OnClick="ShowImage">Render to a data URL</BitButton>
        <BitButton Variant="BitVariant.Outline" OnClick="ShowMarkup">Show the SVG markup</BitButton>
    </div>
    @if (_dataUrl is not null)
    {
        <div class="buttons-container"><img class="chart-snapshot" src="@_dataUrl" alt="A snapshot of the chart" /></div>
    }
    @if (_markup is not null)
    {
        <pre class="csv-preview">@_markup</pre>
    }
    <div class="chart-wrapper"><div class="chart-container"><BitChart @ref="_imageChart" Type="BitChartType.Doughnut" Data="BitChartSampleData.Traffic()" Options="_imageOptions" /></div></div>
</DemoExample>
