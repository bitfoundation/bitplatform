@namespace Bit.BlazorUI.Demo.Client.Core.Pages.Components.Extras.Chart

<DemoExample Title="Linear regression" RazorCode="@linearRazorCode" CsharpCode="@linearCsharpCode" Id="trendlines-linear">
    <div class="example-desc">
        <code>BitChartTrendlinePlugin</code> fits a line through a dataset and draws it over the chart. The default
        <code>Linear</code> kind is a least-squares regression, dashed and in the dataset's color unless set
        otherwise.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Bar" Data="Noisy()" Options="_linear" /></div></div>
</DemoExample>

<DemoExample Title="Projected across the plot" RazorCode="@extendRazorCode" CsharpCode="@extendCsharpCode" Id="trendlines-extend">
    <div class="example-desc">
        <code>Extend</code> continues the fitted line to both plot edges instead of stopping at the first and last
        point; a <code>Label</code> adds a named pill at its end.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Noisy()" Options="_extended" /></div></div>
</DemoExample>

<DemoExample Title="Moving average and the mean" RazorCode="@averagesRazorCode" CsharpCode="@averagesCsharpCode" Id="trendlines-averages">
    <div class="example-desc">
        <code>MovingAverage</code> smooths over a trailing <code>Period</code> window and <code>Average</code>
        draws a flat line at the mean. Each trend line binds to its dataset by <code>DatasetIndex</code>, so
        several can share a chart.
    </div>
    <div class="chart-wrapper"><div class="chart-container"><BitChart Type="BitChartType.Line" Data="Seasonal()" Options="_averages" /></div></div>
</DemoExample>
