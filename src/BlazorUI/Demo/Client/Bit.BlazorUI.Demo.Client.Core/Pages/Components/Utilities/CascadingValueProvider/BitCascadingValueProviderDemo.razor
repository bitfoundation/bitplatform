@page "/components/cascadingvalueprovider"

<PageOutlet Url="components/cascadingvalueprovider"
            Title="CascadingValueProvider"
            Description="BitCascadingValueProvider cascades any number of typed or named values to its descendant components from one flat list, instead of a stack of nested CascadingValue components." />

<DemoPage Name="CascadingValueProvider"
          Description="Replaces a stack of nested CascadingValue components with one flat list. Each value is cascaded by its type or by a name, a later value shadows an earlier one of the same type and name, and changing a value refreshes only the components that consume it."
          Notes="Every value renders a real CascadingValue, so consumers match by type and name exactly as they do with a hand-written one, and the provider adds no markup of its own. For a value the whole app needs, prefer a root-level cascading value (AddCascadingValue on the service collection)."
          Parameters="componentParameters"
          SubClasses="componentSubClasses"
          GitHubUrl="../Utils/Params/BitCascadingValueProvider.cs"
          GitHubDemoUrl="Utilities/CascadingValueProvider/BitCascadingValueProviderDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" CodeFiles="@example1CodeFiles" Id="example1">
        <div>
            Each item of <b>Values</b> becomes a <b>CascadingValue</b> around the child content. A bare value is cascaded by
            its type and a <b>(value, name)</b> tuple by its name; the consumer reads them with plain <b>[CascadingParameter]</b>
            properties.
        </div>

        <br /><br />

        <BitCascadingValueProvider
            Values="@([
                        ("Light", "Theme"),
                        (true, "IsAuthenticated"),
                        ((2) as int?, "NotificationCount"),
                        new(new CascadingDemoUser("Saleh Xafan", "CTO"), "NamedUser"),
                        new(new CascadingDemoUser("Yaser Moradi", "CEO"))
                    ])">
            <CascadingValueDemoConsumer />
        </BitCascadingValueProvider>
    </DemoExample>

    <DemoExample Title="Live values" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" CodeFiles="@example2CodeFiles" Id="example2">
        <div>
            Build <b>Values</b> from state and every render pushes the current values down. Only the consumers of a value that
            actually changed re-render.
        </div>

        <br /><br />

        <BitButton OnClick="() => currentTheme = nextTheme">Switch to @nextTheme theme</BitButton>
        <BitButton OnClick="() => notificationCount++">Add notification (@notificationCount)</BitButton>
        <br /><br />
        <BitToggle @bind-Value="isAuthenticated" Text="Authenticated user" />
        <br />
        <BitTextField @bind-Value="userName" Label="UserName:" Immediate DebounceTime="300" />
        <BitTextField @bind-Value="userRole" Label="UserRole:" Immediate DebounceTime="300" />

        <br /><br />

        <BitCascadingValueProvider Values="values">
            <CascadingValueDemoConsumer Title="Changing cascading values:" />
        </BitCascadingValueProvider>
    </DemoExample>

    <DemoExample Title="ValueList" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" CodeFiles="@example3CodeFiles" Id="example3">
        <div>
            A <b>BitCascadingValueList</b> captures the static type of each value through <b>Add&lt;T&gt;</b>, so a null or a
            nullable value is cascaded as the type it is declared with, and it can be revised in place with <b>Set</b>,
            <b>Remove</b>, <b>Contains</b> and <b>Find</b>. With both parameters set, <b>ValueList</b> is provided first and
            <b>Values</b> wins a conflict: defaults plus overrides.
        </div>

        <br /><br />

        <BitButton OnClick="SetListNotificationCount">Set NotificationCount (@listNotificationCount)</BitButton>
        <BitButton OnClick="ToggleListUser">@(listValues.Contains<CascadingDemoUser>() ? "Remove" : "Add") the typed user</BitButton>

        <br /><br />

        <BitCascadingValueProvider ValueList="listValues" Values="@([("Dark", "Theme")])">
            <CascadingValueDemoConsumer Title="ValueList defaults, Theme overridden by Values:" />
        </BitCascadingValueProvider>
    </DemoExample>

    <DemoExample Title="Nesting" RazorCode="@example4RazorCode" CodeFiles="@example4CodeFiles" Id="example4">
        <div>
            An inner provider overrides only the types and names it redefines; everything else keeps flowing down from the
            outer one.
        </div>

        <br /><br />

        <BitCascadingValueProvider
            Values="@([
                        ("Light", "Theme"),
                        ((7) as int?, "NotificationCount"),
                        new(new CascadingDemoUser("Ava Smith", "Product manager"))
                    ])">
            <CascadingValueDemoConsumer Title="Outer provider:" />

            <br />

            <BitCascadingValueProvider Values="@([("Dark", "Theme")])">
                <CascadingValueDemoConsumer Title="Inner provider (only Theme is overridden):" />
            </BitCascadingValueProvider>
        </BitCascadingValueProvider>
    </DemoExample>

    <DemoExample Title="ValueType" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" CodeFiles="@example5CodeFiles" Id="example5">
        <div>
            <b>ValueType</b> decides which cascading parameters a value reaches and defaults to the value's runtime type. Pass
            it explicitly with <b>new(value, typeof(T))</b>, or use <b>BitCascadingValue.From&lt;T&gt;</b>, to cascade a value as a
            nullable, base or interface type. Cascading null under the same type clears an outer value for a subtree.
        </div>

        <br /><br />

        <BitCascadingValueProvider Values="@([new(5, typeof(int?))])">
            <CascadingValueDemoTypeConsumer Title="Outer provider cascades 5 as int?: " />

            <BitCascadingValueProvider Values="nullCountValues">
                <CascadingValueDemoTypeConsumer Title="Inner provider cascades null as the same int?: " />
            </BitCascadingValueProvider>
        </BitCascadingValueProvider>
    </DemoExample>

    <DemoExample Title="IsFixed & Enabled" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" CodeFiles="@example6CodeFiles" Id="example6">
        <div>
            <b>IsFixed</b>, or the <b>Fixed&lt;T&gt;</b> factory, marks a value that never changes, so its consumers skip change
            tracking. <b>Enabled</b> set to false drops a value as if it had never been added, so an outer value of the same
            type or name shows through again.
        </div>

        <br /><br />

        <BitToggle @bind-Value="provideTheme" Text="Provide the Theme value" />
        <BitToggle @bind-Value="provideUser" Text="Provide the typed user value" />

        <br />

        <BitCascadingValueProvider Values="flagValues">
            <CascadingValueDemoConsumer Title="Fixed and conditional cascading values:" />
        </BitCascadingValueProvider>
    </DemoExample>

    <DemoExample Title="Change notifications" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" CodeFiles="@example7CodeFiles" Id="example7">
        <div>
            The provider listens to every <b>BitCascadingValue</b> it holds: assigning <b>Value</b> refreshes the consumers,
            <b>NotifyChangedAsync(newValue)</b> does the same and waits for the render, and <b>NotifyChanged()</b> or
            <b>NotifyChangedAsync()</b> pushes an object that was mutated in place. It works from any thread, with no
            <b>StateHasChanged</b> call on the page.
        </div>

        <br /><br />

        <BitButton OnClick="RunBackgroundJob">Run a background job</BitButton>

        <br /><br />

        <BitCascadingValueProvider Values="notifyingValues">
            <CascadingValueDemoStatusConsumer Title="Self-refreshing cascading values:" />
        </BitCascadingValueProvider>
    </DemoExample>

    <DemoExample Title="AutoNotify" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" CodeFiles="@example8CodeFiles" Id="example8">
        <div>
            <b>Observed&lt;T&gt;</b> turns <b>AutoNotify</b> on: an <b>INotifyPropertyChanged</b> or <b>INotifyCollectionChanged</b>
            value is watched and refreshes the consumers on each change, and the watch is dropped once no provider listens. The
            job below never calls <b>NotifyChanged</b>.
        </div>

        <br /><br />

        <BitButton OnClick="RunObservableJob">Run a background job</BitButton>

        <br /><br />

        <BitCascadingValueProvider Values="observableValues">
            <CascadingValueDemoObservableConsumer Title="Self-watching cascading values:" />
        </BitCascadingValueProvider>
    </DemoExample>

    <DemoExample Title="Lazy & computed values" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" CodeFiles="@example9CodeFiles" Id="example9">
        <div>
            <b>Lazy&lt;T&gt;</b> runs its factory once, the first time the value is provided, so a disabled or shadowed value is
            never built; <b>IsValueCreated</b> reports whether it has run. <b>Computed&lt;T&gt;</b> re-runs its factory on every
            render, so a list built once still tracks the state it reads. Click the button: Theme and Notifications follow
            it, the lazy factory count does not.
        </div>

        <br /><br />

        <BitToggle @bind-Value="provideLazyNamedUser" Text="Provide the lazy named user" />
        <BitButton OnClick="() => computedClicks++">Click me (@computedClicks)</BitButton>

        <br /><br />

        <BitCascadingValueProvider Values="factoryValues">
            <CascadingValueDemoConsumer Title="Lazy and computed cascading values:" />
            <br />
            <div>Lazy factory runs so far: <b>@lazyUserFactoryCalls</b></div>
        </BitCascadingValueProvider>
    </DemoExample>
</DemoPage>
