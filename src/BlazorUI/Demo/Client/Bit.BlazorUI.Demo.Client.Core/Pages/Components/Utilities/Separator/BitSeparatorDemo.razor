@page "/components/separator"

<PageOutlet Url="components/separator"
            Title="Separator"
            Description="A Separator is a component that visually separates content into groups, as a horizontal or vertical line that can carry a label and is restyled through the theme." />

<DemoPage Name="Separator"
          SecondaryNames="@(["Divider"])"
          Description="BitSeparator splits content into groups with a horizontal or vertical line. Content given to it - a label, an icon - sits between the two segments of the line, so it reads on any surface, and names the separator to screen readers. It is restyled through its parameters, its public CSS variables or a BitParams cascade."
          Notes="A separator is announced by screen readers, so mark a purely visual one Decorative. Its content is presentational: keep links and buttons out of it. Between the items of a list or a menu, render it as one with Element='li'."
          Parameters="componentParameters"
          CssVariables="componentCssVariables"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          GitHubUrl="Utilities/Separator/BitSeparator.cs"
          GitHubDemoUrl="Utilities/Separator/BitSeparatorDemo.razor">

    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>
            A hairline across the full width of its container. Content - text, an icon, any markup - sits between the two
            segments of the line. <b>IsEnabled</b> false dims it with the group it stands in.
        </div>
        <br />
        <div class="example-content">
            <BitSeparator />
            <BitSeparator>Text</BitSeparator>
            <BitSeparator><BitIcon IconName="@BitIconName.Clock" /></BitSeparator>
            <BitSeparator IsEnabled="false">Disabled</BitSeparator>
        </div>
    </DemoExample>

    <DemoExample Title="Vertical" RazorCode="@example2RazorCode" Id="example2">
        <div>
            <b>Vertical</b> stands the line up between items side by side. In a flex row it stretches to the height of the
            row; anywhere else its container needs a height.
        </div>
        <br />
        <div class="example-content">
            <div class="row">
                <span>Item 1</span>
                <BitSeparator Vertical />
                <span>Item 2</span>
                <BitSeparator Vertical />
                <span>Item 3</span>
            </div>
            <div class="row medium">
                <span>Sign in with a password</span>
                <BitSeparator Vertical>OR</BitSeparator>
                <span>Sign in with a passkey</span>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Content alignment" RazorCode="@example3RazorCode" Id="example3">
        <div>
            <b>AlignContent</b> puts the content at the start, the middle or the end of the line - the top or the bottom of a
            vertical one; start and end follow the reading direction. <b>ContentOffset</b> pushes start or end content off
            the edge by any CSS length, where a percentage is of the length of the line.
        </div>
        <br />
        <div class="example-content">
            <BitSeparator AlignContent="BitSeparatorAlignContent.Start">Start</BitSeparator>
            <BitSeparator AlignContent="BitSeparatorAlignContent.Center">Center</BitSeparator>
            <BitSeparator AlignContent="BitSeparatorAlignContent.End">End</BitSeparator>
            <BitSeparator AlignContent="BitSeparatorAlignContent.Start" ContentOffset="2rem">Start, 2rem</BitSeparator>
            <BitSeparator AlignContent="BitSeparatorAlignContent.End" ContentOffset="10%">End, 10%</BitSeparator>
            <div class="row taller">
                <BitSeparator Vertical AlignContent="BitSeparatorAlignContent.Start">Start</BitSeparator>
                <BitSeparator Vertical AlignContent="BitSeparatorAlignContent.Center">Center</BitSeparator>
                <BitSeparator Vertical AlignContent="BitSeparatorAlignContent.End">End</BitSeparator>
                <BitSeparator Vertical AlignContent="BitSeparatorAlignContent.Start" ContentOffset="25%">25%</BitSeparator>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Length" RazorCode="@example4RazorCode" Id="example4">
        <div>
            <b>Inset</b> holds the line off both ends of its container by any CSS length, or off the start and the end given
            two. <b>AutoSize</b> drops the full width (the stretch of a vertical one) and lets the container size the
            separator, so a margin fits inside it instead of overflowing it.
        </div>
        <br />
        <div class="example-content">
            <BitSeparator>Full length</BitSeparator>
            <BitSeparator Inset="2rem">Inset 2rem</BitSeparator>
            <BitSeparator Inset="25% 0">Inset 25% at the start</BitSeparator>
            <div class="row tall">
                <span>Item 1</span>
                <BitSeparator Vertical />
                <span>Item 2</span>
                <BitSeparator Vertical Inset="0.75rem" />
                <span>Item 3</span>
            </div>
            <BitSeparator AutoSize Style="margin-inline: 4rem">AutoSize, with a margin</BitSeparator>
        </div>
    </DemoExample>

    <DemoExample Title="Line" RazorCode="@example5RazorCode" Id="example5">
        <div>
            <b>LineStyle</b> draws the line solid, dashed, dotted or double, and <b>Thickness</b> sets its weight as any CSS
            length. Dots and the gap of a double line need a few pixels of room.
        </div>
        <br />
        <div class="example-content">
            <BitSeparator LineStyle="BitSeparatorLineStyle.Solid">Solid</BitSeparator>
            <BitSeparator LineStyle="BitSeparatorLineStyle.Dashed">Dashed</BitSeparator>
            <BitSeparator LineStyle="BitSeparatorLineStyle.Dotted" Thickness="3px">Dotted, 3px</BitSeparator>
            <BitSeparator LineStyle="BitSeparatorLineStyle.Double" Thickness="4px">Double, 4px</BitSeparator>
            <BitSeparator Thickness="0.5rem">Solid, 0.5rem</BitSeparator>
            <div class="row tall">
                <span>Item 1</span>
                <BitSeparator Vertical LineStyle="BitSeparatorLineStyle.Dashed" />
                <span>Item 2</span>
                <BitSeparator Vertical LineStyle="BitSeparatorLineStyle.Dotted" Thickness="3px" />
                <span>Item 3</span>
                <BitSeparator Vertical LineStyle="BitSeparatorLineStyle.Double" Thickness="4px" />
                <span>Item 4</span>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Lists & menus" RazorCode="@example6RazorCode" Id="example6">
        <div>
            A list may only hold its items, so <b>Element</b> <b>li</b> makes the separator one. It is still announced as a
            separator, not counted as an item. A tag that cannot hold content, such as <b>hr</b>, falls back to <b>div</b>.
        </div>
        <br />
        <div class="example-content">
            <ul class="list" aria-label="Contacts">
                <li><BitPersona PrimaryText="Annie Lindqvist" Size="BitPersonaSize.Size32" /></li>
                <BitSeparator Element="li" Inset="2.5rem 0" />
                <li><BitPersona PrimaryText="Aaron Reid" Size="BitPersonaSize.Size32" /></li>
                <BitSeparator Element="li" Inset="2.5rem 0" />
                <li><BitPersona PrimaryText="Alex Lundberg" Size="BitPersonaSize.Size32" /></li>
            </ul>
        </div>
    </DemoExample>

    <DemoExample Title="Accessibility" RazorCode="@example7RazorCode" Id="example7">
        <div>
            A separator has the <b>separator</b> role, named by its content or by <b>AriaLabel</b>; a vertical one also says
            so through <b>aria-orientation</b>. <b>Decorative</b> takes a purely visual one out of the accessibility tree,
            its content then read as plain text. The content is presentational, so keep focusable elements out of it.
        </div>
        <br />
        <div class="example-content">
            <BitSeparator>Named by its content</BitSeparator>
            <BitSeparator AriaLabel="End of the shipping details" />
            <BitSeparator Decorative />
            <BitSeparator Decorative>Read as plain text</BitSeparator>
        </div>
    </DemoExample>

    <DemoExample Title="CSS variables" RazorCode="@example8RazorCode" Id="example8">
        <div>
            The public <b>--bit-Separator-*</b> variables inherit, so one set on <b>:root</b> or a container restyles every
            separator inside it, and one set in <b>Style</b> restyles that separator. A parameter wins over its variable.
        </div>
        <br />
        <div class="example-content">
            <div style="--bit-Separator-color: var(--bit-clr-pri); --bit-Separator-line-style: dashed; --bit-Separator-content-color: var(--bit-clr-fg-sec); --bit-Separator-content-font-size: 0.75rem;">
                <BitSeparator>Set on the container</BitSeparator>
                <BitSeparator AlignContent="BitSeparatorAlignContent.Start">for every separator inside it</BitSeparator>
                <BitSeparator Color="BitColor.Error">Color wins over the variable</BitSeparator>
            </div>
            <BitSeparator Style="--bit-Separator-thickness: 4px; --bit-Separator-spacing: 1rem; --bit-Separator-content-gap: 0.25rem; --bit-Separator-content-font-weight: 600;">
                Set on one separator
            </BitSeparator>
        </div>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
        <div>
            <b>BitParams</b> with a <b>BitSeparatorParams</b> sets defaults for every separator under it; a separator's own
            value wins (the last one keeps its own <b>Color</b> and <b>LineStyle</b>). The content is not cascaded.
        </div>
        <br />
        <div class="example-content">
            <BitParams Parameters="separatorParams">
                <BitSeparator>Account</BitSeparator>
                <BitSeparator>Billing</BitSeparator>
                <BitSeparator Color="BitColor.Error" LineStyle="BitSeparatorLineStyle.Solid">Danger zone</BitSeparator>
            </BitParams>
        </div>
    </DemoExample>

    <DemoExample Title="Color" RazorCode="@example10RazorCode" Id="example10">
        <div>
            <b>Color</b> paints the line in a role of the theme. <b>Border</b> picks a neutral border tier instead, and
            <b>Color</b> wins where both are set. <b>Background</b> paints behind the content, which is transparent by default.
        </div>
        <br />
        <div class="example-content">
            <BitSeparator Color="BitColor.Primary">Primary</BitSeparator>
            <BitSeparator Color="BitColor.Secondary">Secondary</BitSeparator>
            <BitSeparator Color="BitColor.Tertiary">Tertiary</BitSeparator>
            <BitSeparator Color="BitColor.Info">Info</BitSeparator>
            <BitSeparator Color="BitColor.Success">Success</BitSeparator>
            <BitSeparator Color="BitColor.Warning">Warning</BitSeparator>
            <BitSeparator Color="BitColor.SevereWarning">SevereWarning</BitSeparator>
            <BitSeparator Color="BitColor.Error">Error</BitSeparator>
            <br />
            <BitSeparator Border="BitColorKind.Primary">Primary border</BitSeparator>
            <BitSeparator Border="BitColorKind.Secondary">Secondary border</BitSeparator>
            <BitSeparator Border="BitColorKind.Tertiary">Tertiary border</BitSeparator>
            <BitSeparator Border="BitColorKind.Transparent">Transparent border</BitSeparator>
            <br />
            <BitSeparator Background="BitColorKind.Primary">Primary background</BitSeparator>
            <BitSeparator Background="BitColorKind.Secondary">Secondary background</BitSeparator>
            <BitSeparator Background="BitColorKind.Tertiary">Tertiary background</BitSeparator>
            <BitSeparator Background="BitColorKind.Transparent">Transparent background</BitSeparator>
        </div>
    </DemoExample>

    <DemoExample Title="Size" RazorCode="@example11RazorCode" Id="example11">
        <div>
            <b>Size</b> steps the weight of the line up from the theme's divider hairline. <b>Thickness</b> wins over it.
        </div>
        <br />
        <div class="example-content">
            <BitSeparator Size="BitSize.Small">Small</BitSeparator>
            <BitSeparator Size="BitSize.Medium">Medium</BitSeparator>
            <BitSeparator Size="BitSize.Large">Large</BitSeparator>
            <div class="row tall">
                <span>Small</span>
                <BitSeparator Vertical Size="BitSize.Small" />
                <span>Medium</span>
                <BitSeparator Vertical Size="BitSize.Medium" />
                <span>Large</span>
                <BitSeparator Vertical Size="BitSize.Large" />
                <span>Item</span>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Style & Class" RazorCode="@example12RazorCode" Id="example12">
        <div>
            <b>Style</b> and <b>Class</b> land on the root; <b>Styles</b> and <b>Classes</b> reach its parts: <b>Root</b> and
            <b>Content</b>. The line is the <b>::before</b> and <b>::after</b> of the root, which the class below turns into
            one gradient.
        </div>
        <br />
        <div class="example-content">
            <BitSeparator Style="max-width: 20rem; margin: auto;">Styled</BitSeparator>
            <BitSeparator Class="custom-class">Classed</BitSeparator>
            <BitSeparator Styles="@(new() { Root = "text-transform: uppercase;", Content = "color: dodgerblue; font-weight: 600;" })">
                Styles
            </BitSeparator>
            <BitSeparator Classes="@(new() { Content = "custom-content" })">Classes</BitSeparator>
        </div>
    </DemoExample>

    <DemoExample Title="RTL" RazorCode="@example13RazorCode" Id="example13">
        <div>
            <b>Dir</b> set to <b>BitDir.Rtl</b> lays the separator out right to left, so start-aligned content sits on the right.
        </div>
        <br />
        <div class="example-content">
            <BitSeparator Dir="BitDir.Rtl">جداکننده</BitSeparator>
            <BitSeparator Dir="BitDir.Rtl" AlignContent="BitSeparatorAlignContent.Start">ابتدا</BitSeparator>
            <BitSeparator Dir="BitDir.Rtl" AlignContent="BitSeparatorAlignContent.End">انتها</BitSeparator>
        </div>
    </DemoExample>
</DemoPage>
