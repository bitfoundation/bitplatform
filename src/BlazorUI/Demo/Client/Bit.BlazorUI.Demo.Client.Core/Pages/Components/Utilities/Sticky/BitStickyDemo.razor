    <DemoExample Title="Accessibility" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
        <div>
            A pinned bar covers what scrolls under it, focused controls included (WCAG 2.4.11). <b>ScrollPadding</b> reserves
            its size and offset as the container's scroll padding, so tabbing up and down the links below never leaves the
            focus behind the bar - turn it off to compare. Stickies sharing a container keep the largest claim per edge.
            A named <code>div</code> or <code>span</code> (<b>AriaLabel</b>, <code>aria-labelledby</code>) is announced as a
            <code>group</code>, since a generic element cannot carry a name.
        </div>
        <br />
        <BitToggle @bind-Value="reservesScrollPadding" Text="ScrollPadding" />
        <div class="vertical-container">
            <BitSticky Class="sticky" AriaLabel="Reading list" ScrollPadding="reservesScrollPadding">Reading list</BitSticky>
            <div class="link-list">
                @foreach (var person in people)
                {
                    <BitLink Href="@($"https://en.wikipedia.org/wiki/{person.Name.Replace(' ', '_')}")">@person.Name</BitLink>
                }
            </div>
        </div>
    </DemoExample>

