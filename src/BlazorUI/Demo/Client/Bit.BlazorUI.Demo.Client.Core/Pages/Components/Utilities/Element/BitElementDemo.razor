@page "/components/element"

<PageOutlet Url="components/element"
            Title="Element"
            Description="Renders any HTML tag - an anchor, a button, an input, an SVG shape or a custom element - with the styling, attribute, direction and state parameters of the bit BlazorUI." />

<DemoPage Name="Element"
          Description="BitElement renders whatever tag the Element parameter names - a div by default, or an anchor, a button, an input, an SVG shape, a custom element - with the parameters every bit BlazorUI component takes. Anything that is not a parameter is splatted onto the tag, void elements hold no content, disabling follows what the tag supports, NoWrapper drops the tag and keeps the content, and the stopPropagation / preventDefault modifiers Razor only allows on plain elements are parameters here."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          CssVariables="componentCssVariables"
          GitHubUrl="Utilities/Element/BitElement.cs"
          GitHubDemoUrl="Utilities/Element/BitElementDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div class="example-desc">
            With no parameters the element is a <code>div</code>. <b>Element</b> names any other tag and is used as
            written. A value that is not a valid tag name (whitespace, a <code>&lt;</code>, other symbols) falls back to
            the <code>div</code> instead of reaching the markup.
        </div>
        <div class="example-content">
            <BitElement>The default element (div)</BitElement>
            <BitElement Element="h4">A heading (h4)</BitElement>
            <BitElement Element="p">A paragraph (p) with a <BitElement Element="mark">highlighted (mark)</BitElement> word.</BitElement>
            <BitElement Element="blockquote">A quotation (blockquote)</BitElement>
            <BitElement Element="not a tag name">An invalid tag name falls back to a div.</BitElement>
        </div>
    </DemoExample>

    <DemoExample Title="SVG & custom elements" RazorCode="@example2RazorCode" Id="example2">
        <div class="example-desc">
            The tag's case is kept, so case-sensitive SVG names (<code>linearGradient</code>, <code>clipPath</code>) work
            inside an <code>svg</code>. A custom element (any name with a dash) passes through untouched.
        </div>
        <div class="example-content">
            <BitElement Element="svg" width="160" height="48" viewBox="0 0 160 48" role="img" AriaLabel="A gradient bar">
                <BitElement Element="defs">
                    <BitElement Element="linearGradient" id="demo-gradient" x1="0" y1="0" x2="1" y2="0">
                        <BitElement Element="stop" offset="0%" stop-color="tomato" />
                        <BitElement Element="stop" offset="100%" stop-color="mediumseagreen" />
                    </BitElement>
                </BitElement>
                <BitElement Element="rect" width="160" height="48" rx="8" fill="url(#demo-gradient)" />
            </BitElement>
            <BitElement Element="demo-badge">A custom element (demo-badge)</BitElement>
        </div>
    </DemoExample>

    <DemoExample Title="Void elements" RazorCode="@example3RazorCode" Id="example3">
        <div class="example-desc">
            Void elements (<code>input</code>, <code>img</code>, <code>hr</code>, <code>br</code>, ...) render without a
            closing tag, and their <b>ChildContent</b> is left out rather than emitted as invalid markup.
        </div>
        <div class="example-content">
            <BitElement Element="input" placeholder="An input" AriaLabel="An input" />
            <BitElement Element="hr" />
            <BitElement Element="img" src="_content/Bit.BlazorUI.Demo.Client.Core/images/bit-logo-blue.png" alt="bit logo" width="64" />
            <BitElement Element="br">Not rendered: a br holds no content.</BitElement>
        </div>
    </DemoExample>

    <DemoExample Title="Attributes & events" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
        <div class="example-desc">
            Anything that is not a parameter - <code>href</code>, <code>placeholder</code>, <code>role</code>,
            <code>aria-*</code>, <code>data-*</code>, <code>@@onclick</code>, <code>@@oninput</code>, ... - is splatted
            onto the rendered tag.
        </div>
        <div class="example-content">
            <BitElement Element="a" href="https://bitplatform.dev/" target="_blank" rel="noopener">An anchor to bitplatform.dev</BitElement>
            <BitElement Element="button" data-demo="counter" @onclick="() => counter++">Clicked @counter times</BitElement>
            <BitElement Element="input" placeholder="Type something" aria-describedby="typed-output" @oninput="e => typed = e.Value?.ToString()" />
            <BitElement id="typed-output" role="status">You typed: @typed</BitElement>
        </div>
    </DemoExample>

    <DemoExample Title="Event modifiers" RazorCode="@example5RazorCode" CsharpCode="@example5CsharpCode" Id="example5">
        <div class="example-desc">
            Razor only allows <code>:stopPropagation</code> and <code>:preventDefault</code> on plain elements, so they
            are parameters here. <b>StopPropagation</b> and <b>PreventDefault</b> apply to the click;
            <b>StopPropagationEvents</b> and <b>PreventDefaultEvents</b> take any other event names (with or without
            the <code>on</code> prefix) and apply whether or not a handler is attached.
        </div>
        <div class="example-content">
            <div class="demo-card" @onclick="() => card++">
                The card was clicked @card times.
                <BitElement Element="button" StopPropagation @onclick="() => inner++">Stops propagation (@inner)</BitElement>
                <BitElement Element="button" @onclick="() => inner++">Bubbles up (@inner)</BitElement>
            </div>
            <BitElement Element="a" href="https://bitplatform.dev/" PreventDefault @onclick="() => prevented++">
                An anchor that does not navigate (@prevented)
            </BitElement>
            <div class="demo-card" @ondblclick="() => doubled++">
                The card was double-clicked @doubled times.
                <BitElement class="demo-boxed"
                            StopPropagationEvents="@(["dblclick"])"
                            PreventDefaultEvents="@(["contextmenu"])"
                            @ondblclick="() => inner++"
                            @oncontextmenu="() => inner++">
                    Double-click stays here, right-click opens no browser menu (@inner)
                </BitElement>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Dynamic element" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
        <div class="example-desc">
            The tag can change at runtime; the element is then rebuilt. Splatted attributes follow it, and each tag uses
            only the ones it understands.
        </div>
        <div class="example-content">
            <BitDropdown Label="Element" Items="elementsList" @bind-Value="element" Style="width: 8rem;" />
            <BitElement Element="@element"
                        placeholder="@element"
                        target="_blank"
                        href="https://bitplatform.dev/">
                @element
            </BitElement>
        </div>
    </DemoExample>

    <DemoExample Title="No wrapper" RazorCode="@example7RazorCode" CsharpCode="@example7CsharpCode" Id="example7">
        <div class="example-desc">
            <b>NoWrapper</b> renders the content alone, making the element a conditional wrapper. With no tag to land
            on, the class, style, id, attributes and element reference are ignored.
        </div>
        <div class="example-content">
            <BitToggle @bind-Value="wrapped" Text="Wrap the content" />
            <BitElement Element="mark" NoWrapper="@(wrapped is false)">The same content, highlighted or bare.</BitElement>
        </div>
    </DemoExample>

    <DemoExample Title="Element reference" RazorCode="@example8RazorCode" CsharpCode="@example8CsharpCode" Id="example8">
        <div class="example-desc">
            <b>RootElement</b> is the rendered element's <code>ElementReference</code> for JS interop, and
            <b>FocusAsync</b> focuses it - optionally without scrolling. A non-focusable tag needs a <b>TabIndex</b>.
            Both are no-ops while <b>NoWrapper</b> is set or before the first render.
        </div>
        <div class="example-content">
            <BitElement Element="input" @ref="inputElement" placeholder="Focused by the button" AriaLabel="Focus target" />
            <BitElement class="demo-boxed" TabIndex="0" @ref="boxElement">A div, focusable because it has a TabIndex.</BitElement>
            <BitButton OnClick="FocusTheInput">Focus the input</BitButton>
            <BitButton OnClick="FocusTheBox">Focus the div without scrolling</BitButton>
        </div>
    </DemoExample>

    <DemoExample Title="Disabled" RazorCode="@example9RazorCode" Id="example9">
        <div class="example-desc">
            <b>IsEnabled="false"</b> dims the element and blocks the pointer on any tag, and sets <code>aria-disabled</code>.
            Form elements also get the native <code>disabled</code>; other tags get <code>tabindex="-1"</code>. A disabled
            anchor loses its <code>href</code> and keeps <code>role="link"</code>, so it is still announced as a
            (disabled) link. Screen readers only announce <code>aria-disabled</code> on an element with a role, so give
            a generic tag one. Content inside keeps its own tab stops.
        </div>
        <div class="example-content">
            <BitElement Element="button" IsEnabled="false">A disabled button</BitElement>
            <BitElement Element="input" IsEnabled="false" placeholder="A disabled input" AriaLabel="A disabled input" />
            <BitElement Element="a" href="https://bitplatform.dev/" IsEnabled="false">A disabled anchor</BitElement>
            <BitElement class="demo-boxed" TabIndex="0" role="group" IsEnabled="false">A disabled div, out of the tab order</BitElement>
        </div>
    </DemoExample>

    <DemoExample Title="Visibility" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
        <div class="example-desc">
            <b>Hidden</b> keeps the element's space, <b>Collapsed</b> removes it from the layout. Collapsed also drops
            the content of a <b>NoWrapper</b> element.
        </div>
        <div class="example-content">
            <BitToggle @bind-Value="isVisible" Text="Visible" />
            <BitElement class="demo-boxed" Visibility="@(isVisible ? BitVisibility.Visible : BitVisibility.Hidden)">Hidden keeps its space.</BitElement>
            <BitElement class="demo-boxed" Visibility="@(isVisible ? BitVisibility.Visible : BitVisibility.Collapsed)">Collapsed takes its space with it.</BitElement>
            <BitElement NoWrapper Visibility="@(isVisible ? BitVisibility.Visible : BitVisibility.Collapsed)">Unwrapped content is dropped while collapsed.</BitElement>
        </div>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
        <div class="example-desc">
            <b>BitParams</b> hands a <b>BitElementParams</b> to every element below it as defaults, not overrides: an
            element that sets a parameter itself keeps its own value. Here every item of the toolbar becomes a
            <code>button</code> that keeps its clicks from the card, except the last one.
        </div>
        <div class="example-content">
            <div class="demo-card" @onclick="() => toolbarCard++">
                The card was clicked @toolbarCard times.
                <BitParams Parameters="@elementParams">
                    <BitElement @onclick="() => toolbar++">Edit (@toolbar)</BitElement>
                    <BitElement @onclick="() => toolbar++">Share (@toolbar)</BitElement>
                    <BitElement StopPropagation="false" @onclick="() => toolbar++">Bubbles up (@toolbar)</BitElement>
                </BitParams>
            </div>
            <BitElement>Outside the cascade: a plain div again.</BitElement>
        </div>
    </DemoExample>

    <DemoExample Title="Style & Class" RazorCode="@example12RazorCode" Id="example12">
        <div class="example-desc">
            <b>Style</b> and <b>Class</b> are merged with a plain <code>style</code> or <code>class</code> attribute
            instead of replacing it.
        </div>
        <div class="example-content">
            <BitElement Style="color: tomato; font-weight: bold;">Styled through the Style parameter</BitElement>
            <BitElement Class="demo-boxed">Classed through the Class parameter</BitElement>
            <BitElement Class="demo-boxed" style="color: mediumseagreen;">A Class parameter and a plain style attribute</BitElement>
        </div>
        <br />
        <div class="example-desc">
            The <BitLink Href="#css-variables-section">CSS variables</BitLink> inherit, so they can be set on
            <code>:root</code>, on an ancestor, or on the <b>Style</b> of one element.
        </div>
        <div class="example-content">
            <BitElement Element="button" IsEnabled="false" Style="--bit-Element-disabled-opacity: 0.2;">Disabled, dimmed further</BitElement>
            <div style="--bit-Element-disabled-opacity: 1;">
                <BitElement Element="fieldset" IsEnabled="false">
                    <BitElement Element="legend">A disabled fieldset, not dimmed</BitElement>
                    <BitElement Element="input" placeholder="Its input shows its own disabled look" AriaLabel="Fieldset input" />
                </BitElement>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="RTL" RazorCode="@example13RazorCode" Id="example13">
        <div class="example-desc">
            <b>Dir</b> writes the <code>dir</code> attribute (and the <code>bit-rtl</code> class) on any tag.
        </div>
        <div dir="rtl" class="example-content">
            <BitElement Dir="BitDir.Rtl">این یک المنت راست‌چین است.</BitElement>
            <BitElement Element="blockquote" Dir="BitDir.Rtl">یک نقل قول راست‌چین.</BitElement>
        </div>
    </DemoExample>
</DemoPage>
