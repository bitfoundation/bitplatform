@page "/components/icon"

<PageOutlet Url="components/icon"
            Title="Icon"
            Description="Icon draws one glyph from the 2,300 built-in Fabric MDL2 icons or from any icon set you link: themed, sized, turned, mirrored, animated, and a keyboard-operable button when it is clickable." />

<DemoPage Name="Icon"
          SecondaryNames="@(["Glyph", "Symbol"])"
          Description="Icon draws one glyph: any of the 2,300 built-in Fabric MDL2 icons by name, a glyph of FontAwesome, Bootstrap Icons, Material Icons, Material Symbols or any CSS-class icon set, or an inline SVG of your own. It takes the theme's colors and sizes, comes plain, outlined, filled or circular, turns, mirrors and animates, and becomes a keyboard-operable button when you give it a click handler."
          Notes="An icon is decorative by default and hidden from assistive technology. Give it an AriaLabel or a Title when it is the only thing carrying the meaning."
          Parameters="componentParameters"
          PublicMembers="componentPublicMembers"
          SubClasses="componentSubClasses"
          SubEnums="componentSubEnums"
          CssVariables="componentCssVariables"
          GitHubUrl="Utilities/Icon/BitIcon.razor"
          GitHubDemoUrl="Utilities/Icon/BitIconDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" Id="example1">
        <div>
            <b>IconName</b> names a glyph of the built-in set (all of them are on the <BitLink Href="/iconography">iconography page</BitLink>).
            <b>IsEnabled</b> false draws it in the disabled color.
        </div>
        <br /><br />
        <div class="example-content">
            <BitIcon IconName="@BitIconName.Accept" />
            <BitIcon IconName="@BitIconName.Bus" />
            <BitIcon IconName="@BitIconName.Pinned" />
        </div>
        <br />
        <div class="example-content">
            <BitIcon IconName="@BitIconName.Accept" IsEnabled="false" />
            <BitIcon IconName="@BitIconName.Bus" IsEnabled="false" />
            <BitIcon IconName="@BitIconName.Pinned" IsEnabled="false" />
        </div>
    </DemoExample>

    <DemoExample Title="Variant" RazorCode="@example2RazorCode" Id="example2">
        <div>
            <b>Variant</b>: <b>Text</b> (the default) is the bare glyph, <b>Outline</b> and <b>Fill</b> put it in a box of its own.
            <b>Circular</b> turns that box into a circle of the same size for every glyph.
        </div>
        <br /><br />
        <div class="example-content">
            <BitIcon IconName="@BitIconName.Accept" Variant="BitVariant.Text" />
            <BitIcon IconName="@BitIconName.Accept" Variant="BitVariant.Outline" />
            <BitIcon IconName="@BitIconName.Accept" Variant="BitVariant.Fill" />
            <BitIcon IconName="@BitIconName.Accept" Variant="BitVariant.Outline" Circular />
            <BitIcon IconName="@BitIconName.Accept" Variant="BitVariant.Fill" Circular />
        </div>
        <br />
        <div class="example-content">
            <BitIcon IconName="@BitIconName.Accept" Variant="BitVariant.Text" IsEnabled="false" />
            <BitIcon IconName="@BitIconName.Accept" Variant="BitVariant.Outline" IsEnabled="false" />
            <BitIcon IconName="@BitIconName.Accept" Variant="BitVariant.Fill" IsEnabled="false" />
            <BitIcon IconName="@BitIconName.Accept" Variant="BitVariant.Outline" Circular IsEnabled="false" />
            <BitIcon IconName="@BitIconName.Accept" Variant="BitVariant.Fill" Circular IsEnabled="false" />
        </div>
    </DemoExample>

    <DemoExample Title="Rotate & Flip" RazorCode="@example3RazorCode" Id="example3">
        <div>
            <b>Rotate</b> turns the glyph by quarter turns, <b>RotateAngle</b> by any angle in degrees (and wins over <b>Rotate</b>),
            <b>Flip</b> mirrors it on either axis or both. They combine, so one arrow covers every direction.
            <b>FlipRtl</b> mirrors only in right-to-left: give it to glyphs that point somewhere, never to a clock or a checkmark.
        </div>
        <br /><br />
        <div class="example-content">
            <BitIcon IconName="@BitIconName.Up" />
            <BitIcon IconName="@BitIconName.Up" Rotate="BitIconRotate.Rotate90" />
            <BitIcon IconName="@BitIconName.Up" Rotate="BitIconRotate.Rotate180" />
            <BitIcon IconName="@BitIconName.Up" Rotate="BitIconRotate.Rotate270" />
            <BitIcon IconName="@BitIconName.Up" RotateAngle="45" />
            <BitIcon IconName="@BitIconName.Up" RotateAngle="-30" />
        </div>
        <br />
        <div class="example-content">
            <BitIcon IconName="@BitIconName.ReplyAlt" />
            <BitIcon IconName="@BitIconName.ReplyAlt" Flip="BitIconFlip.Horizontal" />
            <BitIcon IconName="@BitIconName.ReplyAlt" Flip="BitIconFlip.Vertical" />
            <BitIcon IconName="@BitIconName.ReplyAlt" Flip="BitIconFlip.Both" />
            <BitIcon IconName="@BitIconName.ReplyAlt" Flip="BitIconFlip.Horizontal" RotateAngle="45" />
        </div>
        <br />
        <div>FlipRtl, left-to-right and then inside a <code>dir="rtl"</code> container:</div>
        <br />
        <div class="example-content">
            <BitIcon IconName="@BitIconName.Forward" FlipRtl />
            <BitIcon IconName="@BitIconName.Back" FlipRtl />
            <BitIcon IconName="@BitIconName.Clock" />
        </div>
        <br />
        <div class="example-content" dir="rtl">
            <BitIcon IconName="@BitIconName.Forward" FlipRtl />
            <BitIcon IconName="@BitIconName.Back" FlipRtl />
            <BitIcon IconName="@BitIconName.Clock" />
        </div>
    </DemoExample>

    <DemoExample Title="Animation" RazorCode="@example4RazorCode" CsharpCode="@example4CsharpCode" Id="example4">
        <div>
            <b>Animation</b> loops the icon; a turn or a flip stays under it. <b>AnimationDuration</b> sets one cycle, <b>AnimationDelay</b>
            the wait before the first (staggered, a wave), <b>AnimationIterationCount</b> stops an attention-seeking one after a few cycles.
            Reduced motion slows every animation down; <b>ForceAnimation</b> restores its speed.
        </div>
        <br /><br />
        <div class="example-content animation-row">
            <div><BitIcon IconName="@BitIconName.Sync" Animation="BitIconAnimation.Spin" /><span>Spin</span></div>
            <div><BitIcon IconName="@BitIconName.Sync" Animation="BitIconAnimation.SpinReverse" /><span>SpinReverse</span></div>
            <div><BitIcon IconName="@BitIconName.ProgressRingDots" Animation="BitIconAnimation.Pulse" /><span>Pulse</span></div>
            <div><BitIcon IconName="@BitIconName.Heart" Animation="BitIconAnimation.Beat" /><span>Beat</span></div>
            <div><BitIcon IconName="@BitIconName.StatusCircleInner" Animation="BitIconAnimation.Fade" /><span>Fade</span></div>
            <div><BitIcon IconName="@BitIconName.Ringer" Animation="BitIconAnimation.Shake" /><span>Shake</span></div>
            <div><BitIcon IconName="@BitIconName.Up" Animation="BitIconAnimation.Bounce" /><span>Bounce</span></div>
            <div><BitIcon IconName="@BitIconName.CircleFill" Animation="BitIconAnimation.BeatFade" /><span>BeatFade</span></div>
        </div>
        <br />
        <div class="example-content animation-row">
            <div><BitIcon IconName="@BitIconName.Sync" Animation="BitIconAnimation.Spin" AnimationDuration="4s" /><span>Spin 4s</span></div>
            <div><BitIcon IconName="@BitIconName.Sync" Animation="BitIconAnimation.Spin" AnimationDuration="0.4s" /><span>Spin 0.4s</span></div>
            <div><BitIcon IconName="@BitIconName.Send" Animation="BitIconAnimation.Beat" RotateAngle="45" /><span>Beat, turned 45</span></div>
            <div>
                <BitIcon @key="replayKey" IconName="@BitIconName.Ringer" Animation="BitIconAnimation.Shake" AnimationIterationCount="3" />
                <BitLink OnClick="() => replayKey++">Shake 3 times (replay)</BitLink>
            </div>
            <div>
                <span class="wave">
                    <BitIcon IconName="@BitIconName.CircleFill" Animation="BitIconAnimation.Fade" AnimationDuration="1.2s" />
                    <BitIcon IconName="@BitIconName.CircleFill" Animation="BitIconAnimation.Fade" AnimationDuration="1.2s" AnimationDelay="0.2s" />
                    <BitIcon IconName="@BitIconName.CircleFill" Animation="BitIconAnimation.Fade" AnimationDuration="1.2s" AnimationDelay="0.4s" />
                </span>
                <span>AnimationDelay</span>
            </div>
        </div>
    </DemoExample>

    <DemoExample Title="Fixed width" RazorCode="@example5RazorCode" Id="example5">
        <div>
            Font glyphs differ in width, so the labels beside them start at a different place on every row. <b>FixedWidth</b> gives every
            icon the same box; the first list is without it, the second with it.
        </div>
        <br /><br />
        <div class="fixed-width-lists">
            <ul class="icon-list">
                <li><BitIcon IconName="@BitIconName.Home" /> Home</li>
                <li><BitIcon IconName="@BitIconName.Settings" /> Settings</li>
                <li><BitIcon IconName="@BitIconName.Contact" /> Profile</li>
                <li><BitIcon IconName="@BitIconName.SignOut" /> Sign out</li>
            </ul>
            <ul class="icon-list">
                <li><BitIcon IconName="@BitIconName.Home" FixedWidth /> Home</li>
                <li><BitIcon IconName="@BitIconName.Settings" FixedWidth /> Settings</li>
                <li><BitIcon IconName="@BitIconName.Contact" FixedWidth /> Profile</li>
                <li><BitIcon IconName="@BitIconName.SignOut" FixedWidth /> Sign out</li>
            </ul>
        </div>
    </DemoExample>

    <DemoExample Title="Clickable" RazorCode="@example6RazorCode" CsharpCode="@example6CsharpCode" Id="example6">
        <div>
            <b>OnClick</b> makes the icon a button: a tab stop with a focus ring, hover and pressed states, Enter and Space, and a pointer
            target grown to 24&times;24px without growing the icon. Name it with an <b>AriaLabel</b> or a <b>Title</b>; a toggle also takes an
            <code>aria-pressed</code>. A disabled one leaves the tab order but keeps its <b>Title</b> tooltip. For anything more than an icon,
            use a <BitLink Href="/components/button">BitButton</BitLink>.
        </div>
        <br /><br />
        <div class="example-content">
            <BitIcon IconName="@(isStarred ? BitIconName.FavoriteStarFill : BitIconName.FavoriteStar)"
                     Title="Favorite"
                     aria-pressed="@(isStarred ? "true" : "false")"
                     OnClick="() => isStarred = !isStarred" />

            <BitIcon IconName="@BitIconName.Refresh"
                     Variant="BitVariant.Outline"
                     AriaLabel="Refresh the list"
                     OnClick="() => clickCount++" />

            <BitIcon IconName="@BitIconName.Delete"
                     Variant="BitVariant.Fill"
                     Title="Deleting is unavailable here"
                     IsEnabled="false"
                     OnClick="() => clickCount++" />
        </div>
        <br />
        <div>Refreshed @clickCount times.</div>
    </DemoExample>

    <DemoExample Title="Custom content" RazorCode="@example7RazorCode" Id="example7">
        <div>
            <b>ChildContent</b> replaces the glyph - an inline SVG, a sprite, an image - and keeps the icon's color, size and variant. Draw the
            SVG with <code>fill="currentColor"</code> and size it in <code>em</code>. An SVG sits on its bottom edge and rides high next to text;
            <b>Inline</b> drops it onto the line.
        </div>
        <br /><br />
        <div class="example-content">
            <BitIcon>
                <svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2 15.1 8.6 22 9.7l-5 4.9 1.2 7L12 18.3 5.8 21.6 7 14.6l-5-4.9 6.9-1.1z" />
                </svg>
            </BitIcon>
            <BitIcon Variant="BitVariant.Outline">
                <svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" />
                </svg>
            </BitIcon>
            <BitIcon Variant="BitVariant.Fill">
                <svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 21.35 10.55 20C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54z" />
                </svg>
            </BitIcon>
        </div>
        <br />
        <div>
            Aligned by its box
            <BitIcon>
                <svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" />
                </svg>
            </BitIcon>
            and dropped onto the line with Inline
            <BitIcon Inline>
                <svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" />
                </svg>
            </BitIcon>
        </div>
    </DemoExample>

    <DemoExample Title="Accessibility" RazorCode="@example8RazorCode" Id="example8">
        <div>
            An unnamed icon is decorative: <code>aria-hidden</code>, skipped by screen readers - right beside a label that says the same.
            <b>AriaLabel</b>, <b>Title</b> (also a native tooltip) or your own <code>aria-labelledby</code> names it with the <code>img</code> role.
            A native tooltip never shows for keyboard or touch users: for text meant to be read, give the icon a <b>TabIndex</b> and wrap it in a
            <BitLink Href="/components/tooltip">BitTooltip</BitLink>. A focusable icon is never hidden and gets the themed focus ring - so
            name it too: only a glyph with a name of its own (an <b>IconName</b>, a ligature) falls back to that name.
            Ligature icons are marked <code>translate="no"</code>; forced-colors mode keeps variants and the disabled state visible.
        </div>
        <br /><br />
        <div class="example-content">
            <BitIcon IconName="@BitIconName.CompletedSolid" AriaLabel="Succeeded" />
            <BitIcon IconName="@BitIconName.ErrorBadge" Title="Failed on the last run" />
            <BitTooltip Text="Failed runs are retried three times, a minute apart.">
                <BitIcon IconName="@BitIconName.Info" AriaLabel="Retry policy" TabIndex="0" />
            </BitTooltip>
            <span><BitIcon IconName="@BitIconName.Attach" /> Decorative, beside its own label</span>
        </div>
    </DemoExample>

    <DemoExample Title="CSS variables" RazorCode="@example9RazorCode" CsharpCode="@example9CsharpCode" Id="example9">
        <div>
            The public <b>--bit-Icon-*</b> variables (see the <BitLink Href="#css-variables-section">CSS variables</BitLink> table) restyle every
            icon at once, which is also how an icon takes a color outside the theme. They inherit, so set them on <code>:root</code> or on any
            element around the icons. Given only <b>--bit-Icon-color</b>, a clickable icon still deepens under the pointer and while pressed;
            <b>--bit-Icon-hover-color</b> and <b>--bit-Icon-active-color</b> pick those shades yourself. A disabled icon keeps the disabled colors.
            <br />
            <code>currentColor</code> makes a Text icon follow the text around it, the way a glyph of a font does. Set it around Text icons only:
            a Fill icon draws its glyph over a box of that color, and <code>currentColor</code> there is the glyph's own color.
        </div>
        <br /><br />
        <div class="example-content" style="--bit-Icon-color: #0d9488; --bit-Icon-contrast-color: #f0fdfa; --bit-Icon-size: 1.5rem; --bit-Icon-padding: 0.5rem; --bit-Icon-radius: 0.75rem; --bit-Icon-border-width: 2px;">
            <BitIcon IconName="@BitIconName.Home" />
            <BitIcon IconName="@BitIconName.Home" Variant="BitVariant.Outline" />
            <BitIcon IconName="@BitIconName.Home" Variant="BitVariant.Fill" />
            <BitIcon IconName="@BitIconName.Refresh" Variant="BitVariant.Fill" AriaLabel="Refresh" OnClick="() => clickCount++" />
        </div>
        <br />
        <div class="example-content" style="--bit-Icon-color: #db2777; --bit-Icon-hover-color: #be185d; --bit-Icon-active-color: #9d174d; --bit-Icon-focus-color: #f59e0b; --bit-Icon-size: 2rem; --bit-Icon-fixed-width: 3em;">
            <BitIcon IconName="@BitIconName.Heart" />
            <BitIcon IconName="@BitIconName.Settings" AriaLabel="Settings" OnClick="() => clickCount++" />
            <BitIcon IconName="@BitIconName.Home" FixedWidth Variant="BitVariant.Outline" />
        </div>
        <br />
        <div style="color: seagreen; --bit-Icon-color: currentColor;">
            <BitIcon IconName="@BitIconName.Lightbulb" /> The icon takes the color of the text it sits in.
        </div>
    </DemoExample>

    <DemoExample Title="Cascading parameters" RazorCode="@example10RazorCode" CsharpCode="@example10CsharpCode" Id="example10">
        <div>
            <b>BitParams</b> hands a <b>BitIconParams</b> to every icon under it, so a toolbar or a status list sets its shared look once. It
            is a default, not an override: the last icon keeps its own <b>Variant</b>.
        </div>
        <br /><br />
        <BitParams Parameters="@iconParams">
            <div class="example-content">
                <BitIcon IconName="@BitIconName.Mail" />
                <BitIcon IconName="@BitIconName.Calendar" />
                <BitIcon IconName="@BitIconName.TaskManager" />
                <BitIcon IconName="@BitIconName.Settings" Variant="BitVariant.Fill" />
            </div>
        </BitParams>
    </DemoExample>

    <DemoExample Title="Color" RazorCode="@example11RazorCode" CsharpCode="@example11CsharpCode" Id="example11">
        <div>
            <b>Color</b> paints the icon in a theme role, so every preset and both schemes re-skin it. The semantic roles carry meaning; the
            background, foreground and border roles are the neutral tiers of the surface. Like every component's colors, it is the default of
            the <b>--bit-Icon-*</b> color variables, so one of those set around the icon wins over it.
        </div>
        <br /><br />
        <div class="color-grid">
            @foreach (var color in colors)
            {
                <div class="@(IsBackground(color) ? "color-row on-dark" : "color-row")">
                    <BitIcon IconName="@BitIconName.Accept" Color="color" />
                    <BitIcon IconName="@BitIconName.Accept" Color="color" Variant="BitVariant.Outline" />
                    <BitIcon IconName="@BitIconName.Accept" Color="color" Variant="BitVariant.Fill" />
                    <BitIcon IconName="@BitIconName.Accept" Color="color" Variant="BitVariant.Fill" IsEnabled="false" />
                    <span>@color</span>
                </div>
            }
        </div>
    </DemoExample>

    <DemoExample Title="External Icons" RazorCode="@example12RazorCode" CsharpCode="@example12CsharpCode" Id="example12">
        <div>
            <b>Icon</b> takes a <b>BitIconInfo</b> for any other set: <b>Fa</b> (FontAwesome), <b>Bi</b> (Bootstrap Icons), <b>Mi</b>/<b>Ms</b>
            (Material Icons/Symbols, ligature-based), <b>Css</b> for any class list, or a plain string. Link the set's stylesheet yourself.
            <b>IconResolver</b> turns a plain <b>IconName</b> into another set's icon - once, or for a whole subtree through <b>BitParams</b>;
            answering null leaves the name to the built-in set.
        </div>
        <br /><br />

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />

        <div>FontAwesome</div>
        <br />
        <div class="example-content">
            <BitIcon Icon="@("fa-solid fa-house")" />
            <BitIcon Icon="@BitIconInfo.Css("fa-solid fa-heart")" Color="BitColor.Error" />
            <BitIcon Icon="@BitIconInfo.Fa("fa-brands fa-github")" />
            <BitIcon Icon="@BitIconInfo.Fa("solid rocket")" Color="BitColor.Secondary" />
        </div>
        <br />
        <div>Bootstrap Icons</div>
        <br />
        <div class="example-content">
            <BitIcon Icon="@("bi bi-house-fill")" />
            <BitIcon Icon="@BitIconInfo.Css("bi bi-heart-fill")" Color="BitColor.Error" />
            <BitIcon Icon="@BitIconInfo.Bi("github")" />
            <BitIcon Icon="@BitIconInfo.Bi("gear-fill")" Color="BitColor.Secondary" />
        </div>
        <br />
        <div>Material Symbols</div>
        <br />
        <div class="example-content">
            <BitIcon Icon="@BitIconInfo.Ms("home")" />
            <BitIcon Icon="@BitIconInfo.Ms("favorite")" Color="BitColor.Error" />
            <BitIcon Icon="@BitIconInfo.Ms("settings")" Animation="BitIconAnimation.Spin" />
            <BitIcon Icon="@BitIconInfo.Ms("rocket_launch")" Color="BitColor.Secondary" />
        </div>
        <br />
        <div>IconResolver (plain names read as FontAwesome ones; Accept falls through to the built-in set)</div>
        <br />
        <div class="example-content">
            <BitIcon IconName="house" IconResolver="@faResolver" />
            <BitIcon IconName="heart" IconResolver="@faResolver" Color="BitColor.Error" />
            <BitIcon IconName="rocket" IconResolver="@faResolver" Color="BitColor.Secondary" />
            <BitIcon IconName="Accept" IconResolver="@faResolver" Color="BitColor.Success" />
        </div>
    </DemoExample>

    <DemoExample Title="Size" RazorCode="@example13RazorCode" Id="example13">
        <div>
            <b>Size</b> picks one of the theme's three icon sizes, as the default of <b>--bit-Icon-size</b>, which wins over it. <b>FontSize</b>
            takes any CSS length, or <code>inherit</code> to match the surrounding text, and wins over both.
        </div>
        <br /><br />
        <div class="example-content">
            <BitIcon Size="BitSize.Small" IconName="@BitIconName.Accept" />
            <BitIcon Size="BitSize.Medium" IconName="@BitIconName.Accept" />
            <BitIcon Size="BitSize.Large" IconName="@BitIconName.Accept" />
            <BitIcon Size="BitSize.Small" IconName="@BitIconName.Accept" Variant="BitVariant.Fill" />
            <BitIcon Size="BitSize.Medium" IconName="@BitIconName.Accept" Variant="BitVariant.Fill" />
            <BitIcon Size="BitSize.Large" IconName="@BitIconName.Accept" Variant="BitVariant.Fill" />
        </div>
        <br />
        <div class="example-content">
            <BitIcon FontSize="1.5rem" IconName="@BitIconName.Accept" />
            <BitIcon FontSize="2.5rem" IconName="@BitIconName.Accept" />
            <BitIcon FontSize="4rem" IconName="@BitIconName.Accept" />
        </div>
        <br />
        <div style="font-size:1.75rem">
            Sized by the text around it <BitIcon FontSize="inherit" IconName="@BitIconName.FavoriteStarFill" />
        </div>
    </DemoExample>

    <DemoExample Title="Style & Class" RazorCode="@example14RazorCode" Id="example14">
        <div>
            <b>Style</b> and <b>Class</b> land on the icon element itself - the whole component. <b>Style</b> is also where the
            <b>--bit-Icon-*</b> variables are set for one icon alone.
        </div>
        <br /><br />
        <div class="example-content">
            <BitIcon Size="BitSize.Large"
                     IconName="@BitIconName.Accept"
                     Style="color: white; background-color: brown; border-radius: 4px" />

            <BitIcon Class="icon-class"
                     IconName="@BitIconName.Accept" />

            <BitIcon IconName="@BitIconName.Heart"
                     Variant="BitVariant.Fill"
                     Style="--bit-Icon-color: hotpink; --bit-Icon-radius: 50% 0;" />
        </div>
    </DemoExample>

    <DemoExample Title="RTL" RazorCode="@example15RazorCode" Id="example15">
        <div>
            Use BitIcon in right-to-left (RTL). A glyph is not mirrored by the direction alone; <b>FlipRtl</b> opts in, and follows <b>Dir</b>
            or any ancestor's <code>dir</code>.
        </div>
        <br /><br />
        <div dir="rtl">
            <div class="example-content">
                <BitIcon Dir="BitDir.Rtl" IconName="@BitIconName.Accept" />
                <BitIcon Dir="BitDir.Rtl" IconName="@BitIconName.Bus" Color="BitColor.Info" />
                <BitIcon Dir="BitDir.Rtl" IconName="@BitIconName.Forward" FlipRtl />
                <BitIcon Dir="BitDir.Rtl" IconName="@BitIconName.Send" Color="BitColor.Success" Variant="BitVariant.Outline" FlipRtl />
            </div>
        </div>
    </DemoExample>
</DemoPage>
