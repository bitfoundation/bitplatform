@page "/components/params"

<PageOutlet Url="components/params"
            Title="Params"
            Description="BitParams cascades shared default parameters to every bit BlazorUI component in a subtree, so a toolbar, a form or a whole app sets them once." />

<DemoPage Name="Params"
          Description="BitParams cascades shared default parameters to every bit BlazorUI component in a subtree, so a toolbar, a form or a whole app sets them once. Each component reads the params object of its own type (BitButtonParams, BitTagParams, ...), and a parameter it sets itself always wins."
          Notes="A params object fills in only what a component leaves unset, one parameter at a time. BitParams re-reads its objects on every render and tells the components below only when a value actually changed, so rebuilding the list inline or changing a property of one of its objects is fine; a parameter an object stops setting goes back to what the component held before. For values of your own, use BitCascadingValueProvider."
          Parameters="componentParameters"
          SubClasses="componentSubClasses"
          GitHubUrl="../Utils/Params/BitParams.cs"
          GitHubDemoUrl="Utilities/Params/BitParamsDemo.razor">
    <DemoExample Title="Basic" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" Id="example1">
        <div>Every button and tag below takes its look from the params objects; the last button sets its own Variant, which wins.</div>
        <br />
        <BitParams Parameters="basicParams">
            <BitStack Horizontal Wrap VerticalAlign="BitAlignment.Center">
                <BitButton IconName="@BitIconName.Save">Save</BitButton>
                <BitButton IconName="@BitIconName.Share">Share</BitButton>
                <BitButton IconName="@BitIconName.Delete" Variant="BitVariant.Text">Delete</BitButton>
            </BitStack>
            <br />
            <BitStack Horizontal Wrap>
                <BitTag Text="Draft" />
                <BitTag Text="Internal" />
            </BitStack>
        </BitParams>
    </DemoExample>

    <DemoExample Title="Changing values" RazorCode="@example2RazorCode" CsharpCode="@example2CsharpCode" Id="example2">
        <div>The list can be written inline and rebuilt from state. Every component below follows the new values, and a value set back to null returns to the component's own.</div>
        <br />
        <BitToggle @bind-Value="isCompact" Label="Compact" Inline />
        <br />
        <BitParams Parameters="@([new BitButtonParams { Size = isCompact ? BitSize.Small : null },
                                 new BitTagParams { Size = isCompact ? BitSize.Small : null }])">
            <BitStack Horizontal Wrap VerticalAlign="BitAlignment.Center">
                <BitButton>Accept</BitButton>
                <BitButton Variant="BitVariant.Outline">Decline</BitButton>
                <BitTag Text="Pending" Color="BitColor.Warning" />
            </BitStack>
        </BitParams>
    </DemoExample>

    <DemoExample Title="Nesting" RazorCode="@example3RazorCode" CsharpCode="@example3CsharpCode" Id="example3">
        <div>
            A nested BitParams only replaces the parameters it sets and keeps the rest from its ancestors.
            <b>Isolated</b> ignores the ancestors altogether.
        </div>
        <br />
        <BitParams Parameters="outerParams">
            <BitStack Gap="1rem">
                <BitStack Horizontal Wrap VerticalAlign="BitAlignment.Center">
                    <BitText>Outer:</BitText>
                    <BitButton>Edit</BitButton>
                    <BitButton>Copy</BitButton>
                </BitStack>

                <BitParams Parameters="dangerParams">
                    <BitStack Horizontal Wrap VerticalAlign="BitAlignment.Center">
                        <BitText>Nested (Color only):</BitText>
                        <BitButton>Delete</BitButton>
                        <BitButton>Purge</BitButton>
                    </BitStack>
                </BitParams>

                <BitParams Isolated>
                    <BitStack Horizontal Wrap VerticalAlign="BitAlignment.Center">
                        <BitText>Isolated:</BitText>
                        <BitButton>Defaults</BitButton>
                    </BitStack>
                </BitParams>
            </BitStack>
        </BitParams>
    </DemoExample>
</DemoPage>
