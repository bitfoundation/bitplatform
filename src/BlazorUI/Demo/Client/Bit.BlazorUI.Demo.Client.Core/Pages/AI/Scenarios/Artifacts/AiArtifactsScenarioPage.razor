@page "/ai/scenarios/artifacts"
@inherits AppComponentBase

<PageOutlet Url="ai/scenarios/artifacts"
            Title="AI artifacts and versions"
            Keywords="Blazor AI artifacts, canvas, document versions, AI generated document, BitAiArtifactView, code artifact"
            Description="A document an AI writes into a panel of its own and revises on the next turn, keeping every version, with copy, download and full screen - bit BlazorUI's BitAiArtifactView." />

<DocsArticle Eyebrow="AI scenarios"
             Title="Artifacts"
             Lead="A document written into its own panel, then revised on the next turn with the earlier version kept."
             GitHubUrl="AI/Scenarios/Artifacts/AiArtifactsScenarioPage.razor">

    <Badges>
        <BitTag Size="BitSize.Small" Variant="BitVariant.Outline" Color="BitColor.SecondaryForeground" Text="Bit.BlazorUI.AI" />
        <BitTag Size="BitSize.Small" Variant="BitVariant.Outline" Color="BitColor.SecondaryForeground" Text="Scripted transport" />
    </Badges>

    <ChildContent>
        <DocSection Id="demo" Title="Live demo"
                    Description="Send once for a draft, then again to see it revised into version two.">
            <DemoExample Title="A document, drafted and revised" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" CodeFiles="@example1CodeFiles" Id="example1">
                <AiScenarioFrame>
                    <BitAiChat Session="_session"
                               EmptyTitle="Ask for a document"
                               EmptyBody="Send once for a draft, then again to see it revised into version two."
                               Suggestions="_suggestions" />
                </AiScenarioFrame>
            </DemoExample>
        </DocSection>

        <DocSection Id="how-it-works" Title="How it works">
            <p>
                The transport opens an artifact with <code>BitAiArtifactCreatedEvent</code>, streams its body with
                <code>BitAiArtifactDeltaEvent</code> and closes it with <code>BitAiArtifactCompletedEvent</code>. The
                artifact belongs to the conversation, not to a message: a revision three turns later updates the same
                object as a new version, so the UI keeps one artifact with a version selector instead of scattering
                near-identical code blocks through the transcript.
            </p>
            <p>
                Here every turn writes a line of text, then opens <code>art-readme</code> with its <code>Kind</code>
                (<code>BitAiArtifactKind.Document</code>), its title and its <code>Language</code> (<code>markdown</code>),
                streams the body a dozen characters at a time, and completes it with a <code>Summary</code> of what changed,
                which labels the version. The same id on a later turn is what makes it a revision: the conversation
                (<code>BitAiConversation.Artifacts</code>) keeps one <code>BitAiArtifact</code> whose versions grow, and the
                message gets a <code>BitAiArtifactPart</code> pointing at the version it produced. An artifact that is not
                streamed is sent whole, with <code>Content</code> on the created event, or as a <code>Url</code>.
            </p>
            <p>
                Each message shows the artifact opened at the version that turn produced, so a later revision never
                rewrites what an earlier turn appears to have said. Copy and download work on the version being viewed, and
                an HTML artifact renders in a sandboxed frame with same-origin access denied. A kind of the app's own gets
                its own view through <code>renderers.RegisterArtifact(kind, ...)</code>.
            </p>
        </DocSection>

        <DocSection Id="components" Title="Components used">
            <ul>
                <li><BitLink Href="/components/ai/artifactpartview"><code>BitAiArtifactPartView</code></BitLink> - where a message introduced the artifact.</li>
                <li><BitLink Href="/components/ai/artifactview"><code>BitAiArtifactView</code></BitLink> - the panel: title, versions, copy, download and full screen around the body.</li>
                <li><BitLink Href="/components/ai/markdownview"><code>BitAiMarkdownView</code></BitLink> - the body of a Markdown document.</li>
            </ul>
        </DocSection>
    </ChildContent>

    <FooterTemplate>
        <DocPager Pages="AiScenarioNav.Items" AriaLabel="AI scenarios" />
    </FooterTemplate>
</DocsArticle>
