@page "/ai/scenarios/forms"
@inherits AppComponentBase

<PageOutlet Url="ai/scenarios/forms"
            Title="AI-proposed forms"
            Keywords="AI form generation, JSON Schema form, human confirmation, BitAiForm, structured renderer, Blazor AI forms"
            Description="The model proposes a form from a JSON Schema, the user corrects it, and only the corrected, validated values execute - bit BlazorUI's BitAiForm as a structured renderer." />

<DocsArticle Eyebrow="AI scenarios"
             Title="Forms"
             Lead="The model proposes a form from a JSON Schema, the user corrects it, and the corrected values are what execute."
             GitHubUrl="AI/Scenarios/Forms/AiFormsScenarioPage.razor">

    <Badges>
        <BitTag Size="BitSize.Small" Variant="BitVariant.Outline" Color="BitColor.SecondaryForeground" Text="Bit.BlazorUI.AI" />
        <BitTag Size="BitSize.Small" Variant="BitVariant.Outline" Color="BitColor.SecondaryForeground" Text="Scripted transport" />
    </Badges>

    <ChildContent>
        <DocSection Id="demo" Title="Live demo"
                    Description="Ask it to book something: check the form it proposes, correct it, and submit. The values that would execute appear beside the chat.">
            <DemoExample Title="A booking to confirm" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" CodeFiles="@example1CodeFiles" Id="example1">
                <AiScenarioFrame AsideLabel="Submitted values">
                    <Aside>
                        <BitText Element="h4" Typography="BitTypography.Subtitle2">Submitted values</BitText>
                        @if (_values is { } values)
                        {
                            <ul>
                                @foreach (var (key, value) in values)
                                {
                                    <li><strong>@key</strong>: @value</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <BitText Element="p" Typography="BitTypography.Body2" Color="BitColor.SecondaryForeground">Nothing yet. Submit the form in the chat.</BitText>
                        }
                    </Aside>
                    <ChildContent>
                        <CascadingValue Name="BookingSubmitted" Value="_onSubmitted" IsFixed="true">
                            <BitAiChat Session="_session"
                                       EmptyTitle="Ask it to book something"
                                       Suggestions="_suggestions" />
                        </CascadingValue>
                    </ChildContent>
                </AiScenarioFrame>
            </DemoExample>
        </DocSection>

        <DocSection Id="how-it-works" Title="How it works">
            <p>
                Confirmation, not guessing. The model produced a schema, not a booking: the form is built from that schema
                (<code>BitAiFormDefinition.FromJsonSchema</code>), validated by the application rather than by the model, and
                only submits once it is valid.
            </p>
            <p>
                A structured renderer registered for the <code>booking_form</code> schema replaces the default view, so the
                user sees a form rather than the JSON behind it. The renderer, <code>BookingForm</code>, hands the values to
                whatever page cascaded a <code>BookingSubmitted</code> callback, so it stays reusable and the page decides
                what a booking means.
            </p>
            <p>
                Fields appear as the schema streams in, and anything already typed survives a new field arriving.
            </p>
        </DocSection>

        <DocSection Id="components" Title="Components used">
            <ul>
                <li><BitLink Href="/components/ai/form"><code>BitAiForm</code></BitLink> - the form, built from the core input components.</li>
                <li><BitLink Href="/components/ai/structureddataview"><code>BitAiStructuredDataView</code></BitLink> - the structured part that hands its schema to the registered renderer.</li>
            </ul>
        </DocSection>
    </ChildContent>

    <FooterTemplate>
        <DocPager Pages="AiScenarioNav.Items" AriaLabel="AI scenarios" />
    </FooterTemplate>
</DocsArticle>
