@page "/ai/scenarios/parallel-tools"
@inherits AppComponentBase

<PageOutlet Url="ai/scenarios/parallel-tools"
            Title="Parallel AI tool calls"
            Keywords="parallel tool calls, concurrent function calling, Blazor AI tools, BitAiToolCallView, LLM tools UI"
            Description="Two AI tool calls in flight at once in a bit BlazorUI chat, each with its own card, status and timing, run concurrently by the session." />

<DocsArticle Eyebrow="AI scenarios"
             Title="Parallel tools"
             Lead="Two calls in flight at once, each with its own card, status, and timing."
             GitHubUrl="AI/Scenarios/ParallelTools/AiParallelToolsScenarioPage.razor">

    <Badges>
        <BitTag Size="BitSize.Small" Variant="BitVariant.Outline" Color="BitColor.SecondaryForeground" Text="Bit.BlazorUI.AI" />
        <BitTag Size="BitSize.Small" Variant="BitVariant.Outline" Color="BitColor.SecondaryForeground" Text="Scripted transport" />
    </Badges>

    <ChildContent>
        <DocSection Id="demo" Title="Live demo"
                    Description="Compare two cities: the model asks for the weather in both at once.">
            <DemoExample Title="Two calls in one round" RazorCode="@example1RazorCode" CsharpCode="@example1CsharpCode" CodeFiles="@example1CodeFiles" Id="example1">
                <AiScenarioFrame>
                    <BitAiChat Session="_session"
                               EmptyTitle="Compare two cities"
                               Suggestions="_suggestions" />
                </AiScenarioFrame>
            </DemoExample>
        </DocSection>

        <DocSection Id="how-it-works" Title="How it works">
            <p>
                The session runs every call the model asked for in one round concurrently, and waits for all of them before
                asking again. Each card updates on its own, because each <code>BitAiToolCallPart</code> raises its own change
                event and only its own view re-renders - which is where a serial tool UI falls apart.
            </p>
            <p>
                A declined or failed call does not stop the others. Its failure is recorded on that call and sent back to the
                model with the rest. <code>BitAiChatSessionOptions.MaxToolRoundtrips</code> (six on this site) caps how many
                rounds of tools one turn may take.
            </p>
        </DocSection>

        <DocSection Id="components" Title="Components used">
            <ul>
                <li><BitLink Href="/components/ai/toolcallview"><code>BitAiToolCallView</code></BitLink> - one card per call, each with its own status and timing.</li>
                <li><BitLink Href="/components/ai/messagepartview"><code>BitAiMessagePartView</code></BitLink> - what re-renders one part, and only that part, when it changes.</li>
            </ul>
        </DocSection>
    </ChildContent>

    <FooterTemplate>
        <DocPager Pages="AiScenarioNav.Items" AriaLabel="AI scenarios" />
    </FooterTemplate>
</DocsArticle>
