                                <th scope="row"><code>BitBlazorUITrimAssets</code></th>
                                <td><code>true</code> | <code>false</code></td>
                                <td><code>true</code> in a WebAssembly project and wherever <code>PublishTrimmed</code> is (but on a server hosting a WebAssembly client), else <code>false</code></td>
                            </tr>
                            <tr>
                                <th scope="row"><code>BitBlazorUITrimScripts</code></th>
                                <td><code>true</code> | <code>false</code></td>
                                <td><code>BitBlazorUITrimAssets</code></td>
                            </tr>
                            <tr>
                                <th scope="row"><code>BitBlazorUITrimStyles</code></th>
                                <td><code>true</code> | <code>false</code></td>
                                <td><code>BitBlazorUITrimAssets</code></td>
                            </tr>
                            <tr>
                                <th scope="row"><code>BitBlazorUITrimVendorAssets</code></th>
                                <td><code>true</code> | <code>false</code></td>
