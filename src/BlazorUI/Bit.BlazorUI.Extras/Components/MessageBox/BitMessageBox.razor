@namespace Bit.BlazorUI
@inherits BitComponentBase

<div @ref="RootElement"
     @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">
    <div style="@Styles?.Container" class="bit-msb-con @Classes?.Container">
        @if (_HasHeader)
        {
            <div style="@Styles?.Header" class="bit-msb-hdr @Classes?.Header">
                @if (HeaderTemplate is not null)
                {
                    @HeaderTemplate
                }
                else
                {
                    @if (_HasIcon)
                    {
                        @* A glyph that only repeats the color of the message says nothing a screen reader
                           needs to hear, so it is hidden by default; naming it through IconAriaLabel is what
                           turns it into an image with a name - which is what a message box whose severity is
                           carried by the icon alone has to do. *@
                        <div style="@Styles?.IconContainer"
                             class="bit-msb-ict @Classes?.IconContainer"
                             role="@(IconAriaLabel.HasValue() ? "img" : null)"
                             aria-label="@IconAriaLabel"
                             aria-hidden="@(IconAriaLabel.HasValue() ? null : "true")">
                            @if (IconTemplate is not null)
                            {
                                @IconTemplate
                            }
                            else
                            {
                                <i style="@Styles?.Icon" class="bit-msb-ico @_Icon?.GetCssClasses() @Classes?.Icon" />
                            }
                        </div>
                    }

                    @if (Title.HasValue())
                    {
                        @* The id is what the modal around it points its aria-labelledby at, so the message box
                           names the dialog it is the content of instead of leaving it nameless. *@
                        <BitText Id="@_TitleId"
                                 Typography="BitTypography.H5"
                                 Color="BitColor.Tertiary"
                                 Style="@(Styles?.Title)"
                                 Class="@_TitleClass">
                            @Title
                        </BitText>
                    }

                    <BitSpacer Style="@(Styles?.Spacer)" Class="@(Classes?.Spacer)" />

                    @if (ShowCloseButton)
                    {
                        <BitButton @ref="_closeButtonRef"
                                   OnClick="HandleOnCloseClick"
                                   IsEnabled="IsEnabled"
                                   AutoFocus="@_AutoFocusCloseButton"
                                   Size="@Size"
                                   AutoLoading="@AutoLoading"
                                   Icon="@_CloseIcon"
                                   Title="@_CloseButtonTitle"
                                   AriaLabel="@_CloseButtonTitle"
                                   Color="BitColor.Tertiary"
                                   Variant="BitVariant.Text"
                                   Styles="@Styles?.CloseButton"
                                   Classes="@Classes?.CloseButton" />
                    }
                }
            </div>
        }

        @if (_HasBody)
        {
            @* The line breaks written into a body of text are kept, which is what the pre-wrap class is
               for. A body that is markup is laid out by the markup itself: keeping the whitespace of
               the razor file there would turn the newlines between its elements into blank lines. *@
            <div id="@_BodyId" style="@Styles?.Body" class="bit-msb-bdy @(_HasBodyTemplate ? null : "bit-msb-txt") @Classes?.Body">
                @if (_HasBodyTemplate)
                {
                    @(BodyTemplate ?? ChildContent)
                }
                else
                {
                    @Body
                }
            </div>
        }

        @if (_HasFooter)
        {
            <div style="@Styles?.Footer" class="bit-msb-ftr @Classes?.Footer">
                @if (FooterTemplate is not null)
                {
                    @FooterTemplate
                }
                else
                {
                    @foreach (var action in _Actions)
                    {
                        <BitButton @key="action"
                                   @ref="_buttonRefs[action]"
                                   OnClick="@(() => HandleAction(action))"
                                   IsEnabled="IsEnabled"
                                   AutoFocus="@_AutoFocusAction(action)"
                                   Size="@Size"
                                   AutoLoading="@AutoLoading"
                                   Color="@GetActionColor(action)"
                                   Variant="@(action == _PrimaryAction ? BitVariant.Fill : BitVariant.Outline)"
                                   Styles="@GetActionStyles(action)"
                                   Classes="@GetActionClasses(action)">
                            @GetActionText(action)
                        </BitButton>
                    }
                }
            </div>
        }
    </div>
</div>
