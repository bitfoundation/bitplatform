@namespace Bit.BlazorUI

<div class="@RootClass" style="@RootStyle" dir="@Dir?.ToString().ToLowerInvariant()" id="@Id" @attributes="HtmlAttributes">
    @if (_scene.Title is { } title && TitleSide(title) == BitChartPosition.Top)
    {
        @RenderTitle(title, "bit-cht-ttl")
    }
    @if (_scene.Subtitle is { } sub && TitleSide(sub) == BitChartPosition.Top)
    {
        @RenderTitle(sub, "bit-cht-sub")
    }

    @if (_scene.Legend is { Position: BitChartPosition.Top })
    {
        @RenderLegend(_scene.Legend)
    }

    <div class="bit-cht-mid">
        @if (_scene.Title is { } leftTitle && TitleSide(leftTitle) == BitChartPosition.Left)
        {
            @RenderTitle(leftTitle, "bit-cht-ttl bit-cht-ttl-v")
        }
        @if (_scene.Legend is { Position: BitChartPosition.Left })
        {
            @RenderLegend(_scene.Legend)
        }

        <div class="bit-cht-plot" @ref="_plotEl">
            <svg class="bit-cht-svg" viewBox="@ViewBox" preserveAspectRatio="xMidYMid meet" role="img"
                 aria-roledescription="chart"
                 aria-label="@ChartAriaLabel" aria-describedby="@DescribedBy"
                 style="@AnimStyle" tabindex="@(_scene.Elements.Count > 0 ? 0 : -1)"
                 @onkeydown="OnKeyDown" @onblur="OnBlur">
                <defs>
                    @if (_scene.PlotArea is { } pa)
                    {
                        <clipPath id="@ClipId">
                            <rect x="@BitChartSvg.N(pa.Left)" y="@BitChartSvg.N(pa.Top)" width="@BitChartSvg.N(pa.Width)" height="@BitChartSvg.N(pa.Height)" />
                        </clipPath>
                    }
                    @foreach (var def in _scene.Defs)
                    {
                        @if (def.Gradient is BitChartRadialGradient rg)
                        {
                            <radialGradient id="@def.Id" cx="@BitChartSvg.N(rg.CenterX)" cy="@BitChartSvg.N(rg.CenterY)" r="@BitChartSvg.N(rg.Radius)">
                                @foreach (var s in rg.Stops)
                                {
                                    <stop offset="@(BitChartSvg.N(s.Offset * 100))%" stop-color="@s.Color" />
                                }
                            </radialGradient>
                        }
                        else if (def.Gradient is BitChartLinearGradient lg)
                        {
                            <linearGradient id="@def.Id" x1="0" y1="0"
                                            x2="@(lg.Vertical ? "0" : "1")"
                                            y2="@(lg.Vertical ? "1" : "0")">
                                @foreach (var s in lg.Stops)
                                {
                                    <stop offset="@(BitChartSvg.N(s.Offset * 100))%" stop-color="@s.Color" />
                                }
                            </linearGradient>
                        }
                    }
                    @foreach (var pat in _scene.Patterns)
                    {
                        @RenderPattern(pat)
                    }
                </defs>
                <g class="bit-cht-bg" @key="_animKey">
                    @foreach (var n in _scene.Background)
                    {
                        <BitChartSvgPrimitive Node="n" />
                    }
                </g>
                @* Invisible per-index hit areas. They sit below the data so an element under the
                   pointer always wins, and make the chart hoverable across the whole plot. The
                   pointerdown handler is what gives a touch screen - which never hovers - the same
                   tooltip on a tap. *@
                <g class="bit-cht-bands">
                    @foreach (var band in _scene.HitBands)
                    {
                        <rect class="bit-cht-band" x="@BitChartSvg.N(band.X)" y="@BitChartSvg.N(band.Y)"
                              width="@BitChartSvg.N(band.Width)" height="@BitChartSvg.N(band.Height)"
                              fill="transparent" @onmouseenter="() => OnEnterBand(band)" @onmouseleave="OnLeave"
                              @onpointerdown="args => OnPointerDownBand(args, band)"
                              @onclick="() => OnClickBand(band)"
                              style="@(OnElementClick.HasDelegate ? "cursor:pointer" : "cursor:default")" />
                    }
                </g>
                <g class="@SeriesGroupClass" @key="(_animKey, 2)" clip-path="@ClipRef">
                    @foreach (var n in _scene.Series)
                    {
                        <BitChartSvgPrimitive Node="n" />
                    }
                </g>
                <g class="@DataGroupClass" style="@DataGroupStyle" @key="(_animKey, 1)" clip-path="@ClipRef">
                    @for (int ei = 0; ei < _scene.Elements.Count; ei++)
                    {
                        var el = _scene.Elements[ei];
                        <g class="@ElementClass(el)"
                           @onmouseenter="() => OnEnter(el)" @onmouseleave="OnLeave"
                           @onpointerdown="args => OnPointerDownElement(args, el)"
                           @onclick="() => OnClickElement(el)" style="@ElementStyle(ei)">
                            <BitChartSvgPrimitive Node="el.Shape" />
                            @if (el.BorderShape is { } bs)
                            {
                                <BitChartSvgPrimitive Node="bs" />
                            }
                        </g>
                    }
                </g>
                <g class="bit-cht-hover">
                    @foreach (var n in _hoverNodes)
                    {
                        <BitChartSvgPrimitive Node="n" />
                    }
                    @if (_dragBox is { } db)
                    {
                        <rect x="@BitChartSvg.N(db.X)" y="@BitChartSvg.N(db.Y)" width="@BitChartSvg.N(db.W)" height="@BitChartSvg.N(db.H)"
                              fill="@_config.Options.Zoom.DragBoxColor" stroke="@_config.Options.Zoom.DragBoxBorderColor" stroke-width="1" />
                    }
                </g>
                <g class="bit-cht-fg">
                    @foreach (var n in _scene.Foreground)
                    {
                        <BitChartSvgPrimitive Node="n" />
                    }
                </g>
            </svg>

            @if (_scene.IsEmpty)
            {
                <div class="bit-cht-nodata">
                    @if (NoDataTemplate is not null)
                    {
                        @NoDataTemplate
                    }
                    else
                    {
                        @NoDataText
                    }
                </div>
            }

            @if (_activeTooltip is { } tt && _config.Options.Plugins.Tooltip.Enabled)
            {
                var t = _config.Options.Plugins.Tooltip;
                var pos = TooltipPlacement(tt);
                @if (TooltipTemplate is not null && _tooltipContext is { } ctx)
                {
                    <div class="bit-cht-tt bit-cht-tt-custom" style="@pos.Style">
                        @TooltipTemplate(ctx)
                    </div>
                }
                else
                {
                    <div class="bit-cht-tt" style="@pos.Style;background:@t.BackgroundColor;border-radius:@(BitChartSvg.N(t.CornerRadius))px;padding:@(BitChartSvg.N(t.Padding))px @(BitChartSvg.N(t.Padding * 1.5))px;@(t.BorderWidth > 0 ? $"border:{BitChartSvg.N(t.BorderWidth)}px solid {t.BorderColor};" : "")">
                        @if (!string.IsNullOrEmpty(tt.Title))
                        {
                            <div class="bit-cht-tt-ttl" style="color:@t.TitleColor;font-weight:@t.TitleFont.Weight;font-size:@(BitChartSvg.N(t.TitleFont.Size))px;text-align:@TextAlign(t.TitleAlign)">@tt.Title</div>
                        }
                        @foreach (var line in tt.BeforeBody)
                        {
                            <div class="bit-cht-tt-itm" style="color:@t.BodyColor;font-size:@(BitChartSvg.N(t.BodyFont.Size))px">@line</div>
                        }
                        @foreach (var item in tt.Items)
                        {
                            <div class="bit-cht-tt-itm" style="color:@t.BodyColor;font-size:@(BitChartSvg.N(t.BodyFont.Size))px;text-align:@TextAlign(t.BodyAlign)">
                                @if (t.DisplayColors)
                                {
                                    @if (t.UsePointStyle && item.PointStyle is { } ps && BitChartPointShapes.Build(ps, 7, 7, 5, item.Color, item.Color, 1) is { } marker)
                                    {
                                        <svg class="bit-cht-tt-swt-svg" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                                            <BitChartSvgPrimitive Node="marker" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <span class="bit-cht-tt-swt" style="background:@item.Color"></span>
                                    }
                                }
                                <span>@item.Text</span>
                            </div>
                        }
                        @foreach (var line in tt.AfterBody)
                        {
                            <div class="bit-cht-tt-itm" style="color:@t.BodyColor;font-size:@(BitChartSvg.N(t.BodyFont.Size))px">@line</div>
                        }
                        @if (tt.Footer.Count > 0)
                        {
                            <div class="bit-cht-tt-ftr" style="color:@t.FooterColor;font-weight:@t.FooterFont.Weight;font-size:@(BitChartSvg.N(t.FooterFont.Size))px">
                                @foreach (var line in tt.Footer)
                                {
                                    <div>@line</div>
                                }
                            </div>
                        }
                        @if (t.Caret)
                        {
                            <span class="bit-cht-tt-caret" style="@pos.CaretStyle"></span>
                        }
                    </div>
                }
            }
        </div>

        @if (_scene.Legend is { Position: BitChartPosition.Right })
        {
            @RenderLegend(_scene.Legend)
        }
        @if (_scene.Title is { } rightTitle && TitleSide(rightTitle) == BitChartPosition.Right)
        {
            @RenderTitle(rightTitle, "bit-cht-ttl bit-cht-ttl-v")
        }
    </div>

    @if (_scene.Legend is { Position: BitChartPosition.Bottom })
    {
        @RenderLegend(_scene.Legend)
    }

    @if (_scene.Subtitle is { } subBottom && TitleSide(subBottom) == BitChartPosition.Bottom)
    {
        @RenderTitle(subBottom, "bit-cht-sub")
    }
    @if (_scene.Title is { } titleBottom && TitleSide(titleBottom) == BitChartPosition.Bottom)
    {
        @RenderTitle(titleBottom, "bit-cht-ttl")
    }

    @if (ShowNavigationHint)
    {
        <div class="bit-cht-sr" id="@HintId">@NavigationHint</div>
    }

    @if (GenerateTable)
    {
        @RenderDataTable()
    }

    <div class="bit-cht-sr" aria-live="polite" role="status">@_liveMessage</div>
</div>

@code {
    private RenderFragment RenderTitle(BitChartTitleModel title, string cls) => __builder =>
    {
        var lines = title.Text.Split('\n');
        <div class="@cls" style="color:@title.Color;font-family:@title.Font.Family;font-size:@(BitChartSvg.N(title.Font.Size))px;font-weight:@title.Font.Weight;justify-content:@AlignToFlex(title.Align);padding:@(BitChartSvg.N(title.Padding.Top))px @(BitChartSvg.N(title.Padding.Right))px @(BitChartSvg.N(title.Padding.Bottom))px @(BitChartSvg.N(title.Padding.Left))px">
            <div style="text-align:@TextAlign(title.Align)">
                @for (int i = 0; i < lines.Length; i++)
                {
                    @lines[i]
                    @if (i < lines.Length - 1)
                    {
                        <br />
                    }
                }
            </div>
        </div>
    };

    private RenderFragment RenderPattern(BitChartPatternDef def) => __builder =>
    {
        var p = def.Pattern;
        double s = p.Size;
        <pattern id="@def.Id" patternUnits="userSpaceOnUse" width="@BitChartSvg.N(s)" height="@BitChartSvg.N(s)">
            @if (!string.IsNullOrEmpty(p.Background))
            {
                <rect x="0" y="0" width="@BitChartSvg.N(s)" height="@BitChartSvg.N(s)" fill="@p.Background" />
            }
            @switch (p.Style)
            {
                case BitChartPatternStyle.DiagonalUp:
                    <path d="M 0 @BitChartSvg.N(s) L @BitChartSvg.N(s) 0" stroke="@p.Color" stroke-width="@BitChartSvg.N(p.LineWidth)" />
                    break;
                case BitChartPatternStyle.DiagonalDown:
                    <path d="M 0 0 L @BitChartSvg.N(s) @BitChartSvg.N(s)" stroke="@p.Color" stroke-width="@BitChartSvg.N(p.LineWidth)" />
                    break;
                case BitChartPatternStyle.Horizontal:
                    <line x1="0" y1="@BitChartSvg.N(s / 2)" x2="@BitChartSvg.N(s)" y2="@BitChartSvg.N(s / 2)" stroke="@p.Color" stroke-width="@BitChartSvg.N(p.LineWidth)" />
                    break;
                case BitChartPatternStyle.Vertical:
                    <line x1="@BitChartSvg.N(s / 2)" y1="0" x2="@BitChartSvg.N(s / 2)" y2="@BitChartSvg.N(s)" stroke="@p.Color" stroke-width="@BitChartSvg.N(p.LineWidth)" />
                    break;
                case BitChartPatternStyle.Grid:
                    <path d="M 0 @BitChartSvg.N(s / 2) L @BitChartSvg.N(s) @BitChartSvg.N(s / 2) M @BitChartSvg.N(s / 2) 0 L @BitChartSvg.N(s / 2) @BitChartSvg.N(s)" stroke="@p.Color" stroke-width="@BitChartSvg.N(p.LineWidth)" />
                    break;
                case BitChartPatternStyle.Cross:
                    <path d="M 0 0 L @BitChartSvg.N(s) @BitChartSvg.N(s) M 0 @BitChartSvg.N(s) L @BitChartSvg.N(s) 0" stroke="@p.Color" stroke-width="@BitChartSvg.N(p.LineWidth)" />
                    break;
                case BitChartPatternStyle.Dots:
                    <circle cx="@BitChartSvg.N(s / 2)" cy="@BitChartSvg.N(s / 2)" r="@BitChartSvg.N(p.LineWidth)" fill="@p.Color" />
                    break;
            }
        </pattern>
    };

    private RenderFragment RenderLegend(BitChartLegendModel legend) => __builder =>
    {
        bool vertical = legend.Position is BitChartPosition.Left or BitChartPosition.Right;
        <div class="bit-cht-lgd @(vertical ? "bit-cht-lgd-v" : "bit-cht-lgd-h")"
             role="group" aria-label="@(legend.Title ?? "Chart legend")"
             style="justify-content:@AlignToFlex(legend.Align);gap:4px @(BitChartSvg.N(legend.Labels.Padding))px@(legend.MaxHeight is { } mh ? $";max-height:{BitChartSvg.N(mh)}px;overflow-y:auto" : "")">
            @if (!string.IsNullOrEmpty(legend.Title))
            {
                <div class="bit-cht-lgd-ttl">@legend.Title</div>
            }
            @foreach (var item in legend.Items)
            {
                @* A toggle button: the label is the accessible name and aria-pressed carries the state,
                   so a screen reader announces "Alpha, toggle button, pressed". *@
                <button type="button"
                        class="bit-cht-lgd-itm @(item.Hidden ? "bit-cht-hdn" : "")"
                        disabled="@(legend.OnClickToggle is false && OnLegendItemClick.HasDelegate is false)"
                        aria-pressed="@((!item.Hidden).ToString().ToLowerInvariant())"
                        style="cursor:@(legend.OnClickToggle ? "pointer" : "default");color:@legend.Labels.Color;font-size:@(BitChartSvg.N(legend.Labels.Font.Size))px;font-family:@legend.Labels.Font.Family"
                        @onclick="() => ToggleLegend(item)">
                    @if (item.UsePointStyle)
                    {
                        var marker = BitChartPointShapes.Build(item.PointStyle, 8, 8, 6, item.Color, item.StrokeColor ?? item.Color, 1);
                        <svg class="bit-cht-lgd-mrk" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                            @if (marker is not null)
                            {
                                <BitChartSvgPrimitive Node="marker" />
                            }
                        </svg>
                    }
                    else
                    {
                        <span class="bit-cht-lgd-box" aria-hidden="true" style="background:@item.Color;border-color:@(item.StrokeColor ?? item.Color);width:@(BitChartSvg.N(legend.Labels.BoxWidth))px;height:@(BitChartSvg.N(legend.Labels.BoxHeight))px"></span>
                    }
                    <span class="bit-cht-lgd-txt">@item.Text</span>
                </button>
            }
        </div>
    };

    private RenderFragment RenderDataTable() => __builder =>
    {
        var data = _config.Data;
        <div class="bit-cht-sr">
        <table id="@TableId">
            <caption>@TableCaption</caption>
            @if (HasPointData)
            {
                var budget = MaxTableRows > 0 ? MaxTableRows : int.MaxValue;
                <thead>
                    <tr><th scope="col">Series</th><th scope="col">X</th><th scope="col">Y</th></tr>
                </thead>
                <tbody>
                    @foreach (var ds in data.Datasets)
                    {
                        @if (ds.Points is { } pts)
                        {
                            @foreach (var p in pts.Take(budget))
                            {
                                <tr>
                                    <th scope="row">@(ds.Label ?? "Series")</th>
                                    <td>@Fmt(p.X)</td>
                                    <td>@Fmt(p.Y)</td>
                                </tr>
                            }
                            budget -= Math.Min(budget, pts.Count);
                        }
                    }
                </tbody>
            }
            else
            {
                // Every row renders this many cells, so the header has to as well - a dataset can carry
                // more values than there are category names, and a header short of them shifts the whole
                // row against its labels for a screen reader.
                var columns = Math.Min(TableColumnCount, TableColumnLimit);
                <thead>
                    <tr>
                        <th scope="col">Series</th>
                        @for (int ci = 0; ci < columns; ci++)
                        {
                            <th scope="col">@(ci < data.Labels.Count ? data.Labels[ci] : "")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ds in MaxTableRows > 0 ? data.Datasets.Take(MaxTableRows) : data.Datasets)
                    {
                        <tr>
                            <th scope="row">@(ds.Label ?? "Series")</th>
                            @if (ds.RangeData is { } ranges)
                            {
                                @for (int ci = 0; ci < columns; ci++)
                                {
                                    <td>@(ci < ranges.Count && ranges[ci] is { } rr ? $"{Fmt(rr.Low)}–{Fmt(rr.High)}" : "")</td>
                                }
                            }
                            else
                            {
                                @for (int ci = 0; ci < columns; ci++)
                                {
                                    <td>@CellText(ds, ci)</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            }
        </table>
        </div>
    };
}
