@namespace Bit.BlazorUI
@inherits BitComponentBase

<BitModal AriaLabel="@AriaLabel"
          AriaModal="ProModalParameters.Modeless is false"
          Class="@ClassBuilder.Value"
          Dir="ProModalParameters.Dir"
          @attributes="ProModalParameters.HtmlAttributes"
          Id="@_modalId"
          IsEnabled="ProModalParameters.IsEnabled"
          Style="@StyleBuilder.Value"
          Visibility="Visibility"
          Blocking="ProModalParameters.Blocking"
          Classes="_classes"
          FullHeight="ProModalParameters.FullHeight || ProModalParameters.FullSize"
          FullWidth="ProModalParameters.FullWidth || ProModalParameters.FullSize"
          IsAlert="@(ProModalParameters.IsAlert ?? (ProModalParameters.Blocking && ProModalParameters.Modeless is false))"
          IsOpen="IsOpen"
          IsOpenChanged="HandleInnerIsOpenChanged"
          OnDismiss="ProModalParameters.OnDismiss"
          OnOverlayClick="ProModalParameters.OnOverlayClick"
          ShowOverlay="ProModalParameters.Modeless is false"
          SubtitleAriaId="@ProModalParameters.SubtitleAriaId"
          TitleAriaId="@ProModalParameters.TitleAriaId"
          Styles="_styles">
    @if (ProModalParameters.Header is not null || ProModalParameters.HeaderText is not null || ProModalParameters.ShowCloseButton)
    {
        <div style="@_styles?.HeaderContainer" class="bit-pmd-hcn @_classes?.HeaderContainer">
            @if (ProModalParameters.Header is not null)
            {
                <div style="@_styles?.Header" class="bit-pmd-hdr @_classes?.Header">
                    @ProModalParameters.Header
                </div>
            }
            else if (ProModalParameters.HeaderText is not null)
            {
                <div style="@_styles?.Header" class="bit-pmd-hdr @_classes?.Header">
                    @ProModalParameters.HeaderText
                </div>
            }

            @if (ProModalParameters.ShowCloseButton)
            {
                var closeIcon = BitIconInfo.From(ProModalParameters.CloseIcon, ProModalParameters.CloseIconName ?? "Cancel");

                <button @onclick="CloseModal"
                        type="button"
                        title="@ProModalParameters.CloseButtonTitle"
                        aria-label="@ProModalParameters.CloseButtonTitle"
                        style="@_styles?.CloseButton"
                        class="bit-pmd-cls @_classes?.CloseButton">
                    <i style="@_styles?.CloseIcon"
                       class="@closeIcon?.GetCssClasses() @_classes?.CloseIcon" />
                </button>
            }
        </div>
    }

    <div style="@_styles?.Body" class="bit-pmd-bdy @_classes?.Body">
        @(Body ?? ChildContent)
    </div>

    @if (ProModalParameters.Footer is not null)
    {
        <div style="@_styles?.Footer" class="bit-pmd-fcn @_classes?.Footer">
            @ProModalParameters.Footer
        </div>
    }
    else if (ProModalParameters.FooterText is not null)
    {
        <div style="@_styles?.Footer" class="bit-pmd-fcn @_classes?.Footer">
            @ProModalParameters.FooterText
        </div>
    }
</BitModal>
