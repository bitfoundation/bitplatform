@namespace Bit.BlazorUI
@inherits BitComponentBase

<div @ref="RootElement"
     @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @if (Label is not null || LabelTemplate is not null)
    {
        <label style="@Styles?.Label" class="bit-mde-lbl @Classes?.Label" for="@TextAreaId">
            @if (LabelTemplate is not null)
            {
                @LabelTemplate
            }
            else
            {
                @Label
            }
        </label>
    }

    @if (ShowToolbar)
    {
        <div role="toolbar" aria-label="@ActiveTexts.ToolbarAriaLabel" aria-controls="@TextAreaId"
             style="@Styles?.Toolbar" class="bit-mde-tlb @Classes?.Toolbar">
            @foreach (var item in ActiveToolbar)
            {
                if (item.Type is BitMarkdownEditorToolbarItemType.Separator)
                {
                    <span class="bit-mde-sep" aria-hidden="true"></span>
                }
                else if (item.Type is BitMarkdownEditorToolbarItemType.Dropdown)
                {
                    @* A menu holding the active command says so on its trigger, so the caret's
                       heading level can be read off the closed toolbar. *@
                    <div class="bit-mde-dd">
                        <button type="button"
                                style="@Styles?.ToolbarButton"
                                class="bit-mde-btn @Classes?.ToolbarButton @(IsToolbarItemActive(item) ? "bit-mde-act" : null)"
                                title="@GetToolbarItemTitle(item)"
                                aria-label="@GetToolbarItemLabel(item)"
                                aria-keyshortcuts="@GetToolbarItemKeyShortcuts(item)"
                                aria-haspopup="menu"
                                aria-expanded="false"
                                data-cmd="@item.Name"
                                tabindex="-1"
                                disabled="@IsToolbarItemDisabled(item)">
                            @((MarkupString)item.Icon)
                        </button>
                        <div class="bit-mde-ddm" role="menu" aria-label="@GetToolbarItemLabel(item)">
                            @foreach (var child in item.Children ?? [])
                            {
                                if (child.Type is BitMarkdownEditorToolbarItemType.Separator)
                                {
                                    <div class="bit-mde-msep" role="separator"></div>
                                }
                                else
                                {
                                    @* A menu item that reports a state is a radio: the heading picker's
                                       entries exclude one another, which "checked" says and "pressed"
                                       does not. Everything else is a plain command. *@
                                    <button type="button"
                                            role="@(IsToolbarItemToggle(child) ? "menuitemradio" : "menuitem")"
                                            tabindex="-1"
                                            class="bit-mde-btn bit-mde-mi @(IsToolbarItemActive(child) ? "bit-mde-act" : null)"
                                            title="@GetToolbarItemTitle(child)"
                                            aria-label="@GetToolbarItemLabel(child)"
                                            aria-keyshortcuts="@GetToolbarItemKeyShortcuts(child)"
                                            aria-checked="@(IsToolbarItemToggle(child) ? (IsToolbarItemActive(child) ? "true" : "false") : null)"
                                            data-cmd="@child.Name"
                                            disabled="@IsToolbarItemDisabled(child)"
                                            @onclick="() => OnToolbarItemClick(child)">
                                        @((MarkupString)child.Icon)
                                        @if (child.Text is not null)
                                        {
                                            <span class="bit-mde-mit">@child.Text</span>
                                        }
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
                else
                {
                    <button type="button"
                            style="@Styles?.ToolbarButton"
                            class="bit-mde-btn @Classes?.ToolbarButton @(IsToolbarItemActive(item) ? "bit-mde-act" : null)"
                            title="@GetToolbarItemTitle(item)"
                            aria-label="@GetToolbarItemLabel(item)"
                            aria-keyshortcuts="@GetToolbarItemKeyShortcuts(item)"
                            aria-pressed="@(IsToolbarItemToggle(item) ? (IsToolbarItemActive(item) ? "true" : "false") : null)"
                            data-cmd="@item.Name"
                            tabindex="-1"
                            disabled="@IsToolbarItemDisabled(item)"
                            @onclick="() => OnToolbarItemClick(item)">
                        @((MarkupString)item.Icon)
                    </button>
                }
            }
        </div>
    }

    @if (_showFind)
    {
        <div class="bit-mde-fnd" role="region" aria-label="@ActiveTexts.FindReplaceTitle">
            <input @ref="_findRef"
                   class="bit-mde-fni"
                   placeholder="@ActiveTexts.FindPlaceholder"
                   aria-label="@ActiveTexts.FindPlaceholder"
                   value="@_findText"
                   @oninput="e => OnFindTextChanged(e.Value?.ToString() ?? string.Empty)"
                   @onkeydown="OnFindKeyDown" />
            <input class="bit-mde-fni"
                   placeholder="@ActiveTexts.ReplacePlaceholder"
                   aria-label="@ActiveTexts.ReplacePlaceholder"
                   value="@_replaceText"
                   @oninput="e => _replaceText = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnReplaceKeyDown" />
            <button type="button"
                    class="bit-mde-fnb bit-mde-fnc @(_matchCase ? "bit-mde-act" : null)"
                    aria-pressed="@(_matchCase ? "true" : "false")"
                    title="@ActiveTexts.MatchCaseAriaLabel"
                    aria-label="@ActiveTexts.MatchCaseAriaLabel"
                    @onclick="ToggleMatchCase">Aa</button>
            <button type="button" class="bit-mde-fnb" title="@ActiveTexts.FindPreviousAriaLabel" aria-label="@ActiveTexts.FindPreviousAriaLabel" @onclick="FindPreviousMatch">&uarr;</button>
            <button type="button" class="bit-mde-fnb" title="@ActiveTexts.FindNextAriaLabel" aria-label="@ActiveTexts.FindNextAriaLabel" @onclick="FindNextMatch">&darr;</button>
            <span class="bit-mde-fns" aria-live="polite">@FindStatusText</span>
            <button type="button" class="bit-mde-fnb" @onclick="ReplaceOne" disabled="@(ReadOnly || IsEnabled is false)">@ActiveTexts.ReplaceButton</button>
            <button type="button"
                    class="bit-mde-fnb"
                    title="@ActiveTexts.ReplaceAllAriaLabel"
                    aria-label="@ActiveTexts.ReplaceAllAriaLabel"
                    @onclick="ReplaceAll"
                    disabled="@(ReadOnly || IsEnabled is false)">@ActiveTexts.ReplaceAllButton</button>
            <button type="button" class="bit-mde-hcl" @onclick="CloseFind" aria-label="@ActiveTexts.CloseAriaLabel">&times;</button>
        </div>
    }

    <div class="bit-mde-bdy bit-mde-@Mode.ToString().ToLowerInvariant()">
        <div class="bit-mde-pne bit-mde-epn">
            <textarea @ref="_textAreaRef"
                      id="@TextAreaId"
                      style="@Styles?.TextArea"
                      class="bit-mde-txa @Classes?.TextArea"
                      placeholder="@Placeholder"
                      aria-label="@TextAreaAriaLabel"
                      aria-describedby="@TextAreaDescribedBy"
                      maxlength="@(MaxLength is > 0 ? MaxLength : null)"
                      spellcheck="@(SpellCheck ? "true" : "false")"
                      readonly="@(ReadOnly || IsEnabled is false)"
                      autocomplete="off"
                      autocapitalize="off"
                      autocorrect="off"
                      @onfocus="() => OnFocus.InvokeAsync()"
                      @onblur="() => OnBlur.InvokeAsync()"></textarea>
        </div>

        @* The preview pane scrolls on its own, so it needs to be reachable by keyboard
           for the arrow keys to be able to scroll it. *@
        <div style="@Styles?.Preview"
             class="bit-mde-pne bit-mde-ppn @Classes?.Preview"
             tabindex="0"
             role="group"
             aria-label="@ActiveTexts.PreviewAriaLabel">
            @* Edit mode hides this pane, and rendering markdown nobody can see would re-parse the
               whole document on every keystroke for nothing. *@
            @if (Mode is BitMarkdownEditorMode.Edit)
            {
            }
            else if (PreviewTemplate is not null)
            {
                @PreviewTemplate(_previewValue)
            }
            else if (string.IsNullOrWhiteSpace(_previewValue))
            {
                <div class="bit-mde-emp">@ActiveTexts.PreviewEmptyText</div>
            }
            else
            {
                <BitMarkdownViewer Markdown="@_previewValue" Pipeline="@(PreviewPipeline ?? BitMarkdownPipelines.GitHub)" />
            }
        </div>
    </div>

    @if (ShowStatusBar)
    {
        <div style="@Styles?.StatusBar" class="bit-mde-sbr @Classes?.StatusBar">
            <span class="bit-mde-mod">@ActiveTexts.GetModeLabel(Mode)</span>
            @if (ShowCursorPosition)
            {
                <span class="bit-mde-pos">@CursorPositionText</span>
                @if (_selectedLength > 0)
                {
                    <span class="bit-mde-pos">@SelectedText</span>
                }
            }
            <span class="bit-mde-spc"></span>
            <span>@string.Format(ActiveTexts.WordsFormat, WordCount)</span>
            <span id="@CounterId" class="@(IsAtLimit ? "bit-mde-lim" : null)">@CharCountText</span>
            @if (ShowReadingTime)
            {
                <span>@string.Format(ActiveTexts.ReadingTimeFormat, ReadingMinutes)</span>
            }
        </div>
    }

    @if (_showHelp)
    {
        <div class="bit-mde-hlp" @onclick="CloseHelp">
            <div @ref="_helpRef"
                 role="dialog"
                 aria-modal="true"
                 aria-label="@ActiveTexts.KeyboardShortcutsTitle"
                 tabindex="-1"
                 class="bit-mde-hcr"
                 @onkeydown="OnHelpKeyDown"
                 @onclick:stopPropagation="true">
                <span tabindex="0" class="bit-mde-guard" @onfocus="FocusHelpClose"></span>
                <header>
                    <strong>@ActiveTexts.KeyboardShortcutsTitle</strong>
                    <button type="button" @ref="_helpCloseRef" class="bit-mde-hcl" @onclick="CloseHelp" aria-label="@ActiveTexts.CloseAriaLabel">&times;</button>
                </header>
                <dl>
                    @foreach (var (label, keys) in HelpShortcuts)
                    {
                        <div><dt>@label</dt><dd>@keys</dd></div>
                    }
                </dl>
                <span tabindex="0" class="bit-mde-guard" @onfocus="FocusHelpClose"></span>
            </div>
        </div>
    }
</div>
