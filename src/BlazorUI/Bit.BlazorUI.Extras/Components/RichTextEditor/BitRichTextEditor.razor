        <button type="button" class="bit-rte-btn @Classes?.Button @(_showFind ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Loc("find-replace", "Find & replace")" aria-label="@Loc("find-replace-label", "Find and replace")" aria-expanded="@(_showFind ? "true" : "false")" aria-controls="@(_showFind ? $"{UniqueId}-find-panel" : null)" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick="ToggleFind">@BitRichTextEditorIcons.Find</button>
    </div>;

    private RenderFragment SourceGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
        <button type="button" class="bit-rte-btn @Classes?.Button @(_inSourceView ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Loc("source", "HTML source")" aria-label="@Loc("source-label", "HTML source view")" aria-pressed="@(_inSourceView ? "true" : "false")" disabled="@(IsEnabled is false || (EffectiveReadOnly && _inSourceView is false))"
                @onmousedown:preventDefault="true" @onclick="OnSourceToggleClick">@BitRichTextEditorIcons.Source</button>
    </div>;

    private RenderFragment FullScreenGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
        <button type="button" class="bit-rte-btn @Classes?.Button @(_fullScreen ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Loc("full-screen", "Full screen")" aria-label="@Loc("full-screen-label", "Toggle full screen")" aria-pressed="@(_fullScreen ? "true" : "false")"
                @onmousedown:preventDefault="true" @onclick="ToggleFullScreen">@(_fullScreen ? BitRichTextEditorIcons.ExitFullScreen : BitRichTextEditorIcons.FullScreen)</button>
    </div>;

    private RenderFragment ClearGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
        <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" title="@Loc("clear-formatting", "Clear formatting")" aria-label="@Loc("clear-formatting", "Clear formatting")" aria-keyshortcuts="@ShortcutFor("removeFormat")" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick="ClearFormattingAsync">@BitRichTextEditorIcons.ClearFormatting</button>
    </div>;
}
