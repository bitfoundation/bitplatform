@namespace Bit.BlazorUI
@inherits BitComponentBase

<div @ref="RootElement"
     @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @if (Label is not null)
    {
        @* A contenteditable surface cannot be the target of a <label for>, so the label names it through
           aria-labelledby and a click on it moves the focus into the text. *@
        <div id="@LabelId"
             class="bit-rte-lbl@(Required ? " bit-rte-req" : null) @Classes?.Label"
             style="@Styles?.Label"
             @onclick="() => FocusAsync().AsTask()">@Label</div>
    }

    @if (ShowToolbar)
    {
        <div @ref="_toolbarRef" role="toolbar" aria-label="@Loc("toolbar", "Formatting")"
             style="@Styles?.Toolbar" class="bit-rte-tlb @Classes?.Toolbar">
            @foreach (var id in OrderedToolbarIds())
            {
                @RenderGroup(id)
            }
        </div>
    }

    @* The tool panels are not part of the toolbar: they are opened by a shortcut or the floating
       selection toolbar just as often as by a toolbar button, so a chrome-free surface
       (ShowToolbar="false") can still link, embed or search. Each one still requires its own
       toolbar group to be enabled. *@
    @if (_showLinkInput && Has(BitRichTextEditorToolbar.Link) && ControlsDisabled is false)
    {
        <div class="bit-rte-bar @Classes?.Panel" style="@Styles?.Panel" id="@($"{UniqueId}-link-panel")"
             role="group" aria-label="@Loc("link-label", "Insert or edit link")"
             @onkeydown="e => OnPanelKeyDown(e, CloseLinkInput)">
            <input type="url" class="bit-rte-inp" aria-label="@Loc("link-url", "Link URL")"
                   placeholder="@Loc("link-url-placeholder", "https://example.com")"
                   @ref="_linkInputRef"
                   @bind="_linkUrl" @bind:event="oninput"
                   @onkeydown="OnLinkKeyDown" />
            @if (_state.InLink is false)
            {
                <input type="text" class="bit-rte-inp" aria-label="@Loc("link-text", "Link text")"
                       placeholder="@Loc("link-text-placeholder", "Text to display (optional)")"
                       @bind="_linkText" @bind:event="oninput"
                       @onkeydown="OnLinkKeyDown" />
            }
            <label class="bit-rte-opt">
                <input type="checkbox" @bind="_linkNewTab" />
                @Loc("link-new-tab", "Open in a new tab")
            </label>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="ApplyLinkAsync">@Loc("apply", "Apply")</button>
            @if (_state.InLink)
            {
                if (OpenableLinkHref is { } href)
                {
                    @* A link inside the editable text cannot be followed, so the panel offers it. *@
                    <a class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button"
                       href="@href" target="_blank" rel="noopener noreferrer">@Loc("open-link", "Open")</a>
                }
                <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="RemoveLinkAsync">@Loc("remove", "Remove")</button>
            }
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="CloseLinkInput">@Loc("cancel", "Cancel")</button>
        </div>
    }

    @if (_showImageInput && Has(BitRichTextEditorToolbar.Image) && ControlsDisabled is false)
    {
        <div class="bit-rte-bar @Classes?.Panel" style="@Styles?.Panel" id="@($"{UniqueId}-image-panel")"
             role="group" aria-label="@(_state.ImageSelected ? Loc("edit-image", "Edit image") : Loc("insert-image", "Insert image"))"
             @onkeydown="e => OnPanelKeyDown(e, CloseImageInput)">
            <input type="url" class="bit-rte-inp" aria-label="@Loc("image-url", "Image URL")"
                   placeholder="@Loc("image-url-placeholder", "https://example.com/image.png")"
                   @ref="_imageInputRef"
                   @bind="_imageUrl" @bind:event="oninput"
                   @onkeydown="OnImageKeyDown" />
            <input type="text" class="bit-rte-inp" aria-label="@Loc("image-alt", "Alternative text")"
                   placeholder="@Loc("image-alt-placeholder", "Alternative text")"
                   @bind="_imageAlt" @bind:event="oninput"
                   @onkeydown="OnImageKeyDown" />
            <label class="bit-rte-opt">
                @Loc("image-width", "Width (px)")
                <input type="number" class="bit-rte-num" min="16" step="1"
                       placeholder="@Loc("image-width-auto", "Auto")"
                       @bind="_imageWidth" @bind:event="oninput"
                       @onkeydown="OnImageKeyDown" />
            </label>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="ApplyImageAsync">@(_state.ImageSelected ? Loc("update", "Update") : Loc("insert", "Insert"))</button>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="CloseImageInput">@Loc("cancel", "Cancel")</button>
        </div>
    }

    @if (_showMediaInput && Has(BitRichTextEditorToolbar.Media) && ControlsDisabled is false)
    {
        <div class="bit-rte-bar @Classes?.Panel" style="@Styles?.Panel" id="@($"{UniqueId}-media-panel")"
             role="group" aria-label="@Loc("embed-media", "Embed media")"
             @onkeydown="e => OnPanelKeyDown(e, CloseMediaInput)">
            <input type="url" class="bit-rte-inp" aria-label="@Loc("media-url", "Media URL")"
                   placeholder="@Loc("media-url-placeholder", "https://youtube.com/watch?v=...")"
                   @ref="_mediaInputRef"
                   @bind="_mediaUrl" @bind:event="oninput"
                   @onkeydown="OnMediaKeyDown" />
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="ApplyMediaAsync">@Loc("embed", "Embed")</button>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="CloseMediaInput">@Loc("cancel", "Cancel")</button>
        </div>
    }

    @if (_showTableInput && Has(BitRichTextEditorToolbar.Table) && ControlsDisabled is false)
    {
        <div class="bit-rte-bar @Classes?.Panel" style="@Styles?.Panel" id="@($"{UniqueId}-table-panel")"
             role="group" aria-label="@Loc("insert-table-label", "Insert table")"
             @onkeydown="e => OnPanelKeyDown(e, CloseTableInput)">
            <label class="bit-rte-opt">
                @Loc("rows", "Rows")
                <input type="number" class="bit-rte-num" min="1" max="50"
                       @ref="_tableRowsRef"
                       @bind="_tableRows" @bind:event="oninput"
                       @onkeydown="OnTableKeyDown" />
            </label>
            <label class="bit-rte-opt">
                @Loc("columns", "Columns")
                <input type="number" class="bit-rte-num" min="1" max="50"
                       @bind="_tableCols" @bind:event="oninput"
                       @onkeydown="OnTableKeyDown" />
            </label>
            <label class="bit-rte-opt">
                <input type="checkbox" @bind="_tableHeader" />
                @Loc("header-row", "Header row")
            </label>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="ApplyTableAsync">@Loc("insert", "Insert")</button>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="CloseTableInput">@Loc("cancel", "Cancel")</button>
        </div>
    }

    @if (_showFind && Has(BitRichTextEditorToolbar.Find) && ControlsDisabled is false)
    {
        <div class="bit-rte-bar @Classes?.Panel" style="@Styles?.Panel" id="@($"{UniqueId}-find-panel")"
             role="search" aria-label="@Loc("find-replace-label", "Find and replace")"
             @onkeydown="e => OnPanelKeyDown(e, CloseFind)">
            <input type="text" class="bit-rte-inp" aria-label="@Loc("find", "Find")" placeholder="@Loc("find", "Find")"
                   @ref="_findInputRef"
                   @bind="_findTerm" @bind:event="oninput" @bind:after="RunFindAsync"
                   @onkeydown="OnFindKeyDown" />
            <input type="text" class="bit-rte-inp" aria-label="@Loc("replace-with", "Replace with")" placeholder="@Loc("replace-with", "Replace with")"
                   @bind="_replaceTerm" @bind:event="oninput"
                   @onkeydown="OnReplaceKeyDown" />
            <label class="bit-rte-opt" title="@Loc("match-case", "Match case")">
                <input type="checkbox" aria-label="@Loc("match-case", "Match case")" @bind="_findCaseSensitive" @bind:after="RunFindAsync" />
                <span aria-hidden="true">Aa</span>
            </label>
            <label class="bit-rte-opt" title="@Loc("whole-word", "Whole word")">
                <input type="checkbox" aria-label="@Loc("whole-word", "Whole word")" @bind="_findWholeWord" @bind:after="RunFindAsync" />
                <span aria-hidden="true">ab|</span>
            </label>
            <span class="bit-rte-find-count" role="status" aria-live="polite">@_findCount</span>
            <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" title="@Loc("find-previous", "Previous match")" aria-label="@Loc("find-previous", "Previous match")" @onclick="() => StepFindAsync(-1)">@BitRichTextEditorIcons.Previous</button>
            <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" title="@Loc("find-next", "Next match")" aria-label="@Loc("find-next", "Next match")" @onclick="() => StepFindAsync(1)">@BitRichTextEditorIcons.Next</button>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="ReplaceCurrentAsync">@Loc("replace", "Replace")</button>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" aria-label="@Loc("replace-all", "Replace all")" @onclick="ReplaceAllAsync">@Loc("all", "All")</button>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="CloseFind">@Loc("close", "Close")</button>
        </div>
    }

    @if (_showEmoji && Has(BitRichTextEditorToolbar.Emoji) && ControlsDisabled is false)
    {
        <div @ref="_emojiPanelRef" class="bit-rte-emoji-panel @Classes?.Panel" style="@Styles?.Panel" id="@($"{UniqueId}-emoji-panel")"
             role="group" aria-label="@Loc("emoji-label", "Insert emoji")"
             @onkeydown="e => OnPanelKeyDown(e, CloseEmoji)">
            <input type="text" class="bit-rte-inp" aria-label="@Loc("search-emoji", "Search emoji")"
                   placeholder="@Loc("search", "Search")"
                   @ref="_emojiSearchRef"
                   @bind="_emojiSearch" @bind:event="oninput" />
            @{ var emojiGroups = FilteredEmojiGroups().ToArray(); }
            <div class="bit-rte-emoji-scroll">
                @foreach (var group in emojiGroups)
                {
                    <div class="bit-rte-emoji-group" role="group" aria-label="@Loc(group.Key, DefaultEmojiGroupLabel(group.Key))">
                        <div class="bit-rte-emoji-head" aria-hidden="true">@Loc(group.Key, DefaultEmojiGroupLabel(group.Key))</div>
                        <div class="bit-rte-emoji-grid">
                            @foreach (var emo in group)
                            {
                                <button type="button" class="bit-rte-emoji" title="@emo.Name" aria-label="@emo.Name"
                                        @onmousedown:preventDefault="true" @onclick="() => InsertEmojiAsync(emo.Char)">@emo.Char</button>
                            }
                        </div>
                    </div>
                }
                @if (emojiGroups.Length == 0)
                {
                    <span class="bit-rte-emoji-empty" role="status">@Loc("no-matches", "No matches")</span>
                }
            </div>
        </div>
    }

    @if (_showColor && HasColorPalette && Has(BitRichTextEditorToolbar.Color) && ControlsDisabled is false)
    {
        <div @ref="_colorPanelRef" class="bit-rte-bar @Classes?.Panel" style="@Styles?.Panel" id="@($"{UniqueId}-color-panel")"
             role="group" aria-label="@ColorPanelLabel"
             @onkeydown="e => OnPanelKeyDown(e, CloseColor)">
            <div class="bit-rte-swatches">
                @* The first swatch is where the focus lands as the panel opens; only it is captured. *@
                @for (var i = 0; i < ColorPalette!.Count; i++)
                {
                    var color = ColorPalette[i];
                    if (i == 0)
                    {
                        <button @ref="_firstSwatchRef" @attributes="SwatchAttributes(color)"
                                @onmousedown:preventDefault="true" @onclick="() => PickColorAsync(color.Value)"></button>
                    }
                    else
                    {
                        <button @attributes="SwatchAttributes(color)"
                                @onmousedown:preventDefault="true" @onclick="() => PickColorAsync(color.Value)"></button>
                    }
                }
            </div>
            <label class="bit-rte-opt">
                @Loc("custom-color", "Custom")
                <input type="color" value="@(CurrentColor ?? (_colorKind == "back" ? "#ffff00" : "#000000"))"
                       @onchange="e => PickColorAsync(e.Value?.ToString())" />
            </label>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="RemovePickedColorAsync">@Loc("remove", "Remove")</button>
            <button type="button" class="bit-rte-btn bit-rte-pbt @Classes?.Button" style="@Styles?.Button" @onclick="CloseColor">@Loc("cancel", "Cancel")</button>
        </div>
    }

    @if (_inlineError is not null)
    {
        <div class="bit-rte-err @Classes?.Error" style="@Styles?.Error" id="@($"{UniqueId}-error")" role="alert">@_inlineError</div>
    }

    @if (_showSlash && ControlsDisabled is false)
    {
        <div class="bit-rte-slash @Classes?.Menu" style="@Styles?.Menu">
            <input type="text" class="bit-rte-inp" aria-label="@Loc("filter-commands", "Filter commands")"
                   placeholder="@Loc("filter-commands", "Filter commands…")"
                   @ref="_slashInputRef"
                   role="combobox"
                   aria-expanded="true"
                   aria-autocomplete="list"
                   aria-controls="@($"{UniqueId}-slash-list")"
                   aria-activedescendant="@(FilteredSlash().Any() ? $"{UniqueId}-slash-item-{_slashIndex}" : null)"
                   value="@_slashFilter" @oninput="OnSlashFilterInput"
                   @onkeydown="OnSlashKeyDownAsync" />
            <div class="bit-rte-slash-list" role="listbox" id="@($"{UniqueId}-slash-list")" aria-label="@Loc("filter-commands", "Filter commands")">
                @{ var _slashItemIndex = 0; }
                @foreach (var c in FilteredSlash())
                {
                    var _itemIndex = _slashItemIndex++;
                    <button type="button" id="@($"{UniqueId}-slash-item-{_itemIndex}")"
                            role="option"
                            tabindex="-1"
                            aria-selected="@((_itemIndex == _slashIndex).ToString().ToLowerInvariant())"
                            class="bit-rte-slash-item@(_itemIndex == _slashIndex ? " bit-rte-slash-item-sel" : null)"
                            @onmousedown:preventDefault="true" @onclick="() => ApplySlashAsync(c.Command)">@Loc(c.Key, c.Label)</button>
                }
            </div>
            @if (FilteredSlash().Any() is false)
            {
                <div class="bit-rte-emoji-empty" role="status">@Loc("no-command", "No matching command")</div>
            }
        </div>
    }

    @if (_showMention && ControlsDisabled is false)
    {
        <div class="bit-rte-slash bit-rte-mention-menu @Classes?.Menu" style="@Styles?.Menu">
            <input type="text" class="bit-rte-inp" aria-label="@Loc("mention-filter", "Search people")"
                   placeholder="@Loc("mention-filter-placeholder", "Search people…")"
                   @ref="_mentionInputRef"
                   role="combobox"
                   aria-expanded="true"
                   aria-autocomplete="list"
                   aria-controls="@($"{UniqueId}-mention-list")"
                   aria-activedescendant="@(_mentionItems.Count > 0 ? $"{UniqueId}-mention-item-{_mentionIndex}" : null)"
                   value="@_mentionFilter" @oninput="OnMentionFilterInput"
                   @onkeydown="OnMentionKeyDownAsync" />
            <div class="bit-rte-slash-list" role="listbox" id="@($"{UniqueId}-mention-list")" aria-label="@Loc("mention-filter", "Search people")">
                @for (var i = 0; i < _mentionItems.Count; i++)
                {
                    var index = i;
                    var mention = _mentionItems[index];
                    <button type="button" id="@($"{UniqueId}-mention-item-{index}")"
                            role="option"
                            tabindex="-1"
                            aria-selected="@((index == _mentionIndex) ? "true" : "false")"
                            class="bit-rte-slash-item@(index == _mentionIndex ? " bit-rte-slash-item-sel" : null)"
                            @onmousedown:preventDefault="true" @onclick="() => ApplyMentionAsync(mention)">
                        <span class="bit-rte-mention-name">@mention.Display</span>
                        @if (string.IsNullOrEmpty(mention.Description) is false)
                        {
                            <span class="bit-rte-mention-desc">@mention.Description</span>
                        }
                    </button>
                }
            </div>
            @if (_mentionItems.Count == 0)
            {
                <div class="bit-rte-emoji-empty" role="status">@Loc("no-mention", "No matches")</div>
            }
        </div>
    }

    @if (ShowingQuickToolbar)
    {
        <div class="bit-rte-quick @Classes?.QuickToolbar" role="toolbar" style="@($"{QuickToolbarStyle};{Styles?.QuickToolbar}")"
             aria-label="@Loc("quick-toolbar", "Selection formatting")">
            <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Bold ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Loc("bold", "Bold (Ctrl+B)")" aria-label="@Loc("bold-label", "Bold")" aria-keyshortcuts="@ShortcutFor("bold")" aria-pressed="@(_state.Bold ? "true" : "false")"
                    @onmousedown:preventDefault="true" @onclick='() => ExecAsync("bold")'>@BitRichTextEditorIcons.Bold</button>
            <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Italic ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Loc("italic", "Italic (Ctrl+I)")" aria-label="@Loc("italic-label", "Italic")" aria-keyshortcuts="@ShortcutFor("italic")" aria-pressed="@(_state.Italic ? "true" : "false")"
                    @onmousedown:preventDefault="true" @onclick='() => ExecAsync("italic")'>@BitRichTextEditorIcons.Italic</button>
            <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Underline ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Loc("underline", "Underline (Ctrl+U)")" aria-label="@Loc("underline-label", "Underline")" aria-keyshortcuts="@ShortcutFor("underline")" aria-pressed="@(_state.Underline ? "true" : "false")"
                    @onmousedown:preventDefault="true" @onclick='() => ExecAsync("underline")'>@BitRichTextEditorIcons.Underline</button>
            <button type="button" class="bit-rte-btn @Classes?.Button @(_state.InlineCode ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Loc("inline-code", "Inline code (Ctrl+E)")" aria-label="@Loc("inline-code-label", "Inline code")" aria-keyshortcuts="@ShortcutFor("inlineCode")" aria-pressed="@(_state.InlineCode ? "true" : "false")"
                    @onmousedown:preventDefault="true" @onclick='() => ExecAsync("inlineCode")'>@BitRichTextEditorIcons.InlineCode</button>
            @if (Has(BitRichTextEditorToolbar.Link))
            {
                <button type="button" class="bit-rte-btn @Classes?.Button @(_state.InLink ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Loc("link", "Insert/edit link (Ctrl+K)")" aria-label="@Loc("link-label", "Insert or edit link")" aria-keyshortcuts="@ShortcutFor("link")" aria-pressed="@(_state.InLink ? "true" : "false")"
                        @onmousedown:preventDefault="true" @onclick="ToggleLinkInput">@BitRichTextEditorIcons.Link</button>
            }
            <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" title="@Loc("clear-formatting", "Clear formatting")" aria-label="@Loc("clear-formatting", "Clear formatting")"
                    @onmousedown:preventDefault="true" @onclick="ClearFormattingAsync">@BitRichTextEditorIcons.ClearFormatting</button>
        </div>
    }

    @* A non-editable div is not focusable, so a read-only editor would be unreachable by keyboard -
       its content unable to be scrolled or read out. The surface below therefore gets a tab stop
       while read-only, unless the whole component is disabled, where nothing inside it should take
       focus. A visible Label names it in place of the aria-label. *@
    <div class="bit-rte-edt @(Resizable ? "bit-rte-edt-rsz" : null) @Classes?.Editor"
         @ref="_editorRef"
         role="textbox"
         aria-multiline="true"
         aria-label="@(Label is null ? (AriaLabel ?? Loc("editor", "Rich text editor")) : null)"
         aria-labelledby="@(Label is null ? null : LabelId)"
         aria-readonly="@(EffectiveReadOnly ? "true" : null)"
         aria-disabled="@(IsEnabled ? null : "true")"
         aria-required="@(Required ? "true" : null)"
         aria-invalid="@(IsInvalid ? "true" : null)"
         aria-placeholder="@Placeholder"
         aria-describedby="@SurfaceDescribedBy"
         spellcheck="@SpellCheck.ToString().ToLowerInvariant()"
         contenteditable="@((EffectiveReadOnly is false && _inSourceView is false).ToString().ToLowerInvariant())"
         tabindex="@(ReadOnly && IsEnabled && _inSourceView is false ? "0" : null)"
         data-placeholder="@Placeholder"
         hidden="@_inSourceView"
         style="@Styles?.Editor"></div>

    @if (_inSourceView)
    {
        <textarea class="bit-rte-src @Classes?.Source" style="@Styles?.Source"
                  @ref="_sourceRef"
                  aria-label="@Loc("source-view", "HTML source")"
                  aria-invalid="@(IsInvalid ? "true" : null)"
                  aria-describedby="@SurfaceDescribedBy"
                  spellcheck="false"
                  readonly="@EffectiveReadOnly"
                  disabled="@(IsEnabled is false)"
                  value="@_sourceText" @oninput="OnSourceTextChanged"></textarea>
    }

    @if (ErrorMessage.HasValue())
    {
        @* No live role of its own: the status region at the end of the root says it once as it appears, and the
           surface is described by it on every later focus, so it is never read out twice. *@
        <div id="@ErrorMessageId" class="bit-rte-erm @Classes?.ErrorMessage" style="@Styles?.ErrorMessage">@ErrorMessage</div>
    }

    @if (Description.HasValue() || ShowCount)
    {
        @* One row for the helper text and the counts, the way a text field lays them out. Both describe the surface
           (read with it on focus) rather than being live regions, which would read the counts out after every pause in
           typing; only reaching the limit is announced. *@
        <div class="bit-rte-ftr">
            @if (Description.HasValue())
            {
                <div id="@DescriptionId" class="bit-rte-dsc @Classes?.Description" style="@Styles?.Description">@Description</div>
            }
            @if (ShowCount)
            {
                <div class="bit-rte-cnt @Classes?.Count" style="@Styles?.Count" id="@($"{UniqueId}-count")">
                    @CountLabel()
                    <span class="bit-rte-cnt-over" role="status">@(MaxLength is int m && _facts.CharacterCount >= m ? Loc("limit-reached", "limit reached") : null)</span>
                </div>
            }
        </div>
    }

    <span class="bit-rte-ann" role="status">@_announcement</span>
</div>

@code {
    private RenderFragment RenderGroup(string id) => builder =>
    {
        switch (id)
        {
            case "history": builder.AddContent(0, HistoryGroup); break;
            case "blockformat": builder.AddContent(0, BlockFormatGroup); break;
            case "font": builder.AddContent(0, FontGroup); break;
            case "inline": builder.AddContent(0, InlineGroup); break;
            case "color": builder.AddContent(0, ColorGroup); break;
            case "script": builder.AddContent(0, ScriptGroup); break;
            case "lists": builder.AddContent(0, ListsGroup); break;
            case "indent": builder.AddContent(0, IndentGroup); break;
            case "blocks": builder.AddContent(0, BlocksGroup); break;
            case "link": builder.AddContent(0, LinkGroup); break;
            case "media": builder.AddContent(0, MediaGroup); break;
            case "image": builder.AddContent(0, ImageGroup); break;
            case "table": builder.AddContent(0, TableGroup); break;
            case "rule": builder.AddContent(0, RuleGroup); break;
            case "alignment": builder.AddContent(0, AlignmentGroup); break;
            case "direction": builder.AddContent(0, DirectionGroup); break;
            case "emoji": builder.AddContent(0, EmojiGroup); break;
            case "find": builder.AddContent(0, FindGroup); break;
            case "source": builder.AddContent(0, SourceGroup); break;
            case "fullscreen": builder.AddContent(0, FullScreenGroup); break;
            case "clear": builder.AddContent(0, ClearGroup); break;
            default: RenderCustomItem(builder, id); break;
        }
    };

    private RenderFragment HistoryGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
        <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" title="@Loc("undo", "Undo (Ctrl+Z)")" aria-label="@Loc("undo-label", "Undo")" aria-keyshortcuts="@ShortcutFor("undo")" disabled="@ControlsDisabled"
