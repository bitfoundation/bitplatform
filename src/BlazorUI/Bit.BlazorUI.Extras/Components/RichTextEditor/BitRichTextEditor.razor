@namespace Bit.BlazorUI
@inherits BitComponentBase

<div @ref="RootElement"
     @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @if (ShowToolbar)
    {
        <div @ref="_toolbarRef" role="toolbar" aria-label="@Label("toolbar", "Formatting")"
             style="@Styles?.Toolbar" class="bit-rte-tlb @Classes?.Toolbar">
            @foreach (var id in OrderedToolbarIds())
            {
                @RenderGroup(id)
            }
        </div>

        @if (_showLinkInput && Has(BitRichTextEditorToolbar.Link) && ControlsDisabled is false)
        {
            <div class="bit-rte-bar" id="@($"{UniqueId}-link-panel")">
                <input type="url" class="bit-rte-inp" aria-label="@Label("link-url", "Link URL")"
                       placeholder="@Label("link-url-placeholder", "https://example.com")"
                       @ref="_linkInputRef"
                       @bind="_linkUrl" @bind:event="oninput"
                       @onkeydown="OnLinkKeyDown" />
                @if (_state.InLink is false)
                {
                    <input type="text" class="bit-rte-inp" aria-label="@Label("link-text", "Link text")"
                           placeholder="@Label("link-text-placeholder", "Text to display (optional)")"
                           @bind="_linkText" @bind:event="oninput"
                           @onkeydown="OnLinkKeyDown" />
                }
                <label class="bit-rte-find-opt" title="@Label("link-new-tab", "Open in a new tab")">
                    <input type="checkbox" aria-label="@Label("link-new-tab", "Open in a new tab")" @bind="_linkNewTab" />
                    @Label("new-tab", "New tab")
                </label>
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ApplyLinkAsync">@Label("apply", "Apply")</button>
                @if (_state.InLink)
                {
                    <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="RemoveLinkAsync">@Label("remove", "Remove")</button>
                }
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ToggleLinkInput">@Label("cancel", "Cancel")</button>
            </div>
        }

        @if (_showImageInput && Has(BitRichTextEditorToolbar.Image) && ControlsDisabled is false)
        {
            <div class="bit-rte-bar" id="@($"{UniqueId}-image-panel")">
                <input type="url" class="bit-rte-inp" aria-label="@Label("image-url", "Image URL")"
                       placeholder="@Label("image-url-placeholder", "https://example.com/image.png")"
                       @ref="_imageInputRef"
                       @bind="_imageUrl" @bind:event="oninput"
                       @onkeydown="OnImageKeyDown" />
                <input type="text" class="bit-rte-inp" aria-label="@Label("image-alt", "Alternative text")"
                       placeholder="@Label("image-alt-placeholder", "Alternative text")"
                       @bind="_imageAlt" @bind:event="oninput"
                       @onkeydown="OnImageKeyDown" />
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ApplyImageUrlAsync">@Label("insert", "Insert")</button>
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ToggleImageInput">@Label("cancel", "Cancel")</button>
            </div>
        }

        @if (_showMediaInput && Has(BitRichTextEditorToolbar.Media) && ControlsDisabled is false)
        {
            <div class="bit-rte-bar" id="@($"{UniqueId}-media-panel")">
                <input type="url" class="bit-rte-inp" aria-label="@Label("media-url", "Media URL")"
                       placeholder="@Label("media-url-placeholder", "https://youtube.com/watch?v=...")"
                       @ref="_mediaInputRef"
                       @bind="_mediaUrl" @bind:event="oninput"
                       @onkeydown="OnMediaKeyDown" />
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ApplyMediaAsync">@Label("embed", "Embed")</button>
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ToggleMediaInput">@Label("cancel", "Cancel")</button>
            </div>
        }

        @if (_showTableInput && Has(BitRichTextEditorToolbar.Table) && ControlsDisabled is false)
        {
            <div class="bit-rte-bar" id="@($"{UniqueId}-table-panel")">
                <label class="bit-rte-find-opt">
                    @Label("rows", "Rows")
                    <input type="number" class="bit-rte-num" min="1" max="50" aria-label="@Label("rows", "Rows")"
                           @ref="_tableRowsRef"
                           @bind="_tableRows" @bind:event="oninput"
                           @onkeydown="OnTableKeyDown" />
                </label>
                <label class="bit-rte-find-opt">
                    @Label("columns", "Columns")
                    <input type="number" class="bit-rte-num" min="1" max="50" aria-label="@Label("columns", "Columns")"
                           @bind="_tableCols" @bind:event="oninput"
                           @onkeydown="OnTableKeyDown" />
                </label>
                <label class="bit-rte-find-opt">
                    <input type="checkbox" aria-label="@Label("header-row", "Header row")" @bind="_tableHeader" />
                    @Label("header-row", "Header row")
                </label>
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ApplyTableAsync">@Label("insert", "Insert")</button>
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ToggleTableInput">@Label("cancel", "Cancel")</button>
            </div>
        }

        @if (_showFind && Has(BitRichTextEditorToolbar.Find) && ControlsDisabled is false)
        {
            <div class="bit-rte-bar" id="@($"{UniqueId}-find-panel")">
                <input type="text" class="bit-rte-inp" aria-label="@Label("find", "Find")" placeholder="@Label("find", "Find")"
                       @ref="_findInputRef"
                       @bind="_findTerm" @bind:event="oninput" @bind:after="RunFindAsync"
                       @onkeydown="OnFindKeyDown" />
                <input type="text" class="bit-rte-inp" aria-label="@Label("replace-with", "Replace with")" placeholder="@Label("replace-with", "Replace with")"
                       @bind="_replaceTerm" @bind:event="oninput" />
                <label class="bit-rte-find-opt" title="@Label("match-case", "Match case")"><input type="checkbox" aria-label="@Label("match-case", "Match case")" @bind="_findCaseSensitive" @bind:after="RunFindAsync" /> Aa</label>
                <label class="bit-rte-find-opt" title="@Label("whole-word", "Whole word")"><input type="checkbox" aria-label="@Label("whole-word", "Whole word")" @bind="_findWholeWord" @bind:after="RunFindAsync" /> ab|</label>
                <span class="bit-rte-find-count" role="status" aria-live="polite">@_findCount</span>
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" title="@Label("find-previous", "Previous match")" aria-label="@Label("find-previous", "Previous match")" @onclick="() => StepFindAsync(-1)">↑</button>
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" title="@Label("find-next", "Next match")" aria-label="@Label("find-next", "Next match")" @onclick="() => StepFindAsync(1)">↓</button>
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ReplaceCurrentAsync">@Label("replace", "Replace")</button>
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ReplaceAllAsync">@Label("all", "All")</button>
                <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" @onclick="ToggleFind">@Label("close", "Close")</button>
            </div>
        }

        @if (_showEmoji && Has(BitRichTextEditorToolbar.Emoji) && ControlsDisabled is false)
        {
            <div class="bit-rte-emoji-panel" id="@($"{UniqueId}-emoji-panel")">
                <input type="text" class="bit-rte-inp" aria-label="@Label("search-emoji", "Search emoji")"
                       placeholder="@Label("search", "Search")"
                       @ref="_emojiSearchRef"
                       @bind="_emojiSearch" @bind:event="oninput" />
                @{ var emojiGroups = FilteredEmojiGroups().ToArray(); }
                <div class="bit-rte-emoji-scroll">
                    @foreach (var group in emojiGroups)
                    {
                        <div class="bit-rte-emoji-group" role="group" aria-label="@Label(group.Key, DefaultEmojiGroupLabel(group.Key))">
                            <div class="bit-rte-emoji-head">@Label(group.Key, DefaultEmojiGroupLabel(group.Key))</div>
                            <div class="bit-rte-emoji-grid">
                                @foreach (var emo in group)
                                {
                                    <button type="button" class="bit-rte-emoji" title="@emo.Name" aria-label="@emo.Name"
                                            @onmousedown:preventDefault="true" @onclick="() => InsertEmojiAsync(emo.Char)">@emo.Char</button>
                                }
                            </div>
                        </div>
                    }
                    @if (emojiGroups.Length == 0)
                    {
                        <span class="bit-rte-emoji-empty">@Label("no-matches", "No matches")</span>
                    }
                </div>
            </div>
        }
    }

    @if (_inlineError is not null)
    {
        <div class="bit-rte-err" role="alert">@_inlineError</div>
    }

    @if (_showSlash && ControlsDisabled is false)
    {
        <div class="bit-rte-slash">
            <input type="text" class="bit-rte-inp" aria-label="@Label("filter-commands", "Filter commands")"
                   placeholder="@Label("filter-commands", "Filter commands…")"
                   @ref="_slashInputRef"
                   role="combobox"
                   aria-expanded="true"
                   aria-autocomplete="list"
                   aria-controls="@($"{UniqueId}-slash-list")"
                   aria-activedescendant="@(FilteredSlash().Any() ? $"{UniqueId}-slash-item-{_slashIndex}" : null)"
                   value="@_slashFilter" @oninput="OnSlashFilterInput"
                   @onkeydown="OnSlashKeyDownAsync" />
            <div class="bit-rte-slash-list" role="listbox" id="@($"{UniqueId}-slash-list")" aria-label="@Label("filter-commands", "Filter commands")">
                @{ var _slashItemIndex = 0; }
                @foreach (var c in FilteredSlash())
                {
                    var _itemIndex = _slashItemIndex++;
                    <button type="button" id="@($"{UniqueId}-slash-item-{_itemIndex}")"
                            role="option"
                            aria-selected="@((_itemIndex == _slashIndex).ToString().ToLowerInvariant())"
                            class="bit-rte-slash-item@(_itemIndex == _slashIndex ? " bit-rte-slash-item-sel" : null)"
                            @onmousedown:preventDefault="true" @onclick="() => ApplySlashAsync(c.Command)">@Label(c.Key, c.Label)</button>
                }
            </div>
            @if (FilteredSlash().Any() is false)
            {
                <div class="bit-rte-emoji-empty">@Label("no-command", "No matching command")</div>
            }
        </div>
    }

    @if (_showMention && ControlsDisabled is false)
    {
        <div class="bit-rte-slash bit-rte-mention-menu">
            <input type="text" class="bit-rte-inp" aria-label="@Label("mention-filter", "Search people")"
                   placeholder="@Label("mention-filter-placeholder", "Search people…")"
                   @ref="_mentionInputRef"
                   role="combobox"
                   aria-expanded="true"
                   aria-autocomplete="list"
                   aria-controls="@($"{UniqueId}-mention-list")"
                   aria-activedescendant="@(_mentionItems.Count > 0 ? $"{UniqueId}-mention-item-{_mentionIndex}" : null)"
                   value="@_mentionFilter" @oninput="OnMentionFilterInput"
                   @onkeydown="OnMentionKeyDownAsync" />
            <div class="bit-rte-slash-list" role="listbox" id="@($"{UniqueId}-mention-list")" aria-label="@Label("mention-filter", "Search people")">
                @for (var i = 0; i < _mentionItems.Count; i++)
                {
                    var index = i;
                    var mention = _mentionItems[index];
                    <button type="button" id="@($"{UniqueId}-mention-item-{index}")"
                            role="option"
                            aria-selected="@((index == _mentionIndex) ? "true" : "false")"
                            class="bit-rte-slash-item@(index == _mentionIndex ? " bit-rte-slash-item-sel" : null)"
                            @onmousedown:preventDefault="true" @onclick="() => ApplyMentionAsync(mention)">
                        <span class="bit-rte-mention-name">@mention.Display</span>
                        @if (string.IsNullOrEmpty(mention.Description) is false)
                        {
                            <span class="bit-rte-mention-desc">@mention.Description</span>
                        }
                    </button>
                }
            </div>
            @if (_mentionItems.Count == 0)
            {
                <div class="bit-rte-emoji-empty">@Label("no-mention", "No matches")</div>
            }
        </div>
    }

    @if (ShowingQuickToolbar)
    {
        <div class="bit-rte-quick" role="toolbar" style="@QuickToolbarStyle"
             aria-label="@Label("quick-toolbar", "Selection formatting")">
            <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Bold ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("bold", "Bold (Ctrl+B)")" aria-label="@Label("bold-label", "Bold")" aria-pressed="@(_state.Bold ? "true" : "false")"
                    @onmousedown:preventDefault="true" @onclick='() => ExecAsync("bold")'><b>B</b></button>
            <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Italic ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("italic", "Italic (Ctrl+I)")" aria-label="@Label("italic-label", "Italic")" aria-pressed="@(_state.Italic ? "true" : "false")"
                    @onmousedown:preventDefault="true" @onclick='() => ExecAsync("italic")'><i>I</i></button>
            <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Underline ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("underline", "Underline (Ctrl+U)")" aria-label="@Label("underline-label", "Underline")" aria-pressed="@(_state.Underline ? "true" : "false")"
                    @onmousedown:preventDefault="true" @onclick='() => ExecAsync("underline")'><u>U</u></button>
            <button type="button" class="bit-rte-btn @Classes?.Button @(_state.InlineCode ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("inline-code", "Inline code (Ctrl+E)")" aria-label="@Label("inline-code-label", "Inline code")" aria-pressed="@(_state.InlineCode ? "true" : "false")"
                    @onmousedown:preventDefault="true" @onclick='() => ExecAsync("inlineCode")'><code>&lt;&gt;</code></button>
            @if (ShowToolbar && Has(BitRichTextEditorToolbar.Link))
            {
                <button type="button" class="bit-rte-btn @Classes?.Button @(_state.InLink ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("link", "Insert/edit link (Ctrl+K)")" aria-label="@Label("link-label", "Insert or edit link")" aria-pressed="@(_state.InLink ? "true" : "false")"
                        @onmousedown:preventDefault="true" @onclick="ToggleLinkInput">🔗</button>
            }
            <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" title="@Label("clear-formatting", "Clear formatting")" aria-label="@Label("clear-formatting", "Clear formatting")"
                    @onmousedown:preventDefault="true" @onclick="ClearFormattingAsync">⌫</button>
        </div>
    }

    <div class="bit-rte-edt @Classes?.Editor"
         @ref="_editorRef"
         role="textbox"
         aria-multiline="true"
         aria-label="@(AriaLabel ?? Label("editor", "Rich text editor"))"
         aria-readonly="@(EffectiveReadOnly ? "true" : null)"
         aria-describedby="@(ShowCount ? $"{UniqueId}-count" : null)"
         spellcheck="@SpellCheck.ToString().ToLowerInvariant()"
         contenteditable="@((EffectiveReadOnly is false && _inSourceView is false).ToString().ToLowerInvariant())"
         data-placeholder="@Placeholder"
         hidden="@_inSourceView"
         style="@(SurfaceSizeStyle + Styles?.Editor)"></div>

    @if (_inSourceView)
    {
        <textarea class="bit-rte-src @Classes?.Source" style="@(SurfaceSizeStyle + Styles?.Source)"
                  @ref="_sourceRef"
                  aria-label="@Label("source-view", "HTML source")"
                  spellcheck="false"
                  readonly="@EffectiveReadOnly"
                  value="@_sourceText" @oninput="OnSourceTextChanged"></textarea>
    }

    @if (ShowCount)
    {
        <div class="bit-rte-cnt @Classes?.Count" style="@Styles?.Count" id="@($"{UniqueId}-count")" role="status" aria-live="polite">
            @_facts.WordCount @Label("words", "words") · @_facts.CharacterCount@(MaxLength is int max ? $"/{max}" : "") @Label("chars", "chars")
            @if (MaxLength is int m && _facts.CharacterCount >= m)
            {
                <span class="bit-rte-cnt-over">@Label("limit-reached", "limit reached")</span>
            }
        </div>
    }
</div>

@code {
    private RenderFragment RenderGroup(string id) => builder =>
    {
        switch (id)
        {
            case "history": builder.AddContent(0, HistoryGroup); break;
            case "blockformat": builder.AddContent(0, BlockFormatGroup); break;
            case "font": builder.AddContent(0, FontGroup); break;
            case "inline": builder.AddContent(0, InlineGroup); break;
            case "color": builder.AddContent(0, ColorGroup); break;
            case "script": builder.AddContent(0, ScriptGroup); break;
            case "lists": builder.AddContent(0, ListsGroup); break;
            case "indent": builder.AddContent(0, IndentGroup); break;
            case "blocks": builder.AddContent(0, BlocksGroup); break;
            case "link": builder.AddContent(0, LinkGroup); break;
            case "media": builder.AddContent(0, MediaGroup); break;
            case "image": builder.AddContent(0, ImageGroup); break;
            case "table": builder.AddContent(0, TableGroup); break;
            case "rule": builder.AddContent(0, RuleGroup); break;
            case "alignment": builder.AddContent(0, AlignmentGroup); break;
            case "direction": builder.AddContent(0, DirectionGroup); break;
            case "emoji": builder.AddContent(0, EmojiGroup); break;
            case "find": builder.AddContent(0, FindGroup); break;
            case "source": builder.AddContent(0, SourceGroup); break;
            case "fullscreen": builder.AddContent(0, FullScreenGroup); break;
            case "clear": builder.AddContent(0, ClearGroup); break;
            default: RenderCustomItem(builder, id); break;
        }
    };

    private RenderFragment HistoryGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
        <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" title="@Label("undo", "Undo (Ctrl+Z)")" aria-label="@Label("undo-label", "Undo")" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick="UndoAsync">↶</button>
        <button type="button" class="bit-rte-btn @Classes?.Button" style="@Styles?.Button" title="@Label("redo", "Redo (Ctrl+Y)")" aria-label="@Label("redo-label", "Redo")" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick="RedoAsync">↷</button>
    </div>;

    private RenderFragment BlockFormatGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
        <select class="bit-rte-sel" title="@Label("paragraph-format", "Paragraph format")" aria-label="@Label("paragraph-format", "Paragraph format")" disabled="@ControlsDisabled"
                value="@_state.Block" @onchange="OnBlockFormatChanged">
            <option value="p">@Label("block-normal", "Normal")</option>
            <option value="h1">@Label("heading-1", "Heading 1")</option>
            <option value="h2">@Label("heading-2", "Heading 2")</option>
            <option value="h3">@Label("heading-3", "Heading 3")</option>
            <option value="h4">@Label("heading-4", "Heading 4")</option>
            <option value="h5">@Label("heading-5", "Heading 5")</option>
            <option value="h6">@Label("heading-6", "Heading 6")</option>
            <option value="blockquote">@Label("quote", "Quote")</option>
            <option value="pre">@Label("code-block", "Code block")</option>
        </select>
    </div>;

    private RenderFragment FontGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
        <select class="bit-rte-sel" title="@Label("font-family", "Font family")" aria-label="@Label("font-family", "Font family")" disabled="@ControlsDisabled"
                value="@(_state.FontName ?? "")" @onchange="@(e => ApplyFontAsync("name", e))">
            <option value="">@Label("font", "Font")</option>
            @foreach (var f in EffectiveFontFamilies)
            {
                <option value="@f">@f</option>
            }
        </select>
        <select class="bit-rte-sel" title="@Label("font-size", "Font size")" aria-label="@Label("font-size", "Font size")" disabled="@ControlsDisabled"
                value="@(_state.FontSize ?? "")" @onchange="@(e => ApplyFontAsync("size", e))">
            <option value="">@Label("size", "Size")</option>
            @foreach (var s in EffectiveFontSizes)
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>;

    private RenderFragment InlineGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
        <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Bold ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("bold", "Bold (Ctrl+B)")" aria-label="@Label("bold-label", "Bold")" aria-pressed="@(_state.Bold ? "true" : "false")" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick='() => ExecAsync("bold")'><b>B</b></button>
        <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Italic ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("italic", "Italic (Ctrl+I)")" aria-label="@Label("italic-label", "Italic")" aria-pressed="@(_state.Italic ? "true" : "false")" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick='() => ExecAsync("italic")'><i>I</i></button>
        <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Underline ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("underline", "Underline (Ctrl+U)")" aria-label="@Label("underline-label", "Underline")" aria-pressed="@(_state.Underline ? "true" : "false")" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick='() => ExecAsync("underline")'><u>U</u></button>
        <button type="button" class="bit-rte-btn @Classes?.Button @(_state.StrikeThrough ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("strikethrough", "Strikethrough")" aria-label="@Label("strikethrough", "Strikethrough")" aria-pressed="@(_state.StrikeThrough ? "true" : "false")" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick='() => ExecAsync("strikeThrough")'><s>S</s></button>
        <button type="button" class="bit-rte-btn @Classes?.Button @(_state.InlineCode ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("inline-code", "Inline code (Ctrl+E)")" aria-label="@Label("inline-code-label", "Inline code")" aria-pressed="@(_state.InlineCode ? "true" : "false")" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick='() => ExecAsync("inlineCode")'><code>&lt;&gt;</code></button>
    </div>;

    private RenderFragment ColorGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
        <label class="bit-rte-color" title="@Label("text-color", "Text color")">
            <span>A</span>
            <input type="color" aria-label="@Label("text-color", "Text color")" disabled="@ControlsDisabled"
                   value="@(_state.ForeColor ?? "#000000")"
                   @onchange="@(e => ApplyColorAsync("fore", e))" />
        </label>
        <label class="bit-rte-color bit-rte-color-bg" title="@Label("highlight-color", "Highlight color")">
            <span>🖍</span>
            <input type="color" aria-label="@Label("highlight-color", "Highlight color")" disabled="@ControlsDisabled"
                   value="@(_state.BackColor ?? "#ffff00")"
                   @onchange="@(e => ApplyColorAsync("back", e))" />
        </label>
    </div>;

    private RenderFragment ScriptGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
        <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Subscript ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("subscript", "Subscript")" aria-label="@Label("subscript", "Subscript")" aria-pressed="@(_state.Subscript ? "true" : "false")" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick="SubscriptAsync">X₂</button>
        <button type="button" class="bit-rte-btn @Classes?.Button @(_state.Superscript ? "bit-rte-act" : "")" style="@Styles?.Button" title="@Label("superscript", "Superscript")" aria-label="@Label("superscript", "Superscript")" aria-pressed="@(_state.Superscript ? "true" : "false")" disabled="@ControlsDisabled"
                @onmousedown:preventDefault="true" @onclick="SuperscriptAsync">X²</button>
    </div>;

    private RenderFragment ListsGroup => @<div class="bit-rte-grp @Classes?.Group" style="@Styles?.Group">
