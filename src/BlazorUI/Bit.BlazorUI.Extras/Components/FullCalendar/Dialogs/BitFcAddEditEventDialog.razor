@namespace Bit.BlazorUI

<div class="bit-bfc-overlay" @onclick="OnClose">
    @* Escape dismisses the dialog, the way every modal is expected to behave; the handler sits on
       the dialog because focus is trapped inside it while it is open. *@
    <div @ref="_dialogRef" class="bit-bfc-dialog" role="dialog" aria-modal="true" aria-labelledby="@_dialogTitleId" tabindex="-1"
         @onkeydown="OnDialogKeyDown" @onclick:stopPropagation="true">
        <div class="bit-bfc-dialog-header bit-bfc-dialog-header-row">
            <div>
                <h3 id="@_dialogTitleId">@(_isEditing ? Texts.EditEventDialogTitle : Texts.AddEventDialogTitle)</h3>
                <p>@(_isEditing ? Texts.EditEventDialogSubtitle : Texts.AddEventDialogSubtitle)</p>
            </div>
            <button type="button" class="bit-bfc-dialog-close-btn" @onclick="OnClose" aria-label="@Texts.CloseAriaLabel">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="bit-bfc-dialog-body">
            <div class="bit-bfc-field">
                <label for="@_titleInputId">@Texts.TitleLabel</label>
                <input id="@_titleInputId" type="text" @bind="_title" placeholder="@Texts.EventTitlePlaceholder" />
                @if (_errors.ContainsKey("title"))
                {
                    <div class="bit-bfc-field-error">@_errors["title"]</div>
                }
            </div>

            <div class="bit-bfc-field">
                <label class="bit-bfc-field-inline">
                    <input type="checkbox" checked="@_isAllDay" @onchange="OnAllDayChanged" />
                    <span>@Texts.AllDayLabel</span>
                </label>
            </div>

            <div class="bit-bfc-field">
                <label>@Texts.StartDateTimeLabel</label>
                <BitFcDateTimePicker Value="_startDate" ValueChanged="OnStartDateChanged" Culture="State.Culture" Use24HourFormat="State.Use24HourFormat" FirstDayOfWeek="State.FirstDayOfWeekOverride" MinDate="State.MinDate" MaxDate="State.MaxDate" TriggerAriaLabel="@Texts.StartDateTimeLabel"
                                     PreviousMonthAriaLabel="@Texts.PreviousMonthAriaLabel" NextMonthAriaLabel="@Texts.NextMonthAriaLabel"
                                     HourAriaLabel="@Texts.PickerHourAriaLabel" MinuteAriaLabel="@Texts.PickerMinuteAriaLabel"
                                     MeridiemAriaLabel="@Texts.PickerMeridiemAriaLabel" SelectedDayAriaLabel="@Texts.PickerSelectedDayAriaLabel" />
            </div>

            <div class="bit-bfc-field">
                <label>@Texts.EndDateTimeLabel</label>
                <BitFcDateTimePicker Value="_endDate" ValueChanged="OnEndDateChanged" Culture="State.Culture" Use24HourFormat="State.Use24HourFormat" FirstDayOfWeek="State.FirstDayOfWeekOverride" MinDate="State.MinDate" MaxDate="State.MaxDate" TriggerAriaLabel="@Texts.EndDateTimeLabel"
                                     PreviousMonthAriaLabel="@Texts.PreviousMonthAriaLabel" NextMonthAriaLabel="@Texts.NextMonthAriaLabel"
                                     HourAriaLabel="@Texts.PickerHourAriaLabel" MinuteAriaLabel="@Texts.PickerMinuteAriaLabel"
                                     MeridiemAriaLabel="@Texts.PickerMeridiemAriaLabel" SelectedDayAriaLabel="@Texts.PickerSelectedDayAriaLabel" />
                @if (_errors.ContainsKey("endDate"))
                {
                    <div class="bit-bfc-field-error">@_errors["endDate"]</div>
                }
            </div>

            @* An occurrence edited on its own becomes a one-off event, so it has no rule to edit. *@
            @if (_isOccurrenceEdit is false)
            {
                <div class="bit-bfc-field">
                    <label for="@_repeatSelectId">@Texts.RepeatLabel</label>
                    <select id="@_repeatSelectId" value="@(_frequency?.ToString() ?? string.Empty)" @onchange="OnFrequencyChanged">
                        <option value="">@Texts.DoesNotRepeatOption</option>
                        <option value="@nameof(BitFullCalendarRecurrenceFrequency.Daily)">@Texts.RepeatsDaily</option>
                        <option value="@nameof(BitFullCalendarRecurrenceFrequency.Weekly)">@Texts.RepeatsWeekly</option>
                        <option value="@nameof(BitFullCalendarRecurrenceFrequency.Monthly)">@Texts.RepeatsMonthly</option>
                        <option value="@nameof(BitFullCalendarRecurrenceFrequency.Yearly)">@Texts.RepeatsYearly</option>
                    </select>
                </div>

                @if (_frequency is { } frequency)
                {
                    <div class="bit-bfc-field">
                        <label for="@_intervalInputId">@Texts.RepeatEveryLabel</label>
                        <div class="bit-bfc-repeat-row">
                            <input id="@_intervalInputId" class="bit-bfc-repeat-number" type="number" min="1" @bind="_interval" />
                            <span>@GetIntervalUnit(frequency)</span>
                        </div>
                        @if (_errors.ContainsKey("interval"))
                        {
                            <div class="bit-bfc-field-error">@_errors["interval"]</div>
                        }
                    </div>

                    @if (frequency is BitFullCalendarRecurrenceFrequency.Monthly or BitFullCalendarRecurrenceFrequency.Yearly)
                    {
                        <div class="bit-bfc-field">
                            <label for="@_positionSelectId">@Texts.RepeatOnLabel</label>
                            <select id="@_positionSelectId" value="@(_weekOfMonth?.ToString() ?? string.Empty)" @onchange="OnWeekOfMonthChanged">
                                <option value="">@GetDayOfPeriodLabel(frequency)</option>
                                @foreach (var week in Enum.GetValues<BitFullCalendarWeekOfMonth>())
                                {
                                    <option value="@week.ToString()">@string.Format(State.Culture, Texts.RepeatOnWeekOfMonthFormat, Texts.GetWeekOfMonthLabel(week))</option>
                                }
                            </select>
                        </div>
                    }

                    @if (frequency is BitFullCalendarRecurrenceFrequency.Weekly || _weekOfMonth is not null)
                    {
                        <div class="bit-bfc-field">
                            @* A weekly series names its weekdays here; a monthly one already has its "on" label
                               above, on the week-of-the-month choice these days complete. *@
                            @if (frequency is BitFullCalendarRecurrenceFrequency.Weekly)
                            {
                                <label id="@_daysLabelId">@Texts.RepeatOnLabel</label>
                            }
                            <div class="bit-bfc-repeat-days" role="group" aria-labelledby="@(frequency is BitFullCalendarRecurrenceFrequency.Weekly ? _daysLabelId : _positionSelectId)">
                                @foreach (var day in GetOrderedWeekDays())
                                {
                                    var weekDay = day;
                                    <button type="button" class="bit-bfc-repeat-day" aria-pressed="@(_repeatDays.Contains(weekDay) ? "true" : "false")"
                                            aria-label="@State.Culture.DateTimeFormat.GetDayName(weekDay)" @onclick="() => ToggleRepeatDay(weekDay)">
                                        @State.Culture.DateTimeFormat.GetShortestDayName(weekDay)
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div class="bit-bfc-field">
                        <label for="@_endsSelectId">@Texts.EndsLabel</label>
                        <div class="bit-bfc-repeat-row">
                            <select id="@_endsSelectId" class="bit-bfc-repeat-ends" value="@_repeatEnd.ToString()" @onchange="OnRepeatEndChanged">
                                <option value="@nameof(RepeatEnd.Never)">@Texts.EndsNeverOption</option>
                                <option value="@nameof(RepeatEnd.OnDate)">@Texts.EndsOnDateOption</option>
                                <option value="@nameof(RepeatEnd.AfterCount)">@Texts.EndsAfterOption</option>
                            </select>
                            @if (_repeatEnd is RepeatEnd.OnDate)
                            {
                                <div class="bit-bfc-repeat-grow">
                                    <BitFcDateTimePicker Value="_until" ValueChanged="OnUntilChanged" ShowTime="false" Culture="State.Culture" FirstDayOfWeek="State.FirstDayOfWeekOverride" TriggerAriaLabel="@Texts.EndsOnDateOption"
                                                         PreviousMonthAriaLabel="@Texts.PreviousMonthAriaLabel" NextMonthAriaLabel="@Texts.NextMonthAriaLabel" SelectedDayAriaLabel="@Texts.PickerSelectedDayAriaLabel" />
                                </div>
                            }
                            else if (_repeatEnd is RepeatEnd.AfterCount)
                            {
                                <input class="bit-bfc-repeat-number" type="number" min="1" @bind="_count" aria-label="@Texts.OccurrencesLabel" />
                                <span>@Texts.OccurrencesLabel</span>
                            }
                        </div>
                        @if (_errors.ContainsKey("until"))
                        {
                            <div class="bit-bfc-field-error">@_errors["until"]</div>
                        }
                        @if (_errors.ContainsKey("count"))
                        {
                            <div class="bit-bfc-field-error">@_errors["count"]</div>
                        }
                    </div>

                    <div class="bit-bfc-field">
                        <label>@Texts.RepeatExceptionsLabel</label>
                        <div class="bit-bfc-repeat-row">
                            <div class="bit-bfc-repeat-grow">
                                <BitFcDateTimePicker Value="_exceptionDraft" ValueChanged="OnExceptionDraftChanged" ShowTime="false" Culture="State.Culture" FirstDayOfWeek="State.FirstDayOfWeekOverride" TriggerAriaLabel="@Texts.RepeatExceptionsLabel"
                                                     PreviousMonthAriaLabel="@Texts.PreviousMonthAriaLabel" NextMonthAriaLabel="@Texts.NextMonthAriaLabel" SelectedDayAriaLabel="@Texts.PickerSelectedDayAriaLabel" />
                            </div>
                            <button type="button" class="bit-bfc-btn bit-bfc-btn-sm bit-bfc-repeat-skip-btn" @onclick="SkipDraftDate">@Texts.SkipDateButton</button>
                            <button type="button" class="bit-bfc-btn bit-bfc-btn-sm bit-bfc-repeat-add-btn" @onclick="AddDraftDate">@Texts.AddDateButton</button>
                        </div>
                        @if (_exceptionDates.Count > 0)
                        {
                            <div class="bit-bfc-repeat-dates bit-bfc-repeat-skipped">
                                <span class="bit-bfc-repeat-dates-label">@Texts.SkippedDatesLabel</span>
                                @foreach (var d in _exceptionDates)
                                {
                                    var date = d;
                                    var text = date.ToString("d", State.Culture);
                                    <span class="bit-bfc-attendee-chip bit-bfc-attendee-chip-readonly bit-bfc-date-chip-skipped">
                                        @text
                                        <button class="bit-bfc-attendee-chip-remove" type="button" aria-label="@($"{Texts.RemoveDateAriaLabel}: {text}")" @onclick="() => _exceptionDates.Remove(date)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                        @if (_additionalDates.Count > 0)
                        {
                            <div class="bit-bfc-repeat-dates bit-bfc-repeat-added">
                                <span class="bit-bfc-repeat-dates-label">@Texts.AddedDatesLabel</span>
                                @foreach (var d in _additionalDates)
                                {
                                    var date = d;
                                    var text = date.ToString("d", State.Culture);
                                    <span class="bit-bfc-attendee-chip bit-bfc-attendee-chip-readonly">
                                        @text
                                        <button class="bit-bfc-attendee-chip-remove" type="button" aria-label="@($"{Texts.RemoveDateAriaLabel}: {text}")" @onclick="() => _additionalDates.Remove(date)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
            }

            <div class="bit-bfc-field">
                <label for="@_colorSelectId">@Texts.ColorLabel</label>
                <select id="@_colorSelectId" @bind="_color" aria-label="@Texts.EventColorAriaLabel">
                    @foreach (var opt in ColorScheme.GetEditorOptions(_isEditing ? _color : null))
                    {
                        <option value="@opt.Id">@opt.Title</option>
                    }
                </select>
            </div>

            @* The resource picker is only meaningful when the calendar was given resources to
               assign to, so it stays out of the form entirely otherwise. *@
            @if (State.Resources.Count > 0)
            {
                <div class="bit-bfc-field">
                    <label for="@_resourceSelectId">@Texts.ResourceLabel</label>
                    <select id="@_resourceSelectId" @bind="_resource" aria-label="@Texts.ResourceLabel">
                        <option value="">@Texts.NoResourceOption</option>
                        @foreach (var resource in State.Resources)
                        {
                            <option value="@resource.Id">@resource.Title</option>
                        }
                    </select>
                </div>
            }

            <div class="bit-bfc-field">
                <label for="@_descriptionInputId">@Texts.DescriptionLabel</label>
                <textarea id="@_descriptionInputId" @bind="_description" placeholder="@Texts.EventDescriptionPlaceholder"></textarea>
                @if (_errors.ContainsKey("description"))
                {
                    <div class="bit-bfc-field-error">@_errors["description"]</div>
                }
            </div>

            <div class="bit-bfc-field">
                <label>@Texts.AttendeesLabel</label>
                @if (_attendees.Count > 0)
                {
                    <div class="bit-bfc-attendees-chips">
                        @foreach (var a in _attendees)
                        {
                            var attendee = a;
                            <span class="bit-bfc-attendee-chip">
                                <span class="bit-bfc-attendee-chip-avatar">@attendee.Initials</span>
                                @attendee.FullName
                                <button class="bit-bfc-attendee-chip-remove" type="button" aria-label="@($"{Texts.RemoveAttendeeAriaLabel}: {attendee.FullName}")" @onclick="() => RemoveAttendee(attendee)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </span>
                        }
                    </div>
                }
                <div class="bit-bfc-attendee-add-row">
                    <input type="text" @bind="_newFirstName" placeholder="@Texts.FirstNamePlaceholder" aria-label="@Texts.FirstNamePlaceholder" />
                    <input type="text" @bind="_newLastName" placeholder="@Texts.LastNamePlaceholder" aria-label="@Texts.LastNamePlaceholder" />
                    <input type="text" @bind="_newId" placeholder="@Texts.IdOptionalPlaceholder" aria-label="@Texts.IdOptionalPlaceholder" />
                    <button class="bit-bfc-btn bit-bfc-btn-sm" type="button" @onclick="AddAttendee">@Texts.AddButton</button>
                </div>
                @if (_errors.ContainsKey("attendee"))
                {
                    <div class="bit-bfc-field-error">@_errors["attendee"]</div>
                }
            </div>
        </div>
        <div class="bit-bfc-dialog-footer">
            @if (_errors.ContainsKey("overlap"))
            {
                <div class="bit-bfc-field-error" role="alert">@_errors["overlap"]</div>
            }
            <button type="button" class="bit-bfc-btn" @onclick="OnClose">@Texts.CancelButton</button>
            <button type="button" class="bit-bfc-btn bit-bfc-btn-primary" @onclick="Submit" disabled="@_isSubmitting">
                @(_isEditing ? Texts.SaveChangesButton : Texts.CreateEventButton)
            </button>
        </div>
    </div>
</div>
