@namespace Bit.BlazorUI

<div class="bit-bfc-overlay" @onclick="OnClose">
    <div @ref="_dialogRef" class="bit-bfc-dialog" role="dialog" aria-modal="true" aria-labelledby="@_dialogTitleId" @onclick:stopPropagation="true">
        <div class="bit-bfc-dialog-header bit-bfc-dialog-header-row">
            <div>
                <h3 id="@_dialogTitleId">@(_isEditing ? Texts.EditEventDialogTitle : Texts.AddEventDialogTitle)</h3>
                <p>@(_isEditing ? Texts.EditEventDialogSubtitle : Texts.AddEventDialogSubtitle)</p>
            </div>
            <button type="button" class="bit-bfc-dialog-close-btn" @onclick="OnClose" aria-label="@Texts.CloseAriaLabel">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="bit-bfc-dialog-body">
            <div class="bit-bfc-field">
                <label for="@_titleInputId">@Texts.TitleLabel</label>
                <input id="@_titleInputId" type="text" @bind="_title" placeholder="@Texts.EventTitlePlaceholder" />
                @if (_errors.ContainsKey("title"))
                {
                    <div class="bit-bfc-field-error">@_errors["title"]</div>
                }
            </div>

            <div class="bit-bfc-field">
                <label>@Texts.StartDateTimeLabel</label>
                <BitFcDateTimePicker Value="_startDate" ValueChanged="OnStartDateChanged" Culture="State.Culture" Use24HourFormat="State.Use24HourFormat" TriggerAriaLabel="@Texts.StartDateTimeLabel"
                                     PreviousMonthAriaLabel="@Texts.PreviousMonthAriaLabel" NextMonthAriaLabel="@Texts.NextMonthAriaLabel"
                                     HourAriaLabel="@Texts.PickerHourAriaLabel" MinuteAriaLabel="@Texts.PickerMinuteAriaLabel"
                                     MeridiemAriaLabel="@Texts.PickerMeridiemAriaLabel" SelectedDayAriaLabel="@Texts.PickerSelectedDayAriaLabel" />
            </div>

            <div class="bit-bfc-field">
                <label>@Texts.EndDateTimeLabel</label>
                <BitFcDateTimePicker Value="_endDate" ValueChanged="OnEndDateChanged" Culture="State.Culture" Use24HourFormat="State.Use24HourFormat" TriggerAriaLabel="@Texts.EndDateTimeLabel"
                                     PreviousMonthAriaLabel="@Texts.PreviousMonthAriaLabel" NextMonthAriaLabel="@Texts.NextMonthAriaLabel"
                                     HourAriaLabel="@Texts.PickerHourAriaLabel" MinuteAriaLabel="@Texts.PickerMinuteAriaLabel"
                                     MeridiemAriaLabel="@Texts.PickerMeridiemAriaLabel" SelectedDayAriaLabel="@Texts.PickerSelectedDayAriaLabel" />
                @if (_errors.ContainsKey("endDate"))
                {
                    <div class="bit-bfc-field-error">@_errors["endDate"]</div>
                }
            </div>

            @if (ShowRecurrence)
            {
                <div class="bit-bfc-field">
                    <label for="@_repeatSelectId">@Texts.RepeatLabel</label>
                    <select id="@_repeatSelectId" class="bit-bfc-repeat-select" @bind="FrequencyValue">
                        <option value="">@Texts.RecurrenceNone</option>
                        @foreach (var frequency in Enum.GetValues<BitFullCalendarRecurrenceFrequency>())
                        {
                            <option value="@frequency">@Texts.GetRecurrenceFrequencyLabel(frequency)</option>
                        }
                    </select>
                </div>

                @if (_frequency is { } selectedFrequency)
                {
                    <div class="bit-bfc-field">
                        <label for="@_intervalInputId">@Texts.RecurrenceIntervalLabel</label>
                        <div class="bit-bfc-field-row">
                            <input id="@_intervalInputId" type="number" min="1" @bind="Interval" />
                            <span class="bit-bfc-field-unit">@Texts.GetRecurrenceUnitLabel(selectedFrequency)</span>
                        </div>
                    </div>

                    @if (selectedFrequency == BitFullCalendarRecurrenceFrequency.Weekly)
                    {
                        <div class="bit-bfc-field">
                            <label id="@_daysLabelId">@Texts.RecurrenceDaysOfWeekLabel</label>
                            <div class="bit-bfc-weekday-toggles" role="group" aria-labelledby="@_daysLabelId">
                                @foreach (var day in OrderedWeekdays)
                                {
                                    var weekday = day;
                                    <button type="button"
                                            class="bit-bfc-weekday-toggle"
                                            aria-pressed="@(_daysOfWeek.Contains(weekday) ? "true" : "false")"
                                            aria-label="@State.Culture.DateTimeFormat.GetDayName(weekday)"
                                            @onclick="() => ToggleDay(weekday)">
                                        @State.Culture.DateTimeFormat.GetAbbreviatedDayName(weekday)
                                    </button>
                                }
                            </div>
                            @if (_errors.ContainsKey("days"))
                            {
                                <div class="bit-bfc-field-error">@_errors["days"]</div>
                            }
                        </div>
                    }
                    else if (selectedFrequency is BitFullCalendarRecurrenceFrequency.Monthly or BitFullCalendarRecurrenceFrequency.Yearly)
                    {
                        <div class="bit-bfc-field">
                            <label for="@_patternSelectId">@Texts.RecurrencePatternLabel</label>
                            <select id="@_patternSelectId" @bind="MonthPattern">
                                <option value="@MonthPatternKind.DayOfMonth">@DescribeMonthPattern(selectedFrequency, null)</option>
                                @if (StartWeekOfMonth is { } startWeek)
                                {
                                    <option value="@MonthPatternKind.Weekday">@DescribeMonthPattern(selectedFrequency, startWeek)</option>
                                }
                                @if (StartIsInLastWeek)
                                {
                                    <option value="@MonthPatternKind.LastWeekday">@DescribeMonthPattern(selectedFrequency, BitFullCalendarRecurrenceWeekOfMonth.Last)</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="bit-bfc-field">
                        <label for="@_endsSelectId">@Texts.RecurrenceEndsLabel</label>
                        <div class="bit-bfc-field-row">
                            <select id="@_endsSelectId" @bind="_end">
                                <option value="@RecurrenceEndKind.Never">@Texts.RecurrenceEndsNever</option>
                                <option value="@RecurrenceEndKind.OnDate">@Texts.RecurrenceEndsOnDate</option>
                                <option value="@RecurrenceEndKind.AfterCount">@Texts.RecurrenceEndsAfterCount</option>
                            </select>
                            @if (_end == RecurrenceEndKind.OnDate)
                            {
                                <BitFcDateTimePicker Value="_until" ValueChanged="@((DateTime value) => _until = value)" ShowTime="false" Culture="State.Culture" TriggerAriaLabel="@Texts.RecurrenceUntilAriaLabel"
                                                     PreviousMonthAriaLabel="@Texts.PreviousMonthAriaLabel" NextMonthAriaLabel="@Texts.NextMonthAriaLabel" SelectedDayAriaLabel="@Texts.PickerSelectedDayAriaLabel" />
                            }
                            else if (_end == RecurrenceEndKind.AfterCount)
                            {
                                <input type="number" min="1" @bind="Count" aria-label="@Texts.RecurrenceCountAriaLabel" />
                            }
                        </div>
                        @if (_errors.ContainsKey("until"))
                        {
                            <div class="bit-bfc-field-error">@_errors["until"]</div>
                        }
                    </div>

                    <div class="bit-bfc-field">
                        <label>@Texts.RecurrenceSkippedDatesLabel</label>
                        @if (_exceptionDates.Count > 0)
                        {
                            <div class="bit-bfc-attendees-chips bit-bfc-skipped-dates">
                                @foreach (var date in _exceptionDates)
                                {
                                    var skipped = date;
                                    <span class="bit-bfc-date-chip">
                                        @skipped.ToString("d", State.Culture)
                                        <button class="bit-bfc-attendee-chip-remove" type="button" aria-label="@($"{Texts.RemoveDateAriaLabel}: {skipped.ToString("d", State.Culture)}")" @onclick="() => _exceptionDates.Remove(skipped)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                        <div class="bit-bfc-field-row">
                            <BitFcDateTimePicker Value="_newExceptionDate" ValueChanged="@((DateTime value) => _newExceptionDate = value)" ShowTime="false" Culture="State.Culture" TriggerAriaLabel="@Texts.RecurrenceSkipDateAriaLabel"
                                                 PreviousMonthAriaLabel="@Texts.PreviousMonthAriaLabel" NextMonthAriaLabel="@Texts.NextMonthAriaLabel" SelectedDayAriaLabel="@Texts.PickerSelectedDayAriaLabel" />
                            <button class="bit-bfc-btn bit-bfc-btn-sm bit-bfc-skip-date-btn" type="button" @onclick="AddExceptionDate">@Texts.RecurrenceSkipDateButton</button>
                        </div>
                    </div>

                    <div class="bit-bfc-field">
                        <label>@Texts.RecurrenceExtraDatesLabel</label>
                        @if (_additionalDates.Count > 0)
                        {
                            <div class="bit-bfc-attendees-chips bit-bfc-extra-dates">
                                @foreach (var date in _additionalDates)
                                {
                                    var extra = date;
                                    <span class="bit-bfc-date-chip">
                                        @extra.ToString("d", State.Culture)
                                        <button class="bit-bfc-attendee-chip-remove" type="button" aria-label="@($"{Texts.RemoveDateAriaLabel}: {extra.ToString("d", State.Culture)}")" @onclick="() => _additionalDates.Remove(extra)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                        <div class="bit-bfc-field-row">
                            <BitFcDateTimePicker Value="_newAdditionalDate" ValueChanged="@((DateTime value) => _newAdditionalDate = value)" ShowTime="false" Culture="State.Culture" TriggerAriaLabel="@Texts.RecurrenceExtraDateAriaLabel"
                                                 PreviousMonthAriaLabel="@Texts.PreviousMonthAriaLabel" NextMonthAriaLabel="@Texts.NextMonthAriaLabel" SelectedDayAriaLabel="@Texts.PickerSelectedDayAriaLabel" />
                            <button class="bit-bfc-btn bit-bfc-btn-sm bit-bfc-extra-date-btn" type="button" @onclick="AddAdditionalDate">@Texts.RecurrenceAddDateButton</button>
                        </div>
                    </div>
                }
            }

            <div class="bit-bfc-field">
                <label for="@_colorSelectId">@Texts.ColorLabel</label>
                <select id="@_colorSelectId" @bind="_color" aria-label="@Texts.EventColorAriaLabel">
                    @foreach (var opt in ColorScheme.GetEditorOptions(_isEditing ? _color : null))
                    {
                        <option value="@opt.Id">@opt.Title</option>
                    }
                </select>
            </div>

            <div class="bit-bfc-field">
                <label for="@_descriptionInputId">@Texts.DescriptionLabel</label>
                <textarea id="@_descriptionInputId" @bind="_description" placeholder="@Texts.EventDescriptionPlaceholder"></textarea>
                @if (_errors.ContainsKey("description"))
                {
                    <div class="bit-bfc-field-error">@_errors["description"]</div>
                }
            </div>

            <div class="bit-bfc-field">
                <label>@Texts.AttendeesLabel</label>
                @if (_attendees.Count > 0)
                {
                    <div class="bit-bfc-attendees-chips">
                        @foreach (var a in _attendees)
                        {
                            var attendee = a;
                            <span class="bit-bfc-attendee-chip">
                                <span class="bit-bfc-attendee-chip-avatar">@attendee.Initials</span>
                                @attendee.FullName
                                <button class="bit-bfc-attendee-chip-remove" type="button" aria-label="@($"{Texts.RemoveAttendeeAriaLabel}: {attendee.FullName}")" @onclick="() => RemoveAttendee(attendee)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </span>
                        }
                    </div>
                }
                <div class="bit-bfc-attendee-add-row">
                    <input type="text" @bind="_newFirstName" placeholder="@Texts.FirstNamePlaceholder" aria-label="@Texts.FirstNamePlaceholder" />
                    <input type="text" @bind="_newLastName" placeholder="@Texts.LastNamePlaceholder" aria-label="@Texts.LastNamePlaceholder" />
                    <input type="text" @bind="_newId" placeholder="@Texts.IdOptionalPlaceholder" aria-label="@Texts.IdOptionalPlaceholder" />
                    <button class="bit-bfc-btn bit-bfc-btn-sm" type="button" @onclick="AddAttendee">@Texts.AddButton</button>
                </div>
                @if (_errors.ContainsKey("attendee"))
                {
                    <div class="bit-bfc-field-error">@_errors["attendee"]</div>
                }
            </div>
        </div>
        <div class="bit-bfc-dialog-footer">
            <button type="button" class="bit-bfc-btn" @onclick="OnClose">@Texts.CancelButton</button>
            <button type="button" class="bit-bfc-btn bit-bfc-btn-primary" @onclick="Submit" disabled="@_isSubmitting">
                @(_isEditing ? Texts.SaveChangesButton : Texts.CreateEventButton)
            </button>
        </div>
    </div>
</div>
