@namespace Bit.BlazorUI

<div class="bit-bfc-overlay" @onclick="OnClose">
    @* Escape dismisses the dialog, the way every modal is expected to behave. *@
    <div class="bit-bfc-dialog @Parts.Classes?.Dialog" style="@Parts.Styles?.Dialog" role="dialog" aria-modal="true" aria-labelledby="@_dialogTitleId" tabindex="-1" @ref="_dialogRef"
         @onkeydown="OnDialogKeyDown" @onclick:stopPropagation="true">
        <div class="bit-bfc-dialog-header">
            <h3 id="@_dialogTitleId">@string.Format(State.Culture, Texts.EventListTitleFormat, Date.ToString("D", State.Culture))</h3>
            <p>@string.Format(State.Culture, Texts.EventListCountFormat, Events.Count)</p>
        </div>
        <div class="bit-bfc-dialog-body bit-bfc-dialog-body-scroll">
            @* Same reading order the agenda list uses: the all-day events of the date first, then
               the timed ones in clock order, so the overflow list is not in supply order. *@
            @foreach (var ev in SortedEvents)
            {
                <button type="button" class="bit-bfc-agenda-item @Parts.Classes?.Event @ev.CssClass" style="@Parts.Styles?.Event"
                        title="@BitFullCalendarHelpers.BuildEventTooltip(ev, State.Use24HourFormat, State.Culture, Texts.AllDayLabel)"
                        @onclick="() => SelectEvent(ev)">
                    <span class="bit-bfc-agenda-avatar bit-bfc-bg" style="@ColorScheme.GetColorStyle(ev.Color)" aria-hidden="true">
                        @(ev.Attendees.Count > 0 ? ev.Attendees[0].Initials : "")
                    </span>
                    <span class="bit-bfc-agenda-info">
                        <span class="bit-bfc-agenda-title">@ev.Title</span>
                        <span class="bit-bfc-agenda-desc">@ev.Description</span>
                    </span>
                    <span class="bit-bfc-agenda-time">
                        @* An all-day event has no clock time to show, so the label stands in for it. *@
                        @(ev.IsAllDay
                            ? Texts.AllDayLabel
                            : BitFullCalendarHelpers.FormatTime(ev.StartDate, State.Use24HourFormat, State.Culture))
                    </span>
                </button>
            }
        </div>
        <div class="bit-bfc-dialog-footer">
            <button type="button" class="bit-bfc-btn" @onclick="OnClose">@Texts.CloseButton</button>
        </div>
    </div>
</div>

@if (_showDetails && _selectedEvent != null)
{
    <BitFcEventDetailsDialog Event="_selectedEvent" OnClose="() => _showDetails = false" />
}
