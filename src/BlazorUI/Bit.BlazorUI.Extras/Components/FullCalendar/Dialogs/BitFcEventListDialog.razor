@namespace Bit.BlazorUI

<div class="bit-bfc-overlay" @onclick="OnClose">
    <div class="bit-bfc-dialog" @onclick:stopPropagation="true">
        <div class="bit-bfc-dialog-header">
            <h3>@Texts.EventListTitlePrefix @Date.ToString("dddd, MMM d, yyyy", State.Culture)</h3>
            <p>@Events.Count @Texts.EventListCountSuffix</p>
        </div>
        <div class="bit-bfc-dialog-body" style="max-height:400px;overflow-y:auto;">
            @foreach (var ev in Events)
            {
                <div class="bit-bfc-agenda-item" tabindex="0" role="button" @onclick="() => SelectEvent(ev)" @onkeydown="@(e => OnEventKeyDown(e, ev))">
                    <div class="bit-bfc-agenda-avatar bit-bfc-bg" style="@ColorScheme.GetColorStyle(ev.Color)">
                        @(ev.Attendees.Count > 0 ? ev.Attendees[0].Initials : "")
                    </div>
                    <div class="bit-bfc-agenda-info">
                        <div class="bit-bfc-agenda-title">@ev.Title</div>
                        <div class="bit-bfc-agenda-desc">@ev.Description</div>
                    </div>
                    <div class="bit-bfc-agenda-time">
                        @BitFullCalendarHelpers.FormatTime(ev.StartDate, State.Use24HourFormat)
                    </div>
                </div>
            }
        </div>
        <div class="bit-bfc-dialog-footer">
            <button class="bit-bfc-btn" @onclick="OnClose">@Texts.CloseButton</button>
        </div>
    </div>
</div>

@if (_showDetails && _selectedEvent != null)
{
    <BitFcEventDetailsDialog Event="_selectedEvent" OnClose="() => _showDetails = false" />
}
