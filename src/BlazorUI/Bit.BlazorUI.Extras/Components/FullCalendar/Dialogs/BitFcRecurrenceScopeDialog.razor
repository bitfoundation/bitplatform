@namespace Bit.BlazorUI

<div class="bit-bfc-overlay" @onclick="OnCancel">
    @* Escape backs out of the choice the way it closes every other modal of the calendar. data-bit-esc claims
       that press (see Utils.claimEscape), so a surface the calendar sits in (a BitModal, a BitPanel) does not
       close on it too. *@
    <div @ref="_dialogRef" class="bit-bfc-dialog bit-bfc-scope-dialog @Parts.Classes?.Dialog" style="@Parts.Styles?.Dialog" role="dialog" aria-modal="true" aria-labelledby="@_titleId" tabindex="-1"
         data-bit-esc="claim"
         @onkeydown="OnDialogKeyDown" @onclick:stopPropagation="true">
        <div class="bit-bfc-dialog-header">
            <h3 id="@_titleId">@Title</h3>
        </div>
        <div class="bit-bfc-dialog-body" role="radiogroup" aria-labelledby="@_titleId">
            <label class="bit-bfc-field-inline bit-bfc-scope-option">
                <input type="radio" name="@_groupName" checked="@(_scope is Scope.This)" @onchange="() => _scope = Scope.This" />
                <span>@Texts.ThisOccurrenceOption</span>
            </label>
            @if (OnConfirmFollowing.HasDelegate)
            {
                <label class="bit-bfc-field-inline bit-bfc-scope-option">
                    <input type="radio" name="@_groupName" checked="@(_scope is Scope.Following)" @onchange="() => _scope = Scope.Following" />
                    <span>@Texts.ThisAndFollowingOption</span>
                </label>
            }
            <label class="bit-bfc-field-inline bit-bfc-scope-option">
                <input type="radio" name="@_groupName" checked="@(_scope is Scope.All)" @onchange="() => _scope = Scope.All" />
                <span>@Texts.AllOccurrencesOption</span>
            </label>
        </div>
        <div class="bit-bfc-dialog-footer">
            <button type="button" class="bit-bfc-btn" @onclick="OnCancel">@Texts.CancelButton</button>
            <button type="button" class="bit-bfc-btn bit-bfc-btn-primary" @onclick="Confirm">@Texts.OkButton</button>
        </div>
    </div>
</div>
