@using System.Globalization
@namespace Bit.BlazorUI
@inject IJSRuntime JS

@* Escape closes the picker's own popup first and stops there, so it never dismisses the dialog the
   picker sits in while the popup is still open. *@
<div class="bit-bfc-dtp" tabindex="-1" @onkeydown="OnKeyDown" @onkeydown:stopPropagation="_isOpen" @onfocusout="OnFocusOut" @onfocusin="OnFocusIn">
    <button type="button" id="@_TriggerId" class="bit-bfc-dtp-trigger" @onclick="ToggleOpen" aria-haspopup="dialog" aria-expanded="@(_isOpen ? "true" : "false")" aria-controls="@(_isOpen ? _PanelId : null)" aria-label="@GetTriggerAriaLabel()"
            aria-invalid="@(Invalid ? "true" : null)" aria-describedby="@DescribedBy">
        <span>@GetDisplayText()</span>
        <span class="bit-bfc-dtp-trigger-icon" aria-hidden="true">&#9662;</span>
    </button>

    @if (_isOpen)
    {
        <div id="@_PanelId" class="bit-bfc-dtp-panel" role="dialog" aria-label="@(TriggerAriaLabel ?? GetMonthYearLabel(_visibleMonthAnchor))">
            <div class="bit-bfc-dtp-header">
                <button type="button" class="bit-bfc-dtp-nav-btn" @onclick="ShowPreviousMonth" aria-label="@PreviousMonthAriaLabel">
                    &#8249;
                </button>
                @* Announced as the arrow keys or the chevrons turn the month. *@
                <div class="bit-bfc-dtp-month-label" aria-live="polite">@GetMonthYearLabel(_visibleMonthAnchor)</div>
                <button type="button" class="bit-bfc-dtp-nav-btn" @onclick="ShowNextMonth" aria-label="@NextMonthAriaLabel">
                    &#8250;
                </button>
            </div>

            <div class="bit-bfc-dtp-weekdays" aria-hidden="true">
                @foreach (var weekday in _weekdayHeaders)
                {
                    <span>@weekday</span>
                }
            </div>

            <div class="bit-bfc-dtp-days">
                @foreach (var day in BuildCalendarDays())
                {
                    var dayClass = GetDayCellClass(day);
                    @* A date the calendar itself may not navigate to cannot be picked either, so the
                       cell is disabled here instead of only failing validation on save. *@
                    var outOfRange = IsOutOfRange(day.Date);
                    @* Roving tabindex: the day grid is one tab stop the arrow keys walk. *@
                    <button type="button" class="@dayClass" id="@DayId(day.Date)" aria-label="@GetDayAriaLabel(day)" disabled="@outOfRange"
                            data-bit-bfc-roving tabindex="@(day.Date == RovingDate ? "0" : "-1")"
                            aria-current="@(day.Date == (State?.Today ?? DateTime.Today) ? "date" : null)"
                            @onkeydown="args => OnDayKeyDown(day.Date, args)"
                            @onclick="() => SelectDate(day.Date)">
                        @day.Label
                    </button>
                }
            </div>

            @if (ShowTime)
            {
                <div class="bit-bfc-dtp-time">
                    @if (Use24HourFormat)
                    {
                        <select @bind="_hour" @bind:after="OnTimeChanged" aria-label="@HourAriaLabel">
                            @for (var i = 0; i < 24; i++)
                            {
                                <option value="@i">@i.ToString("00", CultureInfo.InvariantCulture)</option>
                            }
                        </select>
                        <span>:</span>
                        <select @bind="_minute" @bind:after="OnTimeChanged" aria-label="@MinuteAriaLabel">
                            @for (var i = 0; i < 60; i++)
                            {
                                <option value="@i">@i.ToString("00", CultureInfo.InvariantCulture)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select value="@Hour12" @onchange="OnHour12Changed" aria-label="@HourAriaLabel">
                            @for (var i = 1; i <= 12; i++)
                            {
                                <option value="@i">@i.ToString("00", CultureInfo.InvariantCulture)</option>
                            }
                        </select>
                        <span>:</span>
                        <select @bind="_minute" @bind:after="OnTimeChanged" aria-label="@MinuteAriaLabel">
                            @for (var i = 0; i < 60; i++)
                            {
                                <option value="@i">@i.ToString("00", CultureInfo.InvariantCulture)</option>
                            }
                        </select>
                        <select value="@(IsPm ? "PM" : "AM")" @onchange="OnMeridiemChanged" aria-label="@MeridiemAriaLabel">
                            <option value="AM">@Culture.DateTimeFormat.AMDesignator</option>
                            <option value="PM">@Culture.DateTimeFormat.PMDesignator</option>
                        </select>
                    }
                </div>
            }
        </div>
    }
</div>
