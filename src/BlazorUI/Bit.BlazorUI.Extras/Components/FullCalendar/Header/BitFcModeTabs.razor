@namespace Bit.BlazorUI

@*
  Top-level mode switch (Event ⇄ Timeline). The Timeline tab is hidden when no resources are
  supplied because the timeline mode is meaningless without resources.
*@

@if (State.Resources.Count > 0)
{
    <div class="bit-bfc-mode-tabs">
        @foreach (var mode in _modes)
        {
            <button class="bit-bfc-mode-tab @(State.Mode == mode ? "active" : "")"
                    type="button"
                    @onclick="() => State.SetMode(mode)">
                @Texts.GetModeLabel(mode)
            </button>
        }
    </div>
}
