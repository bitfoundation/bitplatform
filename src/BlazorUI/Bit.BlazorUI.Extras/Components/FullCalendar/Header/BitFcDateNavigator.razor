@namespace Bit.BlazorUI

<div class="bit-bfc-date-nav">
    @* A step that would leave the MinDate/MaxDate window is not offered at all, so the button state
       matches what State.NavigatePrevious/NavigateNext would actually do. The chevrons are drawn for a
       left-to-right reading; the stylesheet mirrors them in a right-to-left one. *@
    <button type="button" class="bit-bfc-btn bit-bfc-btn-icon bit-bfc-btn-sm bit-bfc-btn-nav" @onclick="State.NavigatePrevious" disabled="@(State.CanNavigatePrevious is false)" title="@Texts.PreviousButtonTitle" aria-label="@Texts.PreviousButtonTitle">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <span class="bit-bfc-header-title" aria-live="polite" aria-atomic="true">
        @BitFullCalendarHelpers.RangeText(State.View, State.SelectedDate, State.Culture, State.FirstDayOfWeekOverride)
    </span>
    <button type="button" class="bit-bfc-btn bit-bfc-btn-icon bit-bfc-btn-sm bit-bfc-btn-nav" @onclick="State.NavigateNext" disabled="@(State.CanNavigateNext is false)" title="@Texts.NextButtonTitle" aria-label="@Texts.NextButtonTitle">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
</div>
