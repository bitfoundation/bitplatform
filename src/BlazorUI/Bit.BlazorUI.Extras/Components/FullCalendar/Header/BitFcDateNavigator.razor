@namespace Bit.BlazorUI

<div class="bit-bfc-date-nav">
    @* A step that would leave the MinDate/MaxDate window is not offered, so the button state matches what
       State.NavigatePrevious/NavigateNext would actually do (nothing). The buttons are aria-disabled rather than
       disabled: the press that reaches the edge would otherwise disable the very button holding the focus and
       drop it to the page. The chevrons are drawn for a
       left-to-right reading; the stylesheet mirrors them in a right-to-left one. *@
    <button type="button" class="bit-bfc-btn bit-bfc-btn-icon bit-bfc-btn-sm bit-bfc-btn-nav" @onclick="State.NavigatePrevious" aria-disabled="@(State.CanNavigatePrevious ? null : "true")" title="@Texts.PreviousButtonTitle" aria-label="@Texts.PreviousButtonTitle">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <span class="bit-bfc-header-title" aria-live="polite" aria-atomic="true">
        @BitFullCalendarHelpers.RangeText(State.View, State.WeekAnchor, State.Culture, State.FirstDayOfWeekOverride, State.WeekDayCount, State.HiddenDays)
    </span>
    <button type="button" class="bit-bfc-btn bit-bfc-btn-icon bit-bfc-btn-sm bit-bfc-btn-nav" @onclick="State.NavigateNext" aria-disabled="@(State.CanNavigateNext ? null : "true")" title="@Texts.NextButtonTitle" aria-label="@Texts.NextButtonTitle">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
</div>
