@namespace Bit.BlazorUI
@inject IJSRuntime JS

@* The panel is dismissed by Escape and by a click anywhere outside it, so it never stays stuck open
   behind the rest of the calendar. focusout is deferred so moving between the panel's own controls
   does not close it. It is a non-modal dialog of form controls - switches, a number, a select and a
   radio group - which a role="menu" (menu items only) could not hold. *@
<div class="bit-bfc-dropdown" @onkeydown="OnKeyDown" @onfocusout="OnFocusOut" @onfocusin="OnFocusIn">
    <button type="button" id="@_buttonId" class="bit-bfc-btn bit-bfc-btn-icon bit-bfc-btn-sm" @onclick="Toggle" title="@Texts.SettingsButtonTitle" aria-label="@Texts.SettingsButtonTitle" aria-haspopup="dialog" aria-expanded="@(_open ? "true" : "false")" aria-controls="@(_open ? _menuId : null)">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    </button>
    @if (_open)
    {
        <div class="bit-bfc-dropdown-menu" id="@_menuId" role="dialog" aria-labelledby="@_titleId" tabindex="-1">
            <div class="bit-bfc-dropdown-label" id="@_titleId">@Texts.CalendarSettingsLabel</div>

            @* An on/off preference is a switch: its state is read as on/off rather than as a pressed button. *@
            <button type="button" class="bit-bfc-dropdown-item" role="switch" aria-checked="@((State.BadgeVariant == BitFullCalendarBadgeVariant.Dot) ? "true" : "false")" @onclick="ToggleBadgeVariant">
                <span>@Texts.DotBadgeLabel</span>
                <span class="bit-bfc-toggle @((State.BadgeVariant == BitFullCalendarBadgeVariant.Dot) ? "checked" : "")" aria-hidden="true">
                    <span class="bit-bfc-toggle-track"></span>
                    <span class="bit-bfc-toggle-thumb"></span>
                </span>
            </button>
            <button type="button" class="bit-bfc-dropdown-item" role="switch" aria-checked="@((State.Use24HourFormat) ? "true" : "false")" @onclick="State.ToggleTimeFormat">
                <span>@Texts.TwentyFourHourFormatLabel</span>
                <span class="bit-bfc-toggle @((State.Use24HourFormat) ? "checked" : "")" aria-hidden="true">
                    <span class="bit-bfc-toggle-track"></span>
                    <span class="bit-bfc-toggle-thumb"></span>
                </span>
            </button>
            <button type="button" class="bit-bfc-dropdown-item" role="switch" aria-checked="@((State.EventLayout == BitFullCalendarEventLayout.Stack) ? "true" : "false")" @onclick="State.ToggleEventLayout">
                <span>@Texts.StackedEventsLabel</span>
                <span class="bit-bfc-toggle @((State.EventLayout == BitFullCalendarEventLayout.Stack) ? "checked" : "")" aria-hidden="true">
                    <span class="bit-bfc-toggle-track"></span>
                    <span class="bit-bfc-toggle-thumb"></span>
                </span>
            </button>
            <button type="button" class="bit-bfc-dropdown-item" role="switch" aria-checked="@((State.ShowDayViewCalendar) ? "true" : "false")" @onclick="State.ToggleShowDayViewCalendar">
                <span>@Texts.ShowDayViewCalendarLabel</span>
                <span class="bit-bfc-toggle @((State.ShowDayViewCalendar) ? "checked" : "")" aria-hidden="true">
                    <span class="bit-bfc-toggle-track"></span>
                    <span class="bit-bfc-toggle-thumb"></span>
                </span>
            </button>
            <button type="button" class="bit-bfc-dropdown-item" role="switch" aria-checked="@((State.ShowWeekNumbers) ? "true" : "false")" @onclick="State.ToggleShowWeekNumbers">
                <span>@Texts.ShowWeekNumbersLabel</span>
                <span class="bit-bfc-toggle @((State.ShowWeekNumbers) ? "checked" : "")" aria-hidden="true">
                    <span class="bit-bfc-toggle-track"></span>
                    <span class="bit-bfc-toggle-thumb"></span>
                </span>
            </button>
            <button type="button" class="bit-bfc-dropdown-item" role="switch" aria-checked="@((State.ShowCurrentTimeIndicator) ? "true" : "false")" @onclick="State.ToggleShowCurrentTimeIndicator">
                <span>@Texts.ShowCurrentTimeIndicatorLabel</span>
                <span class="bit-bfc-toggle @((State.ShowCurrentTimeIndicator) ? "checked" : "")" aria-hidden="true">
                    <span class="bit-bfc-toggle-track"></span>
                    <span class="bit-bfc-toggle-thumb"></span>
                </span>
            </button>
            <button type="button" class="bit-bfc-dropdown-item" role="switch" aria-checked="@((State.HighlightBusinessHours) ? "true" : "false")" @onclick="State.ToggleHighlightBusinessHours">
                <span>@Texts.HighlightBusinessHoursLabel</span>
                <span class="bit-bfc-toggle @((State.HighlightBusinessHours) ? "checked" : "")" aria-hidden="true">
                    <span class="bit-bfc-toggle-track"></span>
                    <span class="bit-bfc-toggle-thumb"></span>
                </span>
            </button>

            <div class="bit-bfc-dropdown-sep" role="separator"></div>

            <div class="bit-bfc-dropdown-item">
                <label for="@_startHourId">@Texts.DayStartsAtLabel</label>
                <span class="bit-bfc-dropdown-field">
                    <input id="@_startHourId" type="number" min="@State.VisibleStartHour" max="@(State.VisibleEndHour - 1)" value="@State.StartOfDayHour"
                           @onchange="OnStartHourChange" />
                    <span aria-hidden="true">@Texts.HourSuffix</span>
                </span>
            </div>

            <div class="bit-bfc-dropdown-item">
                <label for="@_slotDurationId">@Texts.SlotDurationLabel</label>
                <span class="bit-bfc-dropdown-field">
                    <select id="@_slotDurationId" value="@State.SlotDurationMinutes" @onchange="OnSlotDurationChange">
                        @foreach (var duration in _slotDurations)
                        {
                            <option value="@duration" selected="@(duration == State.SlotDurationMinutes)">@duration @Texts.MinuteSuffix</option>
                        }
                    </select>
                </span>
            </div>

            <div class="bit-bfc-dropdown-sep" role="separator"></div>
            <div role="radiogroup" aria-labelledby="@_groupById">
                <div class="bit-bfc-dropdown-label" id="@_groupById">@Texts.AgendaGroupByLabel</div>
                <button type="button" class="bit-bfc-dropdown-item bit-bfc-dropdown-choice" role="radio" data-bit-bfc-roving="arrows"
                        id="@ChoiceId(BitFullCalendarAgendaGroupBy.Date)"
                        aria-checked="@(State.AgendaModeGroupBy == BitFullCalendarAgendaGroupBy.Date ? "true" : "false")"
                        tabindex="@(State.AgendaModeGroupBy == BitFullCalendarAgendaGroupBy.Date ? "0" : "-1")"
                        @onkeydown="OnChoiceKeyDown"
                        @onclick="() => State.SetAgendaModeGroupBy(BitFullCalendarAgendaGroupBy.Date)">
                    @Texts.AgendaGroupByDate
                </button>
                <button type="button" class="bit-bfc-dropdown-item bit-bfc-dropdown-choice" role="radio" data-bit-bfc-roving="arrows"
                        id="@ChoiceId(BitFullCalendarAgendaGroupBy.Color)"
                        aria-checked="@(State.AgendaModeGroupBy == BitFullCalendarAgendaGroupBy.Color ? "true" : "false")"
                        tabindex="@(State.AgendaModeGroupBy == BitFullCalendarAgendaGroupBy.Color ? "0" : "-1")"
                        @onkeydown="OnChoiceKeyDown"
                        @onclick="() => State.SetAgendaModeGroupBy(BitFullCalendarAgendaGroupBy.Color)">
                    @Texts.AgendaGroupByColor
                </button>
            </div>
        </div>
    }
</div>
