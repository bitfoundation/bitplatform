@namespace Bit.BlazorUI
@implements IDisposable

@* Positioned against --bit-bfc-hour-height, the same custom property the hour rows are sized from,
   so re-scaling the grid keeps the marker on the clock time it reports. *@
<div class="bit-bfc-timeline" style="top:@BitFullCalendarHelpers.HoursToCssLength(_offsetHours);">
    <span class="bit-bfc-timeline-label">@BitFullCalendarHelpers.FormatTime(DateTime.Now, State.Use24HourFormat, State.Culture)</span>
    <span class="bit-bfc-timeline-dot"></span>
    <span class="bit-bfc-timeline-line"></span>
</div>
