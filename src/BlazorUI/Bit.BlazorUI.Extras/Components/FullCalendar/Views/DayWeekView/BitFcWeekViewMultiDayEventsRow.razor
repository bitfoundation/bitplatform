@namespace Bit.BlazorUI

@if (_rowCount > 0)
{
    <div class="bit-bfc-multiday-row" style="padding-inline-start:60px;">
        <div style="display:grid;grid-template-columns:repeat(7,1fr);column-gap:0;">
            @foreach (var day in _weekDays)
            {
                var d = day;
                <div style="display:flex;flex-direction:column;gap:1px;">
                    @for (int row = 0; row < _rowCount; row++)
                    {
                        var r = row;
                        var ev = _weekEvents.FirstOrDefault(e =>
                            _eventRows.GetValueOrDefault(e.Id) == r &&
                            e.StartDate.Date <= d.Date && e.EndDate.Date >= d.Date);
                        if (ev != null)
                        {
                            var position = ev.StartDate.Date == d.Date ? "first"
                                : ev.EndDate.Date == d.Date ? "last" : "middle";
                            <BitFcMonthEventBadge Event="ev" CellDate="d" Position="@position" OnSelected="ShowEventDetails" EventTemplate="EventTemplate" />
                        }
                        else
                        {
                            <div style="height:22px;"></div>
                        }
                    }
                </div>
            }
        </div>
    </div>
}

@if (_selectedEvent != null)
{
    <BitFcEventDetailsDialog Event="_selectedEvent" OnClose="CloseEventDetails" />
}

