@namespace Bit.BlazorUI

<div class="bit-bfc-time-column">
    @foreach (var hour in State.VisibleHours)
    {
        <div class="bit-bfc-time-slot-label">
            @* The very first label would sit above the grid's top edge, so it is left out - the row
               it belongs to starts the grid and needs no boundary marker. *@
            @if (hour > State.VisibleStartHour)
            {
                @BitFullCalendarHelpers.FormatHourLabel(hour, State.Use24HourFormat, State.Culture)
            }
        </div>
    }
</div>
