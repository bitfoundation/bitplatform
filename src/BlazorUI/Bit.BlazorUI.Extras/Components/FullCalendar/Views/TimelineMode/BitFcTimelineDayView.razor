@namespace Bit.BlazorUI
@inject IJSRuntime JS

@*
  Timeline mode - Day view.
  Resources × one column per visible hour of the selected date.
*@

@{
    const int hourWidth = BitFullCalendarHelpers.TimelineHourWidthPx;
    const int laneHeight = 44;
    const int laneGap = 4;
    const int rowPadding = 4;
    const int minRowHeight = 60;

    var resources = State.Resources;
    var resourceIds = resources.Select(r => r.Id).Where(id => !string.IsNullOrWhiteSpace(id)).ToList();
    var grouped = BitFullCalendarHelpers.GroupEventsByResourceForDay(
        Events, State.SelectedDate, resourceIds, _unassignedKey);

    int LaneCountFor(string key) =>
        grouped.TryGetValue(key, out var lanes) && lanes.Count > 0 ? lanes.Count : 1;

    int RowHeight(int laneCount)
    {
        var content = (laneCount * laneHeight) + (Math.Max(0, laneCount - 1) * laneGap) + (rowPadding * 2);
        return Math.Max(minRowHeight, content);
    }

    var hasUnassigned = (grouped.TryGetValue(_unassignedKey, out var u) && u.Count > 0) || resourceIds.Count == 0;
    var unassignedLaneCount = hasUnassigned ? LaneCountFor(_unassignedKey) : 1;
    // The rendered row order is what the roving tabindex walks vertically.
    _rowKeys = hasUnassigned ? [.. resourceIds, _unassignedKey] : [.. resourceIds];
    // The row renders only the hours the calendar shows, so a working-hours window is as narrow
    // horizontally here as it is vertically on the day/week grids.
    var visibleHours = State.VisibleHours.ToArray();
    var scrollHour = State.StartOfDayHour;
}

<BitFcTimelineLayout ColumnCount="visibleHours.Length"
                ColumnWidthPx="hourWidth"
                ScrollContainerId="@_scrollContainerId"
                HasUnassignedRow="hasUnassigned"
                RowHeightFor="r => RowHeight(LaneCountFor(r.Id))"
                UnassignedRowHeight="RowHeight(unassignedLaneCount)">

    <HeaderContent>
        <div class="bit-bfc-tl-time-row bit-bfc-tl-time-row-slots">
            @foreach (var h in visibleHours)
            {
                var hour = h;
                var isScrollTarget = hour == scrollHour;
                <div class="bit-bfc-tl-time-cell" style="width:@(hourWidth)px;" data-bit-bfc-tl-scroll-target="@(isScrollTarget ? "true" : null)">
                    <span class="bit-bfc-tl-time-cell-label">@BitFullCalendarHelpers.FormatHourLabel(hour, State.Use24HourFormat, State.Culture)</span>
                </div>
            }
        </div>
    </HeaderContent>

    <RowContent Context="resource">
        @RowCells((resource.Id, resource.Title))
        @if (grouped.TryGetValue(resource.Id, out var lanes))
        {
            @RenderLanes(lanes)
        }
        @NowIndicator
    </RowContent>

    <UnassignedRowContent>
        @RowCells((_unassignedKey, Texts.NoResourceLabel))
        @if (hasUnassigned && grouped.TryGetValue(_unassignedKey, out var unassignedLanes))
        {
            @RenderLanes(unassignedLanes)
        }
        @NowIndicator
    </UnassignedRowContent>
</BitFcTimelineLayout>

@if (_showAddDialog)
{
    <BitFcAddEditEventDialog StartDate="_addStartDate" StartHour="_addStartHour" StartMinute="_addStartMinute" Resource="_addResourceId" OnClose="() => _showAddDialog = false" />
}

@if (_selectedEvent != null)
{
    <BitFcEventDetailsDialog Event="_selectedEvent" OnClose="CloseEventDetails" />
}

@code {
    // The "current time" rule of every row, rendered only while the selected date is today and the
    // clock falls inside the hours the row shows (the component decides both).
    private RenderFragment NowIndicator => @<text>
        @* Only today has a marker to place; skipping it otherwise keeps a row from running a timer
           it would never use. *@
        @if (State.ShowCurrentTimeIndicator && State.SelectedDate.Date == DateTime.Today)
        {
            <BitFcTimelineNowIndicator Day="State.SelectedDate"
                                       ColumnOffsetPx="0"
                                       PixelsPerMinute="@(BitFullCalendarHelpers.TimelineHourWidthPx / 60.0)"
                                       VisibleStartHour="State.VisibleStartHour"
                                       VisibleEndHour="State.VisibleEndHour" />
        }
    </text>;

    // The resource rows and the trailing "unassigned" row draw the same grid of drop targets, so the
    // cells are written once and rendered with the row's key and label.
    private RenderFragment<(string Key, string Label)> RowCells => row =>
        @<text>
            @{
                const int cellHourWidth = BitFullCalendarHelpers.TimelineHourWidthPx;
                var inv = System.Globalization.CultureInfo.InvariantCulture;
                var slots = State.SlotMinutes;
                var slotWidthPercent = 100.0 / slots.Length;
                var hours = State.VisibleHours.ToArray();
            }
            @for (var hi = 0; hi < hours.Length; hi++)
            {
                var hour = hours[hi];
                var leftPx = hi * cellHourWidth;
                <div class="bit-bfc-tl-cell" style="inset-inline-start:@(leftPx)px;width:@(cellHourWidth)px;">
                    @for (var si = 0; si < slots.Length; si++)
                    {
                        var slotIndex = si;
                        var minute = slots[si];
                        var isPreview = State.IsDragging && _dragResourceId == row.Key && _dragHour == hour && _dragMinute == minute;
                        var startPercent = (slotIndex * slotWidthPercent).ToString("F4", inv);
                        var widthPercent = slotWidthPercent.ToString("F4", inv);
                        <div class="@(slotIndex == 0 ? "bit-bfc-tl-cell-slot" : "bit-bfc-tl-cell-half") @(isPreview ? "bit-bfc-tl-drop-preview" : "") @OffHoursClass(State.SelectedDate, hour, minute)"
                             id="@SlotElementId(row.Key, hour, minute)"
                             style="position:absolute;top:0;bottom:0;inset-inline-start:@(startPercent)%;inset-inline-end:auto;width:@(widthPercent)%;"
                             role="@_slotRole"
                             tabindex="@SlotTabIndex(row.Key, hour, minute)"
                             aria-label="@SlotAriaLabel(row.Label, hour, minute)"
                             @ondragenter="() => OnDragEnter(row.Key, hour, minute)"
                             @ondragover:preventDefault="true"
                             @ondrop="() => OnDrop(row.Key, hour, minute)"
                             @onclick="() => OnSlotClickAsync(row.Key, hour, minute)"
                             @onkeydown="e => OnSlotKeyDownAsync(e, row.Key, hour, minute)"></div>
                    }
                    @if (!State.ReadOnly)
                    {
                        <div class="bit-bfc-cell-add-hint" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            @Texts.AddEventHoverHint
                        </div>
                    }
                </div>
            }
        </text>;
}
