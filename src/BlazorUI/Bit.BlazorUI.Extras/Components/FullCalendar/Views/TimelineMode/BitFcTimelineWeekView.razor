@namespace Bit.BlazorUI
@inject IJSRuntime JS

@*
  Timeline mode - Week view.
  Resources × (visible days × visible hours) hour-precision columns.
  Two-row time header: top row spans each day, bottom row shows hourly slots.
*@

@{
    const int hourWidth = BitFullCalendarHelpers.TimelineHourWidthPx;
    const int laneHeight = 44;
    const int laneGap = 4;
    const int rowPadding = 4;
    const int minRowHeight = 60;

    var weekStart = BitFullCalendarHelpers.StartOfWeek(State.SelectedDate, State.Culture, State.FirstDayOfWeekOverride);
    // Hidden weekdays are dropped from the axis, so a work-week timeline is as narrow as the grid.
    var weekDays = BitFullCalendarHelpers.GetWeekDates(State.SelectedDate, State.Culture, State.FirstDayOfWeekOverride, State.HiddenDays);
    var visibleHours = State.VisibleHours.ToArray();
    var hoursPerDay = visibleHours.Length;

    var resources = State.Resources;
    var resourceIds = resources.Select(r => r.Id).Where(id => !string.IsNullOrWhiteSpace(id)).ToList();

    // Lanes per (resourceId, dayIndex)
    var perDay = weekDays.Select(d =>
        BitFullCalendarHelpers.GroupEventsByResourceForDay(Events, d, resourceIds, _unassignedKey)
    ).ToArray();

    int LaneCountFor(string resourceId)
    {
        if (string.IsNullOrEmpty(resourceId))
            return 1;

        var max = 1;
        foreach (var dayMap in perDay)
        {
            if (dayMap.TryGetValue(resourceId, out var lanes) && lanes.Count > max)
                max = lanes.Count;
        }
        return max;
    }

    int RowHeight(int laneCount)
    {
        var content = (laneCount * laneHeight) + (Math.Max(0, laneCount - 1) * laneGap) + (rowPadding * 2);
        return Math.Max(minRowHeight, content);
    }

    // Render the unassigned lane when there are unassigned events, OR when there are no resources at
    // all so the user always has at least one row to add the first event to.
    var hasUnassignedEvents = perDay.Any(m => m.TryGetValue(_unassignedKey, out var l) && l.Count > 0);
    var hasUnassigned = hasUnassignedEvents || resourceIds.Count == 0;
    var unassignedLaneCount = hasUnassigned ? LaneCountFor(_unassignedKey) : 1;
    var totalColumns = weekDays.Length * hoursPerDay;
    // The rendered row and day order is what the roving tabindex walks.
    _rowKeys = hasUnassigned ? [.. resourceIds, _unassignedKey] : [.. resourceIds];
    _weekDays = weekDays;

    // Pick the day and hour cell that should be in view after render: today's day if it falls
    // inside the visible week, otherwise the first day. Within that day, the start-of-day hour.
    var todayIdx = Array.FindIndex(weekDays, d => d.Date == DateTime.Today);
    var scrollDayIdx = todayIdx >= 0 ? todayIdx : 0;
    var scrollHour = State.StartOfDayHour;
}

<BitFcTimelineLayout ColumnCount="totalColumns"
                ColumnWidthPx="hourWidth"
                ScrollContainerId="@_scrollContainerId"
                HasUnassignedRow="hasUnassigned"
                RowHeightFor="r => RowHeight(LaneCountFor(r.Id))"
                UnassignedRowHeight="RowHeight(unassignedLaneCount)">

    <HeaderContent>
        <div class="bit-bfc-tl-time-row bit-bfc-tl-time-row-days">
            @foreach (var d in weekDays)
            {
                var isToday = d.Date == DateTime.Today;
                <div class="bit-bfc-tl-day-header @(isToday ? "today" : "")" style="width:@(hoursPerDay * hourWidth)px;">
                    <span class="bit-bfc-tl-day-header-name">@d.ToString("ddd", State.Culture)</span>
                    <span class="bit-bfc-tl-day-header-date">@d.ToString("M/d", State.Culture)</span>
                </div>
            }
        </div>
        <div class="bit-bfc-tl-time-row bit-bfc-tl-time-row-slots">
            @for (var di = 0; di < weekDays.Length; di++)
            {
                var dayIndex = di;
                @foreach (var h in visibleHours)
                {
                    var hour = h;
                    var isScrollTarget = dayIndex == scrollDayIdx && hour == scrollHour;
                    <div class="bit-bfc-tl-time-cell" style="width:@(hourWidth)px;" data-bit-bfc-tl-scroll-target="@(isScrollTarget ? "true" : null)">
                        <span class="bit-bfc-tl-time-cell-label">@BitFullCalendarHelpers.FormatHourLabel(hour, State.Use24HourFormat, State.Culture)</span>
                    </div>
                }
            }
        </div>
    </HeaderContent>

    <RowContent Context="resource">
        @for (var di = 0; di < weekDays.Length; di++)
        {
            var dayIndex = di;
            var day = weekDays[dayIndex];
            var dayOffsetPx = dayIndex * hoursPerDay * hourWidth;
            var dayMap = perDay[dayIndex];

            @RowCells((resource.Id, resource.Title, day, dayOffsetPx))

            @if (!string.IsNullOrEmpty(resource.Id) && dayMap.TryGetValue(resource.Id, out var lanes))
            {
                @RenderLanes(lanes, day, dayOffsetPx)
            }
        }
    </RowContent>

    <UnassignedRowContent>
        @for (var di = 0; di < weekDays.Length; di++)
        {
            var dayIndex = di;
            var day = weekDays[dayIndex];
            var dayOffsetPx = dayIndex * hoursPerDay * hourWidth;
            var dayMap = perDay[dayIndex];

            @RowCells((_unassignedKey, Texts.NoResourceLabel, day, dayOffsetPx))

            @if (dayMap.TryGetValue(_unassignedKey, out var lanes))
            {
                @RenderLanes(lanes, day, dayOffsetPx)
            }
        }
    </UnassignedRowContent>
</BitFcTimelineLayout>

@if (_showAddDialog)
{
    <BitFcAddEditEventDialog StartDate="_addStartDate" StartHour="_addStartHour" StartMinute="_addStartMinute" Resource="_addResourceId" OnClose="() => _showAddDialog = false" />
}

@if (_selectedEvent != null)
{
    <BitFcEventDetailsDialog Event="_selectedEvent" OnClose="CloseEventDetails" />
}

@code {
    // One day's worth of drop targets for a row. The resource rows and the trailing "unassigned"
    // row draw the same cells, so they are written once and rendered with the row's key and label.
    private RenderFragment<(string Key, string Label, DateTime Day, int DayOffsetPx)> RowCells => row =>
        @<text>
            @{
                const int cellHourWidth = BitFullCalendarHelpers.TimelineHourWidthPx;
                var inv = System.Globalization.CultureInfo.InvariantCulture;
                var slots = State.SlotMinutes;
                var slotWidthPercent = 100.0 / slots.Length;
                var hours = State.VisibleHours.ToArray();
            }
            @for (var hi = 0; hi < hours.Length; hi++)
            {
                var hour = hours[hi];
                var leftPx = row.DayOffsetPx + (hi * cellHourWidth);
                <div class="bit-bfc-tl-cell" style="inset-inline-start:@(leftPx)px;width:@(cellHourWidth)px;">
                    @for (var si = 0; si < slots.Length; si++)
                    {
                        var slotIndex = si;
                        var minute = slots[si];
                        var isPreview = State.IsDragging && _dragResourceId == row.Key && _dragDay == row.Day.Date && _dragHour == hour && _dragMinute == minute;
                        var startPercent = (slotIndex * slotWidthPercent).ToString("F4", inv);
                        var widthPercent = slotWidthPercent.ToString("F4", inv);
                        <div class="@(slotIndex == 0 ? "bit-bfc-tl-cell-slot" : "bit-bfc-tl-cell-half") @(isPreview ? "bit-bfc-tl-drop-preview" : "")"
                             id="@SlotElementId(row.Key, row.Day, hour, minute)"
                             style="position:absolute;top:0;bottom:0;inset-inline-start:@(startPercent)%;inset-inline-end:auto;width:@(widthPercent)%;"
                             role="@_slotRole"
                             tabindex="@SlotTabIndex(row.Key, row.Day, hour, minute)"
                             aria-label="@SlotAriaLabel(row.Label, row.Day, hour, minute)"
                             @ondragenter="() => OnDragEnter(row.Key, row.Day, hour, minute)"
                             @ondragover:preventDefault="true"
                             @ondrop="() => OnDrop(row.Key, row.Day, hour, minute)"
                             @onclick="() => OnSlotClickAsync(row.Key, row.Day, hour, minute)"
                             @onkeydown="e => OnSlotKeyDownAsync(e, row.Key, row.Day, hour, minute)"></div>
                    }
                    @if (!State.ReadOnly)
                    {
                        <div class="bit-bfc-cell-add-hint" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            @Texts.AddEventHoverHint
                        </div>
                    }
                </div>
            }
        </text>;
}
