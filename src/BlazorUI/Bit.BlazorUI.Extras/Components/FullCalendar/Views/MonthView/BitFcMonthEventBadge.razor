@namespace Bit.BlazorUI

@{
    var positionClass = Position switch
    {
        "first" => "position-first",
        "middle" => "position-middle",
        "last" => "position-last",
        _ => ""
    };

    var isDotVariant = State.BadgeVariant == BitFullCalendarBadgeVariant.Dot;
    var colorClass = isDotVariant ? "dot-variant" : "bit-bfc-color";
    var colorStyleVar = ColorScheme.GetColorStyle(Event.Color);
    var showTitle = Position is "first" or "none";
    // An all-day event has no meaningful clock time, so its badge shows the all-day label instead.
    var showTime = Position is "last" or "none" && Event.IsAllDay is false;
    var canDrag = State.CanDrag(Event);
    // Include both the start and end dates (not just the times) so multi-day and overnight events
    // are announced unambiguously to assistive technology. BitFcDayCell.GetBadgePosition() treats a
    // 00:00 end as ending the previous day (exclusive midnight) via GetInclusiveEndDate, so the
    // "last" badge for such events renders on that previous day. Mirror the same inclusive-end
    // adjustment here so the announced/rendered end day and time match where the badge actually
    // appears instead of pointing at the next day's midnight.
    var endIsExclusiveMidnight = Event.EndDate > Event.StartDate && Event.EndDate.TimeOfDay == TimeSpan.Zero;
    var displayEnd = endIsExclusiveMidnight ? Event.EndDate.AddTicks(-1) : Event.EndDate;
    var startLabel = $"{Event.StartDate.ToString("d", State.Culture)} {BitFullCalendarHelpers.FormatTime(Event.StartDate, State.Use24HourFormat, State.Culture)}";
    var endLabel = $"{displayEnd.ToString("d", State.Culture)} {BitFullCalendarHelpers.FormatTime(displayEnd, State.Use24HourFormat, State.Culture)}";
    // A badge shows its title and its start time side by side, and a name that does not hold that text in that order
    // fails Label in Name (WCAG 2.5.3): "Opening, 11/1/2026 07:00 - ..." leaves out the "Opening 07:00" a speech-input
    // user reads off it. So an event of one day is named by the title and its times first, with the date after them;
    // one that spans days keeps the start and the end with their dates, which is what its badges show part of.
    var startTime = BitFullCalendarHelpers.FormatTime(Event.StartDate, State.Use24HourFormat, State.Culture);
    var sameDay = Event.StartDate.Date == displayEnd.Date;
    var badgeAriaLabel = Event.IsAllDay
        ? $"{Event.Title}, {Texts.AllDayLabel}, {Event.StartDate.ToString("d", State.Culture)} - {displayEnd.ToString("d", State.Culture)}"
        : sameDay
            ? $"{Event.Title}, {startTime} - {BitFullCalendarHelpers.FormatTime(displayEnd, State.Use24HourFormat, State.Culture)}, {Event.StartDate.ToString("d", State.Culture)}"
            : $"{Event.Title}, {startLabel} - {endLabel}";
    var templated = EventTemplate is not null;
}

@* A badge is the narrowest surface an event is drawn on - the title alone rarely survives the cell
   width - so the full title, span, and description are offered on hover as well.
   A badge an EventTemplate draws shows whatever the template shows, which the details alone would not hold, so it
   is named by the template's text first and the details after it (aria-labelledby, the two ids below). *@
<div class="bit-bfc-event-badge @colorClass @positionClass @(Event.IsAllDay ? "bit-bfc-event-allday" : null) @Parts.Classes?.Event @Event.CssClass"
     style="@($"{colorStyleVar}{MarginStyle}{Parts.Styles?.Event}")"
     title="@BitFullCalendarHelpers.BuildEventTooltip(Event, State.Use24HourFormat, State.Culture, Texts.AllDayLabel)"
     data-bit-bfc-event="@Event.Id"
     data-bit-bfc-move="@(IsLead && canDrag ? "x" : null)"
     role="@(IsLead ? "button" : null)"
     tabindex="@(IsLead ? "0" : null)"
     aria-label="@(IsLead && templated is false ? badgeAriaLabel : null)"
     aria-labelledby="@(IsLead && templated ? $"{_templateId} {_detailsId}" : null)"
     aria-hidden="@(IsLead ? null : "true")"
     draggable="@(canDrag ? "true" : "false")"
     @ondragstart="OnDragStart"
     @ondragend="OnDragEnd"
     @onclick="() => OnSelected.InvokeAsync(Event)"
     @onkeydown="OnKeyDown"
     @onclick:stopPropagation="true"
     @onkeydown:stopPropagation="true">

    @if (EventTemplate != null)
    {
        @* The wrapper lays nothing out (display: contents), so the template's boxes are the badge's as before. The
           details are hidden, and still read where the name points at them. *@
        <span id="@_templateId" class="bit-bfc-event-tpl">@EventTemplate(Event)</span>
        @if (IsLead)
        {
            <span id="@_detailsId" hidden>@badgeAriaLabel</span>
        }
    }
    else
    {
        <div class="bit-bfc-event-badge-content">
            @if (isDotVariant && Position is not "middle" and not "last")
            {
                <BitFcEventBullet Color="@Event.Color" />
            }
            @if (showTitle)
            {
                <span class="bit-bfc-event-badge-title">@Event.Title</span>
            }
        </div>

        @* The title and the time are read as two words, not one run of text: Razor drops the whitespace between the
           two boxes, and the name the badge carries has a separator there. A whitespace-only run inside the flex
           badge draws nothing. *@
        @if (showTitle && (showTime || (Event.IsAllDay && Position is "last" or "none")))
        {
            @(" ")
        }
        @if (showTime)
        {
            <span class="bit-bfc-event-badge-time">@BitFullCalendarHelpers.FormatTime(Position == "last" ? displayEnd : Event.StartDate, State.Use24HourFormat, State.Culture)</span>
        }
        else if (Event.IsAllDay && Position is "last" or "none")
        {
            <span class="bit-bfc-event-badge-time">@Texts.AllDayLabel</span>
        }
    }
</div>
