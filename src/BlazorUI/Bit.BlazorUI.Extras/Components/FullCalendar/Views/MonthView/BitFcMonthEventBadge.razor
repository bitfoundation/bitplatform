@namespace Bit.BlazorUI

@{
    var positionClass = Position switch
    {
        "first" => "position-first",
        "middle" => "position-middle",
        "last" => "position-last",
        _ => ""
    };

    var isDotVariant = State.BadgeVariant == BitFullCalendarBadgeVariant.Dot;
    var colorClass = isDotVariant ? "dot-variant" : "bit-bfc-color";
    var colorStyleVar = ColorScheme.GetColorStyle(Event.Color);
    var showTitle = Position is "first" or "none";
    var showTime = Position is "last" or "none";
    var badgeAriaLabel = $"{Event.Title}, {BitFullCalendarHelpers.FormatTime(Event.StartDate, State.Use24HourFormat, State.Culture)} - {BitFullCalendarHelpers.FormatTime(Event.EndDate, State.Use24HourFormat, State.Culture)}";
}

<div class="bit-bfc-event-badge @colorClass @positionClass"
     style="@($"{colorStyleVar}{MarginStyle}")"
     role="button"
     tabindex="0"
     aria-label="@badgeAriaLabel"
     draggable="true"
     @ondragstart="OnDragStart"
     @ondragend="OnDragEnd"
     @onclick="() => OnSelected.InvokeAsync(Event)"
     @onkeydown="OnKeyDown"
     @onkeydown:preventDefault="true"
     @onclick:stopPropagation="true">

    @if (EventTemplate != null)
    {
        @EventTemplate(Event)
    }
    else
    {
        <div class="bit-bfc-event-badge-content">
            @if (isDotVariant && Position is not "middle" and not "last")
            {
                <BitFcEventBullet Color="Event.Color" />
            }
            @if (showTitle)
            {
                <span class="bit-bfc-event-badge-title">@Event.Title</span>
            }
        </div>

        @if (showTime)
        {
            <span class="bit-bfc-event-badge-time">@BitFullCalendarHelpers.FormatTime(Position == "last" ? Event.EndDate : Event.StartDate, State.Use24HourFormat, State.Culture)</span>
        }
    }
</div>
