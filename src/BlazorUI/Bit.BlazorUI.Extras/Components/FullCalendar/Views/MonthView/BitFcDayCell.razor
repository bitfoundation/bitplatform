@namespace Bit.BlazorUI

@{
    var isToday = Cell.Date.Date == DateTime.Today;
    var maxSlots = State.MaxEventsPerDayCell;
    var cellEvents = BitFullCalendarHelpers.GetMonthCellEvents(Cell.Date, Events, EventPositions, maxSlots);
    // A date the calendar is not allowed to navigate to is shown for context but never accepts a
    // click, a drop, or the add affordance.
    var isOutOfRange = State.IsDateInAllowedRange(Cell.Date) is false;
    // A day the grid only borrows from a neighbouring month can be left blank altogether, which is
    // what showNonCurrentDates turns off elsewhere. The cell still holds its column open.
    var isBlank = Cell.CurrentMonth is false && State.ShowNonCurrentDates is false;
    var isOffDay = State.HighlightBusinessHours && State.IsBusinessDay(Cell.Date.DayOfWeek) is false;
}

@if (isBlank)
{
    <div class="bit-bfc-month-cell other-month bit-bfc-month-cell-blank @(IsLastColumn ? "bit-bfc-month-cell-last-col" : "")" aria-hidden="true"></div>
}
else
{
<div class="bit-bfc-month-cell @(!Cell.CurrentMonth ? "other-month" : "") @(isOutOfRange ? "bit-bfc-out-of-range" : "") @(isOffDay ? "bit-bfc-day-off" : "") @(IsLastColumn ? "bit-bfc-month-cell-last-col" : "") bit-bfc-droppable"
     @ondragover="OnDragOver"
     @ondragover:preventDefault="true"
     @ondrop="OnDrop"
     @onclick="() => OnCellClick()">

    @* With nav links on, the day number opens that single day - the affordance every calendar puts
       there - and stays a plain label otherwise. *@
    @if (State.NavLinks && isOutOfRange is false)
    {
        <button type="button" class="bit-bfc-month-cell-day bit-bfc-navlink @(isToday ? "today" : "")"
                aria-label="@string.Format(State.Culture, Texts.NavLinkDayAriaLabelFormat, Cell.Date.ToString("D", State.Culture))"
                @onclick="GoToDayView"
                @onclick:stopPropagation="true">@Cell.Day</button>
    }
    else
    {
        <div class="bit-bfc-month-cell-day @(isToday ? "today" : "")">@Cell.Day</div>
    }
    @if (!State.ReadOnly && !isOutOfRange)
    {
        @* Roving tabindex: only one cell of the month grid is in the tab order at a time, and the
           arrow keys move both it and the focus. Enter and Space are left to the button itself. *@
        <button type="button" class="bit-bfc-cell-add-hint bit-bfc-cell-add-hint-month"
                id="@AddButtonId"
                tabindex="@(IsRovingCell ? "0" : "-1")"
                aria-label="@($"{Texts.AddEventHoverHint}, {Cell.Date.ToString("d", State.Culture)}")"
                @onclick="() => OnCellClick()"
                @onkeydown="args => OnCellKeyDown.InvokeAsync((Cell.Date, args))"
                @onclick:stopPropagation="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            @Texts.AddEventHoverHint
        </button>
    }

    <div class="bit-bfc-month-events">
        @for (int i = 0; i < maxSlots; i++)
        {
            var pos = i;
            var item = cellEvents.FirstOrDefault(e => e.Position == pos);
            @if (item.Event != null)
            {
                var position = GetBadgePosition(item.Event, Cell.Date);
                <div class="bit-bfc-month-event-slot">
                    <BitFcMonthEventBadge Event="item.Event" CellDate="Cell.Date" Position="@position" OnSelected="ShowEventDetails" EventTemplate="EventTemplate" />
                </div>
            }
            else
            {
                <div class="bit-bfc-month-event-slot"></div>
            }
        }
    </div>

    @{
        var moreCount = cellEvents.Count - maxSlots;
    }
    @* The overflow affordance is offered wherever events were actually hidden - a leading or
       trailing cell from a neighbouring month hides them just the same. *@
    @if (moreCount > 0)
    {
        <button type="button" class="bit-bfc-month-more"
                aria-label="@($"{string.Format(State.Culture, Texts.MoreEventsFormat, moreCount)}, {Cell.Date.ToString("D", State.Culture)}")"
                @onclick="() => _showEventList = true" @onclick:stopPropagation="true">
            @string.Format(State.Culture, Texts.MoreEventsFormat, moreCount)
        </button>
    }
</div>
}

@if (_showEventList)
{
    <BitFcEventListDialog Date="Cell.Date" Events="cellEvents.Select(e => e.Event).ToList()" OnClose="() => _showEventList = false" />
}

@if (_showAddDialog)
{
    <BitFcAddEditEventDialog StartDate="_addDraftStart" StartHour="_addDraftStart.Hour" StartMinute="_addDraftStart.Minute" OnClose="() => _showAddDialog = false" />
}

@if (_selectedEvent != null)
{
    <BitFcEventDetailsDialog Event="_selectedEvent" OnClose="CloseEventDetails" />
}
