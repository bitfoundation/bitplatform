@namespace Bit.BlazorUI

<div draggable="true"
     class="@(_isDragged ? "bit-bfc-dragging" : "") @Class"
     role="button"
     tabindex="0"
     @ondragstart="OnDragStart"
     @ondragend="OnDragEnd"
     @onclick="OnClick"
     @onkeydown="OnKeyDown"
     @onkeydown:preventDefault="_preventKeyDefault"
     @onclick:stopPropagation="true">
    @ChildContent
</div>
