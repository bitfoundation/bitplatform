@namespace Bit.BlazorUI

@if (_config is not null && _config.FirstPaintStrategy is not BitAccentColorFirstPaintStrategy.None)
{
    @((MarkupString)BitAccentColorSsr.BuildInlineHeadScript(Nonce, _config.Persistence))
    @if (_config.FirstPaintStrategy is BitAccentColorFirstPaintStrategy.StaticCss)
    {
        if (StylesheetHref.HasValue())
        {
            <link rel="stylesheet" href="@GetVersionedStylesheetHref()" />
        }
        else
        {
            <style nonce="@Nonce">@((MarkupString)BitAccentColorSsr.BuildStaticCss(_config.Accents))</style>
        }
    }
    else if (_prerenderCss is not null)
    {
        <style id="@BitAccentColorNames.StyleElementId" nonce="@Nonce">@((MarkupString)_prerenderCss)</style>
    }
}
