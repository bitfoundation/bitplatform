@namespace Bit.BlazorUI
@inherits BitComponentBase

<div @ref="RootElement"
     @attributes="DisabledAwareHtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()"
     role="group"
     aria-label="@(ResolveAriaLabel() ?? "Accent color")">
    @{
        var activeToken = BitAccentColorSsr.NormalizeToken(_accentColorService.ActiveAccent);
        @* With a CSS first-paint strategy the swatches carry their token for the marker CSS
           BitAccentColorHead emits, which rings the one the bit-accent root attribute names - set
           before anything is painted, so prerendered and cached markup rings the visitor's accent
           instead of ringing the default until hydration. Until then the C# accent state is the
           prerender's, i.e. possibly some other visitor's, so the class marking stays off; it takes
           over once this instance is interactive and the real accent has been restored. The hand-off
           is whole: the tokens come off with it, so the marker CSS - whose selectors outrank a single
           class - stops matching and cannot paint over Classes.ActiveSwatch / Styles.ActiveSwatch. *@
        var cssMarked = _config?.FirstPaintStrategy is not (null or BitAccentColorFirstPaintStrategy.None);
        var classMarked = cssMarked is false || _hydrated;
        var tokenMarked = cssMarked && classMarked is false;
    }
    @foreach (var item in _config?.Accents ?? DefaultAccents)
    {
        var token = BitAccentColorSsr.NormalizeToken(item.Color);
        var isActive = token == activeToken;

        <button @onclick="() => HandleOnClickAsync(item)"
                type="button"
                title="@item.Name"
                disabled="@(Disabled)"
                bit-accent-swatch="@(tokenMarked ? token : null)"
                class="@GetSwatchClass(isActive, classMarked)"
                style="@GetSwatchStyle(item, isActive, classMarked)"
                aria-pressed="@(isActive ? "true" : "false")"
                aria-label="@GetSwatchAriaLabel(item)"></button>
    }
</div>
