<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />
    <Import Project="../Bit.BlazorUI.PackageValidation.props" />
    <Import Project="../Bit.BlazorUI.TrimAnalysis.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <!-- See the note in Bit.BlazorUI.csproj: Debug builds only the TFM the demo and tests run on. -->
        <TargetFrameworks Condition=" '$(Configuration)' == 'Debug' And '$(BuildAllTfms)' != 'true' ">net10.0</TargetFrameworks>
        <IsTrimmable>true</IsTrimmable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="compilerconfig.json" />
        <None Include="compilerconfig.json" />
        <!-- dotnet watch: watch the ts sources so edits trigger the tsc target on rebuilds.
             The generated wwwroot css/js stay watched (default Content behavior) so dotnet watch can
             hot-apply them when the demo server's ScssCompilerService regenerates them. Scss sources are
             intentionally not watched here: the in-app compiler recompiles them without a rebuild. Paths
             are rooted with $(MSBuildProjectDirectory) because dotnet watch resolves relative Watch items
             of referenced projects against the startup project's directory. -->
        <Watch Include="$(MSBuildProjectDirectory)\**\*.ts" Exclude="$(MSBuildProjectDirectory)\node_modules\**;$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\**\*.d.ts" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.BlazorUI\Bit.BlazorUI.csproj" />
        <ProjectReference Include="..\Bit.BlazorUI.SourceGenerators\Bit.BlazorUI.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="tsconfig.json" />
        <None Include="tsconfig.json" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.AspNetCore.Components" />
        <Using Include="Microsoft.AspNetCore.Components.Web" />
        <Using Include="Microsoft.AspNetCore.Components.Rendering" />
        <Using Include="Microsoft.AspNetCore.Components.Web.Virtualization" />
        <Using Include="Microsoft.JSInterop" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="**\*.ts" />
        <ScssFiles Include="**\*.scss" />
    </ItemGroup>

    <!-- What the core package's publish-time trimming reads of this one (see Bit.BlazorUI's
         buildTransitive\Bit.BlazorUI.targets): the targets naming this package's pieces, and the pieces themselves. -->
    <ItemGroup>
        <None Include="buildTransitive\Bit.BlazorUI.Extras.targets" Pack="true" PackagePath="buildTransitive\;build\" />
    </ItemGroup>

    <!-- How this package's pieces are written and packed, shared by the packages that have any. -->
    <Import Project="..\Bit.BlazorUI.Build\Bit.BlazorUI.Assets.targets" />

    <Target Name="BeforeBuildTasks" DependsOnTargets="InstallNodejsDependencies;BuildJavaScript;BuildCss" />

    <Target Name="IncludeGeneratedAssets" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="BeforeBuildTasksOnce" Condition=" '$(DesignTimeBuild)' != 'true' ">
        <ItemGroup>
            <Content Include="wwwroot\scripts\*.js;wwwroot\styles\*.css" Exclude="@(Content);@(None)" />
        </ItemGroup>
    </Target>

    <Target Name="BeforeBuildTasksOnce">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="BeforeBuildTasks" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
    </Target>

    <Target Name="BeforeBuildTasksOnCrossTargeting" BeforeTargets="DispatchToInnerBuilds" DependsOnTargets="BeforeBuildTasks" Condition=" '$(IsCrossTargetingBuild)' == 'true' AND '$(DesignTimeBuild)' != 'true' " />

    <!-- A CI build installs exactly what package-lock.json pins (npm ci), so the tools a package is built with are the
         ones reviewed; a local build keeps npm install, which also takes in a package.json edited by hand. -->
    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Condition=" '$(CI)' == 'true' " Command="npm ci" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Exec Condition=" '$(CI)' != 'true' " Command="npm install" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <!-- build-assets.mjs writes the bundle from one piece per .ts file and keeps the pieces in obj\bit-assets for the
         package (see Bit.BlazorUI's csproj). The stamp is per configuration, and a build takes every other configuration's
         stamp away, so switching from one configuration to another rebuilds the script either way even when no .ts file
         changed in between: a Release build after a Debug one minifies it, and a Debug build after a Release one writes it
         readable again. -->
    <Target Name="BuildJavaScript" Inputs="@(TypeScriptFiles);tsconfig.json;@(BitAssetsScript)" Outputs="wwwroot/scripts/bit.blazorui.extras.js;$(BaseIntermediateOutputPath)bit-assets\scripts.json;$(BaseIntermediateOutputPath)$(Configuration)\bit.blazorui.extras.js.stamp">
        <Exec Command="node &quot;@(BitAssetsScript->'%(FullPath)')&quot; scripts --package $(PackageId) --tsconfig tsconfig.json --bundle scripts/bit.blazorui.extras.js --out $(BaseIntermediateOutputPath)bit-assets $(_BitAssetsMinify)" StandardOutputImportance="high" StandardErrorImportance="high" />
        <ItemGroup>
            <_OtherConfigurationScriptStamps Include="$(BaseIntermediateOutputPath)*\bit.blazorui.extras.js.stamp" Exclude="$(BaseIntermediateOutputPath)$(Configuration)\bit.blazorui.extras.js.stamp" />
        </ItemGroup>
        <Delete Files="@(_OtherConfigurationScriptStamps)" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)$(Configuration)" />
        <Touch Files="$(BaseIntermediateOutputPath)$(Configuration)\bit.blazorui.extras.js.stamp" AlwaysCreate="true" />
    </Target>

    <!-- The component stylesheets compiled one by one into the bundle, which the publish-time trimming keeps a subset of;
         the presets are token-only overrides an app links whole. -->
    <Target Name="BuildCss" Inputs="@(ScssFiles);@(BitAssetsScript)" Outputs="wwwroot/styles/bit.blazorui.extras.css;wwwroot/styles/bit.blazorui.material.css;wwwroot/styles/bit.blazorui.cupertino.css;wwwroot/styles/bit.blazorui.fluent2.css;$(BaseIntermediateOutputPath)bit-assets\styles.json">
        <Exec Command="node &quot;@(BitAssetsScript->'%(FullPath)')&quot; styles --package $(PackageId) --components Styles/extra-components.scss --out $(BaseIntermediateOutputPath)bit-assets --bundle Styles/bit.blazorui.extras.scss=styles/bit.blazorui.extras.css --whole Styles/Material/bit.blazorui.material.scss=styles/bit.blazorui.material.css --whole Styles/Cupertino/bit.blazorui.cupertino.scss=styles/bit.blazorui.cupertino.css --whole Styles/Fluent2/bit.blazorui.fluent2.scss=styles/bit.blazorui.fluent2.css" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <ItemGroup>
        <Content Remove="package*.json" />
        <Content Remove="tsconfig.json" />
        <None Include="package*json" />
        <None Include="tsconfig.json" />
    </ItemGroup>

</Project>