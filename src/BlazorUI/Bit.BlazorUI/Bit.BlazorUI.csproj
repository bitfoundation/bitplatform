<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="../../Bit.Build.props" />
    <Import Project="../Bit.BlazorUI.PackageValidation.props" />
    <Import Project="../Bit.BlazorUI.TrimAnalysis.props" />

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <!-- The demo and the tests only run on the latest TFM, so compiling net9.0 and net8.0 on every Debug
             build triples the inner-loop work for output nothing consumes. Release (pack, CI) still builds
             all three; pass -p:BuildAllTfms=true to get them in Debug too. -->
        <TargetFrameworks Condition=" '$(Configuration)' == 'Debug' And '$(BuildAllTfms)' != 'true' ">net10.0</TargetFrameworks>
        <IsTrimmable>true</IsTrimmable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <!-- Hand-written copies of ReleaseVersion, verified against it on build (see Bit.Build.props). -->
    <ItemGroup>
        <ReleaseVersionLiteral Include="Info.cs;Scripts\general.ts" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bit.BlazorUI.Extras, " />
        <InternalsVisibleTo Include="Bit.BlazorUI.Extras, " />
        <InternalsVisibleTo Include="Bit.BlazorUI.Legacy, " />
        <InternalsVisibleTo Include="Bit.BlazorUI.Legacy, " />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
        <PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
        <PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="compilerconfig.json" />
        <None Include="compilerconfig.json" />
        <!-- dotnet watch: watch the ts sources so edits trigger the tsc target on rebuilds.
             The generated wwwroot css/js stay watched (default Content behavior) so dotnet watch can
             hot-apply them when the demo server's ScssCompilerService regenerates them. Scss sources are
             intentionally not watched here: the in-app compiler recompiles them without a rebuild. Paths
             are rooted with $(MSBuildProjectDirectory) because dotnet watch resolves relative Watch items
             of referenced projects against the startup project's directory. -->
        <Watch Include="$(MSBuildProjectDirectory)\**\*.ts" Exclude="$(MSBuildProjectDirectory)\node_modules\**;$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\**\*.d.ts" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.BlazorUI.SourceGenerators\Bit.BlazorUI.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="tsconfig.json" />
        <None Include="tsconfig.json" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.AspNetCore.Components" />
        <Using Include="Microsoft.AspNetCore.Components.Web" />
        <Using Include="Microsoft.AspNetCore.Components.Rendering" />
        <Using Include="Microsoft.AspNetCore.Components.Web.Virtualization" />
        <Using Include="Microsoft.JSInterop" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="**\*.ts" />
        <ScssFiles Include="**\*.scss" />
        <BitAssetsScript Include="..\Bit.BlazorUI.Build\build-assets.mjs" />
    </ItemGroup>

    <!-- The publish-time trimming of the scripts and stylesheets an app gets: the MSBuild task (packed under tasks\, see
         IncludeBitBlazorUIAssetsInPackage) and the consumer-side targets that run it. Built, not referenced: nothing in
         this library calls into it. -->
    <ItemGroup>
        <ProjectReference Include="..\Bit.BlazorUI.Build\Bit.BlazorUI.Build.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="buildTransitive\Bit.BlazorUI.targets;buildTransitive\Bit.BlazorUI.Endpoints.targets" Pack="true" PackagePath="buildTransitive\;build\" />
    </ItemGroup>

    <!-- No source map is written (build-assets.mjs deletes one an older build left beside a bundle), so none is content,
         even while an older one is still on disk as the project is evaluated. -->
    <ItemGroup>
        <Content Remove="wwwroot\styles\*.map;wwwroot\scripts\*.map" />
    </ItemGroup>

    <Target Name="BeforeBuildTasks" DependsOnTargets="InstallNodejsDependencies;BuildJavaScript;BuildCss" />

    <Target Name="IncludeGeneratedAssets" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="BeforeBuildTasksOnce" Condition=" '$(DesignTimeBuild)' != 'true' ">
        <ItemGroup>
            <Content Include="wwwroot\scripts\*.js;wwwroot\styles\*.css" Exclude="@(Content);@(None)" />
        </ItemGroup>
    </Target>

    <!-- What the package carries besides the library and its static web assets:
           buildTransitive\*.targets (+ build\)    the consumer-side trimming (see buildTransitive\Bit.BlazorUI.targets)
           buildTransitive\bit-assets\**           the pieces the bundles are made of, and their manifests
           tasks\Bit.BlazorUI.Build.dll            the MSBuild task that puts a trimmed bundle together
         Added from a target because the pieces are generated by the build. Once, from the first target framework, so a
         multi-targeted pack does not add them three times. -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeBitBlazorUIAssetsInPackage</TargetsForTfmSpecificContentInPackage>
        <!-- The first target framework, outside the condition that reads it: a semicolon is not allowed in one. -->
        <_BitBlazorUIPackedTfm>$(TargetFrameworks.Split(';')[0])</_BitBlazorUIPackedTfm>
    </PropertyGroup>

    <Target Name="IncludeBitBlazorUIAssetsInPackage" Condition="'$(TargetFramework)' == '$(_BitBlazorUIPackedTfm)'">
        <MSBuild Projects="..\Bit.BlazorUI.Build\Bit.BlazorUI.Build.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier">
            <Output TaskParameter="TargetOutputs" ItemName="_BitBlazorUIBuildTaskAssembly" />
        </MSBuild>
        <ItemGroup>
            <_BitBlazorUIAssetPiece Include="$(BaseIntermediateOutputPath)bit-assets\**\*" />
            <TfmSpecificPackageFile Include="@(_BitBlazorUIAssetPiece)" PackagePath="buildTransitive\bit-assets\%(RecursiveDir)%(Filename)%(Extension)" />
            <TfmSpecificPackageFile Include="@(_BitBlazorUIBuildTaskAssembly)" PackagePath="tasks\%(Filename)%(Extension)" />
        </ItemGroup>
    </Target>

    <Target Name="BeforeBuildTasksOnce">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="BeforeBuildTasks" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
    </Target>

    <Target Name="BeforeBuildTasksOnCrossTargeting" BeforeTargets="DispatchToInnerBuilds" DependsOnTargets="BeforeBuildTasks" Condition=" '$(IsCrossTargetingBuild)' == 'true' AND '$(DesignTimeBuild)' != 'true' " />

    <!-- A CI build installs exactly what package-lock.json pins (npm ci), so the tools a package is built with are the
         ones reviewed; a local build keeps npm install, which also takes in a package.json edited by hand. -->
    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Condition=" '$(CI)' == 'true' " Command="npm ci" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Exec Condition=" '$(CI)' != 'true' " Command="npm install" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <!-- build-assets.mjs compiles every .ts file on its own and writes bit.blazorui.js from the pieces, keeping the
         pieces and a manifest of what each needs in obj\bit-assets for the package (see the script for the shape of
         both). The stamp is per configuration, and a build takes every other configuration's stamp away, so switching
         from one configuration to another rebuilds the script either way even when no .ts file changed in between: a
         Release build after a Debug one minifies it, and a Debug build after a Release one writes it readable again. -->
    <Target Name="BuildJavaScript" Inputs="@(TypeScriptFiles);tsconfig.json;@(BitAssetsScript)" Outputs="wwwroot\scripts\bit.blazorui.js;$(BaseIntermediateOutputPath)bit-assets\scripts.json;$(BaseIntermediateOutputPath)$(Configuration)\bit.blazorui.js.stamp">
        <Exec Command="node &quot;@(BitAssetsScript->'%(FullPath)')&quot; scripts --package $(PackageId) --tsconfig tsconfig.json --bundle scripts/bit.blazorui.js --out $(BaseIntermediateOutputPath)bit-assets $(_BitAssetsMinify)" StandardOutputImportance="high" StandardErrorImportance="high" />
        <ItemGroup>
            <_OtherConfigurationScriptStamps Include="$(BaseIntermediateOutputPath)*\bit.blazorui.js.stamp" Exclude="$(BaseIntermediateOutputPath)$(Configuration)\bit.blazorui.js.stamp" />
        </ItemGroup>
        <Delete Files="@(_OtherConfigurationScriptStamps)" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)$(Configuration)" />
        <Touch Files="$(BaseIntermediateOutputPath)$(Configuration)\bit.blazorui.js.stamp" AlwaysCreate="true" />
    </Target>

    <PropertyGroup>
        <_BitAssetsMinify Condition=" '$(Configuration)' == 'Release' ">--minify</_BitAssetsMinify>
    </PropertyGroup>

    <!-- Each bundle compiles to exactly its own part, every component stylesheet compiled on its own, and its own part
         again - build-assets.mjs checks that before it writes anything - which is what lets a publish keep only the
         component stylesheets an app can use. functions.scss is the preamble a component may lean on without importing
         it, the way general.scss imports it ahead of components.scss. -->
    <Target Name="BuildCss" Inputs="@(ScssFiles);@(BitAssetsScript)" Outputs="wwwroot/styles/bit.blazorui.css;wwwroot/styles/bit.blazorui.fluent.css;wwwroot/styles/bit.blazorui.fluent-dark.css;wwwroot/styles/bit.blazorui.fluent-light.css;$(BaseIntermediateOutputPath)bit-assets\styles.json">
        <Exec Command="node &quot;@(BitAssetsScript->'%(FullPath)')&quot; styles --package $(PackageId) --components Styles/components.scss --preamble Styles/functions.scss --out $(BaseIntermediateOutputPath)bit-assets --bundle Styles/bit.blazorui.scss=styles/bit.blazorui.css --bundle Styles/Fluent/bit.blazorui.fluent.scss=styles/bit.blazorui.fluent.css --bundle Styles/Fluent/bit.blazorui.fluent-dark.scss=styles/bit.blazorui.fluent-dark.css --bundle Styles/Fluent/bit.blazorui.fluent-light.scss=styles/bit.blazorui.fluent-light.css" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <ItemGroup>
        <Content Remove="package*.json" />
        <Content Remove="tsconfig.json" />
        <None Include="package*json" />
        <None Include="tsconfig.json" />
    </ItemGroup>

</Project>