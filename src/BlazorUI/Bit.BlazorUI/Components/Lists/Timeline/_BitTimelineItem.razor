@namespace Bit.BlazorUI
@typeparam TItem where TItem : class

@{
    var icon = Timeline.GetIcon(Item);
    var hideDot = Timeline.GetHideDot(Item);
    var iconName = Timeline.GetIconName(Item);
    var primaryText = Timeline.GetPrimaryText(Item);
    var secondaryText = Timeline.GetSecondaryText(Item);
    var primaryContent = Timeline.GetPrimaryContent(Item);
    var secondaryContent = Timeline.GetSecondaryContent(Item);
    var isDisabled = Timeline.Disabled || Timeline.GetIsDisabled(Item);
    var isInteractive = Timeline.IsItemInteractive(Item);
    var template = Timeline.GetTemplate(Item) ?? Timeline.ItemTemplate;
    var dotTemplate = Timeline.GetDotTemplate(Item) ?? Timeline.DotTemplate;

    icon = BitIconInfo.From(icon, iconName);

    // Whatever holds the parts of the item (the item itself, or the button of a clickable one) is marked, so the
    // stylesheet can lay them out without asking the DOM what was rendered. A whole-item template brings its own layout.
    var partsClass = template is null ? " bit-tln-prt" : null;

    RenderFragment content =@<text>
        @if (template is not null)
        {
            @template(Item)
        }
        else
        {
            <div style="@Timeline.Styles?.PrimaryContent" class="bit-tln-pcn @Timeline.Classes?.PrimaryContent">
                @if (primaryContent is not null)
                {
                    @primaryContent(Item)
                }
                else if (primaryText.HasValue())
                {
                    <span style="@Timeline.Styles?.PrimaryText" class="bit-tln-ttx @Timeline.Classes?.PrimaryText">@primaryText</span>
                }
            </div>
            <div style="@Timeline.Styles?.Divider" class="bit-tln-dvd@(hideDot ? " bit-tln-dvh" : null) @Timeline.Classes?.Divider">
                @if (hideDot)
                {
                    @* The dot is what gives the divider its size, so an item without one reserves the space of
                       a dot instead of leaving the divider empty: the connecting line then keeps the axis it
                       has on every other item, rather than drifting toward the contents. *@
                    <div aria-hidden="true" class="bit-tln-hdd"></div>
                }
                else if (dotTemplate is not null)
                {
                    @dotTemplate(Item)
                }
                else
                {
                    @* The default dot and its icon are decoration: what the item says is in its contents. *@
                    <div aria-hidden="true" style="@Timeline.Styles?.Dot" class="bit-tln-dot @Timeline.Classes?.Dot">
                        @if (icon is not null)
                        {
                            <i style="@Timeline.Styles?.Icon" class="bit-tln-ico @icon.GetCssClasses() @Timeline.Classes?.Icon" />
                        }
                    </div>
                }
            </div>
            <div style="@Timeline.Styles?.SecondaryContent" class="bit-tln-scn @Timeline.Classes?.SecondaryContent">
                @if (secondaryContent is not null)
                {
                    @secondaryContent(Item)
                }
                else if (secondaryText.HasValue())
                {
                    <span style="@Timeline.Styles?.SecondaryText" class="bit-tln-ttx @Timeline.Classes?.SecondaryText">@secondaryText</span>
                }
            </div>
        }
    </text>;
}

@* The item itself always stays a list item, so the timeline remains a valid list for assistive
   technologies. A nested button is only rendered while something listens to the item's click, so a
   presentational timeline exposes no controls and stays out of the keyboard tab order. The disabled
   state is announced once: by that button when there is one, and otherwise by the item itself, which is
   then all there is to carry it. *@
<li aria-disabled="@(isInteractive is false && isDisabled ? "true" : null)"
    aria-label="@(isInteractive ? null : Timeline.GetAriaLabel(Item))"
    title="@Timeline.GetTitle(Item)"
    style="@Timeline.GetItemStyles(Item)"
    class="bit-tln-itm@(Timeline.GetItemClasses(Item, isInteractive) + (isInteractive ? null : partsClass)) @Timeline.Classes?.Item">
    @if (isInteractive)
    {
        @* Its keyboard activation is registered in the browser (see OnAfterRenderAsync). *@
        <div @ref="_buttonElement"
             @onclick="() => Timeline.HandleOnItemClick(Item)"
             role="button"
             tabindex="@(isDisabled ? null : "0")"
             aria-disabled="@(isDisabled ? "true" : null)"
             aria-label="@Timeline.GetAriaLabel(Item)"
             class="bit-tln-btn@(partsClass)">
            @content
        </div>
    }
    else
    {
        @content
    }
</li>
