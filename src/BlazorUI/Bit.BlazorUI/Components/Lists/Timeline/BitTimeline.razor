@namespace Bit.BlazorUI
@inherits BitComponentBase
@typeparam TItem

@* A timeline is a sequence, so it is an ordered list. The explicit list role is kept on purpose: WebKit drops
   the list semantics of a list whose markers are hidden (list-style: none) unless the role is spelled out.
   The disabled state is carried by the items that can actually be operated, not by the list, which is not an
   element aria-disabled applies to. *@
<ol @ref="RootElement" @attributes="HtmlAttributes"
    id="@_Id"
    role="list"
    style="@StyleBuilder.Value"
    class="@ClassBuilder.Value"
    aria-label="@AriaLabel"
    dir="@Dir?.ToString().ToLower()">
    @if (Options is not null || ChildContent is not null)
    {
        <CascadingValue Value="this" IsFixed="true">
            @(Options ?? ChildContent)
        </CascadingValue>
    }
    else
    {
        @for (int i = 0; i < _items.Count; i++)
        {
            var item = _items[i];
            <_BitTimelineItem Timeline="this" Item="item" @key="@GetItemKey(item, i.ToString())" />
        }
    }
</ol>
