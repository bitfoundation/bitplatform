@namespace Bit.BlazorUI
@inherits BitComponentBase

@{
    LayOutBeforeFirstRender();

    // The region role and its "carousel" description are the pattern's own and stay after the splatted attributes, as
    // does the tab index, which NoKeyboard and Disabled take off the root on purpose.
    var ariaLabel = ResolveAriaLabel();
}

<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     role="region"
     aria-roledescription="carousel"
     aria-label="@ariaLabel"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()"
     tabindex="@((NoKeyboard || Disabled) ? null : (TabIndex ?? "0"))"
     @onfocusin="HandleFocusIn"
     @onfocusout="HandleFocusOut"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave">

    @* The controls are rendered before the slides so the play/pause button is the first thing the keyboard
       reaches, which is what the carousel pattern of the ARIA authoring practices asks of a carousel that
       moves on its own: the motion can be stopped before anything else is dealt with. The stylesheet puts
       the row back below the slides, so nothing about the way the carousel looks changes with it. *@
    @if ((HideDots is false && _pagesCount > 1) || (AutoPlay && ShowPlayPause))
    {
        <div class="bit-csl-dcn @Classes?.DotsContainer"
             style="@JoinStyles(_directionStyle, Styles?.DotsContainer)">
            @if (AutoPlay && ShowPlayPause)
            {
                var playPauseIcon = IsPaused
                                    ? BitIconInfo.From(PlayIcon, PlayIconName ?? "Play")
                                    : BitIconInfo.From(PauseIcon, PauseIconName ?? "Pause");
                <button @onclick="TogglePlay"
                        type="button"
                        aria-controls="@_ContainerId"
                        aria-label="@(IsPaused ? PlayButtonAriaLabel : PauseButtonAriaLabel)"
                        disabled="@(Disabled)"
                        aria-disabled="@(Disabled ? "true" : null)"
                        class="bit-csl-ppb @Classes?.PlayPauseButton"
                        style="@Styles?.PlayPauseButton">
                    <i aria-hidden="true"
                       style="@Styles?.PlayPauseButtonIcon"
                       class="@playPauseIcon?.GetCssClasses() @Classes?.PlayPauseButtonIcon" />
                </button>
            }
            @if (HideDots is false && _pagesCount > 1)
            {
                @* The group holds the dots alone (not the play/pause button), so its accessible label
                   describes exactly what it contains. *@
                <div role="group" aria-label="@DotsAriaLabel" class="bit-csl-dts">
                    @for (int i = 0; i < _pagesCount; i++)
                    {
                        int index = i;
                        <button @ref="_dotRefs[index]"
                                @onclick="(() => HandleGotoPage(index))"
                                data-bit-key-origin="@KeyOriginDot"
                                type="button"
                                tabindex="@GetDotTabIndex(index)"
                                aria-controls="@_ContainerId"
                                aria-label="@($"{DotAriaLabel} {index + 1}")"
                                aria-current="@(_currentPage == index ? "true" : null)"
                                disabled="@(Disabled)"
                                aria-disabled="@(Disabled ? "true" : null)"
                                style="@JoinStyles(Styles?.Dots, _currentPage == index ? Styles?.CurrentDot : null)"
                                class="bit-csl-dot @(DotTemplate is null ? null : "bit-csl-dtt") @((_currentPage == index ? $"bit-csl-cud {Classes?.CurrentDot}" : "").Trim()) @Classes?.Dots">@DotTemplate?.Invoke(index)</button>
                    }
                </div>
            }
        </div>
    }

    @* The wheel is kept to the carousel by the listener RegisterPreventDefaultsAsync registers, not by
       Blazor's preventDefault directive here: the directive goes through a listener the browser treats
       as passive before net10.0, and it cannot tell the axis the carousel navigates on from the one it
       leaves to the page. *@
    <div @ref="_carouselContainer"
         id="@_ContainerId"
         @onwheel="HandleWheel"
         @onpointerup="HandlePointerUp"
         @onpointerleave="HandlePointerUp"
         @onpointercancel="HandlePointerUp"
         @onpointermove="HandlePointerMove"
         @onpointerdown="HandlePointerDown"
         aria-atomic="false"
         aria-live="@(IsPlaying ? "off" : "polite")"
         class="bit-csl-cnt @((NoDrag || Disabled) ? "bit-csl-ndr" : null) @Classes?.Container"
         style="@JoinStyles(_directionStyle, Styles?.Container)">

        @* The buttons come before the slides (the carousel pattern of the ARIA authoring practices puts
           the controls before the content they control), and the stylesheet places them over the slides.
           The previous button comes first, since it sits at the start of the reading order in either
           direction, so the focus does not run backwards across the carousel. Each button keeps its class
           (bit-csl-pbt, bit-csl-nbt) and what a page gives it (its label, its icon, its parts) in either
           direction, and the stylesheet places it off the direction class of the root (bit-csl-rtl): the next
           button sits at the right edge of a left-to-right carousel, at the left edge of a right-to-left one
           and at the bottom of a vertical one. *@
        @if (HideNextPrev is false)
        {
            var nextIcon = BitIconInfo.From(NextIcon, NextIconName ?? GetDefaultNextIconName());
            var prevIcon = BitIconInfo.From(PrevIcon, PrevIconName ?? GetDefaultPrevIconName());

            // The styles of a part are joined with JoinStyles, which puts the semicolon between two of them: the
            // display:none of a button at the end it cannot pass would otherwise run into a style the page gives
            // the buttons and be dropped by the browser along with it, leaving the button on screen.
            <button @ref="_prevButtonRef"
                    @onclick="HandlePrevButtonClick"
                    data-bit-key-origin="@KeyOriginPrev"
                    type="button"
                    aria-controls="@_ContainerId"
                    aria-label="@(PrevAriaLabel.HasValue() ? PrevAriaLabel : "Previous slide")"
                    disabled="@(Disabled)"
                    aria-disabled="@(Disabled ? "true" : null)"
                    class="bit-csl-pbt @Classes?.Buttons @Classes?.PrevButton"
                    style="@JoinStyles(JoinStyles(_prevButtonStyle, Styles?.Buttons), Styles?.PrevButton)">
                <i aria-hidden="true"
                   style="@JoinStyles(Styles?.ButtonIcons, Styles?.PrevButtonIcon)"
                   class="@prevIcon?.GetCssClasses() @GetCustomIconMirrorClass(PrevIcon, PrevIconName) @Classes?.ButtonIcons @Classes?.PrevButtonIcon" />
            </button>

            <button @ref="_nextButtonRef"
                    @onclick="HandleNextButtonClick"
                    data-bit-key-origin="@KeyOriginNext"
                    type="button"
                    aria-controls="@_ContainerId"
                    aria-label="@(NextAriaLabel.HasValue() ? NextAriaLabel : "Next slide")"
                    disabled="@(Disabled)"
                    aria-disabled="@(Disabled ? "true" : null)"
                    class="bit-csl-nbt @Classes?.Buttons @Classes?.NextButton"
                    style="@JoinStyles(JoinStyles(_nextButtonStyle, Styles?.Buttons), Styles?.NextButton)">
                <i aria-hidden="true"
                   style="@JoinStyles(Styles?.ButtonIcons, Styles?.NextButtonIcon)"
                   class="@nextIcon?.GetCssClasses() @GetCustomIconMirrorClass(NextIcon, NextIconName) @Classes?.ButtonIcons @Classes?.NextButtonIcon" />
            </button>
        }

        <CascadingValue Value="this" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
</div>
