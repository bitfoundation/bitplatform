@namespace Bit.BlazorUI
@inherits BitComponentBase

<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     role="region"
     aria-roledescription="carousel"
     aria-label="@AriaLabel"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()"
     tabindex="@((NoKeyboard || IsEnabled is false) ? null : (TabIndex ?? "0"))"
     @onkeydown="HandleKeyDown"
     @onfocusin="HandleFocusIn"
     @onfocusout="HandleFocusOut"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave">

    @* The controls are rendered before the items so the play/pause button is the first thing the keyboard
       reaches, which is what the carousel pattern of the ARIA authoring practices asks of anything that
       moves on its own: the motion can be stopped before anything else is dealt with. The stylesheet puts
       the row back below the items, so nothing about the way the swiper looks changes with it. *@
    @if ((ShowDots && _pagesCount > 1) || (AutoPlay && ShowPlayPause))
    {
        <div class="bit-swp-dcn @Classes?.DotsContainer"
             style="@_directionStyle @Styles?.DotsContainer">
            @if (AutoPlay && ShowPlayPause)
            {
                var playPauseIcon = IsPaused
                                    ? BitIconInfo.From(PlayIcon, PlayIconName ?? "Play")
                                    : BitIconInfo.From(PauseIcon, PauseIconName ?? "Pause");
                <button @onclick="TogglePlay"
                        type="button"
                        aria-controls="@_ContainerId"
                        aria-label="@(IsPaused ? PlayButtonAriaLabel : PauseButtonAriaLabel)"
                        disabled="@(IsEnabled is false)"
                        class="bit-swp-ppb @Classes?.PlayPauseButton"
                        style="@Styles?.PlayPauseButton">
                    <i aria-hidden="true"
                       style="@Styles?.PlayPauseButtonIcon"
                       class="@playPauseIcon?.GetCssClasses() @Classes?.PlayPauseButtonIcon" />
                </button>
            }
            @if (ShowDots && _pagesCount > 1)
            {
                @* The group holds the dots alone (not the play/pause button), so its accessible label
                   describes exactly what it contains. *@
                <div role="group" aria-label="@DotsAriaLabel" class="bit-swp-dts">
                    @for (int i = 0; i < _pagesCount; i++)
                    {
                        int index = i;
                        <button @onclick="() => HandleGoToPage(index)"
                                type="button"
                                aria-controls="@_ContainerId"
                                aria-label="@($"{DotAriaLabel} {index + 1}")"
                                aria-current="@(_page == index ? "true" : null)"
                                disabled="@(IsEnabled is false)"
                                style="@Styles?.Dots @(_page == index ? Styles?.CurrentDot : null)"
                                class="bit-swp-dot @(DotTemplate is null ? null : "bit-swp-dtt") @((_page == index ? $"bit-swp-cud {Classes?.CurrentDot}" : "").Trim()) @Classes?.Dots">@DotTemplate?.Invoke(index)</button>
                    }
                </div>
            }
        </div>
    }

    @* The buttons sit next to the scrolling box rather than inside it, so they stay in place while the
       items travel under them. *@
    <div class="bit-swp-vwp">
        @if (HideNextPrev is false)
        {
            var nextIcon = BitIconInfo.From(NextIcon, NextIconName ?? GetDefaultNextIconName());
            var prevIcon = BitIconInfo.From(PrevIcon, PrevIconName ?? GetDefaultPrevIconName());

            <button @onclick="HandleGoNext"
                    type="button"
                    aria-controls="@_ContainerId"
                    aria-label="@(NextAriaLabel.HasValue() ? NextAriaLabel : "Next slide")"
                    disabled="@(IsEnabled is false)"
                    class="bit-swp-rbt @Classes?.Buttons @Classes?.NextButton"
                    style="@_nextButtonStyle @Styles?.Buttons @Styles?.NextButton">
                <i aria-hidden="true"
                   style="@Styles?.ButtonIcons @Styles?.NextButtonIcon"
                   class="@nextIcon?.GetCssClasses() @Classes?.ButtonIcons @Classes?.NextButtonIcon" />
            </button>

            <button @onclick="HandleGoPrev"
                    type="button"
                    aria-controls="@_ContainerId"
                    aria-label="@(PrevAriaLabel.HasValue() ? PrevAriaLabel : "Previous slide")"
                    disabled="@(IsEnabled is false)"
                    class="bit-swp-lbt @Classes?.Buttons @Classes?.PrevButton"
                    style="@_prevButtonStyle @Styles?.Buttons @Styles?.PrevButton">
                <i aria-hidden="true"
                   style="@Styles?.ButtonIcons @Styles?.PrevButtonIcon"
                   class="@prevIcon?.GetCssClasses() @Classes?.ButtonIcons @Classes?.PrevButtonIcon" />
            </button>
        }

        <div @ref="_swiperContainer"
             id="@_ContainerId"
             class="bit-swp-cnt @Classes?.Container"
             style="@_directionStyle @Styles?.Container">
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </div>
    </div>
</div>
