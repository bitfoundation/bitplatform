@namespace Bit.BlazorUI

@if (Href.HasValue())
{
    <a @ref="Element"
       @onclick="OnClick"
       @onfocusin="OnFocusIn"
       @onkeydown="OnKeyDown"
       rel="@Rel"
       href="@Href"
       title="@Title"
       class="@Class"
       style="@Style"
       target="@Target"
       tabindex="@TabIndex"
       aria-label="@AriaLabel"
       aria-current="@AriaCurrent"
       aria-disabled="@(Disabled ? "true" : null)">
        @ChildContent
    </a>
}
else
{
    <button @ref="Element"
            @onclick="OnClick"
            @onfocusin="OnFocusIn"
            @onkeydown="OnKeyDown"
            type="button"
            title="@Title"
            class="@Class"
            style="@Style"
            disabled="@Disabled"
            tabindex="@TabIndex"
            aria-label="@AriaLabel"
            aria-current="@AriaCurrent"
            aria-disabled="@(Disabled ? "true" : null)">
        @ChildContent
    </button>
}
