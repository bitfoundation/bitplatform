@namespace Bit.BlazorUI
@inherits BitComponentBase

<div @ref="RootElement" @attributes="HtmlAttributes"
     @onmouseenter="HandleOnMouseEnter"
     @onmouseleave="HandleOnMouseLeave"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">
    <button @ref="_buttonRef"
            @onclick="HandleOnClick"
            @onkeydown="HandleOnButtonKeyDown"
            type="button"
            id="@_buttonId"
            title="@Title"
            tabindex="@TabIndex"
            aria-label="@AriaLabel"
            aria-haspopup="@(TrapFocus ? "dialog" : "true")"
            aria-controls="@_calloutId"
            aria-hidden="@(AriaHidden ? "true" : null)"
            style="@Styles?.Button"
            aria-describedby="@AriaDescription"
            aria-busy="@(IsLoading ? "true" : null)"
            disabled="@(IsEnabled is false || IsLoading)"
            aria-expanded="@(IsOpen ? "true" : "false")"
            class="bit-drm-btn @Classes?.Button">
        @if (Template is not null)
        {
            @Template
        }
        else
        {
            @if (IsLoading)
            {
                <span style="@Styles?.Spinner" class="bit-drm-spn @Classes?.Spinner"></span>
            }
            else
            {
                var icon = BitIconInfo.From(Icon, IconName);

                if (icon is not null)
                {
                    <i aria-hidden="true" style="@Styles?.Icon" class="bit-drm-icn @icon.GetCssClasses() @Classes?.Icon" />
                }
            }

            @* A button only takes phrasing content, so the text and the spinner are spans; the flex
               container blockifies them anyway, so they lay out the same as the divs they replaced. *@
            @if (Text.HasValue())
            {
                <span style="@Styles?.Text" class="bit-drm-txt @Classes?.Text">
                    @Text
                </span>
            }

            @if (NoChevron is false)
            {
                var chevronIcon = BitIconInfo.From(ChevronDownIcon, ChevronDownIconName ?? "ChevronRight bit-ico-r90");

                <i aria-hidden="true"
                   style="@Styles?.ChevronDown"
                   class="bit-drm-chv @chevronIcon?.GetCssClasses() @Classes?.ChevronDown" />
            }
        }
    </button>
</div>

<div @onclick="CloseCallout" @onclick:stopPropagation
     style="display:@(IsOpen ? "block" : "none");@Styles?.Overlay"
     id="@_overlayId"
     class="@($"bit-drm-ovl{(HoverDriven ? " bit-drm-ovl-hov" : null)} {Classes?.Overlay}")"></div>

<div @onclick="HandleOnCalloutClick"
     @onkeydown="HandleOnCalloutKeyDown"
     @onmouseenter="HandleOnMouseEnter"
     @onmouseleave="HandleOnMouseLeave"
     id="@_calloutId"
     tabindex="-1"
     style="@GetCalloutStyles()"
     class="@GetCalloutCssClasses()"
     aria-labelledby="@_buttonId"
     role="@(TrapFocus ? "dialog" : null)"
     aria-modal="@(TrapFocus ? "true" : null)"
     dir="@Dir?.ToString().ToLower()">
    @(Body ?? ChildContent)
</div>
