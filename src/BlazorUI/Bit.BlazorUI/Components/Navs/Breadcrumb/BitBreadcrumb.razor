@namespace Bit.BlazorUI
@inherits BitComponentBase
@typeparam TItem

@* The options render a marker element each, whose DOM order is used to keep the order of the
   registered items in sync with the markup order of the options (even when an option is added or
   removed conditionally later on), since the breadcrumb has to render its items out of an ordered
   list to be able to split them between the display items and the overflow callout.
   A breadcrumb fed by its Items has no options to hold, so it renders no container for them either. *@
@if (Options is not null || ChildContent is not null)
{
    <CascadingValue Value="this" IsFixed="true">
        <div style="display:none" hidden id="@_optionsContainerId">@(Options ?? ChildContent)</div>
    </CascadingValue>
}

@* The trail is a navigation landmark holding an ordered list, as the WAI-ARIA breadcrumb pattern
   requires, so assistive technologies can announce it as navigation and enumerate its steps. The
   explicit list role is there because the list items are rendered as flex boxes, which drops the
   implicit list semantics in some screen reader / browser combinations. *@
@* The aria-label sits before the attribute splatting so that an aria-label passed as a plain
   attribute still wins over the default name of the landmark, while the id, the style, the class and
   the dir stay after it and keep the ones the component renders. *@
<nav @ref="RootElement"
     aria-label="@(AriaLabel ?? "Breadcrumb")"
     @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">
    <ol role="list" style="@Styles?.ItemContainer" class="bit-brc-icn @Classes?.ItemContainer">
        @foreach (var (item, idx) in _displayItems.Select((item, index) => (item, index)))
        {
            <li @key="@GetItemKey(item, idx.ToString())" role="listitem" style="@Styles?.ItemWrapper" class="@Classes?.ItemWrapper">
                @if (idx == _internalOverflowIndex && _overflowItems.Any())
                {
                    @* The button either owns a menu or reveals the collapsed items back into the trail. In the
                       latter case it is a plain button that is gone with the collapsing it undid, so it carries
                       none of the properties of a popup that never opens. *@
                    <button @ref="_overflowButtonRef"
                            @onclick="HandleOnOverflowButtonClick"
                            @onkeydown="HandleOnOverflowButtonKeyDown"
                            id="@_overflowAnchorId"
                            type="button"
                            title="@(OverflowAriaLabel ?? "More items")"
                            style="@Styles?.OverflowButton"
                            class="bit-brc-obt @Classes?.OverflowButton"
                            aria-haspopup="@(ExpandOverflow ? null : "menu")"
                            aria-controls="@(ExpandOverflow ? null : _calloutId)"
                            aria-expanded="@(ExpandOverflow ? null : _isCalloutOpen.ToString().ToLower())"
                            aria-label="@(OverflowAriaLabel ?? "More items")"
                            disabled="@(IsEnabled is false)">
                        @if (OverflowIconTemplate is not null)
                        {
                            @OverflowIconTemplate
                        }
                        else
                        {
                            var overflowIcon = BitIconInfo.From(OverflowIcon, OverflowIconName ?? "More");
                            <i aria-hidden="true" style="@Styles?.OverflowButtonIcon" class="@overflowIcon?.GetCssClasses() @Classes?.OverflowButtonIcon" />
                        }
                    </button>
                }
                else
                {
                    var template = GetTemplate(item);
                    if (GetItemHref(item).HasValue())
                    {
                        <a href="@GetItemHref(item)"
                           @onclick="() => HandleOnItemClick(item)"
                           title="@GetItemTitle(item)"
                           target="@GetItemTarget(item)"
                           rel="@GetItemRel(item)"
                           aria-label="@GetItemAriaLabel(item)"
                           aria-current="@(GetIsSelected(item) ? "page" : null)"
                           style="@GetStyles(item, false)"
                           class="bit-brc-itm @GetClasses(item, false)">
                            @if (template is not null)
                            {
                                @template(item)
                            }
                            else if (ItemTemplate is not null)
                            {
                                @ItemTemplate(item)
                            }
                            else
                            {
                                var icon = GetIcon(item);
                                @if (icon is not null)
                                {
                                    <i aria-hidden="true" style="@Styles?.ItemIcon" class="@icon.GetCssClasses() @Classes?.ItemIcon" />
                                }
                                <span style="@Styles?.ItemText" class="bit-brc-itx @Classes?.ItemText">@GetItemText(item)</span>
                            }
                        </a>
                    }
                    else if (HasClickHandler(item))
                    {
                        <button type="button"
                                title="@GetItemTitle(item)"
                                aria-label="@GetItemAriaLabel(item)"
                                aria-current="@(GetIsSelected(item) ? "page" : null)"
                                aria-disabled="@(GetIsEnabled(item) ? null : "true")"
                                disabled="@(GetIsEnabled(item) is false)"
                                style="@GetStyles(item, false)"
                                class="bit-brc-itm @GetClasses(item, false)" @onclick="() => HandleOnItemClick(item)">
                            @if (template is not null)
                            {
                                @template(item)
                            }
                            else if (ItemTemplate is not null)
                            {
                                @ItemTemplate(item)
                            }
                            else
                            {
                                var icon = GetIcon(item);
                                @if (icon is not null)
                                {
                                    <i aria-hidden="true" style="@Styles?.ItemIcon" class="@icon.GetCssClasses() @Classes?.ItemIcon" />
                                }
                                <span style="@Styles?.ItemText" class="bit-brc-itx @Classes?.ItemText">@GetItemText(item)</span>
                            }
                        </button>
                    }
                    else
                    {
                        <span title="@GetItemTitle(item)"
                              aria-label="@GetItemAriaLabel(item)"
                              aria-current="@(GetIsSelected(item) ? "page" : null)"
                              aria-disabled="@(GetIsEnabled(item) ? null : "true")"
                              style="@GetStyles(item, false)"
                              class="bit-brc-nii @GetClasses(item, false)">
                            @if (template is not null)
                            {
                                @template(item)
                            }
                            else if (ItemTemplate is not null)
                            {
                                @ItemTemplate(item)
                            }
                            else
                            {
                                var icon = GetIcon(item);
                                @if (icon is not null)
                                {
                                    <i aria-hidden="true" style="@Styles?.ItemIcon" class="@icon.GetCssClasses() @Classes?.ItemIcon" />
                                }
                                <span style="@Styles?.ItemText" class="bit-brc-itx @Classes?.ItemText">@GetItemText(item)</span>
                            }
                        </span>
                    }
                }
            </li>

            @if (idx != _displayItems.Count - 1)
            {
                @* The divider is decoration: it carries no information a screen reader user needs and
                   would otherwise be announced as an extra step of the trail. *@
                <li aria-hidden="true" style="@Styles?.Divider" class="@Classes?.Divider">
                    @if (DividerIconTemplate is not null)
                    {
                        @DividerIconTemplate
                    }
                    else if (DividerText.HasValue())
                    {
                        <span style="@Styles?.DividerIcon" class="bit-brc-dtx @Classes?.DividerIcon">@DividerText</span>
                    }
                    else
                    {
                        var dividerIcon = BitIconInfo.From(DividerIcon, DividerIconName ?? "ChevronRight");
                        <i style="@Styles?.DividerIcon"
                           class="bit-brc-div @dividerIcon?.GetCssClasses() @Classes?.DividerIcon" />
                    }
                </li>
            }
        }
    </ol>

</nav>

@if (StructuredData)
{
    @* The trail of the whole hierarchy, including the steps the overflow menu holds, as the
       schema.org BreadcrumbList search engines read. The JSON goes in as markup so that the HTML
       encoding of a server-rendered page leaves it alone (a quote turned into an entity is not
       decoded inside a script element and would break the JSON), which is safe here since the JSON
       writer escapes every angle bracket of every value: no "</script" can come out of it. *@
    var structuredData = GetStructuredData();
    if (structuredData is not null)
    {
        <script type="application/ld+json">@((MarkupString)structuredData)</script>
    }
}

<div @onclick="CloseCallout" @onclick:stopPropagation
     style="display:@(_isCalloutOpen ? "block" : "none");@Styles?.Overlay"
     id="@_overlayId"
     class="bit-brc-ovl @Classes?.Overlay"></div>

@* The callout is moved to the body by the JS positioning, so it repeats the direction and the
   look-and-feel classes of the root element instead of inheriting them. *@
<div @ref="_calloutRef"
     @onkeydown="HandleOnCalloutKeyDown"
     id="@_calloutId"
     dir="@Dir?.ToString().ToLower()"
     style="@GetCalloutStyles()"
     class="@GetCalloutClasses()">
    @* The overflow button announces a menu, so the popup carries the roles of one: the list is the menu,
       its items are the menu items and the wrappers around them are presentational. The label of the
       menu is the one of the button that owns it. *@
    <ul role="menu"
        style="@Styles?.CalloutContainer"
        id="@_scrollContainerId"
        class="bit-brc-scn @Classes?.CalloutContainer"
        aria-labelledby="@_overflowAnchorId">
        @foreach (var (item, idx) in _overflowItems.Select((item, idx) => (item, idx)))
        {
            var overflowTemplate = GetOverflowTemplate(item);
            <li @key="@GetItemKey(item, $"overflow-{idx}")" role="presentation" style="@Styles?.OverflowItemWrapper" class="@Classes?.OverflowItemWrapper">
                @if (GetItemHref(item).HasValue())
                {
                    <a href="@GetItemHref(item)"
                       @onclick="() => HandleOnOverflowItemClick(item)"
                       role="menuitem"
                       tabindex="0"
                       title="@GetItemTitle(item)"
                       target="@GetItemTarget(item)"
                       rel="@GetItemRel(item)"
                       aria-label="@GetItemAriaLabel(item)"
                       aria-current="@(GetIsSelected(item) ? "page" : null)"
                       style="@GetStyles(item, true)"
                       class="bit-brc-ofi @GetClasses(item, true)">
                        @if (overflowTemplate is not null)
                        {
                            @overflowTemplate(item)
                        }
                        else if (OverflowTemplate is not null)
                        {
                            @OverflowTemplate(item)
                        }
                        else
                        {
                            var icon = GetIcon(item);
                            @if (icon is not null)
                            {
                                <i aria-hidden="true" style="@Styles?.OverflowItemIcon" class="@icon.GetCssClasses() @Classes?.OverflowItemIcon" />
                            }
                            <span style="@Styles?.OverflowItemText" class="bit-brc-itx @Classes?.OverflowItemText">@GetItemText(item)</span>
                        }
                    </a>
                }
                else if (HasClickHandler(item))
                {
                    <button type="button"
                            role="menuitem"
                            tabindex="@(GetIsEnabled(item) ? 0 : -1)"
                            title="@GetItemTitle(item)"
                            aria-label="@GetItemAriaLabel(item)"
                            aria-current="@(GetIsSelected(item) ? "page" : null)"
                            aria-disabled="@(GetIsEnabled(item) ? null : "true")"
                            disabled="@(GetIsEnabled(item) is false)"
                            style="@GetStyles(item, true)"
                            class="bit-brc-ofi @GetClasses(item, true)" @onclick="() => HandleOnOverflowItemClick(item)">
                        @if (overflowTemplate is not null)
                        {
                            @overflowTemplate(item)
                        }
                        else if (OverflowTemplate is not null)
                        {
                            @OverflowTemplate(item)
                        }
                        else
                        {
                            var icon = GetIcon(item);
                            @if (icon is not null)
                            {
                                <i aria-hidden="true" style="@Styles?.OverflowItemIcon" class="@icon.GetCssClasses() @Classes?.OverflowItemIcon" />
                            }
                            <span style="@Styles?.OverflowItemText" class="bit-brc-itx @Classes?.OverflowItemText">@GetItemText(item)</span>
                        }
                    </button>
                }
                else
                {
                    @* The item is not actionable, but it is still a step of the trail the arrow keys have
                       to reach, so it stays a menu item the script can move the focus onto. *@
                    <span role="menuitem"
                          tabindex="-1"
                          title="@GetItemTitle(item)"
                          aria-label="@GetItemAriaLabel(item)"
                          aria-current="@(GetIsSelected(item) ? "page" : null)"
                          aria-disabled="@(GetIsEnabled(item) ? null : "true")"
                          style="@GetStyles(item, true)"
                          class="bit-brc-ofn @GetClasses(item, true)">
                          @if (overflowTemplate is not null)
                          {
                              @overflowTemplate(item)
                          }
                          else if (OverflowTemplate is not null)
                          {
                              @OverflowTemplate(item)
                          }
                          else
                          {
                              var icon = GetIcon(item);
                              @if (icon is not null)
                              {
                                  <i aria-hidden="true" style="@Styles?.OverflowItemIcon" class="@icon.GetCssClasses() @Classes?.OverflowItemIcon" />
                              }
                              <span style="@Styles?.OverflowItemText" class="bit-brc-itx @Classes?.OverflowItemText">@GetItemText(item)</span>
                          }
                    </span>
                }
            </li>
        }
    </ul>
</div>
