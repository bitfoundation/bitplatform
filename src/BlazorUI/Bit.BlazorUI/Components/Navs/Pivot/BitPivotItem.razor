@namespace Bit.BlazorUI
@inherits BitComponentBase

@* The tab is a div rather than a button so that it can hold a dismiss button of its own without
   nesting one interactive element inside another. Its activation keys are handled by the tablist. *@
<div @ref="RootElement" @attributes="HtmlAttributes"
     @onclick="HandleOnClick"
     @onfocusin="HandleOnFocusIn"
     id="@_Id"
     role="tab"
     title="@Title"
     aria-label="@AriaLabel"
     data-content="@HeaderText"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     tabindex="@Parent?.GetItemTabIndex(this)"
     aria-controls="@Parent?.GetItemPanelId(this)"
     aria-disabled="@(IsEnabled ? null : "true")"
     aria-selected="@(IsSelected ? "true": "false")">
    <span style="@Parent?.Styles?.HeaderItemContent" class="bit-pvti-cnt @Parent?.Classes?.HeaderItemContent">
        @{
            var icon = BitIconInfo.From(Icon, IconName);
        }
        @if (icon is not null)
        {
            <span style="@Parent?.Styles?.HeaderIconContainer" class="@Parent?.Classes?.HeaderIconContainer">
                <i aria-hidden="true" style="@Parent?.Styles?.HeaderIcon" class="@icon.GetCssClasses() @Parent?.Classes?.HeaderIcon" />
            </span>
        }

        @if (Header is not null)
        {
            @Header
        }
        else if (HeaderText.HasValue())
        {
            @* The data-content is what the stylesheet lays an invisible bold copy of the label out
               of, so that a tab does not change width when it becomes the selected (semibold) one. *@
            <span data-content="@HeaderText"
                  style="@Parent?.Styles?.HeaderText"
                  class="bit-pvti-txt @Parent?.Classes?.HeaderText">@HeaderText</span>
        }

        @if (ItemCount is not null)
        {
            <span style="@Parent?.Styles?.HeaderItemCount" class="bit-pvti-cnr @Parent?.Classes?.HeaderItemCount">(@ItemCount)</span>
        }
    </span>

    @* Out of the tab order on purpose: the tab holding it is the tab stop, and the Delete key is
       what dismisses the tab from the keyboard. *@
    @if (Parent?.GetItemDismissible(this) is true)
    {
        var dismissIcon = BitIconInfo.From(Parent.DismissIcon, Parent.DismissIconName ?? "Cancel");
        @* Its keys are its own as well: the tablist around it would take the Enter that dismisses
           the tab as an activation of it. *@
        <button @onclick="HandleOnDismiss"
                @onclick:stopPropagation="true"
                @onkeydown:stopPropagation="true"
                type="button"
                tabindex="-1"
                title="@(Parent.DismissTitle ?? "Remove")"
                aria-label="@Parent.GetDismissAriaLabel(this)"
                style="@Parent.Styles?.DismissButton"
                class="bit-pvti-dbt @Parent.Classes?.DismissButton">
            <i aria-hidden="true" style="@Parent.Styles?.DismissIcon" class="bit-pvti-dsi @dismissIcon?.GetCssClasses() @Parent.Classes?.DismissIcon" />
        </button>
    }
</div>
