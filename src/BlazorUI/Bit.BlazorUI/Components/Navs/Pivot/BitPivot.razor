@namespace Bit.BlazorUI
@inherits BitComponentBase

@* The root carries no role of its own: it holds the tablist and the tabpanel, and any role here
   would sit between the two and break the association the WAI-ARIA tabs pattern relies on. *@
<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    <CascadingValue Value="this" IsFixed="true">
        <div style="@Styles?.HeaderContainer" class="bit-pvt-hwr @Classes?.HeaderContainer">

            @if (HeaderStart is not null)
            {
                <div style="@Styles?.HeaderStart" class="bit-pvt-hst @Classes?.HeaderStart">
                    @HeaderStart
                </div>
            }

            @if (_ShowSlideButtons)
            {
                var prevIcon = BitIconInfo.From(PreviousIcon, PreviousIconName ?? (_isVertical ? "ChevronUp" : "ChevronLeft"));
                <button type="button"
                        disabled="@(_slideAtStart || _slideHasOverflow is false)"
                        style="@Styles?.SlideButton"
                        aria-label="@(PreviousAriaLabel ?? "Previous")"
                        @onclick="() => Slide(false)"
                        class="bit-pvt-sbt bit-pvt-spv @Classes?.SlideButton">
                    <i aria-hidden="true" class="@prevIcon?.GetCssClasses()" />
                </button>
            }

            @* The arrow, Home, End, Enter, Space and Delete keys of the tabs pattern are all handled
               on the tablist, so a single handler covers every item that bubbles its keydown here. *@
            <div @ref="_headerRef"
                 @onkeydown="HandleOnKeyDown"
                 @onkeydown:preventDefault="_preventKeyDownDefault"
                 role="tablist"
                 aria-label="@AriaLabel"
                 aria-orientation="@(_isVertical ? "vertical" : "horizontal")"
                 style="@Styles?.Header"
                 class="bit-pvt-hct @Classes?.Header">
                @ChildContent

                @if (OverflowBehavior is BitPivotOverflowBehavior.Menu)
                {
                    var moreIcon = BitIconInfo.From(OverflowIcon, OverflowIconName ?? "More");
                    @* Its keys are its own: the tablist around it would otherwise take the Enter or
                       the Space that opens the menu as an activation of the focused tab. *@
                    <button @ref="_moreRef"
                            type="button"
                            style="display:none;@Styles?.OverflowButton"
                            aria-haspopup="menu"
                            aria-label="@(OverflowAriaLabel ?? "More")"
                            aria-controls="@_MenuId"
                            aria-expanded="@(_isMenuOpen ? "true" : "false")"
                            @onclick="ToggleMenu"
                            @onkeydown="HandleMoreKeyDown"
                            @onkeydown:preventDefault="_preventMoreKeyDownDefault"
                            @onkeydown:stopPropagation="true"
                            class="bit-pvti bit-pvt-mor @(_IsSelectedOverflowed ? "bit-pvt-mor-sel" : null) @Classes?.OverflowButton">
                        <span>
                            <i aria-hidden="true" class="@moreIcon?.GetCssClasses()" />
                        </span>
                    </button>
                }
            </div>

            @if (_ShowSlideButtons)
            {
                var nextIcon = BitIconInfo.From(NextIcon, NextIconName ?? (_isVertical ? "ChevronDown" : "ChevronRight"));
                <button type="button"
                        disabled="@(_slideAtEnd || _slideHasOverflow is false)"
                        style="@Styles?.SlideButton"
                        aria-label="@(NextAriaLabel ?? "Next")"
                        @onclick="() => Slide(true)"
                        class="bit-pvt-sbt bit-pvt-snx @Classes?.SlideButton">
                    <i aria-hidden="true" class="@nextIcon?.GetCssClasses()" />
                </button>
            }

            @if (OverflowBehavior is BitPivotOverflowBehavior.Menu)
            {
                <div class="bit-pvt-ovl"
                     style="display:@(_isMenuOpen ? "block" : "none")"
                     @onclick="CloseMenu"></div>

                @* The menu takes the focus on itself and points at the item it is on with an
                   aria-activedescendant, which the WAI-ARIA menu pattern offers as the alternative to
                   moving the real focus from one of its items to the next. *@
                <div @ref="_menuRef"
                     style="display:@(_isMenuOpen ? "block" : "none");@Styles?.OverflowCallout"
                     id="@_MenuId"
                     role="menu"
                     tabindex="-1"
                     aria-label="@(OverflowAriaLabel ?? "More")"
                     aria-activedescendant="@_ActiveMenuItemId"
                     @onkeydown="HandleMenuKeyDown"
                     @onkeydown:preventDefault="_preventMenuKeyDownDefault"
                     class="bit-pvt-mnc @Classes?.OverflowCallout">
                    @for (var i = 0; i < _overflowItemIndexes.Length; i++)
                    {
                        var index = _overflowItemIndexes[i];
                        var item = (index >= 0 && index < _allItems.Count) ? _allItems[index] : null;
                        if (item is null) continue;

                        var itemIndex = i;

                        @* menuitemradio rather than menuitem: the menu is another way of making the
                           single choice the tablist makes, so each of its items carries whether it is
                           the one currently chosen. *@
                        <button type="button"
                                id="@GetMenuItemId(itemIndex)"
                                tabindex="-1"
                                role="menuitemradio"
                                title="@item.Title"
                                disabled="@(item.IsEnabled is false)"
                                aria-disabled="@(item.IsEnabled ? null : "true")"
                                aria-checked="@(item.IsSelected ? "true" : "false")"
                                style="@Styles?.OverflowItem"
                                @onclick="() => SelectFromMenu(item)"
                                class="bit-pvt-mni @(item.IsSelected ? "bit-pvt-mni-sel" : null) @(itemIndex == _menuFocusIndex ? "bit-pvt-mni-act" : null) @Classes?.OverflowItem">
                            @{
                                var menuIcon = BitIconInfo.From(item.Icon, item.IconName);
                            }
                            @if (menuIcon is not null)
                            {
                                <i aria-hidden="true" class="@menuIcon.GetCssClasses()" />
                            }
                            @if (item.Header is not null)
                            {
                                @item.Header
                            }
                            else if (item.HeaderText.HasValue())
                            {
                                <span>@item.HeaderText</span>
                            }
                            @if (item.ItemCount is not null)
                            {
                                <span>(@item.ItemCount)</span>
                            }
                        </button>
                    }
                </div>
            }

            @if (HeaderEnd is not null)
            {
                <div style="@Styles?.HeaderEnd" class="bit-pvt-hnd @Classes?.HeaderEnd">
                    @HeaderEnd
                </div>
            }
        </div>
    </CascadingValue>

    @* The panel is focusable on purpose: the WAI-ARIA tabs pattern asks for it so that a keyboard
       user leaving the tablist lands on the content it controls even when that content holds
       nothing focusable of its own. *@
    @if (HeaderOnly is false)
    {
        if (MountAll || KeepMounted)
        {
            // KeepMounted keeps a panel for every tab that has been shown at least once, so that
            // leaving a tab and coming back to it finds the content in the state it was left in.
            TrackMountedItem();
            @foreach (var item in _allItems)
            {
                if (IsItemPanelRendered(item) is false) continue;

                var isSelected = item == _selectedItem;
                <div role="tabpanel"
                     tabindex="0"
                     id="@GetItemPanelId(item)"
                     hidden="@(isSelected is false)"
                     aria-hidden="@(isSelected ? null : "true")"
                     aria-labelledby="@item._Id"
                     style="@GetItemStyle(item)"
                     class="bit-pvt-cct @GetItemClass(item)">
                    @(item.Body ?? item.ChildContent)
                </div>
            }
        }
        else
        {
            <div role="tabpanel"
                 tabindex="0"
                 id="@(_selectedItem is null ? null : GetItemPanelId(_selectedItem))"
                 aria-labelledby="@(_selectedItem?._Id)"
                 style="@GetItemStyle(_selectedItem)"
                 class="bit-pvt-cct @GetItemClass(_selectedItem)">
                @(_selectedItem?.Body ?? _selectedItem?.ChildContent)
            </div>
        }
    }
</div>
