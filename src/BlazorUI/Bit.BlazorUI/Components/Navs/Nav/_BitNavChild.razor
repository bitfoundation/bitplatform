@namespace Bit.BlazorUI
@typeparam TItem

<li role="listitem" style="@Nav.GetStyle(Item)" class="@Nav.GetClass(Item)">
    @{
        var template = Nav.GetTemplate(Item);
        var templateRenderMode = Nav.GetTemplateRenderMode(Item);
        var isEnabled = Nav.GetIsEnabled(Item);
        var isExpanded = Nav.GetItemExpanded(Item);
        var isSeparator = Nav.GetIsSeparator(Item);
        var text = Nav.GetText(Item);
        var childItems = Nav.GetChildItems(Item);
        var description = Nav.GetDescription(Item);
        // The rotation class is applied next to the icon classes instead of being smuggled into the icon
        // name, so a custom ChevronDownIcon/ChevronDownIconName rotates on expand just like the default one.
        var chevronIcon = BitIconInfo.From(Nav.ChevronDownIcon, Nav.ChevronDownIconName ?? "ChevronRight");
        var chevronRotation = isExpanded ? "bit-nav-exp" : "bit-ico-r90";
        var icon = Nav.GetIcon(Item);
        var url = Nav.GetUrl(Item);
        var title = Nav.GetTitle(Item);
        var target = Nav.GetTarget(Item);
        var renderLink = url.HasValue() || Nav.GetForceAnchor(Item);
        var isSelected = Nav.IsSelected(Item);
        var href = isEnabled ? url : null;
        var isToggleable = childItems.Any() && Nav.NoCollapse is false;
        // A collapsed or expanded item reports its state through aria-expanded; an item that can never be
        // toggled must not report one at all, so it is not announced as an expandable node.
        var ariaExpanded = isToggleable ? (isExpanded ? "true" : "false") : null;
        var toggleAriaLabel = (isExpanded ? Nav.GetCollapseAriaLabel(Item) ?? Nav.CollapseAriaLabel
                                          : Nav.GetExpandAriaLabel(Item) ?? Nav.ExpandAriaLabel) ?? text;
    }

    @if (Nav.RenderType is BitNavRenderType.Grouped && Parent is null)
    {
        @if (isSeparator)
        {
            if (template is not null)
            {
                @template(Item)
            }
            else
            {
                <div role="separator" class="bit-nav-sep @Nav.Classes?.Separator" style="@Nav.Styles?.Separator"></div>
            }
        }
        else if (template is not null && templateRenderMode is BitNavItemTemplateRenderMode.Replace)
        {
            @template(Item)
        }
        else if (Nav.HeaderTemplate is not null && Nav.HeaderTemplateRenderMode is BitNavItemTemplateRenderMode.Replace)
        {
            @Nav.HeaderTemplate(Item)
        }
        else
        {
            <button @ref="_headerElement"
                    @onclick="ToggleItem"
                    @onfocusin="HandleOnFocusIn"
                    @onkeydown="HandleOnKeyDown"
                    @onkeydown:preventDefault="Nav.PreventKeyDownDefault"
                    type="button"
                    title="@(title is not null ? title : text)"
                    disabled="@(isEnabled is false)"
                    style="@Nav.Styles?.Header"
                    class="bit-nav-gcb @Nav.Classes?.Header"
                    aria-expanded="@ariaExpanded"
                    aria-label="@(Nav.GetAriaLabel(Item) ?? toggleAriaLabel)">
                @if (template is not null)
                {
                    @template(Item)
                }
                else if (Nav.HeaderTemplate is not null)
                {
                    @Nav.HeaderTemplate(Item)
                }
                else
                {
                    if (description.HasValue())
                    {
                        <div class="bit-nav-itg">
                            <div class="bit-nav-iit" style="@(Nav.ReversedChevron ? "flex-flow:row-reverse" : null)">
                                @if (isToggleable)
                                {
                                    <i style="@Nav.Styles?.ToggleIcon"
                                       class="@chevronIcon?.GetCssClasses() @chevronRotation @Nav.Classes?.ToggleIcon"
                                       aria-hidden="true" />
                                }
                                @if (icon is not null)
                                {
                                    <i style="@Nav.Styles?.ItemIcon" class="bit-nav-iic @icon.GetCssClasses() @Nav.Classes?.ItemIcon" aria-hidden="true" />
                                }
                                <span style="@Nav.Styles?.HeaderText" class="bit-nav-ghd @Nav.Classes?.HeaderText">@text</span>
                            </div>
                            <div title="@description"
                                 class="bit-nav-des @Nav.Classes?.Description"
                                 style="@((Nav.ReversedChevron || Nav.NoCollapse) ? "padding-inline-start:0" : ""); @Nav.Styles?.Description">
                                @description
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bit-nav-iit" style="@(Nav.ReversedChevron ? "flex-flow:row-reverse" : null)">
                            @if (isToggleable)
                            {
                                <i style="@Nav.Styles?.ToggleIcon"
                                   class="@chevronIcon?.GetCssClasses() @chevronRotation @Nav.Classes?.ToggleIcon"
                                   aria-hidden="true" />
                            }
                            @if (icon is not null)
                            {
                                <i style="@Nav.Styles?.ItemIcon" class="bit-nav-iic @icon.GetCssClasses() @Nav.Classes?.ItemIcon" aria-hidden="true" />
                            }
                            <span style="@Nav.Styles?.HeaderText" class="bit-nav-ghd @Nav.Classes?.HeaderText">@text</span>
                        </div>
                    }
                }
            </button>
        }
    }
    else
    {
        @if (isSeparator)
        {
            if (template is not null)
            {
                @template(Item)
            }
            else
            {
                <div role="separator" style="@Nav.Styles?.Separator" class="bit-nav-sep @Nav.Classes?.Separator"></div>
            }
        }
        else
        {
            var padding = Nav.IconOnly ? 0 : Depth * Nav.IndentValue + (Nav.ReversedChevron ? Nav.IndentReversedPadding : (Nav.NoCollapse ? Nav.IndentValue/2 : (childItems.Any() ? 0 : Nav.IndentPadding)));

            var desPadding = Nav.ReversedChevron is false && (childItems.Any() && Nav.NoCollapse is false) ? Nav.IndentPadding : 0;


            @if (template is not null && templateRenderMode is BitNavItemTemplateRenderMode.Replace)
            {
                @template(Item)
            }
            else if (Nav.ItemTemplate is not null && Nav.ItemTemplateRenderMode is BitNavItemTemplateRenderMode.Replace)
            {
                @Nav.ItemTemplate(Item)
            }
            else
            {
                <_BitNavItemContainer @ref="_container"
                                      Href="@href"
                                      Target="@target"
                                      OnClick="HandleOnClick"
                                      RenderLink="renderLink"
                                      OnFocusIn="HandleOnFocusIn"
                                      OnKeyDown="HandleOnKeyDown"
                                      PreventKeyDownDefault="Nav.PreventKeyDownDefault"
                                      Disabled="@(isEnabled is false)"
                                      AriaExpanded="@ariaExpanded"
                                      AriaLabel="@Nav.GetAriaLabel(Item)"
                                      Title="@(title is not null ? title : text)"
                                      Class="@($"bit-nav-ict {GetItemContainerClasses()}")"
                                      Style="@($"padding-inline-start:{padding}px;{GetItemContainerStyles()}")"
                                      AriaCurrent="@(isSelected ? _AriaCurrentMap[Nav.GetAriaCurrent(Item)] : null)"
                                      TabIndex="@(isEnabled is false ? "-1" : (renderLink && href.HasNoValue() ? "0" : null))"
                                      Rel="@(url.HasValue() && target.HasValue() && IsRelativeUrl(url!) is false ? "noopener noreferrer" : null)">
                    <div class="bit-nav-mct" style="@(Nav.ReversedChevron ? "flex-flow:row-reverse" : null)">
                        @if (childItems.Any() && Nav.IconOnly is false && Nav.NoCollapse is false)
                        {
                            @* The chevron cannot be a button, since it lives inside the item's own anchor or
                               button, so it carries the button role and its keyboard activation explicitly. *@
                            <div @onclick="ToggleItem"
                                 @onclick:preventDefault="true"
                                 @onclick:stopPropagation="true"
                                 @onkeydown="HandleToggleKeyDown"
                                 @onkeydown:preventDefault="_preventToggleKeyDownDefault"
                                 tabindex="0"
                                 role="button"
                                 style="@Nav.Styles?.ToggleButton"
                                 class="bit-nav-cbt @Nav.Classes?.ToggleButton"
                                 aria-expanded="@(isExpanded ? "true" : "false")"
                                 aria-label="@toggleAriaLabel">
                                <i style="@Nav.Styles?.ToggleIcon"
                                   class="@chevronIcon?.GetCssClasses() @chevronRotation @Nav.Classes?.ToggleIcon"
                                   aria-hidden="true" />
                            </div>
                        }
                        <div style="@GetItemStyles()"
                             class="bit-nav-itm @GetItemClasses()">
                            @if (template is not null)
                            {
                                @template(Item)
                            }
                            else if (Nav.ItemTemplate is not null)
                            {
                                @Nav.ItemTemplate(Item)
                            }
                            else
                            {
                                @if (icon is not null)
                                {
                                    <i style="@Nav.Styles?.ItemIcon" class="bit-nav-iic @icon.GetCssClasses() @Nav.Classes?.ItemIcon" aria-hidden="true" />
                                }
                                <span style="@Nav.Styles?.ItemText" class="bit-nav-itx @Nav.Classes?.ItemText">@text</span>
                            }
                        </div>
                    </div>

                    @if (description.HasValue() && Nav.IconOnly is false)
                    {
                        <div title="@description"
                             class="bit-nav-des @Nav.Classes?.Description"
                             style="padding-inline-start:@(desPadding)px;@Nav.Styles?.Description">
                            @description
                        </div>
                    }
                </_BitNavItemContainer>
            }
        }
    }

    @if (ChildrenFragment is not null)
    {
        @* The nav options render their children in place, so the children have to stay rendered (but
           hidden) while collapsed to keep their registrations (and expand/collapse chevron) alive. *@
        <ul role="list" style="@(childItems.Any() && isExpanded ? null : "display:none")">
            <CascadingValue Value="this" IsFixed="true">
                @ChildrenFragment
            </CascadingValue>
        </ul>
    }
    else if ((childItems.Any()) && (isExpanded))
    {
        <ul role="list">
            <CascadingValue Value="this" IsFixed="true">
                @foreach (var (item, idx) in childItems.Select((item, idx) => (item, idx)))
                {
                    var key = Nav.GetItemKey(item, $"{Key}-{idx}");
                    <_BitNavChild @key="@key" Key="@key" Item="item" Depth="Depth + 1" />
                }
            </CascadingValue>
        </ul>
    }
</li>
