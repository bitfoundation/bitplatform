@namespace Bit.BlazorUI
@inherits BitComponentBase

@*  The frame. It takes the width of its container and the height its aspect ratio gives that width, so the content
    framed in it scales with the page rather than keeping the fixed size an iframe has of its own. Everything inside
    it fills it. *@
<div @ref="RootElement"
     @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLowerInvariant()">
    @if (_ShowsPlaceholder)
    {
        var src = _src;

        @*  The click-to-load facade: nothing of the embedded page is requested until the user asks for it. A native
            button, so the keyboard and a screen reader reach it like any other, named by what it does - the template
            is mostly a picture, which says nothing to either.
            Keyed by the address it loads and handed that address, so a click still in flight when a new one arrives
            reaches the button it was made on, and agrees to the address that button showed rather than the new one. *@
        <button @key="src"
                @onclick="() => HandleOnPlaceholderClick(src)"
                type="button"
                tabindex="@TabIndex"
                style="@Styles?.Placeholder"
                class="bit-emb-plh @Classes?.Placeholder"
                disabled="@Disabled"
                aria-disabled="@(Disabled ? "true" : null)"
                aria-label="@_PlaceholderAriaLabel">
            @PlaceholderTemplate
        </button>
    }
    else if (_src is not null)
    {
        @*  Keyed by its address, so a new one replaces the iframe rather than navigating the loaded one - which would
            add an entry to the history of the browser, and make Back step through the earlier embeds first. *@
        <iframe @key="_src"
                @ref="_frameElement"
                style="@Styles?.Frame"
                class="bit-emb-frm @Classes?.Frame"
                src="@_src"
                tabindex="@TabIndex"
                title="@Title"
                loading="@(Loading is BitImageLoading.Eager ? "eager" : "lazy")"
                allow="@Allow"
                allowfullscreen="@AllowFullScreen"
                referrerpolicy="@GetReferrerPolicy()"
                sandbox="@Sandbox"></iframe>
    }
</div>
