@namespace Bit.BlazorUI
@inherits BitComponentBase

@*  The image itself. Everything it renders is merged into a single attribute dictionary rather than
    written as attributes beside the splat: an attribute written after "@attributes" removes the
    splatted one of the same name when its own value is null, so a "decoding" or a "srcset" put in
    ImageAttributes would be taken away again by the parameter of the same name that is not set. See
    GetImageAttributes.

    It is a fragment rather than markup written in place because it is rendered either on its own or as
    the last child of a picture, and the two have to be the same element - a second copy would be a
    second img to keep in step with.

    The img of the DarkSrc is the one second img there is: the picture of the other color scheme, written
    from the same attributes but for its sources, and shown in place of the first one while the scheme is
    dark - which the stylesheet decides, so it is right before the page is interactive (BitImage.scss).

    Each img hears the end of its own fade, which takes the fade off it: played again, it would start over every
    time the img came back into the box tree, as the img of a DarkSrc does on every change of the scheme. *@
@{
    RenderFragment image =@<img @key="_reloadKey" @ref="_imageElement" @attributes="GetImageAttributes()"
                                @onload="HandleOnLoad"
                                @onerror="HandleOnError"
                                @onanimationend="HandleOnImageAnimationEnd"
                                @onclick="HandleOnClick"
                                @onkeydown="HandleOnKeyDown"
                                @onkeyup="HandleOnKeyUp" />;

    RenderFragment darkImage =@<img @key="_darkReloadKey" @ref="_darkImageElement" @attributes="GetImageAttributes(dark: true)"
                                    @onload="HandleOnDarkLoad"
                                    @onerror="HandleOnDarkError"
                                    @onanimationend="HandleOnDarkImageAnimationEnd"
                                    @onclick="HandleOnClick"
                                    @onkeydown="HandleOnKeyDown"
                                    @onkeyup="HandleOnKeyUp" />;
}

@*  The frame. Everything else is positioned against it, so it is the element that carries the size,
    the aspect ratio, the shape and the clipping - which is what lets a cover fit and a rounded corner
    crop the image without the image itself knowing about either. *@
<div @ref="RootElement" @attributes="DisabledAwareHtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLowerInvariant()">

    @*  The low quality placeholder, which stands in the frame while the real image is still on its
        way. It is decorative by definition - the image it stands for carries the meaning - so it is
        hidden from assistive technologies rather than given an alt of its own. Under a FadeIn it outlives
        the load by the length of the fade, fading out as the image fades in, and is removed once that fade
        has ended - which only the browser knows, the duration being the theme's and the reduced-motion
        preference's as much as the component's, and the animation itself a restyle's to replace
        (Bit.BlazorUI.Events registers the directives). A canceled fade lets it go as well: it has nothing
        left to show over the image. Like every part below that follows the state, it is rendered per color
        scheme where the images of a DarkSrc are in different states (GetSchemeParts), and its animations are
        the placeholder of the img of its scheme - or of both, rendered once for both. *@
    @foreach (var (scheme, schemeImage) in GetSchemeParts(IsPlaceholderShown, IsPlaceholderLeaving))
    {
        <img alt=""
             aria-hidden="true"
             src="@PlaceholderSrc"
             referrerpolicy="@GetPlaceholderReferrerPolicy()"
             draggable="false"
             style="@GetPlaceholderStyles()"
             class="@GetPlaceholderClasses(schemeImage, scheme)"
             @onanimationstart="(BitAnimationEventArgs e) => HandleOnPlaceholderAnimationStart(e, scheme)"
             @onanimationend="(BitAnimationEventArgs e) => HandleOnPlaceholderAnimationEnd(e, scheme)"
             @onanimationcancel="(BitAnimationEventArgs e) => HandleOnPlaceholderAnimationEnd(e, scheme)" />
    }

    @if (_hasSources)
    {
        @*  The alternative sources, which the browser walks in order and takes the first of that it is
            satisfied by. The picture is only a grouping element and lays nothing out itself - it is
            given display:contents - so the frame keeps sizing the img exactly as it does without it. *@
        <picture class="bit-img-pic">
            @foreach (var source in Sources!)
            {
                if (source is null || source.Srcset.HasNoValue()) continue;

                <source srcset="@source.Srcset"
                        media="@source.Media"
                        sizes="@source.Sizes"
                        type="@source.Type"
                        width="@source.Width"
                        height="@source.Height" />
            }
            @image
        </picture>
    }
    else
    {
        @image
    }

    @if (_hasDarkImage)
    {
        @darkImage
    }

    @*  The text alternative of an image that is not on screen, which leaves the accessibility tree
        with the image it belongs to - see the .bit-img-alt rule. *@
    @foreach (var (scheme, _) in GetSchemeParts(IsHiddenImageAnnounced))
    {
        <span role="img" aria-label="@GetHiddenImageName()" class="@JoinClasses("bit-img-alt", scheme)"></span>
    }

    @foreach (var (scheme, _) in GetSchemeParts(IsLoadingTemplateShown))
    {
        <div style="@Styles?.LoadingTemplate"
             class="@GetTemplateClasses(scheme, Classes?.LoadingTemplate)">
            @LoadingTemplate
        </div>
    }

    @foreach (var (scheme, _) in GetSchemeParts(IsErrorTemplateShown))
    {
        <div style="@Styles?.ErrorTemplate"
             class="@GetTemplateClasses(scheme, Classes?.ErrorTemplate)">
            @ErrorTemplate
        </div>
    }

    @*  The content laid over the image - a caption, a badge, a gradient scrim. It is the last thing
        in the frame so it stacks above the image without either of them needing a z-index, and it
        lets the pointer through except where the content itself takes it, so an image that is also
        a button stays clickable underneath its own caption. *@
    @if (ChildContent is not null)
    {
        <div style="@Styles?.Content"
             class="bit-img-ovl@(Classes?.Content.HasValue() is true ? $" {Classes!.Content}" : null)">
            @ChildContent
        </div>
    }

</div>
