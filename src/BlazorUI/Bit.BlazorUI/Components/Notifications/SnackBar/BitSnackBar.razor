@namespace Bit.BlazorUI
@inherits BitComponentBase

@* The root is a labelled region rather than a bare box: it is a landmark the screen reader user can jump to,
   and the one place the notifications of the page live. It is rendered even while it holds nothing, so a
   snack bar that arrives later lands inside a container the assistive technology is already watching.
   The negative tabindex keeps it out of the Tab order while still letting the Hotkey and the public
   FocusAsync put the focus on it, which is what puts the next Tab inside the notifications. *@
<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     role="region"
     tabindex="-1"
     class="@ClassBuilder.Value"
     style="@StyleBuilder.Value"
     aria-label="@_RootAriaLabel"
     dir="@Dir?.ToString().ToLower()">

    @* The two announcers are the live regions of the snack bar. They are rendered once and stay, because a live
       region has to already be on the page when its content changes for a screen reader to be watching it - an
       element that arrives carrying its own aria-live is the case assistive technology is least reliable about.
       Each announcement is appended as a child of its own rather than replacing the text of the region, so
       aria-atomic is off and the same message twice in a row is still read twice. *@
    <div class="bit-snb-ann" role="status" aria-live="polite" aria-atomic="false">
        @foreach (var announcement in _politeAnnouncements)
        {
            <div @key="announcement.Id">@announcement.Text</div>
        }
    </div>
    <div class="bit-snb-ann" role="alert" aria-live="assertive" aria-atomic="false">
        @foreach (var announcement in _assertiveAnnouncements)
        {
            <div @key="announcement.Id">@announcement.Text</div>
        }
    </div>

    @foreach (var item in _items)
    {
        @* The id is on the element for the swipe script to read, and only on the items a swipe is allowed to take
           away, so a persistent one does not even follow the pointer. *@
        <div @key="item.Id"
             role="@GetItemRole(item)"
             tabindex="@GetItemTabIndex(item)"
             data-bit-snb-id="@(IsDismissible(item) ? item.Id.ToString() : null)"
             aria-live="@GetItemAriaLive(item)"
             aria-atomic="@GetItemAriaAtomic(item)"
             style="@JoinStyles(Styles?.Container, item.CssStyle)"
             class="bit-snb-itm @GetItemClasses(item) @Classes?.Container @item.CssClass"
             @onclick="() => HandleItemClick(item)"
             @onkeydown="e => HandleItemKeyDown(e, item)"
             @onmouseenter="() => HandleHoverStart(item)"
             @onmouseleave="() => HandleHoverEnd(item)"
             @onfocusin="() => HandleHoverStart(item)"
             @onfocusout="() => HandleHoverEnd(item)">

            @if (Template is not null)
            {
                @Template(item)
            }
            else
            {
                @* The dismiss button comes last in the DOM although it is drawn at the inline end of the header,
                   so a screen reader reads the notification before it reaches the button that throws it away,
                   and the Tab order does the same. *@
                <div style="@Styles?.Header" class="bit-snb-hdr @Classes?.Header">
                    @if (ShowIcon && item.HideIcon is false)
                    {
                        <div style="@Styles?.IconContainer" class="bit-snb-ict @Classes?.IconContainer" aria-hidden="true">
                            <i style="@Styles?.Icon" class="bit-snb-ico @GetIcon(item)?.GetCssClasses() @Classes?.Icon" />
                        </div>
                    }

                    @if (TitleTemplate is not null)
                    {
                        @TitleTemplate(item.Title)
                    }
                    else if (item.Title.HasValue())
                    {
                        @* The tooltip is what a title cut off with an ellipsis is read in full from, so it is only
                           there while the title really is being cut off - on a wrapping title it would be a
                           duplicate of text that is already all on screen. *@
                        <div title="@(Multiline ? null : item.Title)"
                             style="@Styles?.Title"
                             class="bit-snb-ttl @(Multiline ? "" : "bit-snb-elp") @Classes?.Title">
                            @item.Title
                        </div>
                    }

                    @if (ShowsDismissButton(item))
                    {
                        @* The keydown is stopped here for the same reason the click is: the button answers Enter
                           and Space itself, and letting those reach the item would activate a clickable item at
                           the same time as the button that takes it away. Escape is handed on by hand, because
                           it is the item it belongs to rather than the button. *@
                        <button @ref="_dismissButtons[item.Id]"
                                @onclick="() => HandleDismissClick(item)" @onclick:stopPropagation
                                @onkeydown="e => HandleDismissKeyDown(e, item)" @onkeydown:stopPropagation
                                type="button"
                                title="@_DismissAriaLabel"
                                aria-label="@_DismissAriaLabel"
                                style="@Styles?.DismissButton"
                                class="bit-snb-cbt @Classes?.DismissButton">
                            @{
                                var dismissIcon = BitIconInfo.From(DismissIcon, DismissIconName ?? "Cancel");
                            }
                            <i aria-hidden="true" style="@Styles?.DismissIcon" class="@dismissIcon?.GetCssClasses() @Classes?.DismissIcon" />
                        </button>
                    }
                </div>

                @if (BodyTemplate is not null)
                {
                    @BodyTemplate(item.Body ?? string.Empty)
                }
                else if (item.Body.HasValue())
                {
                    @* Same as the title: a body that is being cut off keeps its full text in a tooltip, and one
                       that wraps has nothing to put there that is not already on screen. *@
                    <div title="@(Multiline ? null : item.Body)"
                         style="@Styles?.Body"
                         class="bit-snb-bdy @(Multiline ? "" : "bit-snb-elp") @Classes?.Body">
                        @item.Body
                    </div>
                }

                @if (item.Actions is not null || ActionsTemplate is not null)
                {
                    <div style="@Styles?.Actions" class="bit-snb-act @Classes?.Actions">
                        @(item.Actions ?? ActionsTemplate!(item))
                    </div>
                }
            }

            @if (ShowProgressBar(item))
            {
                @* The bar is the countdown made visible, and the countdown is already spelled out by the text of
                   the notification and by its dismiss button, so it carries nothing of its own for a screen
                   reader to read out. *@
                <span @key="(item.Id, item._generation)"
                      aria-hidden="true"
                      style="@JoinStyles(GetDuration(item), Styles?.ProgressBar)"
                      class="bit-snb-prb @Classes?.ProgressBar">
                </span>
            }
        </div>
    }
</div>
