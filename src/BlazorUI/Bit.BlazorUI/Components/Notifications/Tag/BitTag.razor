@namespace Bit.BlazorUI
@inherits BitComponentBase

@{
    var icon = BitIconInfo.From(Icon, IconName);

    @* The glyph that closes the tag rather than opening it: the chevron of a chip that drops a menu, the
       arrow of one that leads somewhere, the count of what it stands for. It sits after the label and
       before the dismiss button, and it mirrors with the rest of the row when the tag is reversed. *@
    var secondaryIcon = BitIconInfo.From(SecondaryIcon, SecondaryIconName);

    @* The checkmark of a selected tag, which is what makes a filter chip readable as picked rather than
       as merely a different color - a state carried by color alone is one a reader cannot see. *@
    var selectedIcon = Selected && HideSelectedIcon is false
                     ? BitIconInfo.From(SelectedIcon, SelectedIconName ?? "Accept")
                     : null;

    var hasLabel = Text.HasValue() || SecondaryText.HasValue();

    @* The label of the tag names whatever the tag became: an anchor, a button or nothing at all. A tag that
       is one of the first two is the control a screen reader lands on, so the name moves onto that control
       and only stays with the root when there is no control to carry it. *@
    var labelOnRoot = _isInteractive is false;

    var describedById = AriaDescription.HasValue() ? $"{_Id}-dsc" : null;

    @* An attribute written after the splat wins over the one the app passed in through HtmlAttributes, and a
       null one takes it off the element altogether. What the tag has of its own therefore still comes first,
       but it falls back to - and for a description joins - whatever came in with the attributes. *@
    var splattedLabel = GetSplattedAttribute("aria-label");
    var splattedLabelledBy = GetSplattedAttribute("aria-labelledby");
    var splattedTitle = GetSplattedAttribute("title");
    var splattedDescribedBy = GetSplattedAttribute("aria-describedby");
    var splattedTabIndex = GetSplattedAttribute("tabindex");

    @* A tag that is a control carries its tab index on that control, and a dismissible one on its button, so
       the root only takes it where there is nothing else inside the tag to take it - which is the one case
       where a TabIndex is what makes a plain tag reachable at all, and what FocusAsync then has to focus.
       Anywhere else the root drops it, splatted or not: a wrapper that takes focus of its own is a second tab
       stop on something the reader sees as one thing. A disabled tag is out of the tab order whatever was
       asked for, unless AllowDisabledFocus keeps it there. *@
    var tabIndexOnRoot = _isInteractive is false && OnDismiss.HasDelegate is false;
    var tabIndex = TabIndex ?? splattedTabIndex;
    var focusable = Disabled is false || AllowDisabledFocus;
    var rootTabIndex = tabIndexOnRoot && focusable ? tabIndex : null;

    @* A disabled control that keeps its focus reports the state through aria-disabled instead of the native
       disabled attribute, which would take it out of the tab order along with the pointer. *@
    var nativeDisabled = Disabled && AllowDisabledFocus is false;
    var ariaDisabled = Disabled is false || nativeDisabled ? null : "true";

    @* A natively disabled button never fires a click, but one that only says so through aria-disabled still
       does when Enter or Space presses it - and that click would bubble on to whatever holds the tag. The
       handler already ignores it; stopping it here keeps it from reaching anything else either. *@
    var stopClick = StopPropagation || Disabled;

    @* The name and the description follow the control the same way the tab index does: what the tag has of its
       own first, what came in with the attributes behind it, and both of them on the anchor or the button when
       the tag is one - a name left on a wrapper that has no role of its own is a name that may never be read. *@
    var label = AriaLabel ?? splattedLabel;

    @* An aria-labelledby names the control the same way, so it moves onto the anchor or the button along with
       the aria-label, and stays with the root only where there is no control to carry it. *@
    var controlLabelledBy = labelOnRoot ? null : splattedLabelledBy;

    @* The new-tab sentence lands wherever the name of the anchor comes from, the same way it does on every
       BitLink of the page - see BitNewTabUtils.PlaceHint. *@
    var hint = BitNewTabUtils.PlaceHint(_newTabHint, label, controlLabelledBy, $"{_Id}-nth");

    @* ARIA forbids naming an element with no role of its own, and most screen readers ignore an aria-label
       put there anyway, so a static tag never carries one: its name is text no one can see instead, and what
       the tag renders of its own that the name stands in for - the words and the picture's alt - is hidden
       from assistive technologies, which is exactly what an aria-label does to the content of a control. The
       markup the app hands in through ChildContent and the templates is left alone: the tag cannot see what
       is in it, and hiding a link or a button in there would leave the keyboard landing on something a
       screen reader cannot name. *@
    var hiddenLabel = labelOnRoot && label.HasValue();
    var ownContentHidden = hiddenLabel ? "true" : null;

    var describedBy = describedById is not null
                    ? (splattedDescribedBy.HasValue() ? $"{describedById} {splattedDescribedBy}" : describedById)
                    : splattedDescribedBy;

    @* A tag that is not a control but can be dismissed has one thing the keyboard lands on, its dismiss button,
       and a description left on the root alone - a span with no role, which never takes focus - is one a
       screen reader only reads while walking the page line by line. The button carries it as well, which is
       also where "what dismissing the tag will do" belongs. *@
    var rootDescribedBy = labelOnRoot ? describedBy : null;

    @* The keyboard shortcut of the dismiss button is the only reason the tag listens for a key at all, so
       nothing is listening on a tag that has nothing to dismiss - an empty callback still costs a round trip
       to the server on every keystroke of a Blazor Server app. *@
    var onKeyDown = OnDismiss.HasDelegate
                  ? EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleOnKeyDown)
                  : default;

    RenderFragment content =
        @<text>
            @if (selectedIcon is not null)
            {
                <i aria-hidden="true" style="@Styles?.SelectedIcon" class="bit-tag-sic @selectedIcon.GetCssClasses() @Classes?.SelectedIcon" />
            }

            @if (PrefixTemplate is not null)
            {
                @* The outermost leading position, ahead of the icon rather than in place of it: whatever the
                   tag needs there that a glyph or a picture cannot be - an avatar with initials, a colored
                   dot, a flag. It is not a slot the tag names anything by, so what it says has to be said in
                   the label or in the AriaLabel as well. *@
                @PrefixTemplate
            }

            @if (icon is not null)
            {
                <i aria-hidden="true" style="@Styles?.Icon" class="bit-tag-icn @icon.GetCssClasses() @Classes?.Icon" />
            }
            else if (IconUrl.HasValue())
            {
                @* The picture of what the tag stands for - an avatar, a flag, a logo. It is decorative next to
                   the label it sits beside, so it carries an empty alt unless one is given on purpose. *@
                <img src="@IconUrl" alt="@(IconAlt ?? string.Empty)" aria-hidden="@ownContentHidden" style="@Styles?.Image" class="bit-tag-img @Classes?.Image" />
            }

            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else if (hasLabel)
            {
                <span style="@Styles?.Label" class="bit-tag-lbl @Classes?.Label" aria-hidden="@ownContentHidden">
                    @if (Text.HasValue())
                    {
                        <span style="@Styles?.Text" class="bit-tag-tex @Classes?.Text">@Text</span>
                    }

                    @if (SecondaryText.HasValue())
                    {
                        <span style="@Styles?.SecondaryText" class="bit-tag-stx @Classes?.SecondaryText">@SecondaryText</span>
                    }
                </span>
            }

            @if (secondaryIcon is not null)
            {
                <i aria-hidden="true" style="@Styles?.SecondaryIcon" class="bit-tag-sci @secondaryIcon.GetCssClasses() @Classes?.SecondaryIcon" />
            }

            @if (SuffixTemplate is not null)
            {
                @* The mirror of the prefix: the outermost trailing position, after the trailing glyph and
                   still inside whatever the tag became, so it is part of the same target rather than a
                   control of its own. A count, a second avatar, a progress dot. *@
                @SuffixTemplate
            }
        </text>;
}

<span @ref="RootElement" @attributes="HtmlAttributes"
      id="@_Id"
      title="@(Title ?? splattedTitle)"
      style="@StyleBuilder.Value"
      class="@ClassBuilder.Value"
      aria-label="@((string?)null)"
      aria-labelledby="@(labelOnRoot ? splattedLabelledBy : null)"
      aria-describedby="@rootDescribedBy"
      tabindex="@rootTabIndex"
      dir="@Dir?.ToString().ToLower()">
    @if (hiddenLabel)
    {
        @* Ahead of the content rather than after it: this is the name of the tag, and a name read after the
           button that removes the tag is a name that arrives too late to say what was removed. *@
        <span class="bit-tag-vhd">@label</span>
    }

    @if (_isLink)
    {
        @* A tag that leads somewhere is a real anchor: it comes with the context menu, the middle click, the
           status bar and the announcement that every link of the page comes with, none of which a click
           handler on a span can reproduce. A disabled one drops the href, and with it the role of a link, which
           is given back explicitly so that its aria-disabled still has a link to describe; it leaves the tab
           order too, unless AllowDisabledFocus keeps it there - an anchor without an href only takes focus
           through a tabindex of its own. *@
        <a @ref="_contentRef"
           @onclick="HandleOnClick"
           @onclick:preventDefault="@(Disabled)"
           @onclick:stopPropagation="stopClick"
           @onkeydown="onKeyDown"
           style="@Styles?.Content"
           class="bit-tag-cnt bit-tag-int @Classes?.Content"
           href="@(Disabled ? null : Href)"
           role="@(Disabled ? "link" : null)"
           rel="@_rel"
           target="@Target"
           download="@Download"
           tabindex="@(Disabled ? (AllowDisabledFocus ? tabIndex ?? "0" : "-1") : tabIndex)"
           aria-disabled="@(Disabled ? "true" : null)"
           aria-current="@(Selected ? _AriaCurrentMap[AriaCurrent] : null)"
           aria-label="@hint.AriaLabel"
           aria-labelledby="@hint.AriaLabelledBy"
           aria-describedby="@describedBy">
            @content

            @if (hint.HintText is not null)
            {
                <span id="@hint.HintId" class="bit-tag-vhd">@hint.HintText</span>
            }
        </a>
    }
    else if (_isButton)
    {
        @* A tag that does something is a real button: it comes with the keyboard, the focus ring and the
           disabled semantics a span with an onclick handler would each have to reimplement. The dismiss
           button is its sibling rather than its child, since a control inside a button is a control no
           assistive technology can reach. *@
        <button @ref="_contentRef"
                @onclick="HandleOnClick"
                @onclick:stopPropagation="stopClick"
                @onkeydown="onKeyDown"
                style="@Styles?.Content"
                class="bit-tag-cnt bit-tag-int @Classes?.Content"
                type="button"
                tabindex="@tabIndex"
                disabled="@nativeDisabled"
                aria-disabled="@ariaDisabled"
                aria-pressed="@(_isToggle ? Selected.ToString().ToLower() : null)"
                aria-label="@label"
                aria-labelledby="@controlLabelledBy"
                aria-describedby="@describedBy">@content</button>
    }
    else
    {
        <span style="@Styles?.Content" class="bit-tag-cnt @Classes?.Content">@content</span>
    }

    @if (OnDismiss.HasDelegate)
    {
        var dismissIcon = BitIconInfo.From(DismissIcon, DismissIconName ?? "Cancel");
        var dismissLabel = GetDismissLabel(label);

        <button @ref="_dismissRef"
                @onclick="HandleOnDismissClick"
                @onclick:stopPropagation="true"
                @onkeydown="onKeyDown"
                style="@Styles?.DismissButton"
                class="bit-tag-cls @Classes?.DismissButton"
                type="button"
                title="@dismissLabel"
                tabindex="@tabIndex"
                disabled="@nativeDisabled"
                aria-disabled="@ariaDisabled"
                aria-label="@dismissLabel"
                aria-describedby="@rootDescribedBy">
            <i aria-hidden="true" style="@Styles?.DismissIcon" class="bit-tag-dsi @dismissIcon?.GetCssClasses() @Classes?.DismissIcon" />
        </button>
    }

    @if (describedById is not null)
    {
        <span id="@describedById" class="bit-tag-vhd">@AriaDescription</span>
    }
</span>
