@namespace Bit.BlazorUI
@inherits BitComponentBase

@{
    var hasPrimary = (PrimaryTemplate ?? ChildContent) is not null;
    var hasSecondary = SecondaryText.HasValue() || SecondaryTemplate is not null;
    var icon = BitIconInfo.From(Icon, IconName);
    var descriptionId = AriaDescription.HasValue() ? $"{_Id}-dsc" : null;

    // A null or false written over a splatted attribute removes that attribute rather than leaving it alone, so every
    // attribute a page can also write by hand is resolved against what it wrote (see BitComponentBase.GetSplattedAttribute)
    // instead of being overwritten with the parameter's null. The hyphenated aria-* names cannot reach the parameters
    // they mirror - Blazor matches an attribute to a parameter by name, and AriaLabel is not aria-label - so writing one
    // by hand is a real thing to do, and losing it would take a control's name or state with it.
    var formId = FormId ?? GetSplattedAttribute("form");
    var ariaLabel = AriaLabel ?? GetSplattedAttribute("aria-label");
    var ariaHidden = AriaHidden || GetSplattedAttribute("aria-hidden") is "true";
    var ariaBusy = IsLoading ? "true" : GetSplattedAttribute("aria-busy");
    var ariaDisabled = IsEnabled ? GetSplattedAttribute("aria-disabled") : "true";
    // aria-describedby is a list of ids, so the author's are kept beside the component's rather than replaced by it.
    var describedBy = string.Join(' ', new[] { GetSplattedAttribute("aria-describedby"), descriptionId }.Where(id => id.HasValue()));
    // An anchor loses its href when it is disabled or loading, and with it the implicit link role, so the role is put
    // back - unless the page gave the button a role of its own (a menuitem, a tab), which is the one it should keep.
    var anchorRole = GetSplattedAttribute("role") ?? (IsEnabled && IsLoading is false ? null : "link");
    // A floating button that can be dragged can also be moved with the arrow keys, which is the alternative
    // to the dragging that WCAG 2.2 SC 2.5.7 asks for. Naming the keys here is what tells a screen reader
    // user the alternative is there - nothing else on the button says so.
    var keyShortcuts = GetSplattedAttribute("aria-keyshortcuts")
                    ?? (Draggable && (Float || FloatAbsolute) ? "ArrowUp ArrowDown ArrowLeft ArrowRight" : null);
    var tabIndex = GetTabIndex(ariaHidden);
    // Autofocus follows the same rule as the tab order: a control hidden from assistive technologies, or a disabled one
    // that is not kept focusable, must not pull the focus on the first render - a hand-written autofocus included.
    var autoFocus = (AutoFocus || GetSplattedAttribute("autofocus") is not null) && ariaHidden is false && (IsEnabled || AllowDisabledFocus);
    // The two states whose click is ignored are also the two whose native default has to be suppressed: a disabled
    // button kept in the tab order (AllowDisabledFocus) carries no native disabled attribute, and a loading one is
    // only kept from the pointer by pointer-events - both would still submit their form on Enter without this.
    var suppressDefault = IsEnabled is false || (IsLoading && Reclickable is false);

    RenderFragment content = @<text>
        @if (icon is not null)
        {
            <i style="@Styles?.Icon" class="bit-btn-icn @icon.GetCssClasses() @Classes?.Icon" aria-hidden="true" />
        }
        else if (IconUrl.HasValue())
        {
            <img src="@IconUrl" alt="" style="@Styles?.Icon" class="bit-btn-icnu @Classes?.Icon" aria-hidden="true" />
        }

        @if (IconOnly is false && (hasPrimary || hasSecondary))
        {
            <div style="@Styles?.Container" class="bit-btn-tcn @Classes?.Container">
                @if (hasPrimary)
                {
                    <div style="@Styles?.Primary" class="bit-btn-prt @Classes?.Primary">
                        @(PrimaryTemplate ?? ChildContent)
                    </div>
                }

                @if (hasSecondary)
                {
                    <div style="@Styles?.Secondary" class="bit-btn-sct @Classes?.Secondary">
                        @if (SecondaryTemplate is not null)
                        {
                            @SecondaryTemplate
                        }
                        else
                        {
                            @SecondaryText
                        }
                    </div>
                }
            </div>
        }
    </text>;

    RenderFragment body = @<text>
        @if (_showLoading is false)
        {
            @content
        }
        else
        {
            @* Kept in the flow rather than removed so the box holds the size it had before the click, and kept
               visible to assistive technologies so the button's accessible name does not change while it works. *@
            <div style="@Styles?.HiddenContent" class="bit-btn-hcn @Classes?.HiddenContent">
                @content
            </div>

            @* Everything the loading state draws - the stock spinner and its label, or a LoadingTemplate in their
               place - is the visual half of it and is hidden from assistive technologies, so the content stacked
               underneath keeps the button's accessible name while it works. The label is announced from the live
               region below instead, heard as a change of state rather than read as part of that name. *@
            <div style="@Styles?.LoadingContainer" class="bit-btn-ldg @GetLabelPositionClass() @Classes?.LoadingContainer" aria-hidden="true">
                @if (LoadingTemplate is null)
                {
                    <div style="@Styles?.Spinner" class="bit-btn-spn @Classes?.Spinner"></div>
                    @if (LoadingLabel.HasValue())
                    {
                        <div style="@Styles?.LoadingLabel" class="bit-btn-lbl @Classes?.LoadingLabel">
                            @LoadingLabel
                        </div>
                    }
                }
                else
                {
                    @LoadingTemplate
                }
            </div>
        }
    </text>;
}

@if (Href.HasNoValue())
{
    <button @ref="RootElement" @attributes="HtmlAttributes" @onclick="HandleOnClick"
            @onclick:stopPropagation="StopPropagation"
            @onclick:preventDefault="suppressDefault"
            id="@_Id"
            style="@StyleBuilder.Value"
            class="@ClassBuilder.Value"
            type="@_buttonType.GetValue()"
            form="@formId"
            dir="@Dir?.ToString().ToLower()"
            disabled="@(IsEnabled is false && AllowDisabledFocus is false)"
            autofocus="@autoFocus"
            title="@Title"
            tabindex="@tabIndex"
            aria-label="@ariaLabel"
            aria-hidden="@(ariaHidden ? "true" : null)"
            aria-busy="@ariaBusy"
            aria-disabled="@ariaDisabled"
            aria-describedby="@(describedBy.HasValue() ? describedBy : null)"
            aria-keyshortcuts="@keyShortcuts">
        @body
    </button>
}
else
{
    <a @ref="RootElement" @attributes="HtmlAttributes" @onclick="HandleOnClick"
       @onclick:stopPropagation="StopPropagation"
       @onclick:preventDefault="suppressDefault"
       id="@_Id"
       rel="@_rel"
       style="@StyleBuilder.Value"
       class="@ClassBuilder.Value"
       dir="@Dir?.ToString().ToLower()"
       href="@(IsEnabled && IsLoading is false ? Href : null)"
       role="@anchorRole"
       autofocus="@autoFocus"
       title="@Title"
       target="@Target"
       download="@Download"
       tabindex="@tabIndex"
       aria-label="@ariaLabel"
       aria-hidden="@(ariaHidden ? "true" : null)"
       aria-busy="@ariaBusy"
       aria-disabled="@ariaDisabled"
       aria-describedby="@(describedBy.HasValue() ? describedBy : null)"
       aria-keyshortcuts="@keyShortcuts">
        @body
    </a>
}

@* Both of the screen-reader-only pieces are rendered as siblings of the button/anchor rather than inside it, so that
   neither joins its accessible name: the description is read after the name through aria-describedby, and the live
   region would otherwise be read as part of the name of the button it announces.
   The region is rendered from the first render rather than when the loading starts - a live region only announces
   what changes inside one already in the document - but a button given no loading label has nothing to announce,
   and one hidden from assistive technologies has no one to announce it to: aria-hidden on the button cannot reach
   a sibling, so the region is left out rather than left to speak for a button that is not there. *@
@if (ariaHidden is false && LoadingLabel.HasValue())
{
    <span class="bit-btn-sts" role="status">@(IsLoading ? LoadingLabel : null)</span>
}

@if (descriptionId is not null)
{
    <span id="@descriptionId" class="bit-btn-dsc">@AriaDescription</span>
}
