@namespace Bit.BlazorUI
@inherits BitComponentBase

@* Only the explicit Hidden takes the content of the footer out of reach (inert). A footer that the
   scroll slid away is still meant to be reachable: it brings itself back as soon as anything inside
   it takes the focus, and an inert footer can never receive that focus in the first place. *@
@{
    // A null written over a splatted attribute removes it, so an inert the page wrote by hand is kept while Hidden is off
    // (see BitComponentBase.GetSplattedAttribute).
    var ariaLabel = ResolveAriaLabel();
    var inert = Hidden || GetSplattedAttribute("inert") is not null;
}
<footer @ref=RootElement @attributes="HtmlAttributes"
        id="@_Id"
        inert="@inert"
        aria-label="@ariaLabel"
        style="@StyleBuilder.Value"
        class="@ClassBuilder.Value"
        dir="@Dir?.ToString().ToLower()">
    <div style="@Styles?.Container" class="bit-ftr-gut @Classes?.Container">
        @ChildContent
    </div>
</footer>
