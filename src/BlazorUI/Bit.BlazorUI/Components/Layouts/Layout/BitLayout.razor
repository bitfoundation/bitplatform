@namespace Bit.BlazorUI
@inherits BitComponentBase

@* Each section renders the element that carries its landmark role, and the nav panel and the aside are
   siblings of the main content rather than children of it, so "skip to main content" really does skip
   the navigation instead of landing in front of it. *@
<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     aria-label="@AriaLabel"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">
    <CascadingValue Value="Dir">
        @* A bare "#id" would be resolved against the base href of the app, which the router then reads as a
           navigation to another page. The href names this very page instead, so the link still works where
           nothing handles its click (static rendering), and the click handler moves the focus along with the
           scroll, which a plain fragment navigation handled by the router does not. *@
        @if (SkipLink)
        {
            <a href="@_SkipLinkHref"
               @onclick="HandleSkipLinkClick"
               @onclick:preventDefault
               style="@Styles?.SkipLink"
               class="bit-lyt-skp @Classes?.SkipLink">
                @(SkipLinkText ?? "Skip to main content")
            </a>
        }

        @if (_ShowHeader)
        {
            <header style="@Styles?.Header" class="bit-lyt-hdr @Classes?.Header">
                @Header
            </header>
        }

        <div style="@Styles?.Main" class="bit-lyt-man @Classes?.Main">
            @if (_ShowNavPanel)
            {
                <nav aria-label="@NavPanelAriaLabel" style="@_NavPanelStyle" class="bit-lyt-nmn @Classes?.NavPanel">
                    @NavPanel
                </nav>
            }

            @* A page may hold only one main landmark, so a layout nested inside another one renders the very
               same section as a plain div: it keeps its id, its classes and its place as the skip link target,
               and only stops claiming a landmark the page already has. *@
            @if (Nested)
            {
                <div id="@_MainId"
                     tabindex="@(SkipLink ? "-1" : null)"
                     style="@_MainContentStyle"
                     class="bit-lyt-mcn @Classes?.MainContent">
                    @Main
                </div>
            }
            else
            {
                <main id="@_MainId"
                      tabindex="@(SkipLink ? "-1" : null)"
                      style="@_MainContentStyle"
                      class="bit-lyt-mcn @Classes?.MainContent">
                    @Main
                </main>
            }

            @if (_ShowAside)
            {
                <aside aria-label="@AsideAriaLabel" style="@_AsideStyle" class="bit-lyt-asd @Classes?.Aside">
                    @Aside
                </aside>
            }
        </div>

        @if (_ShowFooter)
        {
            <footer style="@Styles?.Footer" class="bit-lyt-ftr @Classes?.Footer">
                @Footer
            </footer>
        }
    </CascadingValue>
</div>
