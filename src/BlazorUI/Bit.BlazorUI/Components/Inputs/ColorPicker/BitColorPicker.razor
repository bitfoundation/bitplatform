@namespace Bit.BlazorUI
@inherits BitComponentBase

@{
    var texts = _Texts;
    var disabled = _IsInputDisabled;
    var readOnly = _IsReadOnly;
    var eyeDropperIcon = BitIconInfo.From(EyeDropperIcon, EyeDropperIconName ?? "Eyedropper");
    var switchIcon = BitIconInfo.From(InputsModeSwitchIcon, InputsModeSwitchIconName ?? "Sort");
    var presetsStyle = PresetsPerRow > 0
                            ? $"--bit-clp-prs-cols:{PresetsPerRow};{Styles?.Presets}"
                            : Styles?.Presets;
    var contrast = ShowContrast ? _Contrast : 0;
    var contrastText = FormatContrast(contrast);
    var aaNormal = BitThemeColorContrast.MeetsWcagAaNormalText(contrast);
    var aaLarge = BitThemeColorContrast.MeetsWcagAaLargeText(contrast);
    @* The contrast readout describes the first widget the panel renders, so the verdict is read out with the
       control the user is standing on rather than waiting at the bottom of the panel to be found. Every part
       above the text fields is optional, so which one that is has to be worked out rather than assumed. *@
    var describes = ShowContrast ? _ContrastId : null;
    var sliders = ShowHueSlider || ShowAlphaSlider;
}

<div @ref="RootElement"
     @attributes="HtmlAttributes"
     id="@_Id"
     role="group"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()"
     aria-label="@(_AriaLabelledBy is null ? _AriaLabel : null)"
     aria-labelledby="@_AriaLabelledBy"
     aria-disabled="@(IsEnabled ? null : "true")">

    @* aria-readonly is not a state a "group" carries - it belongs to the widgets inside it, which is where
       the saturation slider and the native ranges declare it. *@

    @if (_HasLabel)
    {
        @* Not a label element: with no single input to point a "for" at, a label here would label nothing.
           The panel is named through aria-labelledby referencing this id instead. *@
        <div id="@_LabelId" style="@Styles?.LabelContainer" class="bit-clp-lbc @Classes?.LabelContainer">
            @if (LabelTemplate is not null)
            {
                @LabelTemplate
            }
            else
            {
                <span style="@Styles?.Label" class="bit-clp-lbl @Classes?.Label">@Label</span>
            }
        </div>
    }

    @* The saturation-brightness area is a two-dimensional control, which no ARIA role covers on its own:
       it is exposed as a slider over the saturation, named as a 2D slider so the arrangement is announced,
       with the brightness and the resulting hex carried in its value text. The arrow keys walk both axes,
       Shift and the Page keys move a tenth of the area at a time, and Home and End jump to the ends of
       the saturation axis. *@
    @if (ShowSaturationArea)
    {
        <div @ref="_saturationPickerRef"
             @onkeydown="HandleOnSaturationKeyDown"
             role="slider"
             aria-valuemin="0"
             aria-valuemax="100"
             tabindex="@_TabIndex"
             style="@_SaturationPickerStyle"
             aria-roledescription="@texts.SaturationAreaRoleDescription"
             aria-valuenow="@_SaturationValueNow"
             aria-valuetext="@_SaturationValueText"
             aria-label="@texts.SaturationAreaLabel"
             aria-readonly="@(readOnly ? "true" : null)"
             aria-describedby="@describes"
             aria-disabled="@(IsEnabled ? null : "true")"
             class="bit-clp-rec @Classes?.SaturationPicker">
            <div class="bit-clp-light"></div>
            <div class="bit-clp-dark"></div>
            <div class="bit-clp-thumb @Classes?.SaturationThumb" style="@_SaturationThumbStyle"></div>
        </div>
    }

    @* Only drawn where it has something to hold: a picker built without the gradient, the sliders, the
       eyedropper and the preview would otherwise keep the row's gap above the text fields. *@
    @if (sliders || _ShowEyeDropper || ShowPreview)
    {
        <div class="bit-clp-cnt @Classes?.Content" style="@Styles?.Content">
            @if (sliders)
            {
                <div class="bit-clp-sct @Classes?.Sliders" style="@Styles?.Sliders">
                    @if (ShowHueSlider)
                    {
                        <div class="bit-clp-sld bit-clp-hsd @Classes?.HueSlider" style="@Styles?.HueSlider">
                            @* A native range input, so the hue arrives with the whole keyboard contract of a slider -
                               arrows, Home, End, Page - and with the platform's own touch handling, for free. *@
                            <input @ref="_hueInputRef"
                                   @oninput="e => HandleOnHueInput(e, false)"
                                   @onchange="e => HandleOnHueInput(e, true)"
                                   min="0"
                                   max="360"
                                   step="1"
                                   type="range"
                                   aria-label="@texts.HueLabel"
                                   value="@_HueValue"
                                   tabindex="@_TabIndex"
                                   disabled="@disabled"
                                   style="@Styles?.SliderInput"
                                   class="bit-clp-inp @Classes?.SliderInput"
                                   aria-valuetext="@_HueValueText"
                                   aria-describedby="@(ShowSaturationArea ? null : describes)"
                                   aria-readonly="@(readOnly ? "true" : null)" />
                        </div>
                    }

                    @if (ShowAlphaSlider)
                    {
                        <div class="bit-clp-sld bit-clp-asd @Classes?.AlphaSlider"
                             style="@($"--bit-clp-alpha-clr:{_color.Rgb};{Styles?.AlphaSlider}")">
                            @* The transparency gradient is a layer of its own so that the checkerboard it is read
                               against stays in the stylesheet instead of being rebuilt on every render. *@
                            <div class="bit-clp-abg"></div>
                            <input @ref="_alphaSliderRef"
                                   @oninput="e => HandleOnAlphaInput(e, false)"
                                   @onchange="e => HandleOnAlphaInput(e, true)"
                                   min="0"
                                   max="1"
                                   step="0.01"
                                   type="range"
                                   aria-label="@texts.AlphaLabel"
                                   value="@_AlphaValue"
                                   tabindex="@_TabIndex"
                                   disabled="@disabled"
                                   style="@Styles?.SliderInput"
                                   class="bit-clp-inp @Classes?.SliderInput"
                                   aria-valuetext="@_AlphaValueText"
                                   aria-describedby="@(ShowSaturationArea || ShowHueSlider ? null : describes)"
                                   aria-readonly="@(readOnly ? "true" : null)" />
                        </div>
                    }
                </div>
            }

            @if (_ShowEyeDropper)
            {
                <button @onclick="HandleOnEyeDropperClick"
                        type="button"
                        disabled="@disabled"
                        tabindex="@(disabled ? "-1" : TabIndex)"
                        aria-disabled="@(readOnly ? "true" : null)"
                        style="@Styles?.EyeDropper"
                        title="@texts.EyeDropperLabel"
                        aria-label="@texts.EyeDropperLabel"
                        class="bit-clp-eyd @Classes?.EyeDropper">
                    <i aria-hidden="true"
                       style="@Styles?.EyeDropperIcon"
                       class="bit-clp-eyi @eyeDropperIcon?.GetCssClasses() @Classes?.EyeDropperIcon">
                    </i>
                </button>
            }

            @if (ShowPreview)
            {
                @* The color sits on a checkerboard so that a semi-transparent one reads as transparent rather
                   than as a lighter shade of whatever happens to be behind the picker. *@
                <div class="bit-clp-pre @Classes?.Preview" style="@Styles?.Preview" title="@_color.Rgba">
                    <div class="bit-clp-prc" style="@($"background-color:{_color.Rgba}")"></div>
                </div>
            }
        </div>
    }

    @if (ShowInputs)
    {
        <div class="bit-clp-inps @Classes?.Inputs" style="@Styles?.Inputs">
            @if (_ShowHexField)
            {
                <div class="bit-clp-fld bit-clp-fhx @Classes?.Field" style="@Styles?.Field">
                    @* Committed on change rather than on input, so a hex is read once it has been typed out
                       instead of the picker jumping around after every keystroke. *@
                    <input @ref="_hexInputRef"
                           @onchange="HandleOnHexInput"
                           type="text"
                           maxlength="9"
                           autocomplete="off"
                           spellcheck="false"
                           value="@_HexValue"
                           disabled="@disabled"
                           readonly="@readOnly"
                           tabindex="@(disabled ? "-1" : TabIndex)"
                           id="@($"{_Id}-hex")"
                           style="@Styles?.FieldInput"
                           class="bit-clp-fin @Classes?.FieldInput" />
                    <label for="@($"{_Id}-hex")" style="@Styles?.FieldLabel" class="bit-clp-flb @Classes?.FieldLabel">@texts.HexFieldLabel</label>
                </div>
            }

            @* Keyed by the mode, so moving from one set of channels to another replaces the fields rather
               than retitling them - which would leave the browser's own undo history, and any half-typed
               number, attached to a field that now means something else. *@
            @foreach (var (index, name, caption, title, value, max) in _ChannelFields)
            {
                <div @key="@($"{InputsMode}-{name}")" class="bit-clp-fld @Classes?.Field" style="@Styles?.Field">
                    <input @ref="_channelInputRefs[index]"
                           @onchange="e => HandleOnChannelInput(e, index)"
                           min="0"
                           step="1"
                           max="@max"
                           type="number"
                           title="@title"
                           value="@value"
                           autocomplete="off"
                           disabled="@disabled"
                           readonly="@readOnly"
                           tabindex="@(disabled ? "-1" : TabIndex)"
                           id="@($"{_Id}-{name}")"
                           style="@Styles?.FieldInput"
                           class="bit-clp-fin @Classes?.FieldInput" />
                    <label for="@($"{_Id}-{name}")" title="@title" style="@Styles?.FieldLabel" class="bit-clp-flb @Classes?.FieldLabel">@caption</label>
                </div>
            }

            @if (ShowAlphaSlider)
            {
                <div class="bit-clp-fld @Classes?.Field" style="@Styles?.Field">
                    <input @ref="_alphaInputRef"
                           @onchange="HandleOnAlphaFieldInput"
                           min="0"
                           max="100"
                           step="1"
                           type="number"
                           title="@texts.AlphaLabel"
                           autocomplete="off"
                           disabled="@disabled"
                           readonly="@readOnly"
                           value="@_AlphaPercentValue"
                           tabindex="@(disabled ? "-1" : TabIndex)"
                           id="@($"{_Id}-alpha")"
                           style="@Styles?.FieldInput"
                           class="bit-clp-fin @Classes?.FieldInput" />
                    <label for="@($"{_Id}-alpha")" title="@texts.AlphaLabel" style="@Styles?.FieldLabel" class="bit-clp-flb @Classes?.FieldLabel">@texts.AlphaFieldLabel</label>
                </div>
            }

            @if (ShowInputsModeSwitch)
            {
                @* Enabled wherever the picker itself is: it moves which numbers the color is being read as,
                   not the color, so a read-only picker has nothing to refuse about it. *@
                <div class="bit-clp-fld bit-clp-fsw @Classes?.Field" style="@Styles?.Field">
                    <button @onclick="HandleOnInputsModeSwitchClick"
                            type="button"
                            disabled="@(IsEnabled is false)"
                            tabindex="@(IsEnabled ? TabIndex : "-1")"
                            style="@Styles?.InputsModeSwitch"
                            title="@string.Format(texts.InputsModeFormat, _InputsModeLabel)"
                            aria-label="@string.Format(texts.InputsModeSwitchFormat, _InputsModeLabel)"
                            class="bit-clp-swb @Classes?.InputsModeSwitch">
                        <i aria-hidden="true"
                           style="@Styles?.InputsModeSwitchIcon"
                           class="bit-clp-swi @switchIcon?.GetCssClasses() @Classes?.InputsModeSwitchIcon">
                        </i>
                    </button>
                </div>
            }
        </div>
    }

    @if (ShowContrast)
    {
        @* Not a live region: the ratio moves on every frame of a drag, and a screen reader reading each one
           out would drown the picker it is describing. It is read when the user goes looking for it. *@
        <div id="@_ContrastId" class="bit-clp-cnr @Classes?.Contrast" style="@Styles?.Contrast">
            @* role="img" rather than a bare span: aria-label does not apply to a generic element, so the
               spelled-out readings below would be dropped by the very assistive technologies they are for. *@
            <span role="img"
                  style="@Styles?.ContrastRatio"
                  class="bit-clp-cnv @Classes?.ContrastRatio"
                  aria-label="@string.Format(texts.ContrastRatioFormat, contrastText)">@contrastText:1</span>
            @* Both bars, because a color that is fine for a heading is not necessarily fine for body text,
               and the whole point of showing the number here is to answer that before the page ships. *@
            <span role="img"
                  style="@Styles?.ContrastBadge"
                  class="bit-clp-cnb @(aaNormal ? "bit-clp-cnp" : "bit-clp-cnf") @Classes?.ContrastBadge"
                  aria-label="@string.Format(texts.ContrastAaFormat, aaNormal ? texts.ContrastPassLabel : texts.ContrastFailLabel)">@texts.ContrastAaBadge</span>
            <span role="img"
                  style="@Styles?.ContrastBadge"
                  class="bit-clp-cnb @(aaLarge ? "bit-clp-cnp" : "bit-clp-cnf") @Classes?.ContrastBadge"
                  aria-label="@string.Format(texts.ContrastAaLargeFormat, aaLarge ? texts.ContrastPassLabel : texts.ContrastFailLabel)">@texts.ContrastAaLargeBadge</span>
        </div>
    }

    @if (_Presets.Count > 0)
    {
        @* A toolbar rather than a plain group: a palette is a set of alternatives, so it takes one Tab to
           reach and the arrow keys to move within. A tab stop per swatch would put a thirty-color palette
           between the picker and everything after it on the page. *@
        <div @ref="_presetsRef"
             class="bit-clp-prs @(PresetsPerRow > 0 ? "bit-clp-prg" : null) @Classes?.Presets"
             style="@presetsStyle"
             role="toolbar"
             aria-label="@texts.PresetsLabel">
            @{
                var tabStop = _PresetTabStop;
                var presets = _Presets;
            }
            @* The index is copied into the loop body before anything closes over it: a for-loop variable is
               one variable shared by every iteration, so a handler capturing it directly would be handed the
               count rather than the swatch it belongs to. *@
            @for (var i = 0; i < presets.Count; i++)
            {
                var index = i;
                var preset = presets[index];
                var isSelected = IsPresetSelected(preset.Color);
                var presetStyle = $"--bit-clp-prt-clr:{preset.Css};{Styles?.Preset}";

                if (isSelected && Styles?.SelectedPreset is not null)
                {
                    presetStyle = $"{presetStyle};{Styles.SelectedPreset}";
                }

                <button @ref="_presetRefs[index]"
                        @onclick="() => HandleOnPresetClick(preset.Value)"
                        @onkeydown="e => HandleOnPresetsKeyDown(e, index)"
                        type="button"
                        title="@preset.Value"
                        disabled="@disabled"
                        aria-disabled="@(readOnly ? "true" : null)"
                        style="@presetStyle"
                        aria-label="@string.Format(texts.PresetLabelFormat, preset.Color.ColorDescription, preset.Value)"
                        tabindex="@(disabled || index != tabStop ? "-1" : TabIndex ?? "0")"
                        aria-pressed="@(isSelected ? "true" : "false")"
                        class="bit-clp-prt @(isSelected ? "bit-clp-prt-sel" : null) @Classes?.Preset @(isSelected ? Classes?.SelectedPreset : null)">
                </button>
            }
        </div>
    }
</div>
