@namespace Bit.BlazorUI
@inherits BitTextInputBase<TValue>
@typeparam TValue

@{
    var icon = BitIconInfo.From(Icon, IconName);
    var incrementIcon = BitIconInfo.From(IncrementIcon, IncrementIconName ?? "ChevronDownSmall bit-ico-r180");
    var decrementIcon = BitIconInfo.From(DecrementIcon, DecrementIconName ?? "ChevronDownSmall");
    var clearButtonIcon = BitIconInfo.From(ClearButtonIcon, ClearButtonIconName ?? "Cancel");

    // The spin buttons are icon-only, so they always need an accessible name.
    var incrementLabel = IncrementAriaLabel ?? "Increase value";
    var decrementLabel = DecrementAriaLabel ?? "Decrease value";

    // The buttons normally stay out of the tab order (the focused input is the spinbutton and already
    // handles the whole keyboard set). In HideInput mode there is no focusable input left, so they
    // become the only way to operate the component and must be reachable by keyboard.
    var spinTabIndex = HideInput ? 0 : -1;

    // A read-only field cannot be spun either, so the buttons say so instead of looking operable and
    // then doing nothing - the same reasoning that keeps the clear button hidden while read-only.
    var spinDisabled = IsEnabled is false || ReadOnly;

    // A value sitting on an explicit bound cannot be spun any further in that direction. The button is
    // marked aria-disabled (and styled accordingly) rather than given the disabled attribute, so that it
    // stays in the accessibility tree and keeps its focus - which matters in HideInput mode, where the
    // buttons are the only tab stops and losing focus on hitting the bound would strand the user.
    var incrementBlocked = spinDisabled is false && IsAtMax(CurrentValue);
    var decrementBlocked = spinDisabled is false && IsAtMin(CurrentValue);

    var incrementInoperable = spinDisabled || incrementBlocked;
    var decrementInoperable = spinDisabled || decrementBlocked;

    var incrementBlockedClass = incrementBlocked ? " bit-nfl-sbb" : "";
    var decrementBlockedClass = decrementBlocked ? " bit-nfl-sbb" : "";

}

<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">
    @if (Label.HasValue() || LabelTemplate is not null)
    {
        <div style="@Styles?.LabelContainer" class="bit-nfl-lct @Classes?.LabelContainer">
            @* The `for` is dropped in HideInput mode: it would point at a hidden input, which nothing can
               associate a label with. The two buttons are named by the group that references this label. *@
            @if (LabelTemplate is not null)
            {
                <label id="@_labelId" for="@(HideInput ? null : _inputId)">
                    @LabelTemplate
                </label>
            }
            else if (Label.HasValue())
            {
                <label id="@_labelId"
                       for="@(HideInput ? null : _inputId)"
                       style="@Styles?.Label"
                       class="bit-nfl-lbl @Classes?.Label">
                    @Label
                </label>
            }
        </div>
    }

    @* Without the input there is no element carrying the value and its name, so the two buttons are tied
       together into a group and the label of the field names the group instead. With the input present the
       box is a plain wrapper: naming it as well would have a screen reader read the field twice. And
       aria-labelledby takes precedence over aria-label, so the group points at the visible label only
       while no name of its own was given - the same rule LabelledBy applies to the input.
       Where the field sits in a set of them belongs on whatever is exposed: the input normally, but in
       HideInput mode the input is hidden from assistive technologies altogether and the group around it
       is all that is left to carry the position. *@
    <div title="@Title"
         @onclick="HandleOnInputContainerClick"
         style="@Styles?.InputContainer"
         class="bit-nfl-cnt@(HideInput ? " bit-nfl-hdi" : "") @Classes?.InputContainer"
         role="@(HideInput ? "group" : null)"
         aria-label="@(HideInput ? AriaLabel : null)"
         aria-labelledby="@(HideInput ? LabelledBy : null)"
         aria-setsize="@(HideInput ? AriaSetSize : null)"
         aria-posinset="@(HideInput ? AriaPositionInSet : null)">
        @if (PrefixTemplate is not null)
        {
            @PrefixTemplate
        }
        else if (Prefix.HasValue())
        {
            <div style="@Styles?.PrefixContainer" class="bit-nfl-pre @Classes?.PrefixContainer">
                <span id="@_prefixId" style="@Styles?.Prefix" class="@Classes?.Prefix">
                    @Prefix
                </span>
            </div>
        }

        @if (EffectiveMode == BitSpinButtonMode.Spread)
        {
            <button @ref="_buttonDecrement"
                    @onpointerup="HandleOnPointerUpOrOut"
                    @onpointerout="HandleOnPointerUpOrOut"
                    @onpointerdown="() => HandleOnPointerDown(false)"
                    @onpointerdown:preventDefault
                    @onkeydown="(e) => HandleOnButtonKeyDown(e, false)"
                    type="button"
                    tabindex="@spinTabIndex"
                    style="@Styles?.DecrementButton"
                    class="bit-nfl-sbn@(decrementBlockedClass) @Classes?.DecrementButton"
                    disabled="@spinDisabled"
                    title="@DecrementTitle"
                    aria-disabled="@(decrementInoperable ? "true" : null)"
                    aria-label="@decrementLabel">
                <span style="@Styles?.DecrementIconContainer" class="bit-nfl-aic @Classes?.DecrementIconContainer">
                    <i style="@Styles?.DecrementIcon"
                       aria-hidden="true"
                       class="bit-nfl-bic @decrementIcon?.GetCssClasses() @Classes?.DecrementIcon" />
                </span>
            </button>
        }

        @if (HideInput)
        {
            @* A hidden input only carries the value (e.g. for form posting); constraint, interaction
               and aria attributes have no effect on it. *@
            <input @ref="InputElement" @attributes="@InputHtmlAttributes"
                   form=""
                   name="@Name"
                   id="@_inputId"
                   value="@CurrentValueAsString"
                   disabled="@(IsEnabled is false)"
                   type="hidden" />
        }
        else
        {
            @* Two notes on the aria attributes below. aria-labelledby takes precedence over aria-label, so
               pointing at the visible label while a name of its own was given would quietly throw that name
               away - LabelledBy is what keeps the two from colliding, and the visible label goes on naming
               the input through the for/id pair either way. And the spinbutton role replaces the native role
               of the input, so the required state is written out rather than left to the required attribute
               that role supersedes. *@
            <input @ref="InputElement" @attributes="@InputHtmlAttributes"
                   @onblur="HandleOnBlur"
                   @onclick="HandleOnClick"
                   @onfocus="HandleOnFocus"
                   @onkeyup="HandleOnKeyUp"
                   @onkeydown="HandleOnKeyDown"
                   @onfocusin="HandleOnFocusIn"
                   @onfocusout="HandleOnFocusOut"
                   @onwheel="HandleOnMouseWheel"
                   @bind-value:get="@GetDisplayValueAsString()"
                   @bind-value:set="@HandleOnStringValueSet"
                   @bind-value:event="@(Immediate ? "oninput" : "onchange")"
                   form=""
                   name="@Name"
                   id="@_inputId"
                   readonly="@(ReadOnly || IsInputReadOnly)"
                   required="@Required"
                   style="@Styles?.Input"
                   autofocus="@AutoFocus"
                   inputmode="@_inputMode"
                   placeholder="@Placeholder"
                   aria-label="@AriaLabel"
                   aria-setsize="@AriaSetSize"
                   aria-posinset="@AriaPositionInSet"
                   aria-labelledby="@LabelledBy"
                   disabled="@(IsEnabled is false)"
                   class="bit-nfl-inp@(EffectiveMode == BitSpinButtonMode.Spread ? " bit-nfl-cin" : "") @Classes?.Input"
                   autocomplete="@(AutoComplete ?? "off")"
                   type="text"
                   role="spinbutton"
                   aria-valuemin="@GetAriaValueMin()"
                   aria-valuemax="@GetAriaValueMax()"
                   aria-describedby="@AriaDescribedBy"
                   aria-valuenow="@GetAriaValueNow()"
                   aria-valuetext="@GetAriaValueText()"
                   aria-invalid="@AriaInvalid"
                   aria-busy="@AriaBusy"
                   spellcheck="@SpellCheck"
                   autocorrect="@AutoCorrect"
                   autocapitalize="@AutoCapitalize"
                   enterkeyhint="@EffectiveEnterKeyHint"
                   aria-readonly="@AriaReadOnly"
                   aria-required="@AriaRequired"
                   aria-disabled="@AriaDisabled" />

            @if (ShowClearButton && ReadOnly is false && HasVisibleText())
            {
                <button @onclick="HandleOnClearButtonClick"
                        style="@Styles?.ClearButton"
                        class="bit-nfl-cbt @Classes?.ClearButton"
                        type="button"
                        tabindex="-1"
                        aria-label="@(ClearButtonAriaLabel ?? "Clear value")"
                        disabled="@(IsEnabled is false)">
                    @if (ClearButtonTemplate is not null)
                    {
                        @ClearButtonTemplate
                    }
                    else
                    {
                        <i style="@Styles?.ClearButtonIcon" class="@clearButtonIcon?.GetCssClasses() @Classes?.ClearButtonIcon" aria-hidden="true" />
                    }
                </button>
            }

        }

        @if (Loading)
        {
            @* The indicator is hidden from assistive technologies: what it means is already carried by the
               aria-busy of the input and announced by the live region at the end of the component. *@
            <div style="@Styles?.Loading"
                 class="bit-nfl-lod @Classes?.Loading"
                 aria-hidden="true">
                @if (LoadingTemplate is not null)
                {
                    @LoadingTemplate
                }
                else
                {
                    <BitSpinnerLoading Role="none" CustomSize="@LoadingSize" CustomColor="currentColor" />
                }
            </div>
        }

        @if (EffectiveMode == BitSpinButtonMode.Compact)
        {
            <span style="@Styles?.ButtonsContainer" class="bit-nfl-act @Classes?.ButtonsContainer">
                <button @ref="_buttonIncrement"
                        @onpointerup="HandleOnPointerUpOrOut"
                        @onpointerout="HandleOnPointerUpOrOut"
                        @onpointerdown="() => HandleOnPointerDown(true)"
                        @onpointerdown:preventDefault
                        @onkeydown="(e) => HandleOnButtonKeyDown(e, true)"
                        type="button"
                        tabindex="@spinTabIndex"
                        data-is-focusable="@(HideInput ? "true" : "false")"
                        style="@Styles?.IncrementButton"
                        class="bit-nfl-aup@(incrementBlockedClass) @Classes?.IncrementButton"
                        disabled="@spinDisabled"
                        title="@IncrementTitle"
                        aria-label="@incrementLabel"
                        aria-disabled="@(incrementInoperable ? "true" : null)">
                    <span style="@Styles?.IncrementIconContainer" class="bit-nfl-aic @Classes?.IncrementIconContainer">
                        <i style="@Styles?.IncrementIcon"
                           aria-hidden="true"
                           class="bit-nfl-bic @incrementIcon?.GetCssClasses() @Classes?.IncrementIcon" />
                    </span>
                </button>

                <button @ref="_buttonDecrement"
                        @onpointerup="HandleOnPointerUpOrOut"
                        @onpointerout="HandleOnPointerUpOrOut"
                        @onpointerdown="() => HandleOnPointerDown(false)"
                        @onpointerdown:preventDefault
                        @onkeydown="(e) => HandleOnButtonKeyDown(e, false)"
                        type="button"
                        tabindex="@spinTabIndex"
                        data-is-focusable="@(HideInput ? "true" : "false")"
                        style="@Styles?.DecrementButton"
                        class="bit-nfl-adn@(decrementBlockedClass) @Classes?.DecrementButton"
                        disabled="@spinDisabled"
                        title="@DecrementTitle"
                        aria-label="@decrementLabel"
                        aria-disabled="@(decrementInoperable ? "true" : null)">
                    <span style="@Styles?.DecrementIconContainer" class="bit-nfl-aic @Classes?.DecrementIconContainer">
                        <i style="@Styles?.DecrementIcon"
                           aria-hidden="true"
                           class="bit-nfl-bic @decrementIcon?.GetCssClasses() @Classes?.DecrementIcon" />
                    </span>
                </button>
            </span>
        }
        else if (EffectiveMode == BitSpinButtonMode.Inline)
        {
            <button @ref="_buttonDecrement"
                    @onpointerup="HandleOnPointerUpOrOut"
                    @onpointerout="HandleOnPointerUpOrOut"
                    @onpointerdown="() => HandleOnPointerDown(false)"
                    @onpointerdown:preventDefault
                    @onkeydown="(e) => HandleOnButtonKeyDown(e, false)"
                    type="button"
                    tabindex="@spinTabIndex"
                    style="@Styles?.DecrementButton"
                    class="bit-nfl-sbn@(decrementBlockedClass) @Classes?.DecrementButton"
                    disabled="@spinDisabled"
                    title="@DecrementTitle"
                    aria-disabled="@(decrementInoperable ? "true" : null)"
                    aria-label="@decrementLabel">
                <span style="@Styles?.DecrementIconContainer" class="bit-nfl-aic @Classes?.DecrementIconContainer">
                    <i style="@Styles?.DecrementIcon"
                       aria-hidden="true"
                       class="bit-nfl-bic @decrementIcon?.GetCssClasses() @Classes?.DecrementIcon" />
                </span>
            </button>

            <button @ref="_buttonIncrement"
                    @onpointerup="HandleOnPointerUpOrOut"
                    @onpointerout="HandleOnPointerUpOrOut"
                    @onpointerdown="() => HandleOnPointerDown(true)"
                    @onpointerdown:preventDefault
                    @onkeydown="(e) => HandleOnButtonKeyDown(e, true)"
                    type="button"
                    tabindex="@spinTabIndex"
                    style="@Styles?.IncrementButton"
                    class="bit-nfl-sbn@(incrementBlockedClass) @Classes?.IncrementButton"
                    disabled="@spinDisabled"
                    title="@IncrementTitle"
                    aria-disabled="@(incrementInoperable ? "true" : null)"
                    aria-label="@incrementLabel">
                <span style="@Styles?.IncrementIconContainer" class="bit-nfl-aic @Classes?.IncrementIconContainer">
                    <i style="@Styles?.IncrementIcon"
                       aria-hidden="true"
                       class="bit-nfl-bic @incrementIcon?.GetCssClasses() @Classes?.IncrementIcon" />
                </span>
            </button>
        }
        else if (EffectiveMode == BitSpinButtonMode.Spread)
        {
            <button @ref="_buttonIncrement"
                    @onpointerup="HandleOnPointerUpOrOut"
                    @onpointerout="HandleOnPointerUpOrOut"
                    @onpointerdown="() => HandleOnPointerDown(true)"
                    @onpointerdown:preventDefault
                    @onkeydown="(e) => HandleOnButtonKeyDown(e, true)"
                    type="button"
                    tabindex="@spinTabIndex"
                    style="@Styles?.IncrementButton"
                    class="bit-nfl-sbn@(incrementBlockedClass) @Classes?.IncrementButton"
                    disabled="@spinDisabled"
                    title="@IncrementTitle"
                    aria-disabled="@(incrementInoperable ? "true" : null)"
                    aria-label="@incrementLabel">
                <span style="@Styles?.IncrementIconContainer" class="bit-nfl-aic @Classes?.IncrementIconContainer">
                    <i style="@Styles?.IncrementIcon"
                       aria-hidden="true"
                       class="bit-nfl-bic @incrementIcon?.GetCssClasses() @Classes?.IncrementIcon" />
                </span>
            </button>
        }

        @if (icon is not null)
        {
            <i style="@Styles?.Icon"
               class="bit-nfl-lic @icon.GetCssClasses() @Classes?.Icon"
               role="@(IconAriaLabel.HasValue() ? "img" : null)"
               aria-label="@IconAriaLabel"
               aria-hidden="@(IconAriaLabel.HasValue() ? null : "true")" />
        }

        @if (SuffixTemplate is not null)
        {
            @SuffixTemplate
        }
        else if (Suffix.HasValue())
        {
            <div style="@Styles?.SuffixContainer" class="bit-nfl-suf @Classes?.SuffixContainer">
                <span id="@_suffixId" style="@Styles?.Suffix" class="@Classes?.Suffix">
                    @Suffix
                </span>
            </div>
        }
    </div>

    @if (HasErrorMessage)
    {
        @* What is wrong with the value is the first thing to read under the field, so it sits above the
           description. It carries no live role of its own - the region at the end of the component is what
           announces it, so it is never read out twice. *@
        <div id="@_errorId"
             style="@Styles?.ErrorMessageContainer"
             class="bit-nfl-erm @Classes?.ErrorMessageContainer">
            @if (ErrorMessageTemplate is not null)
            {
                @ErrorMessageTemplate
            }
            else
            {
                <span style="@Styles?.ErrorMessage" class="@Classes?.ErrorMessage">@ErrorMessage</span>
            }
        </div>
    }

    @if (HasDescription)
    {
        <div id="@_descriptionId"
             style="@Styles?.DescriptionContainer"
             class="bit-nfl-des @Classes?.DescriptionContainer">
            @if (DescriptionTemplate is not null)
            {
                @DescriptionTemplate
            }
            else
            {
                <span style="@Styles?.Description" class="@Classes?.Description">@Description</span>
            }
        </div>
    }

    @if (AriaDescription.HasValue())
    {
        @* aria-describedby takes an id reference, so the description text has to live in an element
           of its own. It is visually hidden and only exists for assistive technologies. *@
        <span id="@_ariaDescriptionId" class="bit-nfl-dsc">@AriaDescription</span>
    }

    @* A status rather than an alert: whatever it says must not steal the focus or interrupt what is being
       typed, only be announced once the reader is done with the current sentence. It is rendered whether or
       not it has anything to say, because a live region that arrives with its text already in it is the one
       thing screen readers are known to miss. *@
    <span role="status" class="bit-nfl-dsc">@LiveText</span>
</div>