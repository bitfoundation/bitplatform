@namespace Bit.BlazorUI
@inherits BitInputBase<string?>

<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     aria-label="@AriaLabel"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @{
        var hasLabel = LabelTemplate is not null || Label.HasValue();
        var hasDescription = DescriptionTemplate is not null || Description.HasValue();
    }

    @if (LabelTemplate is not null)
    {
        <label id="@_labelId"
               for="@_inputIds[0]"
               style="@Styles?.Label"
               class="bit-otp-lbl @Classes?.Label">
            @LabelTemplate
        </label>
    }
    else if (Label.HasValue())
    {
        <label id="@_labelId"
               for="@_inputIds[0]"
               style="@Styles?.Label"
               class="bit-otp-lbl @Classes?.Label">
            @Label
        </label>
    }

    @{
        var inputType = GetInputType();
        var inputMode = GetInputMode();
        var autoComplete = NoSmsAutoFill ? BitAutoCompleteValue.Off : BitAutoCompleteValue.OneTimeCode;
        var separatorInterval = Math.Max(1, SeparatorInterval);
        var hasSeparator = SeparatorTemplate is not null || Separator.HasValue();
    }
    @* The description is referenced by the group rather than by each input on purpose: an aria-describedby
       on every one of them would make a screen reader read the whole hint again at every single character
       of the code. *@
    <div role="group"
         style="@Styles?.InputsWrapper"
         class="bit-otp-iwr @Classes?.InputsWrapper"
         aria-label="@(hasLabel ? null : AriaLabel)"
         aria-labelledby="@(hasLabel ? _labelId : null)"
         aria-describedby="@(hasDescription ? _descriptionId : null)">
        @for (var i = 0; i < _length; i++)
        {
            int index = i;

            if (index > 0 && hasSeparator && index % separatorInterval == 0)
            {
                @* The two expressions are written back to back on purpose: a separator is a single glyph
                   most of the time, so any whitespace around it would show up right next to the code. *@
                <span aria-hidden="true"
                      style="@Styles?.Separator"
                      class="bit-otp-sep @Classes?.Separator">@(SeparatorTemplate is null ? Separator : null)@(SeparatorTemplate?.Invoke(index))</span>
            }

            @* No maxlength is rendered on purpose. Capping an input at a single character would make the
               browser truncate the code that an autofill (or a paste that the clipboard handler did not
               catch) writes into it, and it is exactly that whole chunk which is spread over the inputs. *@
            <input @ref="_inputRefs[index]" @attributes="InputHtmlAttributes"
                   @onpaste="e => HandleOnPaste(e, index)"
                   @oninput="e => HandleOnInput(e, index)"
                   @onfocusin="e => HandleOnFocusIn(e, index)"
                   @onkeydown="e => HandleOnKeyDown(e, index)"
                   @onfocusout="e => HandleOnFocusOut(e, index)"
                   type="@inputType"
                   autocorrect="off"
                   spellcheck="false"
                   readonly="@ReadOnly"
                   required="@Required"
                   autocapitalize="none"
                   id="@_inputIds[index]"
                   inputmode="@inputMode"
                   autocomplete="@autoComplete"
                   value="@GetInputValue(index)"
                   style="@GetInputStyles(index)"
                   class="@GetInputClasses(index)"
                   placeholder="@GetPlaceholder(index)"
                   aria-label="@GetInputAriaLabel(index)"
                   @* rendered after the splat of the InputHtmlAttributes on purpose, so that the error
                      state of the Invalid parameter reaches the inputs as well as the one a failing
                      validation puts into those attributes. *@
                   aria-invalid="@GetAriaInvalid()"
                   @* the input holding the first character of the code stays in the tab order whichever
                      way the row is laid out, since Tab addresses the code rather than the layout. *@
                   tabindex="@(SingleTabStop && index > 0 ? -1 : (int?)null)"
                   disabled="@(IsEnabled is false)" />
        }
    </div>

    @if (hasDescription)
    {
        <div id="@_descriptionId"
             style="@Styles?.Description"
             class="bit-otp-dsc @Classes?.Description">
            @if (DescriptionTemplate is not null)
            {
                @DescriptionTemplate
            }
            else
            {
                @Description
            }
        </div>
    }

    @if (Name.HasValue())
    {
        @* The value of an OTP input is the whole code, so it is posted as a single named field
           instead of one per input. A disabled component contributes nothing to the form, which is
           what disabling the hidden field reproduces. *@
        <input type="hidden"
               name="@Name"
               value="@CurrentValueAsString"
               disabled="@(IsEnabled is false)" />
    }
</div>
