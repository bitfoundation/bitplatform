@namespace Bit.BlazorUI
@inherits BitInputBase<TValue>
@typeparam TItem
@typeparam TValue

@{
    // A null written over a splatted attribute removes it, so every attribute a page can also write by hand is resolved
    // against what it wrote (see BitComponentBase.GetSplattedAttribute) instead of being overwritten with the null of the
    // parameter or of a state the group is not in. The radiogroup role and the orientation are the pattern's own. A
    // disabled group writes no aria-required at all, the page's included, for the reason IsRequired drops it.
    var ariaLabel = ResolveAriaLabel();
    var ariaRequired = Disabled ? null : (IsRequired ? "true" : GetSplattedAttribute("aria-required"));
    // A rejection by the cascading EditContext or by the app (Invalid, an error message) says "true"; otherwise the
    // attribute is left to what the page wrote.
    var ariaInvalid = IsInvalid ? "true" : GetSplattedAttribute("aria-invalid");
    var ariaReadOnly = ReadOnly ? "true" : GetSplattedAttribute("aria-readonly");
    var ariaDisabled = Disabled ? "true" : GetSplattedAttribute("aria-disabled");
}
@* The invalid state belongs to the choice as a whole, not to the option that happens to be focused,
   so the group carries the aria-invalid too and not only the individual radio inputs of the base class. *@
<div @ref="RootElement" @attributes="DisabledAwareHtmlAttributes"
     id="@_Id"
     role="radiogroup"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()"
     aria-label="@ariaLabel"
     aria-labelledby="@GetAriaLabelledBy()"
     aria-describedby="@GetAriaDescribedBy()"
     aria-required="@ariaRequired"
     aria-invalid="@ariaInvalid"
     aria-readonly="@ariaReadOnly"
     aria-disabled="@ariaDisabled"
     aria-orientation="@(Horizontal ? "horizontal" : "vertical")">

    @if (HasLabel)
    {
        @* Not a label element: with no single input to point a "for" at, a label here would label
           nothing; the group is named through aria-labelledby referencing this id instead. *@
        <div id="@_labelId"
             style="@Styles?.LabelContainer"
             class="@Classes?.LabelContainer">
            @if (LabelTemplate is not null)
            {
                @LabelTemplate
            }
            else
            {
                <span style="@Styles?.Label" class="bit-chg-lbl @Classes?.Label">@Label</span>
            }
        </div>
    }

    @if (HasDescription)
    {
        <div id="@_descriptionId"
             style="@Styles?.Description"
             class="bit-chg-gds @Classes?.Description">
            @if (DescriptionTemplate is not null)
            {
                @DescriptionTemplate
            }
            else
            {
                @Description
            }
        </div>
    }

    <div id="@_optionsContainerId" style="@Styles?.Container" class="bit-chg-cnt @Classes?.Container">
        @if (Options is not null || ChildContent is not null)
        {
            <CascadingValue Value="this" IsFixed="true">
                @(Options ?? ChildContent)
            </CascadingValue>
        }
        else
        {
            @for (int i = 0; i < _items.Count; i++)
            {
                var item = _items[i];
                <_BitChoiceGroupItem @key="@($"{UniqueId}-{i}")" Item="item" Index="i" ChoiceGroup="this" />
            }
        }
    </div>

    @* The error line sits right under the items, the way it sits right under the control of every other input; the
       description stays where it is, under the label. It carries no live role of its own - the region at the end of
       the component is what announces it, so it is never read out twice. *@
    @if (HasErrorMessage)
    {
        <div id="@_errorId" style="@Styles?.ErrorMessageContainer" class="bit-chg-erm @Classes?.ErrorMessageContainer">
            @if (ErrorMessageTemplate is not null)
            {
                @ErrorMessageTemplate
            }
            else
            {
                <span style="@Styles?.ErrorMessage" class="@Classes?.ErrorMessage">@ErrorMessage</span>
            }
        </div>
    }

    @if (HasErrorAriaLabel)
    {
        @* The text a template (or the forced state) is described by, which the template itself may not have at all.
           It is visually hidden: the template is what is seen, this is what is read. *@
        <span id="@_errorLabelId" class="bit-chg-vhd">@ErrorMessageAriaLabel</span>
    }

    @* A status rather than an alert: a rejected choice must not steal the focus or interrupt what is being read,
       only be announced once the reader is done with the current sentence. Once a group is wired for an error
       message it is rendered whether or not it has anything to say, because a live region that arrives with its
       text already in it is the one thing screen readers are known to miss.
       Only a new message is announced, not the same one again after another pick: the arrow keys pick an item at
       every step, and a reason that holds for each of them would be read out at each of them. The radios carry
       aria-invalid, so every step still says the choice is rejected. *@
    @if (_hasLiveRegion)
    {
        <span role="status" aria-live="polite" aria-atomic="true" class="bit-chg-vhd">@LiveText</span>
    }
</div>