@namespace Bit.BlazorUI
@inherits BitInputBase<TValue>
@typeparam TItem
@typeparam TValue

@{
    var errorMessage = ShownErrorMessage;
    var tabStop = TabStopIndex;
}

<div @ref="RootElement" @attributes="DisabledAwareHtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">
    @* Not a label element: a listbox is not a labelable element, so the label names it through aria-labelledby. *@
    @if (Label.HasValue())
    {
        <div id="@_labelId" style="@Styles?.Label" class="bit-lbx-lbl @Classes?.Label">@Label</div>
    }

    @* The listbox itself is no tab stop: the item the keyboard is on is (roving tabindex), so the browser moves the focus
       from item to item - and scrolls the one it lands on into view - while the keys are handled here, where they
       bubble up to. *@
    <ul @ref="_listRef"
        @attributes="InputHtmlAttributes"
        @onkeydown="HandleOnKeyDown"
        id="@_listId"
        role="listbox"
        aria-label="@(Label.HasValue() ? null : ResolveAriaLabel())"
        aria-labelledby="@(Label.HasValue() ? _labelId : null)"
        aria-multiselectable="@(MultiSelect ? "true" : null)"
        aria-required="@(Required ? "true" : null)"
        aria-readonly="@(ReadOnly ? "true" : null)"
        aria-disabled="@(Disabled ? "true" : null)"
        aria-invalid="@(IsInvalid ? "true" : null)"
        aria-describedby="@(errorMessage.HasValue() ? _errorId : null)"
        style="@GetListStyle()"
        class="bit-lbx-lst @Classes?.List">
        @for (var i = 0; i < _items.Count; i++)
        {
            var index = i;
            var item = _items[index];
            var selected = IsSelected(item);
            var disabled = Disabled || GetIsDisabled(item);
            var icon = GetIcon(item);
            var description = GetDescription(item);

            <li @key="GetItemKey(item, index)"
                @ref="_optionRefs[index]"
                @onclick="() => HandleOnItemClick(index)"
                id="@GetOptionId(index)"
                role="option"
                tabindex="@(Disabled is false && index == tabStop ? "0" : "-1")"
                title="@GetTitle(item)"
                aria-label="@GetAriaLabel(item)"
                aria-selected="@(selected ? "true" : "false")"
                aria-disabled="@(disabled ? "true" : null)"
                style="@GetItemStyle(item, selected)"
                class="@GetItemClass(item, selected, disabled)">
                @if (MultiSelect)
                {
                    <span aria-hidden="true" style="@Styles?.Check" class="bit-lbx-chk @Classes?.Check">
                        @if (selected)
                        {
                            <i class="bit-icon bit-icon--CheckMark" />
                        }
                    </span>
                }
                @if (icon is not null)
                {
                    <i aria-hidden="true" style="@Styles?.Icon" class="bit-lbx-ico @icon.GetCssClasses() @Classes?.Icon" />
                }
                <span class="bit-lbx-txc">
                    <span style="@Styles?.Text" class="bit-lbx-txt @Classes?.Text">@GetText(item)</span>
                    @if (description.HasValue())
                    {
                        <span style="@Styles?.Description" class="bit-lbx-dsc @Classes?.Description">@description</span>
                    }
                </span>
            </li>
        }
    </ul>

    @if (errorMessage.HasValue())
    {
        <div id="@_errorId" style="@Styles?.ErrorMessage" class="bit-lbx-err @Classes?.ErrorMessage">@errorMessage</div>
    }
</div>
