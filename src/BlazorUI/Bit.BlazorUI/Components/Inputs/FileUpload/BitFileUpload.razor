@namespace Bit.BlazorUI
@inherits BitInputBase<string?>

<div @ref="@RootElement" @attributes="DisabledAwareHtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @if (LabelTemplate is not null)
    {
        @LabelTemplate
    }
    else if (_ShowLabelButton)
    {
        @* A read-only file upload keeps its browse button focusable, as every read-only control keeps its place in
           the tab order, and says it is unavailable rather than taking it away. A failed validation is declared on
           the button too, since it is what the user operates: the input the value travels through is hidden. *@
        <button @ref="_labelRef"
                @onclick="Browse"
                type="button"
                id="@_buttonId"
                disabled="@(Disabled)"
                aria-disabled="@(Disabled || ReadOnly ? "true" : null)"
                aria-invalid="@(IsInvalid && Disabled is false ? "true" : null)"
                aria-label="@AriaLabel"
                aria-describedby="@(_HasDescription ? _descriptionId : null)"
                style="@Styles?.Label"
                class="bit-upl-lbl @Classes?.Label">
            @* the drop area is the one place a label reads better with a glyph than without, so it brings one
               of its own; anywhere else the icon is opt-in. the text beside it already names the button. *@
            @{ var labelIcon = BitIconInfo.From(LabelIcon, LabelIconName ?? (ShowDropArea ? "CloudUpload" : null)); }
            @if (labelIcon is { IsEmpty: false })
            {
                <i style="@Styles?.LabelIcon" class="bit-upl-lic @labelIcon.GetCssClasses() @Classes?.LabelIcon" aria-hidden="true" />
            }
            @Label
        </button>
    }

    @if (_HasDescription)
    {
        <div id="@_descriptionId" style="@Styles?.Description" class="bit-upl-dsc @Classes?.Description">
            @if (DescriptionTemplate is not null)
            {
                @DescriptionTemplate
            }
            else
            {
                @Description
            }
        </div>
    }

    <input @ref="_inputRef"
           @onchange="HandleOnChange"
           type="file"
           id="@InputId"
           class="bit-upl-fi"
           capture="@Capture"
           multiple="@Multiple"
           webkitdirectory="@Directory"
           disabled="@_NativeInputDisabled"
           aria-disabled="@(_NativeInputDisabled ? "true" : null)"
           aria-label="@AriaLabel"
           aria-labelledby="@(AriaLabel is null && _ShowLabelButton ? _buttonId : null)"
           aria-describedby="@(_HasDescription ? _descriptionId : null)"
           accept="@GetAcceptValue()" />

    @* a list whose every file has been removed renders nothing at all, so the list element itself goes
       away with them rather than staying behind as an empty landmark in the accessibility tree. *@
    @if (HideFileView is false && Files.Any(f => f.Status != BitFileUploadStatus.Removed))
    {
        @* the list is named, so that a screen reader user arriving at it is told what it holds rather than
           only that it is a list of so many items. *@
        <div role="list"
             aria-label="@(FileListAriaLabel.HasValue() ? FileListAriaLabel : null)"
             style="@Styles?.FileList"
             class="bit-upl-fl @Classes?.FileList">
            @* a removed file is not part of the list anymore, so it is left out of it here rather than
               leaving an empty listitem behind for a custom template that renders nothing for it. *@
            @foreach (var file in Files.Where(f => f.Status != BitFileUploadStatus.Removed))
            {
                if (FileViewTemplate is not null)
                {
                    @* the custom template is wrapped so that every child of the list keeps carrying a listitem role *@
                    <div @key="file.FileId" role="listitem">
                        @FileViewTemplate(file)
                    </div>
                }
                else
                {
                    <_BitFileUploadItem @key="file.FileId" FileUpload="this" Item="file" />
                }
            }
        </div>
    }

    @* the batch buttons stay where they are for as long as the list has files picked here, and the ones with
       nothing to act on right now are marked aria-disabled rather than taken out or natively disabled: the
       state changes on its own as uploads settle, and a focused button that vanished - or turned disabled -
       under the keyboard would drop the focus on the document body. *@
    @if (ShowBatchActions && _HasPickedFiles)
    {
        var canUploadAll = _CanUploadAll;
        var canCancelAll = _CanCancelAll;
        var canClear = _CanClear;
        <div style="@Styles?.BatchActions" class="bit-upl-bat @Classes?.BatchActions">
            @if (AutoUpload is false)
            {
                <button @onclick="HandleUploadAll"
                        type="button"
                        disabled="@(Disabled)"
                        aria-disabled="@(Disabled || ReadOnly || canUploadAll is false ? "true" : null)"
                        style="@Styles?.BatchActionButton"
                        class="bit-upl-bab @Classes?.BatchActionButton">
                    @UploadAllText
                </button>
            }
            <button @onclick="HandleCancelAll"
                    type="button"
                    disabled="@(Disabled)"
                    aria-disabled="@(Disabled || ReadOnly || canCancelAll is false ? "true" : null)"
                    style="@Styles?.BatchActionButton"
                    class="bit-upl-bab @Classes?.BatchActionButton">
                @CancelAllText
            </button>
            <button @onclick="HandleClear"
                    type="button"
                    disabled="@(Disabled)"
                    aria-disabled="@(Disabled || ReadOnly || canClear is false ? "true" : null)"
                    style="@Styles?.BatchActionButton"
                    class="bit-upl-bab @Classes?.BatchActionButton">
                @ClearText
            </button>
        </div>
    }

    <div role="status" aria-live="polite" aria-atomic="true" class="bit-upl-lvr">@_announcement</div>

    @* The value's carrier in a form - the names of the files of the value: what a post reads under Name and where
       the InputHtmlAttributes land. The native file input above cannot be it, since the list the component keeps
       (appended to, preloaded, uploaded, removed) is not the one the browser holds. It is nothing to land on, so it
       stays out of the tab order and the accessibility tree. Required deliberately stays off it: the native attribute
       on a control nobody can see makes the browser block the submit of the form over a message it cannot show
       anywhere, so being required is left to the validation rules of the model. *@
    <input @attributes="InputHtmlAttributes"
           type="text"
           name="@Name"
           tabindex="-1"
           aria-hidden="true"
           readonly="@ReadOnly"
           class="bit-input-hidden"
           disabled="@Disabled"
           aria-disabled="@GetInputAriaDisabled(Disabled)"
           value="@CurrentValueAsString" />
</div>
