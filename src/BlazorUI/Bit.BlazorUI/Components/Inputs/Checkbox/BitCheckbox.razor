@namespace Bit.BlazorUI
@inherits BitInputBase<bool>

@{
    // A null or false written over a splatted attribute removes that attribute rather than leaving it alone,
    // so every attribute InputHtmlAttributes can also carry is resolved against what it wrote (see
    // GetSplattedInputAttribute) instead of being overwritten with the parameter's null. The hyphenated
    // aria-* names cannot reach the parameters they mirror - Blazor matches an attribute to a parameter by
    // name, and AriaLabel is not aria-label - so writing one by hand is a real thing to do, and losing it
    // would take the control's name or its description with it.
    var ariaLabel = AriaLabel ?? GetSplattedInputAttribute("aria-label");
    var ariaControls = AriaControls ?? GetSplattedInputAttribute("aria-controls");
    var ariaLabelledby = AriaLabelledby ?? GetSplattedInputAttribute("aria-labelledby");
    var ariaSetSize = AriaSetSize?.ToString() ?? GetSplattedInputAttribute("aria-setsize");
    var ariaPositionInSet = AriaPositionInSet?.ToString() ?? GetSplattedInputAttribute("aria-posinset");

    // aria-describedby is a list of ids, so the author's are kept beside the component's rather than
    // replaced by them. The visible description comes before the screen-reader-only one, in the order the
    // two are read on the page.
    var describedBy = string.Join(' ', new[]
    {
        GetSplattedInputAttribute("aria-describedby"),
        HasDescription ? _descriptionId : null,
        AriaDescription.HasValue() ? _ariaDescriptionId : null,
        AriaDescribedby
    }.Where(id => id.HasValue()));

    // Autofocus must not pull the focus onto a control that cannot take it: a disabled checkbox is out of
    // the tab order altogether unless AllowDisabledFocus keeps it in.
    var autoFocus = AutoFocus && (IsEnabled || AllowDisabledFocus);

    // aria-disabled is not one of the boolean HTML attributes: written as a bool it would be rendered with
    // no value at all, which assistive technologies read as the default - that is, as not disabled. A busy
    // checkbox turns clicks away just like a disabled one does, so it says so here rather than leaving
    // assistive technologies to offer a change that never lands.
    // The three states below say "true" or leave the attribute to whatever the page wrote, rather than
    // writing a null that would take the page's own value down with it.
    var ariaDisabled = IsEnabled is false || IsLoading ? "true" : GetSplattedInputAttribute("aria-disabled");
    var ariaBusy = IsLoading ? "true" : GetSplattedInputAttribute("aria-busy");
    var ariaReadOnly = ReadOnly ? "true" : GetSplattedInputAttribute("aria-readonly");

    // A disabled checkbox kept in the tab order carries no native disabled attribute, so the two things that
    // attribute would otherwise do have to be done by hand: a disabled control is not serialized into its
    // form, and its required is not enforced. Left to the browser, an unchecked one would block the very
    // submit it is disabled from taking part in.
    var name = IsEnabled ? Name ?? GetSplattedInputAttribute("name") : null;

    // A read-only checkbox is serialized like any other, but the native required is dropped for the same
    // reason it is on a disabled one: an unchecked box nobody is allowed to check would refuse the submit
    // with a browser message asking for a click that does nothing. The requirement is still announced -
    // and still enforced by whatever validates the model - it just stops being a trap. So aria-required
    // stands in wherever the attribute was dropped, read-only or disabled alike: a disabled checkbox that
    // AllowDisabledFocus keeps in the tab order is still reached and still read out, and the one thing it
    // must not do is read out as optional. A busy checkbox turns clicks away for as long as it is busy, so
    // it drops the attribute for the same reason and gets it back with the state.
    var required = Required && IsEnabled && ReadOnly is false && IsLoading is false;
    var ariaRequired = Required && required is false ? "true" : GetSplattedInputAttribute("aria-required");

    // The mixed state of a native checkbox lives in its `indeterminate` DOM property, which is not an
    // attribute and cannot be rendered: it is pushed from JavaScript after the element exists. So until
    // that lands - and for good on a statically rendered page, and on a one-way bound Indeterminate the
    // browser clears on a click the component then refuses - the element the screen reader reads says
    // "not checked" while the box on the screen says "partially". aria-checked="mixed" is that same state
    // written in markup, which is what the HTML-in-ARIA rules allow it on a checkbox for.
    var ariaChecked = Indeterminate ? "mixed" : GetSplattedInputAttribute("aria-checked");

    // The glyph is decorative beside the state the input itself announces, so it is hidden from assistive
    // technologies - unless it was given a name of its own, which is an explicit ask for it to be read.
    // An empty box holds the check mark at zero opacity, to be previewed on hover rather than shown, and
    // a transparent element is still in the accessibility tree: naming it there would have the mark read
    // out while it is not on the screen. So the name only takes hold once there is a glyph to see.
    var iconIsShown = CurrentValue || Indeterminate || UncheckedIcon is not null || UncheckedIconName.HasValue();
    var iconIsNamed = CheckIconAriaLabel.HasValue() && iconIsShown;
}

@* stopping propagation on the root covers both the original label click and the click the label forwards to the input *@
<div @ref="RootElement" @attributes="HtmlAttributes"
     @onclick:stopPropagation="StopPropagation"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @* the input precedes the label so its focus-visible state can style the box through a sibling selector *@
    <input @ref="InputElement" @attributes="InputHtmlAttributes"
           @onblur="HandleOnBlur"
           @onfocus="HandleOnFocus"
           @onfocusin="HandleOnFocusIn"
           @onfocusout="HandleOnFocusOut"
           @onclick="@HandleOnCheckboxClick"
           @onclick:stopPropagation="StopPropagation"
           @onclick:preventDefault="@(IsEnabled is false || ReadOnly || IsLoading)"
           name="@name"
           id="@_inputId"
           type="checkbox"
           class="bit-chb-inp"
           value="@CurrentValueAsString"
           checked="@CurrentValue"
           required="@required"
           tabindex="@TabIndex"
           autofocus="@autoFocus"
           disabled="@(IsEnabled is false && AllowDisabledFocus is false)"
           aria-label="@ariaLabel"
           aria-checked="@ariaChecked"
           aria-required="@ariaRequired"
           aria-busy="@ariaBusy"
           aria-setsize="@ariaSetSize"
           aria-controls="@ariaControls"
           aria-disabled="@ariaDisabled"
           aria-readonly="@ariaReadOnly"
           aria-labelledby="@ariaLabelledby"
           aria-posinset="@ariaPositionInSet"
           aria-describedby="@(describedBy.HasValue() ? describedBy : null)" />

    <label title="@Title"
           for="@_inputId"
           style="@Styles?.Container"
           class="bit-chb-lbl @Classes?.Container">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            var icon = GetStateIcon();
            <div style="@Styles?.Box" class="bit-chb-box @Classes?.Box">
                @if (IsLoading)
                {
                    @* the spinner stands in for the glyph rather than beside it, so a busy checkbox keeps
                       the footprint it had - the state it is still in is carried by the box around it *@
                    <span aria-hidden="true" style="@Styles?.Spinner" class="bit-chb-spn @Classes?.Spinner"></span>
                }
                else
                {
                    <i role="@(iconIsNamed ? "img" : null)"
                       aria-hidden="@(iconIsNamed ? null : "true")"
                       aria-label="@(iconIsNamed ? CheckIconAriaLabel : null)"
                       style="@Styles?.Icon"
                       class="bit-chb-ico @(icon is null && Indeterminate ? "bit-chb-idi" : null) @icon?.GetCssClasses() @Classes?.Icon" />
                }
            </div>

            @if (LabelTemplate is not null)
            {
                @* The template is wrapped rather than rendered bare, so that a templated label is still what
                   the required asterisk hangs on and what NoWrap clamps - the same two things a plain one is. *@
                <span style="@Styles?.Label" class="bit-chb-tpl @Classes?.Label">
                    @LabelTemplate
                </span>
            }
            else if (Label.HasValue())
            {
                <span style="@Styles?.Label" class="bit-chb-txt bit-nts @Classes?.Label">
                    @Label
                </span>
            }
        }
    </label>

    @* A line of its own under the checkbox: rendered outside the label, so it describes the checkbox through
       aria-describedby instead of leaking into the accessible name the way content inside it would - and so
       that selecting the sentence does not toggle the box it explains. *@
    @if (HasDescription)
    {
        <div id="@_descriptionId" style="@Styles?.Description" class="bit-chb-des @Classes?.Description">
            @if (DescriptionTemplate is not null)
            {
                @DescriptionTemplate
            }
            else
            {
                @Description
            }
        </div>
    }

    @* rendered as a sibling of the input so the description drives aria-describedby without leaking into the accessible name *@
    @if (AriaDescription.HasValue())
    {
        <span id="@_ariaDescriptionId" class="bit-chb-dsc">@AriaDescription</span>
    }
</div>
