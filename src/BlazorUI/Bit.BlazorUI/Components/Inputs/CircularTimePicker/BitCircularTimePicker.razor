@namespace Bit.BlazorUI
@inherits BitInputBase<TimeSpan?>

<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @if (LabelTemplate is not null)
    {
        <label id="@_labelId" for="@_inputId">
            @LabelTemplate
        </label>
    }
    else if (Label.HasValue())
    {
        <label style="@Styles?.Label" class="bit-ctp-lbl @Classes?.Label" id="@_labelId" for="@_inputId">
            @Label
        </label>
    }

    @if (Standalone is false)
    {
        <div style="@Styles?.InputWrapper" class="bit-ctp-wrp @Classes?.InputWrapper" id="@_circularTimePickerId" aria-owns="@(IsOpen ? _calloutId : null)" @onclick="HandleOnClick">
            <div style="@Styles?.InputContainer" class="bit-ctp-icn @Classes?.InputContainer">
                <input @ref="InputElement" @attributes="InputHtmlAttributes"
                       @onfocus="@HandleOnFocus"
                       @oninput="@HandleOnChange"
                       @onfocusin="@HandleOnFocusIn"
                       @onfocusout="@HandleOnFocusOut"
                       @onkeydown="@HandleOnInputKeyDown"
                       type="text"
                       name="@Name"
                       id="@_inputId"
                       role="combobox"
                       required="@Required"
                       tabindex="@TabIndex"
                       aria-haspopup="dialog"
                       aria-label="@AriaLabel"
                       placeholder="@Placeholder"
                       value="@CurrentValueAsString"
                       disabled=@(IsEnabled is false)
                       readonly=@(AllowTextInput is false || ReadOnly)
                       aria-readonly="@(ReadOnly ? "true" : null)"
                       aria-expanded="@(IsOpen ? "true" : "false")"
                       aria-controls="@(IsOpen ? _calloutId : null)"
                       aria-labelledby="@(Label.HasValue() || LabelTemplate is not null ? _labelId : null)"
                       style="@Styles?.Input"
                       class="bit-ctp-inp@(AllowTextInput ? " bit-ctp-ein" : "") @Classes?.Input" />

                @if (IconTemplate is not null)
                {
                    @IconTemplate
                }
                else
                {
                    var icon = BitIconInfo.From(Icon, IconName ?? "Clock");
                    <i style="@Styles?.Icon" class="bit-ctp-ico @icon?.GetCssClasses() @Classes?.Icon" aria-hidden="true" />
                }
            </div>
        </div>
    }
    else
    {
        <input @ref="InputElement" @attributes="InputHtmlAttributes"
               type="text"
               name="@Name"
               id="@_inputId"
               aria-label="@AriaLabel"
               class="bit-input-hidden"
               value="@CurrentValueAsString"
               disabled="@(IsEnabled is false)"
               readonly="@(AllowTextInput is false || ReadOnly)" />
    }

</div>

@if (Standalone is false)
{
    <div @onclick="CloseCallout"
         id="@_overlayId"
         style="display:@(IsOpen ? "block" : "none"); @Styles?.Overlay"
         class="bit-ctp-ovl @Classes?.Overlay"></div>
}

@*
    The callout is a sibling of the root instead of a child of it, so it carries the direction of the
    component itself - without it, everything inside would fall back to the direction of the page.
*@
<div id="@_calloutId"
     style="@Styles?.Callout"
     class="@GetCalloutCssClasses()"
     dir="@Dir?.ToString().ToLower()">
    <div @attributes=@CalloutHtmlAttributes
         role="dialog"
         aria-label="@CalloutAriaLabel"
         style="@Styles?.CalloutContainer"
         class="bit-ctp-cac @Classes?.CalloutContainer">
        @*
            The dial moving from one part of the time to the next is a change a sighted person reads off the
            toolbar. Nothing carries it to a screen reader on its own - the focus stays on the same listbox
            throughout - so the name of the part the dial is now on is announced from here. Only a change of
            the text is announced, which is exactly a change of the view.
        *@
        <div aria-live="polite" aria-atomic="true" class="bit-ctp-lvr">@ViewTitle</div>
        @*
            The meridiem pair goes either beside the time in the toolbar or under the clock, so it is built
            once here and dropped into whichever of the two AmPmInClock asks for.
        *@
        @{
            RenderFragment amPmButtons =@<div style="@Styles?.AmPmContainer"
                                              class="bit-ctp-apc@(AmPmInClock ? " bit-ctp-apk" : "") @Classes?.AmPmContainer">
                @{
                    var isAm = IsAm();
                }
                <button @onclick="HandleOnAmClick"
                        type="button"
                        title="@_culture.DateTimeFormat.AMDesignator"
                        aria-pressed="@(isAm ? "true" : "false")"
                        style="@GetAmButtonStyle(isAm)"
                        disabled="@(IsEnabled is false)"
                        class="bit-ctp-apb @(isAm ? $"bit-ctp-aps {Classes?.SelectedButtons}" : "bit-ctp-ina") @Classes?.AmButton">
                    @_culture.DateTimeFormat.AMDesignator
                </button>
                <button @onclick="HandleOnPmClick"
                        type="button"
                        title="@_culture.DateTimeFormat.PMDesignator"
                        aria-pressed="@(isAm ? "false" : "true")"
                        style="@GetPmButtonStyle(isAm)"
                        disabled="@(IsEnabled is false)"
                        class="bit-ctp-apb @(isAm ? "bit-ctp-ina" : $"bit-ctp-aps {Classes?.SelectedButtons}") @Classes?.PmButton">
                    @_culture.DateTimeFormat.PMDesignator
                </button>
            </div>;
        }
        <div style="@Styles?.Toolbar"
             class="bit-ctp-tlb @Classes?.Toolbar">
            <div style="@Styles?.HourMinuteContainer"
                 class="bit-ctp-hmc @Classes?.HourMinuteContainer">
                @if (EditMode == BitCircularTimePickerEditMode.Normal)
                {
                    @*
                        The name of a toolbar button carries the part it switches to and the value it is showing:
                        the title alone would leave a screen reader saying "select hour" on a button that reads
                        "07", and the number alone would not say what pressing it does.
                    *@
                    <button @onclick="HandleOnHourClick"
                            type="button"
                            title="@HourButtonTitle"
                            aria-label="@($"{HourButtonTitle} {GetHourString()}")"
                            aria-pressed="@(IsHourView ? "true" : "false")"
                            style="@GetHourButtonStyle()"
                            disabled="@(IsEnabled is false)"
                            class="bit-ctp-txt @(IsHourView ? Classes?.SelectedButtons : "bit-ctp-ina") @Classes?.HourButton">
                        @GetHourString()
                    </button>
                    <span style="@Styles?.HourMinuteSeparator"
                          aria-hidden="true"
                          class="bit-ctp-txt bit-ctp-sep @Classes?.HourMinuteSeparator">:</span>
                    <button @onclick="HandleOnMinuteClick"
                            type="button"
                            title="@MinuteButtonTitle"
                            aria-label="@($"{MinuteButtonTitle} {GetMinuteString()}")"
                            aria-pressed="@(IsMinuteView ? "true" : "false")"
                            style="@GetMinuteButtonStyle()"
                            disabled="@(IsEnabled is false)"
                            class="bit-ctp-txt @(IsMinuteView ? Classes?.SelectedButtons : "bit-ctp-ina") @Classes?.MinuteButton">
                        @GetMinuteString()
                    </button>
                    @if (HasSeconds)
                    {
                        <span style="@Styles?.HourMinuteSeparator"
                              aria-hidden="true"
                              class="bit-ctp-txt bit-ctp-sep @Classes?.HourMinuteSeparator">:</span>
                        <button @onclick="HandleOnSecondClick"
                                type="button"
                                title="@SecondButtonTitle"
                                aria-label="@($"{SecondButtonTitle} {GetSecondString()}")"
                                aria-pressed="@(IsSecondView ? "true" : "false")"
                                style="@GetSecondButtonStyle()"
                                disabled="@(IsEnabled is false)"
                                class="bit-ctp-txt @(IsSecondView ? Classes?.SelectedButtons : "bit-ctp-ina") @Classes?.SecondButton">
                            @GetSecondString()
                        </button>
                    }
                }
                else
                {
                    <span style="@Styles?.HourMinuteText" class="bit-ctp-txt @Classes?.HourMinuteText">@GetTimeString()</span>
                }
            </div>
            @if (TimeFormat == BitTimeFormat.TwelveHours && AmPmInClock is false)
            {
                @amPmButtons
            }
        </div>
        <div style="@Styles?.ClockContainer" class="bit-ctp-clk @Classes?.ClockContainer">
            @*
                A listbox rather than a plain drawing: the numbers are the options of the current view and the
                pointer is the selection, which is what lets a screen reader read out what the dial is on and
                the keyboard move it without every number having to be a tab stop of its own.
            *@
            <div @ref="_clockRef"
                 @onkeydown="HandleOnClockKeyDown"
                 @onwheel="HandleOnClockWheel"
                 @onfocus="@(() => _clockHasFocus = true)"
                 @onblur="@(() => _clockHasFocus = false)"
                 id="@_clockId"
                 role="listbox"
                 tabindex="@(IsEnabled ? 0 : -1)"
                 data-bit-wheel="@(IsWheelSpinEnabled ? "1" : null)"
                 aria-label="@ViewTitle"
                 aria-disabled="@(IsEnabled ? null : "true")"
                 aria-readonly="@(ReadOnly ? "true" : null)"
                 aria-activedescendant="@_activeDescendantId"
                 style="@Styles?.ClockFace"
                 class="bit-ctp-clf @Classes?.ClockFace">
                <div style="@Styles?.ClockPin" aria-hidden="true" class="bit-ctp-pin @Classes?.ClockPin"></div>

                @if (IsHourView)
                {
                    if (TimeFormat == BitTimeFormat.TwelveHours)
                    {
                        var isAmHalf = IsAm();
                        for (int i = 1; i <= 12; i++)
                        {
                            var hour = isAmHalf ? i % 12 : (i % 12) + 12;
                            <span id="@GetNumberId(hour)"
                                  role="option"
                                  aria-selected="@(IsSelected(hour) ? "true" : "false")"
                                  aria-disabled="@(IsSelectable(hour) ? null : "true")"
                                  style="@GetNumberStyle(hour, i)"
                                  class="bit-ctp-num @GetNumberClass(hour)">@i</span>
                        }
                    }
                    else
                    {
                        @*Hours from 13 to 23 and 00 on the outer ring*@
                        for (int i = 1; i <= 12; i++)
                        {
                            var hour = (i + 12) % 24;
                            <span id="@GetNumberId(hour)"
                                  role="option"
                                  aria-selected="@(IsSelected(hour) ? "true" : "false")"
                                  aria-disabled="@(IsSelectable(hour) ? null : "true")"
                                  style="@GetNumberStyle(hour, i)"
                                  class="bit-ctp-num @GetNumberClass(hour)">@(hour.ToString("D2"))</span>
                        }
                        @*Hours from 01 to 12 on the inner ring*@
                        for (int i = 1; i <= 12; i++)
                        {
                            <span id="@GetNumberId(i)"
                                  role="option"
                                  aria-selected="@(IsSelected(i) ? "true" : "false")"
                                  aria-disabled="@(IsSelectable(i) ? null : "true")"
                                  style="@GetNumberStyle(i, i)"
                                  class="bit-ctp-num bit-ctp-inn @GetNumberClass(i)">@(i.ToString("D2"))</span>
                        }
                    }
                }
                else
                {
                    @*The minute and the second rings are the same twelve five-unit marks*@
                    @for (int i = 0; i < 12; i++)
                    {
                        var value = i * 5;
                        <span id="@GetNumberId(value)"
                              role="option"
                              aria-selected="@(IsSelected(value) ? "true" : "false")"
                              aria-disabled="@(IsSelectable(value) ? null : "true")"
                              style="@GetNumberStyle(value, i)"
                              class="bit-ctp-num @GetNumberClass(value)">@(value.ToString("D2"))</span>
                    }
                }

                @{
                    var deg = GetPointerDegree();
                    // A hand that rests on a whole mark lands on a number, so it carries the filled disc that
                    // reads as the selection; in between - a minute or a second with no number of its own - it
                    // shrinks to the small ring that marks the spot without covering it. A part that has not
                    // been picked at all takes that same ring: the hand has to rest somewhere, and the filled
                    // disc would claim a selection the toolbar is reading out as "--".
                    var isOnNumber = CurrentPart.HasValue && deg % 30 == 0;
                }
                <div style="@GetClockPointerStyle(deg)"
                     aria-hidden="true"
                     class="@GetClockPointerClass()">
                    <div style="@GetClockPointerThumbStyle(isOnNumber)"
                         class="bit-ctp-pth@(isOnNumber ? "" : $" bit-ctp-ptm {Classes?.ClockPointerThumbMinute}") @Classes?.ClockPointerThumb"></div>
                </div>
            </div>
        </div>

        @if (TimeFormat == BitTimeFormat.TwelveHours && AmPmInClock)
        {
            @amPmButtons
        }

        @if (HasActions)
        {
            <div style="@Styles?.Actions" class="bit-ctp-act @Classes?.Actions">
                @if (ShowNowButton)
                {
                    <button @onclick="HandleOnNowClick"
                            type="button"
                            style="@Styles?.NowButton"
                            class="bit-ctp-abn @Classes?.NowButton"
                            disabled="@(IsInteractive is false)">
                        @NowButtonText
                    </button>
                }
                @if (ShowClearButton)
                {
                    <button @onclick="HandleOnClearClick"
                            type="button"
                            style="@Styles?.ClearButton"
                            class="bit-ctp-abn @Classes?.ClearButton"
                            disabled="@(IsInteractive is false || CurrentValue.HasValue is false)">
                        @ClearButtonText
                    </button>
                }
            </div>
        }

        @if (ShowCloseButton && Standalone is false)
        {
            var closeButtonIcon = BitIconInfo.From(CloseButtonIcon, CloseButtonIconName ?? "Cancel");
            <button @onclick="CloseCallout"
                    type="button"
                    style="@Styles?.CloseButton"
                    class="bit-ctp-cbn @Classes?.CloseButton"
                    title="@CloseButtonTitle"
                    aria-label="@CloseButtonTitle">
                <i style="@Styles?.CloseButtonIcon" class="bit-ctp-cbi @closeButtonIcon?.GetCssClasses() @Classes?.CloseButtonIcon" aria-hidden="true" />
            </button>
        }
    </div>
</div>
