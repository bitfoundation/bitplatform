@namespace Bit.BlazorUI
@inherits BitInputBase<TValue>
@typeparam TItem
@typeparam TValue

@{
    var chipsRemoveIconCss = BitIconInfo.From(ChipsRemoveIcon, ChipsRemoveIconName ?? "Cancel")?.GetCssClasses();
    var clearButtonIconCss = BitIconInfo.From(ClearButtonIcon, ClearButtonIconName ?? "Cancel")?.GetCssClasses();
    var caretDownIconCss = BitIconInfo.From(CaretDownIcon, CaretDownIconName ?? "ChevronRight bit-ico-r90")?.GetCssClasses();
    var responsiveCloseIconCss = BitIconInfo.From(ResponsiveCloseIcon, ResponsiveCloseIconName ?? "Cancel")?.GetCssClasses();
    var searchBoxIconCss = BitIconInfo.From(SearchBoxIcon, SearchBoxIconName ?? "Search")?.GetCssClasses();
    var searchBoxClearIconCss = BitIconInfo.From(SearchBoxClearIcon, SearchBoxClearIconName ?? "Cancel")?.GetCssClasses();
    var comboBoxAddButtonIconCss = BitIconInfo.From(ComboBoxAddButtonIcon, ComboBoxAddButtonIconName ?? "Add")?.GetCssClasses();
    var itemCheckIconCss = GetItemCheckIconCss();

    RenderFragment emptyContent =
        @<div style="@Styles?.EmptyContent" class="bit-drp-emp @Classes?.EmptyContent">
            @if (HasSearchText && (NoResultsTemplate is not null || NoResultsText.HasValue()))
            {
                @if (NoResultsTemplate is not null)
                {
                    @NoResultsTemplate
                }
                else
                {
                    @NoResultsText
                }
            }
            else if (EmptyTemplate is not null)
            {
                @EmptyTemplate
            }
            else
            {
                @(EmptyText ?? (HasSearchText ? "No results found" : "No items found"))
            }
        </div>;

    RenderFragment loadingContent =
        @<div style="@Styles?.LoadingContainer" class="bit-drp-ldc @Classes?.LoadingContainer" role="status" aria-live="polite">
            @if (LoadingTemplate is not null)
            {
                @LoadingTemplate
            }
            else
            {
                <div style="@Styles?.Spinner" class="bit-drp-spn @Classes?.Spinner"></div>
                <span style="@Styles?.LoadingText" class="@Classes?.LoadingText">@(LoadingText ?? "Loading...")</span>
            }
        </div>;
}

@if ((Virtualize || IsLoading) && (Options ?? ChildContent) is not null)
{
    @* In virtualize mode the items have to be rendered from the (registered) Items collection, and while
       loading the callout shows the loading content instead of them, so the options only register
       themselves here without rendering their items in place. Keeping them mounted (rather than dropping
       them from the tree) preserves both the registration and the markup order of the items. *@
    <CascadingValue Value="this" IsFixed="true">
        <div style="display:none" hidden>@(Options ?? ChildContent)</div>
    </CascadingValue>
}

<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()"
     aria-owns="@(IsOpen? _scrollContainerId : null)">
    @if (LabelTemplate is not null)
    {
        <label id="@_labelId">
            @LabelTemplate
        </label>
    }
    else if (Label.HasValue())
    {
        <label style="@Styles?.Label" class="bit-drp-lbl @Classes?.Label" id="@_labelId">
            @Label
        </label>
    }

    <div @ref="_dropdownWrapperRef"
         @onclick="HandleOnClick"
         @onkeydown="HandleOnTriggerKeyDown"
         title="@Title"
         role="combobox"
         id="@_dropdownId"
         style="@Styles?.Container"
         class="bit-drp-wrp @Classes?.Container"
         tabindex=@(IsEnabled ? 0 : -1)
         aria-haspopup="listbox"
         aria-required="@Required"
         aria-readonly="@(ReadOnly ? "true" : null)"
         aria-invalid="@(ValueInvalid is true ? "true" : null)"
         aria-disabled="@(IsEnabled is false)"
         aria-expanded=@(IsOpen ? "true" : "false")
         aria-labelledby="@GetDropdownAriaLabelledby()"
         aria-controls="@(IsOpen? _scrollContainerId : null)">

        @if (PrefixTemplate is not null)
        {
            @PrefixTemplate
        }
        else if (Prefix.HasValue())
        {
            <span style="@Styles?.PrefixContainer" class="bit-drp-pre @Classes?.PrefixContainer">
                <span style="@Styles?.Prefix" class="@Classes?.Prefix">
                    @Prefix
                </span>
            </span>
        }

        @* No live region here: this element names the combobox through aria-labelledby, so a screen
           reader reads the new selection when the focus returns to the trigger. Announcing it on every
           render would repeat the whole selection after each keystroke typed into the combo input. *@
        <span id="@_dropdownTextContainerId"
              style="@Styles?.TextContainer"
              class="bit-drp-tcn @Classes?.TextContainer">

            @if (Chips)
            {
                @foreach (var item in _selectedItems.Take(GetDisplayedItemsCount()))
                {
                    <span style="@Styles?.Chips" class="bit-drp-chp @Classes?.Chips">
                        @GetText(item)
                        @if (IsEnabled && ReadOnly is false)
                        {
                            @* A button so the chip can be removed with the keyboard and is announced as an action. *@
                            <button @onclick="() => HandleOnClickUnselectItem(item)" @onclick:stopPropagation
                                    type="button"
                                    style="@Styles?.ChipsRemoveButton"
                                    class="bit-drp-crb @Classes?.ChipsRemoveButton"
                                    aria-label="@($"Remove {GetText(item)}")">
                                <i aria-hidden="true" style="@Styles?.ChipsRemoveIcon" class="@chipsRemoveIconCss @Classes?.ChipsRemoveIcon" />
                            </button>
                        }
                    </span>
                }

                @if (GetOverflowItemsCount() > 0)
                {
                    <span style="@Styles?.OverflowChip" class="bit-drp-chp bit-drp-ovf @Classes?.OverflowChip">
                        @GetOverflowText()
                    </span>
                }
            }
            else if (_selectedItems.Count > 0)
            {
                @if (TextTemplate is not null)
                {
                    @TextTemplate(this)
                }
                else
                {
                    @GetText()
                }
            }

            @if (Combo)
            {
                <input @ref="_comboBoxInputRef"
                       @onkeydown="@HandleOnKeyDown"
                       @oninput="@HandleOnComboInput"
                       @onchange="@HandleOnComboChange"
                       @onfocusin="HandleComboInputFocusIn"
                       @onfocusout="HandleComboInputFocusOut"
                       style="@Styles?.ComboBoxInput"
                       class="bit-drp-inp @Classes?.ComboBoxInput"
                       type="text"
                       value="@_searchText"
                       readonly="@ReadOnly"
                       aria-label="@AriaLabel"
                       aria-autocomplete="list"
                       aria-controls="@(IsOpen ? _scrollContainerId : null)"
                       placeholder="@(_selectedItems.Count > 0 ? "" : Placeholder)"
                       autocomplete="@BitAutoCompleteValue.NewPassword"
                       disabled="@(IsEnabled is false)" />
            }
            else if (_selectedItems.Count == 0)
            {
                @if (PlaceholderTemplate is not null)
                {
                    @PlaceholderTemplate(this)
                }
                else
                {
                    @Placeholder
                }
            }
        </span>

        @if (IsEnabled && ReadOnly is false && ShowClearButton && _selectedItems.Count > 0)
        {
            @* The keydown is stopped here so activating this button with the keyboard cannot
               reach the trigger's keydown handler and toggle the callout as well. *@
            <button @onclick="HandleOnClearClick" @onclick:stopPropagation @onkeydown:stopPropagation
                    type="button"
                    aria-label="Clear selection"
                    style="@Styles?.ClearButton"
                    class="bit-drp-icn bit-drp-clr @Classes?.ClearButton">
                <i aria-hidden="true" class="@clearButtonIconCss" />
            </button>
        }

        <span class="bit-drp-icn">
            @if (IsLoading)
            {
                <div aria-hidden="true" style="@Styles?.Spinner" class="bit-drp-spn @Classes?.Spinner"></div>
            }
            else if (CaretDownTemplate is not null)
            {
                @CaretDownTemplate
            }
            else
            {
                <i aria-hidden="true"
                   style="@Styles?.CaretDownIcon"
                   class="@caretDownIconCss @Classes?.CaretDownIcon" />
            }
        </span>

        @if (SuffixTemplate is not null)
        {
            @SuffixTemplate
        }
        else if (Suffix.HasValue())
        {
            <span style="@Styles?.SuffixContainer" class="bit-drp-suf @Classes?.SuffixContainer">
                <span style="@Styles?.Suffix" class="@Classes?.Suffix">
                    @Suffix
                </span>
            </span>
        }
    </div>
    @* Mirrors the selection into a native control so the value takes part in a plain HTML form post. *@
    <select @attributes="InputHtmlAttributes" class="bit-input-hidden" multiple="@MultiSelect">
        @foreach (var item in _selectedItems)
        {
            <option value="@GetValue(item)" selected>@GetText(item)</option>
        }
    </select>
</div>

<div @onclick="CloseCallout"
     style="display:@(IsOpen ? "block" : "none");@Styles?.Overlay"
     id="@_overlayId"
     class="bit-drp-ovl @Classes?.Overlay"></div>

@* The listbox role lives on the scroll container, not here: the search box, the select all row, the
   responsive panel header and the header/footer templates are not options and must not be children
   of the listbox. *@
<div @onkeydown="HandleOnCalloutKeyDown"
     id="@_calloutId"
     tabindex="0"
     style="@Styles?.Callout"
     class="@GetCalloutCssClasses()">

    @if (Responsive)
    {
        <div style="@Styles?.ResponsiveLabelContainer"
             class="bit-drp-rlc @Classes?.ResponsiveLabelContainer">
            @if (LabelTemplate is not null)
            {
                @LabelTemplate
            }
            else if (Label.HasValue())
            {
                <label style="@Styles?.ResponsiveLabel"
                       class="bit-drp-lbl @Classes?.ResponsiveLabel">
                    @Label
                </label>
            }

            <button @onclick="CloseCallout"
                    type="button"
                    title="Close"
                    aria-label="Close"
                    style="@Styles?.ResponsiveCloseButton"
                    class="bit-drp-cls @Classes?.ResponsiveCloseButton">
                <span>
                    <i style="@Styles?.ResponsiveCloseIcon"
                       class="@responsiveCloseIconCss @Classes?.ResponsiveCloseIcon" />
                </span>
            </button>
        </div>
    }

    @if (CalloutHeaderTemplate is not null)
    {
        <div id="@_headerId">@CalloutHeaderTemplate</div>
    }

    @if (ShowSearchBox && Combo is false)
    {
        <div style="@Styles?.SearchBoxContainer"
             class="@GetSearchBoxClasses() @Classes?.SearchBoxContainer">
            <div aria-hidden="true"
                 style="@Styles?.SearchBoxIconContainer"
                 class="bit-drp-sic @Classes?.SearchBoxIconContainer">
                <i aria-hidden="true"
                   style="@Styles?.SearchBoxIcon"
                   class="@searchBoxIconCss @Classes?.SearchBoxIcon" />
            </div>
            <input @ref="_searchInputRef" @onfocusin="HandleSearchBoxFocusIn" @onfocusout="HandleSearchBoxFocusOut" @oninput="@HandleOnSearchBoxInput" @onchange="@HandleOnSearchBoxChange"
                   type="text"
                   role="searchbox"
                   value="@_searchText"
                   aria-label="Search text"
                   placeholder="@SearchBoxPlaceholder"
                   style="@Styles?.SearchBoxInput"
                   class="bit-drp-sin @Classes?.SearchBoxInput" />

            @if (_searchText.HasValue())
            {
                <div style="@Styles?.SearchBoxClearButtonContainer"
                     class="bit-drp-sbcc @Classes?.SearchBoxClearButtonContainer">
                    <button @onclick="HandleSearchBoxOnClear"
                            type="button"
                            style="@Styles?.SearchBoxClearButton"
                            class="bit-drp-sbc @Classes?.SearchBoxClearButton"
                            aria-label="Clear text"
                            disabled="@(_searchText.HasNoValue())">
                        <span>
                            <i aria-hidden="true"
                               style="@Styles?.SearchBoxClearIcon"
                               class="@searchBoxClearIconCss @Classes?.SearchBoxClearIcon" />
                        </span>
                    </button>
                </div>
            }
        </div>
    }

    @if (Combo && _isResponsiveMode)
    {
        <div style="@Styles?.ResponsiveComboInputContainer"
             class="bit-drp-cbi @Classes?.ResponsiveComboInputContainer">
            <input @ref="_comboBoxInputResponsiveRef" @onkeydown="@((k) => HandleOnKeyDown(k))" @oninput="@HandleOnComboInput" @onchange="@HandleOnComboChange" @onfocusin="HandleComboInputFocusIn" @onfocusout="HandleComboInputFocusOut"
                   style="@Styles?.ComboBoxInput"
                   class="bit-drp-icb @Classes?.ComboBoxInput"
                   type="text"
                   value="@_searchText"
                   readonly="@ReadOnly"
                   aria-label="@AriaLabel"
                   aria-autocomplete="list"
                   aria-controls="@_scrollContainerId"
                   placeholder="@Placeholder"
                   autocomplete="@BitAutoCompleteValue.NewPassword"
                   disabled="@(IsEnabled is false)" />

            <button @onclick="HandleOnAddItemComboClick" @onclick:stopPropagation
                    type="button"
                    aria-label="Add"
                    style="@Styles?.ResponsiveComboAddButton"
                    class="bit-drp-icn bit-drp-cai @Classes?.ResponsiveComboAddButton">
                <i aria-hidden="true" class="@comboBoxAddButtonIconCss" />
            </button>
        </div>
    }

    @if (MultiSelect && ShowSelectAll && ItemsProvider is null && IsLoading is false)
    {
        var (allSelected, anySelected) = GetSelectAllState();
        var selectAllClasses = "bit-drp-sac bit-drp-iwr" +
                               (allSelected ? " bit-drp-chd" : string.Empty) +
                               (anySelected && allSelected is false ? " bit-drp-sai" : string.Empty) +
                               (IsEnabled && ReadOnly is false ? string.Empty : " bit-drp-ids");
        var selectAllAriaChecked = allSelected ? "true" : anySelected ? "mixed" : "false";
        <div style="@Styles?.SelectAllContainer"
             class="@selectAllClasses @Classes?.SelectAllContainer">
            <button @onclick="HandleOnSelectAllClick"
                    type="button"
                    role="checkbox"
                    style="@Styles?.SelectAllButton"
                    class="bit-drp-mcn bit-drp-sab @Classes?.SelectAllButton"
                    disabled="@(IsEnabled is false || ReadOnly)"
                    aria-checked="@selectAllAriaChecked">
                <div style="@Styles?.SelectAllCheckBox"
                     class="bit-drp-chb @Classes?.SelectAllCheckBox">
                    <i aria-hidden="true"
                       style="@Styles?.SelectAllCheckIcon"
                       class="bit-drp-chm @itemCheckIconCss @Classes?.SelectAllCheckIcon" />
                </div>
                <span style="@Styles?.SelectAllText"
                      class="bit-drp-itx @Classes?.SelectAllText">
                    @(SelectAllText ?? "Select all")
                </span>
            </button>
        </div>
    }

    <div id="@_scrollContainerId"
         role="listbox"
         style="@Styles?.ScrollContainer"
         class="bit-drp-scn @Classes?.ScrollContainer"
         aria-labelledby="@(HasLabel ? _labelId : null)"
         aria-multiselectable="@(MultiSelect ? "true" : null)">
        @if (IsLoading)
        {
            @loadingContent
        }
        else if (Virtualize)
        {
            if (ItemsProvider is null)
            {
                <Virtualize Items="GetDisplayItems()"
                            ItemSize="ItemSize"
                            OverscanCount="OverscanCount"
                            Placeholder="VirtualizePlaceholder">
                    <ItemContent Context="item">
                        <_BitDropdownItem Item="item" Dropdown="this" ItemCheckIconCss="@itemCheckIconCss" />
                    </ItemContent>
                    <EmptyContent>
                        @emptyContent
                    </EmptyContent>
                </Virtualize>
            }
            else
            {
                <Virtualize @ref="_virtualizeElement"
                            OverscanCount="OverscanCount"
                            Placeholder="VirtualizePlaceholder"
                            ItemsProvider="InternalItemsProvider">
                    <ItemContent Context="item">
                        <_BitDropdownItem Item="item" Dropdown="this" ItemCheckIconCss="@itemCheckIconCss" />
                    </ItemContent>
                    <EmptyContent>
                        @emptyContent
                    </EmptyContent>
                </Virtualize>
            }
        }
        else if ((Options ?? ChildContent) is not null)
        {
            <CascadingValue Value="this" IsFixed="true">
                @(Options ?? ChildContent)
            </CascadingValue>

            @if (HasNoVisibleItems())
            {
                @emptyContent
            }
        }
        else
        {
            @if (HasNoVisibleItems())
            {
                @emptyContent
            }
            else
            {
                @foreach (var item in GetDisplayItems())
                {
                    <_BitDropdownItem Item="item" Dropdown="this" ItemCheckIconCss="@itemCheckIconCss" />
                }
            }
        }
    </div>

    @if (CalloutFooterTemplate is not null)
    {
        <div id="@_footerId">@CalloutFooterTemplate</div>
    }

    @if (HasSearchText && IsLoading is false)
    {
        @* A search silently changes the length of a list a screen reader user cannot see, so the new
           result count is announced. Only rendered while searching, to stay quiet otherwise. *@
        <div role="status" aria-live="polite" aria-atomic="true" class="bit-drp-lvr">
            @GetSearchResultsText()
        </div>
    }

</div>

