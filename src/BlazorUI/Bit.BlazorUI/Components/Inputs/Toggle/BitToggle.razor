@namespace Bit.BlazorUI
@inherits BitInputBase<bool>

@{
    var icon = GetStateIcon();
}

@* stopping propagation on the root covers both the button click and the click a label forwards to it *@
<div @ref="RootElement" @attributes="HtmlAttributes"
     @onclick:stopPropagation="StopPropagation"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @* the label carries an id rather than only a for, since a button takes its accessible name from
       aria-labelledby and never from an associated label element *@
    @if (HasLabel)
    {
        <label id="@_labelId" for="@_buttonId" style="@Styles?.Label" class="bit-tgl-lbl @Classes?.Label">
            @if (LabelTemplate is not null)
            {
                @LabelTemplate
            }
            else
            {
                @Label
            }
        </label>
    }

    <div style="@Styles?.Container" class="bit-tgl-cnt @Classes?.Container">
        <button @ref="_buttonRef"
                @onblur="HandleOnBlur"
                @onclick="HandleOnClick"
                @onfocus="HandleOnFocus"
                @onfocusin="HandleOnFocusIn"
                @onfocusout="HandleOnFocusOut"
                role="@Role"
                type="button"
                id="@_buttonId"
                title="@Title"
                style="@Styles?.Button"
                class="bit-tgl-btn @Classes?.Button"
                autofocus="@AutoFocus"
                tabindex="@TabIndex"
                data-ktp-target="true"
                data-is-focusable="true"
                disabled="@(IsEnabled is false)"
                aria-label="@AriaLabel"
                aria-checked="@_ariaChecked"
                aria-busy="@(Loading ? "true" : null)"
                aria-readonly="@(ReadOnly ? "true" : null)"
                aria-required="@(Required ? "true" : null)"
                aria-labelledby="@(_labelledById.HasValue() ? _labelledById : null)"
                aria-describedby="@(_describedById.HasValue() ? _describedById : null)"
                aria-invalid="@(ValueInvalid is true ? "true" : null)"
                aria-disabled="@(IsEnabled is false ? "true" : null)">

            @* The knob is taken out of the flow and slid between the two ends of the track, while the lane it
               would have taken is held open by the padding of the track, which swaps sides with the state. *@
            <span style="@Styles?.Thumb" class="bit-tgl-sta @Classes?.Thumb">
                @if (Loading)
                {
                    <span style="@Styles?.Spinner" class="bit-tgl-spn @Classes?.Spinner"></span>
                }
                else if (icon is not null)
                {
                    <i aria-hidden="true" style="@Styles?.Icon" class="bit-tgl-ico @icon.GetCssClasses() @Classes?.Icon"></i>
                }
            </span>

            @* the track content is decorative next to aria-checked, so it is hidden from the accessible
               name of the switch that would otherwise change along with the state *@
            @if (HasContent)
            {
                <span aria-hidden="true" style="@Styles?.Content" class="bit-tgl-cnn @Classes?.Content">
                    @* Both sides are rendered and stacked in the same cell, so the track is as wide as the
                       wider of the two and keeps that width through a flip - only the side belonging to the
                       current state is painted. Rendering only the current side would let a toggle whose two
                       states carry differently sized content resize itself under the pointer. *@
                    <span style="@Styles?.OnContent" class="bit-tgl-cno @Classes?.OnContent">@OnContent</span>
                    <span style="@Styles?.OffContent" class="bit-tgl-cnf @Classes?.OffContent">@OffContent</span>
                </span>
            }
        </button>

        @if (_stateText.HasValue())
        {
            <label id="@_stateTextId" style="@Styles?.Text" class="bit-tgl-stx @Classes?.Text" for="@_buttonId">
                @_stateText
            </label>
        }
    </div>

    @* rendered outside the button so the description drives aria-describedby without leaking into the accessible name *@
    @if (AriaDescription.HasValue())
    {
        <span id="@_descriptionId" class="bit-tgl-dsc">@AriaDescription</span>
    }

    @* The form value carrier: hidden from both the tab order and assistive technologies, which the switch
       button in front of it already covers. Required deliberately stays off it: the native attribute on a
       zero-sized control makes browsers block the submit over a message they cannot show anywhere, so being
       required is expressed through aria-required and the validation rules of the model instead. *@
    <input @attributes="InputHtmlAttributes"
           name="@Name"
           type="checkbox"
           tabindex="-1"
           aria-hidden="true"
           class="bit-input-hidden"
           checked="@CurrentValue"
           value="@CurrentValueAsString"
           disabled="@(IsEnabled is false)" />
</div>
