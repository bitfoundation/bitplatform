@namespace Bit.BlazorUI
@inherits BitInputBase<TimeSpan?>

@{
    var increaseHourIcon = BitIconInfo.From(IncreaseHourIcon, IncreaseHourIconName ?? "ChevronDownSmall bit-ico-r180");
    var decreaseHourIcon = BitIconInfo.From(DecreaseHourIcon, DecreaseHourIconName ?? "ChevronDownSmall");
    var increaseMinuteIcon = BitIconInfo.From(IncreaseMinuteIcon, IncreaseMinuteIconName ?? "ChevronDownSmall bit-ico-r180");
    var decreaseMinuteIcon = BitIconInfo.From(DecreaseMinuteIcon, DecreaseMinuteIconName ?? "ChevronDownSmall");
    var increaseSecondIcon = BitIconInfo.From(IncreaseSecondIcon, IncreaseSecondIconName ?? "ChevronDownSmall bit-ico-r180");
    var decreaseSecondIcon = BitIconInfo.From(DecreaseSecondIcon, DecreaseSecondIconName ?? "ChevronDownSmall");
    var closeIcon = BitIconInfo.From(CloseButtonIcon, CloseButtonIconName ?? "Cancel");
    var clearIcon = BitIconInfo.From(ClearButtonIcon, ClearButtonIconName ?? "Cancel");
    var describedBy = DescribedBy;
}

<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @*
        The label names the part of the picker the person operates, which for a standalone one is the hour
        input rather than the hidden input that only carries the value: a label pointing at that one would
        put the focus somewhere invisible when clicked.
    *@
    @{
        var labelFor = Standalone ? _hourInputId : _inputId;
    }

    @if (LabelTemplate is not null)
    {
        <label id="@_labelId" for="@labelFor">
            @LabelTemplate
        </label>
    }
    else if (Label.HasValue())
    {
        <label style="@Styles?.Label" class="bit-tpc-lbl @Classes?.Label" id="@_labelId" for="@labelFor">
            @Label
        </label>
    }

    @if (Standalone is false)
    {
        <div style="@Styles?.InputWrapper" class="bit-tpc-wrp @Classes?.InputWrapper" id="@_timePickerId" aria-owns="@(IsOpen ? _calloutId : null)" @onclick="HandleOnClick">
            <div style="@Styles?.InputContainer" class="bit-tpc-icn @Classes?.InputContainer">
                @if (PrefixTemplate is not null)
                {
                    @PrefixTemplate
                }
                else if (Prefix.HasValue())
                {
                    <span id="@_prefixId" style="@Styles?.PrefixContainer" class="bit-tpc-pre @Classes?.PrefixContainer">
                        <span style="@Styles?.Prefix" class="@Classes?.Prefix">@Prefix</span>
                    </span>
                }

                <input @ref="InputElement" @attributes="InputHtmlAttributes"
                       @onfocus="@HandleOnFocus"
                       @oninput="@HandleOnChange"
                       @onfocusin="@HandleOnFocusIn"
                       @onfocusout="@HandleOnFocusOut"
                       @onkeydown="@HandleOnInputKeyDown"
                       type="text"
                       name="@Name"
                       role="combobox"
                       id="@_inputId"
                       required="@Required"
                       tabindex="@TabIndex"
                       aria-haspopup="dialog"
                       aria-label="@AriaLabel"
                       placeholder="@Placeholder"
                       value="@CurrentValueAsString"
                       disabled="@(IsEnabled is false)"
                       readonly="@(AllowTextInput is false || ReadOnly)"
                       aria-readonly="@(ReadOnly ? "true" : null)"
                       aria-expanded="@(IsOpen ? "true" : "false")"
                       aria-controls="@(IsOpen ? _calloutId : null)"
                       aria-invalid="@(IsInvalid ? "true" : null)"
                       aria-describedby="@describedBy"
                       aria-labelledby="@(Label.HasValue() || LabelTemplate is not null ? _labelId : null)"
                       style="@Styles?.Input"
                       class="bit-tpc-inp@(AllowTextInput ? " bit-tpc-ein" : null) @Classes?.Input" />

                @*
                    The clear button sits inside the field, so the click that presses it also lands on the
                    field: it is stopped there, since taking the value back is not a request to open the
                    popup that picks a new one.
                *@
                @if (ShowsInputClearButton)
                {
                    <button @onclick="HandleOnInputClearClick" @onclick:stopPropagation
                            type="button"
                            title="@ClearButtonTitle"
                            aria-label="@ClearButtonTitle"
                            style="@Styles?.InputClearButton"
                            class="bit-tpc-clr @Classes?.InputClearButton"
                            disabled="@(IsInteractive is false)">
                        <i style="@Styles?.InputClearButtonIcon" class="@clearIcon?.GetCssClasses() @Classes?.InputClearButtonIcon" aria-hidden="true" />
                    </button>
                }

                @if (IconTemplate is not null)
                {
                    @IconTemplate
                }
                else
                {
                    var icon = BitIconInfo.From(Icon, IconName ?? "Clock");
                    <i style="@Styles?.Icon" class="bit-tpc-ico @icon?.GetCssClasses() @Classes?.Icon" aria-hidden="true" />
                }

                @if (SuffixTemplate is not null)
                {
                    @SuffixTemplate
                }
                else if (Suffix.HasValue())
                {
                    <span id="@_suffixId" style="@Styles?.SuffixContainer" class="bit-tpc-suf @Classes?.SuffixContainer">
                        <span style="@Styles?.Suffix" class="@Classes?.Suffix">@Suffix</span>
                    </span>
                }
            </div>
        </div>
    }
    else
    {
        @*
            The value carrier of a standalone picker, so that one still posts and validates like any other
            field. It is invisible, so it is taken out of the tab order: a tab stop nobody can see is a
            place the focus disappears into on the way to the time inputs, which are the part being operated.
        *@
        <input @ref="InputElement" @attributes="InputHtmlAttributes"
               type="text"
               name="@Name"
               id="@_inputId"
               tabindex="-1"
               required="@Required"
               aria-label="@AriaLabel"
               class="bit-input-hidden"
               value="@CurrentValueAsString"
               disabled="@(IsEnabled is false)"
               readonly="@(AllowTextInput is false || ReadOnly)" />
    }

    @if (Standalone is false)
    {
        <div @onclick="CloseCallout"
             style="@GetOverlayStyles()"
             id="@_overlayId"
             class="bit-tpc-ovl @Classes?.Overlay"></div>
    }

    <div @ref="_calloutRef"
         id="@_calloutId"
         style="@GetCalloutStyles()"
         class="@GetCalloutCssClasses()"
         dir="@Dir?.ToString().ToLower()">
        @*
            The callout is a modal dialog only when it floats over the page, where an overlay closes the rest
            of it off and the focus is held inside it; standalone it is a group of controls that is part of
            the page like any other, where role="dialog" would announce a dialog the user can never leave -
            and where a plain div would leave the label below naming nothing.
            A standalone group is named by the visible label where there is one: the hour input carries an
            aria-label of its own, which outranks the label pointing at it, so the group is the only place the
            name of the field is still announced from.
        *@
        <div @onkeydown="HandleOnCalloutKeyDown"
             style="@Styles?.CalloutContainer"
             class="bit-tpc-cac @Classes?.CalloutContainer"
             role="@(Standalone ? "group" : "dialog")"
             aria-modal="@(Standalone ? null : "true")"
             @attributes=@CalloutHtmlAttributes
             aria-label="@(StandaloneHasLabel ? null : CalloutAriaLabel)"
             aria-labelledby="@(StandaloneHasLabel ? _labelId : null)">

            @if (CalloutHeaderTemplate is not null)
            {
                <div id="@_headerId" style="@Styles?.CalloutHeader" class="bit-tpc-chd @Classes?.CalloutHeader">
                    @CalloutHeaderTemplate
                </div>
            }

            @*
                The spin buttons are out of the tab order, as in the spin button pattern: the input beside each
                pair is the spin button, and its arrow keys make the very move the pair makes. Tabbing through
                them would only put two more stops around every part of the time.
            *@
            <div style="@Styles?.TimeInputContainer" class="bit-tpc-tic @Classes?.TimeInputContainer">
                <div style="@Styles?.HourInputContainer" class="bit-tpc-tpr @Classes?.HourInputContainer">
                    <button @onpointerup="HandleOnPointerUpOrOut"
                            @onpointerout="HandleOnPointerUpOrOut"
                            @onpointerdown="() => HandleOnPointerDown(true, TimeUnit.Hour)"
                            @onclick="e => HandleOnSpinClick(e, true, TimeUnit.Hour)"
                            tabindex="-1"
                            type="button"
                            title="@IncreaseHourTitle"
                            aria-label="@IncreaseHourTitle"
                            style="@Styles?.IncreaseHourButton"
                            class="bit-tpc-tbt @Classes?.IncreaseHourButton"
                            disabled="@(IsInteractive is false)">
                        <i style="@Styles?.IncreaseHourIcon" class="@increaseHourIcon?.GetCssClasses() @Classes?.IncreaseHourIcon" aria-hidden="true" />
                    </button>
                    @*
                        The required attribute sits on the hidden input of a standalone picker, so the part that is
                        actually operated has to state it for itself. A standalone picker has no field to describe
                        either, so the helper and error text are tied to the first of its inputs - the part the
                        person operates.
                    *@
                    <input @ref="_inputHourRef"
                           @bind="@_hourView"
                           @bind:event="oninput"
                           @onfocus="HandleOnHourFocus"
                           @onblur="HandleOnTimeInputBlur"
                           @onwheel="e => HandleOnTimeInputWheel(e, TimeUnit.Hour)"
                           data-bit-wheel="@(IsWheelSpinEnabled ? "1" : null)"
                           @onkeydown="e => HandleOnTimeInputKeyDown(e, TimeUnit.Hour)"
                           id="@_hourInputId"
                           min="@(TimeFormat == BitTimeFormat.TwelveHours ? "1" : "0")"
                           max="@(TimeFormat == BitTimeFormat.TwelveHours ? "12" : "23")"
                           type="number"
                           inputmode="numeric"
                           readonly="@ReadOnly"
                           aria-label="@HourInputAriaLabel"
                           aria-readonly="@(ReadOnly ? "true" : null)"
                           aria-invalid="@(Standalone && IsInvalid ? "true" : null)"
                           aria-required="@(Standalone && Required ? "true" : null)"
                           aria-describedby="@(Standalone ? describedBy : null)"
                           style="@Styles?.HourInput"
                           class="bit-tpc-tin @Classes?.HourInput"
                           autocomplete="@BitAutoCompleteValue.NewPassword"
                           disabled="@(IsEnabled is false)" />
                    <button @onpointerup="HandleOnPointerUpOrOut"
                            @onpointerout="HandleOnPointerUpOrOut"
                            @onpointerdown="() => HandleOnPointerDown(false, TimeUnit.Hour)"
                            @onclick="e => HandleOnSpinClick(e, false, TimeUnit.Hour)"
                            tabindex="-1"
                            type="button"
                            title="@DecreaseHourTitle"
                            aria-label="@DecreaseHourTitle"
                            style="@Styles?.DecreaseHourButton"
                            class="bit-tpc-tbt @Classes?.DecreaseHourButton"
                            disabled="@(IsInteractive is false)">
                        <i style="@Styles?.DecreaseHourIcon" class="@decreaseHourIcon?.GetCssClasses() @Classes?.DecreaseHourIcon" aria-hidden="true" />
                    </button>
                </div>
                <div style="@Styles?.HourMinuteSeparator" aria-hidden="true" class="bit-tpc-tpr bit-tpc-tdv @Classes?.HourMinuteSeparator">:</div>
                <div style="@Styles?.MinuteInputContainer" class="bit-tpc-tpr @Classes?.MinuteInputContainer">
                    <button @onpointerup="HandleOnPointerUpOrOut"
                            @onpointerout="HandleOnPointerUpOrOut"
                            @onpointerdown="() => HandleOnPointerDown(true, TimeUnit.Minute)"
                            @onclick="e => HandleOnSpinClick(e, true, TimeUnit.Minute)"
                            tabindex="-1"
                            type="button"
                            title="@IncreaseMinuteTitle"
                            aria-label="@IncreaseMinuteTitle"
                            style="@Styles?.IncreaseMinuteButton"
                            class="bit-tpc-tbt @Classes?.IncreaseMinuteButton"
                            disabled="@(IsInteractive is false)">
                        <i style="@Styles?.IncreaseMinuteIcon" class="@increaseMinuteIcon?.GetCssClasses() @Classes?.IncreaseMinuteIcon" aria-hidden="true" />
                    </button>
                    <input @ref="_inputMinuteRef"
                           @bind="@_minuteView"
                           @bind:event="oninput"
                           @onfocus="HandleOnMinuteFocus"
                           @onblur="HandleOnTimeInputBlur"
                           @onwheel="e => HandleOnTimeInputWheel(e, TimeUnit.Minute)"
                           data-bit-wheel="@(IsWheelSpinEnabled ? "1" : null)"
                           @onkeydown="e => HandleOnTimeInputKeyDown(e, TimeUnit.Minute)"
                           min="0"
                           max="59"
                           type="number"
                           inputmode="numeric"
                           readonly="@ReadOnly"
                           aria-label="@MinuteInputAriaLabel"
                           aria-readonly="@(ReadOnly ? "true" : null)"
                           style="@Styles?.MinuteInput"
                           class="bit-tpc-tin @Classes?.MinuteInput"
                           autocomplete="@BitAutoCompleteValue.NewPassword"
                           disabled="@(IsEnabled is false)" />
                    <button @onpointerup="HandleOnPointerUpOrOut"
                            @onpointerout="HandleOnPointerUpOrOut"
                            @onpointerdown="() => HandleOnPointerDown(false, TimeUnit.Minute)"
                            @onclick="e => HandleOnSpinClick(e, false, TimeUnit.Minute)"
                            tabindex="-1"
                            type="button"
                            title="@DecreaseMinuteTitle"
                            aria-label="@DecreaseMinuteTitle"
                            style="@Styles?.DecreaseMinuteButton"
                            class="bit-tpc-tbt @Classes?.DecreaseMinuteButton"
                            disabled="@(IsInteractive is false)">
                        <i style="@Styles?.DecreaseMinuteIcon" class="@decreaseMinuteIcon?.GetCssClasses() @Classes?.DecreaseMinuteIcon" aria-hidden="true" />
                    </button>
                </div>
                @if (ShowSeconds)
                {
                    <div style="@Styles?.MinuteSecondSeparator" aria-hidden="true" class="bit-tpc-tpr bit-tpc-tdv @Classes?.MinuteSecondSeparator">:</div>
                    <div style="@Styles?.SecondInputContainer" class="bit-tpc-tpr @Classes?.SecondInputContainer">
                        <button @onpointerup="HandleOnPointerUpOrOut"
                                @onpointerout="HandleOnPointerUpOrOut"
                                @onpointerdown="() => HandleOnPointerDown(true, TimeUnit.Second)"
                                @onclick="e => HandleOnSpinClick(e, true, TimeUnit.Second)"
                                tabindex="-1"
                                type="button"
                                title="@IncreaseSecondTitle"
                                aria-label="@IncreaseSecondTitle"
                                style="@Styles?.IncreaseSecondButton"
                                class="bit-tpc-tbt @Classes?.IncreaseSecondButton"
                                disabled="@(IsInteractive is false)">
                            <i style="@Styles?.IncreaseSecondIcon" class="@increaseSecondIcon?.GetCssClasses() @Classes?.IncreaseSecondIcon" aria-hidden="true" />
                        </button>
                        <input @ref="_inputSecondRef"
                               @bind="@_secondView"
                               @bind:event="oninput"
                               @onfocus="HandleOnSecondFocus"
                               @onblur="HandleOnTimeInputBlur"
                               @onwheel="e => HandleOnTimeInputWheel(e, TimeUnit.Second)"
                               data-bit-wheel="@(IsWheelSpinEnabled ? "1" : null)"
                               @onkeydown="e => HandleOnTimeInputKeyDown(e, TimeUnit.Second)"
                               min="0"
                               max="59"
                               type="number"
                               inputmode="numeric"
                               readonly="@ReadOnly"
                               aria-label="@SecondInputAriaLabel"
                               aria-readonly="@(ReadOnly ? "true" : null)"
                               style="@Styles?.SecondInput"
                               class="bit-tpc-tin @Classes?.SecondInput"
                               autocomplete="@BitAutoCompleteValue.NewPassword"
                               disabled="@(IsEnabled is false)" />
                        <button @onpointerup="HandleOnPointerUpOrOut"
                                @onpointerout="HandleOnPointerUpOrOut"
                                @onpointerdown="() => HandleOnPointerDown(false, TimeUnit.Second)"
                                @onclick="e => HandleOnSpinClick(e, false, TimeUnit.Second)"
                                tabindex="-1"
                                type="button"
                                title="@DecreaseSecondTitle"
                                aria-label="@DecreaseSecondTitle"
                                style="@Styles?.DecreaseSecondButton"
                                class="bit-tpc-tbt @Classes?.DecreaseSecondButton"
                                disabled="@(IsInteractive is false)">
                            <i style="@Styles?.DecreaseSecondIcon" class="@decreaseSecondIcon?.GetCssClasses() @Classes?.DecreaseSecondIcon" aria-hidden="true" />
                        </button>
                    </div>
                }
            </div>

            @if (TimeFormat == BitTimeFormat.TwelveHours)
            {
                var isAm = IsAm();
                <div style="@Styles?.AmPmContainer" class="bit-tpc-tpr bit-tpc-am-pm @Classes?.AmPmContainer">
                    @* No title: it would repeat the designator the button already spells out, which
                       a screen reader then reads a second time as the description of the button. *@
                    <button @onclick="HandleOnAmClick"
                            type="button"
                            aria-pressed="@(isAm is true ? "true" : "false")"
                            style="@Styles?.AmButton"
                            class="bit-tpc-tbt bit-tpc-bam @(isAm is true ? "bit-tpc-bns" : string.Empty) @Classes?.AmButton"
                            disabled="@(IsInteractive is false)">
                        @_culture.DateTimeFormat.AMDesignator
                    </button>

                    <button @onclick="HandleOnPmClick"
                            type="button"
                            aria-pressed="@(isAm is false ? "true" : "false")"
                            style="@Styles?.PmButton"
                            class="bit-tpc-tbt bit-tpc-bpm @(isAm is false ? "bit-tpc-bns" : string.Empty) @Classes?.PmButton"
                            disabled="@(IsInteractive is false)">
                        @_culture.DateTimeFormat.PMDesignator
                    </button>
                </div>
            }

            @if (HasActions)
            {
                <div style="@Styles?.Actions" class="bit-tpc-act @Classes?.Actions">
                    @if (ShowNowButton)
                    {
                        <button @onclick="HandleOnNowClick"
                                type="button"
                                style="@Styles?.NowButton"
                                class="bit-tpc-abn @Classes?.NowButton"
                                disabled="@(IsInteractive is false)">
                            @NowButtonText
                        </button>
                    }
                    @if (ShowClearButton)
                    {
                        <button @onclick="HandleOnClearClick"
                                type="button"
                                style="@Styles?.ClearButton"
                                class="bit-tpc-abn @Classes?.ClearButton"
                                disabled="@(IsInteractive is false || HasValueToClear is false)">
                            @ClearButtonText
                        </button>
                    }
                </div>
            }

            @if (CalloutFooterTemplate is not null)
            {
                <div id="@_footerId" style="@Styles?.CalloutFooter" class="bit-tpc-cft @Classes?.CalloutFooter">
                    @CalloutFooterTemplate
                </div>
            }

            @if (ShowCloseButton && Standalone is false)
            {
                <button @onclick="CloseCallout"
                        type="button"
                        style="@Styles?.CloseButton"
                        class="bit-tpc-tbt bit-tpc-cbn @Classes?.CloseButton"
                        title="@CloseButtonTitle"
                        aria-label="@CloseButtonTitle">
                    <i style="@Styles?.CloseButtonIcon" class="@closeIcon?.GetCssClasses() @Classes?.CloseButtonIcon" aria-hidden="true" />
                </button>
            }
        </div>
    </div>

    @*
        The time the picker holds, announced as a whole whenever any part of it changes: a screen reader
        follows the input that was operated by itself, but everything that sets the whole time at once -
        the now, clear and meridiem buttons, the clear button of the field - would otherwise change it
        silently. It sits on the root rather than inside the callout, which is hidden while the callout is
        closed and moved to the end of the document while it is open: a region in either state announces
        nothing.
    *@
    <div role="status" aria-live="polite" aria-atomic="true" class="bit-tpc-vhd">
        @* The rejection wins over the time: the time says what the picker holds, this says what is wrong
           with it. Text only, never ErrorMessageTemplate, which is arbitrary markup meant to be seen -
           rendering it a second time here would duplicate its ids and its handlers. *@
        @if (ErrorMessage.HasValue())
        {
            @ErrorMessage
        }
        else
        {
            @CurrentValueAsString
        }
    </div>

    @if (HasErrorMessage)
    {
        @* What is wrong with the value is the first thing to read under the field, so it comes before the
           helper text. It carries no live role of its own: the region above is what announces it, so it is
           never read out twice. *@
        <div id="@_errorId"
             style="@Styles?.ErrorMessageContainer"
             class="bit-tpc-erm @Classes?.ErrorMessageContainer">
            @if (ErrorMessageTemplate is not null)
            {
                @ErrorMessageTemplate
            }
            else
            {
                <span style="@Styles?.ErrorMessage" class="@Classes?.ErrorMessage">@ErrorMessage</span>
            }
        </div>
    }

    @if (HasDescription)
    {
        @* Described by the field through aria-describedby, so it is read as part of the picker rather than
           as text that only happens to sit under it. *@
        <div id="@_descriptionId"
             style="@Styles?.DescriptionContainer"
             class="bit-tpc-des @Classes?.DescriptionContainer">
            @if (DescriptionTemplate is not null)
            {
                @DescriptionTemplate
            }
            else
            {
                <span style="@Styles?.Description" class="@Classes?.Description">@Description</span>
            }
        </div>
    }

    @if (AriaDescription.HasValue())
    {
        @* aria-describedby takes an id reference, so the text written for a screen reader alone has to be
           in the document to be pointed at - out of sight, but not out of the accessibility tree. *@
        <span id="@_ariaDescriptionId" class="bit-tpc-vhd">@AriaDescription</span>
    }
</div>
