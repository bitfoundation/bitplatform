@namespace Bit.BlazorUI
@inherits BitComponentBase

<div @ref="@RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @if (LabelTemplate is not null)
    {
        @LabelTemplate
    }
    else if (HideLabel is false)
    {
        <button @onclick="Browse"
                type="button"
                id="@_buttonId"
                style="@Styles?.Label"
                class="bit-fin-lbl @Classes?.Label">
            @(Label ?? "Browse")
        </button>
    }

    <input @ref="_inputRef"
           @onchange="HandleOnChange"
           type="file"
           id="@InputId"
           class="bit-fin-fi"
           capture="@Capture"
           multiple="@Multiple"
           webkitdirectory="@Directory"
           disabled="@(IsEnabled is false)"
           aria-label="@AriaLabel"
           aria-labelledby="@(LabelTemplate is null && HideLabel is false ? _buttonId : null)"
           accept="@GetAcceptValue()" />

    @if (Files is not null && HideFileList is false)
    {
        <div role="list" style="@Styles?.FileList" class="bit-fin-fl @Classes?.FileList">
            @for (var i = 0; i < Files.Count; i++)
            {
                var index = i;
                var file = Files[index];
                file.Index = index;

                if (FileViewTemplate is not null)
                {
                    @FileViewTemplate(file)
                }
                else
                {
                    <div role="listitem" style="@Styles?.FileItem" class="bit-fin-itm @GetFileElClass(file.IsValid) @Classes?.FileItem">
                        @if (ShowPreview && file.PreviewUrl is not null)
                        {
                            <img src="@file.PreviewUrl" alt="@file.Name" style="@Styles?.Preview" class="bit-fin-prv @Classes?.Preview" />
                        }
                        <div class="bit-fin-fic">
                            <div title="@file.Name" class="bit-fin-fnc">
                                <div style="@Styles?.FileName" class="bit-fin-fn @Classes?.FileName">
                                    @file.Name
                                </div>
                            </div>
                            <div class="bit-fin-fsc">
                                <span style="@Styles?.FileSize" class="bit-fin-fs @Classes?.FileSize">
                                    @FileSizeHumanizer.Humanize(file.Size)
                                </span>
                            </div>
                            @if (file.IsValid is false)
                            {
                                <div style="@Styles?.ErrorMessage" class="bit-fin-msg @Classes?.ErrorMessage">
                                    @file.Message
                                </div>
                            }
                        </div>
                        @if (ShowRemoveButton)
                        {
                            var removeIcon = BitIconInfo.From(RemoveButtonIcon, RemoveButtonIconName ?? "Delete");

                            <button @onclick="() => RemoveFile(file)"
                                    type="button"
                                    title="Remove"
                                    aria-label="@($"Remove {file.Name}")"
                                    style="@Styles?.RemoveButton"
                                    class="bit-fin-rbt @Classes?.RemoveButton">
                                <i style="@Styles?.RemoveIcon" class="@removeIcon?.GetCssClasses() @Classes?.RemoveIcon" aria-hidden="true" />
                            </button>
                        }
                    </div>
                }
            }
        </div>
    }
</div>
