@namespace Bit.BlazorUI
@inherits BitTextInputBase<string?>

<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @if (HasLabel)
    {
        <label id="@_labelId"
               for="@_inputId"
               style="@Styles?.Label"
               class="bit-srb-lbl @Classes?.Label">
            @if (LabelTemplate is not null)
            {
                @LabelTemplate
            }
            else
            {
                @Label
            }
        </label>
    }

    <div style="@Styles?.Wrapper" class="bit-srb-wrp @Classes?.Wrapper">
        <div class="bit-srb-cnt @Classes?.InputContainer" style="@Styles?.InputContainer">
            @if (HideIcon is false)
            {
                var icon = BitIconInfo.From(Icon, IconName ?? "Search");
                @* The icon sits inside the field and advertises a text cursor, so clicking it has to
                   put the caret in the input the same way clicking the empty space of the field does. *@
                <div aria-hidden="true"
                     @onclick="HandleOnIconClick"
                     style="@Styles?.IconWrapper"
                     class="bit-srb-iwp @Classes?.IconWrapper">
                    <i aria-hidden="true"
                       style="@Styles?.Icon"
                       class="@icon?.GetCssClasses() @Classes?.Icon" />
                </div>
            }

            @if (PrefixTemplate is not null)
            {
                @PrefixTemplate
            }
            else if (Prefix.HasValue())
            {
                <div style="@Styles?.PrefixContainer"
                     class="bit-srb-pre @Classes?.PrefixContainer">
                    <span style="@Styles?.Prefix"
                          class="@Classes?.Prefix">
                        @Prefix
                    </span>
                </div>
            }

            <input @ref="InputElement" @attributes="InputHtmlAttributes"
                   @onclick="@HandleOnClick"
                   @onkeyup="@HandleOnKeyUp"
                   @onfocus="@HandleOnFocus"
                   @onkeydown="@HandleOnKeyDown"
                   @onfocusin="@HandleInputFocusIn"
                   @onfocusout="@HandleInputFocusOut"
                   @oninput="@HandleOnStringValueInputAsync"
                   @onchange="@HandleOnStringValueChangeAsync"
                   type="text"
                   name="@Name"
                   id="@_inputId"
                   tabindex="@TabIndex"
                   readonly="@ReadOnly"
                   required="@Required"
                   aria-required="@(Required ? "true" : null)"
                   value="@CurrentValue"
                   style="@Styles?.Input"
                   autofocus="@AutoFocus"
                   inputmode="@_inputMode"
                   aria-label="@AriaLabel"
                   placeholder="@Placeholder"
                   aria-busy="@AriaBusy"
                   aria-invalid="@AriaInvalid"
                   enterkeyhint="@_enterKeyHint"
                   autocorrect="@GetAutoCorrect()"
                   aria-labelledby="@LabelledBy"
                   disabled="@(IsEnabled is false)"
                   autocapitalize="@AutoCapitalize"
                   aria-describedby="@DescribedBy"
                   class="bit-srb-inp @Classes?.Input"
                   spellcheck="@(SpellCheck is null ? null : (SpellCheck.Value ? "true" : "false"))"
                   maxlength="@(MaxLength >= 0 ? MaxLength : null)"
                   aria-keyshortcuts="@FocusShortcut"
                   role="@(_hasSuggestSource ? "combobox" : "searchbox")"
                   aria-haspopup="@(_hasSuggestSource ? "listbox" : null)"
                   aria-controls="@(_hasSuggestSource ? _scrollContainerId : null)"
                   aria-autocomplete="@(_hasSuggestSource ? "list" : null)"
                   aria-expanded="@(_hasSuggestSource ? (_isOpen ? "true" : "false") : null)"
                   aria-activedescendant="@(_isOpen && _selectedIndex > -1 ? GetItemId(_selectedIndex) : null)"
                   autocomplete="@(AutoComplete ?? (_hasSuggestSource ? "off" : null))" />

            @if (SuffixTemplate is not null)
            {
                @SuffixTemplate
            }
            else if (Suffix.HasValue())
            {
                <div style="@Styles?.SuffixContainer" class="bit-srb-suf @Classes?.SuffixContainer">
                    <span style="@Styles?.Suffix" class="@Classes?.Suffix">
                        @Suffix
                    </span>
                </div>
            }

            @if (Loading)
            {
                @* The search the app itself is running, told where the clear button sits: the one slot of
                   the field that is always visible, unlike the leading icon which collapses on focus.
                   It is decoration - the live region at the end of the component is what says it out loud. *@
                <div aria-hidden="true"
                     style="@Styles?.LoadingSpinner"
                     class="bit-srb-lsp @Classes?.LoadingSpinner">
                    <div class="bit-srb-spn" />
                </div>
            }
            else if (HideClearButton is false && ReadOnly is false && HasValue)
            {
                @* Normally kept out of the tab order because escape already clears the field, which is
                   the faster way to do it from the keyboard. NoClearOnEscape takes that away, so the
                   button becomes the only way left and has to be reachable. *@
                <button @onclick="HandleOnClearButtonClick"
                        type="button"
                        tabindex="@(NoClearOnEscape ? null : "-1")"
                        title="@ClearButtonAriaLabel"
                        style="@Styles?.ClearButton"
                        aria-label="@ClearButtonAriaLabel"
                        disabled="@(IsEnabled is false)"
                        class="bit-srb-cbt @Classes?.ClearButton">
                    @if (ClearButtonTemplate is not null)
                    {
                        @ClearButtonTemplate
                    }
                    else
                    {
                        var clearButtonIcon = BitIconInfo.From(ClearButtonIcon, ClearButtonIconName ?? "Cancel");
                        <i style="@Styles?.ClearButtonIcon" class="@clearButtonIcon?.GetCssClasses() @Classes?.ClearButtonIcon" aria-hidden="true" />
                    }
                </button>
            }
        </div>

        @if (ShowSearchButton)
        {
            @* A visible label already names the button, so repeating it in an aria-label would only
               override what is written on it with a second, unrelated string. *@
            <button @onclick="HandleOnSearchButtonClick"
                    type="button"
                    style="@Styles?.SearchButton"
                    disabled="@(IsEnabled is false)"
                    class="bit-srb-sbn @Classes?.SearchButton"
                    title="@(SearchButtonText.HasValue() ? null : SearchButtonAriaLabel)"
                    aria-label="@(SearchButtonText.HasValue() ? null : SearchButtonAriaLabel)">
                @if (SearchButtonTemplate is not null)
                {
                    @SearchButtonTemplate
                }
                else
                {
                    @* The default glyph is a directional arrow and is marked as such, because it is the one
                       the RTL layout has to mirror; an icon the app chose means the same thing both ways. *@
                    var isDefaultSearchIcon = SearchButtonIcon is null && SearchButtonIconName is null;
                    var searchButtonIcon = BitIconInfo.From(SearchButtonIcon, SearchButtonIconName ?? "ChromeBackMirrored");
                    <i style="@Styles?.SearchButtonIcon" aria-hidden="true"
                       class="@searchButtonIcon?.GetCssClasses() @(isDefaultSearchIcon ? "bit-srb-dsi" : null) @Classes?.SearchButtonIcon" />

                    if (SearchButtonText.HasValue())
                    {
                        <span style="@Styles?.SearchButtonText" class="bit-srb-sbx @Classes?.SearchButtonText">@SearchButtonText</span>
                    }
                }
            </button>
        }
    </div>

    @if (HasErrorMessage)
    {
        @* Above the description rather than below it: what is wrong with the value is the first thing to
           read under the field. It carries no live role of its own - the region at the end of the
           component is what announces it, so it is never read out twice. *@
        <div id="@_errorId"
             style="@Styles?.ErrorMessageContainer"
             class="bit-srb-erm @Classes?.ErrorMessageContainer">
            @if (ErrorMessageTemplate is not null)
            {
                @ErrorMessageTemplate
            }
            else
            {
                <span style="@Styles?.ErrorMessage" class="@Classes?.ErrorMessage">@ErrorMessage</span>
            }
        </div>
    }

    @if (HasDescription)
    {
        @* A div rather than a span: a DescriptionTemplate is free to render block content, which is
           not valid inside a span. *@
        <div id="@_descriptionId"
             style="@Styles?.DescriptionContainer"
             class="bit-srb-des @Classes?.DescriptionContainer">
            @if (DescriptionTemplate is not null)
            {
                @DescriptionTemplate
            }
            else if (Description.HasValue())
            {
                <span style="@Styles?.Description" class="@Classes?.Description">@Description</span>
            }
        </div>
    }

    @if (AriaDescription.HasValue())
    {
        @* aria-describedby takes an id reference, so the description text has to live in an element of
           its own. It is visually hidden and only exists for the assistive technologies. *@
        <span id="@_ariaDescriptionId" class="bit-srb-ard">@AriaDescription</span>
    }

    @* The only channel a screen reader has for the outcome of a search: how many suggestions were
       found, that there were none, or that the term is still too short to search at all. It lives
       outside of the callout on purpose, since the content of a display:none callout is never announced. *@
    @if (_hasSuggestSource)
    {
        <div role="status"
             aria-live="polite"
             aria-atomic="true"
             class="bit-srb-lvr">@_announcement</div>
    }

    @* A status rather than an alert: a rejection must not steal the focus or interrupt what is being
       typed, only be announced once the reader is done with the current sentence. It is rendered whether
       or not it has anything to say, because a live region that arrives with its text already in it is
       the one thing screen readers are known to miss. It is kept apart from the suggest region above,
       which is rewritten on every keystroke and would bury the rejection on the very next one. *@
    <span role="status" class="bit-srb-elv">@LiveText</span>

</div>

@if (_hasSuggestSource)
{
    if (Modeless is false)
    {
        <div @onclick="CloseCallout"
             id="@_overlayId"
             aria-hidden="true"
             class="bit-srb-ovl @Classes?.Overlay"
             style="display:@(_isOpen ? "block" : "none");@Styles?.Overlay" />
    }

    @* The callout is a sibling of the root element rather than a child of it, so it inherits neither
       the direction nor the animation opt-out of the component and has to be given both by hand. *@
    <div id="@_calloutId"
         style="@Styles?.Callout"
         dir="@Dir?.ToString().ToLower()"
         class="bit-srb-cal @_calloutSizeClass @_calloutColorClass @(ReadOnly ? "bit-srb-rol" : null) @(DisableAnimation ? "bit-srb-nan" : null) @Classes?.Callout">

        @if (CalloutHeaderTemplate is not null)
        {
            <div style="@Styles?.CalloutHeader"
                 class="bit-srb-chd @Classes?.CalloutHeader">
                @CalloutHeaderTemplate
            </div>
        }

        @{
            @* Why nothing is being suggested yet, which is otherwise indistinguishable from a search
               that ran and found nothing. *@
            var minCharsHint = GetMinSuggestTriggerCharsText();
        }

        @* These three are purely visual: the live region of the component is what actually reports
           the loading, the empty and the too-short states to the assistive technologies, so giving
           them a role of their own here would only make a screen reader say the very same thing twice. *@
        @if (minCharsHint is not null)
        {
            <div aria-hidden="true"
                 style="@Styles?.Hint"
                 class="bit-srb-hnt @Classes?.Hint">
                @minCharsHint
            </div>
        }
        else if (_isLoading)
        {
            <div aria-hidden="true"
                 style="@Styles?.Loading"
                 class="bit-srb-lod @Classes?.Loading">
                @if (LoadingTemplate is not null)
                {
                    @LoadingTemplate
                }
                else
                {
                    <div class="bit-srb-spn" aria-hidden="true" />
                    @if (LoadingText.HasValue())
                    {
                        <span>@LoadingText</span>
                    }
                }
            </div>
        }
        else if (_suggestFailed && HasSuggestFailedContent)
        {
            <div aria-hidden="true"
                 style="@Styles?.SuggestFailed"
                 class="bit-srb-fld @Classes?.SuggestFailed">
                @if (SuggestFailedTemplate is not null)
                {
                    @SuggestFailedTemplate
                }
                else
                {
                    @SuggestFailedText
                }
            </div>
        }
        else if (_searchTriggered && _suggestFailed is false && _viewSuggestedItems.Count == 0)
        {
            @if (NoResultsTemplate is not null)
            {
                <div aria-hidden="true"
                     style="@Styles?.NoResults"
                     class="bit-srb-nrs @Classes?.NoResults">
                    @NoResultsTemplate
                </div>
            }
            else if (NoResultsText.HasValue())
            {
                <div aria-hidden="true"
                     style="@Styles?.NoResults"
                     class="bit-srb-nrs @Classes?.NoResults">
                    @NoResultsText
                </div>
            }
        }

        <div id="@_scrollContainerId"
             role="listbox"
             aria-label="@SuggestItemsAriaLabel"
             aria-busy="@(_isLoading ? "true" : null)"
             style="@Styles?.ScrollContainer"
             class="bit-srb-scn @Classes?.ScrollContainer">
            @foreach (var (text, index) in _viewSuggestedItems.Select((t, i) => (t, i)))
            {
                var isSelected = index == _selectedIndex;
                @* Keyed by position rather than by text: the ids the aria-activedescendant of the input
                   points at are built from the index, so a row has to keep the index it was rendered with. *@
                <div @key="index" role="presentation" style="@Styles?.SuggestItemWrapper" class="@Classes?.SuggestItemWrapper">
                    @* Read-only blocks picking a suggestion but not browsing the list, so the rows stay in
                       the accessibility tree and stay reachable with the arrow keys - and say that they
                       cannot be chosen, rather than silently swallowing the attempt. The native disabled
                       attribute is deliberately not used: it would take them out of that tree altogether. *@
                    <button @onclick="() => HandleOnSuggestedItemClick(text)"
                            @onmousedown:preventDefault="true"
                            id="@GetItemId(index)"
                            tabindex="-1"
                            type="button"
                            role="option"
                            title="@text"
                            aria-disabled="@(ReadOnly ? "true" : null)"
                            style="@Styles?.SuggestItemButton"
                            aria-posinset="@(index + 1)"
                            aria-setsize="@_viewSuggestedItems.Count"
                            aria-selected="@(isSelected ? "true" : "false")"
                            class="bit-srb-itm@(isSelected ? " bit-srb-sel" : "") @Classes?.SuggestItemButton">
                        @if (SuggestItemTemplate is not null)
                        {
                            @SuggestItemTemplate(text)
                        }
                        else
                        {
                            <span style="@Styles?.SuggestItemText"
                                  class="@Classes?.SuggestItemText">
                                @if (HighlightSuggestItems)
                                {
                                    @foreach (var segment in GetHighlightSegments(text))
                                    {
                                        if (segment.IsMatch)
                                        {
                                            <mark style="@Styles?.SuggestItemHighlight"
                                                  class="bit-srb-hlt @Classes?.SuggestItemHighlight">@segment.Text</mark>
                                        }
                                        else
                                        {
                                            @segment.Text
                                        }
                                    }
                                }
                                else
                                {
                                    @text
                                }
                            </span>
                        }
                    </button>
                </div>
            }
        </div>

        @if (CalloutFooterTemplate is not null)
        {
            <div style="@Styles?.CalloutFooter"
                 class="bit-srb-cft @Classes?.CalloutFooter">
                @CalloutFooterTemplate
            </div>
        }

    </div>
}
