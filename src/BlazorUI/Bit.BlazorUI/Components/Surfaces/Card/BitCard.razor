@namespace Bit.BlazorUI
@inherits BitComponentBase

@{
    var icon = BitIconInfo.From(Icon, IconName);

    @* A custom header takes the place of the icon, the title and the subtitle, so neither of those two lines is
       on the card any more - and neither of their ids is on the page. Anything that points at one of them, the
       name of the stretched link above all, has to know that: an aria-labelledby aimed at an element that was
       never rendered leaves the thing it names with no name at all. *@
    var hasHeaderTemplate = HeaderTemplate is not null;

    var hasTitle = hasHeaderTemplate is false && Title.HasValue();
    var hasSubtitle = hasHeaderTemplate is false && Subtitle.HasValue();
    var titleId = hasTitle ? $"{_Id}-ttl" : null;
    var subtitleId = hasSubtitle ? $"{_Id}-sub" : null;

    @* An attribute written after the splat wins over the one the app passed in through HtmlAttributes, and a
       null one takes it off the element altogether. What the card has of its own therefore comes first, but
       it falls back to whatever came in with the attributes, however the app cased its name (see
       BitComponentBase.GetSplattedAttribute). *@
    var splattedRole = _SplattedRole;
    var splattedLabel = GetSplattedAttribute("aria-label");
    var splattedTabIndex = GetSplattedAttribute("tabindex");
    var splattedLabelledBy = GetSplattedAttribute("aria-labelledby");

    var label = AriaLabel ?? splattedLabel;
    var tabIndex = TabIndex ?? splattedTabIndex;

    @* The name of a card that stretches a link or a button over itself belongs to that control, which is what a
       reader lands on; a copy of it on the wrapper as well would have the same words announced twice. Anywhere
       else the name stays on the root. *@
    var labelOnRoot = _HasStretchedControl is false;

    @* A card that is not a control but does carry a name - through AriaLabel, or through an aria-labelledby
       pointing at a heading elsewhere on the page - needs a role for that name to be announced at all, since a
       name on a plain div is not guaranteed to be read, and "group" is the role of a box that holds related
       things without being a landmark. A role the app splatted in itself always wins. *@
    var isNamed = label.HasValue() || splattedLabelledBy.HasValue();
    var role = splattedRole ?? (labelOnRoot && isNamed ? "group" : null);

    @* Some roles present their children: what is inside one of them is read as the name of the control rather
       than as structure, so nothing in there is ever reached on its own. A card splatted with one - an option or
       a tab above all - therefore has no heading in it whatever the page asks for, and a heading role that can
       never be reached is one more thing for a validator to flag. The list is the one ARIA gives for "children
       presentational: true". The button of a clickable card is stretched over its content rather than wrapped
       around it, so a clickable card keeps its heading. *@
    var presentsItsChildren = role is "button" or "checkbox" or "img" or "menuitemcheckbox" or "menuitemradio"
                                   or "option" or "progressbar" or "radio" or "scrollbar" or "separator"
                                   or "slider" or "switch" or "tab";

    @* A card title is the heading of the section the card is, but only where the page says so: a level turns
       it into one, and without a level it stays the plain line of text it looks like. The heading is a div
       carrying role/aria-level rather than an h1-h6, so no user-agent heading styles have to be undone. *@
    var headingLevel = presentsItsChildren is false && HeadingLevel is >= 1 and <= 6 ? HeadingLevel : null;

    @* A card that carries a selection reports it with the state its control actually carries: a button - the
       one stretched over a clickable card, or a root splatted with that role - says aria-pressed, while the
       roles that make a card an item of a list, a grid or a tab strip say aria-selected instead, and the roles
       that make it a box to tick say aria-checked. A card with none of them has nothing to report the state with
       and is left with only the ring to show for it. *@
    var selectedRole = role is "option" or "row" or "gridcell" or "tab" or "treeitem" or "columnheader" or "rowheader";
    var checkedRole = role is "checkbox" or "switch" or "radio" or "menuitemcheckbox" or "menuitemradio";
    var selectedState = _IsSelectable ? (Selected ? "true" : "false") : null;

    @* aria-disabled is a widget attribute rather than a global one: a div with no role of its own maps to the
       generic role, which prohibits it, and a validator flags it there. It is only reported where the card has
       a role that can carry it - the group it becomes with a name, or whatever the app splatted in. What
       actually takes a disabled card off the pointer and out of the tab order is the bit-dis class and the
       missing tab index, and neither of those depends on this. The states the card does not report itself are the
       ones the app splatted in, written back rather than wiped by a null. *@
    var ariaPressed = (role is "button" ? selectedState : null) ?? GetSplattedAttribute("aria-pressed");
    var ariaSelected = (selectedRole ? selectedState : null) ?? GetSplattedAttribute("aria-selected");
    var ariaChecked = (checkedRole ? selectedState : null) ?? GetSplattedAttribute("aria-checked");
    var ariaBusy = Loading ? "true" : GetSplattedAttribute("aria-busy");
    var ariaDisabled = role is not null && Disabled ? "true" : GetSplattedAttribute("aria-disabled");

    @* The stretched link or button carries no text of its own, so what names it is whatever the card was named
       by: an aria-labelledby the app splatted in, or failing that the title of the card, or failing that its
       subtitle, which is the only other thing on the card that says what it is. A card with none of them - one
       whose header is a template above all - is named by its body, which leaves the controls of its Actions,
       Footer and FloatingActions out of the name: each of them is a tab stop announced on its own, and folded
       into the name as well it would be read out again on every stop of the card. Only a card with no body to
       point at either - a plain padded box, or one that is still loading - is named by everything it says,
       which is verbose but never nameless; an AriaLabel says it shorter. *@
    var bodyId = _IsSectioned && Loading is false && ChildContent is not null ? $"{_Id}-bdy" : null;
    var stretchedLabelledBy = label.HasValue() ? null : (splattedLabelledBy ?? titleId ?? subtitleId ?? bodyId ?? _Id);
    var bodyNamesControl = _HasStretchedControl && bodyId is not null && stretchedLabelledBy == bodyId;

    @* A control named by the title leaves the subtitle beside it unread - a reader tabbing through a page of
       cards hears "Theming, link" and never the "5 min read" under it - so the subtitle describes it instead. It
       does not where it is already the name, nor where the app named the control itself and chose what it says. *@
    var stretchedDescribedBy = titleId is not null && stretchedLabelledBy == titleId ? subtitleId : null;

    @* A card that stretches a control over itself hands its tab index to that control, which is what a reader
       lands on; a copy of it on the wrapper as well would be two tab stops on something the reader sees as a
       single thing. A root the app made a control through a role of its own is reachable by the keyboard without
       being asked, and a disabled card of any kind leaves the tab order altogether - a stop the keyboard can
       still land on but nothing answers on is worse than no stop at all. *@
    var rootTabIndex = _HasStretchedControl || Disabled ? null : (_IsRootControl ? (tabIndex ?? "0") : tabIndex);

    @* The keys a root made a control answers - Enter as it goes down, Space as it comes back up, neither one
       scrolling the page - are wired up in the browser (see OnAfterRenderAsync), where they turn into this same
       click. The stretched button answers them natively, and its click bubbles up to here like any other. *@
    var onClick = _IsClickable
                ? EventCallback.Factory.Create<MouseEventArgs>(this, HandleOnClick)
                : default;
}

<div @ref="RootElement" @attributes="DisabledAwareHtmlAttributes"
     @onclick="onClick"
     @onclick:stopPropagation="StopPropagation"
     id="@_Id"
     role="@role"
     tabindex="@rootTabIndex"
     aria-label="@(labelOnRoot ? label : null)"
     aria-labelledby="@(labelOnRoot ? splattedLabelledBy : null)"
     aria-pressed="@ariaPressed"
     aria-selected="@ariaSelected"
     aria-checked="@ariaChecked"
     aria-busy="@ariaBusy"
     aria-disabled="@ariaDisabled"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">
    @if (_IsLink)
    {
        @* The card is not wrapped in the anchor: an anchor around the whole card is invalid the moment the
           card holds a link or a button of its own, and a screen reader reads the entire card out as the name
           of that one link. The anchor is laid over the surface instead, which is the block-link pattern every
           design system settled on, and it is named after whatever names the card - its label, the heading an
           aria-labelledby points at, its title - so a page of linked cards reads as a list of destinations
           rather than a list of identical links. A disabled card takes the href off, and with it the implicit
           link role an anchor only has while it has one, so the role is put back: without it the anchor is a
           generic element, which may carry neither aria-disabled nor a name. *@
        <a @ref="_stretchedRef"
           style="@Styles?.Link"
           class="bit-crd-lnk @Classes?.Link"
           href="@(Disabled ? null : Href)"
           rel="@_rel"
           target="@Target"
           download="@Download"
           tabindex="@(Disabled ? "-1" : tabIndex)"
           aria-disabled="@(Disabled ? "true" : null)"
           aria-labelledby="@stretchedLabelledBy"
           aria-describedby="@stretchedDescribedBy"
           role="@(Disabled ? "link" : null)"
           aria-label="@label"></a>
    }
    else if (_IsStretchedButton)
    {
        @* The same pattern for a card that does something rather than leading somewhere. The root is not made a
           button: the children of a button are presentational, so the controls in its Actions, Footer and
           FloatingActions would be controls nested in another one - which no screen reader reaches on their own -
           and its title could never be a heading. A native button laid over the surface answers Enter and Space
           by itself, and its click bubbles up to the handler of the root like a click anywhere else on the card.

           Unlike the anchor, it is there for the keyboard and for assistive technologies alone and lets the pointer
           through (see .bit-crd-lnk in BitCard.scss): the root already answers a click anywhere on the card, so the
           pointer loses nothing, while the body keeps scrolling under the wheel and the controls in it stay within
           reach of the pointer as they are of the keyboard. *@
        <button @ref="_stretchedRef"
                type="button"
                style="@Styles?.Link"
                class="bit-crd-lnk @Classes?.Link"
                disabled="@(Disabled)"
                tabindex="@tabIndex"
                aria-pressed="@selectedState"
                aria-labelledby="@stretchedLabelledBy"
                aria-describedby="@stretchedDescribedBy"
                aria-label="@label"></button>
    }

    @if (FloatingActions is not null)
    {
        @* Over the surface rather than in the column of parts, and over the stretched link with it, so the control a
           picture card keeps in its corner is reachable on a card whose header is under the picture - or on a card
           that has no header at all.

           Like the two slots inside the column of parts, it keeps the clicks of the controls in it away from a card
           that has one of its own: pressing the favourite toggle of such a card is pressing the toggle, and not the
           card under it as well - and a key pressed on one of them stays here too, so it does not also act on
           whatever holds the card, a list or a grid answering Enter on the item the card is. *@
        <div @onclick:stopPropagation="_IsClickable"
             @onkeydown:stopPropagation="_IsClickable"
             style="@Styles?.FloatingActions"
             class="bit-crd-fac @Classes?.FloatingActions">@FloatingActions</div>
    }

    @if (_IsSectioned)
    {
        @if (_HasCover)
        {
            <div style="@Styles?.Cover" class="bit-crd-cvr @Classes?.Cover">
                @if (Cover is not null)
                {
                    @Cover
                }
                else
                {
                    <img src="@ImageUrl"
                         alt="@(ImageAlt ?? string.Empty)"
                         loading="@ImageLoading?.ToString().ToLower()"
                         style="@Styles?.Image"
                         class="bit-crd-img @Classes?.Image" />
                }
            </div>
        }

        @* The column of everything that is not the cover. A card that is only a cover has nothing to put in it,
           and rendering it anyway would leave the block padding of the column hanging under the picture. *@
        @if (_HasMain)
        {
            <div style="@Styles?.Main" class="bit-crd-mai @Classes?.Main">
                @if (_HasHeader)
                {
                    <div style="@Styles?.Header" class="bit-crd-hdr @Classes?.Header">
                        @if (HeaderTemplate is not null)
                        {
                            @HeaderTemplate
                        }
                        else
                        {
                            @* The leading slot of the header. A template takes the place of the glyph, so an avatar, a
                               logo or a thumbnail can lead the header without a HeaderTemplate having to take the title
                               and the subtitle - and the name of the stretched link with them - off the card. *@
                            @if (IconTemplate is not null)
                            {
                                <div style="@Styles?.Icon" class="bit-crd-hic @Classes?.Icon">@IconTemplate</div>
                            }
                            else if (icon is not null)
                            {
                                <i aria-hidden="true" style="@Styles?.Icon" class="bit-crd-hic @icon.GetCssClasses() @Classes?.Icon" />
                            }

                            @if (hasTitle || hasSubtitle)
                            {
                                <div style="@Styles?.HeaderText" class="bit-crd-htx @Classes?.HeaderText">
                                    @if (hasTitle)
                                    {
                                        <div id="@titleId"
                                             role="@(headingLevel is null ? null : "heading")"
                                             aria-level="@headingLevel"
                                             style="@Styles?.Title"
                                             class="bit-crd-ttl @Classes?.Title">@Title</div>
                                    }

                                    @if (hasSubtitle)
                                    {
                                        <div id="@subtitleId" style="@Styles?.Subtitle" class="bit-crd-sub @Classes?.Subtitle">@Subtitle</div>
                                    }
                                </div>
                            }
                        }

                        @if (Actions is not null)
                        {
                            @* Outside the title block and raised above the stretched link, so the controls it holds
                               are controls of their own rather than part of whatever the card leads to - and on a card
                               that has a click of its own, the click and the keys stop here rather than reaching
                               the root and what holds it as well, so acting on the menu of a card is not also acting
                               on the card. *@
                            <div @onclick:stopPropagation="_IsClickable"
                                 @onkeydown:stopPropagation="_IsClickable"
                                 style="@Styles?.Actions"
                                 class="bit-crd-act @Classes?.Actions">@Actions</div>
                        }
                    </div>
                }

                @if (Loading)
                {
                    @* The body of a card whose content has not arrived yet. The header stays put - the title of a
                       card is known before its content is - and only what is still being fetched is stood in for. *@
                    <div style="@Styles?.Body" class="bit-crd-bdy @Classes?.Body">
                        @if (LoadingTemplate is not null)
                        {
                            @LoadingTemplate
                        }
                        else
                        {
                            @* The card's own bars rather than BitShimmers: a shimmer re-skinned on its own would otherwise
                               re-skin this placeholder too. They carry nothing to read - the aria-busy of the root already
                               says the content is on its way - so they are hidden from assistive technologies. *@
                            <div style="@Styles?.Skeleton" class="bit-crd-skl @Classes?.Skeleton" aria-hidden="true">
                                <div style="@Styles?.SkeletonBar" class="bit-crd-skb @Classes?.SkeletonBar"></div>
                                <div style="@Styles?.SkeletonBar" class="bit-crd-skb @Classes?.SkeletonBar"></div>
                                <div style="@Styles?.SkeletonBar" class="bit-crd-skb @Classes?.SkeletonBar"></div>
                            </div>
                        }
                    </div>
                }
                else if (ChildContent is not null)
                {
                    <div id="@(bodyNamesControl ? bodyId : null)" style="@Styles?.Body" class="bit-crd-bdy @Classes?.Body">@ChildContent</div>
                }

                @if (Footer is not null)
                {
                    @* Raised above the stretched link for the same reason the header actions are: the buttons of a
                       linked card have to stay reachable by the pointer and by the keyboard, and their clicks and
                       keys stop here on a card that has a click of its own rather than firing it a second time. *@
                    <div @onclick:stopPropagation="_IsClickable"
                         @onkeydown:stopPropagation="_IsClickable"
                         style="@Styles?.Footer"
                         class="bit-crd-ftr @Classes?.Footer">@Footer</div>
                }
            </div>
        }
    }
    else
    {
        @ChildContent
    }
</div>
