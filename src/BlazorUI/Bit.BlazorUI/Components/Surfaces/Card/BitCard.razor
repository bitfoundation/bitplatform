@namespace Bit.BlazorUI
@inherits BitComponentBase

@{
    var icon = BitIconInfo.From(Icon, IconName);

    @* A custom header takes the place of the icon, the title and the subtitle, so neither of those two lines is
       on the card any more - and neither of their ids is on the page. Anything that points at one of them, the
       name of the stretched link above all, has to know that: an aria-labelledby aimed at an element that was
       never rendered leaves the thing it names with no name at all. *@
    var hasHeaderTemplate = HeaderTemplate is not null;

    var hasTitle = hasHeaderTemplate is false && Title.HasValue();
    var hasSubtitle = hasHeaderTemplate is false && Subtitle.HasValue();
    var titleId = hasTitle ? $"{_Id}-ttl" : null;
    var subtitleId = hasSubtitle ? $"{_Id}-sub" : null;

    @* An attribute written after the splat wins over the one the app passed in through HtmlAttributes, and a
       null one takes it off the element altogether. What the card has of its own therefore comes first, but
       it falls back to whatever came in with the attributes. *@
    var splattedRole = HtmlAttributes.TryGetValue("role", out var srl) ? srl?.ToString() : null;
    var splattedLabel = HtmlAttributes.TryGetValue("aria-label", out var sal) ? sal?.ToString() : null;
    var splattedTabIndex = HtmlAttributes.TryGetValue("tabindex", out var sti) ? sti?.ToString() : null;
    var splattedLabelledBy = HtmlAttributes.TryGetValue("aria-labelledby", out var slb) ? slb?.ToString() : null;

    var label = AriaLabel ?? splattedLabel;
    var tabIndex = TabIndex ?? splattedTabIndex;

    @* The name of a linked card belongs to the anchor stretched over it, which is the control a reader lands
       on; a copy of it on the wrapper as well would have the same words announced twice. Anywhere else the
       name stays on the root. *@
    var labelOnRoot = _IsLink is false;

    @* A clickable card is a button in everything but its tag name, so it reports itself as one. A card that
       is not a control but does carry a name - through AriaLabel, or through an aria-labelledby pointing at a
       heading elsewhere on the page - needs a role for that name to be announced at all, since a name on a
       plain div is not guaranteed to be read, and "group" is the role of a box that holds related things
       without being a landmark. A role the app splatted in itself always wins over both. *@
    var isNamed = label.HasValue() || splattedLabelledBy.HasValue();
    var role = splattedRole ?? (_IsButton ? "button" : (labelOnRoot && isNamed ? "group" : null));

    @* Some roles present their children: what is inside one of them is read as the name of the control rather
       than as structure, so nothing in there is ever reached on its own. A card wearing one - the button it
       becomes with a click handler above all, but an option or a tab splatted in just the same - therefore has
       no heading in it whatever the page asks for, and a heading role that can never be reached is one more
       thing for a validator to flag. The list is the one ARIA gives for "children presentational: true". *@
    var presentsItsChildren = role is "button" or "checkbox" or "img" or "menuitemcheckbox" or "menuitemradio"
                                   or "option" or "progressbar" or "radio" or "scrollbar" or "separator"
                                   or "slider" or "switch" or "tab";

    @* A card title is the heading of the section the card is, but only where the page says so: a level turns
       it into one, and without a level it stays the plain line of text it looks like. The heading is a div
       carrying role/aria-level rather than an h1-h6, so no user-agent heading styles have to be undone. *@
    var headingLevel = presentsItsChildren is false && HeadingLevel is >= 1 and <= 6 ? HeadingLevel : null;

    @* A card that carries a selection reports it with the state the role it ended up with actually carries: a
       button says aria-pressed, while the roles that make a card an item of a list, a grid or a tab strip say
       aria-selected instead. A card with neither role has nothing to report the state with - which is why the
       Selected docs ask for such a role to be splatted in - and is left with only the ring to show for it. *@
    var selectedRole = role is "option" or "row" or "gridcell" or "tab" or "treeitem" or "columnheader" or "rowheader";
    var selectedState = _IsSelectable ? (Selected ? "true" : "false") : null;

    @* aria-disabled is a widget attribute rather than a global one: a div with no role of its own maps to the
       generic role, which prohibits it, and a validator flags it there. It is only reported where the card has
       a role that can carry it - the button it becomes with a click handler, the group it becomes with a name,
       or whatever the app splatted in. What actually takes a disabled card off the pointer and out of the tab
       order is the bit-dis class and the missing tab index, and neither of those depends on this. *@

    @* The stretched link carries no text of its own, so what names it is whatever the card was named by: an
       aria-labelledby the app splatted in, or failing that the title of the card, or failing that its subtitle,
       which is the only other thing on the card that says what it is. A linked card with none of them has
       nothing to be named by and needs an AriaLabel. *@
    var linkLabelledBy = label.HasValue() ? null : (splattedLabelledBy ?? titleId ?? subtitleId);

    @* A linked card hands its tab index to the anchor stretched over it, which is the control a reader lands
       on; a copy of it on the wrapper as well would be two tab stops on something the reader sees as a single
       thing. A card that is a button is reachable by the keyboard without being asked, and a disabled card of
       any kind leaves the tab order altogether - a stop the keyboard can still land on but nothing answers on
       is worse than no stop at all. *@
    var rootTabIndex = _IsLink || IsEnabled is false ? null : (_IsButton ? (tabIndex ?? "0") : tabIndex);

    var onClick = OnClick.HasDelegate || _IsToggle
                ? EventCallback.Factory.Create<MouseEventArgs>(this, HandleOnClick)
                : default;

    @* Nothing listens for a key on a card that is not a control - an empty callback still costs a round trip
       to the server on every keystroke of a Blazor Server app. *@
    var onKeyDown = _IsButton
                  ? EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleOnKeyDown)
                  : default;
}

<div @ref="RootElement" @attributes="HtmlAttributes"
     @onclick="onClick"
     @onclick:stopPropagation="StopPropagation"
     @onkeydown="onKeyDown"
     id="@_Id"
     role="@role"
     tabindex="@rootTabIndex"
     aria-label="@(labelOnRoot ? label : null)"
     aria-labelledby="@(labelOnRoot ? splattedLabelledBy : null)"
     aria-pressed="@(role is "button" ? selectedState : null)"
     aria-selected="@(selectedRole ? selectedState : null)"
     aria-busy="@(Loading ? "true" : null)"
     aria-disabled="@(role is not null && IsEnabled is false ? "true" : null)"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">
    @if (_IsLink)
    {
        @* The card is not wrapped in the anchor: an anchor around the whole card is invalid the moment the
           card holds a link or a button of its own, and a screen reader reads the entire card out as the name
           of that one link. The anchor is laid over the surface instead, which is the block-link pattern every
           design system settled on, and it is named after whatever names the card - its label, the heading an
           aria-labelledby points at, its title - so a page of linked cards reads as a list of destinations
           rather than a list of identical links. *@
        <a @ref="_linkRef"
           style="@Styles?.Link"
           class="bit-crd-lnk @Classes?.Link"
           href="@(IsEnabled ? Href : null)"
           rel="@_rel"
           target="@Target"
           download="@Download"
           tabindex="@(IsEnabled ? tabIndex : "-1")"
           aria-disabled="@(IsEnabled ? null : "true")"
           aria-labelledby="@linkLabelledBy"
           aria-label="@label"></a>
    }

    @if (FloatingActions is not null)
    {
        @* Over the surface rather than in the column of parts, and over the stretched link with it, so the control a
           picture card keeps in its corner is reachable on a card whose header is under the picture - or on a card
           that has no header at all.

           Like the two slots inside the column of parts, it keeps the events of the controls in it away from the click
           of a card that has one of its own: pressing the favourite toggle of such a card is pressing the toggle, and
           not the card under it as well. *@
        <div @onclick:stopPropagation="_IsClickable"
             @onkeydown:stopPropagation="_IsClickable"
             style="@Styles?.FloatingActions"
             class="bit-crd-fac @Classes?.FloatingActions">@FloatingActions</div>
    }

    @if (_IsSectioned)
    {
        @if (_HasCover)
        {
            <div style="@Styles?.Cover" class="bit-crd-cvr @Classes?.Cover">
                @if (Cover is not null)
                {
                    @Cover
                }
                else
                {
                    <img src="@ImageUrl"
                         alt="@(ImageAlt ?? string.Empty)"
                         loading="@ImageLoading?.ToString().ToLower()"
                         style="@Styles?.Image"
                         class="bit-crd-img @Classes?.Image" />
                }
            </div>
        }

        @* The column of everything that is not the cover. A card that is only a cover has nothing to put in it,
           and rendering it anyway would leave the block padding of the column hanging under the picture. *@
        @if (_HasMain)
        {
            <div style="@Styles?.Main" class="bit-crd-mai @Classes?.Main">
                @if (_HasHeader)
                {
                    <div style="@Styles?.Header" class="bit-crd-hdr @Classes?.Header">
                        @if (HeaderTemplate is not null)
                        {
                            @HeaderTemplate
                        }
                        else
                        {
                            @* The leading slot of the header. A template takes the place of the glyph, so an avatar, a
                               logo or a thumbnail can lead the header without a HeaderTemplate having to take the title
                               and the subtitle - and the name of the stretched link with them - off the card. *@
                            @if (IconTemplate is not null)
                            {
                                <div style="@Styles?.Icon" class="bit-crd-hic @Classes?.Icon">@IconTemplate</div>
                            }
                            else if (icon is not null)
                            {
                                <i aria-hidden="true" style="@Styles?.Icon" class="bit-crd-hic @icon.GetCssClasses() @Classes?.Icon" />
                            }

                            @if (hasTitle || hasSubtitle)
                            {
                                <div style="@Styles?.HeaderText" class="bit-crd-htx @Classes?.HeaderText">
                                    @if (hasTitle)
                                    {
                                        <div id="@titleId"
                                             role="@(headingLevel is null ? null : "heading")"
                                             aria-level="@headingLevel"
                                             style="@Styles?.Title"
                                             class="bit-crd-ttl @Classes?.Title">@Title</div>
                                    }

                                    @if (hasSubtitle)
                                    {
                                        <div id="@subtitleId" style="@Styles?.Subtitle" class="bit-crd-sub @Classes?.Subtitle">@Subtitle</div>
                                    }
                                </div>
                            }
                        }

                        @if (Actions is not null)
                        {
                            @* Outside the title block and raised above the stretched link, so the controls it holds
                               are controls of their own rather than part of whatever the card leads to - and on a card
                               that has a click of its own, the click and the key press stop here rather than reaching
                               the root as well, so acting on the menu of a card is not also acting on the card. *@
                            <div @onclick:stopPropagation="_IsClickable"
                                 @onkeydown:stopPropagation="_IsClickable"
                                 style="@Styles?.Actions"
                                 class="bit-crd-act @Classes?.Actions">@Actions</div>
                        }
                    </div>
                }

                @if (Loading)
                {
                    @* The body of a card whose content has not arrived yet. The header stays put - the title of a
                       card is known before its content is - and only what is still being fetched is stood in for. *@
                    <div style="@Styles?.Body" class="bit-crd-bdy @Classes?.Body">
                        @if (LoadingTemplate is not null)
                        {
                            @LoadingTemplate
                        }
                        else
                        {
                            <div class="bit-crd-skl">
                                <BitShimmer Width="100%" Height="0.75rem" />
                                <BitShimmer Width="90%" Height="0.75rem" />
                                <BitShimmer Width="60%" Height="0.75rem" />
                            </div>
                        }
                    </div>
                }
                else if (ChildContent is not null)
                {
                    <div style="@Styles?.Body" class="bit-crd-bdy @Classes?.Body">@ChildContent</div>
                }

                @if (Footer is not null)
                {
                    @* Raised above the stretched link for the same reason the header actions are: the buttons of a
                       linked card have to stay reachable by the pointer and by the keyboard, and their events stop
                       here on a card that has a click of its own rather than firing it a second time. *@
                    <div @onclick:stopPropagation="_IsClickable"
                         @onkeydown:stopPropagation="_IsClickable"
                         style="@Styles?.Footer"
                         class="bit-crd-ftr @Classes?.Footer">@Footer</div>
                }
            </div>
        }
    }
    else
    {
        @ChildContent
    }
</div>
