@namespace Bit.BlazorUI
@inherits BitComponentBase

<div @ref="RootElement" @attributes="HtmlAttributes"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()"
     aria-label="@AriaLabel">
    <div style="@Styles?.HeaderWrapper" class="bit-acd-hwr @Classes?.HeaderWrapper">
        @* The APG asks for the toggle to be the only thing inside a heading, so anything else the header
           carries (the Actions slot) is a sibling of the heading rather than a child of it: content inside
           the heading would otherwise be read as part of the heading text, and an interactive element there
           would be nested inside the button. *@
        <div role="heading"
             aria-level="@_HeadingLevel"
             style="@Styles?.Heading"
             class="bit-acd-hed @Classes?.Heading">
            <button @onclick="HandleOnClick"
                    id="@_HeaderId"
                    type="button"
                    style="@Styles?.Header"
                    class="bit-acd-hdr @Classes?.Header"
                    aria-label="@HeaderAriaLabel"
                    aria-expanded="@(IsExpanded ? "true" : "false")"
                    aria-controls="@_ContentId"
                    aria-disabled="@(IsEnabled ? null : "true")"
                    tabindex="@(IsEnabled ? 0 : -1)">
                @if (HeaderTemplate is not null)
                {
                    @HeaderTemplate(IsExpanded)
                }
                else
                {
                    var icon = BitIconInfo.From(Icon, IconName);
                    var expandedIcon = BitIconInfo.From(ExpandedExpanderIcon, ExpandedExpanderIconName);
                    var expanderIcon = (IsExpanded && expandedIcon is not null)
                                     ? expandedIcon
                                     : BitIconInfo.From(ExpanderIcon, ExpanderIconName ?? "ChevronRight bit-ico-r90");
                    // A chevron that turns is the whole story of the state, but an icon that is swapped for
                    // another one when expanded already tells it, and turning that one as well only garbles it.
                    var rotated = IsExpanded && expandedIcon is null && NoExpanderRotation is false;

                    @if (icon is not null)
                    {
                        <i aria-hidden="true"
                           style="@Styles?.Icon"
                           class="bit-acd-ico @icon.GetCssClasses() @Classes?.Icon" />
                    }

                    <div style="@Styles?.HeaderContent" class="bit-acd-wrp @Classes?.HeaderContent">
                        <div style="@Styles?.Title" class="bit-acd-ttl @Classes?.Title">
                            @if (TitleTemplate is not null)
                            {
                                @TitleTemplate
                            }
                            else
                            {
                                @Title
                            }
                        </div>
                        @if (Description.HasValue())
                        {
                            <div style="@Styles?.Description" class="bit-acd-des @Classes?.Description">
                                @Description
                            </div>
                        }
                    </div>

                    @if (HideExpanderIcon is false)
                    {
                        <span style="@Styles?.ExpanderIconWrapper"
                              class="bit-acd-eiw @Classes?.ExpanderIconWrapper @(rotated ? "bit-ico--r180" : "")">
                            <i aria-hidden="true"
                               style="@JoinStyles(Styles?.ExpanderIcon, IsExpanded ? Styles?.ExpandedIcon : null)"
                               class="bit-acd-eic @expanderIcon?.GetCssClasses() @Classes?.ExpanderIcon @(IsExpanded ? Classes?.ExpandedIcon : "")" />
                        </span>
                    }
                }
            </button>
        </div>
        @if (Actions is not null)
        {
            <div style="@Styles?.Actions" class="bit-acd-act @Classes?.Actions">
                @Actions
            </div>
        }
    </div>

    @* The collapse is a grid track animating between 0fr and 1fr, which is the only cross-browser way to
       transition to the intrinsic height of the content: the padding therefore has to sit on the innermost
       element, since a border box can never be shorter than its own padding. *@
    <div style="@Styles?.ContentContainer" class="bit-acd-cnt @Classes?.ContentContainer">
        <div style="@Styles?.ContentWrapper" class="bit-acd-cwr @Classes?.ContentWrapper">
            <div id="@_ContentId"
                 role="region"
                 aria-labelledby="@_HeaderId"
                 style="@Styles?.Content"
                 class="bit-acd-con @(IsExpanded ? "bit-acd-cex" : "bit-acd-cco") @Classes?.Content"
                 tabindex="@(_IsContentFocusable ? "0" : null)">
                @if (_ShouldRenderContent)
                {
                    @(ChildContent ?? Body)
                }
            </div>
        </div>
    </div>
</div>
