@namespace Bit.BlazorUI
@inherits BitComponentBase

@if (IsOpen || KeptMounted)
{
    @* While a kept-mounted Dialog is closed it is still in the page, only hidden: inert and aria-hidden
       take it out of the tab sequence and out of the reading order for the browsers that would otherwise
       still reach into a display:none subtree through a stale reference. *@
    @* The keydown handler sits on the root so that Escape dismisses the Dialog from anywhere inside it -
       the surface, the overlay, whichever part of it the keyboard happens to be in. The keys stop here:
       a Dialog opened from inside another one renders inside that one's surface, so an Escape left to
       carry on up would dismiss the Dialog the keyboard is still working inside of along with the one it
       was meant for - and it stops only Blazor's own bubbling, so native listeners (the focus trap among
       them) still see the key.
       tabindex="-1" makes the root programmatically focusable so that a press on the overlay lands the focus
       inside the Dialog rather than on the body. The root only catches it: the focus trap passes it straight
       on into the surface below, where the dialog role is (Utils.setupFocusTrap has the whole of it). It is
       written ahead of the attributes of the consumer so that a tabindex of their own is the one that lands. *@
    <div @ref="RootElement"
         tabindex="@(TabIndex ?? "-1")"
         @attributes="HtmlAttributes"
         @onkeydown="HandleOnKeyDown"
         @onkeydown:stopPropagation="true"
         id="@_Id"
         style="@StyleBuilder.Value"
         class="@ClassBuilder.Value"
         dir="@Dir?.ToString().ToLower()"
         inert="@(IsOpen is false)"
         aria-hidden="@(IsOpen ? null : "true")">

        <div style="@Styles?.Document" class="bit-dlg-doc @GetPositionClass() @Classes?.Document">
            @if (IsModeless is false)
            {
                @* The press on the overlay is left its default action: it is what blurs the input the user
                   was typing into, and an input only commits what was typed once it loses the focus - before
                   the click the press turns into runs any dismissal handler. Where that focus lands is the
                   tabindex of the root above. *@
                <div style="@Styles?.Overlay" class="bit-dlg-ovl @Classes?.Overlay" aria-hidden="true"
                     @onclick="HandleOnOverlayClick" />
            }

            @* The surface is what carries the role and the accessible name, since that is the element the
               content lives in - a wrapper above the overlay would put the overlay inside the dialog for a
               screen reader. It is made programmatically focusable so that a Dialog holding nothing focusable
               still has somewhere to put the focus, which is what both the Escape key and the focus trap
               need: a keydown only reaches the handler on the root from inside it. *@
            <div id="@_containerId"
                 role="@GetRole()"
                 tabindex="-1"
                 aria-modal="@GetAriaModal()"
                 aria-label="@AriaLabel"
                 aria-labelledby="@GetLabelledBy()"
                 aria-describedby="@GetDescribedBy()"
                 style="@GetContainerStyle()"
                 class="bit-dlg-ctn @GetPreventedClasses() @Classes?.Container">
                @if (HasHeader)
                {
                    <div style="@Styles?.Header" class="bit-dlg-hdr @Classes?.Header">
                        @if (HeaderTemplate is not null)
                        {
                            <div class="bit-dlg-htc">@HeaderTemplate</div>
                        }
                        else if (Title.HasValue() || Subtitle.HasValue())
                        {
                            <div class="bit-dlg-htc">
                                @if (Title.HasValue())
                                {
                                    @* A heading rather than a plain div: the title is the heading of the
                                       Dialog, and a screen reader user navigating by heading expects to
                                       find it there rather than only through the accessible name. *@
                                    <div id="@_titleId" role="heading" aria-level="2" style="@Styles?.Title" class="bit-dlg-ttl @Classes?.Title">@Title</div>
                                }

                                @if (Subtitle.HasValue())
                                {
                                    <div id="@_subtitleId" style="@Styles?.Subtitle" class="bit-dlg-sub @Classes?.Subtitle">@Subtitle</div>
                                }
                            </div>
                        }

                        @if (ShowCloseButton)
                        {
                            var closeIcon = BitIconInfo.From(CloseIcon, CloseIconName ?? "Cancel");
                            var closeTitle = CloseButtonTitle ?? DefaultCloseButtonTitle;

                            <button @ref="_closeButtonRef" @onclick="HandleOnCloseClick"
                                    style="@Styles?.CloseButton"
                                    class="bit-dlg-cls @Classes?.CloseButton"
                                    type="button"
                                    disabled="@(IsEnabled is false || _isLoading)"
                                    title="@closeTitle"
                                    aria-label="@closeTitle">
                                <span>
                                    <i style="@Styles?.CloseIcon" class="bit-dlg-cli @closeIcon?.GetCssClasses() @Classes?.CloseIcon" aria-hidden="true" />
                                </span>
                            </button>
                        }
                    </div>
                }
                <div style="@Styles?.Body" class="bit-dlg-scr-cnt @Classes?.Body">
                    @if (Message.HasValue())
                    {
                        <div id="@_messageId" style="@Styles?.Message" class="bit-dlg-msg @Classes?.Message">@Message</div>
                    }

                    @(Body ?? ChildContent)

                    @if (ShowOkButton || ShowCancelButton)
                    {
                        <div style="@Styles?.ButtonsContainer" class="bit-dlg-bct @Classes?.ButtonsContainer">
                            @if (ShowOkButton)
                            {
                                @* The spinner replaces the label while the Ok callback runs, which would
                                   otherwise leave the button nameless to a screen reader for as long as it
                                   takes - so the label is kept as the accessible name for that stretch. *@
                                <button @ref="_okButtonRef" @onclick="HandleOnOkClick"
                                        type="button"
                                        disabled="@(IsEnabled is false || IsOkButtonEnabled is false || _isLoading)"
                                        aria-busy="@(_isLoading ? "true" : null)"
                                        aria-label="@(_isLoading ? OkText : null)"
                                        style="@Styles?.OkButton"
                                        class="bit-dlg-okb @Classes?.OkButton">
                                    @if (_isLoading)
                                    {
                                        <div style="@Styles?.Spinner" class="bit-dlg-spn @Classes?.Spinner" aria-hidden="true"></div>
                                    }
                                    else
                                    {
                                        @OkText
                                    }
                                </button>
                            }

                            @if (ShowCancelButton)
                            {
                                @* Disabled while the Ok callback is running: a Cancel let through there would
                                   answer a showing the Ok has already answered, and hand that second answer to
                                   an awaiter while the first one is still doing its work. *@
                                <button @ref="_cancelButtonRef" @onclick="HandleOnCancelClick"
                                        type="button"
                                        disabled="@(IsEnabled is false || IsCancelButtonEnabled is false || _isLoading)"
                                        style="@Styles?.CancelButton"
                                        class="bit-dlg-cnb @Classes?.CancelButton">
                                    @CancelText
                                </button>
                            }
                        </div>
                    }
                </div>
                @if (FooterTemplate is not null)
                {
                    <div style="@Styles?.Footer" class="bit-dlg-ftr @Classes?.Footer">
                        @FooterTemplate
                    </div>
                }
            </div>
        </div>

    </div>
}
