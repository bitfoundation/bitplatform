@namespace Bit.BlazorUI
@inherits BitComponentBase

@* The keydown handler is on the root rather than on the tooltip, because the tooltip never takes the
   focus: the keyboard is on the anchor inside the root while the tooltip is shown, so that is where an
   Escape that dismisses it arrives (WCAG 1.4.13 "dismissible").

   The relationship is declared on the root for as long as there is a tooltip to declare it with, rather
   than only while it is on the screen: a name computation follows an aria-describedby or an
   aria-labelledby to the element it points at even when that element is hidden, so a screen reader has
   the text the moment the anchor is reached, instead of racing the render that shows the tooltip. *@
<div @ref="RootElement"
     id="@_Id"
     aria-label="@AriaLabel"
     aria-describedby="@(AriaAttribute == "aria-describedby" ? _tooltipId : null)"
     aria-labelledby="@(AriaAttribute == "aria-labelledby" ? _tooltipId : null)"
     @attributes="HtmlAttributes"
     @onkeydown="@HandleKeyDown"
     @onfocusin="@HandleFocusIn"
     @onfocusout="@HandleFocusOut"
     @onpointerup="@HandlePointerUp"
     @onpointerdown="@HandlePointerDown"
     @onpointerenter="@HandlePointerEnter"
     @onpointerleave="@HandlePointerLeave"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     tabindex="@TabIndex"
     dir="@Dir?.ToString().ToLower()">

    @(Anchor ?? ChildContent)

    @* A tooltip with nothing to say is no tooltip at all: the surface and the arrow are left off the page
       altogether rather than shown as an empty box the moment something asks for them. *@
    @if (HasContent)
    {
        @* A pointer pressed or released inside the tooltip is not a press on the anchor, so neither of them
           is let through to the root: an interactive tooltip would otherwise close itself the moment
           anything inside it was clicked, and selecting the text of one would be taken for the press that
           focuses the anchor. *@
        <div style="@Styles?.TooltipWrapper"
             class="bit-ttp-wrp @GetTooltipClasses() @Classes?.TooltipWrapper"
             @onpointerup="@SwallowPointerEvent"
             @onpointerup:stopPropagation="true"
             @onpointerdown="@SwallowPointerEvent"
             @onpointerdown:stopPropagation="true">
            <div role="tooltip"
                 id="@_tooltipId"
                 style="@Styles?.Tooltip"
                 class="bit-ttp-ctn @Classes?.Tooltip">
                @if (_contentRendered)
                {
                    if (Template is not null)
                    {
                        @Template
                    }
                    else
                    {
                        @Text
                    }
                }
            </div>
            @if (HideArrow is false)
            {
                <div style="@Styles?.Arrow" class="bit-ttp-arw @Classes?.Arrow"></div>
            }
        </div>
    }
</div>
