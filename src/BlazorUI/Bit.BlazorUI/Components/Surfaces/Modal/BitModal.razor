@namespace Bit.BlazorUI
@inherits BitComponentBase

@if (IsOpen || _keptMounted || IsLeaving)
{
    @* The keydown handler sits on the root so that Escape is reported from anywhere inside the Modal - the
       content, the overlay, whichever part of it the keyboard happens to be in. Whether the press dismisses the
       Modal is the script's to decide (Utils.watchEscape watches the same root), since only it can tell a press
       a layer inside the Modal answered first. The keys stop here: a Modal opened from inside another one
       renders inside that one's content, and its Escape is not the outer one's to report. *@
    @* While a kept-mounted Modal is closed it is still in the page, only hidden: inert and aria-hidden
       take it out of the tab sequence and out of the reading order for the browsers that would otherwise
       still reach into a display:none subtree through a stale reference. A Modal playing its exit
       animation is closed in the same way, so the pointer and the keyboard are the page's again at once. *@
    @* tabindex="-1" makes the root programmatically focusable so that a press on the overlay lands the focus
       inside the Modal rather than on the body. The root only catches it: the focus trap passes it straight
       on into the content box below, where the dialog role is (Utils.setupFocusTrap has the whole of it). It
       is written ahead of the attributes of the consumer so that a tabindex of their own is the one that
       lands. *@
    <div @ref="RootElement"
         tabindex="@(TabIndex ?? "-1")"
         @attributes="_params.HtmlAttributes"
         @onkeydown="HandleOnKeyDown" @onkeydown:stopPropagation
         id="@_Id"
         style="@StyleBuilder.Value"
         class="@GetRootClasses()"
         dir="@_params.Dir?.ToString().ToLower()"
         inert="@(IsOpen is false)"
         aria-hidden="@(IsOpen ? null : "true")">
        @if (ShowsOverlay)
        {
            @* The press on the overlay is left its default action: it is what blurs the input the user was
               typing into, and an input only commits what was typed once it loses the focus - before the
               click the press turns into runs any dismissal handler. Where that focus lands is the tabindex
               of the root above. *@
            <div @onclick="HandleOnOverlayClick"
                 aria-hidden="true"
                 style="@GetOverlayStyles()"
                 class="@GetOverlayClasses()" />
        }
        @* The dialog is this box rather than the layer around it: the pattern asks for every element the
           dialog is operated through to be a descendant of the element that carries the role, and the layer
           also holds the overlay, which is not part of the dialog but the page it is covering.
           tabindex="-1" makes it programmatically focusable, which is what the focus has to land on when the
           Modal opens with nothing focusable inside it: the alternative is leaving it behind on the element
           that opened the Modal, out of reach behind the overlay. *@
        <div id="@_containerId"
             tabindex="-1"
             style="@GetContentStyles()"
             class="@GetContentClasses()"
             aria-label="@_params.AriaLabel"
             aria-labelledby="@GetAriaLabelledBy()"
             aria-describedby="@_params.SubtitleAriaId"
             aria-modal="@(IsAriaModal.ToString().ToLowerInvariant())"
             role="@GetRole()">
            @* The parameters a container cascades are for this Modal and they stop here. A Modal declared
               inside the content of one shown through the service - the confirmation a form asks for - would
               otherwise be handed the outer one's header, close button and callbacks, and could not turn any
               of them off: the non-nullable flags merge as "either side can switch it on". The container's
               hold on this Modal's exit (BitModalExit) stops here for the same reason. *@
            <CascadingValue Value="(BitModalParameters?)null" IsFixed="true">
                <CascadingValue Name="@BitModalExit.CascadingName" Value="(BitModalExit?)null" IsFixed="true">
                    @* Everything the chrome is made of is opt-in: a Modal that declares none of it renders its
                       content on its own, as the bare surface it was before the chrome existed. *@
                    @if (HasChrome)
                    {
                        @if (HasHeader)
                        {
                            <div style="@JoinStyles(Styles?.HeaderContainer, _params.Styles?.HeaderContainer)"
                                 class="@JoinClasses("bit-mdl-hcn", Classes?.HeaderContainer, _params.Classes?.HeaderContainer)">
                                @* The text title is what names the dialog when nothing else does (GetAriaLabelledBy), and
                                   is announced as the heading it looks like. A template brings its own markup - a title,
                                   and often a control or two beside it that are no part of the name - so it is left to say
                                   what it is, and to point TitleAriaId at the part of it that names the dialog. *@
                                @if (_params.Header is not null)
                                {
                                    <div style="@JoinStyles(Styles?.Header, _params.Styles?.Header)"
                                         class="@JoinClasses("bit-mdl-hdr", Classes?.Header, _params.Classes?.Header)">
                                        @_params.Header
                                    </div>
                                }
                                else if (_params.HeaderText.HasValue())
                                {
                                    <div id="@_titleId"
                                         role="heading"
                                         aria-level="2"
                                         style="@JoinStyles(Styles?.Header, _params.Styles?.Header)"
                                         class="@JoinClasses("bit-mdl-hdr", Classes?.Header, _params.Classes?.Header)">
                                        @_params.HeaderText
                                    </div>
                                }

                                @if (_params.ShowCloseButton ?? false)
                                {
                                    var closeIcon = BitIconInfo.From(_params.CloseIcon, _params.CloseIconName ?? "Cancel");

                                    <button @onclick="HandleOnCloseClick"
                                            type="button"
                                            disabled="@(_params.Disabled is true)"
                                            title="@(_params.CloseButtonTitle ?? DefaultCloseButtonTitle)"
                                            aria-label="@(_params.CloseButtonTitle ?? DefaultCloseButtonTitle)"
                                            style="@JoinStyles(Styles?.CloseButton, _params.Styles?.CloseButton)"
                                            class="@JoinClasses("bit-mdl-cls", Classes?.CloseButton, _params.Classes?.CloseButton)">
                                        <i aria-hidden="true"
                                           style="@JoinStyles(Styles?.CloseIcon, _params.Styles?.CloseIcon)"
                                           class="@JoinClasses(closeIcon?.GetCssClasses() ?? string.Empty, Classes?.CloseIcon, _params.Classes?.CloseIcon)" />
                                    </button>
                                }
                            </div>
                        }

                        <div style="@JoinStyles(Styles?.Body, _params.Styles?.Body)"
                             class="@JoinClasses("bit-mdl-bdy", Classes?.Body, _params.Classes?.Body)">
                            @(_params.Body ?? ChildContent)
                        </div>

                        @if (HasFooter)
                        {
                            <div style="@JoinStyles(Styles?.Footer, _params.Styles?.Footer)"
                                 class="@JoinClasses("bit-mdl-fcn", Classes?.Footer, _params.Classes?.Footer)">
                                @if (_params.Footer is not null)
                                {
                                    @_params.Footer
                                }
                                else
                                {
                                    @_params.FooterText
                                }
                            </div>
                        }
                    }
                    else
                    {
                        @ChildContent
                    }
                </CascadingValue>
            </CascadingValue>
        </div>
    </div>
}
