@namespace Bit.BlazorUI
@inherits BitComponentBase

<div @ref="RootElement" @attributes="HtmlAttributes"
     @onmouseenter="HandleOnMouseEnter"
     @onmouseleave="HandleOnMouseLeave"
     id="@_Id"
     style="@StyleBuilder.Value"
     class="@ClassBuilder.Value"
     dir="@Dir?.ToString().ToLower()">

    @if (Anchor is not null)
    {
        @* The anchor holds the consumer's own trigger, so the relationship attributes are all this
           element carries: a role or a tabindex of its own would either duplicate the tab stop of the
           button inside it or turn a container of interactive content into an interactive element. *@
        <div @onclick="HandleOnAnchorClick"
             id="@_anchorId"
             aria-controls="@_contentId"
             aria-haspopup="@(TrapFocus ? "dialog" : "true")"
             aria-expanded="@(IsOpen ? "true" : "false")"
             style="@Styles?.AnchorContainer"
             class="bit-clo-acn @Classes?.AnchorContainer">
            @Anchor
        </div>
    }
</div>

<div @onclick="HandleOnOverlayClick" @onclick:stopPropagation
     id="@_overlayId"
     style="display:@(IsOpen ? "block" : "none");@Styles?.Overlay"
     class="@GetOverlayCssClasses()">
</div>

@if (ShowArrow)
{
    @* The arrow is a sibling of the callout rather than a child of it so that a callout which scrolls
       its own content never clips the half of the arrow that sticks out of it. It is positioned, and
       hidden again, by the same code that places the callout. *@
    <div id="@_arrowId"
         aria-hidden="true"
         style="@Styles?.Arrow"
         class="@GetArrowCssClasses()">
    </div>
}

<div @onclick="HandleOnCalloutClick"
     @onkeydown="HandleOnCalloutKeyDown"
     @onmouseenter="HandleOnMouseEnter"
     @onmouseleave="HandleOnMouseLeave"
     id="@_contentId"
     tabindex="-1"
     role="@GetRole()"
     aria-label="@AriaLabel"
     aria-modal="@(TrapFocus ? "true" : null)"
     style="@GetCalloutStyles()"
     class="@GetCalloutCssClasses()"
     dir="@Dir?.ToString().ToLower()">
    @(Content ?? ChildContent)
</div>
