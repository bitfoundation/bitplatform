<Project>

    <!-- The endpoints half of the publish-time asset trimming (see Bit.BlazorUI.targets): defines the trimmed bundles
         with content fingerprinting and gives them endpoints. -->

    <UsingTask TaskName="Bit.BlazorUI.Build.RelabelBitBlazorUIEndpoints" AssemblyFile="$(BitBlazorUIBuildTasksAssembly)" Condition="'$(_BitBlazorUITasksFromSource)' != 'true'" />
    <UsingTask TaskName="Bit.BlazorUI.Build.RelabelBitBlazorUIEndpoints" AssemblyFile="$(BitBlazorUIBuildTasksAssembly)" TaskFactory="TaskHostFactory" Condition="'$(_BitBlazorUITasksFromSource)' == 'true'" />

    <Target Name="_BitBlazorUIDefineTrimmedAssetsWithEndpoints" AfterTargets="_BitBlazorUIAssembleTrimmedAssets"
            Condition="'@(_BitBlazorUITrimmedCandidate)' != ''">

        <DefineStaticWebAssets CandidateAssets="@(_BitBlazorUITrimmedCandidate)"
                               FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
                               FingerprintPatterns="@(StaticWebAssetFingerprintPattern)">
            <Output TaskParameter="Assets" ItemName="_BitBlazorUITrimmedAsset" />
        </DefineStaticWebAssets>

        <DefineStaticWebAssetEndpoints CandidateAssets="@(_BitBlazorUITrimmedAsset)"
                                       ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                       ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
            <Output TaskParameter="Endpoints" ItemName="_BitBlazorUITrimmedEndpoint" />
        </DefineStaticWebAssetEndpoints>

    </Target>

    <!-- The rewritten service worker manifest and script (see _BitBlazorUIRewriteServiceWorker). Not fingerprinted: the SDK
         gives the client's originals no fingerprinted route either, and a browser finds both by name. -->
    <Target Name="_BitBlazorUIDefineServiceWorkerWithEndpoints" AfterTargets="_BitBlazorUIRewriteServiceWorker"
            Condition="'@(_BitBlazorUIServiceWorkerCandidate)' != ''">

        <DefineStaticWebAssets CandidateAssets="@(_BitBlazorUIServiceWorkerCandidate)">
            <Output TaskParameter="Assets" ItemName="_BitBlazorUIServiceWorkerAsset" />
        </DefineStaticWebAssets>

        <DefineStaticWebAssetEndpoints CandidateAssets="@(_BitBlazorUIServiceWorkerAsset)"
                                       ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                       ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
            <Output TaskParameter="Endpoints" ItemName="_BitBlazorUIServiceWorkerEndpoint" />
        </DefineStaticWebAssetEndpoints>

    </Target>

    <!-- Restores the "_content/<package>/..." labels the trimmed bundles' endpoints are given bare (see
         RelabelBitBlazorUIEndpoints for why), once the compressed copies - and their labels - have been derived. -->
    <Target Name="BitBlazorUIRestoreTrimmedAssetLabels" BeforeTargets="GenerateStaticWebAssetsPublishManifest"
            Condition="'$(_BitBlazorUIPublishTrimming)' == 'true' and '@(_BitBlazorUITrimmedAsset)' != ''">

        <RelabelBitBlazorUIEndpoints Endpoints="@(StaticWebAssetEndpoint)" Assets="@(_BitBlazorUITrimmedAsset)">
            <Output TaskParameter="Replaced" ItemName="_BitBlazorUIRelabelledOriginal" />
            <Output TaskParameter="Relabelled" ItemName="_BitBlazorUIRelabelled" />
        </RelabelBitBlazorUIEndpoints>

        <ItemGroup>
            <StaticWebAssetEndpoint Remove="@(_BitBlazorUIRelabelledOriginal)" />
            <StaticWebAssetEndpoint Include="@(_BitBlazorUIRelabelled)" />
            <_BitBlazorUIRelabelledOriginal Remove="@(_BitBlazorUIRelabelledOriginal)" />
            <_BitBlazorUIRelabelled Remove="@(_BitBlazorUIRelabelled)" />
        </ItemGroup>
    </Target>

</Project>
