<Project Sdk="Microsoft.NET.Sdk">

    <!--
    The part of the AI packages every other one builds on, and the only one a server needs of them: the contracts
    (IBitAiTransport, the events, the request), the wire format (BitAiWireSerializer), the conversation model with its
    streaming reducer, the chat session, the tools, the DI builder and the client transports that need nothing beyond the
    framework (SSE and WebSocket).

    A plain library on purpose: no Razor, no static web assets, no ASP.NET Core and no package beyond the two
    Microsoft.Extensions abstractions every host has. A Blazor app gets it through Bit.BlazorUI.AI, a server through
    Bit.BlazorUI.AI.Server, and nothing of either reaches the other.
    -->

    <Import Project="../../../Bit.Build.props" />
    <!-- Bit.BlazorUI.PackageValidation.props is not imported yet: package validation compares a pack against the last
         published package, and this one has never been published. Import it once the first release is out. -->
    <Import Project="../../Bit.BlazorUI.TrimAnalysis.props" />

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <!-- See the note in Bit.BlazorUI.csproj: Debug builds only the TFM the demo and tests run on. -->
        <TargetFrameworks Condition=" '$(Configuration)' == 'Debug' And '$(BuildAllTfms)' != 'true' ">net11.0</TargetFrameworks>
        <RootNamespace>Bit.BlazorUI</RootNamespace>
        <IsTrimmable>true</IsTrimmable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Description>The core of bit BlazorUI AI: the transport contract, the events and the versioned wire format they cross the network in, the conversation model, the chat session and the SSE and WebSocket client transports. No UI and no ASP.NET Core dependency, so a server, a Blazor app and a plain .NET client share it.</Description>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageTags>$(PackageTags);Blazor;AI;LLM;Chat;Streaming;SSE;WebSockets</PackageTags>
    </PropertyGroup>

    <!-- Runs in the browser as well (through Bit.BlazorUI.AI): the platform analyzer then flags what WebAssembly lacks. -->
    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <!-- The DI and logging abstractions the builder and the session use: part of the .NET 11 base framework, a package
         (which every host of .NET 10 references anyway) before it. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    </ItemGroup>

    <!-- The packages of the family are versioned and released together, and the UI one reads the session's internals
         (the reducer's hooks, the shared JSON metadata). The satellites (Server, SignalR, ChatClient) stay on the public
         API, so a package installed alone never depends on another's internals. -->
    <ItemGroup>
        <InternalsVisibleTo Include="Bit.BlazorUI.AI, " />
        <InternalsVisibleTo Include="Bit.BlazorUI.AI, " />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Text.Json" />
    </ItemGroup>

</Project>
