@namespace Bit.BlazorUI
@inherits BitAiComponentBase

@{
    var source = BitAiSafeUrls.Image(Part.Url);
    var loaded = _loaded == source;
}

<figure @ref="RootElement"
        @attributes="HtmlAttributes"
        id="@_Id"
        style="@StyleBuilder.Value"
        class="@ClassBuilder.Value"
        dir="@Dir?.ToString().ToLower()">
    @* The source asked for is the one shown once the user loaded it, so a part handed another image asks again. *@
    @switch (DecideImage(source, loaded))
    {
        case BitAiImageDecision.Show:
            @* The intrinsic size is declared where it is known, so the message list does not jump as the image decodes.
               Blazor sets the attributes in the order they are written, and an engine that sees the source before the
               loading attribute starts the fetch then (WebKit), so how the image loads is written ahead of what it
               loads. An image the user loaded takes the focus off the button it replaces (see LoadImage), so it can
               hold it. *@
            <img @ref="_image"
                 loading="lazy"
                 decoding="async"
                 width="@Part.Width"
                 height="@Part.Height"
                 src="@source"
                 alt="@(Part.Alt ?? string.Empty)"
                 tabindex="@(loaded ? "-1" : null)"
                 style="@Styles?.Image"
                 class="bit-aiipv-img @Classes?.Image" />
            break;

        case BitAiImageDecision.AskFirst:
            @* An image the policy holds back is a button that loads it, named after what it shows (or, with no alternative
               text, the host it would be fetched from) - never the image itself, which would already have been fetched. *@
            <BitActionButton IconName="Photo2"
                             Title="@source"
                             OnClick="() => LoadImage(source)"
                             Classes="@ImagePlaceholderClasses"
                             Styles="@Styles?.ImagePlaceholder">
                @Strings.LoadImage(string.IsNullOrWhiteSpace(Part.Alt) ? ImageHostOf(source) : Part.Alt)
            </BitActionButton>
            break;

        default:
            @if (string.IsNullOrWhiteSpace(Part.Alt) is false)
            {
                <span style="@Styles?.BlockedImage" class="bit-aiipv-imb @Classes?.BlockedImage">@Part.Alt</span>
            }
            break;
    }
    @if (Part.Caption is { Length: > 0 } caption)
    {
        <figcaption style="@Styles?.Caption" class="bit-aiipv-cap @Classes?.Caption">@caption</figcaption>
    }
</figure>
