<Project>

    <!-- Names this package's script and stylesheet pieces to the publish-time asset trimming of Bit.BlazorUI, which this
         package depends on and whose buildTransitive\Bit.BlazorUI.targets does the trimming (and documents how to
         configure it): buildTransitive\bit-assets in the package, obj\bit-assets in the source tree. Removed before they
         are included, so a second import of this file (from build\ as well as buildTransitive\) leaves one of each. -->
    <ItemGroup>
        <BitBlazorUIAssetFolder Remove="$(MSBuildThisFileDirectory)bit-assets\;$(MSBuildThisFileDirectory)..\obj\bit-assets\" />
        <BitBlazorUIAssetFolder Include="$(MSBuildThisFileDirectory)bit-assets\;$(MSBuildThisFileDirectory)..\obj\bit-assets\" Package="Bit.BlazorUI.AI" />
    </ItemGroup>

    <!-- Names this package's scripts to the choice between the bundle and the lazy scripts (BitBlazorUILazyScripts): the
         file names of its bundle and its boot module under scripts/. -->
    <ItemGroup>
        <BitBlazorUIScriptPackage Remove="Bit.BlazorUI.AI" />
        <BitBlazorUIScriptPackage Include="Bit.BlazorUI.AI" Bundle="bit.blazorui.ai.js" Boot="bit.blazorui.ai.boot.js" />
    </ItemGroup>

</Project>
