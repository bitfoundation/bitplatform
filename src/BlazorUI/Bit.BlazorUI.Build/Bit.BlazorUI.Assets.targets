<Project>

    <!--
    The package side of the publish-time trimming, imported by the csproj of each bit BlazorUI package that ships scripts
    or stylesheets (Bit.BlazorUI, Bit.BlazorUI.Extras, Bit.BlazorUI.Legacy, Bit.BlazorUI.Icons) - kept here, once, so the
    packages cannot drift apart in how their pieces are written and packed:

      @(BitAssetsScript)     build-assets.mjs, which each package's BuildJavaScript and BuildCss targets run with the
                             bundles of their own, writing the pieces and their manifests into obj\bit-assets
      $(_BitAssetsMinify)    passed to its scripts command: a Release build minifies the pieces, and so the bundle
      the package            the pieces under buildTransitive\bit-assets, where the consumer-side targets read them
                             (Bit.BlazorUI's buildTransitive\Bit.BlazorUI.targets); with BitBlazorUIPackBuildTask set
                             (Bit.BlazorUI's), the task itself under tasks\ too
      the assembly           obj\bit-assets\lazy-scripts.json as the resource bit-lazy-scripts.json: which module of the
                             lazy scripts exports what, read by the .NET side of BitBlazorUILazyScripts (BitScriptLoader)

    Imported after the csproj sets TargetFrameworks, which the packing reads.
    -->

    <ItemGroup>
        <BitAssetsScript Include="$(MSBuildThisFileDirectory)build-assets.mjs" />
    </ItemGroup>

    <PropertyGroup>
        <_BitAssetsMinify Condition=" '$(Configuration)' == 'Release' ">--minify</_BitAssetsMinify>

        <!-- Added from a target because the pieces are generated by the build. Once, from the first target framework, so
             a multi-targeted pack does not add them three times. -->
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeBitBlazorUIAssetsInPackage</TargetsForTfmSpecificContentInPackage>
        <!-- The first target framework, outside the condition that reads it: a semicolon is not allowed in one. -->
        <_BitBlazorUIPackedTfm>$(TargetFrameworks.Split(';')[0])</_BitBlazorUIPackedTfm>
    </PropertyGroup>

    <!-- No source map is written (build-assets.mjs deletes one an older build left beside a bundle), so none is content,
         even while an older one is still on disk as the project is evaluated. -->
    <ItemGroup>
        <Content Remove="wwwroot\styles\*.map;wwwroot\scripts\*.map" />
    </ItemGroup>

    <!-- Embedded from a target because build-assets.mjs writes it during the build, which a clean build has not run yet when
         the project is evaluated; before the build proper, so the resources are prepared with it. A package without scripts
         (Bit.BlazorUI.Icons) has none to embed. -->
    <Target Name="EmbedBitBlazorUILazyScripts" BeforeTargets="BeforeBuild" DependsOnTargets="BeforeBuildTasksOnce" Condition="'$(DesignTimeBuild)' != 'true'">
        <ItemGroup Condition="Exists('$(BaseIntermediateOutputPath)bit-assets\lazy-scripts.json')">
            <EmbeddedResource Remove="$(BaseIntermediateOutputPath)bit-assets\lazy-scripts.json" />
            <EmbeddedResource Include="$(BaseIntermediateOutputPath)bit-assets\lazy-scripts.json" LogicalName="bit-lazy-scripts.json" WithCulture="false" Type="Non-Resx" />
        </ItemGroup>
    </Target>

    <Target Name="IncludeBitBlazorUIAssetsInPackage" Condition="'$(TargetFramework)' == '$(_BitBlazorUIPackedTfm)'">
        <MSBuild Condition="'$(BitBlazorUIPackBuildTask)' == 'true'" Projects="$(MSBuildThisFileDirectory)Bit.BlazorUI.Build.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier">
            <Output TaskParameter="TargetOutputs" ItemName="_BitBlazorUIBuildTaskAssembly" />
        </MSBuild>
        <ItemGroup>
            <_BitBlazorUIAssetPiece Include="$(BaseIntermediateOutputPath)bit-assets\**\*" />
            <TfmSpecificPackageFile Include="@(_BitBlazorUIAssetPiece)" PackagePath="buildTransitive\bit-assets\%(RecursiveDir)%(Filename)%(Extension)" />
            <TfmSpecificPackageFile Include="@(_BitBlazorUIBuildTaskAssembly)" PackagePath="tasks\%(Filename)%(Extension)" />
        </ItemGroup>
    </Target>

</Project>
