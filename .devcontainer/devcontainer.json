{
  "name": "bit platform",
  "hostRequirements": {
    "cpus": 4
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/powershell:2": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1",
      "helm": "3",
      "minikube": "1"
    },
    "ghcr.io/devcontainers/features/node:2": { "version": "24" }
  },
  "image": "mcr.microsoft.com/dotnet/sdk:10.0.400",
  "postStartCommand": "dotnet workload install wasm-tools && dotnet dev-certs https --trust",
  "waitFor": "onCreateCommand",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "CONTRIBUTING.md"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "ms-dotnettools.blazorwasm-companion",
        "ms-dotnettools.vscode-dotnet-runtime"
      ]
    }
  },
  "forwardPorts": [
    2030,
    2031,
    2032,
    4000,
    4001,
    5000,
    5001,
    4030,
    4031,
    4040,
    4041,
    5030,
    5031,
    5040,
    5041
  ],
  "remoteEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development"
  }
}